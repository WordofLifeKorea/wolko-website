---
/**
 * 비전 그림 — 가운데 먼저 믿은 한 친구에게서 복음이 원을 그리며 친구에서 친구로 퍼진다.
 * 사람마다: 흐린 모양(아직 못 들음) → 하늘색 고리(들음) → 금색(믿음) → 바깥 친구들에게 선(전함).
 * 흐린 바탕 그물 위로 빛이 선을 타고 다음 친구에게 가고, 받은 친구는 금빛 배지로 밝아진다.
 * 셋째 원까지 퍼지면 그림 전체가 확 줄어들고, 바깥 친구들에게서 복음이 마구잡이로 뻗어 나간다. 화면에 보이는 동안 계속 되풀이한다.
 * 1·2·3 표시는 가운데 친구 · 첫 원 · 둘째 원 친구 곁에 하나씩, 퍼지는 차례대로 켜지며 그림 옆 '믿고 → 전하고 → 또 전하고'와 짝을 이룬다.
 * 재생 중에는 감싼 section 에도 is-armed / is-on / is-fading 과 data-rl-step(1·2·3)을 붙여, 페이지가 세 걸음을 같은 때에 밝힐 수 있게 한다.
 * 자바스크립트가 없거나 움직임 줄이기 설정이면 처음부터 다 퍼진 그림을 보여 준다.
 */
interface Props { labelKo: string; labelEn: string }
const { labelKo, labelEn } = Astro.props;

const C = 300;
const R = [0, 105, 180, 255];
const f = (v: number) => Math.round(v * 10) / 10;
const at = (r: number, deg: number) => ({ x: f(C + r * Math.cos(deg * Math.PI / 180)), y: f(C + r * Math.sin(deg * Math.PI / 180)) });

type Person = { x: number; y: number; a: number; g: number; t: number; parent: Person | null };
const T = [0.6, 2.4, 4.2, 6.0]; // 원마다 믿는 시각(초) — 한 겹에 1.8초씩 천천히
const LINE = 0.5;               // 믿고 나서 다음 친구에게 빛이 떠나기까지 (빛이 선을 타는 데 1.2초)
const center: Person = { ...at(0, 0), a: 0, g: 0, t: T[0], parent: null };
// 첫 원 세 친구, 둘째 원은 한 사람이 두 친구씩, 셋째 원은 한 사람이 한두 친구씩
const ring1: Person[] = [-90, 30, 150].map(a => ({ ...at(R[1], a), a, g: 1, t: 0, parent: center }));
const ring2: Person[] = ring1.flatMap(p => [-22, 22].map(d => ({ ...at(R[2], p.a + d), a: p.a + d, g: 2, t: 0, parent: p })));
const split = [2, 1, 2, 2, 1, 2];
const ring3: Person[] = ring2.flatMap((p, i) => (split[i] === 1 ? [0] : [-11, 11]).map(d => ({ ...at(R[3], p.a + d), a: p.a + d, g: 3, t: 0, parent: p })));
[ring1, ring2, ring3].forEach((ring, i) => ring.forEach((p, k) => { p.t = f(T[i + 1] + (k % 3) * 0.06); }));
const people = [center, ...ring1, ...ring2, ...ring3];

const arcs = people.filter(p => p.parent).map(p => ({ d: `M${p.parent!.x} ${p.parent!.y} L${p.x} ${p.y}`, delay: f(p.parent!.t + LINE), out: false }));
// 바깥 친구들마다 바깥쪽으로 짧은 꼬리 — 서서히 흐려지며 끝나, 복음이 또 이어진다는 느낌만 남긴다
ring3.forEach(p => {
  const a = at(R[3] + 16, p.a), b = at(R[3] + 52, p.a);
  arcs.push({ d: `M${a.x} ${a.y} L${b.x} ${b.y}`, delay: f(p.t + LINE), out: true });
});
// 마지막 장면: 그림 전체가 확 줄어들고, 바깥 친구들에게서 복음이 규칙대로 퍼져 소용돌이 꽃처럼 피어난다
// 규칙: 한 사람이 한 명 또는 두 명에게 전한다(두 명일 확률 TWO). 친구마다 맡은 방향(부채꼴)이 있고, 두 친구에게 전하면
// 전해 준 친구가 선 자리에서 부채꼴을 둘로 나눠 맡는다. 선은 제 부채꼴 안에서만 바깥으로 뻗으므로 서로 겹치지 않는다.
// 소용돌이는 그린 뒤 그림 전체를 '멀수록 더 돌리는' 한 가지 규칙으로 비틀어 만든다(겹치지 않는 그림은 비틀어도 겹치지 않는다).
// 한 겹 안에서는 시계 방향으로 훑듯 차례로 켜지고, 바깥 겹으로 갈수록 천천히 퍼진다.
const ZOOM = 0.47;                // 줄어든 크기 — 가장 멀리 뻗은 친구까지 그림 안에 든다
const zoomAt = f(Math.max(...ring3.map(p => p.t)) + 0.9);
const burstAt = zoomAt + 1.1;     // 다 줄어들 즈음부터 퍼지기 시작
const norm = (d: number) => ((d % 360) + 360) % 360;
const LEVELS = 3;                       // 겹 수
const TWO = 0.5;                       // 두 명에게 전할 확률 — 나머지는 한 명
const STEP = 100;                       // 한 번 전할 때 뻗는 평균 길이 — 친구마다 0.7~1.3배로 달라 끝이 둥근 원이 되지 않는다
let seed = 11;                          // 같은 그림이 늘 나오도록 고정된 난수
const rnd = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
// 뒤로 갈수록 천천히: 겹마다 다음 겹까지의 간격, 한 바퀴 훑는 시간, 선이 그려지는 시간이 길어지고 마지막 겹은 특히 느리다(초)
const GAPS = [0.85, 1.6];
const SWEEP = [0.35, 0.6, 2.2];
const DRAW = [0.5, 0.85, 2.5];
const SPIRAL = 0.09;                    // 소용돌이: 바깥 친구(반지름 255)에서 1만큼 멀어질 때마다 도는 각도
// 겹마다 사람 배지 반지름(r), 선 굵기(w), 선 진하기(o) — 바깥일수록 작고 흐리게
const LOOK = [{ r: 12, w: 2.4, o: .8 }, { r: 11, w: 2, o: .68 }, { r: 10, w: 1.6, o: .56 }];
const twist = (r: number, deg: number) => at(r, deg + SPIRAL * (r - R[3]));
type Tip = { a: number; r: number; lo: number; hi: number };
const outer = [...ring3].sort((p, q) => norm(p.a) - norm(q.a));
let tips: Tip[] = outer.map((p, i) => { // 바깥 친구마다 맡은 방향 = 양옆 친구와의 가운데까지
  const a = norm(p.a);
  let prev = norm(outer[(i + outer.length - 1) % outer.length].a), next = norm(outer[(i + 1) % outer.length].a);
  if (prev >= a) prev -= 360;
  if (next <= a) next += 360;
  return { a, r: R[3], lo: (prev + a) / 2, hi: (a + next) / 2 };
});
const burst: { d: string; x: number; y: number; delay: number; level: number }[] = [];
let start = burstAt, lastStart = burstAt;
Array.from({ length: LEVELS }, (_, level) => level).forEach(level => {
  lastStart = start;
  const next: Tip[] = [];
  tips.forEach(tip => {
    // 한 명 또는 두 명에게 전한다 — 한 명이면 부채꼴을 통째로, 두 명이면 둘로 나눠 맡는다
    (rnd() < TWO ? [[tip.lo, tip.a], [tip.a, tip.hi]] : [[tip.lo, tip.hi]]).forEach(([lo, hi]) => {
      const child: Tip = { lo, hi, a: (lo + hi) / 2, r: tip.r + STEP * (0.7 + 0.6 * rnd()) };
      // 선: 각도와 반지름을 함께 고르게 바꿔 가며 잇고(제 부채꼴을 벗어나지 않음), 소용돌이로 비튼다
      const pts = Array.from({ length: 9 }, (_, k) => {
        const t = k / 8;
        return twist(tip.r + (child.r - tip.r) * t, tip.a + (child.a - tip.a) * t);
      });
      const end = pts[pts.length - 1];
      burst.push({ d: 'M' + pts.map(q => `${q.x} ${q.y}`).join('L'), ...end, delay: f(start + norm(child.a) / 360 * SWEEP[level]), level });
      next.push(child);
    });
  });
  tips = next;
  start += GAPS[level] ?? 0;
});
const shockAt = f(lastStart); // 가장 바깥 겹이 켜질 때 한 번 퍼지는 빛 물결
// 한 바퀴 길이(초) — 가장 바깥 겹이 다 밝아지는 시각
const cycle = f(Math.max(...burst.map(b => b.delay + DRAW[b.level])) + 1);

// 원 이름표 — 오른쪽 위(-30°) 빈 길목을 따라
const names = [['내 친구', 'My friends'], ['친구의 친구', 'Their friends'], ['그다음 친구', 'And theirs']]
  .map(([ko, en], i) => ({ ko, en, ...at(R[i + 1], -30), delay: f(T[i + 1]) }));

// 세 걸음 표시: 퍼지는 차례대로 가운데 친구 곁에 1, 첫 원 친구 곁에 2, 둘째 원 친구 곁에 3 — 그 친구가 밝아질 때 켜진다
// 위쪽으로 이어지는 세 친구를 따라가고, 표시는 선을 피해 비어 있는 쪽(각도)에 둔다
const marks = [
  { n: 1, p: center, deg: -140, dist: 40 },
  { n: 2, p: ring1[0], deg: 180, dist: 36 },
  { n: 3, p: ring2[1], deg: 0, dist: 36 },
].map(({ n, p, deg, dist }) => ({ n, x: f(p.x + dist * Math.cos(deg * Math.PI / 180)), y: f(p.y + dist * Math.sin(deg * Math.PI / 180)), delay: p.t }));
const stepTimes = marks.map(m => m.delay);
---
<p class="sr-only"><span class="wl-ko">{labelKo}</span><span class="wl-en">{labelEn}</span></p>
<svg class="rl" viewBox="0 0 600 600" aria-hidden="true" data-cycle={cycle} data-steps={JSON.stringify(stepTimes)} style={`--z:${zoomAt}s;--zoom:${ZOOM}`}>
  <defs>
    <radialGradient id="rl-fade" gradientUnits="userSpaceOnUse" cx={C} cy={C} r={R[3] + 52}>
      <stop offset={f((R[3] + 16) / (R[3] + 52) * 100) / 100} stop-color="#f3dca6" stop-opacity=".75" />
      <stop offset="1" stop-color="#f3dca6" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="rl-halo-fill">
      <stop offset="0" stop-color="#f3dca6" stop-opacity=".55" />
      <stop offset=".45" stop-color="#f3dca6" stop-opacity=".18" />
      <stop offset="1" stop-color="#f3dca6" stop-opacity="0" />
    </radialGradient>
    <radialGradient id="rl-badge-fill" cx=".38" cy=".32" r=".8">
      <stop offset="0" stop-color="#fff6dc" />
      <stop offset=".55" stop-color="#f3dca6" />
      <stop offset="1" stop-color="#d9b56a" />
    </radialGradient>
    <filter id="rl-glow" x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="2.4" result="b" />
      <feMerge><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge>
    </filter>
    <g id="rl-person"><circle cx="0" cy="-5" r="5" /><path d="M-9 11C-9 3-5 1 0 1s9 2 9 10z" /></g>
  </defs>

  <g class="rl-world">
  <!-- 바탕: 아직 아무도 듣지 못한 모습 — 늘 흐리게 깔려 있다 -->
  <g class="rl-ghost">
    {R.slice(1).map(r => <circle class="rl-guide" cx={C} cy={C} r={r} />)}
    {arcs.filter(a => !a.out).map(a => <path d={a.d} />)}
    {people.map(n => (
      <g transform={`translate(${n.x} ${n.y})`}>
        <circle r={n.g ? 12 : 16} />
        <use href="#rl-person" transform={`scale(${n.g ? 0.68 : 0.9})`} />
      </g>
    ))}
  </g>

  <!-- 살아나는 층: 금빛 선 · 선을 타고 가는 빛 · 믿음으로 밝아지는 친구 · 원 이름표 · 세 걸음 표시 -->
  <g class="rl-live">
    {R.slice(1).map((r, i) => <circle class="rl-guide-lit" cx={C} cy={C} r={r} style={`--d:${T[i + 1]}s`} />)}
    {arcs.map(a => <path class:list={['rl-arc', { 'rl-arc-out': a.out }]} pathLength="1" d={a.d} style={`--d:${a.delay}s`} />)}
    {arcs.map(a => <path class:list={['rl-spark', { 'rl-spark-out': a.out }]} pathLength="1" d={a.d} filter="url(#rl-glow)" style={`--d:${a.delay}s`} />)}
    {people.map(n => (
      <g class:list={['rl-node', { 'rl-node-first': !n.g }]} transform={`translate(${n.x} ${n.y})`} style={`--d:${n.t}s`}>
        <circle class="rl-halo" r={n.g ? 26 : 38} />
        <circle class="rl-ring" r={n.g ? 13 : 17} />
        <g class="rl-badge">
          <circle r={n.g ? 12 : 16} />
          <use href="#rl-person" transform={`scale(${n.g ? 0.68 : 0.9})`} />
        </g>
      </g>
    ))}
    {names.map(n => <>
      <text class="rl-name wl-ko" x={f(n.x + 12)} y={f(n.y - 8)} style={`--d:${n.delay}s`}>{n.ko}</text>
      <text class="rl-name wl-en" x={f(n.x + 12)} y={f(n.y - 8)} style={`--d:${n.delay}s`}>{n.en}</text>
    </>)}
    {marks.map(m => (
      <g transform={`translate(${m.x} ${m.y})`}>
        <g class="rl-mark" style={`--d:${m.delay}s`}><circle r="13" /><text y="5" text-anchor="middle">{m.n}</text></g>
      </g>
    ))}
  </g>

  <!-- 마지막 장면: 줄어든 그림 바깥으로 규칙대로 피어나는 복음 (재생할 때만) -->
  <g class="rl-burst">
    <circle class="rl-shock" cx={C} cy={C} r="600" style={`--d:${shockAt}s`} />
    {burst.map(b => <path pathLength="1" d={b.d} stroke-width={LOOK[b.level].w} style={`--d:${b.delay}s;--dur:${DRAW[b.level]}s;--o:${LOOK[b.level].o}`} />)}
    {burst.map(b => (
      <g transform={`translate(${b.x} ${b.y})`}>
        <g class="rl-bud" style={`--d:${f(b.delay + DRAW[b.level] * 0.8)}s;--dur:${f(DRAW[b.level] + 0.1)}s`}>
          <circle r={LOOK[b.level].r} />
          <use href="#rl-person" transform={`scale(${f(LOOK[b.level].r / 17.6 * 100) / 100})`} />
        </g>
      </g>
    ))}
  </g>
  </g>
  <text class="rl-note wl-ko" x={C} y="352" text-anchor="middle">먼저 믿은 친구</text>
  <text class="rl-note wl-en" x={C} y="352" text-anchor="middle">First to believe</text>
</svg>

<style>
  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  .rl { display:block; width:100%; max-width:600px; height:auto; margin:0 auto; overflow:visible; }

  .rl-ghost path { fill:none; stroke:rgba(255,255,255,.08); stroke-width:1.2; }
  .rl-ghost circle { fill:rgba(255,255,255,.03); stroke:rgba(255,255,255,.16); stroke-width:1; }
  .rl-ghost .rl-guide { fill:none; stroke:rgba(255,255,255,.1); stroke-dasharray:3 6; }
  .rl-ghost use { fill:rgba(255,255,255,.26); }

  /* 다 퍼진 모습 — 자바스크립트가 없거나 움직임 줄이기 설정일 때 그대로 보인다 */
  .rl-live { transition:opacity .9s ease; }
  .rl-guide-lit { fill:none; stroke:rgba(243,220,166,.3); stroke-width:1.2; stroke-dasharray:3 6; }
  .rl-arc { fill:none; stroke:#f3dca6; stroke-width:1.5; stroke-linecap:round; stroke-dasharray:1; stroke-dashoffset:0; opacity:.62; }
  .rl-arc-out { stroke:url(#rl-fade); opacity:1; }
  .rl-spark { fill:none; stroke:#fffaf0; stroke-width:2.6; stroke-linecap:round; stroke-dasharray:.14 2; stroke-dashoffset:-1.2; opacity:0; }
  .rl-node .rl-halo { fill:url(#rl-halo-fill); opacity:.8; }
  .rl-node .rl-ring { fill:none; stroke:#8fdcf7; stroke-width:1.4; opacity:0; }
  .rl-node .rl-badge circle { fill:url(#rl-badge-fill); stroke:rgba(255,246,220,.9); stroke-width:1; }
  .rl-node .rl-badge use { fill:#0b3442; }
  .rl-node-first .rl-badge circle { stroke-width:1.4; }
  .rl-name { fill:#f3dca6; font:700 15px var(--ff-sans); }
  .rl-note { fill:rgba(255,255,255,.72); font:500 14px var(--ff-sans); transition:opacity .9s ease; }
  .rl-mark circle { fill:#052833; stroke:#f3dca6; stroke-width:1.6; }
  .rl-mark text { fill:#f3dca6; font:700 14px var(--ff-sans); }
  /* 휴대폰: 그림이 줄어드는 만큼 글씨를 키운다 */
  @media (max-width:640px) {
    .rl-name, .rl-note { font-size:17px; }
    .rl-mark text { font-size:16px; }
  }

  /* 재생 준비(.is-armed): 살아나는 층이 모두 꺼진 상태 → .is-on 이 붙으면 차례대로 */
  .rl.is-armed .rl-arc { stroke-dashoffset:1; }
  .rl.is-armed .rl-halo { opacity:0; transform:scale(.4); }
  .rl.is-armed .rl-badge { opacity:0; transform:scale(.55); }
  .rl.is-armed .rl-guide-lit, .rl.is-armed .rl-name { opacity:0; }
  .rl.is-armed .rl-mark { opacity:0; transform:scale(.4); }
  .rl.is-armed.is-on .rl-arc { animation:rl-draw 1.2s cubic-bezier(.65,0,.35,1) var(--d) both; }
  .rl.is-armed.is-on .rl-spark { animation:rl-spark 1.2s cubic-bezier(.65,0,.35,1) var(--d) both; }
  .rl.is-armed.is-on .rl-ring { animation:rl-hear 1.1s cubic-bezier(.2,.7,.2,1) calc(var(--d) - .12s) both; }
  .rl.is-armed.is-on .rl-badge { animation:rl-believe .7s cubic-bezier(.34,1.56,.64,1) var(--d) both; }
  .rl.is-armed.is-on .rl-halo { animation:rl-bloom 1s cubic-bezier(.2,.7,.2,1) var(--d) both, rl-breathe 3.4s ease-in-out calc(var(--d) + 1s) infinite alternate; }
  .rl.is-armed.is-on .rl-node-first .rl-halo { animation:rl-bloom 1s cubic-bezier(.2,.7,.2,1) var(--d) both, rl-breathe 2.6s ease-in-out calc(var(--d) + 1s) infinite alternate; }
  .rl.is-armed.is-on .rl-guide-lit { animation:rl-show .8s ease-out var(--d) both; }
  /* 글자와 1·2·3 은 그림이 줄어들기 시작하면 사라진다 */
  .rl.is-armed.is-on .rl-name { animation:rl-show .8s ease-out var(--d) both, rl-hide .4s ease-in var(--z) forwards; }
  .rl.is-armed.is-on .rl-mark { animation:rl-believe .5s cubic-bezier(.34,1.56,.64,1) var(--d) both, rl-hide .4s ease-in var(--z) forwards; }
  .rl.is-armed.is-on .rl-note { animation:rl-hide .4s ease-in var(--z) forwards; }
  /* 마지막 장면: 확 줄어든 뒤 바깥으로 마구잡이로 뻗는다 */
  .rl-world { transform-box:view-box; transform-origin:300px 300px; transition:opacity .9s ease; }
  .rl-burst { display:none; }
  .rl.is-armed .rl-burst { display:inline; }
  .rl-burst path { fill:none; stroke:#f3dca6; stroke-linecap:round; stroke-dasharray:1; stroke-dashoffset:1; opacity:var(--o); }
  .rl-bud { opacity:0; }
  .rl-bud circle { fill:url(#rl-badge-fill); stroke:rgba(255,246,220,.9); stroke-width:1; }
  .rl-bud use { fill:#0b3442; }
  .rl-shock { fill:none; stroke:#f3dca6; stroke-width:6; opacity:0; transform-box:view-box; transform-origin:300px 300px; }
  .rl.is-armed.is-on .rl-world { animation:rl-zoom 1.3s cubic-bezier(.7,0,.2,1) var(--z) both; }
  .rl.is-armed.is-on .rl-burst path { animation:rl-draw var(--dur) cubic-bezier(.3,0,.2,1) var(--d) both; }
  .rl.is-armed.is-on .rl-bud { animation:rl-bud var(--dur) cubic-bezier(.34,1.56,.64,1) var(--d) both; }
  .rl.is-armed.is-on .rl-shock { animation:rl-shock 4s cubic-bezier(.2,.7,.2,1) var(--d) both; }
  /* 바깥 친구들의 짧은 꼬리는 퍼지는 선과 겹치지 않게 줄어들 때 사라진다 */
  .rl.is-armed.is-on .rl-arc-out { animation:rl-draw 1.2s cubic-bezier(.65,0,.35,1) var(--d) both, rl-hide .4s ease-in var(--z) forwards; }
  @keyframes rl-bud { 0% { opacity:0; transform:scale(.2); } 50% { opacity:1; transform:scale(1.5); } 100% { opacity:.9; transform:scale(1); } }
  @keyframes rl-shock { 0% { opacity:0; transform:scale(.5); } 20% { opacity:.45; } 100% { opacity:0; transform:scale(1.02); } }
  .rl.is-fading .rl-world, .rl.is-fading .rl-note { opacity:0; }

  @keyframes rl-draw { from { stroke-dashoffset:1; } to { stroke-dashoffset:0; } }
  @keyframes rl-spark {
    0% { stroke-dashoffset:.14; opacity:0; }
    12% { opacity:1; }
    82% { opacity:1; }
    100% { stroke-dashoffset:-1; opacity:0; }
  }
  @keyframes rl-hear { 0% { opacity:0; transform:scale(.5); } 20% { opacity:.9; } 100% { opacity:0; transform:scale(2.1); } }
  @keyframes rl-believe { 0% { opacity:0; transform:scale(.55); } 40% { opacity:1; } 100% { opacity:1; transform:scale(1); } }
  @keyframes rl-bloom { 0% { opacity:0; transform:scale(.4); } 45% { opacity:1; transform:scale(1.15); } 100% { opacity:.8; transform:scale(1); } }
  @keyframes rl-breathe { from { opacity:.8; transform:scale(1); } to { opacity:.45; transform:scale(.86); } }
  @keyframes rl-show { from { opacity:0; } to { opacity:1; } }
  @keyframes rl-hide { to { opacity:0; } }
  @keyframes rl-zoom { from { transform:scale(1); } to { transform:scale(var(--zoom)); } }</style>

<script>
  // 화면에 보이는 동안 계속 되풀이한다: 한 친구에서 시작해 다 퍼지면 → 잠시 머문 뒤 → 금빛 층이 부드럽게 사라지고 → 다시 처음부터.
  // 화면 밖으로 나가면 멈추고, 다시 들어오면 처음부터. 움직임 줄이기 설정이면 다 퍼진 그림만 보여 준다.
  // 감싼 section 에도 같은 상태와 data-rl-step 을 붙여, 페이지의 세 걸음 글자가 그림 속 1·2·3 과 같은 때에 밝아지게 한다.
  const still = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll<SVGSVGElement>('svg.rl').forEach(svg => {
    if (still || !('IntersectionObserver' in window)) return;
    const scope = svg.closest('section');
    const els: Element[] = scope ? [svg, scope] : [svg];
    const set = (add: string[], remove: string[] = []) => els.forEach(el => { el.classList.remove(...remove); el.classList.add(...add); });
    set(['is-armed']);
    const playMs = (parseFloat(svg.dataset.cycle || '7') + 2.6) * 1000;   // 다 퍼진 뒤 2.6초 머문다
    const steps: number[] = JSON.parse(svg.dataset.steps || '[]');
    let timers: number[] = [];
    const clear = () => { timers.forEach(t => clearTimeout(t)); timers = []; };
    const run = () => {
      clear();
      els.forEach(el => el.classList.remove('is-on', 'is-fading'));
      void svg.getBoundingClientRect();
      set(['is-on']);
      // 퍼지는 차례대로 세 걸음을 밟는다: section 의 data-rl-step 이 1 → 2 → 3
      if (scope) {
        delete scope.dataset.rlStep;
        steps.forEach((t, i) => timers.push(window.setTimeout(() => { scope.dataset.rlStep = String(i + 1); }, t * 1000)));
      }
      timers.push(window.setTimeout(() => {
        if (scope) delete scope.dataset.rlStep;
        set(['is-fading']);                                              // 금빛 층만 0.9초 동안 사라진다(흐린 바탕은 그대로)
        timers.push(window.setTimeout(run, 1300));
      }, playMs));
    };
    const stop = () => { clear(); els.forEach(el => el.classList.remove('is-on', 'is-fading')); if (scope) delete scope.dataset.rlStep; };
    new IntersectionObserver(entries => {
      entries.forEach(e => (e.isIntersecting ? (svg.classList.contains('is-on') ? null : run()) : stop()));
    }, { threshold: 0.25 }).observe(svg);
  });
</script>
