---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  activeNav?: string;   // 'home' | 'about' | 'ministry' | 'connect' | 'give' | 'location'
  whiteNav?: boolean;   // 흰 배경 네비 (히어로 이미지 없는 페이지용)
  langRoot?: string;    // 언어 토글 루트 id (없으면 기본 body)
  languageOnlyNav?: boolean; // 업무 페이지용: 상단 메뉴 없이 언어 토글만 표시
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
}

const {
  title,
  description = '복음전파와 제자훈련으로 한국의 다음 세대를 섬깁니다 — Word of Life Korea',
  activeNav = '',
  whiteNav = false,
  langRoot = 'lang-root',
  languageOnlyNav = false,
  ogTitle = title,
  ogDescription = description,
  ogImage = '/images/WOLKO Circle.png',
} = Astro.props;
// 불러오는 중 · 처리 중 덮개(wolko-busy.js)는 포탈에서만 — 공개 홈페이지(랜딩 · 하위 페이지)에는 띄우지 않는다
const isPortal = /^\/portal(\/|$)/.test(Astro.url.pathname);
// 바닥글 연도 — 빌드할 때의 올해가 저절로 들어간다(사용자 결정 2026-11-05)
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script is:inline src="/wolko-lang-sync.js?v=3"></script>
  {isPortal && <script is:inline src="/wolko-busy.js?v=2"></script>}
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="월코, WOLKO, Word of Life Korea (월코), 워드오브라이프 코리아, 워드오브라이프, Word of Life Korea, 월비, 제주월비, WOLBI, 청소년 사역, 복음, 캠프, 영어캠프, 제주캠프, 다음 세대, 선교, 제자훈련">
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <!-- Naver Search Advisor 소유권 인증 -->
  <meta name="naver-site-verification" content="82acfea2246b60e8bd7ab6fb68bcfad2aabf2bd8">
  <!-- canonical -->
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()}>
  <!-- Open Graph -->
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()}>
  <meta property="og:image" content={new URL(ogImage, Astro.site).toString()}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="WOLKO 월코">
  <!-- 개별 페이지 head 확장용 슬롯 -->
  <slot name="head" />
  <link rel="stylesheet" href="/wolko-ui.css?v=6">
</head>
<body>
  <!-- 본문 바로가기 — 키보드로 들어오면 첫 Tab 에 보이고, 누르면 메뉴를 건너 본문(main#main)으로 간다 -->
  <a class="skip-link" href="#main"><span class="wl-ko">본문 바로가기</span><span class="wl-en">Skip to main content</span></a>

  <!-- NAV -->
  <nav class={`nav${whiteNav ? ' always-white' : ''}${languageOnlyNav ? ' language-only' : ''}`} id="mainNav">
    <a href="/" class="nav-logo">
      <img src="/images/WOLKO_logo_transparent.png?v=2" alt="WOLKO 월코">
    </a>
    <ul class="nav-menu">
      <li class="nav-item">
        <a href="/" class={`nav-link${activeNav === 'home' ? ' active' : ''}`} aria-current={activeNav === 'home' ? 'true' : undefined}>HOME</a>
      </li>
      <li class="nav-item">
        <a href="/about" class={`nav-link has-dropdown${activeNav === 'about' ? ' active' : ''}`} aria-current={activeNav === 'about' ? 'true' : undefined}>
          <span class="wl-ko">소개</span><span class="wl-en">About</span>
        </a>
        <ul class="nav-dropdown">
          <li><a href="/about"><span class="wl-ko">월코소개</span><span class="wl-en">About WOLKO</span></a></li>
          <li><a href="/people"><span class="wl-ko">섬기는이</span><span class="wl-en">Our Team</span></a></li>
          <li><a href="/endorsements"><span class="wl-ko">추천사</span><span class="wl-en">Endorsements</span></a></li>
        </ul>
      </li>
      <li class="nav-item">
        <a href="/ministry" data-direct-link class={`nav-link has-dropdown${activeNav === 'ministry' ? ' active' : ''}`} aria-current={activeNav === 'ministry' ? 'true' : undefined}>
          <span class="wl-ko">사역</span><span class="wl-en">Ministry</span>
        </a>
        <ul class="nav-dropdown">
          <li><a href="/camp"><span class="wl-ko">캠프사역</span><span class="wl-en">Camp Ministry</span></a></li>
          <li><a href="/wolbi-jeju"><span class="wl-ko">제주월비</span><span class="wl-en">Jeju WOLBI</span></a></li>
          <li><a href="/youth"><span class="wl-ko">청소년 사역</span><span class="wl-en">Youth Ministry</span></a></li>
          <li><a href="/jr-syme">Jr. SYME</a></li>
        </ul>
      </li>
      <li class="nav-item">
        <a href="/mission-report" class={`nav-link has-dropdown${activeNav === 'connect' ? ' active' : ''}`} aria-current={activeNav === 'connect' ? 'true' : undefined}>
          <span class="wl-ko">소통</span><span class="wl-en">Connect</span>
        </a>
        <ul class="nav-dropdown">
          <li><a href="/contact"><span class="wl-ko">문의</span><span class="wl-en">Contact</span></a></li>
          <li><a href="/mission-report"><span class="wl-ko">선교보고</span><span class="wl-en">Mission Reports</span></a></li>
          <li><a href="/camp-register"><span class="wl-ko">캠프 신청</span><span class="wl-en">Camp Register</span></a></li>
          <li><a href="/rsvp"><span class="wl-ko">이벤트 참석 신청</span><span class="wl-en">Event RSVP</span></a></li>
        </ul>
      </li>
      <li class="nav-item">
        <a href="/give" class={`nav-link has-dropdown${activeNav === 'give' ? ' active' : ''}`} aria-current={activeNav === 'give' ? 'true' : undefined}>
          <span class="wl-ko">후원</span><span class="wl-en">Give</span>
        </a>
        <ul class="nav-dropdown">
          <li><a href="/give"><span class="wl-ko">월코후원</span><span class="wl-en">Support WOLKO</span></a></li>
        </ul>
      </li>
      <li class="nav-item">
        <a href="/location" class={`nav-link${activeNav === 'location' ? ' active' : ''}`} aria-current={activeNav === 'location' ? 'true' : undefined}>
          <span class="wl-ko">오시는길</span><span class="wl-en">Location</span>
        </a>
      </li>
    </ul>
    <div class="nav-right">
      <!-- 언어 단추: 누르면 영어 화면이 켜지고(aria-pressed=true) 다시 누르면 한국어. 이름은 언어를 바꿔도 같다 -->
      <button type="button" class="lang-toggle" id="langToggle" aria-pressed="false">
        <span class="lang-slider" id="langSlider" aria-hidden="true"></span>
        <span class="lang-side is-active" id="langKo" aria-hidden="true">
          <img src="/images/flags/kr.svg" alt="">
          <span>KO</span>
        </span>
        <span class="lang-side is-inactive" id="langEn" aria-hidden="true">
          <img src="/images/flags/us.svg?v=2" alt="">
          <span>EN</span>
        </span>
        <span class="sr-only" lang="en">English</span>
      </button>
      <button type="button" class="nav-hamburger" id="hamburger" aria-controls="mobileMenu" aria-expanded="false" onclick="toggleMobile()">
        <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
        <span class="sr-only"><span class="wl-ko">메뉴</span><span class="wl-en">Menu</span></span>
      </button>
    </div>
  </nav>

  <!-- 모바일 메뉴 딤 배경 -->
  <div class="mobile-menu-backdrop" id="menuBackdrop" onclick="toggleMobile()"></div>

  <!-- 모바일 메뉴 -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-item"><a href="/">HOME</a></div>
    <div class="mobile-menu-divider"></div>

    <div class="mobile-menu-item">
      <button class="mobile-parent" type="button" onclick="toggleMobileSub(this)" aria-controls="mobileAboutSub" aria-expanded="false">
        <span><span class="wl-ko">소개</span><span class="wl-en">About</span></span>
        <span class="mobile-parent-chevron" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="#004f68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <ul class="mobile-sub" id="mobileAboutSub">
        <li><a href="/about"><span class="wl-ko">월코소개</span><span class="wl-en">About WOLKO</span></a></li>
        <li><a href="/people"><span class="wl-ko">섬기는이</span><span class="wl-en">Our Team</span></a></li>
        <li><a href="/endorsements"><span class="wl-ko">추천사</span><span class="wl-en">Endorsements</span></a></li>
      </ul>
    </div>

    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-item">
      <button class="mobile-parent" type="button" onclick="toggleMobileSub(this)" aria-controls="mobileMinistrySub" aria-expanded="false">
        <span><span class="wl-ko">사역</span><span class="wl-en">Ministry</span></span>
        <span class="mobile-parent-chevron" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="#004f68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <ul class="mobile-sub" id="mobileMinistrySub">
        <li><a class="mobile-sub-overview" href="/ministry"><span class="wl-ko">사역 전체 소개</span><span class="wl-en">All Ministries</span></a></li>
        <li><a href="/camp"><span class="wl-ko">캠프사역</span><span class="wl-en">Camp Ministry</span></a></li>
        <li><a href="/wolbi-jeju"><span class="wl-ko">제주월비</span><span class="wl-en">Jeju WOLBI</span></a></li>
        <li><a href="/youth"><span class="wl-ko">청소년 사역</span><span class="wl-en">Youth Ministry</span></a></li>
        <li><a href="/jr-syme">Jr. SYME</a></li>
      </ul>
    </div>

    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-item">
      <button class="mobile-parent" type="button" onclick="toggleMobileSub(this)" aria-controls="mobileConnectSub" aria-expanded="false">
        <span><span class="wl-ko">소통</span><span class="wl-en">Connect</span></span>
        <span class="mobile-parent-chevron" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="#004f68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <ul class="mobile-sub" id="mobileConnectSub">
        <li><a href="/contact"><span class="wl-ko">문의</span><span class="wl-en">Contact</span></a></li>
        <li><a href="/mission-report"><span class="wl-ko">선교보고</span><span class="wl-en">Mission Reports</span></a></li>
        <li><a href="/camp-register"><span class="wl-ko">캠프 신청</span><span class="wl-en">Camp Register</span></a></li>
        <li><a href="/rsvp"><span class="wl-ko">이벤트 참석 신청</span><span class="wl-en">Event RSVP</span></a></li>
      </ul>
    </div>

    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-item">
      <button class="mobile-parent" type="button" onclick="toggleMobileSub(this)" aria-controls="mobileGiveSub" aria-expanded="false">
        <span><span class="wl-ko">후원</span><span class="wl-en">Give</span></span>
        <span class="mobile-parent-chevron" aria-hidden="true">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="#004f68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <ul class="mobile-sub" id="mobileGiveSub">
        <li><a href="/give"><span class="wl-ko">월코후원</span><span class="wl-en">Support WOLKO</span></a></li>
      </ul>
    </div>

    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-item">
      <a href="/location"><span class="wl-ko">오시는길</span><span class="wl-en">Location</span></a>
    </div>
  </div>

  <!-- 페이지 콘텐츠 — 본문 바로가기의 도착점. 페이지 안에는 main 을 따로 두지 않는다(한 페이지에 main 은 하나) -->
  <main id="main" tabindex="-1">
    <div id={langRoot}>
      <slot />
    </div>
  </main>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-logo">
        <div class="footer-logo-lockup">
          <img src="/images/wolko-logo-reverse.svg?v=2" alt="WOLKO 월코 — Word of Life Korea" width="185" height="36">
        </div>
        <p class="footer-desc">
          <span class="wl-ko">복음전파와 제자훈련으로<br>한국의 다음 세대를 섬깁니다.<br><br>Word of Life Korea (월코)</span>
          <span class="wl-en">Reaching the next generation of Korea<br>through the Gospel and discipleship.<br><br>Word of Life Korea</span>
        </p>
      </div>
      <div class="footer-col">
        <p class="footer-col-title"><span class="wl-ko">소개</span><span class="wl-en">ABOUT</span></p>
        <a href="/about"><span class="wl-ko">월코소개</span><span class="wl-en">About WOLKO</span></a>
        <a href="/people"><span class="wl-ko">섬기는이</span><span class="wl-en">Our Team</span></a>
        <a href="/endorsements"><span class="wl-ko">추천사</span><span class="wl-en">Endorsements</span></a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title"><a href="/ministry"><span class="wl-ko">사역</span><span class="wl-en">MINISTRY</span></a></p>
        <a href="/camp"><span class="wl-ko">캠프사역</span><span class="wl-en">Camp Ministry</span></a>
        <a href="/wolbi-jeju"><span class="wl-ko">제주월비</span><span class="wl-en">Jeju WOLBI</span></a>
        <a href="/youth"><span class="wl-ko">청소년 사역</span><span class="wl-en">Youth Ministry</span></a>
        <a href="/jr-syme">Jr. SYME</a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title"><span class="wl-ko">소통</span><span class="wl-en">CONNECT</span></p>
        <a href="/contact"><span class="wl-ko">문의</span><span class="wl-en">Contact</span></a>
        <a href="/mission-report"><span class="wl-ko">선교보고</span><span class="wl-en">Mission Reports</span></a>
        <a href="/camp-register"><span class="wl-ko">캠프 신청</span><span class="wl-en">Camp Register</span></a>
        <a href="/rsvp"><span class="wl-ko">이벤트 참석 신청</span><span class="wl-en">Event RSVP</span></a>
      </div>
      <div class="footer-col">
        <!-- 위 메뉴와 같은 순서: 소개 · 사역 · 소통 · 후원 · 오시는길 -->
        <p class="footer-col-title"><span class="wl-ko">후원</span><span class="wl-en">GIVE</span></p>
        <a href="/give"><span class="wl-ko">월코후원</span><span class="wl-en">Support WOLKO</span></a>
        <p class="footer-col-title footer-col-title--sub"><a href="/location"><span class="wl-ko">오시는길</span><span class="wl-en">LOCATION</span></a></p>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© {year} Word of Life Korea. All rights reserved.</span>
      <span>경기도 평택시 경기대로 1407, 2층 | 제주시 애월읍 광상로 622</span>
    </div>
  </footer>

  <script define:vars={{ whiteNav, langRoot }}>
    // 네비 스크롤 효과 — whiteNav 페이지도 스크롤 시 상단 고정 애니메이션 적용
    const nav = document.getElementById('mainNav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 40);
    });

    // 스크롤바는 스크롤 중에만 살짝 보였다가 멈추면 사라진다(global.css 참고).
    let scrollbarFadeTimer;
    window.addEventListener('scroll', () => {
      document.documentElement.classList.add('is-scrolling');
      clearTimeout(scrollbarFadeTimer);
      scrollbarFadeTimer = setTimeout(() => {
        document.documentElement.classList.remove('is-scrolling');
      }, 900);
    }, { passive: true });

    // 언어 토글
    const langRootTargets = [
      document.getElementById(langRoot),
      ...document.querySelectorAll('#wl-root')
    ].filter(Boolean);
    const slider = document.getElementById('langSlider');
    const koSide = document.getElementById('langKo');
    const enSide = document.getElementById('langEn');
    let isEn = false;

    function syncLangSliderPosition() {
      if (!isEn) {
        slider.style.left = '3px';
        return;
      }
      const toggle = document.getElementById('langToggle');
      const sliderW = slider.offsetWidth || (window.innerWidth <= 1500 ? 31 : 55);
      slider.style.left = (toggle.clientWidth - sliderW - 3) + 'px';   // 테두리를 뺀 안쪽 폭 기준 — 양쪽 여백이 3px로 같게
    }

    function applyLang(en) {
      isEn = en;
      // 페이지 콘텐츠 루트에 lang-en 클래스 적용
      langRootTargets.forEach(function(el) { el.classList.toggle('lang-en', en); });
      document.documentElement.classList.toggle('lang-en', en);
      document.body.classList.toggle('lang-en', en);
      // 네비, 모바일메뉴, 푸터 모두 적용
      document.getElementById('mainNav').classList.toggle('lang-en', en);
      document.getElementById('mobileMenu').classList.toggle('lang-en', en);
      document.querySelector('.footer').classList.toggle('lang-en', en);

      if (en) {
        koSide.className = 'lang-side is-inactive';
        enSide.className = 'lang-side is-active';
      } else {
        koSide.className = 'lang-side is-active';
        enSide.className = 'lang-side is-inactive';
      }
      // 화면 읽기 프로그램·번역기가 지금 언어를 알도록 문서 언어와 단추 상태도 함께 바꾼다
      document.documentElement.lang = en ? 'en' : 'ko';
      document.getElementById('langToggle')?.setAttribute('aria-pressed', en ? 'true' : 'false');
      syncLangSliderPosition();
      try { localStorage.setItem('wolko-lang', en ? 'en' : 'ko'); } catch(e) {}
      restoreHashScroll();
      setTimeout(restoreHashScroll, 160);
    }

    window.toggleLang = function() { applyLang(!isEn); };
    document.getElementById('langToggle')?.addEventListener('click', window.toggleLang);
    window.addEventListener('resize', syncLangSliderPosition);

    function restoreHashScroll() {
      if (!window.location.hash || window.location.hash === '#partnerChurches') return;   // 협력 교회 목록 주소로 들어와도 첫 화면부터 보인다
      const target = document.getElementById(window.location.hash.slice(1));
      if (!target) return;
      requestAnimationFrame(function() {
        target.scrollIntoView({ block: 'start' });
      });
    }
    // 본문 바로가기: 주소(#main)를 바꾸지 않고 초점만 본문으로 옮긴다 — 주소에 #main 이 남으면 언어를 바꿀 때 맨 위로 튀기 때문
    document.querySelector('.skip-link')?.addEventListener('click', function(e) {
      const main = document.getElementById('main');
      if (!main) return;
      e.preventDefault();
      main.focus();
    });

    const hamburger = document.getElementById('hamburger');
    function closeMobileMenu(leaveFocus) {
      const menu = document.getElementById('mobileMenu');
      const backdrop = document.getElementById('menuBackdrop');
      menu.classList.remove('open');
      backdrop.classList.remove('open');
      hamburger?.setAttribute('aria-expanded', 'false');
      clearTimeout(window.__mobileMenuHideTimer);
      window.__mobileMenuHideTimer = setTimeout(function() {
        if (!menu.classList.contains('open')) {
          menu.style.display = 'none';
          backdrop.style.display = 'none';
        }
      }, 200);
      document.querySelectorAll('.mobile-menu-item.is-open').forEach(function(el) {
        el.classList.remove('is-open');
        el.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'false');
      });
      // 초점이 닫히는 메뉴 안에 있었으면 갈 곳을 잃지 않게 메뉴 단추로 돌려보낸다
      if (!leaveFocus && hamburger && menu.contains(document.activeElement)) hamburger.focus({ preventScroll: true });
    }

    window.toggleMobile = function() {
      const menu = document.getElementById('mobileMenu');
      const backdrop = document.getElementById('menuBackdrop');
      if (menu.classList.contains('open')) {
        closeMobileMenu();
      } else {
        clearTimeout(window.__mobileMenuHideTimer);
        menu.style.display = 'block';
        backdrop.style.display = 'block';
        // 화면 갱신(requestAnimationFrame)을 기다리지 않는다 — 영상·큰 이미지로 화면이 바쁜 폰에서는 갱신이 늦어져
        // 메뉴가 안 보이는 동안 터치가 뒤의 딤 배경으로 가서 메뉴가 안 눌리거나 바로 닫히곤 했다.
        // 강제로 레이아웃을 한 번 계산(offsetWidth)한 뒤 바로 클래스를 붙이면 열림 애니메이션은 그대로 재생된다.
        // 지금 페이지가 들어 있는 묶음은 펼친 채로 연다
        const cur = menu.querySelector('.mobile-menu-item.has-current');
        if (cur && cur.querySelector('.mobile-sub') && !menu.querySelector('.mobile-menu-item.is-open')) {
          cur.classList.add('is-open');
          cur.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'true');
        }
        void menu.offsetWidth;
        menu.classList.add('open');
        backdrop.classList.add('open');
        hamburger?.setAttribute('aria-expanded', 'true');
        // 열면 메뉴 첫 링크로 초점을 옮긴다(키보드·화면 읽기 프로그램이 바로 메뉴를 고를 수 있게)
        menu.querySelector('a[href], button')?.focus({ preventScroll: true });
      }
    };
    // Esc 로 닫고 초점을 메뉴 단추로 돌려보낸다
    document.addEventListener('keydown', function(e) {
      if (e.key !== 'Escape') return;
      const menu = document.getElementById('mobileMenu');
      if (!menu.classList.contains('open')) return;
      closeMobileMenu();
      hamburger?.focus({ preventScroll: true });
    });
    // 메뉴 끝에서 Tab 으로 본문에 나가면 닫는다 — 덮인 화면 뒤에 초점이 숨지 않게.
    // 초점이 갈 곳이 정해진 경우(relatedTarget)만 본다. 손가락으로 빈 곳을 눌러 초점이 잠깐 사라질 때는 닫지 않는다.
    // 위 메뉴 막대(언어·메뉴 단추)로 가는 것은 덮인 곳이 아니므로 열어 둔다(지금처럼 메뉴를 연 채 언어를 바꿀 수 있게).
    document.getElementById('mobileMenu').addEventListener('focusout', function(e) {
      const menu = e.currentTarget;
      const to = e.relatedTarget;
      if (!to || !menu.classList.contains('open') || menu.contains(to) || to.closest('#mainNav')) return;
      closeMobileMenu(true);
    });
    // 지금 보고 있는 페이지를 메뉴에서 강조한다 — 주소가 가장 길게 맞는 링크 하나(하위 페이지도 포함), 그 묶음 제목도 함께
    (function markCurrent() {
      const here = location.pathname.replace(/\/+$/, '') || '/';
      let best = null, bestLen = -1;
      document.querySelectorAll('#mobileMenu a[href^="/"]').forEach(function(a) {
        const href = a.getAttribute('href').replace(/[?#].*$/, '').replace(/\/+$/, '') || '/';
        const hit = href === '/' ? here === '/' : (here === href || here.startsWith(href + '/'));
        if (hit && href.length > bestLen) { best = a; bestLen = href.length; }
      });
      if (!best) return;
      best.classList.add('is-current');
      best.setAttribute('aria-current', 'page');
      best.closest('.mobile-menu-item')?.classList.add('has-current');
    })();

    window.toggleMobileSub = function(btn) {
      const item = btn.closest('.mobile-menu-item');
      const isOpen = item.classList.contains('is-open');
      // 다른 열린 항목 닫기
      document.querySelectorAll('.mobile-menu-item.is-open').forEach(function(el) {
        el.classList.remove('is-open');
        el.querySelector('[aria-expanded]')?.setAttribute('aria-expanded', 'false');
      });
      if (!isOpen) {
        item.classList.add('is-open');
        btn.setAttribute('aria-expanded', 'true');
      }
    };

    document.querySelectorAll('.nav-item').forEach(function(item) {
      const trigger = item.querySelector('.nav-link.has-dropdown');
      const dropdown = item.querySelector('.nav-dropdown');
      if (!trigger || !dropdown) return;

      function closeOtherDropdowns() {
        document.querySelectorAll('.nav-item.is-open').forEach(function(el) {
          if (el !== item) el.classList.remove('is-open');
        });
      }

      item.addEventListener('mouseenter', function() {
        closeOtherDropdowns();
        item.classList.add('is-open');
      });
      item.addEventListener('mouseleave', function() {
        item.classList.remove('is-open');
      });
      item.addEventListener('focusin', function() {
        closeOtherDropdowns();
        item.classList.add('is-open');
      });
      item.addEventListener('focusout', function(e) {
        if (!item.contains(e.relatedTarget)) item.classList.remove('is-open');
      });
      trigger.addEventListener('click', function(e) {
        if (trigger.hasAttribute('data-direct-link')) return;
        if (window.matchMedia('(hover: none)').matches && !item.classList.contains('is-open')) {
          e.preventDefault();
          closeOtherDropdowns();
          item.classList.add('is-open');
        }
      });
    });
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.nav-item')) {
        document.querySelectorAll('.nav-item.is-open').forEach(function(el) { el.classList.remove('is-open'); });
      }
    });

    // 저장된 언어 설정 복원
    try {
      if (localStorage.getItem('wolko-lang') === 'en') applyLang(true);
    } catch(e) {}
    window.addEventListener('load', restoreHashScroll);
    setTimeout(restoreHashScroll, 350);
  </script>

  <!-- 모달 열릴 때 배경 스크롤 잠금 -->
  <script>
    (function() {
      function checkModalOpen() {
        const open =
          !!document.querySelector('.modal-backdrop.open') ||          // CRS
          !!document.querySelector('.crp-reg-modal:not([hidden])') ||  // camp-register
          (document.getElementById('reportModal')?.style.display === 'flex'); // team PDF
        document.body.classList.toggle('modal-open', open);
      }
      new MutationObserver(checkModalOpen).observe(document.body, {
        subtree: true, attributes: true,
        attributeFilter: ['class', 'hidden', 'style']
      });
    })();
  </script>
</body>
</html>
