---
import '../styles/global.css';
export interface Props {
  title: string;
  description?: string;
  activeNav?: string;   // 'home' | 'about' | 'ministry' | 'connect' | 'give' | 'location'
  whiteNav?: boolean;   // 흰 배경 네비 (히어로 이미지 없는 페이지용)
  langRoot?: string;    // 언어 토글 루트 id (없으면 기본 body)
}

const {
  title,
  description = '복음전파와 제자훈련으로 한국의 다음 세대를 섬깁니다 — Word of Life Korea',
  activeNav = '',
  whiteNav = false,
  langRoot = 'lang-root',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="keywords" content="월코, WOLKO, 한국생명의말씀협회, 워드오브라이프 코리아, 워드오브라이프, Word of Life Korea, 월비, 제주월비, WOLBI, 청소년 사역, 복음, 캠프, 영어캠프, 제주캠프, 다음 세대, 선교, 제자훈련">
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <!-- Naver Search Advisor 소유권 인증 -->
  <meta name="naver-site-verification" content="82acfea2246b60e8bd7ab6fb68bcfad2aabf2bd8">
  <!-- canonical -->
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site).toString()}>
  <!-- Open Graph -->
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).toString()}>
  <meta property="og:image" content={new URL('/images/WOLKO Circle.png', Astro.site).toString()}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="WOLKO 월코">
  <!-- 개별 페이지 head 확장용 슬롯 -->
  <slot name="head" />
</head>
<body>

  <!-- NAV -->
  <nav class={`nav${whiteNav ? ' always-white' : ''}`} id="mainNav">
    <a href="/" class="nav-logo">
      <img src="/images/WOLKO_logo_transparent.png" alt="WOLKO 월코">
    </a>
    <ul class="nav-menu">
      <li class="nav-item">
        <a href="/" class={`nav-link${activeNav === 'home' ? ' active' : ''}`}>HOME</a>
      </li>
      <li class="nav-item">
        <a href="/about" class={`nav-link has-dropdown${activeNav === 'about' ? ' active' : ''}`}>
          <span class="wl-ko">소개</span><span class="wl-en">About</span>
        </a>
        <ul class="nav-dropdown">
          <li><a href="/about"><span class="wl-ko">월코소개</span><span class="wl-en">About WOLKO</span></a></li>
          <li><a href="/people"><span class="wl-ko">섬기는이</span><span class="wl-en">Our Team</span></a></li>
          <li><a href="/endorsements"><span class="wl-ko">추천사</span><span class="wl-en">Endorsements</span></a></li>
        </ul>
      </li>
      <li class="nav-item">
        <a href="/camp" class={`nav-link has-dropdown${activeNav === 'ministry' ? ' active' : ''}`}>
          <span class="wl-ko">사역</span><span class="wl-en">Ministry</span>
        </a>
        <ul class="nav-dropdown">
          <li><a href="/camp"><span class="wl-ko">캠프사역</span><span class="wl-en">Camp Ministry</span></a></li>
          <li><a href="/wolbi-jeju"><span class="wl-ko">제주월비</span><span class="wl-en">Jeju WOLBI</span></a></li>
          <li><a href="/youth"><span class="wl-ko">청소년 사역</span><span class="wl-en">Youth Ministry</span></a></li>
          <li><a href="/jr-syme">Jr. SYME</a></li>
          <li><a href="/vietnam"><span class="wl-ko">베트남 선교</span><span class="wl-en">Vietnam Mission</span></a></li>
        </ul>
      </li>
      <li class="nav-item">
        <a href="/mission-report" class={`nav-link has-dropdown${activeNav === 'connect' ? ' active' : ''}`}>
          <span class="wl-ko">소통</span><span class="wl-en">Connect</span>
        </a>
        <ul class="nav-dropdown">
          <li><a href="/contact">Contact</a></li>
          <li><a href="/mission-report"><span class="wl-ko">선교보고</span><span class="wl-en">Mission Reports</span></a></li>
          <li><a href="/camp-register"><span class="wl-ko">캠프 신청</span><span class="wl-en">Camp Register</span></a></li>
        </ul>
      </li>
      {/* 자료실 — HIDDEN (준비 중, 나중에 주석 해제하면 복구)
      <li class="nav-item">
        <a href="/resources" class={`nav-link has-dropdown${activeNav === 'resources' ? ' active' : ''}`}>
          <span class="wl-ko">자료실</span><span class="wl-en">Resources</span>
        </a>
        <ul class="nav-dropdown">
          <li><a href="/resources/class-notes"><span class="wl-ko">수업 자료</span><span class="wl-en">Class Notes</span></a></li>
          <li><a href="/resources/qt-book"><span class="wl-ko">매일묵상집</span><span class="wl-en">Q.T Book</span></a></li>
          <li><a href="/resources/etc"><span class="wl-ko">그 외 자료들</span><span class="wl-en">Etc.</span></a></li>
        </ul>
      </li>
      */}
      <li class="nav-item">
        <a href="/give" class={`nav-link has-dropdown${activeNav === 'give' ? ' active' : ''}`}>
          <span class="wl-ko">후원</span><span class="wl-en">Give</span>
        </a>
        <ul class="nav-dropdown">
          <li><a href="/give"><span class="wl-ko">월코후원</span><span class="wl-en">Support WOLKO</span></a></li>
        </ul>
      </li>
      <li class="nav-item">
        <a href="/location" class={`nav-link${activeNav === 'location' ? ' active' : ''}`}>
          <span class="wl-ko">오시는길</span><span class="wl-en">Location</span>
        </a>
      </li>
    </ul>
    <div class="nav-right">
      <div class="lang-toggle" id="langToggle">
        <div class="lang-slider" id="langSlider"></div>
        <div class="lang-side is-active" id="langKo">
          <img src="https://flagcdn.com/w40/kr.png" alt="KR">
          <span>한국어</span>
        </div>
        <div class="lang-side is-inactive" id="langEn">
          <img src="https://flagcdn.com/w40/us.png" alt="US">
          <span>English</span>
        </div>
      </div>
      <div class="nav-hamburger" id="hamburger" onclick="toggleMobile()">
        <span></span><span></span><span></span>
      </div>
    </div>
  </nav>

  <!-- 모바일 메뉴 딤 배경 -->
  <div class="mobile-menu-backdrop" id="menuBackdrop" onclick="toggleMobile()"></div>

  <!-- 모바일 메뉴 -->
  <div class="mobile-menu" id="mobileMenu">
    <div class="mobile-menu-item"><a href="/">HOME</a></div>
    <div class="mobile-menu-divider"></div>

    <div class="mobile-menu-item">
      <button class="mobile-parent" onclick="toggleMobileSub(this)">
        <span><span class="wl-ko">소개</span><span class="wl-en">About</span></span>
        <span class="mobile-parent-chevron">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="#004f68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <ul class="mobile-sub">
        <li><a href="/about"><span class="wl-ko">월코소개</span><span class="wl-en">About WOLKO</span></a></li>
        <li><a href="/people"><span class="wl-ko">섬기는이</span><span class="wl-en">Our Team</span></a></li>
        <li><a href="/endorsements"><span class="wl-ko">추천사</span><span class="wl-en">Endorsements</span></a></li>
      </ul>
    </div>

    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-item">
      <button class="mobile-parent" onclick="toggleMobileSub(this)">
        <span><span class="wl-ko">사역</span><span class="wl-en">Ministry</span></span>
        <span class="mobile-parent-chevron">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="#004f68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <ul class="mobile-sub">
        <li><a href="/camp"><span class="wl-ko">캠프사역</span><span class="wl-en">Camp Ministry</span></a></li>
        <li><a href="/wolbi-jeju"><span class="wl-ko">제주월비</span><span class="wl-en">Jeju WOLBI</span></a></li>
        <li><a href="/youth"><span class="wl-ko">청소년 사역</span><span class="wl-en">Youth Ministry</span></a></li>
        <li><a href="/jr-syme">Jr. SYME</a></li>
        <li><a href="/vietnam"><span class="wl-ko">베트남 선교</span><span class="wl-en">Vietnam Mission</span></a></li>
      </ul>
    </div>

    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-item">
      <button class="mobile-parent" onclick="toggleMobileSub(this)">
        <span><span class="wl-ko">소통</span><span class="wl-en">Connect</span></span>
        <span class="mobile-parent-chevron">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="#004f68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <ul class="mobile-sub">
        <li><a href="/contact">Contact</a></li>
        <li><a href="/mission-report"><span class="wl-ko">선교보고</span><span class="wl-en">Mission Reports</span></a></li>
        <li><a href="/camp-register"><span class="wl-ko">캠프 신청</span><span class="wl-en">Camp Register</span></a></li>
      </ul>
    </div>

    {/* 자료실 모바일 — HIDDEN (준비 중, 나중에 주석 해제하면 복구)
    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-item">
      <button class="mobile-parent" onclick="toggleMobileSub(this)">
        <span><span class="wl-ko">자료실</span><span class="wl-en">Resources</span></span>
        <span class="mobile-parent-chevron">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="#004f68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <ul class="mobile-sub">
        <li><a href="/resources/class-notes"><span class="wl-ko">수업 자료</span><span class="wl-en">Class Notes</span></a></li>
        <li><a href="/resources/qt-book"><span class="wl-ko">매일묵상집</span><span class="wl-en">Q.T Book</span></a></li>
        <li><a href="/resources/etc"><span class="wl-ko">그 외 자료들</span><span class="wl-en">Etc.</span></a></li>
      </ul>
    </div>
    */}

    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-item">
      <button class="mobile-parent" onclick="toggleMobileSub(this)">
        <span><span class="wl-ko">후원</span><span class="wl-en">Give</span></span>
        <span class="mobile-parent-chevron">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5l5 5 5-5" stroke="#004f68" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
      </button>
      <ul class="mobile-sub">
        <li><a href="/give"><span class="wl-ko">월코후원</span><span class="wl-en">Support WOLKO</span></a></li>
      </ul>
    </div>

    <div class="mobile-menu-divider"></div>
    <div class="mobile-menu-item">
      <a href="/location"><span class="wl-ko">오시는길</span><span class="wl-en">Location</span></a>
    </div>
  </div>

  <!-- 페이지 콘텐츠 -->
  <div id={langRoot}>
    <slot />
  </div>

  <!-- FOOTER -->
  <footer class="footer">
    <div class="footer-inner">
      <div class="footer-logo">
        <div class="footer-logo-lockup">
          <img src="/images/WOLKO Circle.png" alt="WOLKO">
          <div class="footer-logo-text">
            <span class="footer-logo-name">WOLKO 월코</span>
            <span class="footer-logo-sub">Word of Life Korea</span>
          </div>
        </div>
        <p class="footer-desc">
          <span class="wl-ko">복음전파와 제자훈련으로<br>한국의 다음 세대를 섬깁니다.<br><br>한국생명의말씀협회<br>Word of Life Korea</span>
          <span class="wl-en">Reaching the next generation of Korea<br>through the Gospel and discipleship.<br><br>Word of Life Korea</span>
        </p>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">ABOUT</p>
        <a href="/about"><span class="wl-ko">월코소개</span><span class="wl-en">About WOLKO</span></a>
        <a href="/people"><span class="wl-ko">섬기는이</span><span class="wl-en">Our Team</span></a>
        <a href="/endorsements"><span class="wl-ko">추천사</span><span class="wl-en">Endorsements</span></a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">MINISTRY</p>
        <a href="/camp"><span class="wl-ko">캠프사역</span><span class="wl-en">Camp Ministry</span></a>
        <a href="/wolbi-jeju"><span class="wl-ko">제주월비</span><span class="wl-en">Jeju WOLBI</span></a>
        <a href="/youth"><span class="wl-ko">청소년 사역</span><span class="wl-en">Youth Ministry</span></a>
        <a href="/jr-syme">Jr. SYME</a>
        <a href="/vietnam"><span class="wl-ko">베트남 선교</span><span class="wl-en">Vietnam Mission</span></a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">CONNECT</p>
        <a href="/contact">Contact</a>
        <a href="/mission-report"><span class="wl-ko">선교보고</span><span class="wl-en">Mission Reports</span></a>
        <a href="/camp-register"><span class="wl-ko">캠프 신청</span><span class="wl-en">Camp Register</span></a>
      </div>
      <div class="footer-col">
        <p class="footer-col-title">MORE</p>
        <a href="/give"><span class="wl-ko">월코후원</span><span class="wl-en">Support WOLKO</span></a>
        <a href="/location"><span class="wl-ko">오시는길</span><span class="wl-en">Location</span></a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>© 2025 Word of Life Korea. All rights reserved.</span>
      <span>경기도 평택시 경기대로 1407, 2층 | 제주시 애월읍 광상로 622</span>
    </div>
  </footer>

  <script define:vars={{ whiteNav, langRoot }}>
    // 네비 스크롤 효과 — whiteNav 페이지도 스크롤 시 상단 고정 애니메이션 적용
    const nav = document.getElementById('mainNav');
    window.addEventListener('scroll', () => {
      nav.classList.toggle('scrolled', window.scrollY > 40);
    });

    // 언어 토글
    const langRootTargets = [
      document.getElementById(langRoot),
      ...document.querySelectorAll('#wl-root')
    ].filter(Boolean);
    const slider = document.getElementById('langSlider');
    const koSide = document.getElementById('langKo');
    const enSide = document.getElementById('langEn');
    let isEn = false;

    function syncLangSliderPosition() {
      if (!isEn) {
        slider.style.left = '3px';
        return;
      }
      const toggle = document.getElementById('langToggle');
      const sliderW = slider.offsetWidth || (window.innerWidth <= 1500 ? 32 : 78);
      slider.style.left = (toggle.offsetWidth - sliderW - 3) + 'px';
    }

    function applyLang(en) {
      isEn = en;
      // 페이지 콘텐츠 루트에 lang-en 클래스 적용
      langRootTargets.forEach(function(el) { el.classList.toggle('lang-en', en); });
      document.documentElement.classList.toggle('lang-en', en);
      document.body.classList.toggle('lang-en', en);
      // 네비, 모바일메뉴, 푸터 모두 적용
      document.getElementById('mainNav').classList.toggle('lang-en', en);
      document.getElementById('mobileMenu').classList.toggle('lang-en', en);
      document.querySelector('.footer').classList.toggle('lang-en', en);

      if (en) {
        koSide.className = 'lang-side is-inactive';
        enSide.className = 'lang-side is-active';
      } else {
        koSide.className = 'lang-side is-active';
        enSide.className = 'lang-side is-inactive';
      }
      syncLangSliderPosition();
      try { localStorage.setItem('wolko-lang', en ? 'en' : 'ko'); } catch(e) {}
      restoreHashScroll();
      setTimeout(restoreHashScroll, 160);
    }

    window.toggleLang = function() { applyLang(!isEn); };
    document.getElementById('langToggle')?.addEventListener('click', window.toggleLang);
    window.addEventListener('resize', syncLangSliderPosition);

    function restoreHashScroll() {
      if (!window.location.hash) return;
      const target = document.getElementById(window.location.hash.slice(1));
      if (!target) return;
      requestAnimationFrame(function() {
        target.scrollIntoView({ block: 'start' });
      });
    }
    function closeMobileMenu() {
      const menu = document.getElementById('mobileMenu');
      const backdrop = document.getElementById('menuBackdrop');
      menu.classList.remove('open');
      backdrop.classList.remove('open');
      setTimeout(function() {
        if (!menu.classList.contains('open')) {
          menu.style.display = 'none';
          backdrop.style.display = 'none';
        }
      }, 200);
      document.querySelectorAll('.mobile-menu-item.is-open').forEach(function(el) { el.classList.remove('is-open'); });
    }

    window.toggleMobile = function() {
      const menu = document.getElementById('mobileMenu');
      const backdrop = document.getElementById('menuBackdrop');
      if (menu.classList.contains('open')) {
        closeMobileMenu();
      } else {
        menu.style.display = 'block';
        backdrop.style.display = 'block';
        requestAnimationFrame(function() {
          requestAnimationFrame(function() {
            menu.classList.add('open');
            backdrop.classList.add('open');
          });
        });
      }
    };
    window.toggleMobileSub = function(btn) {
      const item = btn.closest('.mobile-menu-item');
      const isOpen = item.classList.contains('is-open');
      // 다른 열린 항목 닫기
      document.querySelectorAll('.mobile-menu-item.is-open').forEach(function(el) {
        el.classList.remove('is-open');
      });
      if (!isOpen) item.classList.add('is-open');
    };

    document.querySelectorAll('.nav-item').forEach(function(item) {
      const trigger = item.querySelector('.nav-link.has-dropdown');
      const dropdown = item.querySelector('.nav-dropdown');
      if (!trigger || !dropdown) return;

      function closeOtherDropdowns() {
        document.querySelectorAll('.nav-item.is-open').forEach(function(el) {
          if (el !== item) el.classList.remove('is-open');
        });
      }

      item.addEventListener('mouseenter', function() {
        closeOtherDropdowns();
        item.classList.add('is-open');
      });
      item.addEventListener('mouseleave', function() {
        item.classList.remove('is-open');
      });
      item.addEventListener('focusin', function() {
        closeOtherDropdowns();
        item.classList.add('is-open');
      });
      item.addEventListener('focusout', function(e) {
        if (!item.contains(e.relatedTarget)) item.classList.remove('is-open');
      });
      trigger.addEventListener('click', function(e) {
        if (window.matchMedia('(hover: none)').matches && !item.classList.contains('is-open')) {
          e.preventDefault();
          closeOtherDropdowns();
          item.classList.add('is-open');
        }
      });
    });
    document.addEventListener('click', function(e) {
      if (!e.target.closest('.nav-item')) {
        document.querySelectorAll('.nav-item.is-open').forEach(function(el) { el.classList.remove('is-open'); });
      }
    });

    // 저장된 언어 설정 복원
    try {
      if (localStorage.getItem('wolko-lang') === 'en') applyLang(true);
    } catch(e) {}
    window.addEventListener('load', restoreHashScroll);
    setTimeout(restoreHashScroll, 350);
  </script>

  <!-- 모달 열릴 때 배경 스크롤 잠금 -->
  <script>
    (function() {
      function checkModalOpen() {
        const open =
          !!document.querySelector('.modal-backdrop.open') ||          // CRS
          !!document.querySelector('.crp-reg-modal:not([hidden])') ||  // camp-register
          (document.getElementById('reportModal')?.style.display === 'flex'); // team PDF
        document.body.classList.toggle('modal-open', open);
      }
      new MutationObserver(checkModalOpen).observe(document.body, {
        subtree: true, attributes: true,
        attributeFilter: ['class', 'hidden', 'style']
      });
    })();
  </script>
</body>
</html>
