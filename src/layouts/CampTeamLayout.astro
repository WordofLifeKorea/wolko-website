---
// 캠프팀 포털 공통 틀 (사이드바 + 언어 전환 + 로그인 안내). 내용은 각 페이지가 채운다.
export interface Props { title: string; active: 'home' | 'camps' | 'tasks' | 'meetings' | 'files' | 'resources' | 'search' | 'budget' | 'tv' | 'trash' | 'settings'; }
const { title, active } = Astro.props;
const nav = [
  { key: 'home', href: '/campteam/', t: 'navHome', e: '🏠', c: '#3b8ff0' },
  { key: 'camps', href: '/campteam/camps/', t: 'navCamps', e: '🏕️', c: '#9bbf1f' },
  { key: 'tasks', href: '/campteam/tasks/', t: 'navTasks', e: '✅', c: '#22b573' },
  { key: 'meetings', href: '/campteam/meetings/', t: 'navMeetings', e: '📝', c: '#8b6cf0' },
  { key: 'files', href: '/campteam/files/', t: 'navFiles', e: '📁', c: '#f0a020' },
  { key: 'resources', href: '/campteam/resources/', t: 'navResources', e: '📚', c: '#ec5fa0' },
  { key: 'tv', href: '/campteam/tv/', t: 'navTv', e: '📺', c: '#14b8c4' },
];
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <script is:inline src="/wolko-lang-sync.js?v=2"></script>
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
  <title>{title} — WOLKO Camp Team</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/campteam/campteam.css?v=3">
  <link rel="stylesheet" href="/campteam/tv.css?v=1">
  <script is:inline src="/wolko-session.js?v=2"></script>
</head>
<body>
<div class="app">
  <aside>
    <a class="logo" href="/campteam/"><img src="/images/WOLKO Circle.png" alt="WOLKO"><span><b>WOLKO Camp Team</b><small>Word of Life Korea</small></span></a>
    <form class="gsearch" action="/campteam/search/" method="get" role="search"><input type="search" name="q" minlength="2" maxlength="80" data-t-ph="searchAll" aria-label="search"></form>
    <nav class="nav">
      <h6 data-t="navGroupTeam"></h6>
      {nav.map(n => <a href={n.href} class={active === n.key ? 'on' : ''} style={`--c:${n.c}`}><span class="ic">{n.e}</span><span data-t={n.t}></span></a>)}
      <h6 id="moneyHead" hidden data-t="navFinance"></h6>
      <a id="moneyNav" href="/campteam/budget/" class={active === 'budget' ? 'on' : ''} style="--c:#d4a373" hidden><span class="ic">💰</span><span data-t="navBudget"></span></a>
      <a id="trashNav" href="/campteam/trash/" class={active === 'trash' ? 'on' : ''} style="--c:#9fb4c0" hidden><span class="ic">🗑️</span><span data-t="navTrash"></span></a>
      <h6 id="adminHead" hidden data-t="navAdmin"></h6>
      <a id="settingsNav" href="/campteam/settings/" class={active === 'settings' ? 'on' : ''} style="--c:#d155e6" hidden><span class="ic">⚙️</span><span data-t="navSettings"></span></a>
    </nav>
    <div class="side-foot">
      <a class="back" href="/portal/"><span data-t="backPortal"></span></a>
      <div class="lang"><button id="langKo" type="button">한국어</button><button id="langEn" type="button">English</button></div>
      <div class="who" id="who"></div>
    </div>
  </aside>
  <main id="main"><slot /></main>
</div>
<div class="gate" id="gate" hidden>
  <div class="gate-card">
    <h2 data-t="gateTitle"></h2>
    <p data-t="gateBody"></p>
    <a class="btn pri" href="/portal/" data-t="gateBtn"></a>
    <div id="gbtn" hidden style="margin-top:16px;border-top:1px solid var(--border);padding-top:14px"><p class="meta" data-t="gateGoogle" style="margin:0 0 8px"></p><div id="gbtnInner" style="display:flex;justify-content:center"></div></div>
    <p class="meta" id="gnote" style="color:var(--accent);margin:10px 0 0"></p>
  </div>
</div>
<script is:inline src="/campteam/campteam.js?v=2"></script>
<slot name="scripts" />
</body>
</html>
