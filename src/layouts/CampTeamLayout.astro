---
// 캠프팀 포털 공통 틀 (사이드바 + 언어 전환 + 로그인 안내). 내용은 각 페이지가 채운다.
export interface Props { title: string; active: 'home' | 'camps' | 'tasks' | 'meetings' | 'files' | 'resources' | 'search' | 'budget' | 'tv' | 'trash' | 'settings' | 'alerts' | 'calendar'; }
const { title, active } = Astro.props;
const ICON = {
  home: '<path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-5a2 2 0 0 1 4 0v5"/>',
  camps: '<path d="M3 20 12 4l9 16"/><path d="M9.5 20 12 15.5l2.5 4.5"/><path d="M2 20h20"/>',
  tasks: '<path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1z"/><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><path d="m9 13.5 2 2 4-4.5"/>',
  meetings: '<path d="M5 4h14a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-9l-4 3.5V17H5a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1z"/><path d="M8 9h8M8 12.5h5"/>',
  files: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/><path d="M9 13h6M9 17h4"/>',
  resources: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 11h18"/>',
  tv: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/><path d="m10.5 8.5 4 2-4 2z" fill="currentColor" stroke="none"/>',
  budget: '<path d="M4 8V6a2 2 0 0 1 2-2h11v4"/><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M16 14h2"/>',
  trash: '<path d="M4 7h16M10 11v6M14 11v6"/><path d="M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12"/><path d="M9 7V4h6v3"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="15.5" rx="2.5"/><path d="M3.5 10h17M8 3v4M16 3v4"/><path d="M8 14h2M12 14h2M16 14h.01M8 17.5h2"/>',
  alerts: '<path d="M6 9a6 6 0 0 1 12 0c0 5 2 6.5 2 6.5H4S6 14 6 9z"/><path d="M10 19a2 2 0 0 0 4 0"/>',
  settings: '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
};
// 메뉴 아이콘 — 포털 왼쪽 메뉴와 같은 방식의 색 있는 일러스트(32×32, 단색 면). 포털 그림과 겹치는 것(캠프 공간 = 수련원)은 같은 그림을 쓴다.
const ART = {
  home: '<path d="M3 15.500 16 4l13 11.500z" fill="#3b8ff0"/><rect x="6.500" y="14.500" width="19" height="14" rx="2.500" fill="#fff"/><rect x="21" y="6" width="3.200" height="6.500" rx="1.200" fill="#1f5fbf"/><rect x="12.800" y="19" width="6.400" height="9.500" rx="1.800" fill="#3b8ff0"/>',
  camps: '<path d="M10 19 21 4l11 15z" fill="#f0dc92"/><path d="M21 4l11 15H21z" fill="#e6cd74"/><path d="M3.500 28.500V25M3.500 14.500 .5 22.500h6zM3.500 19 .8 25.500h5.400z" fill="#4f9a5a"/><path d="M28.800 28.500V26M28.800 16.500l-2.800 7.500h5.600zM28.800 20.500l-2.500 6h5z" fill="#4f9a5a"/><rect x="20.800" y="8.500" width="3" height="6" fill="#8a5a2b"/><path d="M2.500 18.500 16 7.500l13.500 11z" fill="#d9a81a"/><path d="M16 7.500l13.500 11H16z" fill="#b98a0e"/><rect x="5.500" y="18.500" width="21" height="10" rx="1" fill="#fff6d1"/><rect x="16" y="18.500" width="10.500" height="10" fill="#f3e3a3"/><rect x="8" y="20.800" width="3.600" height="4" rx=".9" fill="#ffc83d"/><rect x="20.400" y="20.800" width="3.600" height="4" rx=".9" fill="#ffc83d"/><path d="M13.500 28.500V24a2.500 2.500 0 0 1 5 0v4.500z" fill="#8a5a2b"/><rect x="1.500" y="28" width="29" height="2.200" rx="1.100" fill="#7bb274"/>',
  tasks: '<rect x="5" y="5.500" width="22" height="24" rx="4" fill="#22b573"/><rect x="8" y="9.500" width="16" height="17.500" rx="2" fill="#fff"/><rect x="11" y="3" width="10" height="6.500" rx="2.200" fill="#14724a"/><path d="M11 18.500l3.200 3.200 6.300-7.200" stroke="#22b573" stroke-width="2.700" fill="none" stroke-linecap="round" stroke-linejoin="round"/>',
  calendar: '<rect x="4" y="5.500" width="24" height="22.500" rx="4.500" fill="#fff"/><path d="M4 10a4.500 4.500 0 0 1 4.500-4.500h15A4.500 4.500 0 0 1 28 10v3.500H4z" fill="#2aa6a0"/><rect x="9.500" y="2.500" width="3" height="6" rx="1.500" fill="#1a6f6b"/><rect x="19.500" y="2.500" width="3" height="6" rx="1.500" fill="#1a6f6b"/><rect x="8" y="16.500" width="4.500" height="3.800" rx="1.200" fill="#cdeceb"/><rect x="13.800" y="16.500" width="4.500" height="3.800" rx="1.200" fill="#2aa6a0"/><rect x="19.600" y="16.500" width="4.500" height="3.800" rx="1.200" fill="#cdeceb"/><rect x="8" y="22" width="4.500" height="3.800" rx="1.200" fill="#cdeceb"/><rect x="13.800" y="22" width="4.500" height="3.800" rx="1.200" fill="#cdeceb"/><rect x="19.600" y="22" width="4.500" height="3.800" rx="1.200" fill="#cdeceb"/>',
  meetings: '<path d="M13 11h14a4 4 0 0 1 4 4v7a4 4 0 0 1-4 4h-2v4l-5-4h-7a4 4 0 0 1-4-4v-7a4 4 0 0 1 4-4z" fill="#fff"/><path d="M5 3.500h16a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4h-7L8 24v-4.500H5a4 4 0 0 1-4-4v-8a4 4 0 0 1 4-4z" fill="#8b6cf0"/><circle cx="8.500" cy="11.500" r="1.700" fill="#fff"/><circle cx="13" cy="11.500" r="1.700" fill="#fff"/><circle cx="17.500" cy="11.500" r="1.700" fill="#fff"/>',
  files: '<path d="M3 9.500A3.500 3.500 0 0 1 6.500 6h5.500l3 3h10.500a3.500 3.500 0 0 1 3.500 3.500v13A3.500 3.500 0 0 1 25.500 29h-19A3.500 3.500 0 0 1 3 25.500z" fill="#d98a12"/><rect x="7" y="10.500" width="18" height="8" rx="1.500" fill="#fff"/><path d="M3 15.500A3.500 3.500 0 0 1 6.500 12h19a3.500 3.500 0 0 1 3.500 3.500v10A3.500 3.500 0 0 1 25.500 29h-19A3.500 3.500 0 0 1 3 25.500z" fill="#ffc14d"/>',
  resources: '<rect x="6" y="3.500" width="20" height="25" rx="3.500" fill="#fff"/><path d="M6 7a3.500 3.500 0 0 1 3.500-3.500H22.500A3.500 3.500 0 0 1 26 7v3H6z" fill="#ec5fa0"/><rect x="10" y="14" width="12" height="2.200" rx="1.100" fill="#f6b8d4"/><rect x="10" y="18.500" width="12" height="2.200" rx="1.100" fill="#f6b8d4"/><rect x="10" y="23" width="7" height="2.200" rx="1.100" fill="#f6b8d4"/>',
  tv: '<rect x="3" y="5" width="26" height="18" rx="4.500" fill="#14b8c4"/><rect x="6" y="8" width="20" height="12" rx="2.500" fill="#d6f6f8"/><path d="M14 10.800v6.400l5.400-3.200z" fill="#0e8f99"/><rect x="12.500" y="23" width="7" height="3" fill="#0e8f99"/><rect x="8" y="25.500" width="16" height="3" rx="1.500" fill="#0e8f99"/>',
  alerts: '<path d="M16 3.500a2.200 2.200 0 0 1 2.200 2.200v.7a8.200 8.200 0 0 1 6 7.900V19l2.800 4H5l2.800-4v-4.700a8.200 8.200 0 0 1 6-7.900v-.7A2.200 2.200 0 0 1 16 3.500z" fill="#f06a5f"/><path d="M12.200 25.500a3.800 3.800 0 0 0 7.600 0z" fill="#b83a32"/>',
  budget: '<rect x="3" y="8" width="26" height="19" rx="4.500" fill="#d98f3a"/><path d="M3 12.500A4.500 4.500 0 0 1 7.500 8H23v4.500z" fill="#f0b56a"/><rect x="18.500" y="14" width="10.500" height="7.500" rx="3.700" fill="#fff3d9"/><circle cx="23" cy="17.750" r="1.800" fill="#d98f3a"/>',
  trash: '<path d="M8 10h16l-1.300 16.500a3 3 0 0 1-3 2.700h-7.400a3 3 0 0 1-3-2.700z" fill="#8fa5b3"/><rect x="5" y="6.500" width="22" height="3.500" rx="1.750" fill="#6c8494"/><rect x="12.500" y="3" width="7" height="4.500" rx="2" fill="#6c8494"/><rect x="12" y="13" width="2" height="11" rx="1" fill="#e4ecf1"/><rect x="18" y="13" width="2" height="11" rx="1" fill="#e4ecf1"/>',
  settings: '<rect x="3" y="4" width="26" height="24" rx="5" fill="#fff"/><rect x="7" y="9" width="18" height="2.600" rx="1.300" fill="#ecc9f4"/><circle cx="12" cy="10.300" r="3.300" fill="#d155e6"/><rect x="7" y="15" width="18" height="2.600" rx="1.300" fill="#ecc9f4"/><circle cx="21" cy="16.300" r="3.300" fill="#a936c4"/><rect x="7" y="21" width="18" height="2.600" rx="1.300" fill="#ecc9f4"/><circle cx="14" cy="22.300" r="3.300" fill="#d155e6"/>',
};
const nav = [
  { key: 'home', href: '/portal/campteam/', t: 'navHome', c: '#3b8ff0' },
  { key: 'camps', href: '/portal/campteam/camps/', t: 'navCamps', c: '#9bbf1f' },
  { key: 'tasks', href: '/portal/campteam/tasks/', t: 'navTasks', c: '#22b573' },
  { key: 'calendar', href: '/portal/campteam/calendar/', t: 'navCalendar', c: '#3bb3a6' },
  { key: 'meetings', href: '/portal/campteam/meetings/', t: 'navMeetings', c: '#8b6cf0' },
  { key: 'files', href: '/portal/campteam/files/', t: 'navFiles', c: '#f0a020' },
  { key: 'resources', href: '/portal/campteam/resources/', t: 'navResources', c: '#ec5fa0' },
  { key: 'tv', href: '/portal/campteam/tv/', t: 'navTv', c: '#14b8c4' },
];
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <script is:inline src="/wolko-lang-sync.js?v=2"></script>
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
  <title>{title} — Camp & Outreach Team</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/portal/campteam/campteam.css?v=62">
  <slot name="head" />
  <link rel="stylesheet" href="/portal/campteam/tv.css?v=3">
  <script is:inline src="/wolko-session.js?v=2"></script>
</head>
<body>
<div class="app">
  <aside>
    <div class="topbar">
      <a class="logo" href="/portal/campteam/"><img src="/images/WOLKO Circle.png" alt="WOLKO"><span><b>Camp &amp; Outreach Team</b><small>WOLKO · Word of Life Korea</small></span></a>
      <div class="langmini" role="group" aria-label="Language"><button type="button" id="langKoM" aria-label="한국어" title="한국어">🇰🇷</button><button type="button" id="langEnM" aria-label="English" title="English">🇺🇸</button></div>
      <button class="bell" id="bellBtn" type="button" aria-label="알림공지" aria-controls="aPanel" hidden><svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICON.alerts}></svg><b class="bellbadge" id="bellBadge" hidden></b></button>
      <button class="menu-btn" id="menuBtn" type="button" aria-label="Menu" aria-expanded="false" aria-controls="drawer"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
    <div class="drawer" id="drawer">
      <button class="drawer-x" id="drawerX" type="button" aria-label="Close menu">✕</button>
    <div class="exitrow" id="exitRow"><a class="portal-top" href="/portal/"><span aria-hidden="true">←</span> <span data-t="backPortalShort"></span></a></div>
    <p class="team-badge"><span data-t="teamSpace"></span><span data-t="teamSpace2"></span></p>
    <form class="gsearch" action="/portal/campteam/search/" method="get" role="search"><input type="search" name="q" minlength="2" maxlength="80" data-t-ph="searchAll" aria-label="search"></form>
    <nav class="nav">
      <h6 data-t="navGroupTeam"></h6>
      {nav.map(n => <a href={n.href} class={active === n.key ? 'on' : ''} style={`--c:${n.c}`}><span class="ic"><svg class="art" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" set:html={ART[n.key]} /></span><span data-t={n.t}></span></a>)}
      <a id="alertsNav" href="/portal/campteam/alerts/" class={active === 'alerts' ? 'on' : ''} style="--c:#e5534b" hidden><span class="ic"><svg class="art" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" set:html={ART.alerts} /></span><span data-t="navAlerts"></span><b class="navbadge" id="navBadge" hidden></b></a>
      <h6 id="moneyHead" hidden data-t="navFinance"></h6>
      <a id="moneyNav" href="/portal/campteam/finance/" class={active === 'budget' ? 'on' : ''} style="--c:#d4a373" hidden><span class="ic"><svg class="art" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" set:html={ART.budget} /></span><span data-t="navBudget"></span></a>
      <a id="trashNav" href="/portal/campteam/trash/" class={active === 'trash' ? 'on' : ''} style="--c:#9fb4c0" hidden><span class="ic"><svg class="art" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" set:html={ART.trash} /></span><span data-t="navTrash"></span></a>
      <h6 id="adminHead" hidden data-t="navAdmin"></h6>
      <a id="settingsNav" href="/portal/campteam/settings/" class={active === 'settings' ? 'on' : ''} style="--c:#d155e6" hidden><span class="ic"><svg class="art" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" set:html={ART.settings} /></span><span data-t="navSettings"></span></a>
    </nav>
    <div class="side-foot">
      <div class="lang"><button id="langKo" type="button">한국어</button><button id="langEn" type="button">English</button></div>
      <div class="who" id="who"></div>
    </div>
    </div>
  </aside>
  <div class="scrim" id="scrim"></div>
<div class="apanel-scrim" id="aScrim"></div>
<aside class="apanel" id="aPanel" aria-hidden="true" role="dialog" aria-labelledby="aTitle">
  <div class="aph"><b id="aTitle" data-t="alTitle"></b><span class="qh" data-h="alerts"></span><span class="sp"></span><button type="button" class="btn sm" id="aSeenAll" data-t="alSeenAll"></button><button type="button" class="alclose big" id="aClose" aria-label="close">✕</button></div>
  <div class="apt"><button type="button" data-pt="mine" class="on"><span data-t="alMine"></span><i hidden></i></button><button type="button" data-pt="team"><span data-t="alTeam"></span><i hidden></i></button></div>
  <div class="apb" id="aBody"></div>
  <div class="apf"><a href="/portal/campteam/alerts/" data-t="alAll"></a></div>
</aside>
  <main id="main"><slot /></main>
</div>
<div class="gate" id="gate" hidden>
  <div class="gate-card">
    <h2 data-t="gateTitle"></h2>
    <p data-t="gateBody"></p>
    <a class="btn pri" href="/portal/" data-t="gateBtn"></a>
    <div id="gbtn" hidden style="margin-top:16px;border-top:1px solid var(--border);padding-top:14px"><p class="meta" data-t="gateGoogle" style="margin:0 0 8px"></p><div id="gbtnInner" style="display:flex;justify-content:center"></div></div>
    <p class="meta" id="gnote" style="color:var(--accent);margin:10px 0 0"></p>
  </div>
</div>
<script is:inline src="/portal/campteam/campteam.js?v=20"></script>
<script is:inline src="/portal/campteam/help.js?v=4"></script>
<script is:inline src="/portal/campteam/alerts.js?v=6"></script>
<slot name="scripts" />
</body>
</html>
