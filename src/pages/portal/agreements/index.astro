---
// 관리자 · 마스터 전용 — 캠프 스태프 · 크루가 서명한 서약서(신앙고백서 등) 기록. 서명 그림과 문서 글을 보고, 인쇄(PDF 저장) · 엑셀(CSV) · 삭제 요청 처리를 한다.
// 서명하는 곳: 공개 페이지 /staff-agreements/ · 서버: functions/api/agreements/sign.js, functions/api/portal/agreements.js
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <script is:inline src="/wolko-busy.js?v=3"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
  <script is:inline src="/wolko-back-close.js?v=2"></script>
  <title>서약서 서명 기록 — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <style is:global>
    :root { --ink:#132c37; --muted:#607681; --line:#dbe7eb; --deep:#004f68; --ok:#15803d; --bad:#b91c1c; --bg:#f6fafc; --card:#fff; }
    @media (prefers-color-scheme: dark) { :root { --ink:#e6f0f4; --muted:#9db3bd; --line:#2a4350; --deep:#73d1f5; --ok:#4ade80; --bad:#f87171; --bg:#0f2029; --card:#142a35; } }
    * { box-sizing:border-box; }
    body { margin:0; padding:24px 16px 64px; background:var(--bg); color:var(--ink); font:15px/1.6 'Noto Sans KR', system-ui, sans-serif; }
    main { max-width:980px; margin:0 auto; display:grid; gap:16px; }
    h1 { font-size:22px; margin:0; } p.sub { margin:4px 0 0; color:var(--muted); font-size:13px; }
    section, .card { background:var(--card); border:1px solid var(--line); border-radius: var(--ws-radius-sm, 8px); padding:16px 18px; }
    input, select { width:100%; padding:0 12px; border:1px solid var(--line); border-radius: var(--ws-radius-sm, 8px); background:transparent; color:inherit; font:inherit; height:44px; }
    button { height:36px; padding:0 16px; border:1px solid var(--line); border-radius: var(--ws-radius-sm, 8px); background:transparent; color:inherit; font:inherit; font-size:14px; font-weight:700; cursor:pointer; }
    button.primary { background:var(--deep); border-color:var(--deep); color:#fff; }
    @media (prefers-color-scheme: dark) { button.primary { color:#00303f; } }
    button.danger { color:var(--bad); border-color:var(--bad); }
    button:disabled { opacity:.5; cursor:default; }
    .row { display:flex; gap:10px; align-items:center; flex-wrap:wrap; } .row > input, .row > select { width:auto; flex:1; min-width:150px; }
    .grid { display:grid; gap:10px; }
    .meta { color:var(--muted); font-size:13px; }
    .msg { font-size:13px; min-height:1.2em; } .msg.bad { color:var(--bad); }
    .wrap { overflow-x:auto; border:1px solid var(--line); border-radius: var(--ws-radius-sm, 8px); }
    table { width:100%; border-collapse:collapse; font-size:14px; min-width:720px; }
    th, td { padding:9px 12px; text-align:left; border-bottom:1px solid var(--line); vertical-align:middle; overflow-wrap:anywhere; }
    th { background:color-mix(in srgb, var(--deep) 7%, transparent); color:var(--muted); font-size:12px; white-space:nowrap; }
    tr:last-child td { border-bottom:0; }
    .tag { display:inline-block; padding:0 8px; height:22px; line-height:20px; border-radius: var(--ws-radius-sm, 8px); font-size:12px; font-weight:800; border:1px solid var(--line); white-space:nowrap; }
    .tag.crew { color:#5a44ad; border-color:#5a44ad; } .tag.staff { color:var(--deep); border-color:var(--deep); }
    .overlay { position:fixed; inset:0; z-index:50; display:flex; align-items:center; justify-content:center; padding:20px; background:rgba(16,41,54,.55); }
    .overlay[hidden] { display:none; }
    .modal { width:min(760px,100%); max-height:calc(100dvh - 40px); overflow-y:auto; background:var(--card); border-radius: var(--ws-radius-sm, 8px); padding:22px 24px 26px; display:grid; gap:12px; }
    .sigbox { background:#fff; border:1px solid var(--line); border-radius: var(--ws-radius-sm, 8px); padding:8px; }
    .sigbox img { display:block; max-width:100%; height:auto; margin:0 auto; }
    dl.kv { display:grid; grid-template-columns:130px 1fr; gap:4px 12px; margin:0; font-size:14px; } dl.kv dt { color:var(--muted); } dl.kv dd { margin:0; font-weight:600; overflow-wrap:anywhere; }
    ol.items { margin:0; padding:0; list-style:none; font-size:13.5px; } ol.items li { padding:7px 0; border-top:1px solid var(--line); display:grid; grid-template-columns:30px 1fr; gap:8px; } ol.items li.sec { display:block; padding-top:14px; }
    [hidden] { display:none !important; }
    @media (max-width:560px) { dl.kv { grid-template-columns:1fr; } .modal { padding:18px 16px 22px; } }
  </style>
  <script src="/wolko-access.js?v=2" defer></script>
  <link rel="stylesheet" href="/wolko-buttons.css?v=1" />
</head>
<body>
  <main>
    <div>
      <h1>서약서 서명 기록</h1>
      <p class="sub">스태프 · 크루가 공개 페이지(wolko.org/staff-agreements)에서 서명한 기록이에요. 이름과 이메일, 서명 그림이 들어 있어 관리자만 볼 수 있어요.</p>
    </div>

    <section id="loginBox">
      <div class="grid">
        <input id="email" type="email" placeholder="이메일" autocomplete="username">
        <input id="password" type="password" placeholder="비밀번호" autocomplete="current-password">
        <div class="row"><button id="loginBtn" class="primary" type="button">로그인</button><span id="loginMsg" class="msg bad"></span></div>
      </div>
    </section>

    <div id="app" hidden class="grid">
      <div class="card grid">
        <div class="row">
          <select id="fDoc" aria-label="문서"></select>
          <select id="fRole" aria-label="구분"><option value="">스태프 · 크루 전체</option><option value="staff">스태프</option><option value="crew">크루</option></select>
          <input id="fSearch" type="search" placeholder="이름 · 이메일 · 확인번호 검색">
        </div>
        <div class="row"><span class="meta" id="count"></span><button id="csvBtn" type="button">엑셀(CSV)로 받기</button><button id="copyBtn" type="button">서명 주소 복사</button><span class="msg bad" id="msg"></span></div>
      </div>
      <div class="wrap"><table>
        <thead><tr><th>서명 시각</th><th>문서</th><th>캠프</th><th>구분</th><th>이름</th><th>이메일</th><th>확인번호</th><th></th></tr></thead>
        <tbody id="rows"></tbody>
      </table></div>
      <p id="empty" class="sub" hidden>아직 서명한 기록이 없어요.</p>
    </div>
  </main>

  <div class="overlay" id="ov" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="mTitle">
      <div class="row" style="justify-content:space-between"><strong id="mTitle" style="font-size:18px"></strong><button id="mClose" type="button">닫기</button></div>
      <div class="sigbox"><img id="mSig" alt="서명"></div>
      <dl class="kv" id="mKv"></dl>
      <div class="row"><button id="mPrint" type="button" class="primary">인쇄 · PDF로 저장</button><button id="mDel" type="button" class="danger">이 기록 삭제</button><span class="msg bad" id="mMsg"></span></div>
      <div id="mDoc"></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var KEY = 'wolko-hub-token';
      var $ = function (id) { return document.getElementById(id); };
      var esc = function (v) { return String(v == null ? '' : v).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
      var ROLE = { staff: '스태프', crew: '크루' };
      var data = { items: [], docs: [] }, current = null;
      function headers() { return { Authorization: 'Bearer ' + (sessionStorage.getItem(KEY) || '') }; }
      function when(ms) { try { return new Intl.DateTimeFormat('ko-KR', { timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(ms)); } catch (e) { return ''; } }
      function itemsHtml(doc) {   // 소제목이 있는 문서는 소제목 + 번호 붙은 항목
        var n = 0;
        return doc.sections.map(function (sec) { return (sec.ko ? '<li class="sec"><strong>' + esc(sec.ko) + '</strong></li>' : '') + sec.items.map(function (it) { n++; return '<li><b>' + String(n).padStart(2, '0') + '</b><span>' + esc(it.ko) + '</span></li>'; }).join(''); }).join('');
      }
      function docTitle(id) { var d = data.docs.filter(function (x) { return x.id === id; })[0]; return d ? d.title : id; }
      function filtered() {
        var fd = $('fDoc').value, fr = $('fRole').value, q = $('fSearch').value.trim().toLowerCase();
        return data.items.filter(function (i) {
          return (!fd || i.doc === fd) && (!fr || i.role === fr) && (!q || (i.name + ' ' + i.email + ' ' + i.code).toLowerCase().indexOf(q) >= 0);
        });
      }
      function render() {
        var items = filtered();
        $('count').textContent = '총 ' + items.length + '건' + (data.truncated ? ' (일부만 보여요 — 엑셀에는 전체가 들어 있어요)' : '');
        $('empty').hidden = items.length > 0;
        $('rows').innerHTML = items.map(function (i) {
          return '<tr data-view="' + esc(i.code) + '" style="cursor:pointer"><td>' + esc(when(i.t)) + '</td><td>' + esc(docTitle(i.doc)) + '</td><td>' + esc(i.camp || '—') + '</td><td><span class="tag ' + esc(i.role) + '">' + esc(ROLE[i.role] || i.role) + '</span></td><td>' + esc(i.name) + '</td><td>' + esc(i.email) + '</td><td>' + esc(i.code) + '</td><td><button type="button" data-view="' + esc(i.code) + '">보기</button></td></tr>';
        }).join('');
      }
      async function load() {
        var res = await fetch('/api/portal/agreements', { headers: headers() });
        var body = await res.json().catch(function () { return {}; });
        if (!res.ok) { $('app').hidden = true; $('loginBox').hidden = false; $('loginMsg').textContent = body.error || '확인하지 못했습니다.'; return; }
        data = body;
        $('fDoc').innerHTML = '<option value="">문서 전체</option>' + data.docs.map(function (d) { return '<option value="' + esc(d.id) + '">' + esc(d.title) + '</option>'; }).join('');
        $('loginBox').hidden = true; $('app').hidden = false; render();
      }
      async function view(code) {
        $('mMsg').textContent = '';
        var res = await fetch('/api/portal/agreements?code=' + encodeURIComponent(code), { headers: headers() });
        var body = await res.json().catch(function () { return {}; });
        if (!res.ok) { $('msg').textContent = body.error || '불러오지 못했어요.'; return; }
        current = body; var r = body.record;
        $('mTitle').textContent = docTitle(r.doc) + ' · ' + r.name;
        $('mSig').src = r.signature;
        $('mKv').innerHTML = [['구분', ROLE[r.role] || r.role], ...(r.campId ? [['캠프', (r.campName ? r.campName + ' · ' : '') + r.campId]] : []), ['이름', r.name], ['이메일', r.email], ['서명 시각', when(Date.parse(r.signedAt)) + ' (한국 시간)'], ['확인번호', r.code], ['문서 버전', r.version], ['문서 글 해시', String(r.textHash || '').slice(0, 16) + '…']]
          .map(function (p) { return '<dt>' + p[0] + '</dt><dd>' + esc(p[1]) + '</dd>'; }).join('');
        $('mDoc').innerHTML = body.doc
          ? '<strong>서명한 문서 (' + esc(body.doc.version) + ')</strong><ol class="items">' + itemsHtml(body.doc) + '</ol>' + (body.record.declared && body.doc.declaration ? '<p class="meta">본인 진술 확인: ' + esc(body.doc.declaration.ko) + '</p>' : '')
          : '<p class="meta">서명한 때의 문서 버전(' + esc(r.version) + ')과 지금 문서가 달라 글은 보여 드리지 않아요. 위의 글 해시로 서명한 글을 확인할 수 있어요.</p>';
        $('ov').hidden = false; document.body.style.overflow = 'hidden';
      }
      function closeModal() { $('ov').hidden = true; document.body.style.overflow = ''; current = null; }
      function printCurrent() {
        if (!current) return;
        var r = current.record, doc = current.doc;
        var w = window.open('', '_blank'); if (!w) { alert('팝업을 허용한 뒤 다시 눌러 주세요.'); return; }
        var items = doc ? '<ol>' + itemsHtml(doc) + '</ol>' + (r.declared && doc.declaration ? '<p class="pledge">' + esc(doc.declaration.ko) + '</p>' : '') + '<p class="pledge">' + esc(doc.ko.pledge) + '</p>' : '<p>(문서 버전 ' + esc(r.version) + ' — 글 해시 ' + esc(r.textHash) + ')</p>';
        w.document.write('<!doctype html><html lang="ko"><head><meta charset="utf-8"><title>' + esc(docTitle(r.doc)) + ' — ' + esc(r.name) + '</title><style>body{font:14px/1.75 "Noto Sans KR",system-ui,sans-serif;color:#10252e;max-width:760px;margin:32px auto;padding:0 24px}h1{font-size:22px}ol{list-style:none;padding:0}li{display:grid;grid-template-columns:34px 1fr;gap:10px;padding:8px 0;border-top:1px solid #d6dee2}li b{color:#004f68}li.sec{display:block;font-weight:800;padding-top:14px}.pledge{padding:10px 14px;border:1px solid #d6dee2;background:#f6f9fb;font-weight:600}.sig{margin-top:24px;border:1px solid #d6dee2;padding:14px 18px}.sig img{display:block;max-width:360px;width:100%;border-bottom:1px solid #9fb0b8;margin:8px 0}dl{display:grid;grid-template-columns:130px 1fr;gap:4px 12px;font-size:13px}dt{color:#587383}dd{margin:0;font-weight:600}</style></head><body><h1>' + esc(docTitle(r.doc)) + '</h1>' + items
          + '<div class="sig"><img alt="signature" src="' + r.signature + '"><dl><dt>이름</dt><dd>' + esc(r.name) + '</dd><dt>구분</dt><dd>' + esc(ROLE[r.role] || r.role) + '</dd>' + (r.campId ? '<dt>캠프</dt><dd>' + esc((r.campName ? r.campName + ' · ' : '') + r.campId) + '</dd>' : '') + '<dt>이메일</dt><dd>' + esc(r.email) + '</dd><dt>서명 시각</dt><dd>' + esc(when(Date.parse(r.signedAt))) + ' (한국 시간)</dd><dt>확인번호</dt><dd>' + esc(r.code) + '</dd><dt>문서 버전</dt><dd>' + esc(r.version) + '</dd></dl></div>'
          + '<script>window.onload=function(){setTimeout(function(){window.print()},300)}<\/script></body></html>');
        w.document.close();
      }
      async function csv() {
        $('msg').textContent = '';
        try {
          var d = $('fDoc').value;
          var res = await fetch('/api/portal/agreements?format=csv' + (d ? '&doc=' + encodeURIComponent(d) : ''), { headers: headers() });
          if (!res.ok) throw new Error((await res.json().catch(function () { return {}; })).error || '받지 못했어요.');
          var blob = await res.blob(), a = document.createElement('a');
          a.href = URL.createObjectURL(blob); a.download = 'wolko-agreements.csv'; document.body.append(a); a.click(); a.remove();
          setTimeout(function () { URL.revokeObjectURL(a.href); }, 4000);
        } catch (err) { $('msg').textContent = err.message; }
      }
      $('rows').addEventListener('click', function (e) { var b = e.target.closest('[data-view]'); if (b) view(b.dataset.view); });
      ['fDoc', 'fRole'].forEach(function (id) { $(id).addEventListener('change', render); }); $('fSearch').addEventListener('input', render);
      $('csvBtn').addEventListener('click', csv);
      $('copyBtn').addEventListener('click', async function () { try { await navigator.clipboard.writeText('https://wolko.org/staff-agreements/'); $('msg').textContent = ''; $('copyBtn').textContent = '복사했어요'; setTimeout(function () { $('copyBtn').textContent = '서명 주소 복사'; }, 2000); } catch (e) { $('msg').textContent = 'wolko.org/staff-agreements/'; } });
      $('mClose').addEventListener('click', closeModal); $('ov').addEventListener('mousedown', function (e) { if (e.target === $('ov')) closeModal(); });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !$('ov').hidden) closeModal(); });
      $('mPrint').addEventListener('click', printCurrent);
      $('mDel').addEventListener('click', async function () {
        if (!current || !confirm('이 서명 기록을 지울까요? 되돌릴 수 없어요.')) return;
        $('mDel').disabled = true;
        try {
          var res = await fetch('/api/portal/agreements?code=' + encodeURIComponent(current.record.code), { method: 'DELETE', headers: headers() });
          var b = await res.json().catch(function () { return {}; });
          if (!res.ok) throw new Error(b.error || '지우지 못했어요.');
          closeModal(); await load();
        } catch (err) { $('mMsg').textContent = err.message; }
        $('mDel').disabled = false;
      });
      $('loginBtn').addEventListener('click', async function () {
        $('loginMsg').textContent = '';
        try {
          var res = await fetch('/api/hub/account-login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: $('email').value, password: $('password').value }) });
          var body = await res.json().catch(function () { return {}; });
          if (!res.ok) throw new Error(body.error || '로그인하지 못했습니다.');
          sessionStorage.setItem(KEY, body.hubToken); $('password').value = '';
          await load();
        } catch (err) { $('loginMsg').textContent = err.message; }
      });
      if (sessionStorage.getItem(KEY)) load();
    })();
  </script>
</body>
</html>
