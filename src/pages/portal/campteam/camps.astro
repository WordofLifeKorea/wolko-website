---
import CampTeamLayout from '../../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="캠프별 공간" active="camps">
  <div class="top">
    <div><div class="h1row"><h1 data-t="campsTitle"></h1><span class="qh" data-h="pageCamps"></span></div><div class="sub" data-t="campsSub"></div></div>
    <div class="actions"><button class="btn" id="addType" hidden data-t="addType"></button><button class="btn pri" id="addCamp" hidden data-t="addCamp"></button></div>
  </div>
  <div class="hintbox" id="viewOnly" data-t="viewOnly" hidden style="margin-bottom:14px"></div>
  <div class="hint ordhint" data-t="ordHint"></div><div class="ordtools" id="ordTools"></div>
  <div id="list"></div>
  <dialog id="dlg">
    <h3 id="dlgTitle"></h3>
    <form id="dlgForm" class="form" method="dialog">
      <div id="dlgFields" class="form"></div>
      <div class="err" id="dlgErr" hidden></div>
      <div class="dlg-actions"><button type="button" class="btn" id="cancel" data-t="cancel"></button><button type="submit" class="btn pri" data-t="save"></button></div>
    </form>
  </dialog>
  <script is:inline slot="scripts" src="/portal/campteam/camps.js?v=5"></script>
</CampTeamLayout>
