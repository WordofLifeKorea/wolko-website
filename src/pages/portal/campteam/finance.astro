---
import CampTeamLayout from '../../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="캠프 예산 · 회계 장부" active="budget">
  <div class="top">
    <div><div class="h1row"><h1 data-t="fnTitle"></h1><span class="qh" data-h="pageFinance"></span></div><div class="sub" data-t="fnSub"></div></div>
  </div>
  <div class="locked" id="fnLocked" hidden data-t="budgetLocked"></div>
  <div id="fnMain" hidden>
    <div class="perbar"><label class="perlbl"><span data-t="perNowLabel"></span><span id="fnPerHelp"></span><select id="fnPeriodSel"></select></label><button class="btn sm" id="fnPerManage" type="button" data-t="perManage"></button><button class="btn sm pri" id="fnPerNew" type="button" hidden data-t="perNew"></button></div>
    <div class="hintbox" id="fnViewOnly" hidden style="margin-bottom:12px"></div>
    <div id="fnBanner"></div>
    <div class="tabs" id="fnTabs"></div>
    <div id="fnBody"></div>
  </div>
  <dialog id="dlg" class="wide">
    <h3 id="dlgTitle"></h3>
    <form id="dlgForm" class="form" method="dialog"><div id="dlgFields" class="form"></div><div class="err" id="dlgErr" hidden></div><div class="dlg-actions" id="dlgActions"></div></form>
  </dialog>
  <script is:inline slot="scripts" src="/portal/campteam/xlsx-lite.js?v=1"></script>
  <script is:inline slot="scripts" src="/portal/campteam/ledger-parse.js?v=1"></script>
  <script is:inline slot="scripts" src="/portal/campteam/finance.js?v=8"></script>
  <script is:inline slot="scripts" src="/portal/campteam/finance-import.js?v=2"></script>
  <script is:inline slot="scripts" src="/portal/campteam/finance-extra.js?v=2"></script>
  <script is:inline slot="scripts" type="module" src="/portal/campteam/calc-core.js?v=3"></script>
  <script is:inline slot="scripts" src="/portal/campteam/finance-calc.js?v=5"></script>
</CampTeamLayout>
