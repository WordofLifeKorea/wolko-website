---
// 「이 메일 그만 받기」 확인 화면 — 로그인 없이 연다(메일의 링크를 누른 뒤 보내지는 곳). 이메일 끄기는 /api/campteam/email-off 가 하고, 이 화면은 결과만 알려 준다.
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <script is:inline src="/wolko-busy.js?v=2"></script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <meta name="referrer" content="no-referrer">
  <title>WOLKO — E-mail settings</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
  <style is:inline>
    :root{--bg:#f4f6f8;--card:#fff;--text:#1a2d38;--mid:#5a7585;--blue:#004f68;--accent:#c42a36;--border:#dfe6ea;--ok:#1f9d6b}
    @media (prefers-color-scheme:dark){:root{--bg:#10181d;--card:#18232a;--text:#e8eff3;--mid:#9fb4c0;--blue:#7fc4de;--border:#2a3a44}}
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:'Noto Sans KR',system-ui,sans-serif;line-height:1.6}
    main{max-width:520px;margin:0 auto;padding:20px 16px 60px}.lang{display:flex;gap:6px;justify-content:flex-end}.lang button{border:1px solid var(--border);background:var(--card);color:var(--text);border-radius:8px;padding:6px 12px;cursor:pointer;font:inherit;font-size:14px}.lang button.on{background:var(--blue);color:#fff;border-color:var(--blue)}
    .card{background:var(--card);border:1px solid var(--border);border-radius:16px;padding:22px 20px;margin-top:18px}
    h1{font-size:21px;margin:0 0 10px}p{margin:8px 0;font-size:15.5px}.mid{color:var(--mid);font-size:14px}
    .ico{width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font-size:24px;color:#fff;margin-bottom:12px}.ico.ok{background:var(--ok)}.ico.bad{background:var(--accent)}
    .btn{display:inline-block;margin-top:12px;padding:13px 18px;border-radius:12px;border:1px solid var(--border);background:var(--card);color:var(--text);font:inherit;font-size:16px;font-weight:600;cursor:pointer;text-decoration:none}.btn.pri{background:var(--blue);color:#fff;border-color:var(--blue)}.btn:disabled{opacity:.5}
    .how{background:var(--bg);border-radius:10px;padding:10px 12px;margin-top:12px;font-size:14.5px}
  </style>
</head>
<body>
<main><div class="lang"><button type="button" id="lko">한국어</button><button type="button" id="len">English</button></div><div id="app" class="card"></div></main>
<script is:inline>
(function () {
  var T = {
    ko: {
      okH: '이메일을 껐어요', okP: '이제 「매주 화요일 이메일」과 「마감·일정 알림 이메일」이 오지 않아요.', okKeep: '포털 안의 알림 목록은 그대로예요. 알림은 직접 「확인」을 눌러야 사라져요.',
      how: '다시 받고 싶으면: 캠프팀 포털에 로그인 → 알림 → 오른쪽 위 「설정」에서 이메일 스위치를 켜 주세요.', again: '실수였나요? 다시 받기', againOk: '다시 켰어요', how2: '앞으로 이메일을 다시 받아요. 끄고 싶으면 메일 맨 아래 「이 메일 그만 받기」를 누르거나, 포털의 알림 → 설정에서 꺼 주세요.', againFail: '지금은 처리하지 못했어요. 포털의 알림 → 설정에서 켜 주세요.', open: '포털 알림 설정 열기',
      badH: '이 링크는 쓸 수 없어요', badP: '링크가 맞지 않거나 너무 오래되었어요. 아무것도 바뀌지 않았어요.', badHow: '이메일을 끄려면: 캠프팀 포털에 로그인 → 알림 → 오른쪽 위 「설정」에서 이메일 스위치를 꺼 주세요.',
      errH: '지금은 처리하지 못했어요', errP: '잠시 뒤에 같은 링크를 다시 눌러 주세요. 계속 안 되면 포털의 알림 → 설정에서 직접 끌 수 있어요.' },
    en: {
      okH: 'E-mails are off', okP: 'You will no longer get the Tuesday weekly e-mail or the deadline & event e-mails.', okKeep: 'Your alert list inside the portal is unchanged. An alert goes away only when you mark it read.',
      how: 'To get them again: sign in to the camp team portal, then Alerts → Settings (top right) and turn the e-mail switches on.', again: 'Not what you wanted? Turn them back on', againOk: 'Turned back on', how2: 'You will get e-mails again. To stop, use the link at the bottom of an e-mail or Alerts → Settings in the portal.', againFail: 'Could not do that now. Please turn them on under Alerts → Settings in the portal.', open: 'Open portal alert settings',
      badH: 'This link cannot be used', badP: 'The link is not valid or is too old. Nothing was changed.', badHow: 'To turn e-mails off: sign in to the camp team portal, then Alerts → Settings (top right) and switch the e-mails off.',
      errH: 'Could not do that now', errP: 'Please open the same link again in a moment. If it keeps failing, turn e-mails off under Alerts → Settings in the portal.' } };
  var P = new URLSearchParams(location.search), t = P.get('t') || '', mode = P.get('ok') === '1' ? 'ok' : P.get('err') === '2' ? 'err' : 'bad', again = '';
  var lang = /^en/i.test(navigator.language || 'ko') ? 'en' : 'ko', app = document.getElementById('app'), L = function (k) { return T[lang][k]; };
  try { var sv = localStorage.getItem('ct-survey-lang'); if (sv === 'en' || sv === 'ko') lang = sv; } catch (e) {}
  function esc(s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); }
  function draw() {
    document.documentElement.lang = lang; document.getElementById('lko').className = lang === 'ko' ? 'on' : ''; document.getElementById('len').className = lang === 'en' ? 'on' : '';
    var link = '<p><a class="btn" href="/portal/campteam/alerts/">' + esc(L('open')) + '</a></p>';
    if (mode === 'ok' && again === 'ok') app.innerHTML = '<div class="ico ok" aria-hidden="true">✓</div><h1>' + esc(L('againOk')) + '</h1><div class="how">' + esc(L('how2')) + '</div>' + link;
    else if (mode === 'ok') app.innerHTML = '<div class="ico ok" aria-hidden="true">✓</div><h1>' + esc(L('okH')) + '</h1><p>' + esc(L('okP')) + '</p><p class="mid">' + esc(L('okKeep')) + '</p><div class="how">' + esc(L('how')) + '</div>' + (t ? '<p><button type="button" class="btn" id="again">' + esc(L('again')) + '</button></p>' : '') + '<p class="mid" id="againMsg" role="status">' + (again === 'fail' ? esc(L('againFail')) : '') + '</p>' + link;
    else if (mode === 'err') app.innerHTML = '<div class="ico bad" aria-hidden="true">!</div><h1>' + esc(L('errH')) + '</h1><p>' + esc(L('errP')) + '</p>' + link;
    else app.innerHTML = '<div class="ico bad" aria-hidden="true">!</div><h1>' + esc(L('badH')) + '</h1><p>' + esc(L('badP')) + '</p><div class="how">' + esc(L('badHow')) + '</div>' + link;
    var b = document.getElementById('again'); if (b) b.onclick = function () {
      b.disabled = true;
      fetch('/api/campteam/email-off', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ t: t, action: 'on' }) })
        .then(function (r) { again = r.ok ? 'ok' : 'fail'; draw(); }).catch(function () { again = 'fail'; draw(); });
    };
  }
  function pick(l) { lang = l; try { localStorage.setItem('ct-survey-lang', l); } catch (e) {} draw(); }
  document.getElementById('lko').onclick = function () { pick('ko'); }; document.getElementById('len').onclick = function () { pick('en'); };
  draw();
})();
</script>
</body>
</html>
