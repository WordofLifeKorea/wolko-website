---
import CampTeamLayout from '../../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="보관함" active="library">
  <div class="top">
    <div><div class="h1row"><h1 data-t="libTitle"></h1></div><div class="sub" data-t="libSub"></div></div>
    <div class="actions"><a class="btn" href="/portal/campteam/translate/" data-t="libTranslate"></a> <button class="btn" id="libImp" hidden data-t="libImport"></button> <button class="btn pri" id="libAdd" hidden data-t="libAdd"></button></div>
  </div>
  <div class="tabs" id="libTabs"></div>
  <div class="filters"><input id="libQ" type="search" maxlength="80" data-t-ph="libSearch"></div>
  <div class="tagbar" id="libTags" hidden></div>
  <div class="count-line" id="libCount"></div>
  <div id="libList"></div>
  <dialog id="libDlg" class="wide"><div id="libBody"></div></dialog>
  <script is:inline slot="scripts" src="/portal/campteam/library.js?v=1"></script>
</CampTeamLayout>
