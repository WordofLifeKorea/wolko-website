---
import CampTeamLayout from '../../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="캠프 준비" active="prep">
  <div class="top">
    <div><div class="h1row"><h1 data-t="pTitle"></h1></div><div class="sub" data-t="pSub"></div></div>
    <div class="actions"><button class="btn" id="pQuick" data-t="qBtn" hidden></button> <button class="btn" id="pCal" data-t="pCal" hidden></button></div>
  </div>
  <div class="ptabs" id="pTabs"></div>
  <div class="p-camp" id="pCampWrap"><div id="pCampPick"></div></div>
  <div id="pView"></div>
  <dialog id="pDlg" class="wide"><div id="pBody"></div></dialog>
  <script is:inline slot="scripts" src="/portal/campteam/prep.js?v=6"></script>
  <script is:inline slot="scripts" src="/portal/campteam/prep-extra.js?v=1"></script>
  <script is:inline slot="scripts" src="/portal/campteam/prep-assign.js?v=1"></script>
  <link rel="stylesheet" href="/portal/campteam/form-render.css?v=2">
  <script is:inline slot="scripts" src="/portal/campteam/form-render.js?v=1"></script>
  <script is:inline slot="scripts" src="/portal/campteam/prep-forms.js?v=3"></script>
</CampTeamLayout>
