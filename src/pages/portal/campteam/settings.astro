---
import CampTeamLayout from '../../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="설정 · 팀 명단" active="settings">
  <div class="top"><div><div class="h1row"><h1 data-t="setTitle"></h1><span class="qh" data-h="pageSettings"></span></div><div class="sub" data-t="setSub"></div></div></div>
  <section class="card" style="margin-bottom:16px">
    <table>
      <thead><tr><th data-t="colEmail"></th><th data-t="colName"></th><th data-t="colAliases"></th><th><span data-t="colRole"></span><span class="qh" data-h="role"></span></th><th></th></tr></thead>
      <tbody id="rows"></tbody>
    </table>
  </section>
  <section class="card" id="ownerSec" style="margin-bottom:16px" hidden>
    <h2><span data-t="onTitle"></span></h2><div class="hintbox" data-t="onHelp" style="margin-bottom:10px"></div>
    <div id="onPending"></div>
    <div id="onList" style="margin-top:8px"></div>
    <form id="onForm" class="actions" style="margin-top:10px;gap:8px"><input id="onName" maxlength="60" data-t-ph="onPh" style="flex:1;min-width:160px"><button class="btn pri" type="submit" data-t="onAdd"></button></form>
    <div class="err" id="onErr" hidden></div>
  </section>
  <section class="card">
    <h2 data-t="addMember"></h2>
    <form id="addForm" class="form">
      <div class="two"><label><span data-t="fEmail"></span><input id="fEmail" type="email" required placeholder="name@wolko.org"></label>
      <label><span data-t="fName"></span><input id="fName" maxlength="60"></label></div>
      <div class="two"><label><span data-t="fAliases"></span><input id="fAliases" maxlength="200"></label>
      <label><span data-t="fRole"></span><select id="roleSel"></select></label></div>
      <div id="addPerm"></div>
      <div class="err" id="addErr" hidden></div>
      <div><button class="btn pri" type="submit" data-t="save"></button></div>
    </form>
  </section>
  <section class="card" id="spSec" style="margin-top:16px" hidden>
    <h2><span data-t="spTitle"></span></h2><div class="hintbox" data-t="spHelp" style="margin-bottom:10px"></div>
    <div class="actions"><label class="btn pri" for="spFiles" data-t="spPick" style="cursor:pointer"></label><input id="spFiles" type="file" accept="image/png" multiple hidden><span class="hint" id="spStat"></span></div>
  </section>
  <section class="card" id="trSec" style="margin-top:16px" hidden>
    <h2><span data-t="trTitle"></span></h2><div class="hintbox" data-t="trHelp" style="margin-bottom:10px"></div>
    <div class="actions"><button class="btn pri" id="trRun" data-t="trRun"></button><span class="hint" id="trStat"></span></div>
  </section>
  <section class="card" style="margin-top:16px">
    <h2><span data-t="shTitle"></span><span class="qh" data-h="sheets"></span></h2>
    <div class="hintbox" data-t="shHelp" style="margin-bottom:10px"></div>
    <div class="actions"><button class="btn" id="shPreview" data-t="shPreview"></button></div>
    <div id="shOut" style="margin-top:12px"></div>
  </section>
  <section class="card" style="margin-top:16px">
    <h2><span data-t="gcTitle"></span><span class="qh" data-h="sheets"></span></h2><div class="hintbox" data-t="gcHelp" style="margin-bottom:10px"></div>
    <div class="actions"><button class="btn" id="gcPreview" data-t="shPreview"></button><button class="btn pri" id="gcApply" data-t="gcApply" hidden></button></div><div id="gcOut" style="margin-top:12px"></div>
  </section>
  <section class="card" style="margin-top:16px">
    <h2><span data-t="glTitle"></span><span class="qh" data-h="glossary"></span><button class="btn sm pri" id="glAdd" data-t="glAdd"></button></h2><div class="hintbox" data-t="glHelp" style="margin-bottom:10px"></div><div id="glList"></div>
  </section>
  <section class="card" style="margin-top:16px">
    <h2><span data-t="bkTitle"></span><span class="qh" data-h="backup"></span></h2><div class="hintbox" data-t="bkHelp" style="margin-bottom:10px"></div>
    <div class="actions"><button class="btn pri" id="bkJson" data-t="bkJson"></button><select id="bkTable" class="btn"></select><button class="btn" id="bkCsv" data-t="bkCsv"></button></div>
  </section>
  <section class="card" style="margin-top:16px">
    <h2><span data-t="auTitle"></span><span class="qh" data-h="audit"></span></h2>
    <div class="filters t" style="grid-template-columns:1fr 1fr 1.4fr"><select id="auEntity"></select><input id="auActor" data-t-ph="auActor" maxlength="60"><input id="auQ" type="search" data-t-ph="auSearch"></div>
    <div style="overflow:auto"><table id="auTable"></table></div>
  </section>
  <dialog id="dlg" class="wide"><h3 id="dlgTitle"></h3><form id="dlgForm" class="form" method="dialog"><div id="dlgFields" class="form"></div><div class="err" id="dlgErr" hidden></div><div class="dlg-actions" id="dlgActions"></div></form></dialog>
  <script is:inline slot="scripts" src="/portal/campteam/settings.js?v=4"></script>
  <script is:inline slot="scripts" src="/portal/campteam/settings-extra.js?v=5"></script>
  <script is:inline slot="scripts" src="/portal/campteam/office-admin.js?v=1"></script>
  <script is:inline slot="scripts" src="/portal/campteam/owners-admin.js?v=1"></script>
</CampTeamLayout>
