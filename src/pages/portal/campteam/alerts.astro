---
import CampTeamLayout from '../../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="알림공지" active="alerts">
  <div class="top">
    <div><h1><span data-t="alTitle"></span><span class="qh" data-h="alerts"></span></h1><div class="sub" data-t="apSub"></div></div>
    <div class="actions apwrap">
      <button class="btn pri" id="apNew" type="button" data-t="apNewBtn"></button>
      <button class="btn" id="apSetBtn" type="button" aria-haspopup="dialog" aria-expanded="false" aria-controls="apPop"><svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg> <span data-t="apSetBtn"></span></button>
      <div class="appop" id="apPop" role="dialog" aria-label="알림 설정" hidden></div>
    </div>
  </div>
  <div class="err" id="apErr" hidden></div>
  <div class="appopscrim" id="apPopScrim" hidden></div>
  <div class="alpage">
    <div class="sec">
      <div class="tabs" id="apTabs"></div>
      <div class="stack" id="apList"></div>
    </div>
  </div>
  <dialog id="dlg" class="wide">
    <h3 id="dlgTitle"></h3>
    <form id="dlgForm" class="form alform" method="dialog"><div id="dlgFields" class="form"></div><div class="err" id="dlgErr" hidden></div><div class="dlg-actions" id="dlgActions"></div></form>
  </dialog>
  <script is:inline slot="scripts" src="/portal/campteam/alerts-page.js?v=3"></script>
</CampTeamLayout>
