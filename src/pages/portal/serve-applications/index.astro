---
// 담당자·마스터 전용 — 섬김 지원 신청서(인터뷰하면서 입력). 항목 정의는 서버(schema)에서 받아 그린다.
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow">
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
  <title>섬김 지원 신청서 — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <style is:global>
    :root { --ink:#132c37; --muted:#607681; --line:#dbe7eb; --deep:#004f68; --ok:#15803d; --bad:#b91c1c; --warn:#a16207; --bg:#f6fafc; --card:#fff; }
    @media (prefers-color-scheme: dark) { :root { --ink:#e6f0f4; --muted:#9db3bd; --line:#2a4350; --deep:#73d1f5; --ok:#4ade80; --bad:#f87171; --warn:#facc15; --bg:#0f2029; --card:#142a35; } }
    * { box-sizing:border-box; }
    body { margin:0; padding:20px 16px 90px; background:var(--bg); color:var(--ink); font:15px/1.6 'Noto Sans KR', system-ui, sans-serif; }
    main { max-width:900px; margin:0 auto; display:grid; gap:14px; }
    h1 { font-size:22px; margin:0; } h2 { font-size:17px; margin:0 0 4px; }
    p.sub { margin:4px 0 0; color:var(--muted); font-size:13px; }
    section, .card { background:var(--card); border:1px solid var(--line); border-radius:14px; padding:16px 18px; }
    input, textarea, select { width:100%; padding:0 12px; border:1px solid var(--line); border-radius:10px; background:transparent; color:inherit; font:inherit; }
    input, select { height:42px; } textarea { padding:10px 12px; min-height:90px; resize:vertical; }
    input[type=radio], input[type=checkbox] { width:18px; height:18px; flex:none; }
    button { height:38px; padding:0 14px; border:1px solid var(--line); border-radius:10px; background:transparent; color:inherit; font:inherit; font-weight:700; cursor:pointer; }
    button.primary { background:var(--deep); border-color:var(--deep); color:#fff; }
    @media (prefers-color-scheme: dark) { button.primary { color:#00303f; } }
    button.danger { color:var(--bad); border-color:var(--bad); }
    button:disabled { opacity:.5; cursor:default; }
    a { color:var(--deep); }
    .row { display:flex; gap:10px; align-items:center; flex-wrap:wrap; } .grid { display:grid; gap:12px; }
    .tag { display:inline-block; padding:2px 10px; border-radius:999px; font-size:12px; font-weight:800; border:1px solid var(--line); }
    .tag.submitted, .tag.approved { color:var(--ok); border-color:var(--ok); } .tag.draft { color:var(--deep); border-color:var(--deep); }
    .tag.hold { color:var(--warn); border-color:var(--warn); } .tag.rejected { color:var(--bad); border-color:var(--bad); }
    .meta { color:var(--muted); font-size:13px; } .msg { font-size:13px; min-height:1.2em; } .msg.bad { color:var(--bad); } .msg.ok { color:var(--ok); }
    .steps { display:flex; gap:6px; overflow-x:auto; padding-bottom:4px; }
    .step { flex:none; height:34px; border-radius:999px; font-size:13px; }
    .step.active { background:color-mix(in srgb, var(--deep) 12%, transparent); border-color:var(--deep); color:var(--deep); }
    .step.err { border-color:var(--bad); color:var(--bad); }
    .field { display:grid; gap:5px; } .field.err > .lbl { color:var(--bad); }
    .lbl { font-weight:700; font-size:14px; } .lbl small { display:block; font-weight:400; color:var(--muted); font-size:12px; }
    .req { color:var(--bad); } .sens { font-size:11px; font-weight:800; color:var(--warn); border:1px solid var(--warn); border-radius:999px; padding:0 7px; margin-left:6px; }
    .opts { display:flex; gap:16px; flex-wrap:wrap; } .opt { display:flex; align-items:center; gap:7px; font-weight:400; }
    .two { display:grid; grid-template-columns:1fr 1fr; gap:12px; } @media (max-width:640px) { .two { grid-template-columns:1fr; } }
    .bar { position:fixed; left:0; right:0; bottom:0; padding:10px 16px; background:var(--card); border-top:1px solid var(--line); }
    .bar .inner { max-width:900px; margin:0 auto; display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
    .audit { font-size:12px; color:var(--muted); display:grid; gap:2px; max-height:220px; overflow:auto; }
    #printArea { display:none; }
    @media print { body > main, .bar { display:none !important; } #printArea { display:block; color:#000; background:#fff; font-size:12px; } #printArea h2 { margin:14px 0 4px; border-bottom:1px solid #999; } #printArea dl { margin:0; } #printArea dt { font-weight:700; margin-top:6px; } #printArea dd { margin:0; white-space:pre-wrap; } }
    [hidden] { display:none !important; }
  </style>
  <script src="/wolko-access.js?v=1" defer></script>
</head>
<body>
  <main>
    <div>
      <h1>섬김 지원 신청서</h1>
      <p class="sub">인터뷰하면서 담당자가 입력합니다. 이혼·형사·학대 관련·건강 항목은 별도로 저장되며, 열람·수정 기록이 남습니다. <a href="/portal/serve-inquiries/">← 섬김 문의로</a></p>
    </div>

    <section id="loginBox">
      <div class="grid">
        <input id="email" type="email" placeholder="이메일" autocomplete="username">
        <input id="password" type="password" placeholder="비밀번호" autocomplete="current-password">
        <div class="row"><button id="loginBtn" class="primary" type="button">로그인</button><span id="loginMsg" class="msg bad"></span></div>
      </div>
    </section>

    <div id="listView" hidden class="grid"><div id="list" class="grid"></div><p id="listEmpty" class="sub" hidden>신청서가 없습니다. 섬김 문의에서 "인터뷰 진행 승인"한 뒤 신청서를 만들 수 있습니다.</p></div>

    <div id="formView" hidden class="grid">
      <div class="row"><button id="backBtn" type="button">← 목록</button><strong id="fvName"></strong><span id="fvStatus" class="tag"></span><span id="fvLang" class="tag"></span></div>
      <div class="steps" id="steps"></div>
      <section id="stepBody" class="grid"></section>
      <section id="refsPanel" hidden class="grid"></section>
      <section id="decision" hidden class="grid"></section>
      <details><summary class="meta">열람·수정 기록</summary><div id="audit" class="audit"></div></details>
    </div>
  </main>

  <div class="bar" id="bar" hidden><div class="inner">
    <button id="prevBtn" type="button">← 이전</button><button id="nextBtn" type="button">다음 →</button>
    <span id="saveState" class="meta" style="flex:1"></span>
    <button id="printBtn" type="button">인쇄 / PDF</button><button id="submitBtn" class="primary" type="button">제출</button>
  </div></div>
  <div id="printArea"></div>

  <script is:inline>
    (function () {
      var KEY = 'wolko-hub-token';
      var $ = function (id) { return document.getElementById(id); };
      var STATUS = { draft: '작성 중', submitted: '제출됨', approved: '승인', hold: '보류', rejected: '거절' };
      var S = { schema: [], apps: [], app: null, values: {}, step: 0, dirty: false, timer: 0, saving: false, errors: {} };
      function headers(json) { var h = { Authorization: 'Bearer ' + (sessionStorage.getItem(KEY) || '') }; if (json) h['Content-Type'] = 'application/json'; return h; }
      function esc(v) { return String(v == null ? '' : v).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
      function when(iso) { try { return new Date(iso).toLocaleString('ko-KR', { timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit' }); } catch (e) { return iso || ''; } }
      async function api(method, query, body) {
        var res = await fetch('/api/portal/serve-applications' + (query || ''), { method: method, headers: headers(!!body), body: body ? JSON.stringify(body) : undefined });
        var data = await res.json().catch(function () { return {}; });
        if (!res.ok) { var e = new Error(data.error || '처리하지 못했습니다.'); e.data = data; e.status = res.status; throw e; }
        return data;
      }
      function locked() { return S.app && ['approved', 'hold', 'rejected'].indexOf(S.app.status) >= 0; }
      function fieldVisible(f) { return !f.showIf || S.values[f.showIf.field] === f.showIf.equals; }
      function allFields() { return S.schema.reduce(function (a, s) { return a.concat(s.fields); }, []); }

      /* ── 목록 ── */
      function showList() {
        location.hash = ''; S.app = null; $('formView').hidden = true; $('bar').hidden = true; $('listView').hidden = false;
        $('list').innerHTML = S.apps.map(function (a) {
          return '<div class="card row" style="justify-content:space-between"><div><strong>' + esc(a.name) + '</strong> ' + esc(a.nameKo && a.name !== a.nameKo ? '(' + a.nameKo + ')' : '') +
            ' <span class="tag ' + a.status + '">' + STATUS[a.status] + '</span> <span class="tag">' + (a.lang === 'ko' ? '한글' : 'English') + '</span>' + (a.source === 'online' ? ' <span class="tag">온라인 지원 ' + esc(a.refNo || '') + '</span>' : '') + '<div class="meta">수정 ' + when(a.updatedAt) + '</div></div>' +
            '<button type="button" class="primary" data-open="' + esc(a.id) + '">열기</button></div>';
        }).join('');
        $('listEmpty').hidden = S.apps.length > 0;
      }
      /* ── 폼 ── */
      function labelHtml(f) { return '<span class="lbl">' + esc(f.label.ko) + (f.required ? ' <span class="req">*</span>' : '') + (f.sensitive ? '<span class="sens">민감</span>' : '') + '<small>' + esc(f.label.en) + '</small></span>'; }
      function inputHtml(f) {
        var v = S.values[f.id], dis = locked() ? ' disabled' : '', id = 'f_' + f.id;
        if (f.type === 'textarea') return '<textarea id="' + id + '" data-f="' + f.id + '"' + dis + '>' + esc(v) + '</textarea>';
        if (f.type === 'select') return '<select id="' + id + '" data-f="' + f.id + '"' + dis + '><option value="">—</option>' + f.options.map(function (o) { return '<option value="' + esc(o.v) + '"' + (v === o.v ? ' selected' : '') + '>' + esc(o.ko) + ' / ' + esc(o.en) + '</option>'; }).join('') + '</select>';
        if (f.type === 'radio') return '<div class="opts">' + f.options.map(function (o) { return '<label class="opt"><input type="radio" name="' + id + '" data-f="' + f.id + '" value="' + esc(o.v) + '"' + (v === o.v ? ' checked' : '') + dis + '> ' + esc(o.ko) + ' / ' + esc(o.en) + '</label>'; }).join('') + '</div>';
        if (f.type === 'checkbox') return '<label class="opt"><input type="checkbox" id="' + id + '" data-f="' + f.id + '"' + (v ? ' checked' : '') + dis + '> <span>' + esc(f.label.ko) + '<small class="meta" style="display:block">' + esc(f.label.en) + '</small></span></label>';
        return '<input id="' + id + '" data-f="' + f.id + '" type="' + (f.type === 'tel' ? 'tel' : f.type) + '" value="' + esc(v) + '"' + dis + '>';
      }
      function renderStep() {
        var sec = S.schema[S.step], html = '<h2>' + esc(sec.title.ko) + ' <span class="meta">' + esc(sec.title.en) + '</span></h2>';
        if (sec.id === 'internal') html += '<p class="sub">이 영역은 월코 내부 기록입니다(지원자에게 보이지 않음).</p>';
        var fields = sec.fields.filter(fieldVisible), pair = sec.id.indexOf('reference') === 0 ? 2 : 0;
        html += '<div class="' + (pair ? 'two' : 'grid') + '">' + fields.map(function (f) {
          if (f.type === 'checkbox') return '<div class="field' + (S.errors[f.id] ? ' err' : '') + '" style="grid-column:1/-1">' + inputHtml(f) + '</div>';
          return '<div class="field' + (S.errors[f.id] ? ' err' : '') + '"' + (f.type === 'textarea' || f.type === 'radio' ? ' style="grid-column:1/-1"' : '') + '><label class="lbl" for="f_' + f.id + '">' + labelHtml(f) + '</label>' + inputHtml(f) + '</div>';
        }).join('') + '</div>';
        $('stepBody').innerHTML = html;
        $('steps').innerHTML = S.schema.map(function (s, i) {
          var bad = s.fields.some(function (f) { return S.errors[f.id]; });
          return '<button type="button" class="step' + (i === S.step ? ' active' : '') + (bad ? ' err' : '') + '" data-step="' + i + '">' + (i + 1) + '. ' + esc(s.title.ko.split(' (')[0]) + '</button>';
        }).join('');
        $('prevBtn').disabled = S.step === 0; $('nextBtn').disabled = S.step === S.schema.length - 1;
      }
      function renderFormChrome() {
        var a = S.app, v = S.values;
        $('fvName').textContent = [v.firstName, v.lastName].filter(Boolean).join(' ') || v.nameKo || '(이름 없음)';
        $('fvStatus').className = 'tag ' + a.status; $('fvStatus').textContent = STATUS[a.status];
        $('fvLang').className = 'tag'; $('fvLang').textContent = a.lang === 'ko' ? '한글' : 'English';
        $('submitBtn').hidden = locked();
        $('submitBtn').textContent = a.status === 'submitted' ? '다시 제출' : '제출';
        var d = $('decision');
        d.hidden = !(a.status === 'submitted' || locked());
        d.innerHTML = '<h2>최종 결정</h2>' + (locked()
          ? '<div class="row"><span class="tag ' + a.status + '">' + STATUS[a.status] + '</span><span class="meta">' + when(a.decidedAt) + '</span><button type="button" data-decide="reopen">다시 열기</button></div>'
          : '<textarea id="decNote" placeholder="메모(선택)" style="min-height:60px"></textarea><div class="row"><button type="button" class="primary" data-decide="approved">최종 승인</button><button type="button" data-decide="hold">보류</button><button type="button" class="danger" data-decide="rejected">거절</button></div><p class="sub">거절·보류한 신청서는 결정 후 12개월이 지나면 자동 삭제됩니다.</p>');
        $('audit').innerHTML = (a.audit || []).slice().reverse().slice(0, 40).map(function (x) { return '<span>' + when(x.at) + ' · ' + esc(x.by) + ' · ' + esc(x.action) + (x.note ? ' — ' + esc(x.note) : '') + '</span>'; }).join('');
      }
      /* ── 추천서 (온라인 지원서 — 추천인이 메일 링크로 작성, 암호화 저장) ── */
      var REF_STATE = { sent: '요청 메일 보냄 · 답변 기다리는 중', failed: '요청 메일 발송 실패', completed: '추천서 도착' };
      function renderRefs(schema) {
        var a = S.app, box = $('refsPanel'), refs = a.references || [];
        box.hidden = !refs.length; if (!refs.length) return;
        var fields = (schema || []).reduce(function (x, s) { return x.concat(s.fields.map(function (f) { return Object.assign({ sec: s.title.ko }, f); })); }, []);
        var label = function (f, v) { if (f.type === 'checkbox') return v ? '예' : '아니요'; var o = (f.options || []).filter(function (o) { return o.v === v; })[0]; return o ? o.ko : v; };
        box.innerHTML = '<h2>추천서 <span class="meta">References · 지원자에게 보이지 않음</span></h2>' + refs.map(function (r) {
          var ans = (a.referenceAnswers || {})[r.n];
          var head = '<div class="row" style="justify-content:space-between"><strong>추천인 ' + r.n + ' · ' + esc(r.name || '') + ' <span class="meta">' + esc(r.email) + '</span></strong><span class="tag ' + (r.status === 'completed' ? 'approved' : r.status === 'failed' ? 'rejected' : 'submitted') + '">' + esc(REF_STATE[r.status] || r.status) + '</span></div>';
          if (!ans) return '<div class="card">' + head + '<div class="meta">요청 ' + when(r.sentAt) + '</div></div>';
          if (ans.error) return '<div class="card">' + head + '<p class="msg bad">' + esc(ans.error) + '</p></div>';
          var rows = fields.filter(function (f) { return ans[f.id] !== undefined && ans[f.id] !== ''; }).map(function (f) {
            return '<div class="field" style="grid-column:1/-1"><span class="lbl">' + esc(f.label.ko) + '<small>' + esc(f.label.en) + '</small></span><div style="white-space:pre-wrap">' + esc(label(f, ans[f.id])) + '</div></div>';
          }).join('');
          return '<details class="card" open><summary>' + head + '</summary><div class="meta">제출 ' + when(ans.submittedAt) + '</div><div class="grid">' + rows + '</div></details>';
        }).join('');
      }
      async function openApp(id) {
        var data = await api('GET', '?id=' + encodeURIComponent(id));
        S.schema = data.schema; S.app = data.application; S.values = data.application.values || {}; S.step = 0; S.errors = {}; S.dirty = false;
        renderRefs(data.referenceSchema);
        location.hash = id; $('listView').hidden = true; $('formView').hidden = false; $('bar').hidden = false; $('saveState').textContent = '';
        renderFormChrome(); renderStep();
      }
      /* ── 저장 ── */
      function setState(text, bad) { $('saveState').textContent = text; $('saveState').style.color = bad ? 'var(--bad)' : ''; }
      async function save(submit) {
        clearTimeout(S.timer);
        if (!S.app || locked()) return true;
        S.saving = true; setState(submit ? '제출하는 중…' : '저장 중…');
        try {
          var r = await api('PUT', '', { id: S.app.id, values: S.values, submit: !!submit });
          S.dirty = false; S.app.status = r.appStatus; S.errors = {};
          setState((submit ? '제출했습니다 · ' : '자동 저장됨 · ') + new Date().toLocaleTimeString('ko-KR', { hour: '2-digit', minute: '2-digit' }));
          renderFormChrome(); return true;
        } catch (e) {
          if (e.data && e.data.missing) { S.errors = {}; e.data.missing.forEach(function (id) { S.errors[id] = 1; }); var first = e.data.missing[0]; S.schema.forEach(function (s, i) { if (s.fields.some(function (f) { return f.id === first; })) S.step = i; }); renderStep(); setState('필수 항목 ' + e.data.missing.length + '개가 비어 있습니다.', true); }
          else setState(e.message, true);
          return false;
        } finally { S.saving = false; }
      }
      function schedule() { S.dirty = true; setState('입력 중…'); clearTimeout(S.timer); S.timer = setTimeout(function () { save(false); }, 1500); }
      /* ── 인쇄 ── */
      function buildPrint() {
        var html = '<h1>월코 섬김 지원 신청서 / WOLKO Team Member Application</h1>';
        S.schema.forEach(function (sec) {
          var rows = sec.fields.filter(fieldVisible).map(function (f) {
            var v = S.values[f.id]; if (v === undefined || v === '' || v === false) return '';
            var shown = f.options ? ((f.options.filter(function (o) { return o.v === v; })[0] || {}).ko || v) : (v === true ? '예' : v);
            return '<dt>' + esc(f.label.ko) + ' / ' + esc(f.label.en) + '</dt><dd>' + esc(shown) + '</dd>';
          }).join('');
          if (rows) html += '<h2>' + esc(sec.title.ko) + ' / ' + esc(sec.title.en) + '</h2><dl>' + rows + '</dl>';
        });
        $('printArea').innerHTML = html;
      }
      /* ── 이벤트 ── */
      document.addEventListener('input', function (e) { var f = e.target.getAttribute && e.target.getAttribute('data-f'); if (!f || locked()) return; S.values[f] = e.target.type === 'checkbox' ? e.target.checked : e.target.value; schedule(); });
      document.addEventListener('change', function (e) { var f = e.target.getAttribute && e.target.getAttribute('data-f'); if (!f || locked()) return; if (e.target.type === 'radio' || e.target.tagName === 'SELECT') { S.values[f] = e.target.value; schedule(); renderStep(); } else if (e.target.type === 'checkbox') { S.values[f] = e.target.checked; schedule(); } });
      $('steps').addEventListener('click', function (e) { var b = e.target.closest('[data-step]'); if (b) { S.step = +b.dataset.step; renderStep(); window.scrollTo(0, 0); } });
      $('prevBtn').addEventListener('click', function () { if (S.step > 0) { S.step--; renderStep(); window.scrollTo(0, 0); } });
      $('nextBtn').addEventListener('click', function () { if (S.step < S.schema.length - 1) { S.step++; renderStep(); window.scrollTo(0, 0); } });
      $('submitBtn').addEventListener('click', async function () { await save(true); });
      $('printBtn').addEventListener('click', async function () { if (S.dirty) await save(false); try { await api('GET', '?id=' + encodeURIComponent(S.app.id) + '&export=1'); } catch (e) {} buildPrint(); window.print(); });
      $('backBtn').addEventListener('click', async function () { if (S.dirty) await save(false); await loadList(); });
      $('list').addEventListener('click', function (e) { var b = e.target.closest('[data-open]'); if (b) openApp(b.dataset.open).catch(function (err) { alert(err.message); }); });
      $('decision').addEventListener('click', async function (e) {
        var b = e.target.closest('[data-decide]'); if (!b) return;
        var act = b.dataset.decide, note = ($('decNote') || {}).value || '';
        if (act === 'rejected' && !confirm('이 신청서를 거절 처리할까요?')) return;
        try {
          await api('PATCH', '', act === 'reopen' ? { id: S.app.id, action: 'reopen' } : { id: S.app.id, action: 'decide', status: act, note: note });
          await openApp(S.app.id);
        } catch (err) { setState(err.message, true); }
      });
      window.addEventListener('beforeunload', function (e) { if (S.dirty) { e.preventDefault(); e.returnValue = ''; } });
      async function loadList() {
        var data = await api('GET', '');
        S.schema = data.schema; S.apps = data.applications; showList();
      }
      async function start() {
        var id = decodeURIComponent((location.hash || '').slice(1)); // 목록을 그리면 주소의 #가 지워지므로 먼저 읽어 둔다
        try {
          await loadList(); $('loginBox').hidden = true;
          if (id) await openApp(id);
        } catch (e) { $('loginBox').hidden = false; $('listView').hidden = true; $('loginMsg').textContent = e.message; }
      }
      $('loginBtn').addEventListener('click', async function () {
        $('loginMsg').textContent = '';
        try {
          var res = await fetch('/api/hub/account-login', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: $('email').value, password: $('password').value }) });
          var data = await res.json().catch(function () { return {}; });
          if (!res.ok) throw new Error(data.error || '로그인하지 못했습니다.');
          sessionStorage.setItem(KEY, data.hubToken); $('password').value = ''; await start();
        } catch (err) { $('loginMsg').textContent = err.message; }
      });
      if (sessionStorage.getItem(KEY)) start();
    })();
  </script>
</body>
</html>
