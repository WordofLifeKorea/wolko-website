    }
    function openFileMenu(tile, x, y) {
      if (!canWrite || !currentItem) return;
      const meta = (currentItem.files || []).find(f => f.id === tile.dataset.contextFile);
      if (!meta) return;
      closeFileMenu();
      fileMenuTrigger = tile.querySelector('button');
      fileMenu = document.createElement('div');
      fileMenu.className = 'file-context-menu';
      fileMenu.setAttribute('role', 'dialog');
      fileMenu.setAttribute('aria-label', meta.fileName);
      for (const [label, action] of [
        [t('renameFile'), () => { closeFileMenu(); renameFile(meta.id); }],
        [t('moveFile'), () => {
          fileMenu.innerHTML = moveOptionsHtml(meta);
          fileMenu.querySelector('select')?.focus();
        }],
        [t('removeFile'), () => { closeFileMenu(); deleteFile(meta.id); }],
      ]) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = label;
        button.addEventListener('click', action);
        fileMenu.append(button);
      }
      document.body.append(fileMenu);
      fileMenu.style.left = Math.max(8, Math.min(x, window.innerWidth - fileMenu.offsetWidth - 8)) + 'px';
      fileMenu.style.top = Math.max(8, Math.min(y, window.innerHeight - fileMenu.offsetHeight - 8)) + 'px';
      fileMenu.querySelector('button').focus();
