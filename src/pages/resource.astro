        moveFile: 'Move', fileMovedToast: 'File moved.', fileMoveFailed: 'Could not move the file.',
        addNote: '🖍 Drag to Add a Note', addNoteActive: '✕ Cancel Marking', addNoteHint: 'Drag over the document to mark where the note belongs',
        addNoteAreaPdf: '🖼 Mark an Image/Table Area', addNoteHintPdf: 'Just drag over any text to select it — a note box pops up automatically. Use this button only for non-text parts like images or tables.',
        addGeneralNote: '+ Add Note', addTimeNote: '+ Note at This Time',
        notesLabel: 'Notes', notesEmpty: 'No notes yet. Drag over text in the document, or click the button above to mark an area.', notePlaceholder: 'Describe what needs fixing here',
        noteCancel: 'Cancel', noteSave: 'Save', noteResolve: 'Resolve', noteReopen: 'Reopen', noteDelete: 'Delete',
        noteDeleteConfirm: 'Delete this note?', noteSaveFailed: 'Could not save the note.', noteDeleteFailed: 'Could not delete the note.', noteUpdateFailed: 'Could not update the note.',
        noteDeletedToast: 'Note deleted.',
        openInNewTab: 'Open in new tab', cannotPreviewInline: "This file type can't be previewed inline.",
        pageOf: (n, total) => `${n} / ${total}`, loadingFile: 'Loading...', pdfLoadFailed: 'Could not load the PDF.', zoomReset: 'Click to reset to 100% (fit width)',
      },
    };
    let lang = localStorage.getItem('wolko-lang') === 'en' ? 'en' : 'ko';
    function t(key) { return T[lang]?.[key] ?? T.ko[key] ?? key; }

    let resources = [];
    let lastUpdatedAt = '';
    let canWrite = false;
    let currentItem = null; // 에디터가 열려 있는 동안의 현재 항목(파일 업로드 등에서 참조)
    let editorMode = 'view'; // 'view' | 'edit'
    const $ = id => document.getElementById(id);
    const STAGE_COUNT = 3;
    const STAGE_COLORS = ['#6f55c9', '#d88217', '#0077a3', '#16865a']; // stage 0~3(완료)
    const MAX_FILE_BYTES = 24 * 1024 * 1024; // Cloudflare KV 값 한도(25MiB) 아래 안전 여유

    function parseSession() {
      const token = sessionStorage.getItem('wolko-hub-token') || '';
      try { const raw = atob(token).split(':'); const exp = Number(raw[3]); return raw[0] === 'wolko-hub' && raw.length === 5 && exp > Date.now() ? { token, email: raw[1], role: raw[2] } : null; } catch { return null; }
    }
    function authHeaders() { return { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (parseSession()?.token || '') }; }
    function esc(value) { return String(value || '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char])); }
    function toast(message, isError = false) { const el = $('toast'); el.textContent = message; el.classList.toggle('is-error', isError); el.classList.add('show'); clearTimeout(toast.timer); toast.timer = setTimeout(() => el.classList.remove('show'), 3200); }
    function percent(items) { return items.length ? Math.round(items.reduce((sum, item) => sum + Number(item.progress || 0), 0) / items.length) : 0; }
    function ring(percentValue, color, large = false) { return `<div class="progress-ring${large ? ' progress-ring-lg' : ''}" style="--progress:${percentValue};--ring-color:${color}"><div class="ring-inner"><strong>${percentValue}%</strong>${large ? `<span>${esc(t('overallLabel'))}</span>` : ''}</div></div>`; }
    // 3단계 각각 몇 %까지 됐는지(stagePercents)를 보고, 아직 100%가 안 된
    // 첫 단계를 "현재 진행 중인 단계"로 본다. 전부 100%면 완료.
    function currentStageIndex(percents) {
      const p = Array.isArray(percents) && percents.length === STAGE_COUNT ? percents : [0, 0, 0];
      const idx = p.findIndex(v => v < 100);
      return idx === -1 ? STAGE_COUNT : idx;
    }
    function stageColor(percents) { return STAGE_COLORS[Math.min(STAGE_COUNT, currentStageIndex(percents))]; }
    function stageLabel(percents) { const idx = currentStageIndex(percents); return idx >= STAGE_COUNT ? t('stageComplete') : t('stageActive' + (idx + 1)); }
    function stageMarkup(percents) { return `<span class="status-pill" style="--status:${stageColor(percents)}"><i></i>${esc(stageLabel(percents))}</span>`; }
    function formatUpdated(value) { if (!value) return ''; try { return new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'ko-KR', { month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(value)) + (lang === 'en' ? ' updated' : ' 업데이트'); } catch { return ''; } }
    function formatLogTime(value) { try { return new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'ko-KR', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(value)); } catch { return ''; } }
    function humanFileSize(bytes) { const n = Number(bytes) || 0; if (n < 1024) return n + ' B'; if (n < 1024 * 1024) return Math.round(n / 1024) + ' KB'; return (n / (1024 * 1024)).toFixed(1) + ' MB'; }

    function applyStaticLang() {
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-t]').forEach(el => {
        const key = el.getAttribute('data-t');
        const val = t(key);
        if (typeof val === 'string') el.textContent = val;
      });
      document.querySelectorAll('[data-t-ph]').forEach(el => {
        const val = t(el.getAttribute('data-t-ph'));
        if (typeof val === 'string') el.placeholder = val;
      });
      $('langKoBtn')?.classList.toggle('is-active', lang === 'ko');
      $('langEnBtn')?.classList.toggle('is-active', lang === 'en');
    }
    function setLang(next) {
      if (lang === next) return;
      lang = next;
      localStorage.setItem('wolko-lang', lang);
      applyStaticLang();
      render();
      if (!$('editorOverlay').hidden) openEditor($('resourceId').value);
    }

    function render() {
      $('updatedAt').textContent = formatUpdated(lastUpdatedAt);
      const total = resources.length;
      const overall = percent(resources);
      const translating = resources.filter(item => currentStageIndex(item.stagePercents) === 0).length;
      const complete = resources.filter(item => currentStageIndex(item.stagePercents) >= STAGE_COUNT).length;
      $('overallRing').style.setProperty('--progress', overall); $('overallPercent').textContent = overall + '%';
      $('overallCaption').textContent = total ? t('overallCaptionN')(total) : t('overallCaptionEmpty');
      $('summaryGrid').innerHTML = [
        [t('summaryItems'), total], [t('summaryAvg'), overall + '%'], [t('summaryTranslating'), translating], [t('summaryComplete'), complete],
      ].map(([label, value]) => `<article class="summary-card"><strong>${value}</strong><span>${esc(label)}</span></article>`).join('');
      $('resourceGrid').innerHTML = total ? resources.map(item => {
        const color = stageColor(item.stagePercents);
        const thumb = item.thumbnailData ? `<img src="${item.thumbnailData}" alt="">` : `<span class="thumb-placeholder">W<br>RESOURCE</span>`;
        return `<article class="resource-card" onclick="openEditor('${item.id}')"><div class="resource-thumb">${thumb}</div><div class="resource-body"><div class="resource-top">${stageMarkup(item.stagePercents)}</div><h3>${esc(item.title)}</h3><p class="translation-line">${item.translation ? esc(item.translation) : esc(t('noTranslation'))}</p>${item.detail ? `<p class="detail-line">${esc(item.detail)}</p>` : ''}<div class="resource-progress"><div class="bar"><i style="width:${item.progress}%"></i></div><span>${item.progress}%</span></div></div><div class="card-ring">${ring(item.progress, color)}</div></article>`;
      }).join('') : `<div class="empty-state"><strong>${esc(t('emptyTitle'))}</strong><span>${esc(canWrite ? t('emptyHintWrite') : t('emptyHintRead'))}</span></div>`;
      $('addResourceBtn').hidden = !canWrite;
    }

    async function loadResources() {
      const res = await fetch('/api/portal/resources', { headers: authHeaders() });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) return logout();
      if (!res.ok) throw new Error(data.error || t('loadFailed'));
      resources = Array.isArray(data.items) ? data.items : []; canWrite = !!data.canWrite; lastUpdatedAt = data.updatedAt || ''; render();
    }

    /* ── 첨부 파일 (레슨 폴더 안에 원본/수정본으로 정리) ── */
    // 이미 올라간 파일을 다른 폴더(원본/수정본)나 미분류로 옮기는 드롭다운.
    // 지금 있는 위치는 목록에서 빼서, 옮길 곳만 보이게 한다.
    function moveOptionsHtml(meta) {
      if (!canWrite) return '';
      const folders = currentItem.folders || [];
      const current = `${meta.folderId || ''}|${meta.category || ''}`;
      const options = [];
      if (current !== '|') options.push(`<option value="|">${esc(t('unfiledLabel'))}</option>`);
      folders.forEach(f => {
        if (`${f.id}|original` !== current) options.push(`<option value="${f.id}|original">${esc(f.name)} · ${esc(t('originalLabel'))}</option>`);
        if (`${f.id}|revised` !== current) options.push(`<option value="${f.id}|revised">${esc(f.name)} · ${esc(t('revisedLabel'))}</option>`);
      });
      if (!options.length) return '';
      return `<select class="file-move-select" data-file-id="${meta.id}" onchange="moveFileEvent(this)"><option value="" selected disabled>${esc(t('moveFile'))}</option>${options.join('')}</select>`;
    }
    // 확장자별로 색이 다른 작은 뱃지 아이콘 — 실제 아이콘 파일 없이 목록을
    // 파일 탐색기처럼 한눈에 훑어볼 수 있게 한다.
    const FILE_TYPE_MAP = {
      pdf: ['PDF', '#c0392b', '#fdecea'],
      zip: ['ZIP', '#6c5ce7', '#efecfd'], rar: ['ZIP', '#6c5ce7', '#efecfd'], '7z': ['ZIP', '#6c5ce7', '#efecfd'],
      doc: ['DOC', '#2b579a', '#e8eefa'], docx: ['DOC', '#2b579a', '#e8eefa'],
      xls: ['XLS', '#1e7145', '#e7f5ee'], xlsx: ['XLS', '#1e7145', '#e7f5ee'],
      ppt: ['PPT', '#c0392b', '#fdecea'], pptx: ['PPT', '#c0392b', '#fdecea'],
      png: ['IMG', '#008e92', '#e6f6f6'], jpg: ['IMG', '#008e92', '#e6f6f6'], jpeg: ['IMG', '#008e92', '#e6f6f6'], gif: ['IMG', '#008e92', '#e6f6f6'], webp: ['IMG', '#008e92', '#e6f6f6'],
      mp4: ['VID', '#d88217', '#fdf3e7'], mov: ['VID', '#d88217', '#fdf3e7'],
      mp3: ['AUD', '#d88217', '#fdf3e7'], wav: ['AUD', '#d88217', '#fdf3e7'], m4a: ['AUD', '#d88217', '#fdf3e7'],
    };
    function fileIconHtml(fileName) {
      const ext = (fileName.split('.').pop() || '').toLowerCase();
      const [label, color, bg] = FILE_TYPE_MAP[ext] || [ext ? ext.slice(0, 4).toUpperCase() : 'FILE', '#67808d', '#eef2f4'];
      return `<span class="file-type-icon" style="color:${color};background:${bg};">${esc(label)}</span>`;
    }
    // File actions are available through the context menu and keyboard menu key.
    function fileTileHtml(meta) {
      const metaLine = `${t('uploadedBy')(esc(meta.uploadedByName || meta.uploadedBy || ''), esc(formatLogTime(meta.uploadedAt)))} · ${humanFileSize(meta.fileSize)}`;
      const openNotes = (currentItem.annotations || []).filter(a => a.fileId === meta.id && a.status === 'open').length;
      const noteBadge = openNotes ? `<span class="file-tile-note-badge">${openNotes}</span>` : '';
      return `<div class="file-tile" data-context-file="${meta.id}">
        <button type="button" class="file-tile-newtab" onclick="event.stopPropagation();openInNewTab('${meta.id}')" title="${esc(t('openInNewTab'))}" aria-label="${esc(t('openInNewTab'))}">↗</button>
        <button type="button" class="file-tile-preview" onclick="previewFile('${meta.id}')" title="${esc(t('previewFile'))}">
          ${noteBadge}
          ${fileIconHtml(meta.fileName)}
          <span class="file-tile-name" title="${esc(meta.fileName)}">${esc(meta.fileName)}</span>
          <span class="file-tile-meta">${metaLine}</span>
        </button>
      </div>`;
    }
    function filesIn(folderId, category) {
      return (currentItem.files || [])
        .filter(f => (f.folderId || null) === folderId && (category === undefined || (f.category || null) === category))
        .sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
    }
    function fileGroupHtml(files, folderId, category) {
      if (folderId) return fileDetailsHtml(files, folderId, category);
      const tiles = files.map(fileTileHtml).join('');
      const emptyMsg = !files.length && !canWrite ? `<p class="file-empty">${esc(t('noFileRead'))}</p>` : '';
      const addTile = canWrite ? `<label class="file-tile file-tile-add"><input type="file" multiple data-folder-id="${folderId || ''}" data-category="${category || ''}" onchange="handleFileUploadEvent(this)"><span class="file-tile-add-icon">+</span><span class="file-tile-name">${esc(t('addFile'))}</span></label>` : '';
      const addRow = `<div class="file-icon-grid">${tiles}${addTile}</div>`;
      return emptyMsg + addRow;
    }
    function fileDetailsHtml(files, folderId, category) {
      const labels = lang === 'en'
        ? ['Name', 'Size', 'Kind', 'Uploaded']
        : ['이름', '크기', '종류', '업로드 일시'];
      const rows = files.map(meta => {
        const extension = meta.fileName.includes('.') ? meta.fileName.split('.').pop().toUpperCase() : '';
        const kind = extension || (lang === 'en' ? 'File' : '파일');
        let date = '', time = '';
        try {
          const uploadedAt = new Date(meta.uploadedAt);
          const locale = lang === 'en' ? 'en-US' : 'ko-KR';
          date = new Intl.DateTimeFormat(locale, {
            year:'numeric', month:'2-digit', day:'2-digit',
          }).format(uploadedAt);
          time = new Intl.DateTimeFormat(locale, { hour:'2-digit', minute:'2-digit' }).format(uploadedAt);
        } catch {}
        return `<tr data-context-file="${esc(meta.id)}" onclick="previewFile('${meta.id}')">
          <td><button type="button" class="file-details-name" title="${esc(meta.fileName)}">${fileIconHtml(meta.fileName)}<span>${esc(meta.fileName)}</span></button></td>
          <td class="file-details-size">${humanFileSize(meta.fileSize)}</td>
          <td class="file-details-kind">${esc(kind)}</td>
          <td class="file-details-date" title="${esc(meta.uploadedByName || meta.uploadedBy || '')}"><span>${esc(date)}</span> <span class="file-details-time">${esc(time)}</span></td>
          <td class="file-details-newtab"><button type="button" onclick="event.stopPropagation();openInNewTab('${meta.id}')" title="${esc(t('openInNewTab'))}" aria-label="${esc(t('openInNewTab'))}">↗</button></td>
        </tr>`;
      }).join('');
      const addRow = canWrite ? `<label class="file-details-add"><input type="file" multiple data-folder-id="${folderId}" data-category="${category || ''}" onchange="handleFileUploadEvent(this)"><span aria-hidden="true">+</span>${esc(t('addFile'))}</label>` : '';
      return `<div class="file-details-wrap"><table class="file-details-table"><thead><tr>${labels.map((label, i) => `<th scope="col" class="${['', 'file-details-size', 'file-details-kind', 'file-details-date'][i]}">${esc(label)}</th>`).join('')}<th scope="col" class="file-details-newtab"></th></tr></thead><tbody>${rows || `<tr><td colspan="5" class="file-details-empty">${esc(t('noFileRead'))}</td></tr>`}</tbody></table></div>${addRow}`;
    }
    const FOLDER_ICON_SVG = '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg>';
    let currentFolderId = null; // null = 폴더 탐색기 최상위(미분류 + 폴더 아이콘 목록), 그 외엔 그 폴더 안
    function openFolder(folderId) { currentFolderId = folderId; renderFilesAndFolders(); }
    function closeFolderView() { currentFolderId = null; renderFilesAndFolders(); }
    function renderFilesAndFolders() {
      closeFileMenu();
      if (!currentItem) { // 새 항목(아직 저장 전)은 파일을 못 붙인다
        $('filesBody').innerHTML = `<p class="file-empty">${esc(t('savedAfterCreate'))}</p>`;
        return;
      }
      const folders = currentItem.folders || [];
      const openFolderData = currentFolderId ? folders.find(f => f.id === currentFolderId) : null;

      // 폴더 안으로 들어간 상태 — 뒤로가기 + 그 폴더의 원본/수정본만 보여준다.
      if (openFolderData) {
        $('filesBody').innerHTML = `
          <div class="folder-nav">
            <button type="button" class="folder-back-btn" onclick="closeFolderView()">${esc(t('backToFolders'))}</button>
            <span class="folder-nav-name">${esc(openFolderData.name)}</span>
            ${canWrite ? `<button type="button" class="file-btn" onclick="renameFolder('${openFolderData.id}')">${esc(t('renameFolder'))}</button>` : ''}
            ${canWrite ? `<button type="button" class="file-btn is-danger" onclick="deleteFolder('${openFolderData.id}')">${esc(t('deleteFolder'))}</button>` : ''}
          </div>
          <div class="folder-category is-revised">
            <div class="folder-category-label">${esc(t('revisedLabel'))}<span>${esc(t('fileCount')(filesIn(openFolderData.id, 'revised').length))}</span></div>
            ${fileGroupHtml(filesIn(openFolderData.id, 'revised'), openFolderData.id, 'revised')}
          </div>
          <div class="folder-category is-original">
            <div class="folder-category-label">${esc(t('originalLabel'))}<span>${esc(t('fileCount')(filesIn(openFolderData.id, 'original').length))}</span></div>
            ${fileGroupHtml(filesIn(openFolderData.id, 'original'), openFolderData.id, 'original')}
          </div>`;
        return;
      }

      // 최상위 — 미분류 파일 + 폴더 아이콘 그리드(더블클릭 없이 클릭으로 열기).
      currentFolderId = null;
      const unfiled = filesIn(null, undefined);
      let html = '';
      if (unfiled.length || !folders.length) {
        html += `<div class="file-group"><div class="file-group-head">${esc(t('unfiledLabel'))}</div>${fileGroupHtml(unfiled, null, null)}</div>`;
      }
      if (folders.length) {
        html += `<div class="folder-grid">${folders.map(folder => {
          const count = (currentItem.files || []).filter(f => f.folderId === folder.id).length;
          return `<button type="button" class="folder-icon-item" onclick="openFolder('${folder.id}')">${FOLDER_ICON_SVG}<span class="folder-icon-name">${esc(folder.name)}</span><span class="folder-icon-count">${t('fileCount')(count)}</span></button>`;
        }).join('')}</div>`;
      }
      if (canWrite) {
        html += `<div class="folder-add-row"><input type="text" id="newFolderName" maxlength="60" placeholder="${esc(t('folderNamePh'))}" onkeydown="if(event.key==='Enter'){event.preventDefault();addFolder();}"><button type="button" class="file-btn" onclick="addFolder()">${esc(t('addFolder'))}</button></div>`;
      }
      $('filesBody').innerHTML = html;
    }
    function renderUploadLog() {
      const log = currentItem?.uploadLog || [];
      if (!log.length) { $('uploadLogList').innerHTML = `<p class="upload-log-empty">${esc(t('uploadLogEmpty'))}</p>`; return; }
