---
// Resource & Media — 발표용 Resource 작업 현황 리포트(구 portal.astro, 주소 /portal → /resource로 이동).
// "WOLKO Portal" 이름은 내부 도구 런처(portal.astro, 구 hub.astro)가 물려받았다.
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>Resource & Media — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Noto+Sans+KR:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolko-auth.css?v=1">
  <link rel="stylesheet" href="/wolko-rail.css?v=9">
  <link rel="stylesheet" href="/wolko-lang-toggle.css?v=2">
  <link rel="stylesheet" href="/portal.css?v=17">
  <script src="/wolko-rail.js?v=9" defer></script>
</head>
<body>
  <div class="login-screen" id="loginScreen">
    <div class="login-card">
      <div class="login-logo"><img src="/images/WOLKO Circle.png" alt="WOLKO"><div class="login-logo-text"><span class="login-logo-name">WOLKO 월코</span><span class="login-logo-sub">Word of Life Korea</span></div></div>
      <p class="login-title" data-t="loginTitle">포탈 로그인이 필요합니다</p>
      <p class="login-description" data-t="loginDesc">Resource & Media는 WOLKO 포탈 계정으로 확인할 수 있습니다.</p>
      <a class="login-btn" href="/portal" style="display:block;text-align:center;text-decoration:none;" data-t="loginBtn">포탈로 이동</a>
    </div>
  </div>

  <header class="portal-header">
    <a class="portal-brand" href="/portal"><img src="/images/WOLKO Circle.png" alt="WOLKO"><span>Resource & Media</span></a>
    <div class="portal-header-actions">
      <span class="viewer-label" id="viewerLabel"></span>
      <div class="wl-lang-toggle" role="group" aria-label="Language">
        <button type="button" class="wl-lang-btn" id="langKoBtn" onclick="setLang('ko')" aria-label="한국어" title="한국어"><img src="https://flagcdn.com/w20/kr.png" alt=""><span>KO</span></button>
        <button type="button" class="wl-lang-btn" id="langEnBtn" onclick="setLang('en')" aria-label="English" title="English"><img src="https://flagcdn.com/w20/us.png" alt=""><span>EN</span></button>
      </div>
      <a class="back-link" href="/portal" data-t="backToPortal">포탈</a>
      <button class="logout-btn" type="button" onclick="logout()" data-t="logout">로그아웃</button>
    </div>
  </header>

  <main class="portal-main" id="portalMain" hidden>
    <section class="hero-panel">
      <div class="hero-copy"><p class="eyebrow" data-t="heroEyebrow">RESOURCE REPORT</p><h1 data-t="heroTitle">자료 제작 진행 현황</h1><p data-t="heroDesc">번역과 제작 중인 자료를 한눈에 확인하고, 발표에 바로 사용할 수 있는 진행 리포트입니다.</p></div>
      <div class="overall-progress" id="overallProgress"><div class="progress-ring progress-ring-lg" id="overallRing"><div class="ring-inner"><strong id="overallPercent">0%</strong><span data-t="overallLabel">전체 완성도</span></div></div><p id="overallCaption"></p></div>
    </section>

    <section class="summary-grid" id="summaryGrid"></section>

    <section class="report-section">
      <div class="section-head"><div><h2 data-t="sectionTitle">작업 중인 자료</h2></div><button class="add-resource" id="addResourceBtn" type="button" hidden onclick="openEditor()"><span>+</span> <span data-t="addResourceBtn">항목 추가</span></button></div>
      <p class="report-updated" id="updatedAt"></p>
      <div class="resource-grid" id="resourceGrid"></div>
    </section>
  </main>

  <div class="editor-overlay" id="editorOverlay" hidden>
    <div class="editor-card" id="editorCard">
      <div class="editor-head"><div><p class="section-eyebrow" id="editorEyebrow">RESOURCE DETAIL</p><h2 id="editorTitle"></h2></div><button class="icon-close" type="button" onclick="closeEditor()" aria-label="close">×</button></div>
      <p class="editor-error" id="editorError"></p>

      <!-- ── 보기 모드(기본) — 정돈된 진행 현황 요약, 수정 버튼을 눌러야 편집 폼으로 ── -->
      <div class="detail-view" id="detailView">
        <div class="detail-top-row">
          <div class="resource-thumb" id="detailThumb"><span class="thumb-placeholder">W<br>RESOURCE</span></div>
          <div class="detail-top-info">
            <span class="status-pill" id="detailStatusPill"></span>
            <div class="resource-progress"><div class="bar"><i id="detailProgressBar" style="width:0%"></i></div><span id="detailProgressPct">0%</span></div>
          </div>
        </div>
        <div class="detail-field"><span class="field-label" data-t="fieldTranslation">번역/제작 내용</span><p id="detailTranslation"></p></div>
        <div class="detail-field" id="detailDetailField" hidden><span class="field-label" data-t="fieldDetail">간단한 진행 메모</span><p id="detailDetail"></p></div>

        <div class="file-slot" id="filesSlot">
          <div class="file-slot-head"><span class="field-label" data-t="filesLabel">첨부 파일</span><p data-t="fileHint">PDF · 이미지 · 문서 · 최대 24MB</p></div>
          <div class="file-slot-body" id="filesBody"></div>
        </div>
        <details class="upload-log-section" id="uploadLogSection">
          <summary class="field-label" data-t="uploadLogLabel">업로드 로그</summary>
          <div class="upload-log" id="uploadLogList"></div>
        </details>

        <div class="detail-actions">
          <button type="button" class="cancel-resource" onclick="closeEditor()" data-t="closeBtn">닫기</button>
          <button type="button" class="save-resource" id="editResourceBtn" onclick="enterEditMode()" hidden data-t="editBtn">수정</button>
        </div>
      </div>

      <!-- ── 수정 모드 — "수정" 버튼을 눌렀을 때만 ── -->
      <form id="editorForm" hidden>
        <input type="hidden" id="resourceId">
        <input type="hidden" id="thumbnailData">
        <label class="field"><span data-t="fieldName">자료 이름</span><input id="resourceName" maxlength="120" required data-t-ph="nameField"></label>
        <div class="field">
          <span><span data-t="fieldStage">진행 단계</span> <b id="stagePct">0%</b></span>
          <div class="stage-stepper" id="stageStepper">
            <div class="stage-card" data-stage-index="0">
              <i>1</i><span data-t="stage1Name">번역</span>
              <select class="stage-pct-select" onchange="setStagePercent(0, this.value)">
                <option value="0">0%</option><option value="10">10%</option><option value="20">20%</option><option value="30">30%</option><option value="40">40%</option><option value="50">50%</option><option value="60">60%</option><option value="70">70%</option><option value="80">80%</option><option value="90">90%</option><option value="100">100%</option>
              </select>
            </div>
            <div class="stage-card" data-stage-index="1">
              <i>2</i><span data-t="stage2Name">검토</span>
              <select class="stage-pct-select" onchange="setStagePercent(1, this.value)">
                <option value="0">0%</option><option value="10">10%</option><option value="20">20%</option><option value="30">30%</option><option value="40">40%</option><option value="50">50%</option><option value="60">60%</option><option value="70">70%</option><option value="80">80%</option><option value="90">90%</option><option value="100">100%</option>
              </select>
            </div>
            <div class="stage-card" data-stage-index="2">
              <i>3</i><span data-t="stage3Name">디자인 및 퍼블리시</span>
              <select class="stage-pct-select" onchange="setStagePercent(2, this.value)">
                <option value="0">0%</option><option value="10">10%</option><option value="20">20%</option><option value="30">30%</option><option value="40">40%</option><option value="50">50%</option><option value="60">60%</option><option value="70">70%</option><option value="80">80%</option><option value="90">90%</option><option value="100">100%</option>
              </select>
            </div>
          </div>
        </div>
        <label class="field"><span data-t="fieldTranslation">번역/제작 내용</span><input id="resourceTranslation" maxlength="120" data-t-ph="translationField"></label>
        <label class="field"><span data-t="fieldDetail">간단한 진행 메모</span><textarea id="resourceDetail" maxlength="260" data-t-ph="detailField"></textarea></label>
        <div class="thumbnail-field">
          <div><span class="field-label" data-t="fieldThumbnail">발표용 썸네일</span><p data-t="thumbnailHint">JPG, PNG, WEBP, GIF · 자동 압축 · 최대 1MB</p></div>
          <label class="thumbnail-upload"><input id="thumbnailInput" type="file" accept="image/jpeg,image/png,image/webp,image/gif" onchange="loadThumbnail(this)"><span data-t="chooseImage">이미지 선택</span></label>
          <div class="thumbnail-preview" id="thumbnailPreview"><span>NO IMAGE</span></div>
        </div>

        <div class="editor-actions">
          <button class="delete-resource" id="deleteResourceBtn" type="button" hidden onclick="deleteResource()" data-t="deleteBtn">삭제</button>
          <span></span>
          <button class="cancel-resource" type="button" onclick="exitEditMode()" id="cancelBtn" data-t="cancelBtn">취소</button>
          <button class="save-resource" id="saveResourceBtn" type="submit" data-t="saveBtn">저장</button>
        </div>
      </form>
    </div>
  </div>

  <div class="toast" id="toast"></div>

  <script is:inline>
    const T = {
      ko: {
        loginTitle: '포탈 로그인이 필요합니다', loginDesc: 'Resource & Media는 WOLKO 포탈 계정으로 확인할 수 있습니다.', loginBtn: '포탈로 이동',
        backToPortal: '포탈', logout: '로그아웃',
        heroEyebrow: '리소스 리포트', heroTitle: '자료 제작 진행 현황', heroDesc: '번역과 제작 중인 자료를 한눈에 확인하고, 발표에 바로 사용할 수 있는 진행 리포트입니다.',
        overallLabel: '전체 완성도', overallCaptionN: n => `${n}개 항목의 평균 진행률`, overallCaptionEmpty: '아직 등록된 작업 항목이 없습니다',
        summaryItems: '전체 항목', summaryAvg: '평균 완성도', summaryTranslating: '번역 진행', summaryComplete: '완료 자료',
        sectionTitle: '작업 중인 자료', addResourceBtn: '항목 추가',
        detailEyebrow: '자료 상세', editorEyebrow: '자료 편집',
        stageActive1: '번역 중', stageActive2: '검토 중', stageActive3: '디자인·퍼블리시 중', stageComplete: '완료',
        stage1Name: '번역', stage2Name: '검토', stage3Name: '디자인 및 퍼블리시', fieldStage: '진행 단계',
        noTranslation: '번역/제작 내용 미입력',
        emptyTitle: '아직 등록된 작업 항목이 없습니다.', emptyHintWrite: '오른쪽 위의 항목 추가 버튼으로 첫 리소스를 등록해보세요.', emptyHintRead: '관리자가 작업 항목을 등록하면 이곳에 표시됩니다.',
        editorAdd: '작업 항목 추가', editorEdit: '작업 항목 수정', editBtn: '수정',
        fieldName: '자료 이름', fieldTranslation: '번역/제작 내용', fieldDetail: '간단한 진행 메모',
        nameField: '예: 2026 Summer Camp Student Book', translationField: '예: 학생 교재 영문 번역 및 편집', detailField: '현재 작업 범위 또는 다음 단계',
        fieldThumbnail: '발표용 썸네일', thumbnailHint: 'JPG, PNG, WEBP, GIF · 자동 압축 · 최대 1MB', chooseImage: '이미지 선택',
        filesLabel: '첨부 파일', fileHint: 'PDF · 이미지 · 문서 · 최대 24MB',
        addFile: '+ 파일 추가', replaceFile: '교체', previewFile: '미리보기', removeFile: '삭제', noFileWrite: '업로드된 파일이 없습니다', noFileRead: '업로드된 파일이 없습니다', uploading: '업로드 중...',
        unfiledLabel: '미분류', originalLabel: '원본', revisedLabel: '번역본',
        folderNamePh: '레슨 이름 (예: 레슨 1)', addFolder: '+ 폴더 추가', deleteFolder: '폴더 삭제',
        backToFolders: '← 목록', renameFolder: '이름 변경', renameFolderPrompt: '새 폴더 이름을 입력하세요',
        fileCount: n => `파일 ${n}개`,
        folderDeleteConfirm: '이 폴더를 삭제할까요? 안의 파일은 미분류로 이동합니다.',
        folderDeletedToast: '폴더를 삭제했습니다.', folderSaveFailed: '폴더를 만들지 못했습니다.', folderDeleteFailed: '폴더를 삭제하지 못했습니다.',
        savedAfterCreate: '항목을 저장한 뒤 파일을 첨부할 수 있습니다.',
        uploadedBy: (name, time) => `${name}님 · ${time}`,
        uploadLogLabel: '업로드 로그', uploadLogEmpty: '아직 업로드 기록이 없습니다.',
        logUploadedFile: name => `${name} 업로드`,
        deleteBtn: '삭제', cancelBtn: '취소', closeBtn: '닫기', saveBtn: '저장',
        nameRequired: '작업 항목 이름을 입력해주세요.', saveFailed: '저장하지 못했습니다.', deleteFailed: '삭제하지 못했습니다.', loadFailed: '리포트를 불러오지 못했습니다.',
        savedToast: '리포트를 저장했습니다.', deletedToast: '작업 항목을 삭제했습니다.', deleteConfirm: '이 작업 항목을 삭제할까요?',
        thumbnailTypeError: 'JPG, PNG, WEBP, GIF 이미지만 올릴 수 있습니다.', thumbnailProcessError: '이미지를 처리하지 못했습니다.',
        fileTooLarge: '파일 용량이 너무 큽니다(최대 24MB).', fileUploadFailed: '파일을 업로드하지 못했습니다.', filePreviewFailed: '파일을 불러오지 못했습니다.', fileDeleteFailed: '파일을 삭제하지 못했습니다.',
        fileRemoveConfirm: '이 파일을 삭제할까요?', fileUploadedToast: '파일을 업로드했습니다.', filesUploadedToast: n => `파일 ${n}개를 업로드했습니다.`, fileRemovedToast: '파일을 삭제했습니다.',
        moveFile: '이동', fileMovedToast: '파일을 이동했습니다.', fileMoveFailed: '파일을 이동하지 못했습니다.',
      },
      en: {
        loginTitle: 'Portal login required', loginDesc: 'Resource & Media is available with your WOLKO Portal account.', loginBtn: 'Go to Portal',
        backToPortal: 'Portal', logout: 'Log out',
        heroEyebrow: 'RESOURCE REPORT', heroTitle: 'Resource Production Status', heroDesc: 'See translation and production work at a glance — a progress report ready to present anytime.',
        overallLabel: 'Overall completion', overallCaptionN: n => `Average progress across ${n} item${n === 1 ? '' : 's'}`, overallCaptionEmpty: 'No work items registered yet',
        summaryItems: 'Total Items', summaryAvg: 'Avg. Progress', summaryTranslating: 'In Translation', summaryComplete: 'Ready to Present',
        sectionTitle: 'Active Resources', addResourceBtn: 'Add Item',
        detailEyebrow: 'RESOURCE DETAIL', editorEyebrow: 'RESOURCE EDITOR',
        stageActive1: 'Translating', stageActive2: 'Reviewing', stageActive3: 'Design & Publish', stageComplete: 'Complete',
        stage1Name: 'Translation', stage2Name: 'Review', stage3Name: 'Design & Publish', fieldStage: 'Progress Stage',
        noTranslation: 'No translation info yet',
        emptyTitle: 'No work items registered yet.', emptyHintWrite: 'Use the Add Item button above to register your first resource.', emptyHintRead: "Items will appear here once an admin adds them.",
        editorAdd: 'Add Work Item', editorEdit: 'Edit Work Item', editBtn: 'Edit',
        fieldName: 'Resource name', fieldTranslation: 'Translation / production notes', fieldDetail: 'Progress notes',
        nameField: 'e.g. 2026 Summer Camp Student Book', translationField: 'e.g. English translation & editing of the student textbook', detailField: 'Current scope or next steps',
        fieldThumbnail: 'Presentation thumbnail', thumbnailHint: 'JPG, PNG, WEBP, GIF · auto-compressed · up to 1MB', chooseImage: 'Choose image',
        filesLabel: 'Attached Files', fileHint: 'PDF · image · document · up to 24MB',
        addFile: '+ Add File', replaceFile: 'Replace', previewFile: 'Preview', removeFile: 'Remove', noFileWrite: 'No file uploaded yet', noFileRead: 'No file uploaded yet', uploading: 'Uploading...',
        unfiledLabel: 'Unfiled', originalLabel: 'Original', revisedLabel: 'Translated',
        folderNamePh: 'Folder name (e.g. Lesson 1)', addFolder: '+ Add Folder', deleteFolder: 'Delete Folder',
        backToFolders: '← Back', renameFolder: 'Rename', renameFolderPrompt: 'Enter a new folder name',
        fileCount: n => `${n} file${n === 1 ? '' : 's'}`,
        folderDeleteConfirm: 'Delete this folder? Files inside will move to Unfiled.',
        folderDeletedToast: 'Folder deleted.', folderSaveFailed: 'Could not create the folder.', folderDeleteFailed: 'Could not delete the folder.',
        savedAfterCreate: 'Save this item first, then you can attach files.',
        uploadedBy: (name, time) => `${name} · ${time}`,
        uploadLogLabel: 'Upload log', uploadLogEmpty: 'No uploads yet.',
        logUploadedFile: name => `uploaded ${name}`,
        deleteBtn: 'Delete', cancelBtn: 'Cancel', closeBtn: 'Close', saveBtn: 'Save',
        nameRequired: 'Please enter a resource name.', saveFailed: 'Could not save.', deleteFailed: 'Could not delete.', loadFailed: 'Could not load the report.',
        savedToast: 'Report saved.', deletedToast: 'Work item deleted.', deleteConfirm: 'Delete this work item?',
        thumbnailTypeError: 'Only JPG, PNG, WEBP, or GIF images are allowed.', thumbnailProcessError: 'Could not process the image.',
        fileTooLarge: 'File is too large (max 24MB).', fileUploadFailed: 'Could not upload the file.', filePreviewFailed: 'Could not load the file.', fileDeleteFailed: 'Could not delete the file.',
        fileRemoveConfirm: 'Delete this file?', fileUploadedToast: 'File uploaded.', filesUploadedToast: n => `Uploaded ${n} files.`, fileRemovedToast: 'File removed.',
        moveFile: 'Move', fileMovedToast: 'File moved.', fileMoveFailed: 'Could not move the file.',
      },
    };
    let lang = localStorage.getItem('wolko-lang') === 'en' ? 'en' : 'ko';
    function t(key) { return T[lang]?.[key] ?? T.ko[key] ?? key; }

    let resources = [];
    let lastUpdatedAt = '';
    let canWrite = false;
    let currentItem = null; // 에디터가 열려 있는 동안의 현재 항목(파일 업로드 등에서 참조)
    let editorMode = 'view'; // 'view' | 'edit'
    const $ = id => document.getElementById(id);
    const STAGE_COUNT = 3;
    const STAGE_COLORS = ['#6f55c9', '#d88217', '#0077a3', '#16865a']; // stage 0~3(완료)
    const MAX_FILE_BYTES = 24 * 1024 * 1024; // Cloudflare KV 값 한도(25MiB) 아래 안전 여유

    function parseSession() {
      const token = sessionStorage.getItem('wolko-hub-token') || '';
      try { const raw = atob(token).split(':'); const exp = Number(raw[3]); return raw[0] === 'wolko-hub' && raw.length === 5 && exp > Date.now() ? { token, email: raw[1], role: raw[2] } : null; } catch { return null; }
    }
    function authHeaders() { return { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (parseSession()?.token || '') }; }
    function esc(value) { return String(value || '').replace(/[&<>"']/g, char => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[char])); }
    function toast(message, isError = false) { const el = $('toast'); el.textContent = message; el.classList.toggle('is-error', isError); el.classList.add('show'); clearTimeout(toast.timer); toast.timer = setTimeout(() => el.classList.remove('show'), 3200); }
    function percent(items) { return items.length ? Math.round(items.reduce((sum, item) => sum + Number(item.progress || 0), 0) / items.length) : 0; }
    function ring(percentValue, color, large = false) { return `<div class="progress-ring${large ? ' progress-ring-lg' : ''}" style="--progress:${percentValue};--ring-color:${color}"><div class="ring-inner"><strong>${percentValue}%</strong>${large ? `<span>${esc(t('overallLabel'))}</span>` : ''}</div></div>`; }
    // 3단계 각각 몇 %까지 됐는지(stagePercents)를 보고, 아직 100%가 안 된
    // 첫 단계를 "현재 진행 중인 단계"로 본다. 전부 100%면 완료.
    function currentStageIndex(percents) {
      const p = Array.isArray(percents) && percents.length === STAGE_COUNT ? percents : [0, 0, 0];
      const idx = p.findIndex(v => v < 100);
      return idx === -1 ? STAGE_COUNT : idx;
    }
    function stageColor(percents) { return STAGE_COLORS[Math.min(STAGE_COUNT, currentStageIndex(percents))]; }
    function stageLabel(percents) { const idx = currentStageIndex(percents); return idx >= STAGE_COUNT ? t('stageComplete') : t('stageActive' + (idx + 1)); }
    function stageMarkup(percents) { return `<span class="status-pill" style="--status:${stageColor(percents)}"><i></i>${esc(stageLabel(percents))}</span>`; }
    function formatUpdated(value) { if (!value) return ''; try { return new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'ko-KR', { month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(value)) + (lang === 'en' ? ' updated' : ' 업데이트'); } catch { return ''; } }
    function formatLogTime(value) { try { return new Intl.DateTimeFormat(lang === 'en' ? 'en-US' : 'ko-KR', { month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(value)); } catch { return ''; } }
    function humanFileSize(bytes) { const n = Number(bytes) || 0; if (n < 1024) return n + ' B'; if (n < 1024 * 1024) return Math.round(n / 1024) + ' KB'; return (n / (1024 * 1024)).toFixed(1) + ' MB'; }

    function applyStaticLang() {
      document.documentElement.lang = lang;
      document.querySelectorAll('[data-t]').forEach(el => {
        const key = el.getAttribute('data-t');
        const val = t(key);
        if (typeof val === 'string') el.textContent = val;
      });
      document.querySelectorAll('[data-t-ph]').forEach(el => {
        const val = t(el.getAttribute('data-t-ph'));
        if (typeof val === 'string') el.placeholder = val;
      });
      $('langKoBtn')?.classList.toggle('is-active', lang === 'ko');
      $('langEnBtn')?.classList.toggle('is-active', lang === 'en');
    }
    function setLang(next) {
      if (lang === next) return;
      lang = next;
      localStorage.setItem('wolko-lang', lang);
      applyStaticLang();
      render();
      if (!$('editorOverlay').hidden) openEditor($('resourceId').value);
    }

    function render() {
      $('updatedAt').textContent = formatUpdated(lastUpdatedAt);
      const total = resources.length;
      const overall = percent(resources);
      const translating = resources.filter(item => currentStageIndex(item.stagePercents) === 0).length;
      const complete = resources.filter(item => currentStageIndex(item.stagePercents) >= STAGE_COUNT).length;
      $('overallRing').style.setProperty('--progress', overall); $('overallPercent').textContent = overall + '%';
      $('overallCaption').textContent = total ? t('overallCaptionN')(total) : t('overallCaptionEmpty');
      $('summaryGrid').innerHTML = [
        [t('summaryItems'), total], [t('summaryAvg'), overall + '%'], [t('summaryTranslating'), translating], [t('summaryComplete'), complete],
      ].map(([label, value]) => `<article class="summary-card"><strong>${value}</strong><span>${esc(label)}</span></article>`).join('');
      $('resourceGrid').innerHTML = total ? resources.map(item => {
        const color = stageColor(item.stagePercents);
        const thumb = item.thumbnailData ? `<img src="${item.thumbnailData}" alt="">` : `<span class="thumb-placeholder">W<br>RESOURCE</span>`;
        return `<article class="resource-card" onclick="openEditor('${item.id}')"><div class="resource-thumb">${thumb}</div><div class="resource-body"><div class="resource-top">${stageMarkup(item.stagePercents)}</div><h3>${esc(item.title)}</h3><p class="translation-line">${item.translation ? esc(item.translation) : esc(t('noTranslation'))}</p>${item.detail ? `<p class="detail-line">${esc(item.detail)}</p>` : ''}<div class="resource-progress"><div class="bar"><i style="width:${item.progress}%"></i></div><span>${item.progress}%</span></div></div><div class="card-ring">${ring(item.progress, color)}</div></article>`;
      }).join('') : `<div class="empty-state"><strong>${esc(t('emptyTitle'))}</strong><span>${esc(canWrite ? t('emptyHintWrite') : t('emptyHintRead'))}</span></div>`;
      $('addResourceBtn').hidden = !canWrite;
    }

    async function loadResources() {
      const res = await fetch('/api/portal/resources', { headers: authHeaders() });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) return logout();
      if (!res.ok) throw new Error(data.error || t('loadFailed'));
      resources = Array.isArray(data.items) ? data.items : []; canWrite = !!data.canWrite; lastUpdatedAt = data.updatedAt || ''; render();
    }

    /* ── 첨부 파일 (레슨 폴더 안에 원본/수정본으로 정리) ── */
    // 이미 올라간 파일을 다른 폴더(원본/수정본)나 미분류로 옮기는 드롭다운.
    // 지금 있는 위치는 목록에서 빼서, 옮길 곳만 보이게 한다.
    function moveOptionsHtml(meta) {
      if (!canWrite) return '';
      const folders = currentItem.folders || [];
      const current = `${meta.folderId || ''}|${meta.category || ''}`;
      const options = [];
      if (current !== '|') options.push(`<option value="|">${esc(t('unfiledLabel'))}</option>`);
      folders.forEach(f => {
        if (`${f.id}|original` !== current) options.push(`<option value="${f.id}|original">${esc(f.name)} · ${esc(t('originalLabel'))}</option>`);
        if (`${f.id}|revised` !== current) options.push(`<option value="${f.id}|revised">${esc(f.name)} · ${esc(t('revisedLabel'))}</option>`);
      });
      if (!options.length) return '';
      return `<select class="file-move-select" data-file-id="${meta.id}" onchange="moveFileEvent(this)"><option value="" selected disabled>${esc(t('moveFile'))}</option>${options.join('')}</select>`;
    }
    // 확장자별로 색이 다른 작은 뱃지 아이콘 — 실제 아이콘 파일 없이 목록을
    // 파일 탐색기처럼 한눈에 훑어볼 수 있게 한다.
    const FILE_TYPE_MAP = {
      pdf: ['PDF', '#c0392b', '#fdecea'],
      zip: ['ZIP', '#6c5ce7', '#efecfd'], rar: ['ZIP', '#6c5ce7', '#efecfd'], '7z': ['ZIP', '#6c5ce7', '#efecfd'],
      doc: ['DOC', '#2b579a', '#e8eefa'], docx: ['DOC', '#2b579a', '#e8eefa'],
      xls: ['XLS', '#1e7145', '#e7f5ee'], xlsx: ['XLS', '#1e7145', '#e7f5ee'],
      ppt: ['PPT', '#c0392b', '#fdecea'], pptx: ['PPT', '#c0392b', '#fdecea'],
      png: ['IMG', '#008e92', '#e6f6f6'], jpg: ['IMG', '#008e92', '#e6f6f6'], jpeg: ['IMG', '#008e92', '#e6f6f6'], gif: ['IMG', '#008e92', '#e6f6f6'], webp: ['IMG', '#008e92', '#e6f6f6'],
      mp4: ['VID', '#d88217', '#fdf3e7'], mov: ['VID', '#d88217', '#fdf3e7'],
      mp3: ['AUD', '#d88217', '#fdf3e7'], wav: ['AUD', '#d88217', '#fdf3e7'], m4a: ['AUD', '#d88217', '#fdf3e7'],
    };
    function fileIconHtml(fileName) {
      const ext = (fileName.split('.').pop() || '').toLowerCase();
      const [label, color, bg] = FILE_TYPE_MAP[ext] || [ext ? ext.slice(0, 4).toUpperCase() : 'FILE', '#67808d', '#eef2f4'];
      return `<span class="file-type-icon" style="color:${color};background:${bg};">${esc(label)}</span>`;
    }
    function fileRowHtml(meta) {
      const metaLine = `${t('uploadedBy')(esc(meta.uploadedByName || meta.uploadedBy || ''), esc(formatLogTime(meta.uploadedAt)))} · ${humanFileSize(meta.fileSize)}`;
      const replaceInput = canWrite ? `<label class="file-btn"><input type="file" data-file-id="${meta.id}" data-folder-id="${meta.folderId || ''}" data-category="${meta.category || ''}" onchange="handleFileUploadEvent(this)">${esc(t('replaceFile'))}</label>` : '';
      const removeBtn = canWrite ? `<button type="button" class="file-btn is-danger" onclick="deleteFile('${meta.id}')">${esc(t('removeFile'))}</button>` : '';
      return `<div class="file-row">${fileIconHtml(meta.fileName)}<div class="file-row-info"><span class="file-row-name">${esc(meta.fileName)}</span><span class="file-row-meta">${metaLine}</span></div><div class="file-row-actions"><button type="button" class="file-btn" onclick="previewFile('${meta.id}')">${esc(t('previewFile'))}</button>${replaceInput}${moveOptionsHtml(meta)}${removeBtn}</div></div>`;
    }
    function filesIn(folderId, category) {
      return (currentItem.files || [])
        .filter(f => (f.folderId || null) === folderId && (category === undefined || (f.category || null) === category))
        .sort((a, b) => new Date(b.uploadedAt) - new Date(a.uploadedAt));
    }
    function fileGroupHtml(files, folderId, category) {
      const rows = files.map(fileRowHtml).join('');
      const emptyMsg = files.length ? '' : `<p class="file-empty">${esc(canWrite ? t('noFileWrite') : t('noFileRead'))}</p>`;
      const addRow = canWrite ? `<label class="file-btn file-add-btn"><input type="file" multiple data-folder-id="${folderId || ''}" data-category="${category || ''}" onchange="handleFileUploadEvent(this)">${esc(t('addFile'))}</label>` : '';
      return emptyMsg + rows + addRow;
    }
    const FOLDER_ICON_SVG = '<svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z"/></svg>';
    let currentFolderId = null; // null = 폴더 탐색기 최상위(미분류 + 폴더 아이콘 목록), 그 외엔 그 폴더 안
    function openFolder(folderId) { currentFolderId = folderId; renderFilesAndFolders(); }
    function closeFolderView() { currentFolderId = null; renderFilesAndFolders(); }
    function renderFilesAndFolders() {
      if (!currentItem) { // 새 항목(아직 저장 전)은 파일을 못 붙인다
        $('filesBody').innerHTML = `<p class="file-empty">${esc(t('savedAfterCreate'))}</p>`;
        return;
      }
      const folders = currentItem.folders || [];
      const openFolderData = currentFolderId ? folders.find(f => f.id === currentFolderId) : null;

      // 폴더 안으로 들어간 상태 — 뒤로가기 + 그 폴더의 원본/수정본만 보여준다.
      if (openFolderData) {
        $('filesBody').innerHTML = `
          <div class="folder-nav">
            <button type="button" class="folder-back-btn" onclick="closeFolderView()">${esc(t('backToFolders'))}</button>
            <span class="folder-nav-name">${esc(openFolderData.name)}</span>
            ${canWrite ? `<button type="button" class="file-btn" onclick="renameFolder('${openFolderData.id}')">${esc(t('renameFolder'))}</button>` : ''}
            ${canWrite ? `<button type="button" class="file-btn is-danger" onclick="deleteFolder('${openFolderData.id}')">${esc(t('deleteFolder'))}</button>` : ''}
          </div>
          <div class="folder-category is-original">
            <div class="folder-category-label">${esc(t('originalLabel'))}</div>
            ${fileGroupHtml(filesIn(openFolderData.id, 'original'), openFolderData.id, 'original')}
          </div>
          <div class="folder-category is-revised">
            <div class="folder-category-label">${esc(t('revisedLabel'))}</div>
            ${fileGroupHtml(filesIn(openFolderData.id, 'revised'), openFolderData.id, 'revised')}
          </div>`;
        return;
      }

      // 최상위 — 미분류 파일 + 폴더 아이콘 그리드(더블클릭 없이 클릭으로 열기).
      currentFolderId = null;
      const unfiled = filesIn(null, undefined);
      let html = '';
      if (unfiled.length || !folders.length) {
        html += `<div class="file-group"><div class="file-group-head">${esc(t('unfiledLabel'))}</div>${fileGroupHtml(unfiled, null, null)}</div>`;
      }
      if (folders.length) {
        html += `<div class="folder-grid">${folders.map(folder => {
          const count = (currentItem.files || []).filter(f => f.folderId === folder.id).length;
          return `<button type="button" class="folder-icon-item" onclick="openFolder('${folder.id}')">${FOLDER_ICON_SVG}<span class="folder-icon-name">${esc(folder.name)}</span><span class="folder-icon-count">${t('fileCount')(count)}</span></button>`;
        }).join('')}</div>`;
      }
      if (canWrite) {
        html += `<div class="folder-add-row"><input type="text" id="newFolderName" maxlength="60" placeholder="${esc(t('folderNamePh'))}" onkeydown="if(event.key==='Enter'){event.preventDefault();addFolder();}"><button type="button" class="file-btn" onclick="addFolder()">${esc(t('addFolder'))}</button></div>`;
      }
      $('filesBody').innerHTML = html;
    }
    function renderUploadLog() {
      const log = currentItem?.uploadLog || [];
      if (!log.length) { $('uploadLogList').innerHTML = `<p class="upload-log-empty">${esc(t('uploadLogEmpty'))}</p>`; return; }
      $('uploadLogList').innerHTML = log.map(entry => `<div class="upload-log-item"><b>${esc(entry.uploadedByName || '')}</b><span>${esc(t('logUploadedFile')(entry.fileName || ''))} · ${esc(formatLogTime(entry.uploadedAt))}</span></div>`).join('');
    }
    function handleFileUploadEvent(inputEl) {
      handleFileUpload(inputEl, {
        fileId: inputEl.dataset.fileId || null,
        folderId: inputEl.dataset.folderId || null,
        category: inputEl.dataset.category || null,
      });
    }
    function readFileAsDataUrl(file) {
      return new Promise((resolve, reject) => {
        const reader = new FileReader();
        reader.onerror = reject;
        reader.onload = () => resolve(reader.result);
        reader.readAsDataURL(file);
      });
    }
    // 여러 파일을 한 번에 골라도(교체 버튼 제외) 순서대로 하나씩 업로드한다 —
    // 응답마다 항목 전체(currentItem)를 새로 받아오므로 동시에 보내면
    // 먼저 끝난 업로드 결과를 나중 응답이 덮어써 버릴 수 있다.
    async function handleFileUpload(inputEl, opts = {}) {
      const files = [...(inputEl.files || [])];
      if (!files.length) return;
      // 업로드가 몇 초 걸릴 수 있어서(특히 큰 파일), 끝날 때까지 파일이 갑자기
      // "뿅" 나타나는 것처럼 보이지 않게 누른 버튼 자리에 바로 스피너를 띄운다.
      // renderFilesAndFolders()가 끝나고 다시 그리면서 원래 모습으로 돌아간다.
      const labelEl = inputEl.closest('label');
      if (labelEl) { labelEl.classList.add('is-uploading'); labelEl.innerHTML = `<span class="btn-spinner"></span>${esc(t('uploading'))}`; }
      let successCount = 0;
      let failMessage = '';
      for (const file of files) {
        if (file.size > MAX_FILE_BYTES) { failMessage = t('fileTooLarge'); continue; }
        try {
          const fileData = await readFileAsDataUrl(file);
          const body = { id: currentItem.id, fileName: file.name, fileType: file.type, fileData };
          if (opts.fileId && successCount === 0) body.fileId = opts.fileId;
          if (opts.folderId) body.folderId = opts.folderId;
          if (opts.category) body.category = opts.category;
          const res = await fetch('/api/portal/resource-file', { method: 'POST', headers: authHeaders(), body: JSON.stringify(body) });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || t('fileUploadFailed'));
          currentItem = data.item;
          successCount++;
        } catch (e) {
          failMessage = e.message || t('fileUploadFailed');
        }
      }
      const idx = resources.findIndex(r => r.id === currentItem.id);
      if (idx !== -1) resources[idx] = currentItem;
      renderFilesAndFolders(); renderUploadLog(); render();
      if (successCount) toast(successCount > 1 ? t('filesUploadedToast')(successCount) : t('fileUploadedToast'));
      if (failMessage) toast(failMessage, true);
      inputEl.value = '';
    }
    async function addFolder() {
      const nameInput = $('newFolderName');
      const name = nameInput.value.trim();
      if (!name) return;
      try {
        const res = await fetch('/api/portal/resource-folder', { method: 'POST', headers: authHeaders(), body: JSON.stringify({ id: currentItem.id, name }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('folderSaveFailed'));
        currentItem = data.item;
        const idx = resources.findIndex(r => r.id === currentItem.id);
        if (idx !== -1) resources[idx] = currentItem;
        renderFilesAndFolders();
      } catch (e) {
        toast(e.message || t('folderSaveFailed'), true);
      }
    }
    async function renameFolder(folderId) {
      const folder = (currentItem.folders || []).find(f => f.id === folderId);
      const name = prompt(t('renameFolderPrompt'), folder?.name || '')?.trim();
      if (!name || name === folder?.name) return;
      try {
        const res = await fetch('/api/portal/resource-folder', { method: 'PUT', headers: authHeaders(), body: JSON.stringify({ id: currentItem.id, folderId, name }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('folderSaveFailed'));
        currentItem = data.item;
        const idx = resources.findIndex(r => r.id === currentItem.id);
        if (idx !== -1) resources[idx] = currentItem;
        renderFilesAndFolders();
      } catch (e) {
        toast(e.message || t('folderSaveFailed'), true);
      }
    }
    async function deleteFolder(folderId) {
      if (!confirm(t('folderDeleteConfirm'))) return;
      try {
        const res = await fetch(`/api/portal/resource-folder?id=${encodeURIComponent(currentItem.id)}&folderId=${encodeURIComponent(folderId)}`, { method: 'DELETE', headers: authHeaders() });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('folderDeleteFailed'));
        currentItem = data.item;
        const idx = resources.findIndex(r => r.id === currentItem.id);
        if (idx !== -1) resources[idx] = currentItem;
        renderFilesAndFolders();
        toast(t('folderDeletedToast'));
      } catch (e) {
        toast(e.message || t('folderDeleteFailed'), true);
      }
    }
    async function previewFile(fileId) {
      // 팝업 차단 우회: fetch(비동기) 이후에 window.open을 부르면 "사용자 조작 직후"로
      // 인정 안 하는 브라우저가 있어 조용히 막힌다 — 클릭 즉시(동기) 빈 탭을 먼저 열어두고,
      // 데이터가 오면 그 탭의 위치만 바꾼다.
      const win = window.open('', '_blank');
      try {
        const res = await fetch(`/api/portal/resource-file?id=${encodeURIComponent(currentItem.id)}&fileId=${encodeURIComponent(fileId)}`, { headers: authHeaders() });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('filePreviewFailed'));
        const dataUrl = data.file.fileData;
        const parts = dataUrl.match(/^data:([^;]+);base64,(.*)$/s);
        if (!parts) throw new Error(t('filePreviewFailed'));
        const byteChars = atob(parts[2]);
        const bytes = new Uint8Array(byteChars.length);
        for (let i = 0; i < byteChars.length; i++) bytes[i] = byteChars.charCodeAt(i);
        const blob = new Blob([bytes], { type: parts[1] });
        const url = URL.createObjectURL(blob);
        if (win) win.location = url; else window.open(url, '_blank');
        setTimeout(() => URL.revokeObjectURL(url), 60000);
      } catch (e) {
        if (win) win.close();
        toast(e.message || t('filePreviewFailed'), true);
      }
    }
    function moveFileEvent(selectEl) {
      const [folderId, category] = selectEl.value.split('|');
      moveFile(selectEl.dataset.fileId, folderId || null, category || null);
    }
    async function moveFile(fileId, folderId, category) {
      try {
        const res = await fetch('/api/portal/resource-file', { method: 'PUT', headers: authHeaders(), body: JSON.stringify({ id: currentItem.id, fileId, folderId, category }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('fileMoveFailed'));
        currentItem = data.item;
        const idx = resources.findIndex(r => r.id === currentItem.id);
        if (idx !== -1) resources[idx] = currentItem;
        renderFilesAndFolders();
        toast(t('fileMovedToast'));
      } catch (e) {
        toast(e.message || t('fileMoveFailed'), true);
      }
    }
    async function deleteFile(fileId) {
      if (!confirm(t('fileRemoveConfirm'))) return;
      try {
        const res = await fetch(`/api/portal/resource-file?id=${encodeURIComponent(currentItem.id)}&fileId=${encodeURIComponent(fileId)}`, { method: 'DELETE', headers: authHeaders() });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('fileDeleteFailed'));
        currentItem = data.item;
        const idx = resources.findIndex(r => r.id === currentItem.id);
        if (idx !== -1) resources[idx] = currentItem;
        renderFilesAndFolders(); render();
        toast(t('fileRemovedToast'));
      } catch (e) {
        toast(e.message || t('fileDeleteFailed'), true);
      }
    }

    /* ── 에디터(보기 모드 기본 + 수정 버튼으로 편집 폼) ── */
    function renderDetailView() {
      const item = currentItem;
      if (!item) return;
      const thumb = item.thumbnailData ? `<img src="${item.thumbnailData}" alt="">` : `<span class="thumb-placeholder">W<br>RESOURCE</span>`;
      $('detailThumb').innerHTML = thumb;
      const pillEl = $('detailStatusPill');
      pillEl.style.setProperty('--status', stageColor(item.stagePercents));
      pillEl.innerHTML = `<i></i>${esc(stageLabel(item.stagePercents))}`;
      $('detailProgressBar').style.width = item.progress + '%';
      $('detailProgressPct').textContent = item.progress + '%';
      $('detailTranslation').textContent = item.translation ? item.translation : t('noTranslation');
      $('detailDetailField').hidden = !item.detail;
      $('detailDetail').textContent = item.detail || '';
    }
    function showEditorMode(mode) {
      editorMode = mode;
      const isEdit = mode === 'edit';
      $('detailView').hidden = isEdit;
      $('editorForm').hidden = !isEdit;
      $('editorEyebrow').textContent = isEdit ? t('editorEyebrow') : t('detailEyebrow');
      $('editorTitle').textContent = isEdit ? (currentItem ? t('editorEdit') : t('editorAdd')) : (currentItem?.title || '');
      if (isEdit) $('resourceName').focus();
    }
    function enterEditMode() { showEditorMode('edit'); }
    function exitEditMode() {
      // 취소 — 입력값은 버리고(폼은 다음에 열 때 다시 채움) 원래 저장된 값 그대로 보기 모드로 돌아간다.
      if (!currentItem) { closeEditor(); return; }
      openEditor(currentItem.id);
    }
    function openEditor(id = '') {
      const item = resources.find(entry => entry.id === id) || null;
      currentItem = item;
      currentFolderId = null;
      $('editorForm').reset(); $('resourceId').value = item?.id || ''; $('resourceName').value = item?.title || ''; renderStageStepper(item?.stagePercents || [0, 0, 0]); $('resourceTranslation').value = item?.translation || ''; $('resourceDetail').value = item?.detail || ''; $('thumbnailData').value = item?.thumbnailData || '';
      renderThumbnail(item?.thumbnailData || '');
      $('deleteResourceBtn').hidden = !item;
      $('editResourceBtn').hidden = !canWrite;
      $('editorError').textContent = '';
      renderFilesAndFolders(); renderUploadLog();
      $('editorOverlay').hidden = false;
      if (item) { renderDetailView(); showEditorMode('view'); }
      else { showEditorMode('edit'); }
    }
    function closeEditor() { $('editorOverlay').hidden = true; currentItem = null; editorMode = 'view'; }
    // 진행 단계 스텝퍼 — 버튼 N을 누르면 1~N단계가 완료로, 이미 N단계까지
    // 완료된 상태에서 N을 다시 누르면 한 단계 되돌린다(간단한 토글식 취소).
    let editorStagePercents = [0, 0, 0];
    function renderStageStepper(percents) {
      editorStagePercents = percents.slice(0, STAGE_COUNT);
      $('stagePct').textContent = Math.round(editorStagePercents.reduce((s, p) => s + p, 0) / STAGE_COUNT) + '%';
      document.querySelectorAll('#stageStepper .stage-card').forEach((card, i) => {
        const pct = editorStagePercents[i] || 0;
        card.classList.toggle('is-done', pct >= 100);
        card.classList.toggle('is-started', pct > 0 && pct < 100);
        card.querySelector('.stage-pct-select').value = pct;
      });
    }
    function setStagePercent(index, value) {
      editorStagePercents[index] = Number(value) || 0;
      renderStageStepper(editorStagePercents);
    }
    function renderThumbnail(data) { $('thumbnailPreview').innerHTML = data ? `<img src="${data}" alt="">` : '<span>NO IMAGE</span>'; }
    async function loadThumbnail(input) {
      const file = input.files?.[0]; if (!file) return;
      if (!/^image\/(jpeg|png|webp|gif)$/.test(file.type)) { $('editorError').textContent = t('thumbnailTypeError'); return; }
      try { const data = await compressImage(file); $('thumbnailData').value = data; renderThumbnail(data); } catch { $('editorError').textContent = t('thumbnailProcessError'); }
    }
    function compressImage(file) { return new Promise((resolve, reject) => { const reader = new FileReader(); reader.onerror = reject; reader.onload = () => { const image = new Image(); image.onerror = reject; image.onload = () => { const scale = Math.min(1, 1200 / Math.max(image.width, image.height)); const canvas = document.createElement('canvas'); canvas.width = Math.max(1, Math.round(image.width * scale)); canvas.height = Math.max(1, Math.round(image.height * scale)); canvas.getContext('2d').drawImage(image, 0, 0, canvas.width, canvas.height); let data = canvas.toDataURL('image/webp', .82); if (data.length > 1450000) data = canvas.toDataURL('image/jpeg', .68); if (data.length > 1500000) return reject(new Error('too-large')); resolve(data); }; image.src = reader.result; }; reader.readAsDataURL(file); }); }
    async function saveResource(event) {
      event.preventDefault();
      const id = $('resourceId').value;
      const item = { title: $('resourceName').value, stagePercents: editorStagePercents, translation: $('resourceTranslation').value, detail: $('resourceDetail').value, thumbnailData: $('thumbnailData').value };
      const button = $('saveResourceBtn'); button.disabled = true; $('editorError').textContent = '';
      try {
        const res = await fetch('/api/portal/resources', { method: id ? 'PUT' : 'POST', headers: authHeaders(), body: JSON.stringify(id ? { id, item } : { item }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('saveFailed'));
        resources = data.items; lastUpdatedAt = data.updatedAt || ''; render(); toast(t('savedToast'));
        // 방금 만든 항목이면 저장 직후 바로 파일을 첨부할 수 있게 같은 항목으로 에디터를 다시 연다.
        // 새 항목은 서버가 목록 맨 앞에 넣어 반환하므로 items[0]이 곧 그 항목의 id다.
        const savedId = id || data.items[0]?.id;
        if (savedId) openEditor(savedId); else closeEditor();
      } catch (e) {
        $('editorError').textContent = e.message;
      } finally {
        button.disabled = false;
      }
    }
    async function deleteResource() {
      const id = $('resourceId').value; if (!id || !confirm(t('deleteConfirm'))) return;
      try {
        const res = await fetch('/api/portal/resources?id=' + encodeURIComponent(id), { method: 'DELETE', headers: authHeaders() });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('deleteFailed'));
        resources = data.items; lastUpdatedAt = data.updatedAt || ''; closeEditor(); render(); toast(t('deletedToast'));
      } catch (e) {
        $('editorError').textContent = e.message;
      }
    }
    function logout() { sessionStorage.removeItem('wolko-hub-token'); sessionStorage.removeItem('wolko-hub-email'); sessionStorage.removeItem('wolko-hub-role'); location.href = '/portal'; }
    $('editorForm').addEventListener('submit', saveResource); $('editorOverlay').addEventListener('click', event => { if (event.target === $('editorOverlay')) closeEditor(); });

    applyStaticLang();
    const session = parseSession();
    if (session) { $('loginScreen').hidden = true; $('portalMain').hidden = false; $('viewerLabel').textContent = session.email; loadResources().catch(error => toast(error.message, true)); }
  </script>
</body>
</html>
