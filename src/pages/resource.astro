    }
    // PDF 캔버스/이미지 공용 드래그 하이라이트 — 마우스 전용 이벤트가 아니라
    // Pointer Events를 써서 손가락 드래그도 똑같이 처리한다. 좌표는 화면
    // 크기와 무관하게 0~1로 정규화해서 저장하므로, 나중에 다른 화면 크기에서
    // 다시 열어도(퍼센트 기반 CSS로) 항상 같은 위치를 가리킨다.
    function attachDragHighlight(surfaceEl) {
      if (!surfaceEl) return;
      surfaceEl.addEventListener('pointerdown', event => {
        if (!drawModeOn) return;
        try { surfaceEl.setPointerCapture(event.pointerId); } catch {}
        const rect = surfaceEl.getBoundingClientRect();
        dragState = { rect, pointerId: event.pointerId, startX: (event.clientX - rect.left) / rect.width, startY: (event.clientY - rect.top) / rect.height };
        const box = document.createElement('div');
        box.className = 'highlight-box is-drawing';
        box.id = 'viewerDragBox';
        surfaceEl.appendChild(box);
        event.preventDefault();
      });
      surfaceEl.addEventListener('pointermove', event => {
        if (!dragState || event.pointerId !== dragState.pointerId) return;
        const { rect, startX, startY } = dragState;
        const curX = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
        const curY = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
        const x = Math.min(startX, curX), y = Math.min(startY, curY), w = Math.abs(curX - startX), h = Math.abs(curY - startY);
        const box = $('viewerDragBox');
        if (box) { box.style.left = (x * 100) + '%'; box.style.top = (y * 100) + '%'; box.style.width = (w * 100) + '%'; box.style.height = (h * 100) + '%'; }
      });
      surfaceEl.addEventListener('pointerup', event => {
        if (!dragState || event.pointerId !== dragState.pointerId) return;
        const { rect, startX, startY } = dragState;
        const curX = Math.max(0, Math.min(1, (event.clientX - rect.left) / rect.width));
        const curY = Math.max(0, Math.min(1, (event.clientY - rect.top) / rect.height));
        const x = Math.min(startX, curX), y = Math.min(startY, curY), w = Math.abs(curX - startX), h = Math.abs(curY - startY);
        dragState = null;
        const box = $('viewerDragBox');
        if (w < 0.01 || h < 0.01) { box?.remove(); return; } // 너무 작은 드래그(실수로 살짝 눌림)는 무시
        // 저장 전까지 상자를 지우지 않고 연하게(is-pending) 남겨서 "방금 여기를
        // 표시했다"는 게 계속 보이게 한다 — 노트를 저장하면(renderHighlights가
        // 다시 그리면서) 진한 색의 정식 하이라이트로 바뀐다.
        if (box) {
          box.classList.remove('is-drawing');
          box.classList.add('is-pending');
          const color = highlightColorFor(parseSession()?.email);
          box.style.borderColor = color;
          box.style.background = color + '2e';
        }
        // 노트 하나 남길 때마다 버튼을 다시 누르게 하면 번거로우니, 표시 모드는
        // 사용자가 직접 버튼을 눌러 끌 때까지 계속 켜둔다 — 연달아 여러 곳에
        // 노트를 남길 수 있다.
        openNoteComposer({ kind: 'area', x, y, w, h, page: viewerKind === 'pdf' ? viewerPage : null });
      });
    }
    // 텍스트 레이어 위에서 마우스/손가락으로 글자를 드래그해 선택하면(따로
    // 버튼을 누를 필요 없이) 곧바로 메모 입력창이 뜬다. 영역 표시 모드(사각형
    // 자유 드래그)가 켜져 있을 때는 그쪽 로직이 이미 pointerdown에서
    // preventDefault + setPointerCapture로 텍스트 선택 자체가 시작되지 않게
    // 막아주므로 서로 부딪히지 않는다.
    function attachTextSelectionNote(textLayerEl, surfaceEl) {
      if (!textLayerEl) return;
      textLayerEl.addEventListener('pointerup', () => {
        if (drawModeOn) return;
        // mouseup 시점엔 아직 브라우저 선택 영역이 확정되지 않을 수 있어 한 틱 늦춘다.
        setTimeout(() => {
          const captured = captureTextSelectionRects(surfaceEl, textLayerEl);
          if (!captured) return;
          openNoteComposer({ kind: 'area', x: captured.x, y: captured.y, w: captured.w, h: captured.h, rects: captured.rects, page: viewerPage, quote: captured.text });
        }, 0);
      });
    }
    // 드래그로 선택된 실제 텍스트 범위(Range)를 줄 단위 사각형들로 변환한다.
    // 한 줄이면 사각형 1개, 여러 줄에 걸치면 줄 수만큼 생긴다 — 각각을 0~1
    // 비율로 정규화해서 저장하므로 화면 크기·확대율이 달라져도 항상 같은
    // 글자 위치를 가리킨다(기존 자유 드래그 사각형과 동일한 좌표계).
    function captureTextSelectionRects(surfaceEl, textLayerEl) {
      const sel = window.getSelection();
      if (!sel || sel.isCollapsed || sel.rangeCount === 0) return null;
      const range = sel.getRangeAt(0);
      if (!textLayerEl.contains(range.commonAncestorContainer)) return null;
      const quote = sel.toString().replace(/\s+/g, ' ').trim();
      if (!quote) return null;
      const rect = surfaceEl.getBoundingClientRect();
      if (!rect.width || !rect.height) return null;
      const rects = Array.from(range.getClientRects())
        .map(r => ({ x: (r.left - rect.left) / rect.width, y: (r.top - rect.top) / rect.height, w: r.width / rect.width, h: r.height / rect.height }))
        .filter(r => r.w > 0.001 && r.h > 0.001)
        .map(r => ({ x: Math.max(0, Math.min(1, r.x)), y: Math.max(0, Math.min(1, r.y)), w: Math.max(0, Math.min(1 - Math.max(0, r.x), r.w)), h: Math.max(0, Math.min(1 - Math.max(0, r.y), r.h)) }))
        .slice(0, 20);
      if (!rects.length) return null;
      const minX = Math.min(...rects.map(r => r.x)), minY = Math.min(...rects.map(r => r.y));
      const maxX = Math.max(...rects.map(r => r.x + r.w)), maxY = Math.max(...rects.map(r => r.y + r.h));
      return { rects, x: minX, y: minY, w: maxX - minX, h: maxY - minY, text: quote };
    }
    function addTimeNote() {
      const el = $('viewerMedia');
      if (!el) return;
      openNoteComposer({ kind: 'time', timeSec: el.currentTime });
    }
    function openNoteComposer(pending) {
      pendingNote = pending;
      toggleNotesPanel(true);
      $('noteComposer').hidden = false;
      const quoteEl = $('noteComposerQuote');
      if (quoteEl) {
        if (pending.quote) { quoteEl.hidden = false; quoteEl.textContent = '“' + (pending.quote.length > 140 ? pending.quote.slice(0, 140) + '…' : pending.quote) + '”'; }
        else quoteEl.hidden = true;
      }
      $('noteComposerText').value = '';
      $('noteComposerText').focus();
    }
    function cancelNoteComposer() {
      pendingNote = null;
      const composer = $('noteComposer');
      if (composer) composer.hidden = true;
      window.getSelection()?.removeAllRanges();
      $('viewerDragBox')?.remove();
    }
    async function submitNoteComposer() {
      const textVal = $('noteComposerText').value.trim();
      if (!textVal || !pendingNote) return;
      const body = { id: currentItem.id, fileId: viewerFileId, kind: pendingNote.kind, text: textVal };
      if (pendingNote.kind === 'area') Object.assign(body, { x: pendingNote.x, y: pendingNote.y, w: pendingNote.w, h: pendingNote.h, page: pendingNote.page, rects: pendingNote.rects, quote: pendingNote.quote });
      if (pendingNote.kind === 'time') body.timeSec = pendingNote.timeSec;
      try {
        const res = await fetch('/api/portal/resource-annotation', { method: 'POST', headers: authHeaders(), body: JSON.stringify(body) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('noteSaveFailed'));
        currentItem = data.item;
        const idx = resources.findIndex(r => r.id === currentItem.id);
        if (idx !== -1) resources[idx] = currentItem;
        cancelNoteComposer();
        renderNotesList(); renderHighlights(); renderFilesAndFolders();
      } catch (e) {
        toast(e.message || t('noteSaveFailed'), true);
      }
    }
    function annotationsForViewerFile() {
      return (currentItem?.annotations || []).filter(a => a.fileId === viewerFileId);
    }
    function formatTimeSec(sec) {
      const s = Math.max(0, Math.round(sec || 0));
      return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
    }
    function toggleNotesPanel(force) {
      const panel = $('notesPanel');
      const isOpen = typeof force === 'boolean' ? force : !panel.classList.contains('is-open');
      panel.classList.toggle('is-open', isOpen);
      panel.setAttribute('aria-hidden', String(!isOpen));
      $('viewerNotesToggle').classList.toggle('is-active', isOpen);
      $('viewerNotesToggle').setAttribute('aria-expanded', String(isOpen));
    }
    // 노트 작성자마다 고정된 색을 배정한다(이메일을 해시해서 팔레트에서 하나
    // 고르는 방식 — 서버에 따로 저장할 필요 없이 항상 같은 사람은 같은 색).
    const HIGHLIGHT_PALETTE = ['#d88217', '#0077a3', '#6f55c9', '#c0392b', '#16865a', '#8e44ad', '#d81b60', '#00838f'];
    function highlightColorFor(email) {
      const str = String(email || '');
      let hash = 0;
      for (let i = 0; i < str.length; i++) hash = (hash * 31 + str.charCodeAt(i)) >>> 0;
      return HIGHLIGHT_PALETTE[hash % HIGHLIGHT_PALETTE.length];
    }
    function renderNotesList() {
      const list = annotationsForViewerFile();
      $('viewerNotesCount').textContent = list.length ? String(list.length) : '';
      if (!list.length) { $('notesList').innerHTML = `<p class="upload-log-empty">${esc(t('notesEmpty'))}</p>`; return; }
      const session = parseSession();
      $('notesList').innerHTML = list.slice().sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt)).map(a => {
        const canManage = !!(session && (session.email === a.createdBy || canWrite));
        const where = a.kind === 'time' ? formatTimeSec(a.timeSec) : (a.kind === 'area' && a.page ? t('pageOf')(a.page, a.page) : '');
        const jumpAttr = a.kind !== 'general' ? ` onclick="jumpToNote('${a.id}')"` : '';
        return `<div class="note-item is-${a.status}" data-note-id="${a.id}">
          <div class="note-item-head"><b><span class="note-item-author-dot" style="background:${highlightColorFor(a.createdBy)}"></span>${esc(a.createdByName)}</b><span>${esc(formatLogTime(a.createdAt))}</span></div>
          ${where ? `<button type="button" class="note-item-where"${jumpAttr}>${esc(where)}</button>` : ''}
          ${a.quote ? `<blockquote class="note-item-quote">${esc(a.quote)}</blockquote>` : ''}
          <p>${esc(a.text)}</p>
          ${canManage ? `<div class="note-item-actions"><button type="button" onclick="toggleNoteStatus('${a.id}','${a.status === 'open' ? 'resolved' : 'open'}')">${esc(a.status === 'open' ? t('noteResolve') : t('noteReopen'))}</button><button type="button" class="is-danger" onclick="deleteAnnotation('${a.id}')">${esc(t('noteDelete'))}</button></div>` : ''}
        </div>`;
      }).join('');
    }
    function renderHighlights() {
      const surface = $('viewerSurfaceInner');
      if (!surface) return;
      surface.querySelectorAll('.highlight-box:not(.is-drawing):not(.is-pending)').forEach(el => el.remove());
      if (viewerKind !== 'pdf' && viewerKind !== 'image') return;
      annotationsForViewerFile().filter(a => a.kind === 'area' && (viewerKind !== 'pdf' || (a.page || 1) === viewerPage)).forEach(a => {
        const color = highlightColorFor(a.createdBy);
        // 텍스트를 드래그해서 만든 노트는 줄마다 사각형이 따로 있어서(rects)
        // 그 줄들을 각각 그리고, 옛날 방식(자유 사각형 하나)은 그대로 x/y/w/h
        // 하나만 그린다 — 형광펜처럼 줄 단위로 딱 붙게 보이려는 것.
        const boxRects = (Array.isArray(a.rects) && a.rects.length) ? a.rects : [{ x: a.x, y: a.y, w: a.w, h: a.h }];
        const isText = !!a.rects?.length;
        boxRects.forEach(r => {
          const box = document.createElement('div');
          box.className = 'highlight-box is-' + a.status + (isText ? ' is-text-rect' : '');
          box.style.borderColor = color;
          // 텍스트 밑줄(is-text-rect)은 CSS가 배경 없이 밑줄만 그리게 두고
          // (원색 사진·어두운 슬라이드 위에서도 글자가 안 가려지게), 자유
          // 사각형(이미지·표 표시)만 반투명 배경을 채운다.
          if (!isText) box.style.background = color + '2e';
          box.style.left = (r.x * 100) + '%'; box.style.top = (r.y * 100) + '%'; box.style.width = (r.w * 100) + '%'; box.style.height = (r.h * 100) + '%';
          box.title = `${a.createdByName}: ${a.text}`;
          box.addEventListener('click', () => jumpToNoteListItem(a.id));
          surface.appendChild(box);
        });
      });
    }
    function jumpToNoteListItem(annotationId) {
      toggleNotesPanel(true);
      document.querySelector(`[data-note-id="${annotationId}"]`)?.scrollIntoView({ block: 'nearest' });
    }
    function jumpToNote(annotationId) {
      const a = annotationsForViewerFile().find(x => x.id === annotationId);
      if (!a) return;
      if (a.kind === 'time') { const media = $('viewerMedia'); if (media) media.currentTime = a.timeSec; }
      if (a.kind === 'area' && viewerKind === 'pdf' && a.page && a.page !== viewerPage) { viewerPage = a.page; renderPdfPage(); }
    }
    async function toggleNoteStatus(annotationId, status) {
      try {
        const res = await fetch('/api/portal/resource-annotation', { method: 'PUT', headers: authHeaders(), body: JSON.stringify({ id: currentItem.id, annotationId, status }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || t('noteUpdateFailed'));
        currentItem = data.item;
        const idx = resources.findIndex(r => r.id === currentItem.id);
