<script>
  // ── Hero Slideshow ──────────────────────────────────────
  (function() {
    const slides = document.querySelectorAll('#heroSection .wh-hero-slide');
    if (!slides.length) return;
    let current = 0;

    function nextSlide() {
      slides[current].classList.remove('wh-slide-active');
      current = (current + 1) % slides.length;
      const next = slides[current];
      next.classList.add('wh-slide-active');
      // re-trigger Ken Burns animation
      next.style.animation = 'none';
      void next.offsetWidth;
      next.style.animation = '';
    }

    setInterval(nextSlide, 6000);
  })();

// ── Vision Accordion ────────────────────────────────────
  (function() {
    const items = document.querySelectorAll('#visionList .wh-vision-item');
    items.forEach(function(item) {
      const trigger = item.querySelector('.wh-vision-trigger');
      if (!trigger) return;
      trigger.addEventListener('click', function() {
        const isOpen = item.classList.contains('is-active');
        items.forEach(function(i) { i.classList.remove('is-active'); });
        if (!isOpen) item.classList.add('is-active');
      });
    });
  })();
</script>

