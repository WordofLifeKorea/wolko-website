---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
// 제주 캠퍼스 데이 안내 팝업: 일정 파일의 접수(status: open)가 열려 있을 때만 만든다 (시작일이 지나면 화면에서 자동으로 숨긴다)
const campusDayEntry = (await getCollection('camp_schedules')).find((c) => String(c.id).startsWith('2026-jeju-campus-day'));
const campusDay = campusDayEntry && campusDayEntry.data.status === 'open' ? campusDayEntry.data : null;

// 맨 위 사진 — 6초마다 바뀌고, 오른쪽 아래 숫자(01 / 05)와 막대가 함께 바뀐다. 막대를 누르면 그 사진으로 간다.
const heroSlides = [
  { src: '/images/heroes/worship.jpg' },
  { src: '/images/heroes/outdoor.jpg' },
  { src: '/images/heroes/books.jpg', pos: 'center 20%' },
  { src: '/images/heroes/cross.jpg' },
  { src: '/images/heroes/samuel.jpg', pos: 'center 15%' },
];
const pad2 = (n: number) => String(n).padStart(2, '0');

// 월코 비전 다섯 가지 — 펼치기 없이 다섯 칸에 글을 모두 보여 준다
const visions = [
  {
    ko: '성경중심', en: 'Bible-Centered',
    dKo: '성경은 우리 삶의 기초이며, 많은 사람의 삶에 변화를 가져왔습니다.',
    dEn: 'At the heart of every WOLKO ministry is the unchanging truth of Scripture. The Bible is not merely a book — it is our foundation, our guide for life, and our unshakeable source of hope. From summer camps to the deep Bible studies at WOLBI Jeju, everything we do is firmly built on the Word of God.',
  },
  {
    ko: '청소년 사역 중심', en: 'Youth-Focused',
    dKo: '월코를 움직이는 힘은 다음 세대를 향한 열정입니다. 그들 안에는 그리스도를 위해 세상을 바꿀 놀라운 가능성이 있습니다. 그 가능성을 믿기에, 월코는 오늘도 청소년 사역에 온 힘을 쏟습니다.',
    dEn: 'The driving force behind WOLKO is a passion for the next generation. Young people hold incredible potential to change the world for Christ. Because we believe in that potential, WOLKO pours everything into every ministry we do.',
  },
  {
    ko: '복음전파', en: 'Evangelism',
    dKo: '월코는 복음을 통해 예수 그리스도가 삶의 해답이라는 것을 전합니다.',
    dEn: 'The message WOLKO carries is simple, yet life-changing: Jesus Christ is the answer. Through dynamic youth ministry, Bible school campuses, international missions, and youth camps, WOLKO is committed to sharing the Gospel with every generation.',
  },
  {
    ko: '제자훈련', en: 'Discipleship',
    dKo: '월코는 주님께서 주신 지상명령에 순종하기위해 제자훈련을 합니다. 참 제자는 또 다른 제자를 세웁니다.',
    dEn: 'In obedience to the Great Commission, WOLKO makes disciples — and true disciples make more disciples.',
  },
  {
    ko: '열정과 헌신', en: 'Passion-Driven',
    dKo: '월코의 정신은 열정과 목적, 그리고 복음을 전하려는 공동의 헌신 위에 세워져 있습니다. 우리는 그리스도를 위해 사는 것이 최고의 삶이라 여기며, 그 열정이 모든 사역의 원동력이 됩니다.',
    dEn: 'WOLKO was built on passion, purpose, and a unified devotion to sharing the Gospel. Living for Christ is the greatest adventure we know — and that excitement and conviction drives everything we do.',
  },
];

// 사역 소개 네 칸 — 사진(4:3) · 번호 · 이름 · 한 줄 설명
const ministries = [
  {
    href: '/camp', img: '/images/ministries/camp.jpg', ko: '캠프 사역', en: 'Camp Ministry',
    dKo: '청소년과 다음 세대가 복음을 듣고 삶의 전환점을 경험하도록 돕는 월코의 대표 사역입니다.',
    dEn: "WOLKO's flagship ministry — helping youth and the next generation hear the Gospel and experience life-changing encounters.",
  },
  {
    href: '/youth', img: '/images/ministries/youth.jpg', ko: '청소년 사역', en: 'Youth Ministry',
    dKo: '교회와 삶 속에서 청소년들이 말씀 위에 세워지고 예수 그리스도를 따르도록 섬깁니다.',
    dEn: "Serving youth in churches and communities, helping them build their lives on God's Word and follow Jesus Christ.",
  },
  {
    href: '/wolbi-jeju', img: '/images/ministries/wolbi.jpg', ko: '제주 월비', en: 'WOLBI Jeju',
    dKo: '깊이 있는 성경 연구와 훈련을 통해 복음을 삶으로 살아내는 제자를 세워갑니다.',
    dEn: 'Through in-depth Bible study and training, we raise disciples who live out the Gospel in everyday life.',
  },
  {
    href: '/give', img: '/images/ministries/syme.jpg', ko: '선교 및 참여', en: 'Missions & Giving',
    dKo: '기도와 후원, 재능기부와 직접 참여를 통해 더 많은 다음 세대에게 복음이 흘러가게 합니다.',
    dEn: 'Through prayer, giving, volunteering, and direct involvement, help the Gospel reach more of the next generation.',
  },
];
---

<BaseLayout
  title="월코 (WOLKO) — 한국의 다음 세대에게 복음을"
  description="월코(WOLKO) — 복음전파와 제자훈련으로 한국의 다음 세대를 섬깁니다. Word of Life Korea (월코) 공식 웹사이트."
  activeNav="home"
>
<Fragment slot="head">
  <link rel="preload" as="image" href={heroSlides[0].src} fetchpriority="high" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "WOLKO 월코 — Word of Life Korea",
    "url": "https://wolko.org",
    "logo": "https://wolko.org/images/WOLKO Circle.png",
    "description": "복음전파와 제자훈련으로 한국의 다음 세대를 섬깁니다.",
    "sameAs": [
      "https://www.youtube.com/@wolkorea",
      "https://www.instagram.com/wolkorea"
    ]
  })} />
</Fragment>

<style>
/* ═══════════════════════════
   공통 — 사역 페이지(/ministry)와 같은 규칙: 1200px 폭, 앞에 가는 선이 붙은 작은 표시,
   G마켓 산스 제목, 각진 버튼(52px), 둥근 카드·그림자·색 띠 없음
═══════════════════════════ */
.hm-home {
  --hm-deep: #004f68;
  --hm-navy: #0b2430;
  --hm-ink: #10252e;
  --hm-text: #3e535d;
  --hm-text-2: #4a5d66;
  --hm-muted: #587383;
  --hm-label: #5a7380;
  --hm-line: #d6dee2;
  --hm-soft: #f6f9fb;
  background: #fff;
  color: var(--hm-ink);
  font-family: var(--ff-sans);
  word-break: keep-all;
  overflow: hidden;
}
.hm-shell { width: min(1200px, calc(100% - 48px)); margin-inline: auto; }
.hm-home svg { width: 14px; height: 14px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: square; }
.hm-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }

.hm-eyebrow { display: flex; align-items: center; gap: 12px; color: var(--hm-deep); font-size: 13px; font-weight: 700; line-height: 1.4; letter-spacing: .12em; text-transform: uppercase; }
.hm-eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; flex: none; }
.hm-h2 { margin-top: 20px; font-family: var(--ff-serif); font-size: clamp(30px, 3.1vw, 44px); font-weight: 700; line-height: 1.22; letter-spacing: -.03em; color: var(--hm-navy); }
.hm-h2--sm { font-size: clamp(28px, 2.5vw, 36px); }
.hm-lead { margin-top: 24px; max-width: 560px; font-size: 17px; line-height: 1.85; color: var(--hm-text); }

.hm-sec { padding: 120px 0; }
.hm-sec--soft { background: var(--hm-soft); }

/* 버튼 — 높이 52px, 모서리 2px, 화살표는 글자색 */
.hm-actions { margin-top: 36px; display: flex; flex-wrap: wrap; gap: 10px; }
.hm-btn {
  height: 52px; padding: 0 24px; display: inline-flex; align-items: center; justify-content: space-between; gap: 12px;
  border: 1px solid transparent; border-radius: 2px; font-size: 15px; font-weight: 700; line-height: 1; text-decoration: none; white-space: nowrap;
  transition: background-color .2s, border-color .2s, color .2s, gap .25s;
}
.hm-btn:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
.hm-btn--light { background: #fff; border-color: #fff; color: var(--hm-deep); }
.hm-btn--light:hover { background: #e8f1f4; border-color: #e8f1f4; color: var(--hm-deep); gap: 16px; }
.hm-btn--ghost { border-color: rgba(255,255,255,.55); color: #fff; }
.hm-btn--ghost:hover { background: rgba(255,255,255,.12); color: #fff; }
.hm-btn--primary { background: var(--hm-deep); border-color: var(--hm-deep); color: #fff; }
.hm-btn--primary:hover { background: #00384a; border-color: #00384a; color: #fff; gap: 16px; }
.hm-btn--outline { border-color: #9fb3bc; color: var(--hm-deep); }
.hm-btn--outline:hover { background: #fff; border-color: var(--hm-deep); color: var(--hm-deep); }

/* 구역 머리 — 왼쪽 표시·제목, 오른쪽 설명 또는 링크 */
.hm-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 80px; }
.hm-head-sub { max-width: 420px; font-size: 16px; line-height: 1.8; color: var(--hm-text-2); }
.hm-textlink {
  flex: none; display: inline-flex; align-items: center; gap: 10px; padding-bottom: 4px;
  border-bottom: 1.5px solid var(--hm-deep); color: var(--hm-deep); font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap;
  transition: gap .25s, color .2s, border-color .2s;
}
.hm-textlink:hover { gap: 14px; color: #00384a; border-color: #00384a; }

/* ═══════════════════════════
   1. 히어로 — 사진 5장 교체, 아래쪽에 제목과 설명 · 버튼 · 사진 번호 줄 (다른 페이지 맨 위 배너와 같은 모양)
═══════════════════════════ */
.hm-hero { position: relative; display: flex; flex-direction: column; min-height: 100vh; min-height: 100svh; padding-top: 150px; overflow: hidden; background: #0b1e27; color: #fff; }
.wh-hero-slide {
  position: absolute; inset: 0;
  background-size: cover; background-position: 50% 30%; background-repeat: no-repeat;
  opacity: 0; transition: opacity 2s cubic-bezier(0.4,0,0.2,1); will-change: opacity;
}
.wh-hero-slide.wh-slide-active { opacity: 1; }
/* 사진은 나타날 때부터 사라질 때까지 일정한 속도로 아주 천천히 다가온다(100% → 107%).
   사라지는 사진도 흐려지는 2초 동안 계속 다가오게 두어서, 바뀌는 순간 크기가 툭 튀지 않는다. */
.wh-hero-slide.is-zooming { animation: whSlideZoom 9s linear forwards; }
@keyframes whSlideZoom { from { transform: scale(1); } to { transform: scale(1.07); } }
.hm-hero-shade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(0deg, rgba(5,20,28,0.9) 0%, rgba(5,20,28,0.6) 40%, rgba(5,20,28,0.1) 72%, rgba(5,20,28,0.32) 100%); }
.hm-hero-inner { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; justify-content: flex-end; padding-bottom: 64px; }
.hm-hero-eyebrow { display: flex; align-items: center; gap: 12px; color: rgba(255,255,255,.86); font-size: 13px; font-weight: 700; line-height: 1.4; letter-spacing: .12em; text-transform: uppercase; }
.hm-hero-eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; flex: none; }
.hm-hero-title { margin-top: 20px; font-family: var(--ff-serif); font-size: clamp(40px, 5.2vw, 76px); font-weight: 700; line-height: 1.14; letter-spacing: -.04em; color: #fff; }
.hm-hero-title .wl-en { font-size: .78em; }
.hm-hero-bar { margin-top: 40px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,.3); display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 0 56px; align-items: center; }
.hm-hero-desc { font-size: 17px; line-height: 1.75; color: rgba(255,255,255,.84); }
.hm-hero-actions { display: flex; gap: 10px; flex-wrap: wrap; }
.hm-hero-pager { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
.hm-hero-count { font-family: var(--ff-serif); font-size: 14px; line-height: 1; letter-spacing: .04em; font-variant-numeric: tabular-nums; color: #fff; }
.hm-hero-total { color: rgba(255,255,255,.5); }
.hm-hero-segs { display: flex; gap: 6px; }
.hm-hero-seg { position: relative; width: 28px; height: 16px; min-width: 0 !important; min-height: 0 !important; padding: 0; border: 0; border-radius: 0; background: none; cursor: pointer; }
.hm-hero-seg::before { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 2px; margin-top: -1px; background: rgba(255,255,255,.35); transition: background-color .3s; }
.hm-hero-seg:hover::before { background: rgba(255,255,255,.7); }
.hm-hero-seg.is-on::before { background: #fff; }
.hm-hero-seg:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

/* 등장 움직임 — 맨 위 배너(PageHero)와 같은 순서: 사진 → 작은 표시 → 제목 → 아래 줄. 스크립트가 .hm-motion 을 붙일 때만 */
@keyframes hmRise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
@keyframes hmLine { from { width: 0; } to { width: 28px; } }
.hm-hero.hm-motion:not(.is-ready) .wh-hero-slide { opacity: 0; animation: none; }
.hm-hero.hm-motion:not(.is-ready) .hm-hero-eyebrow,
.hm-hero.hm-motion:not(.is-ready) .hm-hero-title,
.hm-hero.hm-motion:not(.is-ready) .hm-hero-bar { opacity: 0; }
.hm-hero.hm-motion.is-ready .hm-hero-eyebrow { animation: hmRise 1.2s .35s cubic-bezier(.2,.7,.2,1) both; }
.hm-hero.hm-motion.is-ready .hm-hero-eyebrow::before { animation: hmLine 1s .65s ease-out both; }
.hm-hero.hm-motion.is-ready .hm-hero-title { animation: hmRise 1.3s .6s cubic-bezier(.2,.7,.2,1) both; }
.hm-hero.hm-motion.is-ready .hm-hero-bar { animation: hmRise 1.3s 1.05s cubic-bezier(.2,.7,.2,1) both; }

/* ═══════════════════════════
   3. 왜 지금인가 — 왼쪽 글 · 오른쪽 큰 숫자
═══════════════════════════ */
.hm-why-inner { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 96px; align-items: end; }
.hm-stat { border-top: 2px solid var(--hm-navy); padding-top: 24px; }
.hm-stat-label { font-size: 13px; font-weight: 700; line-height: 1.5; color: var(--hm-label); }
.hm-stat-value { margin-top: 8px; font-family: var(--ff-serif); font-size: clamp(96px, 9.2vw, 132px); font-weight: 700; line-height: 1; letter-spacing: -.05em; color: var(--hm-deep); }
.hm-stat-value span { font-size: .485em; letter-spacing: -.02em; }
.hm-stat-desc { margin-top: 18px; font-size: 15.5px; line-height: 1.8; color: var(--hm-text); }
.hm-stat-desc strong { color: var(--hm-navy); font-weight: 700; }
.hm-stat-source { margin-top: 14px; padding-top: 12px; border-top: 1px solid var(--hm-line); font-size: 12.5px; line-height: 1.6; color: var(--hm-muted); }

/* ═══════════════════════════
   4. 우리의 이야기 — 누르면 재생되는 영상
═══════════════════════════ */
.hm-story-inner { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 72px; align-items: center; }
.hm-story-text { margin-top: 22px; font-size: 16px; line-height: 1.85; color: var(--hm-text); }
.hm-video { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: #0b1e27; }
/* 영상 칸은 누를 때 스크립트가 만들어 넣는다 — 페이지 범위 스타일이 닿지 않으니 :global 로 건다 */
.hm-video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
.hm-video-poster { position: absolute; inset: 0; display: block; width: 100%; height: 100%; min-height: 0 !important; padding: 0; border: 0; border-radius: 0; background: #0b1e27; color: #fff; font: inherit; text-align: left; cursor: pointer; }
.hm-video-poster img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; opacity: .72; transition: opacity .3s; }
.hm-video-play { position: absolute; left: 50%; top: 50%; width: 84px; height: 84px; margin: -42px 0 0 -42px; display: grid; place-items: center; background: #fff; transition: background-color .2s; }
.hm-home .hm-video-play svg { width: 26px; height: 26px; margin-left: 3px; fill: var(--hm-deep); stroke: none; }
.hm-video-title { position: absolute; left: 28px; right: 28px; bottom: 24px; font-size: 14px; font-weight: 600; line-height: 1.5; color: #fff; }
.hm-video-poster:hover img { opacity: .8; }
.hm-video-poster:hover .hm-video-play { background: #e8f1f4; }
.hm-video-poster:focus-visible { outline: 3px solid var(--hm-deep); outline-offset: 3px; }

/* ═══════════════════════════
   5. 비전 — 다섯 칸 (펼치기 없음)
═══════════════════════════ */
.hm-vision-list { list-style: none; margin-top: 56px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0 28px; }
.hm-vision-item { padding-top: 22px; border-top: 2px solid var(--hm-navy); }
.hm-vision-num { display: block; font-family: var(--ff-serif); font-size: 15px; line-height: 1.2; color: var(--hm-deep); }
.hm-vision-name { margin-top: 14px; font-family: var(--ff-serif); font-size: 22px; font-weight: 700; line-height: 1.3; letter-spacing: -.02em; color: var(--hm-navy); }
.hm-vision-text { margin-top: 12px; font-size: 14.5px; line-height: 1.8; color: var(--hm-text-2); }

/* ═══════════════════════════
   6. 사역 — 네 칸 (사진 4:3)
═══════════════════════════ */
.hm-min-grid { margin-top: 56px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; }
.hm-min-card { display: flex; flex-direction: column; min-width: 0; color: inherit; text-decoration: none; }
.hm-min-card:focus-visible { outline: 2px solid var(--hm-deep); outline-offset: 4px; }
.hm-min-media { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: #e3eaee; }
.hm-min-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
.hm-min-card:hover .hm-min-media img { transform: scale(1.03); }
.hm-min-num { margin-top: 20px; font-family: var(--ff-serif); font-size: 14px; line-height: 1.2; color: var(--hm-deep); }
.hm-min-title { margin-top: 8px; display: flex; justify-content: space-between; align-items: center; gap: 12px; font-family: var(--ff-serif); font-size: 22px; font-weight: 700; line-height: 1.3; letter-spacing: -.02em; color: var(--hm-navy); }
.hm-min-title svg { color: var(--hm-deep); transition: transform .25s; }
.hm-min-card:hover .hm-min-title svg { transform: translateX(4px); }
.hm-min-text { margin-top: 10px; font-size: 14.5px; line-height: 1.75; color: var(--hm-muted); }

/* ═══════════════════════════
   8. 마무리 — 남색 띠
═══════════════════════════ */
.hm-closing { padding: 104px 0; background: var(--hm-navy); color: #fff; }
.hm-closing-inner { display: flex; justify-content: space-between; align-items: flex-end; gap: 60px; }
.hm-closing .hm-eyebrow { color: rgba(255,255,255,.78); }
.hm-closing .hm-h2 { color: #fff; }
.hm-closing-sub { margin-top: 20px; font-size: 17px; line-height: 1.8; color: rgba(255,255,255,.8); }
.hm-closing .hm-actions { margin-top: 0; flex: none; }

/* 스크롤하면 떠오르기 — 스크립트가 .hm-rv 를 붙일 때만 (작은 표시 → 제목 → 글 → 왼쪽부터 칸 순서) */
