  <script is:inline>
    // 스크롤하면 떠오르기: 구역([data-rv-group])마다 [data-rv] 를 문서 순서대로(작은 표시 → 제목 → 글 → 왼쪽부터 칸) 조금씩 늦춰 띄운다.
    // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var items = [];
      [].forEach.call(document.querySelectorAll('.hm-home [data-rv-group]'), function (g) {
        [].forEach.call(g.querySelectorAll('[data-rv]'), function (el, i) {
          el.style.setProperty('--d', Math.min(i, 6) * 0.08 + 's');
          el.classList.add('hm-rv');
          items.push(el);
        });
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      items.forEach(function (el) { io.observe(el); });
    })();
  </script>

</div>


<script>
  // ── 히어로 사진 교체 ─────────────────────────────────────
  // 6초마다 다음 사진으로. 아래 줄의 숫자(01 / 05)와 막대가 함께 바뀌고, 막대를 누르면 그 사진으로 가서 6초를 새로 센다.
  (function() {
    const hero = document.getElementById('heroSection');
    if (!hero) return;
    const slides = hero.querySelectorAll('.wh-hero-slide');
    if (!slides.length) return;
    const segs = hero.querySelectorAll('.hm-hero-seg');
    const cur = hero.querySelector('.hm-hero-cur');
    let current = 0;
    let timer = 0;

    function show(idx) {
      const prev = slides[current];
      prev.classList.remove('wh-slide-active');
      // 사라지는 사진은 흐려지는 동안(2초) 계속 다가오게 두었다가, 다 사라진 뒤에 움직임을 뗀다
      setTimeout(function() { if (!prev.classList.contains('wh-slide-active')) prev.classList.remove('is-zooming'); }, 2200);
      current = (idx + slides.length) % slides.length;
      const next = slides[current];
      next.classList.remove('is-zooming');
      void next.offsetWidth;                       // 다가오기를 처음(100%)부터 다시
      next.classList.add('wh-slide-active', 'is-zooming');
      if (cur) cur.textContent = String(current + 1).padStart(2, '0');
      segs.forEach(function(s, i) {
        s.classList.toggle('is-on', i === current);
        s.setAttribute('aria-current', i === current ? 'true' : 'false');
      });
    }
    function restart() {
      clearInterval(timer);
      timer = setInterval(function() { show(current + 1); }, 6000);
    }
    segs.forEach(function(s, i) {
      s.addEventListener('click', function() { if (i !== current) show(i); restart(); });
    });
    restart();
  })();

  // ── 우리의 이야기 영상: 사진을 누르면 그 자리에 유튜브 영상을 넣고 바로 재생 ──
  (function() {
    const box = document.getElementById('homeVideo');
    const poster = box && box.querySelector('.hm-video-poster');
    if (!box || !poster) return;
    poster.addEventListener('click', function() {
      const frame = document.createElement('iframe');
      frame.src = box.getAttribute('data-src') || '';
      frame.title = 'Word of Life Korea';
      frame.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share');
      frame.setAttribute('allowfullscreen', '');
      frame.setAttribute('frameborder', '0');
      while (box.firstChild) box.removeChild(box.firstChild);
      box.appendChild(frame);
      frame.focus();
    });
  })();

  // ── 홈 안내 팝업: 5초 자동 교체, 아래 점과 모바일 좌우 스와이프로 넘긴다 ──
  // "다시 보지 않기"는 카드마다 localStorage(영구), 그냥 닫기/배경 클릭/신청 이동은
  // sessionStorage(이번 방문 동안만)로 구분해서 과하게 반복 노출되지 않게 한다.
  (function () {
    var overlay = document.getElementById('homePromos');
    if (!overlay) return;
    var dotsEl = document.getElementById('homePromoDots');
    var todayKst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
    var ROTATE_MS = 5000;
    var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var timer = null, current = 0;

    function setup(cfg) {
      var card = document.getElementById(cfg.card);
      if (!card) return null;
      var start = (card.dataset.start || '').slice(0, 10);
      var skip = start && todayKst >= start;                       // 행사가 시작되면 더 띄우지 않는다
      try {
        if (localStorage.getItem(cfg.perma) === '1' || sessionStorage.getItem(cfg.session) === '1') skip = true;
      } catch (e) {}
      if (skip) { card.hidden = true; return null; }
      var item = { card: card, cfg: cfg, gone: false };
      document.getElementById(cfg.close).addEventListener('click', closeAll);
      document.getElementById(cfg.cta).addEventListener('click', function () { markSeen(item); });
      document.getElementById(cfg.dismiss).addEventListener('click', function () {
        try { localStorage.setItem(cfg.perma, '1'); } catch (e) {}
        item.gone = true; card.hidden = true; markSeen(item);
        render(0);                                                  // 남은 카드로 넘어간다 (없으면 팝업을 닫는다)
      });
      return item;
    }
    function markSeen(item) { try { sessionStorage.setItem(item.cfg.session, '1'); } catch (e) {} }

    var items = [
      setup({ card: 'thanksgivingPromo', close: 'thanksgivingPromoClose', cta: 'thanksgivingPromoCta', dismiss: 'thanksgivingPromoDismiss',
              perma: 'wolko-promo-thanksgiving-2026-11-26-hide', session: 'wolko-promo-thanksgiving-2026-11-26-seen' }),
      setup({ card: 'campusDayPromo', close: 'campusDayPromoClose', cta: 'campusDayPromoCta', dismiss: 'campusDayPromoDismiss',
              perma: 'wolko-promo-jeju-campus-day-2026-hide', session: 'wolko-promo-jeju-campus-day-2026-seen' }),
    ].filter(Boolean);
    if (!items.length) return;

    function live() { return items.filter(function (i) { return !i.gone; }); }
    function closeOverlay() {
      clearInterval(timer); timer = null;
      overlay.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(function () { overlay.hidden = true; }, 350);
    }
    function closeAll() { live().forEach(markSeen); closeOverlay(); }

    // 점(네비게이터)과 현재 카드 표시
    function render(idx) {
      var l = live();
      if (!l.length) { closeOverlay(); return; }
      current = (idx + l.length) % l.length;
      items.forEach(function (i) { i.card.classList.remove('is-active'); });
      l[current].card.classList.add('is-active');
      dotsEl.hidden = l.length < 2;
      dotsEl.innerHTML = l.map(function (_, n) {
        return '<button type="button" role="tab" aria-label="' + (n + 1) + '/' + l.length + '" aria-selected="' + (n === current) + '" class="' + (n === current ? 'is-on' : '') + '" data-n="' + n + '"></button>';
      }).join('');
      restart();
    }
    function restart() {
      clearInterval(timer); timer = null;
      if (reduceMotion || live().length < 2 || paused) return;
      timer = setInterval(function () { render(current + 1); }, ROTATE_MS);
    }
    var paused = false;
    dotsEl.addEventListener('click', function (e) { var b = e.target.closest('[data-n]'); if (b) render(+b.dataset.n); });
    // 읽는 중에는 넘어가지 않게: 마우스를 올리거나 손가락을 대고 있거나 키보드 포커스가 있는 동안 멈춘다
    var row = overlay.querySelector('.wh-promo-row');
    ['mouseenter', 'focusin', 'touchstart'].forEach(function (ev) { row.addEventListener(ev, function () { paused = true; clearInterval(timer); timer = null; }, { passive: true }); });
    ['mouseleave', 'focusout', 'touchend'].forEach(function (ev) { row.addEventListener(ev, function () { paused = false; restart(); }, { passive: true }); });
    var stage = document.getElementById('homePromoStage');
    var touchOrigin = null, suppressClickUntil = 0;
    function swipeDirection(start, end) {
      var dx = end.clientX - start.clientX;
      var dy = end.clientY - start.clientY;
      return Math.abs(dx) >= 45 && Math.abs(dx) > Math.abs(dy) * 1.25 ? (dx < 0 ? 1 : -1) : 0;
    }
    stage.addEventListener('touchstart', function (e) {
      touchOrigin = e.touches.length === 1 ? { clientX: e.touches[0].clientX, clientY: e.touches[0].clientY } : null;
    }, { passive: true });
    stage.addEventListener('touchend', function (e) {
      if (touchOrigin && e.changedTouches.length === 1 && !e.touches.length) {
        var direction = swipeDirection(touchOrigin, e.changedTouches[0]);
        if (direction && live().length > 1) {
          suppressClickUntil = Date.now() + 500;
          render(current + direction);
        }
      }
      touchOrigin = null;
    }, { passive: true });
    stage.addEventListener('touchcancel', function () { touchOrigin = null; paused = false; restart(); }, { passive: true });
    // 스와이프를 마친 손가락이 신청/닫기 버튼의 클릭으로 이어지지 않게 한다.
    stage.addEventListener('click', function (e) {
      if (Date.now() < suppressClickUntil) { e.preventDefault(); e.stopPropagation(); }
    }, true);
    overlay.addEventListener('click', function (e) { if (e.target === overlay || e.target === row) closeAll(); });
    document.addEventListener('keydown', function (e) {
      if (!overlay.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeAll();
      else if (e.key === 'ArrowRight') render(current + 1);
      else if (e.key === 'ArrowLeft') render(current - 1);
    });

    // 팝업이 모바일 메뉴(z-index 998)보다 위(1000)라서, 메뉴를 열어 둔 채 팝업이 뜨면 하위 메뉴를 눌러도 팝업이 터치를 받는다.
    // 그래서 메뉴가 열려 있으면 메뉴가 닫힐 때까지 팝업을 미룬다.
    function showPromos() {
      var menu = document.getElementById('mobileMenu');
      // 메뉴는 열리는 즉시 display:block 이 되고 open 클래스는 두 프레임 뒤에 붙으므로 둘 다 본다
      if (menu && (menu.classList.contains('open') || (menu.style && menu.style.display === 'block'))) { setTimeout(showPromos, 600); return; }
      overlay.hidden = false;
      render(0);
      requestAnimationFrame(function () { overlay.classList.add('is-open'); });
      document.body.style.overflow = 'hidden';
    }
    setTimeout(showPromos, 700);
  })();
</script>

