/* ═══════════════════════════
   감사의 밤 안내 팝업
═══════════════════════════ */
.wh-promo-overlay {
  position: fixed; inset: 0; z-index: 1000;
  display: flex; align-items: center; justify-content: center;
  padding: 24px;
  background: rgba(15, 8, 6, 0.55);
  backdrop-filter: blur(3px);
  opacity: 0; visibility: hidden;
  transition: opacity .35s ease, visibility 0s linear .35s;
}
.wh-promo-overlay.is-open { opacity: 1; visibility: visible; transition: opacity .35s ease; }
/* 팝업: 카드가 두 장이면 한 장씩 3초마다 교체되고, 아래 점(네비게이터)으로 직접 넘길 수 있다 */
.wh-promo-row { width: 100%; max-width: 400px; max-height: 100%; display: flex; flex-direction: column; align-items: center; gap: 14px; margin: auto; }
.wh-promo-stage { width: 100%; display: grid; touch-action: pan-y pinch-zoom; }
.wh-promo-stage > .wh-promo-card { grid-area: 1 / 1; opacity: 0; visibility: hidden; pointer-events: none; transition: opacity .45s ease, visibility 0s linear .45s, transform .4s cubic-bezier(.2,.8,.3,1.1); }
/* 열려 있을 때만 보이고 눌린다. (예전엔 .is-active 카드가 스스로 visibility:visible 이라, 팝업을 닫아도 투명한 카드와 '초대장 보기' 버튼이 화면 가운데에 남아 눌렸다) */
.wh-promo-overlay.is-open .wh-promo-stage > .wh-promo-card.is-active { opacity: 1; visibility: visible; pointer-events: auto; transition: opacity .45s ease; }
.wh-promo-overlay:not(.is-open) { pointer-events: none; }
.wh-promo-stage > .wh-promo-card[hidden] { display: none; }
.wh-promo-dots { display: flex; gap: 10px; align-items: center; justify-content: center; }
.wh-promo-dots[hidden] { display: none; }
:root:root .wh-promo-dots :global(button) { width: 12px !important; height: 12px !important; flex: 0 0 12px; min-width: 0 !important; min-height: 0 !important; padding: 0 !important; aspect-ratio: 1 / 1; border: 0; border-radius: 50%; background: rgba(255,255,255,.45); cursor: pointer; transition: background .2s, transform .2s; }
:root:root .wh-promo-dots :global(button.is-on) { background: #fff; transform: scale(1.25); }
:root:root .wh-promo-dots :global(button:focus-visible) { outline: 2px solid #fff; outline-offset: 3px; }
.wh-promo-card {
  position: relative; width: 100%; max-width: 400px; max-height: 90vh; overflow-y: auto;
  background: #fff; border-radius: 20px; overflow-x: hidden;
  box-shadow: 0 30px 80px rgba(0,0,0,.35);
  transform: translateY(18px) scale(.97);
  transition: transform .4s cubic-bezier(.2,.8,.3,1.1);
}
.wh-promo-overlay.is-open .wh-promo-card { transform: translateY(0) scale(1); }
/* 모바일: 상단 메뉴가 팝업 위에 떠 있으므로(메뉴 버튼이 눌리도록) 팝업 카드는 메뉴 줄 아래에서 시작해 닫기 버튼이 가려지지 않게 한다 */
@media (max-width: 900px) {
  .wh-promo-overlay { padding-top: calc(var(--nav-h) + 20px); }
  .wh-promo-card { max-height: calc(100vh - var(--nav-h) - 120px); max-height: calc(100dvh - var(--nav-h) - 120px); }
}
.wh-promo-close {
  position: absolute; top: 12px; right: 12px; z-index: 2;
  width: 30px; height: 30px; border-radius: 50%; border: none;
  background: rgba(0,0,0,.35); color: #fff; display: grid; place-items: center; cursor: pointer;
  backdrop-filter: blur(4px);
}
:root:root .wh-promo-close {
  /* 공용 버튼 규칙(최소 높이 44px 등)이 세로로 길게 늘리지 않도록 정원으로 고정 */
  width: 34px !important; height: 34px !important; min-width: 0 !important; min-height: 0 !important;
  padding: 0 !important; aspect-ratio: 1 / 1; flex: none; border-radius: 50% !important;
}
.wh-promo-close svg { width: 14px; height: 14px; stroke: currentColor; fill: none; stroke-width: 2.2; stroke-linecap: round; }
.wh-promo-close:hover { background: rgba(0,0,0,.5); }
.wh-promo-image { display: block; width: 100%; aspect-ratio: 1200 / 630; object-fit: cover; }
.wh-promo-body { padding: 22px 24px 24px; text-align: center; }
.wh-promo-eyebrow { font-size: 10.5px; font-weight: 800; letter-spacing: .22em; color: #b0631f; text-transform: uppercase; margin-bottom: 9px; }
.wh-promo-title { margin: 0 0 8px; font-family: var(--ff-serif); font-size: 24px; font-weight: 800; color: #3b1f17; }
.wh-promo-meta { margin: 0 0 20px; font-size: 13.5px; line-height: 1.6; color: #6b5346; }
.wh-promo-actions { display: flex; flex-direction: column; gap: 9px; }
.wh-promo-btn {
  display: block; padding: 13px 20px; border-radius: 12px; text-decoration: none;
  background: linear-gradient(135deg, #9a3b22, #d9772f); color: #fff;
  font-weight: 800; font-size: 14.5px; box-shadow: 0 10px 24px rgba(154,59,34,.28);
}
.wh-promo-dismiss {
  background: none; border: none; padding: 4px; font-size: 12px; color: #9a8a80;
  cursor: pointer; text-decoration: underline; text-underline-offset: 2px; font-family: var(--ff-sans);
}
@media (prefers-reduced-motion: reduce) {
  .wh-promo-overlay, .wh-promo-card { transition: none !important; }
}
</style>

