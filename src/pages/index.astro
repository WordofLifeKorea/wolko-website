    // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다. 사진이 2.5초 넘게 안 오면 기다리지 않는다.
    (function () {
      var h = document.getElementById('heroSection');
      if (!h || !('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      h.classList.add('hm-motion');
      var done = false, first = h.querySelector('.wh-hero-slide'), m = first && /url\(['"]?([^'")]+)/.exec(first.style.backgroundImage);
      function go() { if (done) return; done = true; h.classList.add('is-ready'); }
      if (!m) return go();
      var img = new Image();
      img.onload = img.onerror = go;
      img.src = m[1];
      if (img.complete) go();
      setTimeout(go, 2500);
    })();
