---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="WOLKO — 한국의 다음 세대에게 복음을"
  description="복음전파와 제자훈련으로 한국의 다음 세대를 섬깁니다 — Word of Life Korea"
  activeNav="home"
>

<style>
/* ═══════════════════════════
   공통
═══════════════════════════ */
.wh-home-combined,
.wh-home-combined * { box-sizing: border-box; word-break: keep-all; }
.wh-home-combined { background: #ffffff; overflow: hidden; font-family: var(--ff-sans); }

/* ═══════════════════════════
   HERO SLIDESHOW
═══════════════════════════ */
.wh-home-hero { position: relative; min-height: 100vh; background: #0d1e28; overflow: hidden; }
.wh-hero-slide {
  position: absolute; inset: 0;
  background-size: cover; background-position: center 30%;
  opacity: 0; transition: opacity 2s cubic-bezier(0.4,0,0.2,1); will-change: opacity;
}
.wh-hero-slide.wh-slide-active { opacity: 1; animation: whSlideKenBurns 8s ease-out forwards; }
@keyframes whSlideKenBurns { from { transform: scale(1.08); } to { transform: scale(1.00); } }
.wh-home-hero-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, rgba(4,14,20,0.30) 0%, rgba(4,14,20,0.15) 25%, rgba(4,14,20,0.50) 65%, rgba(4,14,20,0.82) 100%);
  pointer-events: none;
}
.wh-home-hero-inner {
  position: relative; z-index: 2; min-height: 100vh;
  display: flex; align-items: center; justify-content: center;
  padding: 140px 24px 110px;
}
.wh-home-hero-content {
  width: 100%; max-width: 820px;
  margin: 0 auto; text-align: center; color: #ffffff;
  display: flex; flex-direction: column; align-items: center;
}
.wh-home-hero-title {
  margin: 0 0 22px;
  font-family: var(--ff-serif);
  font-size: clamp(40px, 6.4vw, 76px);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: -0.04em;
  color: #ffffff;
  text-shadow: 0 4px 24px rgba(0,0,0,0.45);
  opacity: 0; transform: translateY(18px);
  animation: whHomeFadeUp 0.9s ease 0.25s forwards;
}
.wh-home-hero-desc {
  max-width: 580px; margin: 0 0 44px;
  font-family: var(--ff-sans);
  font-size: var(--fs-body-l);
  font-weight: 400;
  line-height: var(--lh-body);
  color: rgba(255,255,255,0.75);
  opacity: 0; transform: translateY(18px);
  animation: whHomeFadeUp 0.9s ease 0.4s forwards;
}
.wh-home-hero-buttons {
  display: flex; justify-content: center; align-items: center;
  gap: 14px; flex-wrap: wrap;
  opacity: 0; transform: translateY(18px);
  animation: whHomeFadeUp 0.9s ease 0.55s forwards;
}
.wh-home-btn {
  display: inline-flex; align-items: center; justify-content: center;
  min-width: 180px; min-height: 56px; padding: 15px 30px;
  border-radius: 999px; text-decoration: none !important;
  font-family: var(--ff-sans);
  font-size: 14px; font-weight: 700; letter-spacing: 0.02em;
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}
.wh-home-btn-primary, .wh-home-btn-primary:link, .wh-home-btn-primary:visited {
  background: #ffffff; color: #004f68 !important; box-shadow: 0 12px 30px rgba(0,0,0,0.25);
}
.wh-home-btn-secondary, .wh-home-btn-secondary:link, .wh-home-btn-secondary:visited {
  background: rgba(255,255,255,0.10); color: #ffffff !important;
  border: 1.5px solid rgba(255,255,255,0.40);
}
.wh-home-btn:hover { transform: translateY(-2px); }
.wh-home-btn-primary:hover { box-shadow: 0 18px 40px rgba(0,0,0,0.30); }
.wh-home-btn-secondary:hover { background: rgba(255,255,255,0.18); border-color: rgba(255,255,255,0.65); }
.wh-home-btn:active { transform: translateY(1px) scale(0.98); }
@keyframes whHomeFadeUp { to { opacity: 1; transform: translateY(0); } }

/* ═══════════════════════════
   PARTNERSHIP
═══════════════════════════ */
.wolko-partnership-v2 {
  padding: 120px 20px 128px;
  background:
    radial-gradient(circle at 14% 12%, rgba(115,209,245,0.08), transparent 30%),
    radial-gradient(circle at 86% 82%, rgba(0,79,104,0.05), transparent 24%),
    linear-gradient(180deg, #f9fcfd 0%, #ffffff 100%);
}
.wolko-partnership-v2__inner { max-width: 1180px; margin: 0 auto; }
.wolko-partnership-v2__top { max-width: 720px; margin: 0 auto 64px; text-align: center; }
.wolko-partnership-v2__badge {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 8px 18px; margin-bottom: 20px; border-radius: 999px;
  background: rgba(0,79,104,0.05); border: 1px solid rgba(0,79,104,0.10);
  color: #006f90;
  font-family: var(--ff-sans);
  font-size: var(--fs-label); font-weight: 800; letter-spacing: var(--ls-label);
  text-transform: uppercase;
}
.wolko-partnership-v2__title {
  margin: 0 0 18px;
  color: #004f68;
  font-family: var(--ff-serif);
  font-size: clamp(36px, 4.6vw, 56px);
  font-weight: 800;
  line-height: var(--lh-head);
  letter-spacing: var(--ls-head);
}
.wolko-partnership-v2__subtitle {
  margin: 0;
  color: #647983;
  font-family: var(--ff-sans);
  font-size: var(--fs-body-l);
  font-weight: 400;
  line-height: var(--lh-body);
}
.wolko-partnership-v2__grid { display: grid; grid-template-columns: 1.06fr 0.94fr; gap: 24px; align-items: start; }
.wolko-partnership-v2__copy, .wolko-partnership-v2__side { display: flex; flex-direction: column; gap: 16px; }
.wolko-partnership-v2__panel, .wolko-partnership-v2__stat-card {
  background: #ffffff; border: 1px solid rgba(0,79,104,0.08); border-radius: 24px;
  box-shadow: 0 2px 8px rgba(18,55,72,0.04), 0 12px 32px rgba(18,55,72,0.06);
}
.wolko-partnership-v2__panel {
  padding: 40px 38px 36px;
  background: linear-gradient(145deg, #002f42 0%, #004f68 55%, #005f7c 100%);
  border: none;
  position: relative; overflow: hidden;
}
.wolko-partnership-v2__panel::before {
  content: '"';
  position: absolute; top: -10px; right: 24px;
  font-family: 'Plus Jakarta Sans', sans-serif; font-size: 160px; line-height: 1;
  color: rgba(115,209,245,0.07); pointer-events: none; user-select: none;
}
.wolko-partnership-v2__eyebrow {
  margin: 0 0 18px;
  color: #73d1f5;
  font-family: var(--ff-sans);
  font-size: var(--fs-label); font-weight: 800; letter-spacing: var(--ls-label);
  text-transform: uppercase;
}
.wolko-partnership-v2__panel-title {
  margin: 0 0 20px;
  color: #ffffff;
  font-family: var(--ff-serif);
  font-size: clamp(18px, 1.9vw, 22px);
  font-weight: 700;
  line-height: 1.6;
  letter-spacing: var(--ls-head);
}
.wolko-partnership-v2__text {
  margin: 0;
  color: rgba(255,255,255,0.68);
  font-family: var(--ff-sans);
  font-size: var(--fs-body-m);
  font-weight: 400;
  line-height: var(--lh-body);
}
.wolko-partnership-v2__stat-card { padding: 40px 32px 36px; text-align: center; }
.wolko-partnership-v2__stat-label {
  margin: 0 0 16px;
  color: #00708f;
  font-family: var(--ff-sans);
  font-size: var(--fs-label); font-weight: 800; letter-spacing: var(--ls-label);
  text-transform: uppercase;
}
.wolko-partnership-v2__stat-value {
  margin: 0 0 12px;
  color: #c42a36;
  font-family: var(--ff-sans);
  font-size: clamp(56px, 9vw, 88px);
  line-height: 1; font-weight: 900; letter-spacing: -0.05em;
}
.wolko-partnership-v2__stat-value span {
  margin-left: 2px;
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 700; letter-spacing: -0.02em;
  color: #c42a36;
}
.wolko-partnership-v2__stat-desc {
  margin: 0;
  color: #667b84;
  font-family: var(--ff-sans);
  font-size: var(--fs-body-s);
  font-weight: 400;
  line-height: 1.7;
}
.wolko-partnership-v2__actions { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.wolko-partnership-v2__btn {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 54px; padding: 15px 20px; border-radius: 999px;
  text-decoration: none !important;
  font-family: var(--ff-sans);
  font-size: 14px; font-weight: 700; letter-spacing: 0.02em;
  transition: transform 0.22s ease, box-shadow 0.22s ease;
}
.wolko-partnership-v2__btn.is-primary, .wolko-partnership-v2__btn.is-primary:link, .wolko-partnership-v2__btn.is-primary:visited {
  background: linear-gradient(135deg, #004f68 0%, #0d6f8c 44%, #73d1f5 100%);
  color: #ffffff !important; box-shadow: 0 12px 28px rgba(0,79,104,0.22);
}
.wolko-partnership-v2__btn.is-primary:hover { transform: translateY(-2px); box-shadow: 0 18px 36px rgba(0,79,104,0.28); }
.wolko-partnership-v2__btn.is-secondary, .wolko-partnership-v2__btn.is-secondary:link, .wolko-partnership-v2__btn.is-secondary:visited {
  background: #ffffff; color: #004f68; border: 1px solid rgba(0,79,104,0.14); box-shadow: 0 4px 14px rgba(20,50,70,0.06);
}
.wolko-partnership-v2__btn.is-secondary:hover { transform: translateY(-2px); background: #f4f9fc; }
.wolko-partnership-v2__video { margin-top: 72px; padding-top: 64px; border-top: 1px solid rgba(0,79,104,0.08); text-align: center; }
.wolko-partnership-v2__video-label {
  margin: 0 0 20px;
  color: #00708f;
  font-family: var(--ff-sans);
  font-size: var(--fs-label); font-weight: 800; letter-spacing: var(--ls-label);
  text-transform: uppercase;
}
.wolko-partnership-v2__video-wrap {
  position: relative; width: 100%; max-width: 900px; margin: 0 auto;
  padding-bottom: 50.6%; border-radius: 20px; overflow: hidden; background: #0a1e28;
  box-shadow: 0 24px 56px rgba(0,79,104,0.14), 0 4px 14px rgba(0,79,104,0.06);
}
.wolko-partnership-v2__video-wrap iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
.wolko-partnership-v2__video-caption {
  margin: 20px 0 0;
  color: #8a9ea7;
  font-family: var(--ff-sans);
  font-size: 13px; font-weight: 400; line-height: 1.7;
}

/* ═══════════════════════════
   VISION
═══════════════════════════ */
.wh-vision-section {
  padding: 120px 20px;
  background:
    radial-gradient(ellipse at 18% 8%, rgba(115,209,245,0.09), transparent 36%),
    radial-gradient(ellipse at 84% 88%, rgba(0,79,104,0.05), transparent 28%),
    linear-gradient(180deg, #ffffff 0%, #f8fbfc 100%);
  overflow: hidden;
}
.wh-vision-inner { max-width: 860px; margin: 0 auto; }
.wh-vision-head { text-align: center; margin-bottom: 64px; }
.wh-badge {
  display: inline-block; padding: 7px 16px; border-radius: 999px;
  background: rgba(0,79,104,0.05); border: 1px solid rgba(0,79,104,0.10);
  color: #00708f;
  font-family: var(--ff-sans);
  font-size: var(--fs-label); font-weight: 800; letter-spacing: var(--ls-label);
  text-transform: uppercase; margin-bottom: 18px;
}
.wh-vision-title {
  margin: 0 0 12px;
  font-family: var(--ff-serif);
  font-size: clamp(32px, 4vw, 50px);
  font-weight: 800;
  line-height: var(--lh-head);
  letter-spacing: var(--ls-head);
  color: #004f68;
}
.wh-vision-subtitle {
  margin: 0;
  color: #7a909a;
  font-family: var(--ff-sans);
  font-size: var(--fs-body-l);
  font-weight: 400;
  line-height: var(--lh-body);
}
.wh-vision-list { display: flex; flex-direction: column; }
.wh-vision-item {
  position: relative; border-bottom: 1px solid rgba(0,79,104,0.08);
  opacity: 0; transform: translateY(16px);
  animation: whItemReveal 0.55s cubic-bezier(0.23,1,0.32,1) forwards;
  animation-delay: calc(0.08s * var(--wh-i));
}
.wh-vision-item:first-child { border-top: 1px solid rgba(0,79,104,0.08); }
@keyframes whItemReveal { to { opacity: 1; transform: translateY(0); } }
.wh-vision-accent {
  position: absolute; left: 0; top: 0; width: 3px; height: 100%;
  background: linear-gradient(180deg, #004f68, #73d1f5); border-radius: 0 3px 3px 0;
  transform: scaleY(0); transform-origin: top center;
  transition: transform 0.35s cubic-bezier(0.23,1,0.32,1); pointer-events: none;
}
.wh-vision-item.is-active .wh-vision-accent { transform: scaleY(1); }
.wh-vision-trigger {
  width: 100%; display: flex; align-items: center; gap: 24px;
  padding: 28px 16px 28px 20px; border: none; background: transparent;
  cursor: pointer; text-align: left; transition: background 0.2s ease; position: relative;
}
.wh-vision-trigger:hover { background: rgba(0,79,104,0.018); }
.wh-vision-item.is-active .wh-vision-trigger { background: rgba(0,79,104,0.025); }
.wh-vision-num {
  flex: 0 0 auto;
  font-family: var(--ff-sans);
  font-size: 20px; font-weight: 800; letter-spacing: 0.02em;
  color: rgba(0,79,104,0.12); min-width: 40px; transition: color 0.3s;
}
.wh-vision-item.is-active .wh-vision-num { color: #73d1f5; }
.wh-vision-titles { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.wh-vision-label {
  font-family: var(--ff-sans);
  font-size: 19px; font-weight: 700;
  letter-spacing: var(--ls-sub);
  line-height: 1.3;
  color: #1a2e38; transition: color 0.3s;
}
.wh-vision-item.is-active .wh-vision-label { color: #004f68; }
.wh-vision-chevron {
  flex: 0 0 auto; width: 30px; height: 30px; border-radius: 50%; position: relative;
  margin-left: auto;
  background: rgba(0,79,104,0.06);
  border: 1.5px solid rgba(0,79,104,0.15);
  transition: background 0.25s, border-color 0.25s, transform 0.35s cubic-bezier(0.23,1,0.32,1);
}
.wh-vision-item.is-active .wh-vision-chevron {
  background: #004f68;
  border-color: #004f68;
}
.wh-vision-chevron::before, .wh-vision-chevron::after {
  content: ""; position: absolute;
  top: 50%; left: 50%;
  background: #6b8fa0; border-radius: 2px;
  transition: background 0.25s, transform 0.3s cubic-bezier(0.23,1,0.32,1), opacity 0.25s;
}
.wh-vision-chevron::before { width: 12px; height: 2px; transform: translate(-50%, -50%); }
.wh-vision-chevron::after  { width: 2px; height: 12px; transform: translate(-50%, -50%); }
.wh-vision-item.is-active .wh-vision-chevron::before,
.wh-vision-item.is-active .wh-vision-chevron::after { background: #fff; }
.wh-vision-item.is-active .wh-vision-chevron::after { transform: translate(-50%, -50%) scaleY(0); opacity: 0; }
.wh-vision-body { max-height: 0; overflow: hidden; transition: max-height 0.4s cubic-bezier(0.23,1,0.32,1), opacity 0.3s; opacity: 0; }
.wh-vision-body p {
  margin: 0; padding: 4px 20px 32px 84px;
  font-family: var(--ff-sans);
  font-size: var(--fs-body-m);
  font-weight: 400;
  line-height: var(--lh-body);
  color: #5a6f79;
}
.wh-vision-item.is-active .wh-vision-body { max-height: 400px; opacity: 1; }

/* ═══════════════════════════
   MINISTRY
═══════════════════════════ */
.wh-ministry-section {
  padding: 120px 20px 130px;
  background:
    radial-gradient(circle at 12% 14%, rgba(115,209,245,0.10), transparent 24%),
    radial-gradient(circle at 86% 82%, rgba(0,79,104,0.06), transparent 24%),
    linear-gradient(180deg, #f8fbfc 0%, #ffffff 100%);
}
.wh-ministry-inner { max-width: 1180px; margin: 0 auto; }
.wh-ministry-head { text-align: center; max-width: 720px; margin: 0 auto 56px; }
.wh-ministry-title {
  margin: 0 0 16px;
  color: #004f68;
  font-family: var(--ff-serif);
  font-size: clamp(32px, 4vw, 52px);
  font-weight: 800;
  line-height: var(--lh-head);
  letter-spacing: var(--ls-head);
}
.wh-ministry-subtitle {
  margin: 0;
  color: #6d8089;
  font-family: var(--ff-sans);
  font-size: var(--fs-body-l);
  font-weight: 400;
  line-height: var(--lh-body);
}
.wh-ministry-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }
.wh-ministry-card {
  display: flex; flex-direction: column; justify-content: space-between;
  min-height: 280px; padding: 32px 28px 28px; border-radius: 20px;
  text-decoration: none !important; position: relative; overflow: hidden;
  background: #ffffff; border: 1px solid rgba(0,79,104,0.08);
  box-shadow: 0 2px 8px rgba(18,55,72,0.04), 0 12px 32px rgba(18,55,72,0.06);
  transition: transform 0.25s ease, box-shadow 0.25s ease;
}
.wh-ministry-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
  background: linear-gradient(90deg, #004f68 0%, #007ea1 55%, #73d1f5 100%);
  opacity: 0.55; transition: opacity 0.25s ease;
}
.wh-ministry-card:hover { transform: translateY(-5px); box-shadow: 0 6px 16px rgba(18,55,72,0.07), 0 24px 48px rgba(18,55,72,0.11); }
.wh-ministry-card:hover::before { opacity: 1; }
.wh-ministry-card-top { margin-bottom: 20px; }
.wh-ministry-card-num {
  display: inline-block; margin-bottom: 14px;
  color: rgba(0,79,104,0.28);
  font-family: var(--ff-sans);
  font-size: var(--fs-label); font-weight: 800; letter-spacing: var(--ls-label);
  text-transform: uppercase;
}
.wh-ministry-card-title {
  margin: 0;
  color: #0d1e28;
  font-family: var(--ff-serif);
  font-size: 21px; font-weight: 700;
  letter-spacing: var(--ls-head);
  line-height: 1.3;
}
.wh-ministry-card-text {
  margin: 0 0 24px;
  color: #677c86;
  font-family: var(--ff-sans);
  font-size: var(--fs-body-s);
  font-weight: 400;
  line-height: var(--lh-body);
}
.wh-ministry-card-link {
  display: inline-flex; align-items: center; gap: 7px;
  color: #004f68;
  font-family: var(--ff-sans);
  font-size: 12px; font-weight: 800; letter-spacing: 0.07em; text-transform: uppercase;
}
.wh-ministry-card-link::after { content: "→"; transition: transform 0.2s; }
.wh-ministry-card:hover .wh-ministry-card-link::after { transform: translateX(4px); }

/* ═══════════════════════════
   반응형
═══════════════════════════ */
@media (max-width: 1100px) { .wh-ministry-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 980px) { .wolko-partnership-v2__grid { grid-template-columns: 1fr; } }
@media (max-width: 768px) {
  .wh-home-hero { min-height: auto; }
  .wh-home-hero-inner { min-height: 100svh; padding: 120px 20px 100px; }
  .wh-home-hero-title { font-size: clamp(30px, 7.5vw, 38px); }
  .wh-home-hero-desc { font-size: 15px; margin-bottom: 36px; }
  .wh-home-btn { width: 100%; max-width: 280px; min-height: 52px; }
  .wolko-partnership-v2 { padding: 80px 20px 90px; }
  .wolko-partnership-v2__top { margin-bottom: 44px; }
  .wolko-partnership-v2__title { font-size: clamp(28px, 7vw, 36px); }
  .wolko-partnership-v2__subtitle { font-size: 15px; }
  .wolko-partnership-v2__panel { padding: 28px 26px 26px; }
  .wolko-partnership-v2__panel-title { font-size: 18px; }
  .wolko-partnership-v2__text { font-size: 15px; }
  .wolko-partnership-v2__stat-card { padding: 32px 24px 28px; }
  .wolko-partnership-v2__stat-value { font-size: 80px; }
  .wolko-partnership-v2__actions { grid-template-columns: 1fr; }
  .wolko-partnership-v2__video { margin-top: 52px; padding-top: 48px; }
  .wolko-partnership-v2__video-wrap { border-radius: 14px; padding-bottom: 56.25%; }
  .wh-vision-section { padding: 80px 20px; }
  .wh-vision-head { margin-bottom: 44px; }
  .wh-vision-title { font-size: clamp(26px, 6.5vw, 32px); }
  .wh-vision-subtitle { font-size: 15px; }
  .wh-vision-trigger { gap: 16px; padding: 22px 12px 22px 16px; }
  .wh-vision-num { font-size: 18px; min-width: 32px; }
  .wh-vision-label { font-size: 16px; }
  .wh-vision-body p { padding: 4px 12px 28px 52px; font-size: 14px; line-height: 1.9; }
  .wh-vision-item.is-active .wh-vision-body { max-height: 480px; }
  .wh-ministry-section { padding: 80px 20px 90px; }
  .wh-ministry-head { margin-bottom: 36px; }
  .wh-ministry-title { font-size: clamp(26px, 6.5vw, 32px); }
  .wh-ministry-subtitle { font-size: 15px; }
  .wh-ministry-grid { grid-template-columns: 1fr; gap: 12px; }
  .wh-ministry-card { min-height: auto; padding: 28px 22px 24px; border-radius: 16px; }
  .wh-ministry-card-title { font-size: 19px; }
  .wh-ministry-card-text { font-size: 14px; margin-bottom: 16px; }
}
@media (hover: none) {
