---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get mission reports, sorted newest first
let reports: any[] = [];
try {
  reports = (await getCollection('mission_report')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );
} catch (e) {
  // collection may not have entries yet
}

const latestReport = reports[0] ?? null;
---

<BaseLayout
  title="선교보고 — Word of Life Korea"
  description="월코 선교보고 — PDF 소식지를 통해 현장의 이야기를 전합니다"
  activeNav="connect"
>

<style>
  :root {
    --c-deep: #004f68; --c-mid: #0a5b76; --c-light: #73d1f5;
    --c-bg: #f4f8fb; --c-white: #ffffff;
    --c-text: #152028; --c-muted: #5b6b78;
    --c-line: rgba(0,79,104,0.12);
    --r-xl: 28px; --r-lg: 20px;
  }

  /* HERO */
  .hero {
    position:relative; overflow:hidden;
    padding:100px 24px 64px; text-align:center;
    background:linear-gradient(135deg, #083d51 0%, var(--c-deep) 60%, var(--c-mid) 100%);
  }
  .hero::before {
    content:""; position:absolute; inset:0;
    background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);
    background-size:60px 60px; pointer-events:none;
  }
  .hero-inner { position:relative; z-index:2; max-width:760px; margin:0 auto; }
  .hero-eyebrow {
    display:inline-flex; align-items:center; gap:8px; padding:7px 16px; border-radius:999px;
    background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.22);
    font-size:11px; font-weight:800; letter-spacing:0.09em; color:rgba(255,255,255,0.9);
    margin-bottom:22px; text-transform:uppercase;
  }
  .hero-eyebrow-dot { width:6px; height:6px; border-radius:50%; background:var(--c-light); }
  .hero-inner h1 {
    font-size:clamp(32px,5vw,56px); font-weight:800; line-height:1.13;
    letter-spacing:-0.04em; color:#fff; margin-bottom:14px;
  }
  .hero-inner h1 em { font-style:normal; color:#9ae3ff; }
  .hero-sub { font-size:16px; line-height:1.88; color:rgba(255,255,255,0.8); max-width:580px; margin:0 auto; }

  /* Archive row */
  .archive-bar { background:var(--c-bg); border-bottom:1px solid var(--c-line); padding:18px 24px; }
  .archive-inner { max-width:1100px; margin:0 auto; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .archive-label { font-size:12px; font-weight:800; color:var(--c-deep); text-transform:uppercase; letter-spacing:0.06em; margin-right:4px; }
  .archive-btn {
    padding:8px 16px; border-radius:999px; border:1px solid var(--c-line); background:var(--c-white);
    font-size:12.5px; font-weight:700; color:var(--c-muted); cursor:pointer;
    transition:background .18s, border-color .18s, color .18s;
    white-space:nowrap;
  }
  .archive-btn:hover, .archive-btn.active { background:var(--c-deep); border-color:var(--c-deep); color:#fff; }

  /* FLIPBOOK AREA */
  .flipbook-section { padding:48px 24px 80px; background:var(--c-white); }
  .flipbook-wrap { max-width:1100px; margin:0 auto; }

  /* No PDF state */
  .no-pdf {
    text-align:center; padding:80px 24px;
    border:2px dashed var(--c-line); border-radius:var(--r-xl);
    background:var(--c-bg);
  }
  .no-pdf-icon { margin-bottom:16px; display:flex; justify-content:center; opacity:0.6; }
  .no-pdf h3 { font-size:22px; font-weight:800; color:var(--c-text); margin-bottom:10px; }
  .no-pdf p { font-size:15px; color:var(--c-muted); max-width:420px; margin:0 auto; line-height:1.8; }

  /* Report meta */
  .report-meta {
    display:flex; align-items:center; gap:16px; flex-wrap:wrap;
    margin-bottom:28px; padding-bottom:20px; border-bottom:1px solid var(--c-line);
  }
  .report-title { font-size:22px; font-weight:800; color:var(--c-text); flex:1; }
  .report-date { font-size:12px; font-weight:700; color:var(--c-muted); }
  .download-btn {
    display:inline-flex; align-items:center; gap:8px; padding:10px 20px; border-radius:999px;
    background:rgba(0,79,104,0.08); color:var(--c-deep); font-size:13px; font-weight:800;
    text-decoration:none; transition:background .18s; border:1px solid var(--c-line);
    white-space:nowrap;
  }
  .download-btn:hover { background:rgba(0,79,104,0.16); }

  /* Flipbook container */
  #flipbook-container {
    position:relative; width:100%; background:#f5f2ee;
    border-radius:var(--r-xl); overflow:hidden;
    box-shadow:0 8px 32px rgba(0,0,0,0.10), 0 1px 4px rgba(0,0,0,0.06);
    min-height:360px;
    display:flex; flex-direction:column;
    border:1px solid rgba(0,0,0,0.07);
  }

  /* Controls bar */
  .fb-controls {
    display:flex; align-items:center; justify-content:space-between;
    padding:10px 16px; background:rgba(0,0,0,0.03);
    border-bottom:1px solid rgba(0,0,0,0.07); gap:10px; flex-wrap:wrap;
  }
  .fb-nav { display:flex; align-items:center; gap:6px; }
  .fb-btn {
    width:34px; height:34px; border-radius:8px; border:1px solid rgba(0,0,0,0.11);
    background:rgba(255,255,255,0.7); color:var(--c-text); cursor:pointer; display:flex;
    align-items:center; justify-content:center;
    transition:background .18s; user-select:none;
  }
  .fb-btn svg { display:block; }
  .fb-btn:hover { background:#fff; border-color:rgba(0,0,0,0.18); }
  .fb-btn:disabled { opacity:0.3; cursor:default; }
  .fb-page-info {
    font-size:12px; font-weight:700; color:var(--c-muted);
    min-width:72px; text-align:center; padding:0 4px;
  }
  .fb-right { display:flex; align-items:center; gap:6px; }
  .fb-zoom-btns { display:flex; gap:4px; }
  .fb-zoom-btn {
    width:34px; height:34px; border-radius:8px; border:1px solid rgba(0,0,0,0.11);
    background:rgba(255,255,255,0.7); color:var(--c-text); cursor:pointer;
    font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center;
    transition:background .18s;
  }
  .fb-zoom-btn:hover { background:#fff; border-color:rgba(0,0,0,0.18); }
  .fb-fullscreen-btn {
    width:34px; height:34px; border-radius:8px; border:1px solid rgba(0,0,0,0.11);
    background:rgba(255,255,255,0.7); color:var(--c-text); cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    transition:background .18s;
  }
  .fb-fullscreen-btn:hover { background:#fff; border-color:rgba(0,0,0,0.18); }
  .fb-fullscreen-btn svg, .fb-zoom-btn svg { display:block; }

  /* Flipbook viewport */
  #spread-viewport {
    flex:1; display:flex; align-items:center; justify-content:center;
    padding:20px 16px; min-height:320px; position:relative; overflow:hidden;
    touch-action: none;
    background: #f5f2ee;
  }

  /* Side arrow buttons */
  .fb-arrow-btn {
    position: absolute;
    top: 50%; transform: translateY(-50%);
    width: 36px; height: 64px;
    background: rgba(255,255,255,0.82);
    border: 1px solid rgba(0,0,0,0.09);
    border-radius: 8px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    z-index: 20;
    color: var(--c-text);
    opacity: 0.45;
    transition: opacity 0.18s, background 0.18s, transform 0.18s;
    backdrop-filter: blur(4px);
  }
  .fb-arrow-btn:hover:not(:disabled) {
    opacity: 1; background: #fff;
    transform: translateY(-50%) scale(1.07);
  }
  .fb-arrow-btn:disabled { opacity: 0.12; cursor: default; }
  #fb-arrow-prev { left: 10px; }
  #fb-arrow-next { right: 10px; }
  @media (max-width: 768px) { .fb-arrow-btn { display: none; } }

  .fb-loading-indicator {
    position:absolute; inset:0; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:14px; color:var(--c-muted);
    font-size:13px; font-weight:600; text-align:center;
  }
  .fb-spinner {
    width:36px; height:36px; border:3px solid rgba(0,0,0,0.10);
    border-top-color:var(--c-deep); border-radius:50%; animation:spin .8s linear infinite;
  }
  @keyframes spin { to { transform:rotate(360deg); } }

  /* Spread viewer */
  #flip-book {
    width:100%; height:100%;
    transition: opacity 0.18s ease;
  }
  /* spread-fade-out는 JS로 동적 추가 → :global */
  :global(#flip-book.spread-fade-out) { opacity: 0; }

  /* JS로 동적 생성한 요소 → Astro 스코프 적용 안 됨 → :global() 필수 */
  :global(.spread-img) {
    display: block;
    width: auto;
    height: auto;
    max-height: var(--page-maxh, 40vh);
    user-select: none;
    -webkit-user-drag: none;
    flex-shrink: 1;
    transition: max-height 0.2s ease;
  }
  :global(.spread-img-left) {
    max-width: 50%;
    box-shadow: -3px 0 16px rgba(0,0,0,0.14), inset -6px 0 14px rgba(0,0,0,0.05);
    border-radius: 2px 0 0 2px;
    border: 1px solid rgba(0,0,0,0.07);
    border-right: none;
  }
  :global(.spread-img-right) {
    max-width: 50%;
    box-shadow: 3px 0 16px rgba(0,0,0,0.14), inset 6px 0 14px rgba(0,0,0,0.05);
    border-radius: 0 2px 2px 0;
    border: 1px solid rgba(0,0,0,0.07);
    border-left: none;
  }
  :global(.spread-img-cover) {
    max-width: 48%;
    box-shadow: 0 6px 32px rgba(0,0,0,0.18), 0 2px 6px rgba(0,0,0,0.10);
    border-radius: 2px;
    border: 1px solid rgba(0,0,0,0.07);
  }

  /* Archive list */
  .archive-section { padding:56px 24px 80px; background:var(--c-bg); }
  .archive-grid { max-width:1100px; margin:0 auto; }
  .archive-grid-title { font-size:18px; font-weight:800; color:var(--c-text); margin-bottom:24px; }
  .archive-list { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; }
  .archive-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-lg);
    padding:22px 20px; cursor:pointer; transition:transform .2s, box-shadow .2s, border-color .2s;
    display:flex; flex-direction:column; gap:8px;
  }
  .archive-card:hover { transform:translateY(-3px); box-shadow:0 8px 28px rgba(0,79,104,0.12); border-color:rgba(0,79,104,0.22); }
  .archive-card.current { border-color:var(--c-deep); background:rgba(0,79,104,0.04); }
  .ac-icon { font-size:28px; }
  .ac-title { font-size:14px; font-weight:800; color:var(--c-text); line-height:1.3; }
  .ac-date { font-size:12px; color:var(--c-muted); }
  .ac-badge {
    display:inline-block; padding:3px 10px; border-radius:999px;
    background:rgba(0,79,104,0.08); color:var(--c-deep); font-size:11px; font-weight:800;
    width:fit-content;
  }

  @media (max-width:768px) {
    .fb-controls { padding:10px 14px; }
    .fb-fullscreen-btn, .fb-zoom-btns { display:none; }
  }
</style>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">
      <span class="hero-eyebrow-dot"></span>
      <span class="wl-ko">월코 선교보고</span>
      <span class="wl-en">WOLKO Mission Report</span>
    </div>
    <h1>
      <span class="wl-ko">현장의 이야기를 <em>전합니다</em></span>
      <span class="wl-en">Stories from <em>the Field</em></span>
    </h1>
    <p class="hero-sub">
      <span class="wl-ko">월코 선교사들이 전하는 복음의 현장 이야기를 담은 소식지입니다. 기도와 후원으로 함께해 주시는 분들께 감사드립니다.</span>
      <span class="wl-en">A newsletter sharing stories from the Gospel frontlines by WOLKO missionaries. Thank you to all who partner with us through prayer and support.</span>
    </p>
  </div>
</section>

<!-- FLIPBOOK -->
<section class="flipbook-section">
  <div class="flipbook-wrap">
    {latestReport ? (
      <>
        <div class="report-meta">
          <div>
            <div class="report-title">
              <span class="wl-ko">{latestReport.data.title_ko}</span>
              <span class="wl-en">{latestReport.data.title_en}</span>
            </div>
            <div class="report-date">
              {new Date(latestReport.data.date).toLocaleDateString('ko-KR', { year:'numeric', month:'long' })}
            </div>
          </div>
          <a href={latestReport.data.pdf_url} target="_blank" rel="noopener" class="download-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v7M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="wl-ko">PDF 다운로드</span><span class="wl-en">Download PDF</span>
          </a>
        </div>

        <div id="flipbook-container" data-pdf={latestReport.data.pdf_url}>
          <div class="fb-controls">
            <div class="fb-nav">
              <button class="fb-btn" id="fb-first" title="처음 페이지">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 2v10M5 7l5-4v8L5 7z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="fb-btn" id="fb-prev" title="이전 페이지">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 11L4 7l5-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <span class="fb-page-info" id="fb-page-info">1 / —</span>
              <button class="fb-btn" id="fb-next" title="다음 페이지">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 3l5 4-5 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="fb-btn" id="fb-last" title="마지막 페이지">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M11 2v10M9 7L4 3v8l5-4z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="fb-right">
              <div class="fb-zoom-btns">
                <button class="fb-zoom-btn" id="fb-zoom-out" title="축소">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </button>
                <button class="fb-zoom-btn" id="fb-zoom-in" title="확대">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </button>
              </div>
              <button class="fb-fullscreen-btn" id="fb-fullscreen" title="전체화면">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5V2h3M9 2h3v3M12 9v3H9M5 12H2V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>
          <div id="spread-viewport">
            <button class="fb-arrow-btn" id="fb-arrow-prev" title="이전 페이지" disabled>
              <svg width="12" height="20" viewBox="0 0 12 20" fill="none"><path d="M10 2L2 10l8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <button class="fb-arrow-btn" id="fb-arrow-next" title="다음 페이지" disabled>
              <svg width="12" height="20" viewBox="0 0 12 20" fill="none"><path d="M2 2l8 8-8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div id="fb-loading" class="fb-loading-indicator">
              <div class="fb-spinner"></div>
              <span id="fb-loading-text">
                <span class="wl-ko">PDF를 불러오는 중입니다...</span>
                <span class="wl-en">Loading PDF...</span>
              </span>
            </div>
            <div id="flip-book"></div>
          </div>
        </div>
      </>
    ) : (
      <div class="no-pdf">
        <div class="no-pdf-icon">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><rect x="10" y="6" width="28" height="36" rx="4" stroke="#004f68" stroke-width="2"/><path d="M18 18h12M18 24h12M18 30h8" stroke="#004f68" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h3><span class="wl-ko">선교보고 소식지 준비 중</span><span class="wl-en">Mission Report Coming Soon</span></h3>
        <p><span class="wl-ko">월코 선교보고 소식지가 곧 업로드됩니다. 기도와 관심으로 함께해 주셔서 감사합니다.</span><span class="wl-en">The WOLKO mission report newsletter will be uploaded soon. Thank you for your prayers and support.</span></p>
      </div>
    )}
  </div>
</section>

{/* Archive */}
{reports.length > 1 && (
  <section class="archive-section">
    <div class="archive-grid">
      <div class="archive-grid-title">
        <span class="wl-ko">지난 선교보고 보기</span>
        <span class="wl-en">Previous Reports</span>
      </div>
      <div class="archive-list" id="archive-list">
        {reports.map((r, i) => (
          <div
            class={`archive-card${i === 0 ? ' current' : ''}`}
            data-pdf={r.data.pdf_url}
            data-title-ko={r.data.title_ko}
            data-title-en={r.data.title_en}
            data-date={r.data.date}
          >
            <div class="ac-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="5" y="4" width="18" height="22" rx="3" stroke="#004f68" stroke-width="1.6"/><path d="M10 11h8M10 15h8M10 19h5" stroke="#004f68" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <div class="ac-title">
              <span class="wl-ko">{r.data.title_ko}</span>
              <span class="wl-en">{r.data.title_en}</span>
            </div>
            <div class="ac-date">{new Date(r.data.date).toLocaleDateString('ko-KR', { year:'numeric', month:'long' })}</div>
            {i === 0 && <span class="ac-badge"><span class="wl-ko">최신</span><span class="wl-en">Latest</span></span>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script is:inline>
(function () {
  var container = document.getElementById('flipbook-container');
  if (!container) return;

  var PDFJS_SRC    = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
  var PDFJS_WORKER = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  var DB_NAME      = 'wolko-pdf-v4';
  var STORE_NAME   = 'pages';
  var isMobile     = window.innerWidth < 768;
  var SCALE        = isMobile ? 2.0 : 3.0;  /* 렌더 품질: 고정, 변경 불가 */
  var displayVh    = 80;                     /* 데스크탑 표시 높이 (vh), CSS만 변경 */

  var loadingEl  = document.getElementById('fb-loading');
  var flipBookEl = document.getElementById('flip-book');
  var pageInfo   = document.getElementById('fb-page-info');

  /* ── Mobile state ── */
  var mobilePages = [];
  var mobilePage  = 0;

  /* ── Desktop spread state ── */
  var allPages     = [];
  var spreadIdx    = 0;
  var totalSpreads = 0;

  /* ── Helpers ── */
  function loadScript(src) {
    return new Promise(function (res, rej) {
      var s = document.createElement('script');
      s.src = src; s.onload = res; s.onerror = rej;
      document.head.appendChild(s);
    });
  }
  function showSpinner() {
    loadingEl.style.display = 'flex';
    flipBookEl.style.display = 'none';
  }
  function showError(msg) {
    loadingEl.innerHTML = '<span style="color:#f87171;text-align:center;padding:0 20px;">' + msg + '</span>';
  }

  /* ── IndexedDB cache ── */
  function openDB() {
    return new Promise(function (res, rej) {
      var req = indexedDB.open(DB_NAME, 1);
      req.onupgradeneeded = function (e) {
        e.target.result.createObjectStore(STORE_NAME, { keyPath: 'key' });
      };
      req.onsuccess = function (e) { res(e.target.result); };
      req.onerror   = function () { rej(null); };
    });
  }
  function getCache(db, key) {
    return new Promise(function (res) {
      try {
        var tx  = db.transaction(STORE_NAME, 'readonly');
        var req = tx.objectStore(STORE_NAME).get(key);
        req.onsuccess = function () { res(req.result || null); };
        req.onerror   = function () { res(null); };
      } catch(e) { res(null); }
    });
  }
  function setCache(db, key, data) {
    try {
      var tx = db.transaction(STORE_NAME, 'readwrite');
      tx.objectStore(STORE_NAME).put({ key: key, data: data, ts: Date.now() });
    } catch(e) {}
  }

  /* ── PDF render ── */
  function renderPage(pdfDoc, pageNum) {
    return pdfDoc.getPage(pageNum).then(function (page) {
      var vp = page.getViewport({ scale: SCALE });
      var c  = document.createElement('canvas');
      c.width = vp.width; c.height = vp.height;
      var ctx = c.getContext('2d', { alpha: false });
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, c.width, c.height);
      return page.render({
        canvasContext: ctx,
        viewport: vp,
        intent: 'print',
      }).promise.then(function () {
        return { url: c.toDataURL('image/png'), w: vp.width, h: vp.height };
      });
    });
  }

  /* ── Mobile: simple single-page viewer ── */
  function buildMobileViewer(pages) {
    mobilePages = pages;
    mobilePage  = 0;
    flipBookEl.innerHTML = '';
    flipBookEl.style.cssText = 'display:flex;align-items:center;justify-content:center;width:100%;';

    var img = document.createElement('img');
    img.id = 'mob-page-img';
    img.style.cssText = 'max-width:100%;height:auto;display:block;border-radius:8px;box-shadow:0 4px 24px rgba(0,0,0,0.45);user-select:none;-webkit-user-drag:none;';
    img.draggable = false;
    img.src = pages[0].url;
    flipBookEl.appendChild(img);

    updateMobileNav();
    loadingEl.style.display = 'none';
    flipBookEl.style.display = 'flex';
  }

  function updateMobileNav() {
    var tot = mobilePages.length;
    pageInfo.textContent = (mobilePage + 1) + ' / ' + tot;
    document.getElementById('fb-prev').disabled  = mobilePage === 0;
    document.getElementById('fb-first').disabled = mobilePage === 0;
    document.getElementById('fb-next').disabled  = mobilePage >= tot - 1;
    document.getElementById('fb-last').disabled  = mobilePage >= tot - 1;
  }

  function goMobilePage(i) {
    if (i < 0 || i >= mobilePages.length) return;
    mobilePage = i;
    var img = document.getElementById('mob-page-img');
    if (img) img.src = mobilePages[i].url;
    updateMobileNav();
  }

  /* ──────────────────────────────────────────
     DESKTOP: two-page spread <img> viewer
     Spread 0 = cover (single, centred)
     Spread k = pages [2k-1, 2k]
  ────────────────────────────────────────── */
  function buildDesktopViewer(pages) {
    allPages     = pages;
    spreadIdx    = 0;
    totalSpreads = 1 + Math.ceil((pages.length - 1) / 2);

    flipBookEl.innerHTML = '';
    flipBookEl.style.cssText = 'display:flex;align-items:center;justify-content:center;width:100%;height:100%;';

    var li = document.createElement('img');
    li.id = 'desk-left'; li.className = 'spread-img'; li.draggable = false;
    var ri = document.createElement('img');
    ri.id = 'desk-right'; ri.className = 'spread-img'; ri.draggable = false;

    flipBookEl.appendChild(li);
    flipBookEl.appendChild(ri);

    applySpreadImages();
    loadingEl.style.display = 'none';
    flipBookEl.style.display = 'flex';
  }

  function applySpreadImages() {
    var li = document.getElementById('desk-left');
    var ri = document.getElementById('desk-right');
    if (!li || !ri) return;

    if (spreadIdx === 0) {
      li.style.display = 'none';
      ri.className = 'spread-img spread-img-cover';
      ri.src = allPages[0].url;
      ri.style.display = 'block';
    } else {
      var leftIdx  = spreadIdx * 2 - 1;
      var rightIdx = spreadIdx * 2;
      li.className = 'spread-img spread-img-left';
      ri.className = 'spread-img spread-img-right';
      if (leftIdx < allPages.length) {
        li.src = allPages[leftIdx].url; li.style.display = 'block';
      } else { li.style.display = 'none'; }
      if (rightIdx < allPages.length) {
        ri.src = allPages[rightIdx].url; ri.style.display = 'block';
      } else { ri.style.display = 'none'; }
    }
    updateDesktopNav();
  }

  function updateDesktopNav() {
    var fp = spreadIdx === 0 ? 1 : spreadIdx * 2;
    var lp = spreadIdx === 0 ? 1 : Math.min(spreadIdx * 2 + 1, allPages.length);
    pageInfo.textContent = fp + (lp > fp ? '–' + lp : '') + ' / ' + allPages.length;
    var atFirst = spreadIdx === 0;
    var atLast  = spreadIdx >= totalSpreads - 1;
    document.getElementById('fb-prev').disabled  = atFirst;
    document.getElementById('fb-first').disabled = atFirst;
    document.getElementById('fb-next').disabled  = atLast;
    document.getElementById('fb-last').disabled  = atLast;
    document.getElementById('fb-arrow-prev').disabled = atFirst;
    document.getElementById('fb-arrow-next').disabled = atLast;
  }

  function goDesktopSpread(idx) {
    if (idx < 0 || idx >= totalSpreads || idx === spreadIdx) return;
    spreadIdx = idx;
    flipBookEl.classList.add('spread-fade-out');
    setTimeout(function () {
      applySpreadImages();
      flipBookEl.classList.remove('spread-fade-out');
    }, 160);
  }

  /* ── Unified build & navigation ── */
  function buildViewer(pages) {
    if (isMobile) buildMobileViewer(pages);
    else buildDesktopViewer(pages);
  }
  function navigatePrev()  { isMobile ? goMobilePage(mobilePage - 1)         : goDesktopSpread(spreadIdx - 1); }
  function navigateNext()  { isMobile ? goMobilePage(mobilePage + 1)         : goDesktopSpread(spreadIdx + 1); }
  function navigateFirst() { isMobile ? goMobilePage(0)                      : goDesktopSpread(0); }
  function navigateLast()  { isMobile ? goMobilePage(mobilePages.length - 1) : goDesktopSpread(totalSpreads - 1); }

  /* ── Main load (cache-first) ── */
  var db = null;
  function loadPdf(pdfUrl) {
    showSpinner();
    var cacheKey = pdfUrl + '@' + SCALE.toFixed(1);

    return (db ? Promise.resolve(db) : openDB().then(function (d) { db = d; return d; }))
      .catch(function () { return null; })
      .then(function (database) {
        if (!database) return renderAndBuild(pdfUrl, null, cacheKey);
        return getCache(database, cacheKey).then(function (hit) {
          if (hit && hit.data && hit.data.length) {
            buildViewer(hit.data); return;
          }
          return renderAndBuild(pdfUrl, database, cacheKey);
        });
      }).catch(function (err) {
        console.error(err);
        showError('PDF를 불러오지 못했습니다.<br>' + (err && err.message ? err.message : ''));
      });
  }

  function renderAndBuild(pdfUrl, database, cacheKey) {
    return pdfjsLib.getDocument(pdfUrl).promise.then(function (pdfDoc) {
      var n = pdfDoc.numPages;
      var pages = [];
      function next(i) {
        if (i > n) return Promise.resolve();
        return renderPage(pdfDoc, i).then(function (p) {
          pages.push(p);
          return next(i + 1);
        });
      }
      return next(1).then(function () {
        if (database) setCache(database, cacheKey, pages);
        buildViewer(pages);
      });
    });
  }

  /* ── Bootstrap (PDF.js only — StPageFlip removed) ── */
  loadScript(PDFJS_SRC).then(function () {
    pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER;
    var url = container.dataset.pdf
      || ((document.querySelector('.archive-card[data-pdf]') || {}).dataset || {}).pdf;
    if (url) loadPdf(url);
  }).catch(function (err) {
    showError('뷰어를 불러오지 못했습니다.<br>' + (err || ''));
  });

  /* ── Navigation buttons ── */
  document.getElementById('fb-prev').addEventListener('click',       navigatePrev);
  document.getElementById('fb-next').addEventListener('click',       navigateNext);
  document.getElementById('fb-first').addEventListener('click',      navigateFirst);
  document.getElementById('fb-last').addEventListener('click',       navigateLast);
  document.getElementById('fb-arrow-prev').addEventListener('click', navigatePrev);
  document.getElementById('fb-arrow-next').addEventListener('click', navigateNext);

  document.getElementById('fb-fullscreen').addEventListener('click', function () {
    if (document.fullscreenElement) document.exitFullscreen();
    else if (container.requestFullscreen) container.requestFullscreen();
  });

  /* Zoom = CSS display size only, SCALE(품질)은 고정 — 재렌더링 없음 */
  function applyDisplayZoom() {
    container.style.setProperty('--page-maxh', displayVh + 'vh');
    document.getElementById('fb-zoom-in').disabled  = displayVh >= 82;
    document.getElementById('fb-zoom-out').disabled = displayVh <= 30;
  }
  if (!isMobile) applyDisplayZoom();

  document.getElementById('fb-zoom-in').addEventListener('click', function () {
    displayVh = Math.min(displayVh + 10, 82);
    applyDisplayZoom();
  });
  document.getElementById('fb-zoom-out').addEventListener('click', function () {
    displayVh = Math.max(displayVh - 10, 30);
    applyDisplayZoom();
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') navigateNext();
    else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') navigatePrev();
  });

  /* ── Archive cards ── */
  document.querySelectorAll('.archive-card[data-pdf]').forEach(function (card) {
    card.addEventListener('click', function () {
      document.querySelectorAll('.archive-card').forEach(function (c) { c.classList.remove('current'); });
      card.classList.add('current');
      var url = card.dataset.pdf;
      if (url) {
        container.dataset.pdf = url;
        loadPdf(url).then(function () {
          container.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    });
  });

  /* ── Pinch zoom + pan + swipe navigation ── */
  (function () {
    var vp        = document.getElementById('spread-viewport');
    var inner     = document.getElementById('flip-book');
    var czoom     = 1;
    var lastZoom  = 1;
    var tx = 0, ty = 0;
    var ltx = 0, lty = 0;
    var startDist = 0;
    var midX = 0, midY = 0;
    var panStart   = { x: 0, y: 0 };
    var swipeStartX = 0;
    var isPinching = false;

    function dist(t) {
      var dx = t[0].clientX - t[1].clientX;
      var dy = t[0].clientY - t[1].clientY;
      return Math.sqrt(dx*dx + dy*dy);
    }
    function mid(t) {
      return { x: (t[0].clientX + t[1].clientX) / 2,
               y: (t[0].clientY + t[1].clientY) / 2 };
    }
    function clamp(v, lo, hi) { return Math.max(lo, Math.min(hi, v)); }

    function applyTransform() {
      inner.style.transformOrigin = '0 0';
      inner.style.transform = 'translate(' + tx + 'px,' + ty + 'px) scale(' + czoom + ')';
    }
    function resetTransform() {
      czoom = 1; lastZoom = 1; tx = 0; ty = 0; ltx = 0; lty = 0;
      inner.style.transform = '';
      inner.style.transformOrigin = '';
    }

    vp.addEventListener('touchstart', function (e) {
      if (e.touches.length === 2) {
        isPinching = true;
        e.preventDefault();
        startDist = dist(e.touches);
        var m = mid(e.touches);
        var r = vp.getBoundingClientRect();
        midX = m.x - r.left;
        midY = m.y - r.top;
      } else if (e.touches.length === 1) {
        swipeStartX = e.touches[0].clientX;
        if (czoom > 1.05) {
          panStart.x = e.touches[0].clientX - ltx;
          panStart.y = e.touches[0].clientY - lty;
        }
      }
    }, { passive: false });

    vp.addEventListener('touchmove', function (e) {
      if (e.touches.length === 2 && isPinching) {
        e.preventDefault();
        var d = dist(e.touches);
        var newZoom = clamp(lastZoom * (d / startDist), 1, 5);
        tx = midX - (midX - ltx) * (newZoom / lastZoom);
        ty = midY - (midY - lty) * (newZoom / lastZoom);
        var maxTx = vp.clientWidth  * (newZoom - 1);
        var maxTy = vp.clientHeight * (newZoom - 1);
        tx = clamp(tx, -maxTx, 0);
        ty = clamp(ty, -maxTy, 0);
        czoom = newZoom;
        applyTransform();
      } else if (e.touches.length === 1 && czoom > 1.05 && !isPinching) {
        e.preventDefault();
        var newTx = e.touches[0].clientX - panStart.x;
        var newTy = e.touches[0].clientY - panStart.y;
        var maxTx2 = vp.clientWidth  * (czoom - 1);
        var maxTy2 = vp.clientHeight * (czoom - 1);
        tx = clamp(newTx, -maxTx2, 0);
        ty = clamp(newTy, -maxTy2, 0);
        applyTransform();
      }
    }, { passive: false });

    var lastTap = 0;
    vp.addEventListener('touchend', function (e) {
      if (e.touches.length < 2) {
        var wasPinching = isPinching;
        isPinching = false;
        lastZoom = czoom;
        ltx = tx; lty = ty;
        if (czoom < 1.05) resetTransform();

        /* Swipe page navigation (mobile, not zoomed, not after pinch) */
        if (isMobile && !wasPinching && czoom <= 1.05 && e.changedTouches.length === 1) {
          var deltaX = e.changedTouches[0].clientX - swipeStartX;
          if (Math.abs(deltaX) > 50) {
            if (deltaX < 0) navigateNext();
            else navigatePrev();
            return;
          }
        }
      }

      /* Double-tap to reset zoom */
      if (e.changedTouches.length === 1) {
        var now = Date.now();
        if (now - lastTap < 300) resetTransform();
        lastTap = now;
      }
    });
  })();
})();
</script>

</BaseLayout>
