---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Get mission reports, sorted newest first
let reports: any[] = [];
try {
  reports = (await getCollection('mission_report')).sort(
    (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
  );
} catch (e) {
  // collection may not have entries yet
}

const latestReport = reports[0] ?? null;
---

<BaseLayout
  title="선교보고 — Word of Life Korea"
  description="월코 선교보고 — PDF 소식지를 통해 현장의 이야기를 전합니다"
  activeNav="connect"
>

<style>
  :root {
    --c-deep: #004f68; --c-mid: #0a5b76; --c-light: #73d1f5;
    --c-bg: #f4f8fb; --c-white: #ffffff;
    --c-text: #152028; --c-muted: #5b6b78;
    --c-line: rgba(0,79,104,0.12);
    --r-xl: 28px; --r-lg: 20px;
  }

  /* HERO */
  .hero {
    position:relative; overflow:hidden;
    padding:100px 24px 64px; text-align:center;
    background:linear-gradient(135deg, #083d51 0%, var(--c-deep) 60%, var(--c-mid) 100%);
  }
  .hero::before {
    content:""; position:absolute; inset:0;
    background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);
    background-size:60px 60px; pointer-events:none;
  }
  .hero-inner { position:relative; z-index:2; max-width:760px; margin:0 auto; }
  .hero-eyebrow {
    display:inline-flex; align-items:center; gap:8px; padding:7px 16px; border-radius:999px;
    background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.22);
    font-size:11px; font-weight:800; letter-spacing:0.09em; color:rgba(255,255,255,0.9);
    margin-bottom:22px; text-transform:uppercase;
  }
  .hero-eyebrow-dot { width:6px; height:6px; border-radius:50%; background:var(--c-light); }
  .hero-inner h1 {
    font-size:clamp(32px,5vw,56px); font-weight:800; line-height:1.13;
    letter-spacing:-0.04em; color:#fff; margin-bottom:14px;
  }
  .hero-inner h1 em { font-style:normal; color:#9ae3ff; }
  .hero-sub { font-size:16px; line-height:1.88; color:rgba(255,255,255,0.8); max-width:580px; margin:0 auto; }

  /* Archive row */
  .archive-bar { background:var(--c-bg); border-bottom:1px solid var(--c-line); padding:18px 24px; }
  .archive-inner { max-width:1100px; margin:0 auto; display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
  .archive-label { font-size:12px; font-weight:800; color:var(--c-deep); text-transform:uppercase; letter-spacing:0.06em; margin-right:4px; }
  .archive-btn {
    padding:8px 16px; border-radius:999px; border:1px solid var(--c-line); background:var(--c-white);
    font-size:12.5px; font-weight:700; color:var(--c-muted); cursor:pointer;
    transition:background .18s, border-color .18s, color .18s;
    white-space:nowrap;
  }
  .archive-btn:hover, .archive-btn.active { background:var(--c-deep); border-color:var(--c-deep); color:#fff; }

  /* FLIPBOOK AREA */
  .flipbook-section { padding:48px 24px 80px; background:var(--c-white); }
  .flipbook-wrap { max-width:1100px; margin:0 auto; }

  /* No PDF state */
  .no-pdf {
    text-align:center; padding:80px 24px;
    border:2px dashed var(--c-line); border-radius:var(--r-xl);
    background:var(--c-bg);
  }
  .no-pdf-icon { margin-bottom:16px; display:flex; justify-content:center; opacity:0.6; }
  .no-pdf h3 { font-size:22px; font-weight:800; color:var(--c-text); margin-bottom:10px; }
  .no-pdf p { font-size:15px; color:var(--c-muted); max-width:420px; margin:0 auto; line-height:1.8; }

  /* Report meta */
  .report-meta {
    display:flex; align-items:center; gap:16px; flex-wrap:wrap;
    margin-bottom:28px; padding-bottom:20px; border-bottom:1px solid var(--c-line);
  }
  .report-title { font-size:22px; font-weight:800; color:var(--c-text); flex:1; }
  .report-date { font-size:12px; font-weight:700; color:var(--c-muted); }
  .download-btn {
    display:inline-flex; align-items:center; gap:8px; padding:10px 20px; border-radius:999px;
    background:rgba(0,79,104,0.08); color:var(--c-deep); font-size:13px; font-weight:800;
    text-decoration:none; transition:background .18s; border:1px solid var(--c-line);
    white-space:nowrap;
  }
  .download-btn:hover { background:rgba(0,79,104,0.16); }

  /* Flipbook container */
  #flipbook-container {
    position:relative; width:100%; background:#1a1a2e;
    border-radius:var(--r-xl); overflow:hidden;
    box-shadow:0 20px 60px rgba(0,0,0,0.28);
    min-height:500px;
    display:flex; flex-direction:column;
  }

  /* Controls bar */
  .fb-controls {
    display:flex; align-items:center; justify-content:space-between;
    padding:10px 16px; background:rgba(255,255,255,0.06);
    border-bottom:1px solid rgba(255,255,255,0.08); gap:10px; flex-wrap:wrap;
  }
  .fb-nav { display:flex; align-items:center; gap:6px; }
  .fb-btn {
    width:34px; height:34px; border-radius:8px; border:1px solid rgba(255,255,255,0.15);
    background:rgba(255,255,255,0.07); color:#fff; cursor:pointer; display:flex;
    align-items:center; justify-content:center;
    transition:background .18s; user-select:none;
  }
  .fb-btn svg { display:block; }
  .fb-btn:hover { background:rgba(255,255,255,0.16); }
  .fb-btn:disabled { opacity:0.28; cursor:default; }
  .fb-page-info {
    font-size:12px; font-weight:700; color:rgba(255,255,255,0.55);
    min-width:72px; text-align:center; padding:0 4px;
  }
  .fb-right { display:flex; align-items:center; gap:6px; }
  .fb-zoom-btns { display:flex; gap:4px; }
  .fb-zoom-btn {
    width:34px; height:34px; border-radius:8px; border:1px solid rgba(255,255,255,0.15);
    background:rgba(255,255,255,0.07); color:rgba(255,255,255,0.8); cursor:pointer;
    font-size:15px; font-weight:700; display:flex; align-items:center; justify-content:center;
    transition:background .18s;
  }
  .fb-zoom-btn:hover { background:rgba(255,255,255,0.16); }
  .fb-fullscreen-btn {
    width:34px; height:34px; border-radius:8px; border:1px solid rgba(255,255,255,0.15);
    background:rgba(255,255,255,0.07); color:rgba(255,255,255,0.8); cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    transition:background .18s;
  }
  .fb-fullscreen-btn:hover { background:rgba(255,255,255,0.16); }
  .fb-fullscreen-btn svg, .fb-zoom-btn svg { display:block; }

  /* Flipbook viewport */
  #spread-viewport {
    flex:1; display:flex; align-items:center; justify-content:center;
    padding:24px 16px; min-height:520px; position:relative; overflow:hidden;
  }

  .fb-loading-indicator {
    position:absolute; inset:0; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:14px; color:rgba(255,255,255,0.5);
    font-size:13px; font-weight:600; text-align:center;
  }
  .fb-spinner {
    width:36px; height:36px; border:3px solid rgba(255,255,255,0.15);
    border-top-color:var(--c-light); border-radius:50%; animation:spin .8s linear infinite;
  }
  @keyframes spin { to { transform:rotate(360deg); } }

  /* StPageFlip container */
  #flip-book {
    width:100%; height:100%;
  }
  /* Shadow fix for dark bg */
  .stf__parent { background:transparent !important; }
  .stf__block { box-shadow: -4px 0 20px rgba(0,0,0,0.5), 4px 0 20px rgba(0,0,0,0.5); }

  /* Archive list */
  .archive-section { padding:56px 24px 80px; background:var(--c-bg); }
  .archive-grid { max-width:1100px; margin:0 auto; }
  .archive-grid-title { font-size:18px; font-weight:800; color:var(--c-text); margin-bottom:24px; }
  .archive-list { display:grid; grid-template-columns:repeat(auto-fill,minmax(220px,1fr)); gap:16px; }
  .archive-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-lg);
    padding:22px 20px; cursor:pointer; transition:transform .2s, box-shadow .2s, border-color .2s;
    display:flex; flex-direction:column; gap:8px;
  }
  .archive-card:hover { transform:translateY(-3px); box-shadow:0 8px 28px rgba(0,79,104,0.12); border-color:rgba(0,79,104,0.22); }
  .archive-card.current { border-color:var(--c-deep); background:rgba(0,79,104,0.04); }
  .ac-icon { font-size:28px; }
  .ac-title { font-size:14px; font-weight:800; color:var(--c-text); line-height:1.3; }
  .ac-date { font-size:12px; color:var(--c-muted); }
  .ac-badge {
    display:inline-block; padding:3px 10px; border-radius:999px;
    background:rgba(0,79,104,0.08); color:var(--c-deep); font-size:11px; font-weight:800;
    width:fit-content;
  }

  @media (max-width:640px) {
    .fb-controls { padding:10px 14px; }
    .fb-fullscreen-btn, .fb-zoom-btns { display:none; }
  }
</style>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">
      <span class="hero-eyebrow-dot"></span>
      <span class="wl-ko">월코 선교보고</span>
      <span class="wl-en">WOLKO Mission Report</span>
    </div>
    <h1>
      <span class="wl-ko">현장의 이야기를 <em>전합니다</em></span>
      <span class="wl-en">Stories from <em>the Field</em></span>
    </h1>
    <p class="hero-sub">
      <span class="wl-ko">월코 선교사들이 전하는 복음의 현장 이야기를 담은 소식지입니다. 기도와 후원으로 함께해 주시는 분들께 감사드립니다.</span>
      <span class="wl-en">A newsletter sharing stories from the Gospel frontlines by WOLKO missionaries. Thank you to all who partner with us through prayer and support.</span>
    </p>
  </div>
</section>

<!-- FLIPBOOK -->
<section class="flipbook-section">
  <div class="flipbook-wrap">
    {latestReport ? (
      <>
        <div class="report-meta">
          <div>
            <div class="report-title">
              <span class="wl-ko">{latestReport.data.title_ko}</span>
              <span class="wl-en">{latestReport.data.title_en}</span>
            </div>
            <div class="report-date">
              {new Date(latestReport.data.date).toLocaleDateString('ko-KR', { year:'numeric', month:'long' })}
            </div>
          </div>
          <a href={latestReport.data.pdf_url} target="_blank" rel="noopener" class="download-btn">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v7M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="wl-ko">PDF 다운로드</span><span class="wl-en">Download PDF</span>
          </a>
        </div>

        <div id="flipbook-container" data-pdf={latestReport.data.pdf_url}>
          <div class="fb-controls">
            <div class="fb-nav">
              <button class="fb-btn" id="fb-first" title="처음 페이지">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 2v10M5 7l5-4v8L5 7z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="fb-btn" id="fb-prev" title="이전 페이지">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 11L4 7l5-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <span class="fb-page-info" id="fb-page-info">1 / —</span>
              <button class="fb-btn" id="fb-next" title="다음 페이지">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 3l5 4-5 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="fb-btn" id="fb-last" title="마지막 페이지">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M11 2v10M9 7L4 3v8l5-4z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
            <div class="fb-right">
              <div class="fb-zoom-btns">
                <button class="fb-zoom-btn" id="fb-zoom-out" title="축소">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </button>
                <button class="fb-zoom-btn" id="fb-zoom-in" title="확대">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                </button>
              </div>
              <button class="fb-fullscreen-btn" id="fb-fullscreen" title="전체화면">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5V2h3M9 2h3v3M12 9v3H9M5 12H2V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
            </div>
          </div>
          <div id="spread-viewport">
            <div id="fb-loading" class="fb-loading-indicator">
              <div class="fb-spinner"></div>
              <span id="fb-loading-text">
                <span class="wl-ko">PDF를 불러오는 중입니다...</span>
                <span class="wl-en">Loading PDF...</span>
              </span>
            </div>
            <div id="flip-book"></div>
          </div>
        </div>
      </>
    ) : (
      <div class="no-pdf">
        <div class="no-pdf-icon">
          <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><rect x="10" y="6" width="28" height="36" rx="4" stroke="#004f68" stroke-width="2"/><path d="M18 18h12M18 24h12M18 30h8" stroke="#004f68" stroke-width="2" stroke-linecap="round"/></svg>
        </div>
        <h3><span class="wl-ko">선교보고 소식지 준비 중</span><span class="wl-en">Mission Report Coming Soon</span></h3>
        <p><span class="wl-ko">월코 선교보고 소식지가 곧 업로드됩니다. 기도와 관심으로 함께해 주셔서 감사합니다.</span><span class="wl-en">The WOLKO mission report newsletter will be uploaded soon. Thank you for your prayers and support.</span></p>
      </div>
    )}
  </div>
</section>

{/* Archive */}
{reports.length > 1 && (
  <section class="archive-section">
    <div class="archive-grid">
      <div class="archive-grid-title">
        <span class="wl-ko">지난 선교보고 보기</span>
        <span class="wl-en">Previous Reports</span>
      </div>
      <div class="archive-list" id="archive-list">
        {reports.map((r, i) => (
          <div
            class={`archive-card${i === 0 ? ' current' : ''}`}
            data-pdf={r.data.pdf_url}
            data-title-ko={r.data.title_ko}
            data-title-en={r.data.title_en}
            data-date={r.data.date}
          >
            <div class="ac-icon">
              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><rect x="5" y="4" width="18" height="22" rx="3" stroke="#004f68" stroke-width="1.6"/><path d="M10 11h8M10 15h8M10 19h5" stroke="#004f68" stroke-width="1.5" stroke-linecap="round"/></svg>
            </div>
            <div class="ac-title">
              <span class="wl-ko">{r.data.title_ko}</span>
              <span class="wl-en">{r.data.title_en}</span>
            </div>
            <div class="ac-date">{new Date(r.data.date).toLocaleDateString('ko-KR', { year:'numeric', month:'long' })}</div>
            {i === 0 && <span class="ac-badge"><span class="wl-ko">최신</span><span class="wl-en">Latest</span></span>}
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<script is:inline>
(function () {
  var container = document.getElementById('flipbook-container');
  if (!container) return;

  var PDFJS_SRC    = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
  var PDFJS_WORKER = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  var PAGEFLIP_SRC = 'https://cdn.jsdelivr.net/npm/page-flip@2.0.7/dist/js/page-flip.browser.js';
  var DB_NAME      = 'wolko-pdf-v4';
  var STORE_NAME   = 'pages';
  var SCALE        = window.innerWidth < 640 ? 2.5 : 4.0;

  var loadingEl  = document.getElementById('fb-loading');
  var flipBookEl = document.getElementById('flip-book');
  var pageInfo   = document.getElementById('fb-page-info');
  var pageFlip   = null;

  /* ── Helpers ── */
  function loadScript(src) {
    return new Promise(function (res, rej) {
      var s = document.createElement('script');
      s.src = src; s.onload = res; s.onerror = rej;
      document.head.appendChild(s);
    });
  }
  function showSpinner() {
    loadingEl.style.display = 'flex';
    flipBookEl.style.display = 'none';
  }
  function showError(msg) {
    loadingEl.innerHTML = '<span style="color:#f87171;text-align:center;padding:0 20px;">' + msg + '</span>';
  }

  /* ── IndexedDB cache ── */
  function openDB() {
    return new Promise(function (res, rej) {
      var req = indexedDB.open(DB_NAME, 1);
      req.onupgradeneeded = function (e) {
        e.target.result.createObjectStore(STORE_NAME, { keyPath: 'key' });
      };
      req.onsuccess = function (e) { res(e.target.result); };
      req.onerror   = function () { rej(null); };
    });
  }
  function getCache(db, key) {
    return new Promise(function (res) {
      try {
        var tx  = db.transaction(STORE_NAME, 'readonly');
        var req = tx.objectStore(STORE_NAME).get(key);
        req.onsuccess = function () { res(req.result || null); };
        req.onerror   = function () { res(null); };
      } catch(e) { res(null); }
    });
  }
  function setCache(db, key, data) {
    try {
      var tx = db.transaction(STORE_NAME, 'readwrite');
      tx.objectStore(STORE_NAME).put({ key: key, data: data, ts: Date.now() });
    } catch(e) {}
  }

  /* ── PDF render ── */
  function renderPage(pdfDoc, pageNum) {
    return pdfDoc.getPage(pageNum).then(function (page) {
      var vp = page.getViewport({ scale: SCALE });
      var c  = document.createElement('canvas');
      c.width = vp.width; c.height = vp.height;
      var ctx = c.getContext('2d', { alpha: false });
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, c.width, c.height);
      return page.render({
        canvasContext: ctx,
        viewport: vp,
        intent: 'print',          // print intent = maximum sharpness
      }).promise.then(function () {
        return { url: c.toDataURL('image/png'), w: vp.width, h: vp.height };
      });
    });
  }

  /* ── Build flipbook ── */
  function buildFlipbook(pages) {
    if (pageFlip) { try { pageFlip.destroy(); } catch(e) {} pageFlip = null; }
    flipBookEl.innerHTML = '';

    var isMobile = window.innerWidth < 640;
    var pw = pages[0].w, ph = pages[0].h;
    var urls = pages.map(function (p) { return p.url; });

    pageFlip = new St.PageFlip(flipBookEl, {
      width: pw, height: ph,
      size: 'stretch',
      minWidth: isMobile ? 160 : 320, maxWidth: 900,
      minHeight: isMobile ? 200 : 400, maxHeight: 1400,
      showCover: true,
      usePortrait: isMobile,
      drawShadow: true,
      flippingTime: 650,
      mobileScrollSupport: false,
      startZIndex: 1,
    });
    pageFlip.loadFromImages(urls);

    function updateNav() {
      var cur = pageFlip.getCurrentPageIndex();
      var tot = pageFlip.getPageCount();
      pageInfo.textContent = (cur + 1) + ' / ' + tot;
      document.getElementById('fb-prev').disabled  = cur === 0;
      document.getElementById('fb-first').disabled = cur === 0;
      document.getElementById('fb-next').disabled  = cur >= tot - 1;
      document.getElementById('fb-last').disabled  = cur >= tot - 1;
    }
    pageFlip.on('flip', updateNav);
    pageFlip.on('changeState', updateNav);

    pageInfo.textContent = '1 / ' + urls.length;
    document.getElementById('fb-prev').disabled  = true;
    document.getElementById('fb-first').disabled = true;
    document.getElementById('fb-next').disabled  = urls.length <= 1;
    document.getElementById('fb-last').disabled  = urls.length <= 1;

    loadingEl.style.display = 'none';
    flipBookEl.style.display = 'block';
  }

  /* ── Main load (cache-first) ── */
  var db = null;
  function loadPdf(pdfUrl) {
    showSpinner();
    var cacheKey = pdfUrl + '@' + SCALE.toFixed(1);

    return (db ? Promise.resolve(db) : openDB().then(function (d) { db = d; return d; }))
      .catch(function () { return null; }) // IndexedDB unavailable → proceed without cache
      .then(function (database) {
        if (!database) return renderAndBuild(pdfUrl, null, cacheKey);
        return getCache(database, cacheKey).then(function (hit) {
          if (hit && hit.data && hit.data.length) {
            // ✅ Cache hit — instant display
            buildFlipbook(hit.data);
            return;
          }
          // Cache miss — render then cache
          return renderAndBuild(pdfUrl, database, cacheKey);
        });
      }).catch(function (err) {
        console.error(err);
        showError('PDF를 불러오지 못했습니다.<br>' + (err && err.message ? err.message : ''));
      });
  }

  function renderAndBuild(pdfUrl, database, cacheKey) {
    return pdfjsLib.getDocument(pdfUrl).promise.then(function (pdfDoc) {
      var n = pdfDoc.numPages;
      var pages = [];
      // Sequential render to avoid memory spikes
      function next(i) {
        if (i > n) return Promise.resolve();
        return renderPage(pdfDoc, i).then(function (p) {
          pages.push(p);
          return next(i + 1);
        });
      }
      return next(1).then(function () {
        if (database) setCache(database, cacheKey, pages);
        buildFlipbook(pages);
      });
    });
  }

  /* ── Bootstrap ── */
  loadScript(PDFJS_SRC).then(function () {
    pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER;
    return loadScript(PAGEFLIP_SRC);
  }).then(function () {
    var url = container.dataset.pdf
      || ((document.querySelector('.archive-card[data-pdf]') || {}).dataset || {}).pdf;
    if (url) loadPdf(url);
  }).catch(function (err) {
    showError('뷰어를 불러오지 못했습니다.<br>' + (err || ''));
  });

  /* ── Navigation ── */
  document.getElementById('fb-prev').addEventListener('click',  function () { if (pageFlip) pageFlip.flipPrev(); });
  document.getElementById('fb-next').addEventListener('click',  function () { if (pageFlip) pageFlip.flipNext(); });
  document.getElementById('fb-first').addEventListener('click', function () { if (pageFlip) pageFlip.flip(0); });
  document.getElementById('fb-last').addEventListener('click',  function () { if (pageFlip) pageFlip.flip(pageFlip.getPageCount() - 1); });

  document.getElementById('fb-fullscreen').addEventListener('click', function () {
    if (document.fullscreenElement) document.exitFullscreen();
    else if (container.requestFullscreen) container.requestFullscreen();
  });

  /* Zoom — invalidates cache for that scale */
  document.getElementById('fb-zoom-in').addEventListener('click', function () {
    SCALE = Math.min(SCALE + 0.5, 4.0);
    var url = container.dataset.pdf; if (url) loadPdf(url);
  });
  document.getElementById('fb-zoom-out').addEventListener('click', function () {
    SCALE = Math.max(SCALE - 0.5, 1.0);
    var url = container.dataset.pdf; if (url) loadPdf(url);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowRight' || e.key === 'ArrowDown') document.getElementById('fb-next').click();
    else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') document.getElementById('fb-prev').click();
  });

  /* ── Archive cards ── */
  document.querySelectorAll('.archive-card[data-pdf]').forEach(function (card) {
    card.addEventListener('click', function () {
      document.querySelectorAll('.archive-card').forEach(function (c) { c.classList.remove('current'); });
      card.classList.add('current');
      var url = card.dataset.pdf;
      if (url) {
        container.dataset.pdf = url;
        loadPdf(url).then(function () {
          container.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      }
    });
  });
})();
</script>

</BaseLayout>
