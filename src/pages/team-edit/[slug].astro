---
// /team-edit/[slug] — Password-protected profile self-edit page
// Each team member logs in with their slug + KV-stored password
// Edits are committed directly to GitHub via Cloudflare Worker Functions

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const members = await getCollection('team');
  return members
    .filter(m => !m.slug.startsWith('map-order'))
    .map(m => ({
      params: { slug: m.slug },
      props: { member: m },
    }));
}

const { member } = Astro.props;
const { slug } = Astro.params;
const d = member.data;

// Build a safe JSON string for inline script
const initialData = JSON.stringify({
  slug,
  hero_tagline_ko:  d.hero_tagline_ko || '',
  hero_tagline_en:  d.hero_tagline_en || '',
  hero_tagline2_ko: d.hero_tagline2_ko || '',
  hero_tagline2_en: d.hero_tagline2_en || '',
  hero_subtitle_ko: d.hero_subtitle_ko || '',
  hero_subtitle_en: d.hero_subtitle_en || '',
  bio_ko:           d.bio_ko || '',
  bio_en:           d.bio_en || '',
  bio_ko_2:         d.bio_ko_2 || '',
  bio_en_2:         d.bio_en_2 || '',
  verse_ref:        d.verse_ref || '',
  verse_ko:         d.verse_ko || '',
  verse_en:         d.verse_en || '',
  photo_url:        d.photo_url || '',
  photo_story:      d.photo_story || '',
  photo_url_2:      d.photo_url_2 || '',
  prayer_ko:        d.prayer_ko || '',
  prayer_en:        d.prayer_en || '',
  report_url:       d.report_url || '',
});

const hasSpouse = d.show_spouse && (d.bio_ko_2 || d.bio_en_2);
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>프로필 편집 — {d.name_ko}</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Noto+Sans+KR:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --blue:    #004f68;
      --blue-lt: #0077a3;
      --accent:  #c42a36;
      --bg:      #f0f4f7;
      --card:    #ffffff;
      --border:  #d8e4ea;
      --text:    #1a2d38;
      --mid:     #5a7585;
      --light:   #8fa8b5;
      --green:   #1da462;
      --f-sans:  'Montserrat', sans-serif;
      --f-body:  'Noto Sans KR', sans-serif;
      --radius:  14px;
    }

    body {
      font-family: var(--f-body);
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ── LOGIN SCREEN ─────────────────────────────────────────── */
    .login-screen {
      position: fixed; inset: 0;
      background: linear-gradient(145deg, #002f40, #004f68);
      display: flex; align-items: center; justify-content: center;
      z-index: 9999;
      transition: opacity 0.4s ease;
    }
    .login-screen.hidden { opacity: 0; pointer-events: none; }

    .login-card {
      background: #fff;
      border-radius: 20px;
      padding: 44px 40px 36px;
      width: 100%; max-width: 380px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.3);
      text-align: center;
    }
    .login-logo {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      margin-bottom: 24px;
    }
    .login-logo img { height: 36px; }
    .login-logo-name {
      font-family: var(--f-sans);
      font-size: 14px; font-weight: 700;
      color: var(--blue); letter-spacing: 0.04em;
    }
    .login-title {
      font-size: 13px; color: var(--mid);
      margin-bottom: 8px;
    }
    .login-name {
      font-size: 18px; font-weight: 600; color: var(--text);
      margin-bottom: 24px;
    }
    .login-input-wrap { position: relative; margin-bottom: 12px; }
    .login-input {
      width: 100%;
      padding: 14px 72px 14px 16px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      font-size: 15px;
      font-family: var(--f-body);
      color: var(--text);
      outline: none;
      transition: border-color 0.2s;
      background: #fafbfc;
    }
    .login-input:focus { border-color: var(--blue); background: #fff; }
    .login-input.error { border-color: var(--accent); }
    .login-eye {
      position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer;
      color: var(--mid); padding: 5px 7px; transition: color 0.2s;
      font-family: var(--f-sans); font-size: 10px; font-weight: 700;
      letter-spacing: 0.04em;
    }
    .login-eye:hover { color: var(--blue); }
    .login-error {
      font-size: 13px; color: var(--accent);
      min-height: 20px; margin-bottom: 10px;
    }
    .login-btn {
      width: 100%; padding: 15px;
      background: var(--blue);
      color: #fff; font-family: var(--f-sans);
      font-size: 14px; font-weight: 700;
      border: none; border-radius: 10px;
      cursor: pointer; transition: background 0.2s;
      letter-spacing: 0.04em;
    }
    .login-btn:hover { background: var(--blue-lt); }
    .login-btn:disabled { opacity: 0.6; cursor: not-allowed; }

    /* ── MAIN LAYOUT ──────────────────────────────────────────── */
    .page-header {
      background: var(--blue);
      padding: 20px 32px;
      display: flex; align-items: center; gap: 16px;
    }
    .page-header-logo img { height: 30px; }
    .page-header-info { flex: 1; }
    .page-header-title {
      font-family: var(--f-sans);
      font-size: 13px; font-weight: 700;
      color: rgba(255,255,255,0.6); letter-spacing: 0.06em;
      text-transform: uppercase;
    }
    .page-header-name {
      font-size: 18px; font-weight: 600; color: #fff;
      margin-top: 2px;
    }
    .page-header-actions {
      display: flex; gap: 10px;
    }
    .btn-logout {
      padding: 8px 16px;
      background: rgba(255,255,255,0.12);
      color: rgba(255,255,255,0.85);
      border: 1px solid rgba(255,255,255,0.2);
      border-radius: 8px;
      font-family: var(--f-sans);
      font-size: 11px; font-weight: 600;
      cursor: pointer; transition: background 0.2s;
      letter-spacing: 0.04em;
    }
    .btn-logout:hover { background: rgba(255,255,255,0.22); }

    .page-main {
      max-width: 800px; margin: 0 auto;
      padding: 36px 24px 80px;
    }

    /* ── SECTION CARDS ────────────────────────────────────────── */
    .edit-section {
      background: var(--card);
      border-radius: var(--radius);
      padding: 28px 28px 24px;
      margin-bottom: 20px;
      box-shadow: 0 2px 12px rgba(0,60,90,0.07);
    }
    .section-header {
      display: flex; align-items: center; gap: 10px;
      margin-bottom: 22px;
      padding-bottom: 14px;
      border-bottom: 1.5px solid var(--border);
    }
    .section-title {
      font-family: var(--f-sans);
      font-size: 13px; font-weight: 700;
      color: var(--blue); letter-spacing: 0.04em;
      text-transform: uppercase;
    }
    .section-sub {
      font-size: 12px; color: var(--light);
      margin-top: 1px;
    }

    /* ── FIELDS ───────────────────────────────────────────────── */
    .field-group { margin-bottom: 18px; }
    .field-group:last-child { margin-bottom: 0; }

    .field-label {
      display: flex; align-items: center; gap: 8px;
      font-size: 12px; font-weight: 600; color: var(--mid);
      letter-spacing: 0.04em; text-transform: uppercase;
      margin-bottom: 7px;
    }
    .field-lang {
      font-size: 10px; font-weight: 700;
      padding: 2px 6px; border-radius: 4px;
    }
    .field-lang.ko { background: #e8f3f8; color: var(--blue); }
    .field-lang.en { background: #fef3e2; color: #c47a00; }

    .field-input, .field-textarea {
      width: 100%;
      border: 1.5px solid var(--border);
      border-radius: 9px;
      padding: 12px 14px;
      font-family: var(--f-body);
      font-size: 14px; color: var(--text);
      background: #fafbfc;
      outline: none;
      transition: border-color 0.2s, background 0.2s;
      resize: vertical;
    }
    .field-input:focus, .field-textarea:focus {
      border-color: var(--blue);
      background: #fff;
    }
    .field-textarea { min-height: 120px; line-height: 1.7; }
    .field-textarea.tall { min-height: 180px; }

    .field-pair {
      display: grid; grid-template-columns: 1fr 1fr; gap: 14px;
    }
    @media (max-width: 600px) {
      .field-pair { grid-template-columns: 1fr; }
    }

    /* ── PHOTO SECTION ────────────────────────────────────────── */
    .photo-grid {
      display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;
    }
    @media (max-width: 600px) {
      .photo-grid { grid-template-columns: 1fr; }
    }

    .photo-item {}
    .photo-preview {
      width: 100%; aspect-ratio: 3/4;
      border-radius: 10px;
      border: 2px dashed var(--border);
      overflow: hidden; position: relative;
      background: #f4f7f9;
      cursor: pointer;
      transition: border-color 0.2s;
    }
    .photo-preview:hover { border-color: var(--blue-lt); }
    .photo-preview img {
      width: 100%; height: 100%; object-fit: cover;
      display: block;
    }
    .photo-overlay {
      position: absolute; inset: 0;
      background: rgba(0,0,0,0.45);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 6px;
      opacity: 0;
      transition: opacity 0.2s;
    }
    .photo-preview:hover .photo-overlay { opacity: 1; }
    .photo-overlay span {
      font-size: 11px; font-weight: 600;
      color: rgba(255,255,255,0.9);
      letter-spacing: 0.04em;
    }
    .photo-empty {
      width: 100%; height: 100%;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 8px;
      color: var(--light);
      font-size: 12px; font-weight: 500;
    }
    .photo-label {
      font-size: 11px; font-weight: 600;
      color: var(--mid); letter-spacing: 0.04em;
      text-align: center;
      margin-top: 8px; text-transform: uppercase;
    }
    .photo-upload-status {
      font-size: 11px; color: var(--green);
      text-align: center; min-height: 16px;
      margin-top: 4px;
    }

    /* ── SAVE BAR ─────────────────────────────────────────────── */
    .save-bar {
      position: fixed; bottom: 0; left: 0; right: 0;
      background: #fff;
      border-top: 1.5px solid var(--border);
      padding: 16px 24px;
      display: flex; align-items: center; gap: 14px;
      box-shadow: 0 -4px 20px rgba(0,60,90,0.08);
      z-index: 100;
    }
    .save-status {
      flex: 1; font-size: 13px; color: var(--mid);
    }
    .save-status.success { color: var(--green); font-weight: 600; }
    .save-status.error   { color: var(--accent); font-weight: 600; }

    .btn-save {
      padding: 13px 32px;
      background: var(--blue);
      color: #fff; border: none;
      border-radius: 10px;
      font-family: var(--f-sans);
      font-size: 13px; font-weight: 700;
      cursor: pointer; transition: background 0.2s;
      letter-spacing: 0.04em;
    }
    .btn-save:hover { background: var(--blue-lt); }
    .btn-save:disabled { opacity: 0.5; cursor: not-allowed; }

    .btn-preview {
      padding: 13px 20px;
      background: transparent;
      color: var(--blue);
      border: 1.5px solid var(--blue);
      border-radius: 10px;
      font-family: var(--f-sans);
      font-size: 13px; font-weight: 700;
      cursor: pointer; transition: all 0.2s;
      letter-spacing: 0.04em;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .btn-preview:hover { background: var(--blue); color: #fff; }

    /* ── REPORT / NEWSLETTER ─────────────────────────────────── */
    .report-current {
      display: flex; align-items: center; gap: 8px;
      background: rgba(0,79,104,0.06);
      border: 1px solid rgba(0,79,104,0.14);
      border-radius: 8px;
      padding: 10px 14px;
      margin-bottom: 18px;
      font-size: 12px;
    }
    .report-current-label { color: var(--mid); font-weight: 600; white-space: nowrap; }
    .report-current-url {
      color: var(--blue-lt); text-decoration: none;
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
      flex: 1;
    }
    .report-current-url:hover { text-decoration: underline; }

    .pdf-upload-btn {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 10px 18px;
      background: rgba(0,79,104,0.08);
      color: var(--blue);
      border: 1.5px solid rgba(0,79,104,0.2);
      border-radius: 8px;
      font-family: var(--f-sans);
      font-size: 12px; font-weight: 700;
      cursor: pointer; transition: all 0.2s;
      letter-spacing: 0.04em;
    }
    .pdf-upload-btn:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
    .pdf-upload-btn:disabled { opacity: 0.5; cursor: not-allowed; }

    .pdf-upload-status {
      font-size: 12px; font-weight: 600;
      color: var(--green);
    }
    .pdf-upload-status.error { color: var(--accent); }

    /* ── AUTO-TRANSLATE ──────────────────────────────────────── */
    .translate-row {
      display: flex; align-items: center; justify-content: center;
      gap: 8px; margin: 6px 0;
    }
    .translate-row::before, .translate-row::after {
      content: ''; flex: 1; height: 1px; background: var(--border);
    }
    .btn-translate {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 5px 12px;
      background: rgba(0,79,104,0.06);
      border: 1.5px solid rgba(0,79,104,0.18);
      border-radius: 20px;
      font-size: 11px; font-weight: 700;
      color: var(--blue-lt);
      cursor: pointer; white-space: nowrap;
      transition: all 0.2s;
      letter-spacing: 0.03em;
    }
    .btn-translate:hover { background: var(--blue); color: #fff; border-color: var(--blue); }
    .btn-translate:disabled { opacity: 0.45; cursor: not-allowed; }
    /* ── NOTICE BOX ───────────────────────────────────────────── */
    .notice {
      background: rgba(0,79,104,0.06);
      border: 1px solid rgba(0,79,104,0.15);
      border-radius: 10px;
      padding: 14px 16px;
      font-size: 12px; color: var(--mid);
      line-height: 1.7;
      margin-bottom: 20px;
    }
    .notice strong { color: var(--blue); }
  </style>
</head>
<body>

  <!-- ── LOGIN SCREEN ─────────────────────────────────────────── -->
  <div class="login-screen" id="loginScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <span class="login-logo-name">WOLKO</span>
      </div>
      <p class="login-title">Profile Login</p>
      <p class="login-name">{d.name_ko}</p>
      <div class="login-input-wrap">
        <input
          type="password"
          class="login-input"
          id="loginPw"
          placeholder="Enter password"
          autocomplete="current-password"
          inputmode="latin"
          pattern="[\x21-\x7E]*"
        >
        <button class="login-eye" id="loginEye" type="button" aria-label="Show password">Show</button>
      </div>
      <p class="login-error" id="loginError"></p>
      <button class="login-btn" id="loginBtn">Sign In</button>
    </div>
  </div>

  <!-- ── PAGE HEADER ──────────────────────────────────────────── -->
  <header class="page-header">
    <div class="page-header-logo">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
    </div>
    <div class="page-header-info">
      <div class="page-header-title">Edit Profile</div>
      <div class="page-header-name">{d.name_ko} <span style="font-weight:400;font-size:14px;opacity:0.7;">/ {d.name_en}</span></div>
    </div>
    <div class="page-header-actions">
      <a class="btn-preview" href={`/team/${slug}`} target="_blank">
        View My Page
      </a>
      <button class="btn-logout" id="logoutBtn">Sign Out</button>
    </div>
  </header>

  <!-- ── MAIN CONTENT ─────────────────────────────────────────── -->
  <main class="page-main">

    <div class="notice">
      <strong>Note:</strong> Click <strong>Save</strong> to push changes directly to GitHub. The site will rebuild in about 1–2 minutes.
      Click a photo slot to upload a new photo (jpg, png, webp / max 30MB).
    </div>

    <!-- ① Photo Section -->
    <div class="edit-section">
      <div class="section-header">
        <div>
          <div class="section-title">Photos</div>
          <div class="section-sub">Click to replace — saved immediately on upload</div>
        </div>
      </div>

      <div class="photo-grid">
        <!-- Profile Photo -->
        <div class="photo-item">
          <div class="photo-preview" id="preview-photo_url" onclick="triggerUpload('photo_url')">
            {d.photo_url
              ? <img id="img-photo_url" src={d.photo_url} alt="Profile photo">
              : <div class="photo-empty" id="empty-photo_url">
                  <span>No photo</span>
                </div>
            }
            <div class="photo-overlay">
              <span>Change Photo</span>
            </div>
          </div>
          <div class="photo-label">Profile Photo</div>
          <div class="photo-upload-status" id="status-photo_url"></div>
        </div>

        <!-- Story Photo -->
        <div class="photo-item">
          <div class="photo-preview" id="preview-photo_story" onclick="triggerUpload('photo_story')">
            {d.photo_story
              ? <img id="img-photo_story" src={d.photo_story} alt="Story photo">
              : <div class="photo-empty" id="empty-photo_story">
                  <span>No photo</span>
                </div>
            }
            <div class="photo-overlay">
              <span>Change Photo</span>
            </div>
          </div>
          <div class="photo-label">Story Photo (Self)</div>
          <div class="photo-upload-status" id="status-photo_story"></div>
        </div>

        <!-- Spouse Photo -->
        <div class="photo-item" style={!hasSpouse ? 'opacity:0.4;pointer-events:none' : ''}>
          <div class="photo-preview" id="preview-photo_url_2" onclick="triggerUpload('photo_url_2')">
            {d.photo_url_2
              ? <img id="img-photo_url_2" src={d.photo_url_2} alt="Spouse photo">
              : <div class="photo-empty" id="empty-photo_url_2">
                  <span>No photo</span>
                </div>
            }
            <div class="photo-overlay">
              <span>Change Photo</span>
            </div>
          </div>
          <div class="photo-label">Spouse Photo{!hasSpouse ? ' (N/A)' : ''}</div>
          <div class="photo-upload-status" id="status-photo_url_2"></div>
        </div>
      </div>

      <!-- Hidden file input -->
      <input type="file" id="fileInput" accept="image/jpeg,image/png,image/webp" style="display:none">
    </div>

    <!-- ② Hero Titles -->
    <div class="edit-section">
      <div class="section-header">
        <div>
          <div class="section-title">Hero Titles</div>
          <div class="section-sub">Large tagline text shown on the profile hero image</div>
        </div>
      </div>

      <!-- Preview hint -->
      <div style="background:rgba(0,79,104,0.05);border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:12px;color:var(--mid);line-height:1.7;">
        <strong style="color:var(--blue);">흰색 타이틀</strong> — 히어로 이미지 위 큰 흰색 텍스트 (1줄)<br>
        <strong style="color:var(--blue-lt);">하늘색 타이틀</strong> — 흰색 아래 두 번째 줄 텍스트<br>
        <strong style="color:var(--mid);">Short Bio</strong> — 타이틀 아래 작은 설명 문구
      </div>

      <!-- White tagline (line 1) -->
      <p style="font-size:11px;font-weight:700;color:var(--mid);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:8px;">흰색 타이틀 (1줄)</p>
      <div class="field-group">
        <label class="field-label"><span class="field-lang ko">KO</span> Korean</label>
        <input type="text" class="field-input" id="f-hero_tagline_ko" value={d.hero_tagline_ko || ''} placeholder="예: 확신으로">
      </div>
      <div class="translate-row">
        <button class="btn-translate" onclick="autoTranslate('f-hero_tagline_ko','f-hero_tagline_en','tagline')">
          Translate
</button>
      </div>
      <div class="field-group" style="margin-bottom:18px;">
        <label class="field-label"><span class="field-lang en">EN</span> English</label>
        <input type="text" class="field-input" id="f-hero_tagline_en" value={d.hero_tagline_en || ''} placeholder="e.g. Proclaiming the Gospel">
      </div>

      <!-- Blue tagline (line 2) -->
      <p style="font-size:11px;font-weight:700;color:var(--blue-lt);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:8px;">하늘색 타이틀 (2줄)</p>
      <div class="field-group">
        <label class="field-label"><span class="field-lang ko">KO</span> Korean</label>
        <input type="text" class="field-input" id="f-hero_tagline2_ko" value={d.hero_tagline2_ko || ''} placeholder="예: 복음을 전하다">
      </div>
      <div class="translate-row">
        <button class="btn-translate" onclick="autoTranslate('f-hero_tagline2_ko','f-hero_tagline2_en','tagline')">
          Translate
</button>
      </div>
      <div class="field-group" style="margin-bottom:18px;">
        <label class="field-label"><span class="field-lang en">EN</span> English</label>
        <input type="text" class="field-input" id="f-hero_tagline2_en" value={d.hero_tagline2_en || ''} placeholder="e.g. with Conviction">
      </div>

      <!-- Short Bio subtitle -->
      <p style="font-size:11px;font-weight:700;color:var(--mid);letter-spacing:0.06em;text-transform:uppercase;margin-bottom:8px;">Short Bio (타이틀 아래 설명)</p>
      <div class="field-group">
        <label class="field-label"><span class="field-lang ko">KO</span> Korean</label>
        <textarea class="field-textarea" id="f-hero_subtitle_ko" rows="3">{d.hero_subtitle_ko || ''}</textarea>
      </div>
      <div class="translate-row">
        <button class="btn-translate" onclick="autoTranslate('f-hero_subtitle_ko','f-hero_subtitle_en','subtitle')">
          Translate
</button>
      </div>
      <div class="field-group">
        <label class="field-label"><span class="field-lang en">EN</span> English</label>
        <textarea class="field-textarea" id="f-hero_subtitle_en" rows="3">{d.hero_subtitle_en || ''}</textarea>
      </div>
    </div>

    <!-- ③ Life Verse -->
    <div class="edit-section">
      <div class="section-header">
        <div>
          <div class="section-title">Life Verse</div>
          <div class="section-sub">Life Verse</div>
        </div>
      </div>

      <div style="background:rgba(0,79,104,0.05);border-radius:10px;padding:12px 16px;margin-bottom:20px;font-size:12px;color:var(--mid);line-height:1.7;">
        본문 말씀 직접 적지 않아도 말씀 구절 몇장 몇절인지만 적고 아래 버튼으로 load 하면 자동으로 <strong>개역개정4판</strong> 한글 · <strong>NIV</strong> 영문 성경말씀이 채워집니다.<br>
        <em style="color:var(--blue);">You don't have to add full Bible text here. Just click the load button after writing the reference and it will fill automatically with <strong>개역개정4판</strong> KOR &amp; <strong>NIV</strong> ENG.</em>
      </div>

      <div class="field-group">
        <label class="field-label">Verse reference (e.g. Psalm 96:2–3)</label>
        <input type="text" class="field-input" id="f-verse_ref" value={d.verse_ref || ''} placeholder="예: 시편 96:2-3 / Psalm 96:2-3">
      </div>
      <div class="translate-row">
        <button class="btn-translate" id="btn-verse-lookup" onclick="lookupVerse()">
          Load Korean &amp; English Bible Text
        </button>
      </div>
      <div class="field-group">
        <label class="field-label"><span class="field-lang ko">KO</span> Korean</label>
        <textarea class="field-textarea" id="f-verse_ko" rows="4">{d.verse_ko || ''}</textarea>
      </div>
      <div class="field-group">
        <label class="field-label"><span class="field-lang en">EN</span> English Verse</label>
        <textarea class="field-textarea" id="f-verse_en" rows="4">{d.verse_en || ''}</textarea>
      </div>
    </div>

    <!-- ④ My Story -->
    <div class="edit-section">
      <div class="section-header">
        <div>
          <div class="section-title">My Story</div>
          <div class="section-sub">Personal testimony / ministry introduction</div>
        </div>
      </div>
      <div class="field-group">
        <label class="field-label"><span class="field-lang ko">KO</span> Korean</label>
        <textarea class="field-textarea tall" id="f-bio_ko">{d.bio_ko || ''}</textarea>
      </div>
      <div class="translate-row">
        <button class="btn-translate" onclick="autoTranslate('f-bio_ko','f-bio_en','bio')">
          Translate
</button>
      </div>
      <div class="field-group">
        <label class="field-label"><span class="field-lang en">EN</span> English</label>
        <textarea class="field-textarea tall" id="f-bio_en">{d.bio_en || ''}</textarea>
      </div>
    </div>

    <!-- ⑤ Spouse Story (if applicable) -->
    {hasSpouse && (
      <div class="edit-section">
        <div class="section-header">
          <div>
            <div class="section-title">Spouse's Story</div>
            <div class="section-sub">{d.spouse_ko} / {d.spouse_en}</div>
          </div>
        </div>
        <div class="field-group">
          <label class="field-label"><span class="field-lang ko">KO</span> Korean</label>
          <textarea class="field-textarea tall" id="f-bio_ko_2">{d.bio_ko_2 || ''}</textarea>
        </div>
        <div class="translate-row">
          <button class="btn-translate" onclick="autoTranslate('f-bio_ko_2','f-bio_en_2','bio')">
            Translate
  </button>
        </div>
        <div class="field-group">
          <label class="field-label"><span class="field-lang en">EN</span> English</label>
          <textarea class="field-textarea tall" id="f-bio_en_2">{d.bio_en_2 || ''}</textarea>
        </div>
      </div>
    )}

    <!-- ⑥ Prayer Requests -->
    <div class="edit-section">
      <div class="section-header">
        <div>
          <div class="section-title">Prayer Requests</div>
          <div class="section-sub">Prayer requests to share with supporters</div>
        </div>
      </div>
      <div class="field-group">
        <label class="field-label"><span class="field-lang ko">KO</span> Korean</label>
        <textarea class="field-textarea" id="f-prayer_ko" rows="5" placeholder="예: 평택 캠퍼스 청소년 여름 캠프를 위해 기도해 주세요...">{d.prayer_ko || ''}</textarea>
      </div>
      <div class="translate-row">
        <button class="btn-translate" onclick="autoTranslate('f-prayer_ko','f-prayer_en','prayer')">
          Translate
</button>
      </div>
      <div class="field-group">
        <label class="field-label"><span class="field-lang en">EN</span> English</label>
        <textarea class="field-textarea" id="f-prayer_en" rows="5" placeholder="e.g. Please pray for the summer youth camp at Pyeongtaek...">{d.prayer_en || ''}</textarea>
      </div>
    </div>

    <!-- ⑦ Newsletter / Ministry Report -->
    <div class="edit-section">
      <div class="section-header">
        <div>
          <div class="section-title">Newsletter / Ministry Report</div>
          <div class="section-sub">Upload a PDF or paste a Mailchimp/newsletter link</div>
        </div>
      </div>

      <!-- Current value display -->
      {d.report_url && (
        <div class="report-current" id="report-current-wrap">
          <span class="report-current-label">현재 링크:</span>
          <a id="report-current-link" href={d.report_url} target="_blank" rel="noopener" class="report-current-url">{d.report_url}</a>
        </div>
      )}
      {!d.report_url && (
        <div class="report-current" id="report-current-wrap" style="display:none">
          <span class="report-current-label">현재 링크:</span>
          <a id="report-current-link" href="#" target="_blank" rel="noopener" class="report-current-url"></a>
        </div>
      )}

      <!-- URL input -->
      <div class="field-group">
        <label class="field-label">
          Mailchimp or external newsletter URL
        </label>
        <input
          type="url"
          class="field-input"
          id="f-report_url"
          value={d.report_url || ''}
          placeholder="https://mailchimp.com/... 또는 https://..."
        >
        <p style="font-size:11px;color:var(--light);margin-top:6px;">외부 링크 입력 시 아래 PDF 업로드는 무시됩니다. Save를 눌러야 반영됩니다.</p>
      </div>

      <!-- PDF upload -->
      <div class="field-group" style="margin-top:4px">
        <label class="field-label">
          Or upload PDF newsletter
        </label>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">
          <button type="button" class="pdf-upload-btn" id="pdfUploadBtn" onclick="triggerPdfUpload()">
            PDF 업로드
          </button>
          <span class="pdf-upload-status" id="pdf-upload-status"></span>
        </div>
        <input type="file" id="pdfFileInput" accept="application/pdf" style="display:none">
        <p style="font-size:11px;color:var(--light);margin-top:6px;">업로드 시 자동으로 URL이 설정됩니다. Save 없이도 즉시 반영됩니다.</p>
      </div>
    </div>

  </main>

  <!-- ── SAVE BAR ──────────────────────────────────────────────── -->
  <div class="save-bar">
    <div class="save-status" id="saveStatus"></div>
    <button class="btn-save" id="saveBtn">Save Changes</button>
  </div>

  <script is:inline define:vars={{ initialData, slug }}>
    // ── State ──────────────────────────────────────────────────
    const TOKEN_KEY = `wolko_team_token_${slug}`;
    let authToken = sessionStorage.getItem(TOKEN_KEY) || '';
    let activeUploadField = null;

    // ── Login ──────────────────────────────────────────────────
    const loginScreen = document.getElementById('loginScreen');
    const loginPw     = document.getElementById('loginPw');
    const loginBtn    = document.getElementById('loginBtn');
    const loginError  = document.getElementById('loginError');
    const loginEye    = document.getElementById('loginEye');
    const PASSWORD_ALLOWED_RE = /^[\x21-\x7E]*$/;

    function cleanPasswordValue(value) {
      return String(value || '').replace(/[^\x21-\x7E]/g, '');
    }

    function enforceAsciiPasswordInput(input) {
      function warnPasswordLanguage() {
        loginError.textContent = 'Please switch to English input before entering the password.';
        loginPw.classList.add('error');
      }
      input.addEventListener('beforeinput', e => {
        if (e.data && !PASSWORD_ALLOWED_RE.test(e.data)) {
          e.preventDefault();
          warnPasswordLanguage();
        }
      });
      input.addEventListener('paste', e => {
        const text = e.clipboardData?.getData('text') || '';
        const clean = cleanPasswordValue(text);
        if (text !== clean) {
          e.preventDefault();
          const start = input.selectionStart ?? input.value.length;
          const end = input.selectionEnd ?? start;
          input.setRangeText(clean, start, end, 'end');
          input.dispatchEvent(new Event('input', { bubbles: true }));
          warnPasswordLanguage();
        }
      });
      input.addEventListener('input', () => {
        const clean = cleanPasswordValue(input.value);
        if (input.value !== clean) {
          input.value = clean;
          warnPasswordLanguage();
        }
      });
    }

    enforceAsciiPasswordInput(loginPw);

    function showEditPage() {
      loginScreen.classList.add('hidden');
    }

    // Check if already logged in
    if (authToken) {
      // Quick verify by attempting a harmless call (just show the page)
      showEditPage();
    }

    loginEye.addEventListener('click', () => {
      const isHidden = loginPw.type === 'password';
      loginPw.type = isHidden ? 'text' : 'password';
      loginEye.textContent = isHidden ? 'Hide' : 'Show';
      loginEye.setAttribute('aria-label', isHidden ? 'Hide password' : 'Show password');
    });

    loginPw.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
    loginBtn.addEventListener('click', doLogin);

    async function doLogin() {
      const pw = loginPw.value.trim();
      if (!pw) return;
      loginBtn.disabled = true;
      loginBtn.textContent = 'Verifying...';
      loginError.textContent = '';
      loginPw.classList.remove('error');

      try {
        const res = await fetch('/api/team/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug, password: pw }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Login failed');
        authToken = data.token;
        sessionStorage.setItem(TOKEN_KEY, authToken);
        showEditPage();
      } catch (e) {
        loginPw.classList.add('error');
        loginError.textContent = e.message;
      } finally {
        loginBtn.disabled = false;
        loginBtn.textContent = 'Sign In';
      }
    }

    // ── Auto-translate ─────────────────────────────────────────
    window.autoTranslate = async function(koId, enId, ctx) {
      const koEl = document.getElementById(koId);
      const enEl = document.getElementById(enId);
      if (!koEl || !enEl) return;

      const koVal = koEl.value.trim();
      const enVal = enEl.value.trim();

      // 방향 결정: 비어 있는 쪽으로 번역
      // 둘 다 있으면 → 사용자에게 선택 묻기
      let from, targetEl;
      if (koVal && !enVal) {
        from = 'ko'; targetEl = enEl;
      } else if (enVal && !koVal) {
        from = 'en'; targetEl = koEl;
      } else if (koVal && enVal) {
        const choice = confirm('두 필드 모두 내용이 있습니다.\n\n확인 → 한국어 기준으로 영어 번역\n취소 → 영어 기준으로 한국어 번역');
        from = choice ? 'ko' : 'en';
        targetEl = choice ? enEl : koEl;
      } else {
        alert('번역할 내용을 먼저 입력해 주세요.');
        return;
      }

      const sourceEl = from === 'ko' ? koEl : enEl;
      const text = sourceEl.value.trim();

      // 버튼 비활성화
      const btn = event.currentTarget;
      const origText = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = '번역 중...';

      try {
        const res = await fetch('/api/team/translate', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${authToken}`,
          },
          body: JSON.stringify({ text, from, context: ctx }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '번역 실패');

        targetEl.value = data.translated;
        targetEl.style.borderColor = 'var(--green)';
        setTimeout(() => { targetEl.style.borderColor = ''; }, 2000);
      } catch (e) {
        alert('번역 오류: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = origText;
      }
    };

    // ── Verse lookup ───────────────────────────────────────────
    window.lookupVerse = async function() {
      const ref = document.getElementById('f-verse_ref').value.trim();
      if (!ref) { alert('구절 참조를 먼저 입력해 주세요.\n예: 시편 96:2-3 / John 3:16'); return; }

      const btn = document.getElementById('btn-verse-lookup');
      const origHTML = btn.innerHTML;
      btn.disabled = true;
      btn.textContent = '불러오는 중...';

      try {
        const res = await fetch('/api/team/translate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Authorization': `Bearer ${authToken}` },
          body: JSON.stringify({ text: ref, from: 'ref', context: 'verse_lookup' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '불러오기 실패');

        const koEl = document.getElementById('f-verse_ko');
        const enEl = document.getElementById('f-verse_en');
        if (data.ko) { koEl.value = data.ko; koEl.style.borderColor = 'var(--green)'; setTimeout(() => { koEl.style.borderColor = ''; }, 2500); }
        if (data.en) { enEl.value = data.en; enEl.style.borderColor = 'var(--green)'; setTimeout(() => { enEl.style.borderColor = ''; }, 2500); }
      } catch (e) {
        alert('오류: ' + e.message);
      } finally {
        btn.disabled = false;
        btn.innerHTML = origHTML;
      }
    };

    // ── Logout ─────────────────────────────────────────────────
    document.getElementById('logoutBtn').addEventListener('click', () => {
      sessionStorage.removeItem(TOKEN_KEY);
      authToken = '';
      loginScreen.classList.remove('hidden');
      loginPw.value = '';
    });

    // ── Photo upload ───────────────────────────────────────────
    const fileInput = document.getElementById('fileInput');

    window.triggerUpload = function(field) {
      activeUploadField = field;
      fileInput.value = '';
      fileInput.click();
    };

    fileInput.addEventListener('change', async () => {
      const file = fileInput.files[0];
      if (!file || !activeUploadField) return;

      if (file.size > 30 * 1024 * 1024) {
        setPhotoStatus(activeUploadField, 'File size must be under 30MB.', true);
        return;
      }

      setPhotoStatus(activeUploadField, 'Uploading...');

      const fd = new FormData();
      fd.append('file', file);
      fd.append('field', activeUploadField);

      try {
        const res = await fetch('/api/team/upload', {
          method: 'POST',
          headers: { Authorization: `Bearer ${authToken}` },
          body: fd,
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed');

        // Update preview
        const previewEl = document.getElementById(`preview-${activeUploadField}`);
        const emptyEl   = document.getElementById(`empty-${activeUploadField}`);
        let imgEl = document.getElementById(`img-${activeUploadField}`);

        if (!imgEl) {
          imgEl = document.createElement('img');
          imgEl.id = `img-${activeUploadField}`;
          imgEl.alt = 'Photo';
          previewEl.insertBefore(imgEl, previewEl.firstChild);
        }
        imgEl.src = data.url + '?t=' + Date.now();
        imgEl.style.display = '';
        if (emptyEl) emptyEl.style.display = 'none';

        setPhotoStatus(activeUploadField, 'Uploaded — will appear after site rebuild.');
      } catch (e) {
        setPhotoStatus(activeUploadField, e.message, true);
      }
    });

    function setPhotoStatus(field, msg, isErr = false) {
      const el = document.getElementById(`status-${field}`);
      if (!el) return;
      el.textContent = msg;
      el.style.color = isErr ? '#c42a36' : '#1da462';
    }

    // ── PDF upload (newsletter/report) ─────────────────────────
    const pdfFileInput = document.getElementById('pdfFileInput');

    window.triggerPdfUpload = function() {
      pdfFileInput.value = '';
      pdfFileInput.click();
    };

    pdfFileInput.addEventListener('change', async () => {
      const file = pdfFileInput.files[0];
      if (!file) return;

      if (file.size > 50 * 1024 * 1024) {
        setPdfStatus('파일 크기는 50MB 이하여야 합니다.', true);
        return;
      }

      const btn = document.getElementById('pdfUploadBtn');
      btn.disabled = true;
      setPdfStatus('업로드 중...');

      const fd = new FormData();
      fd.append('file', file);
      fd.append('field', 'report_url');

      try {
        const res = await fetch('/api/team/upload', {
          method: 'POST',
          headers: { Authorization: `Bearer ${authToken}` },
          body: fd,
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed');

        // Update the URL input field and current link display
        const urlInput = document.getElementById('f-report_url');
        if (urlInput) urlInput.value = data.url;

        const wrap = document.getElementById('report-current-wrap');
        const link = document.getElementById('report-current-link');
        if (wrap && link) {
          link.href = data.url;
          link.textContent = data.url;
          wrap.style.display = 'flex';
        }

        setPdfStatus('업로드 완료 — 사이트 재빌드 후 반영됩니다.');
      } catch (e) {
        setPdfStatus(e.message, true);
      } finally {
        btn.disabled = false;
      }
    });

    function setPdfStatus(msg, isErr = false) {
      const el = document.getElementById('pdf-upload-status');
      if (!el) return;
      el.textContent = msg;
      el.className = 'pdf-upload-status' + (isErr ? ' error' : '');
    }

    // ── Save profile fields ────────────────────────────────────
    const saveBtn    = document.getElementById('saveBtn');
    const saveStatus = document.getElementById('saveStatus');

    function getFieldVal(id) {
      const el = document.getElementById(id);
      return el ? el.value : undefined;
    }

    saveBtn.addEventListener('click', async () => {
      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';
      saveStatus.textContent = '';
      saveStatus.className = 'save-status';

      const fields = {};
      const fids = [
        'hero_tagline_ko', 'hero_tagline_en',
        'hero_tagline2_ko', 'hero_tagline2_en',
        'hero_subtitle_ko', 'hero_subtitle_en',
        'verse_ref', 'verse_ko', 'verse_en',
        'bio_ko', 'bio_en', 'bio_ko_2', 'bio_en_2',
        'prayer_ko', 'prayer_en',
        'report_url',
      ];
      for (const fid of fids) {
        const v = getFieldVal(`f-${fid}`);
        if (v !== undefined) fields[fid] = v;
      }

      try {
        const res = await fetch('/api/team/update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Authorization: `Bearer ${authToken}`,
          },
          body: JSON.stringify({ fields }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Save failed');

        saveStatus.textContent = 'Saved — changes will appear after rebuild (about 1–2 min).';
        saveStatus.className = 'save-status success';
      } catch (e) {
        saveStatus.textContent = e.message;
        saveStatus.className = 'save-status error';
        if (e.message.includes('인증') || e.message.includes('auth')) {
          // Token may have expired — prompt re-login
          sessionStorage.removeItem(TOKEN_KEY);
          authToken = '';
          loginScreen.classList.remove('hidden');
        }
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save Changes';
      }
    });
  </script>

</body>
</html>
