---
// 비공개 스태프(섬김) 지원서 — 링크를 받은 사람만 들어오는 페이지. 홈페이지·포탈 어디에도 연결하지 않고, 검색엔진에도 올리지 않는다.
// 제출하면 포탈 "섬김 지원 신청서"에 저장되고(functions/api/apply/staff.js), 추천인 1·2 에게 추천서 요청 메일이 간다.
// 지원자는 메일로 받은 임시 비밀번호로 로그인해 서버에 저장하며 이어 쓴다(functions/api/apply/account.js). 30일 동안 로그인하지 않으면 임시 계정은 자동 삭제.
// 항목 정의는 서버 검증과 같은 것(serveApplicationSchema.js)을 빌드할 때 넣는다. 로고는 공식 로고(/images/wolko-logo.svg)만 쓴다.
import { APPLICANT_SECTIONS } from '../../../functions/lib/serveApplicationSchema.js';
const schemaJson = JSON.stringify(APPLICANT_SECTIONS);
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta name="referrer" content="no-referrer">
  <title>Staff Application · 스태프 지원서 — Word of Life Korea</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/apply.css?v=4">
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
</head>
<body data-mode="loading">
  <header class="ap-top">
    <div class="ap-wrap ap-top-in">
      <a class="ap-brand" href="https://wolko.org" target="_blank" rel="noopener"><img src="/images/wolko-logo.svg" alt="WOLKO 월코 — Word of Life Korea" width="185" height="36"></a>
      <div class="ap-top-right">
        <span class="ap-acct" id="apAcct" hidden>
          <span class="ap-acct-who" id="apAcctEmail"></span>
          <button type="button" class="ap-txt" id="apLogout" data-i="logout">로그아웃</button>
        </span>
        <div class="ap-lang" role="group" aria-label="Language"><button type="button" data-lang="ko">한국어</button><button type="button" data-lang="en">English</button></div>
      </div>
    </div>
  </header>

  <section class="ap-wrap">
    <div class="ap-title">
      <h1 data-i="title">스태프 지원서</h1>
      <p data-i="lead">월코에서 청소년 사역을 함께할 스태프를 모집합니다. 지원서와 추천서 2부를 받아 검토한 뒤 면담을 진행합니다.</p>
    </div>
  </section>

  <div class="ap-wrap ap-band">
    <div class="ap-band-row">
      <h1 data-i="title">스태프 지원서</h1>
      <span class="ap-band-meta"><span id="apProg"></span><span class="ap-saved" id="apSaved" aria-live="polite"></span></span>
    </div>
    <div class="ap-progress" aria-hidden="true"><div class="ap-progress-bar" id="apBar"></div></div>
  </div>

  <section class="ap-wrap ap-gate" id="apGate" hidden>
    <div class="ap-intro">
      <h2 data-i="infoTitle">지원 안내</h2>
      <dl class="ap-info">
        <div><dt data-i="infoTimeL">작성 시간</dt><dd data-i="infoTime">20–30분 정도 걸립니다. 쓰는 동안 자동으로 저장되므로 나눠서 써도 됩니다.</dd></div>
        <div><dt data-i="infoRefL">추천인</dt><dd data-i="infoRef">두 분의 이름과 이메일이 필요합니다. ① 담임목사님 또는 교회 지도자 ② 동역자 또는 친구</dd></div>
        <div><dt data-i="infoMailL">추천서</dt><dd data-i="infoMail">지원서를 제출하면 추천인께 추천서 양식이 이메일로 자동 발송됩니다. 미리 말씀드려 두시면 좋습니다.</dd></div>
        <div><dt data-i="infoPrivL">개인정보</dt><dd data-i="infoPriv">검토 담당자만 열람합니다. 선발되지 않으면 결정 후 12개월이 지나 삭제됩니다.</dd></div>
        <div><dt data-i="infoAcctL">임시 계정</dt><dd data-i="gateNote">로그인은 이메일로 받는 임시 비밀번호로 합니다. 30일 동안 로그인하지 않으면 계정과 제출하지 않은 내용은 삭제됩니다.</dd></div>
      </dl>
    </div>

    <div class="ap-box">
      <form id="apIssueForm" novalidate>
        <h2 data-i="issueTitle">작성 시작하기</h2>
        <p class="ap-box-lead" data-i="issueLead">이메일로 임시 비밀번호를 보내 드립니다.</p>
        <div class="ap-field"><label class="ap-label" for="apIssueName" data-i="gateName">이름</label><input id="apIssueName" type="text" autocomplete="name" maxlength="80"></div>
        <div class="ap-field"><label class="ap-label" for="apIssueEmail" data-i="gateEmail">이메일</label><input id="apIssueEmail" type="email" autocomplete="email" maxlength="120"></div>
        <input type="text" name="website" id="apHoney" tabindex="-1" autocomplete="off" class="ap-honey" aria-hidden="true">
        <button type="submit" class="ap-btn primary block" id="apIssueBtn" data-i="issueBtn">임시 비밀번호 받기</button>
        <p class="ap-box-foot"><span data-i="haveCode">비밀번호를 이미 받으셨으면</span> <button type="button" class="ap-link" data-gate="login" data-i="toLogin">로그인</button></p>
      </form>
      <form id="apLoginForm" novalidate hidden>
        <h2 data-i="loginTitle">로그인</h2>
        <p class="ap-box-lead" data-i="loginLead">메일로 받은 임시 비밀번호를 입력해 주세요.</p>
        <div class="ap-field"><label class="ap-label" for="apLoginEmail" data-i="gateEmail">이메일</label><input id="apLoginEmail" type="email" autocomplete="username" maxlength="120"></div>
        <div class="ap-field"><label class="ap-label" for="apLoginPw" data-i="gatePw">임시 비밀번호</label><input id="apLoginPw" type="text" class="ap-pw" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" maxlength="12" placeholder="XXXX-XXXX"></div>
        <button type="submit" class="ap-btn primary block" id="apLoginBtn" data-i="loginBtn">로그인</button>
        <p class="ap-box-foot"><span data-i="lostCode">비밀번호를 잃어버렸으면</span> <button type="button" class="ap-link" data-gate="start" data-i="resend">다시 받기</button></p>
      </form>
      <p class="ap-gate-msg" id="apGateMsg" role="status" hidden></p>
    </div>
  </section>

  <main class="ap-wrap ap-main" id="apMain" hidden>
    <nav class="ap-steps" aria-label="Steps">
      <div id="apSteps"></div>
      <p class="ap-steps-foot" id="apAcctExp"></p>
    </nav>
    <form class="ap-card" id="apForm" novalidate>
      <div id="apStep"></div>
      <p class="ap-err" id="apErr" role="alert" hidden></p>
      <div class="ap-actions">
        <button type="button" class="ap-btn ghost" id="apPrev" data-i="prev">이전</button>
        <button type="button" class="ap-btn primary" id="apNext" data-i="next">저장하고 다음으로</button>
      </div>
    </form>
  </main>

  <section class="ap-done" id="apDone" hidden>
    <h2 data-i="doneTitle">지원서가 접수되었습니다</h2>
    <p class="ap-done-lead" id="apDoneLead"></p>
    <table class="ap-receipt">
      <tbody>
        <tr><th scope="row" data-i="refNo">접수 번호</th><td class="ap-no" id="apRefNo">—</td></tr>
        <tr><th scope="row" data-i="submittedAt">제출 일시</th><td id="apWhen">—</td></tr>
        <tr><th scope="row" data-i="stageNow">진행 상황</th><td class="ap-stage" id="apStage">—</td></tr>
      </tbody>
    </table>
    <h3 data-i="refStatusTitle">추천서</h3>
    <table class="ap-refs">
      <thead><tr><th scope="col" data-i="colRef">추천인</th><th scope="col" data-i="colSent">요청 메일</th><th scope="col" data-i="colState">상태</th></tr></thead>
      <tbody id="apRefList"></tbody>
    </table>
    <p class="ap-done-note" data-i="refHelp">추천인께 메일함(스팸함 포함)을 한번 확인해 달라고 말씀드리면 더 빨리 진행됩니다. 추천서 내용은 지원자에게 공개되지 않습니다.</p>
    <h3 data-i="nextTitle">앞으로의 진행</h3>
    <p class="ap-done-next" data-i="nextText">추천서 두 통이 모두 도착하면 검토 담당자가 지원서를 검토하고, 면담 일정은 이메일이나 전화로 따로 연락드립니다.</p>
  </section>

  <footer class="ap-wrap"><div class="ap-foot"><span data-i="org">월코 (Word of Life Korea)</span><span data-i="footNote">이 지원서는 스태프 선발에만 사용됩니다.</span></div></footer>

  <script type="application/json" id="apSchema" set:html={schemaJson}></script>
  <script is:inline src="/apply.js?v=5" defer></script>
</body>
</html>
