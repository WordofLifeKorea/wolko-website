---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="제주 월비 (WOLBI Jeju) — Word of Life Korea"
  description="제주 월비 — 대학 수준의 성경 교육과 제자훈련, 그리고 세계를 경험하는 11개월"
  activeNav="ministry"
>

<!-- WOLBI Jeju 본문 | 한/영 이중언어 | 플로팅 바 분리 버전 -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://cdn.jsdelivr.net/npm/pretendard@latest/dist/web/variable/pretendardvariable-dynamic-subset.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@600;700;800;900&display=swap" rel="stylesheet">

<style>
/* ══ 언어 표시/숨김 ══ */
.wl-ko { display: block; }
.wl-en { display: none; }
span.wl-ko { display: inline; }
span.wl-en { display: none; }
.lang-en .wl-ko { display: none !important; }
.lang-en .wl-en { display: block !important; }
.lang-en span.wl-en { display: inline !important; }

/* ══════════════════════════════════════════════
   WOLBI JEJU — 본문 CSS (.wj-wrap 격리)
══════════════════════════════════════════════ */
.wj-wrap {
  --c-deep:    #004f68;
  --c-mid:     #007ea1;
  --c-light:   #73d1f5;
  --c-red:     #c42a36;
  --c-red-dk:  #a82330;
  --c-white:   #ffffff;
  --c-off:     #f5fafd;
  --c-pale:    #eef7fb;
  --c-text:    #111820;
  --c-sub:     #334a56;
  --c-muted:   #6b8896;
  --c-border:  rgba(0,79,104,0.12);
  --f-serif:   'Plus Jakarta Sans', 'Pretendard Variable', Pretendard, sans-serif;
  --f-sans:    'Pretendard Variable', Pretendard, -apple-system, sans-serif;
  --sp-xs:  8px; --sp-sm: 16px; --sp-md: 24px;
  --sp-lg: 40px; --sp-xl: 64px; --sp-2xl: 96px; --sp-3xl: 140px;
  --max-w: 1100px; --pad-h: 48px;
  font-family: var(--f-sans) !important;
  font-weight: 400;
  color: var(--c-text);
  background: var(--c-white);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
.wj-wrap *, .wj-wrap *::before, .wj-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }
.wj-wrap img { display: block; width: 100%; }
.wj-wrap a { text-decoration: none; color: inherit; }
.wj-wrap ul { list-style: none; }

/* 리빌 */
.wj-wrap .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.7s ease, transform 0.7s ease; }
.wj-wrap .reveal.visible { opacity: 1; transform: none; }
.wj-wrap .reveal-delay-1 { transition-delay: 0.10s; }
.wj-wrap .reveal-delay-2 { transition-delay: 0.20s; }
.wj-wrap .reveal-delay-3 { transition-delay: 0.30s; }

/* 공통 */
.wj-wrap .section { padding: var(--sp-3xl) var(--pad-h); }
.wj-wrap .container { max-width: var(--max-w); margin: 0 auto; }
.wj-wrap .section-label {
  display: inline-flex; align-items: center; gap: var(--sp-sm);
  font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--c-mid); margin-bottom: var(--sp-sm);
}
.wj-wrap .section-label::before { content: ''; width: 14px; height: 2px; background: var(--c-red); flex-shrink: 0; }
.wj-wrap .section-title { font-family: var(--f-serif); font-size: clamp(28px, 4vw, 56px); font-weight: 800; color: var(--c-deep); line-height: 1.1; letter-spacing: -0.035em; }
.wj-wrap .section-desc { font-size: 16px; line-height: 1.9; color: var(--c-sub); max-width: 600px; }
.wj-wrap .accent-line { width: 48px; height: 3px; background: linear-gradient(90deg, var(--c-red), var(--c-mid)); border-radius: 2px; margin: var(--sp-md) 0 var(--sp-lg); }

/* ── HERO ── */
.wj-wrap .hero {
  position: relative; height: 100vh; min-height: 620px;
  background: var(--c-deep); display: flex; align-items: center; overflow: hidden;
}
.wj-wrap .hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 80% 60% at 70% 40%, rgba(0,126,161,0.45) 0%, transparent 70%),
              radial-gradient(ellipse 50% 80% at 10% 80%, rgba(115,209,245,0.10) 0%, transparent 60%);
  pointer-events: none;
}
.wj-wrap .hero-circle { position: absolute; right: -120px; top: -120px; width: 560px; height: 560px; border-radius: 50%; border: 1px solid rgba(115,209,245,0.15); pointer-events: none; }
.wj-wrap .hero-circle::after { content: ''; position: absolute; inset: 60px; border-radius: 50%; border: 1px solid rgba(115,209,245,0.08); }
.wj-wrap .hero-cross { position: absolute; right: 7%; bottom: 12%; opacity: 0.04; font-size: 240px; color: var(--c-white); line-height: 1; user-select: none; pointer-events: none; }
.wj-wrap .hero-inner { position: relative; z-index: 2; width: 100%; max-width: var(--max-w); margin: 0 auto; padding: 0 var(--pad-h); padding-bottom: 120px; }
.wj-wrap .hero-badge {
  display: inline-flex; align-items: center; gap: var(--sp-sm);
  background: rgba(115,209,245,0.12); border: 1px solid rgba(115,209,245,0.28);
  color: var(--c-light); font-size: 11px; font-weight: 500; letter-spacing: 0.2em;
  text-transform: uppercase; padding: 8px 18px; border-radius: 100px; margin-bottom: var(--sp-lg);
}
.wj-wrap .hero-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--c-light); }
.wj-wrap .hero-title { font-family: 'Plus Jakarta Sans', 'Pretendard Variable', sans-serif; font-size: clamp(36px, 5.8vw, 68px); font-weight: 800; color: var(--c-white); line-height: 1.22; letter-spacing: -0.025em; margin-bottom: var(--sp-sm); }
.wj-wrap .hero-title em { font-style: italic; color: var(--c-light); }
.wj-wrap .hero-subtitle { font-size: clamp(14px, 1.8vw, 18px); color: rgba(255,255,255,0.82); font-weight: 400; letter-spacing: 0.03em; margin-bottom: var(--sp-xl); max-width: 600px; }
.wj-wrap .hero-cta-group { display: flex; gap: var(--sp-sm); flex-wrap: wrap; }
.wj-wrap .btn-primary { display: inline-flex; align-items: center; gap: var(--sp-sm); background: #c42a36; color: #fff; font-family: var(--f-sans); font-size: 14px; font-weight: 600; letter-spacing: 0.04em; padding: 15px 30px; border-radius: 4px; transition: background 0.25s, transform 0.2s; }
.wj-wrap .btn-primary:hover { background: #a82330; transform: translateY(-2px); }
.wj-wrap .btn-secondary { display: inline-flex; align-items: center; gap: var(--sp-sm); background: transparent; color: #fff; font-family: var(--f-sans); font-size: 14px; font-weight: 500; letter-spacing: 0.04em; padding: 15px 30px; border-radius: 4px; border: 1.5px solid rgba(255,255,255,0.55); transition: border-color 0.25s, background 0.25s; }
.wj-wrap .btn-secondary:hover { border-color: var(--c-light); background: rgba(115,209,245,0.08); }
.wj-wrap .hero-stats { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,20,32,0.72); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid rgba(115,209,245,0.15); z-index: 3; }
.wj-wrap .hero-stats-inner { max-width: var(--max-w); margin: 0 auto; padding: 0 var(--pad-h); display: flex; align-items: stretch; }
.wj-wrap .hero-stat { flex: 1; padding: var(--sp-md) 0; display: flex; flex-direction: column; gap: 4px; border-right: 1px solid rgba(115,209,245,0.12); }
.wj-wrap .hero-stat:first-child { padding-right: var(--sp-lg); }
.wj-wrap .hero-stat:not(:first-child) { padding-left: var(--sp-lg); }
.wj-wrap .hero-stat:last-child { border-right: none; }
.wj-wrap .hero-stat-num { font-family: var(--f-serif); font-size: 26px; font-weight: 700; color: var(--c-light); line-height: 1; }
.wj-wrap .hero-stat-label { font-size: 12px; color: rgba(255,255,255,0.72); font-weight: 400; }
.wj-wrap .hero-scroll { position: absolute; bottom: 88px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: var(--sp-xs); color: rgba(255,255,255,0.35); font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase; z-index: 2; }
.wj-wrap .hero-scroll-line { width: 1px; height: 36px; background: linear-gradient(to bottom, rgba(255,255,255,0.35), transparent); animation: wj-pulse 2s ease-in-out infinite; }
@keyframes wj-pulse { 0%,100%{opacity:.35} 50%{opacity:.85} }

/* ── INTRO ── */
.wj-wrap .intro { background: var(--c-white); }
.wj-wrap .intro-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3xl); align-items: center; max-width: var(--max-w); margin: 0 auto; }
.wj-wrap .intro-img-wrap { position: relative; }
.wj-wrap .intro-img { width: 100%; aspect-ratio: 4/5; object-fit: cover; border-radius: 8px; display: block; position: relative; z-index: 1; }
.wj-wrap .intro-img-frame { position: absolute; top: -20px; right: -20px; bottom: 20px; left: 20px; border: 2px solid rgba(0,126,161,0.15); border-radius: 8px; pointer-events: none; }
.wj-wrap .intro-quote { position: absolute; bottom: -24px; right: -24px; background: var(--c-deep); color: var(--c-white); padding: var(--sp-md) var(--sp-lg); border-radius: 6px; max-width: 240px; z-index: 2; box-shadow: 0 16px 48px rgba(0,30,45,0.25); }
.wj-wrap .intro-quote-icon { font-family: var(--f-serif); font-size: 48px; line-height: 1; color: var(--c-light); opacity: 0.5; margin-bottom: var(--sp-xs); }
.wj-wrap .intro-quote-text { font-size: 13px; font-style: italic; line-height: 1.65; color: rgba(255,255,255,0.82); }
.wj-wrap .intro-quote-source { font-size: 11px; color: var(--c-light); margin-top: var(--sp-sm); font-weight: 500; letter-spacing: 0.06em; }

/* ── HIGHLIGHTS ── */
.wj-wrap .highlights { background: var(--c-deep); padding: var(--sp-3xl) var(--pad-h); position: relative; overflow: hidden; }
.wj-wrap .highlights::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 100% at 90% 50%, rgba(0,126,161,0.35) 0%, transparent 60%); pointer-events: none; }
.wj-wrap .highlights-inner { position: relative; z-index: 1; max-width: var(--max-w); margin: 0 auto; }
.wj-wrap .highlights-top { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--sp-2xl); gap: var(--sp-md); }
.wj-wrap .highlights-title { font-family: var(--f-serif); font-size: clamp(26px, 3.5vw, 48px); color: var(--c-white); line-height: 1.1; font-weight: 800; letter-spacing: -0.035em; }
.wj-wrap .highlights-sub { font-size: 14px; color: rgba(255,255,255,0.52); line-height: 1.75; max-width: 300px; text-align: right; }
.wj-wrap .highlights-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(115,209,245,0.12); border-radius: 8px; overflow: hidden; }
.wj-wrap .hi-card { background: rgba(0,10,20,0.35); padding: var(--sp-xl) var(--sp-lg); display: flex; flex-direction: column; gap: var(--sp-sm); transition: background 0.3s; }
.wj-wrap .hi-card:hover { background: rgba(0,126,161,0.25); }
.wj-wrap .hi-icon { width: 44px; height: 44px; border-radius: 8px; background: rgba(115,209,245,0.12); display: flex; align-items: center; justify-content: center; margin-bottom: var(--sp-xs); }
.wj-wrap .hi-icon svg { width: 22px; height: 22px; stroke: var(--c-light); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.wj-wrap .hi-num { font-family: var(--f-serif); font-size: 34px; font-weight: 700; color: var(--c-light); line-height: 1; }
.wj-wrap .hi-label { font-size: 14px; font-weight: 500; color: var(--c-white); }
.wj-wrap .hi-desc { font-size: 13px; color: rgba(255,255,255,0.70); line-height: 1.7; font-weight: 400; }

/* ── ACADEMICS ── */
.wj-wrap .academics { background: var(--c-off); }
.wj-wrap .academics-layout { display: grid; grid-template-columns: 320px 1fr; gap: var(--sp-3xl); align-items: start; max-width: var(--max-w); margin: 0 auto; }
.wj-wrap .academics-sticky { position: sticky; top: 100px; }
.wj-wrap .academics-courses { display: flex; flex-direction: column; gap: 4px; }
.wj-wrap .course-item { display: grid; grid-template-columns: 52px 1fr; background: var(--c-white); border-radius: 6px; overflow: hidden; border: 1px solid var(--c-border); transition: box-shadow 0.25s, transform 0.25s; }
.wj-wrap .course-item:hover { transform: translateX(4px); box-shadow: 0 4px 24px rgba(0,79,104,0.10); }
.wj-wrap .course-num { background: var(--c-deep); color: rgba(255,255,255,0.38); font-size: 11px; font-weight: 600; display: flex; align-items: center; justify-content: center; writing-mode: vertical-lr; letter-spacing: 0.1em; padding: var(--sp-sm) 0; }
.wj-wrap .course-body { padding: var(--sp-md); }
.wj-wrap .course-name { font-size: 15px; font-weight: 600; color: var(--c-deep); margin-bottom: var(--sp-xs); }
.wj-wrap .course-desc { font-size: 13px; color: var(--c-muted); line-height: 1.65; }
.wj-wrap .course-tag { display: inline-block; margin-top: var(--sp-sm); font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-mid); background: var(--c-pale); padding: 3px 10px; border-radius: 100px; }

/* ── TRIPS ── */
.wj-wrap .trips { background: var(--c-white); }
.wj-wrap .trips-header { text-align: center; margin-bottom: var(--sp-2xl); max-width: var(--max-w); margin-left: auto; margin-right: auto; }
.wj-wrap .trips-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-md); max-width: var(--max-w); margin: 0 auto; }
.wj-wrap .trip-card { border-radius: 10px; overflow: hidden; border: 1px solid var(--c-border); background: var(--c-white); transition: box-shadow 0.3s, transform 0.3s; }
.wj-wrap .trip-card:hover { box-shadow: 0 16px 48px rgba(0,79,104,0.12); transform: translateY(-4px); }
.wj-wrap .trip-img { aspect-ratio: 16/10; object-fit: cover; display: block; width: 100%; }
.wj-wrap .trip-body { padding: var(--sp-lg) var(--sp-lg) var(--sp-xl); }
.wj-wrap .trip-flag { font-size: 26px; margin-bottom: var(--sp-sm); }
.wj-wrap .trip-title { font-family: var(--f-serif); font-size: 20px; font-weight: 700; color: var(--c-deep); margin-bottom: var(--sp-sm); }
.wj-wrap .trip-desc { font-size: 14px; color: var(--c-sub); line-height: 1.8; }
.wj-wrap .trip-when { display: inline-flex; align-items: center; gap: 6px; margin-top: var(--sp-md); font-size: 11px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-red); }

/* ── ADMISSION ── */
.wj-wrap .admission { background: var(--c-pale); }
.wj-wrap .admission-header { max-width: var(--max-w); margin: 0 auto var(--sp-2xl); }
.wj-wrap .admission-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-md); max-width: var(--max-w); margin: 0 auto; }
.wj-wrap .adm-card { background: var(--c-white); border-radius: 10px; padding: var(--sp-xl); border: 1px solid var(--c-border); position: relative; overflow: hidden; }
.wj-wrap .adm-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--c-deep), var(--c-mid)); }
.wj-wrap .adm-card-num { font-family: var(--f-serif); font-size: 56px; font-weight: 700; color: rgba(0,79,104,0.06); line-height: 1; position: absolute; top: var(--sp-sm); right: var(--sp-md); }
.wj-wrap .adm-card-title { font-size: 17px; font-weight: 600; color: var(--c-deep); margin-bottom: var(--sp-md); padding-top: 4px; }
.wj-wrap .adm-list { display: flex; flex-direction: column; gap: var(--sp-sm); }
.wj-wrap .adm-list li { display: flex; gap: var(--sp-sm); font-size: 14px; color: var(--c-sub); line-height: 1.65; }
.wj-wrap .adm-list li::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--c-mid); flex-shrink: 0; margin-top: 7px; }

/* ── ACCREDITATION ── */
.wj-wrap .accred { background: var(--c-deep); padding: var(--sp-2xl) var(--pad-h); }
.wj-wrap .accred-inner { max-width: var(--max-w); margin: 0 auto; display: flex; align-items: center; gap: var(--sp-3xl); }
.wj-wrap .accred-badge { flex-shrink: 0; width: 112px; height: 112px; border-radius: 50%; border: 2px solid rgba(115,209,245,0.3); display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 4px; text-align: center; padding: var(--sp-sm); }
.wj-wrap .accred-badge-main { font-family: var(--f-serif); font-size: 20px; font-weight: 700; color: var(--c-light); line-height: 1; }
.wj-wrap .accred-badge-sub { font-size: 9px; color: rgba(255,255,255,0.48); letter-spacing: 0.1em; font-weight: 500; }
.wj-wrap .accred-title { font-family: var(--f-serif); font-size: 26px; font-weight: 700; color: var(--c-white); margin-bottom: var(--sp-sm); }
.wj-wrap .accred-desc { font-size: 14px; color: rgba(255,255,255,0.58); line-height: 1.85; max-width: 680px; }
.wj-wrap .accred-links { display: flex; gap: var(--sp-md); margin-top: var(--sp-md); flex-wrap: wrap; }
.wj-wrap .accred-link { font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #73d1f5; display: inline-flex; align-items: center; gap: 6px; transition: color 0.2s; }
.wj-wrap .accred-link:hover { color: #fff; }
.wj-wrap .accred-link::after { content: '→'; font-size: 14px; }

/* ── TESTIMONIALS ── */
.wj-wrap .testimonials { background: var(--c-pale); padding: var(--sp-3xl) var(--pad-h); }
.wj-wrap .testimonials-inner { max-width: var(--max-w); margin: 0 auto; }
.wj-wrap .testimonials-header { text-align: center; margin-bottom: var(--sp-2xl); }
.wj-wrap .testimonials-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-md); }
.wj-wrap .testi-card { background: var(--c-white); border-radius: 10px; padding: var(--sp-xl) var(--sp-lg); border: 1px solid var(--c-border); position: relative; }
.wj-wrap .testi-card::before { content: '"'; font-family: var(--f-serif); font-size: 64px; line-height: 1; color: var(--c-light); opacity: 0.5; position: absolute; top: var(--sp-sm); left: var(--sp-md); }
.wj-wrap .testi-text { font-size: 14px; font-style: italic; color: var(--c-sub); line-height: 1.9; margin-bottom: var(--sp-md); padding-top: var(--sp-xl); }
.wj-wrap .testi-author { display: flex; align-items: center; gap: var(--sp-sm); }
.wj-wrap .testi-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--c-deep); display: flex; align-items: center; justify-content: center; font-family: var(--f-serif); font-weight: 700; font-size: 15px; color: var(--c-light); flex-shrink: 0; }
.wj-wrap .testi-name { font-size: 13px; font-weight: 600; color: var(--c-deep); }
.wj-wrap .testi-origin { font-size: 11px; color: var(--c-muted); margin-top: 2px; }

/* ── CTA ── */
.wj-wrap .cta-section { background: var(--c-white); padding: var(--sp-3xl) var(--pad-h); }
.wj-wrap .cta-inner { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3xl); align-items: start; }
.wj-wrap .cta-text .section-desc { margin-top: var(--sp-md); }
.wj-wrap .cta-cards { display: flex; flex-direction: column; gap: var(--sp-sm); }
.wj-wrap .cta-card { background: var(--c-off); border: 1px solid var(--c-border); border-radius: 8px; padding: var(--sp-md) var(--sp-lg); display: flex; align-items: center; gap: var(--sp-md); transition: background 0.25s, border-color 0.25s, transform 0.2s; cursor: pointer; }
.wj-wrap .cta-card:hover { background: var(--c-pale); border-color: var(--c-mid); transform: translateX(4px); }
.wj-wrap .cta-card-icon { width: 48px; height: 48px; border-radius: 8px; background: var(--c-deep); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.wj-wrap .cta-card-icon svg { width: 22px; height: 22px; stroke: var(--c-light); fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.wj-wrap .cta-card-label { font-size: 14px; font-weight: 600; color: var(--c-deep); margin-bottom: 3px; }
.wj-wrap .cta-card-sub { font-size: 12px; color: var(--c-muted); }
.wj-wrap .cta-card-arrow { margin-left: auto; color: var(--c-muted); font-size: 18px; transition: color 0.2s, transform 0.2s; }
.wj-wrap .cta-card:hover .cta-card-arrow { color: var(--c-mid); transform: translateX(4px); }

/* ── CONTACT BAR ── */
.wj-wrap .contact-bar { background: var(--c-deep); padding: var(--sp-lg) var(--pad-h); }
.wj-wrap .contact-bar-inner { max-width: var(--max-w); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-md); flex-wrap: wrap; }
.wj-wrap .contact-bar-label { font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-light); margin-bottom: 6px; }
