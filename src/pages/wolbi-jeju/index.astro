<script is:inline>
  // 제주 월비 움직임: 스크롤하면 사진은 살짝 당겨지며 자리 잡고, 글은 아래에서 차례로 떠오른다.
  // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
  (function () {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var items = [].slice.call(document.querySelectorAll(
      '.wj-wrap .wj-split-media, .wj-wrap .wj-split-body > *, .wj-wrap .wj-head > *, .wj-wrap .wj-hl, ' +
      '.wj-wrap .wj-acad-side > *, .wj-wrap .wj-course, .wj-wrap .wj-trip, .wj-wrap .wj-adm, ' +
      '.wj-wrap .wj-accred-inner > *, .wj-wrap .wj-testi, .wj-wrap .wj-closing-top > *, .wj-wrap .wj-closing-contact'
    ));
    items.forEach(function (el) {
      var sib = el.parentNode.children, i = [].indexOf.call(sib, el);
      el.style.setProperty('--d', Math.min(i, 6) * 0.08 + 's');
      el.classList.add('wj-rv');
    });
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    items.forEach(function (el) { io.observe(el); });
  })();
</script>

