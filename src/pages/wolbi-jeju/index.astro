---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="WOLBI 제주 — Word of Life Korea"
  description="성경을 삶으로 살아내는 1년 — 제주 월비 성경대학 입학 안내, 커리큘럼, 선교 여행"
  activeNav="ministry"
>

<style>
  :root {
    --c-deep: #004f68; --c-mid: #0a5b76; --c-light: #73d1f5;
    --c-bg: #f4f8fb; --c-white: #ffffff;
    --c-text: #152028; --c-muted: #5b6b78;
    --c-line: rgba(0,79,104,0.12);
    --r-xl: 28px; --r-lg: 20px; --r-md: 14px;
  }

  /* ── HERO ── */
  .hero {
    position:relative; overflow:hidden;
    padding:160px 24px 100px; text-align:center;
    background:
      linear-gradient(180deg, rgba(5,24,36,0.40) 0%, rgba(5,24,36,0.60) 100%),
      url("https://wolko.synology.me/Web_Contents/Photos/WOLBI_Jeju/WOLBI_Banner.jpg") center / cover no-repeat;
    background-color:#083d51;
  }
  .hero::before {
    content:""; position:absolute; inset:0;
    background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);
    background-size:60px 60px; pointer-events:none;
  }
  .hero-inner { position:relative; z-index:2; max-width:880px; margin:0 auto; }
  .hero-eyebrow {
    display:inline-flex; align-items:center; gap:8px; padding:7px 16px; border-radius:999px;
    background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.22);
    font-size:11px; font-weight:800; letter-spacing:0.09em; color:rgba(255,255,255,0.9);
    margin-bottom:22px; text-transform:uppercase;
  }
  .hero-eyebrow-dot { width:6px; height:6px; border-radius:50%; background:var(--c-light); }
  .hero-inner h1 {
    font-size:clamp(38px,6vw,64px); font-weight:800; line-height:1.12;
    letter-spacing:-0.04em; color:#fff; margin-bottom:18px;
    text-shadow:0 6px 24px rgba(0,0,0,0.26);
  }
  .hero-inner h1 em { font-style:normal; color:#9ae3ff; display:block; }
  .hero-sub { font-size:17px; line-height:1.88; color:rgba(255,255,255,0.82); max-width:660px; margin:0 auto 32px; }
  .hero-btns { display:flex; justify-content:center; gap:12px; flex-wrap:wrap; margin-top:30px; }
  .btn-primary {
    display:inline-flex; align-items:center; gap:8px; padding:15px 28px; border-radius:999px;
    background:#fff; color:var(--c-deep); font-size:14px; font-weight:800;
    text-decoration:none; box-shadow:0 10px 28px rgba(0,0,0,0.18); transition:transform .18s, box-shadow .18s;
  }
  .btn-primary:hover { transform:translateY(-2px); box-shadow:0 16px 36px rgba(0,0,0,0.22); }
  .btn-outline {
    display:inline-flex; align-items:center; gap:8px; padding:15px 28px; border-radius:999px;
    background:transparent; border:2px solid rgba(255,255,255,0.5); color:#fff;
    font-size:14px; font-weight:800; text-decoration:none; transition:background .18s, border-color .18s;
  }
  .btn-outline:hover { background:rgba(255,255,255,0.1); border-color:rgba(255,255,255,0.8); }

  .hero-stats {
    position:relative; z-index:2; display:flex; justify-content:center;
    margin:56px auto 0; max-width:800px;
    background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.16);
    border-radius:18px; backdrop-filter:blur(8px); overflow:hidden;
  }
  .hero-stat { flex:1; padding:20px 14px; text-align:center; border-right:1px solid rgba(255,255,255,0.12); }
  .hero-stat:last-child { border-right:none; }
  .hero-stat-num { font-size:26px; font-weight:800; letter-spacing:-0.04em; color:#fff; display:block; line-height:1; margin-bottom:5px; }
  .hero-stat-label { font-size:11px; font-weight:700; color:rgba(255,255,255,0.68); line-height:1.35; }

  /* ── SECTIONS ── */
  .section { padding:96px 24px; }
  .section--alt { background:var(--c-bg); }
  .page-wrap { max-width:1140px; margin:0 auto; }

  .sec-badge {
    display:inline-block; padding:7px 14px; border-radius:999px;
    background:rgba(0,79,104,0.08); color:var(--c-deep);
    font-size:11px; font-weight:800; letter-spacing:0.06em;
  }
  .sec-title {
    font-size:clamp(28px,4vw,44px); font-weight:800; line-height:1.2;
    letter-spacing:-0.035em; color:var(--c-text); margin:14px 0 16px;
  }
  .sec-desc { font-size:16px; line-height:1.9; color:var(--c-muted); max-width:700px; }

  .quote-bar {
    background:linear-gradient(135deg, #083d51 0%, var(--c-deep) 100%);
    padding:36px 24px; text-align:center;
  }
  .quote-text { font-size:18px; font-style:italic; color:rgba(255,255,255,0.92); max-width:680px; margin:0 auto 10px; line-height:1.7; }
  .quote-attr { font-size:12px; font-weight:700; letter-spacing:0.06em; color:rgba(255,255,255,0.55); text-transform:uppercase; }

  /* Features */
  .features-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px; margin-top:48px; }
  .feature-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-xl);
    padding:32px 28px; box-shadow:0 4px 20px rgba(0,79,104,0.07);
    display:flex; flex-direction:column; gap:12px;
    transition:transform .22s, box-shadow .22s;
  }
  .feature-card:hover { transform:translateY(-4px); box-shadow:0 12px 36px rgba(0,79,104,0.14); }
  .feature-icon { font-size:26px; }
  .feature-tag { font-size:11px; font-weight:800; letter-spacing:0.06em; color:var(--c-mid); text-transform:uppercase; }
  .feature-title { font-size:18px; font-weight:800; color:var(--c-text); }
  .feature-desc { font-size:14px; line-height:1.82; color:var(--c-muted); }

  /* Courses */
  .courses-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:16px; margin-top:48px; }
  .course-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-lg);
    padding:24px 26px; box-shadow:0 3px 14px rgba(0,79,104,0.06);
    display:flex; flex-direction:column; gap:10px;
    transition:transform .2s, box-shadow .2s;
  }
  .course-card:hover { transform:translateY(-3px); box-shadow:0 10px 28px rgba(0,79,104,0.12); }
  .course-tag {
    display:inline-block; padding:4px 10px; border-radius:999px;
    background:rgba(0,79,104,0.08); color:var(--c-deep); font-size:11px; font-weight:800;
    width:fit-content;
  }
  .course-title { font-size:15px; font-weight:800; color:var(--c-text); }
  .course-desc { font-size:13px; line-height:1.78; color:var(--c-muted); }

  /* Trips */
  .trips-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(300px,1fr)); gap:20px; margin-top:48px; }
  .trip-card {
    border-radius:var(--r-xl); overflow:hidden;
    box-shadow:0 6px 28px rgba(0,79,104,0.10);
    transition:transform .22s, box-shadow .22s;
  }
  .trip-card:hover { transform:translateY(-4px); box-shadow:0 14px 40px rgba(0,79,104,0.16); }
  .trip-head {
    padding:28px 28px 22px;
    background:linear-gradient(135deg, var(--c-deep) 0%, var(--c-mid) 100%);
    position:relative; overflow:hidden;
  }
  .trip-head::after { content:""; position:absolute; right:-30px; bottom:-36px; width:120px; height:120px; border-radius:50%; background:rgba(255,255,255,0.07); }
  .trip-timing { font-size:11px; font-weight:800; letter-spacing:0.07em; color:rgba(255,255,255,0.6); text-transform:uppercase; margin-bottom:8px; }
  .trip-title { font-size:22px; font-weight:800; color:#fff; position:relative; z-index:1; }
  .trip-body { background:var(--c-white); padding:24px 28px; }
  .trip-desc { font-size:14px; line-height:1.85; color:var(--c-muted); }

  /* Testimonials */
  .testimonials-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:18px; margin-top:48px; }
  .testimonial-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-xl);
    padding:30px 28px; box-shadow:0 4px 18px rgba(0,79,104,0.06);
    display:flex; flex-direction:column; gap:14px;
    transition:transform .22s, box-shadow .22s;
  }
  .testimonial-card:hover { transform:translateY(-4px); box-shadow:0 12px 32px rgba(0,79,104,0.12); }
  .testimonial-quote { font-size:30px; color:var(--c-light); font-weight:900; line-height:1; }
  .testimonial-text { font-size:14.5px; line-height:1.9; color:#3a4e58; font-style:italic; flex:1; }
  .testimonial-origin { font-size:12px; font-weight:800; color:var(--c-deep); padding-top:10px; border-top:1px solid var(--c-line); }

  /* Admission */
  .admit-grid { display:grid; grid-template-columns:1fr 1fr 1fr; gap:20px; margin-top:48px; }
  .admit-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-xl);
    padding:28px 24px; box-shadow:0 3px 14px rgba(0,79,104,0.06);
  }
  .admit-card h4 { font-size:16px; font-weight:800; color:var(--c-deep); margin-bottom:16px; }
  .admit-list { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:8px; }
  .admit-list li { font-size:13.5px; line-height:1.7; color:var(--c-muted); padding-left:16px; position:relative; }
  .admit-list li::before { content:"·"; position:absolute; left:0; color:var(--c-mid); font-weight:800; }

  /* Accreditation */
  .accred-card {
    background:linear-gradient(135deg, var(--c-deep) 0%, var(--c-mid) 100%);
    border-radius:var(--r-xl); padding:40px 44px; margin-top:48px;
    display:flex; align-items:flex-start; gap:32px; flex-wrap:wrap;
    box-shadow:0 8px 36px rgba(0,79,104,0.22);
  }
  .accred-badge {
    flex-shrink:0; width:72px; height:72px; border-radius:50%; background:rgba(255,255,255,0.15);
    border:2px solid rgba(255,255,255,0.3); display:flex; align-items:center; justify-content:center;
    font-size:28px;
  }
  .accred-content { flex:1; min-width:200px; }
  .accred-label { font-size:11px; font-weight:800; letter-spacing:0.08em; color:rgba(255,255,255,0.6); text-transform:uppercase; margin-bottom:8px; }
  .accred-title { font-size:22px; font-weight:800; color:#fff; margin-bottom:12px; }
  .accred-desc { font-size:14px; line-height:1.82; color:rgba(255,255,255,0.78); }

  /* CTA section */
  .cta-section { background:linear-gradient(135deg, #083d51 0%, var(--c-deep) 100%); padding:88px 24px; text-align:center; }
  .cta-section h2 { font-size:clamp(28px,3.5vw,42px); font-weight:800; color:#fff; margin-bottom:14px; letter-spacing:-0.03em; }
  .cta-section p { font-size:16px; color:rgba(255,255,255,0.78); max-width:580px; margin:0 auto 40px; line-height:1.85; }
  .cta-cards { display:flex; justify-content:center; gap:16px; flex-wrap:wrap; margin-bottom:30px; }
  .cta-card {
    background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.2);
    border-radius:var(--r-lg); padding:24px 28px; text-align:left; min-width:200px;
    text-decoration:none; transition:background .18s, transform .18s; display:block;
  }
  .cta-card:hover { background:rgba(255,255,255,0.18); transform:translateY(-2px); }
  .cta-card-title { font-size:15px; font-weight:800; color:#fff; margin-bottom:6px; }
  .cta-card-desc { font-size:12px; color:rgba(255,255,255,0.6); }
  .cta-contact { font-size:13px; color:rgba(255,255,255,0.65); line-height:2; }
  .cta-contact a { color:rgba(255,255,255,0.88); font-weight:700; text-decoration:none; }
  .btn-white {
    display:inline-flex; align-items:center; gap:8px; padding:16px 30px; border-radius:999px;
    background:#fff; color:var(--c-deep); font-size:15px; font-weight:800;
    text-decoration:none; box-shadow:0 8px 24px rgba(0,0,0,0.18); margin-top:28px;
    transition:transform .18s, box-shadow .18s;
  }
  .btn-white:hover { transform:translateY(-2px); box-shadow:0 14px 32px rgba(0,0,0,0.22); }

  .lang-en .wl-ko { display:none; }
  body:not(.lang-en) .wl-en { display:none; }

  @media (max-width:768px) {
    .admit-grid { grid-template-columns:1fr; }
    .accred-card { padding:28px 24px; }
  }
</style>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">
      <span class="hero-eyebrow-dot"></span>
      <span>WOLBI JEJU · Word of Life Bible Institute</span>
    </div>
    <h1>
      <span class="wl-ko">성경을 삶으로 살아내는<em>1년</em></span>
      <span class="wl-en">One Year of<em>Living the Word</em></span>
    </h1>
    <p class="hero-sub">
      <span class="wl-ko">제주 월비 — 대학 수준의 성경 교육과 제자훈련, 그리고 세계를 경험하는 11개월</span>
      <span class="wl-en">WOLBI Jeju — 11 months of college-level Bible education, discipleship training, and global experience</span>
    </p>
    <div class="hero-btns">
      <a href="https://wolbi.org" target="_blank" rel="noopener" class="btn-primary">
        <span class="wl-ko">캠퍼스데이 신청하기 →</span>
        <span class="wl-en">Apply for Campus Day →</span>
      </a>
      <a href="#about" class="btn-outline">
        <span class="wl-ko">더 알아보기</span>
        <span class="wl-en">Learn More</span>
      </a>
    </div>
  </div>
  <div class="hero-stats">
    <div class="hero-stat">
      <span class="hero-stat-num">11</span>
      <div class="hero-stat-label"><span class="wl-ko">개월 집중<br>성경 커리큘럼</span><span class="wl-en">Months Intensive<br>Bible Curriculum</span></div>
    </div>
    <div class="hero-stat">
      <span class="hero-stat-num">5</span>
      <div class="hero-stat-label"><span class="wl-ko">개 대륙<br>10개 캠퍼스 네트워크</span><span class="wl-en">Continents<br>10-Campus Network</span></div>
    </div>
    <div class="hero-stat">
      <span class="hero-stat-num">66</span>
      <div class="hero-stat-label"><span class="wl-ko">권 성경<br>전권 학습</span><span class="wl-en">Books<br>Full Bible Study</span></div>
    </div>
    <div class="hero-stat">
      <span class="hero-stat-num">3</span>
      <div class="hero-stat-label"><span class="wl-ko">개국<br>선교 여행</span><span class="wl-en">Countries<br>Mission Trips</span></div>
    </div>
  </div>
</section>

<!-- QUOTE -->
<div class="quote-bar">
  <p class="quote-text">
    <span class="wl-ko">"월비에서 보낸 1년은 제 생애 최고의 해였습니다."</span>
    <span class="wl-en">"The year I spent at WOLBI was the best year of my life."</span>
  </p>
  <p class="quote-attr">
    <span class="wl-ko">— 졸업생 간증</span>
    <span class="wl-en">— WOLBI Graduate</span>
  </p>
</div>

<!-- ABOUT -->
<section id="about" class="section section--alt">
  <div class="page-wrap">
    <span class="sec-badge"><span class="wl-ko">WOLBI JEJU 소개</span><span class="wl-en">About WOLBI Jeju</span></span>
    <h2 class="sec-title">
      <span class="wl-ko">아름다운 제주에서 성경의 깊이를 만나다</span>
      <span class="wl-en">Encounter the Depths of Scripture on Jeju Island</span>
    </h2>
    <p class="sec-desc">
      <span class="wl-ko">제주 월비(WOLBI, Word of Life Bible Institute)는 대학교 과정에 준하는 체계적인 성경 교육과 제자훈련을 통해, 하나님의 말씀 위에 굳게 세워진 다음 세대를 준비시키는 사역입니다.</span>
      <span class="wl-en">WOLBI Jeju is a ministry that prepares the next generation to stand firmly on God's Word, through systematic Bible education and discipleship training at the college level.</span>
    </p>
    <p class="sec-desc" style="margin-top:16px;">
      <span class="wl-ko">세계 5개 대륙 10개 캠퍼스 네트워크의 일부로서, 제주 캠퍼스는 한국·미국·캐나다·대만·일본 등 각국의 청년들이 11개월 동안 성경 66권과 조직신학 전 과정을 함께 배우고, 선교 여행과 사역 훈련을 통해 삶의 변화를 경험하는 곳입니다.</span>
      <span class="wl-en">As part of a global network spanning 10 campuses across 5 continents, the Jeju campus brings together young people from Korea, the United States, Canada, Taiwan, Japan, and beyond — studying all 66 books of the Bible and the full scope of systematic theology over 11 months, while experiencing life transformation through mission trips and ministry training.</span>
    </p>
  </div>
</section>

<!-- UNIQUE FEATURES -->
<section class="section">
  <div class="page-wrap">
    <span class="sec-badge"><span class="wl-ko">제주 월비만의 특별한 경험</span><span class="wl-en">What Makes WOLBI Jeju Unique</span></span>
    <h2 class="sec-title">
      <span class="wl-ko">1년간 말씀을 배우고, 사역 안에서 성장하고, 다양한 문화를 경험해 보세요</span>
      <span class="wl-en">Study the Word, grow through ministry, and experience the world — all in one year</span>
    </h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">📖</div>
        <div class="feature-tag"><span class="wl-ko">성경</span><span class="wl-en">Bible</span></div>
        <div class="feature-title"><span class="wl-ko">성경 전권 학습</span><span class="wl-en">All 66 Books</span></div>
        <div class="feature-desc"><span class="wl-ko">구약·신약 전 66권을 세계적 성경 학자들에게 직접 배우며, 연간 성경을 3독에 가깝게 읽어냅니다.</span><span class="wl-en">Study all 66 books under world-class Bible scholars, reading through nearly the entire Bible three times over the course of the year.</span></div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">✈️</div>
        <div class="feature-tag"><span class="wl-ko">선교</span><span class="wl-en">Mission</span></div>
        <div class="feature-title"><span class="wl-ko">해외 선교 여행</span><span class="wl-en">Mission Trips</span></div>
        <div class="feature-desc"><span class="wl-ko">태국·베트남 선교 여행(12월), 이스라엘 성지 순례(3월)로 하나님의 말씀이 살아있는 현장을 직접 경험합니다.</span><span class="wl-en">Mission trips to Thailand and Vietnam in December, and a Holy Land pilgrimage to Israel in March — experience the living Word in the places where it all happened.</span></div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🌏</div>
        <div class="feature-tag"><span class="wl-ko">다문화</span><span class="wl-en">Global</span></div>
        <div class="feature-title"><span class="wl-ko">다국적 학생 공동체</span><span class="wl-en">Multicultural Community</span></div>
        <div class="feature-desc"><span class="wl-ko">북미 1/3, 한국 1/3, 아시아·기타 1/3로 구성된 다양한 문화권의 청년들이 함께 신앙 공동체를 이룹니다.</span><span class="wl-en">Roughly one-third from North America, one-third from Korea, and one-third from Asia and beyond — a vibrant, faith-filled community from around the world.</span></div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🎓</div>
        <div class="feature-tag"><span class="wl-ko">학점</span><span class="wl-en">Credit</span></div>
        <div class="feature-title"><span class="wl-ko">학점 인정 교육과정</span><span class="wl-en">College Credit Transfer</span></div>
        <div class="feature-desc"><span class="wl-ko">미국·캐나다 대부분의 기독교 대학에서 1년 학점으로 인정되며, 뉴욕 본교 2학년으로의 편입도 가능합니다.</span><span class="wl-en">Credits are recognized at most Christian colleges in the U.S. and Canada, and transfer as a full first year. Students may also transfer into the second year at the New York home campus.</span></div>
      </div>
    </div>
  </div>
</section>

<!-- CURRICULUM -->
<section class="section section--alt">
  <div class="page-wrap">
