      <span class="wl-ko">캠퍼스데이 신청 →</span>
      <span class="wl-en">Apply for Campus Day →</span>
    </a>
  </div>
</div>

</div><!-- /#wl-root -->

<script>
/* ── reveal 애니메이션 ── */
var obs = new IntersectionObserver(function(entries) {
  entries.forEach(function(e) {
    if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
  });
}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.wj-wrap .reveal').forEach(function(el) { obs.observe(el); });

/* ── 언어 초기화 (플로팅 바 wlToggle과 연동) ── */
try {
  if (localStorage.getItem('wolko-lang') === 'en') {
    document.getElementById('wl-root').classList.add('lang-en');
  }
} catch(e) {}
</script>

</BaseLayout>
