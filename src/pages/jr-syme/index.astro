---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Jr. SYME — Word of Life Korea"
  description="중·고등학생을 위한 영어 제자훈련 집중 프로그램. 말씀과 훈련으로 가득한 3주."
  activeNav="ministry"
>

<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;800;900&family=Plus+Jakarta+Sans:ital,wght@0,700;0,800;1,700&display=swap');

.jr {
  --jc-deep:  #004f68;
  --jc-mid:   #007ea1;
  --jc-light: #73d1f5;
  --jc-ink:   #152028;
  --jc-muted: #637a86;
  --jc-line:  #dde6ea;
  --jc-bg:    #f5f8fa;
  font-family: 'Noto Sans KR', 'Apple SD Gothic Neo', sans-serif;
  color: var(--jc-ink);
  word-break: keep-all;
  -webkit-font-smoothing: antialiased;
}
/* 언어 토글 */
.jr .wl-en         { display: none; }
.jr span.wl-en     { display: none; }
.lang-en .jr .wl-ko    { display: none !important; }
.lang-en .jr .wl-en    { display: block !important; }
.lang-en .jr span.wl-ko { display: none !important; }
.lang-en .jr span.wl-en { display: inline !important; }

/* ──────────────────────────────
   HERO
────────────────────────────── */
.jr-hero {
  background: #03334a;
  padding: 148px 40px 80px;
  position: relative;
  overflow: hidden;
}
.jr-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(ellipse at 80% -10%, rgba(115,209,245,0.18) 0%, transparent 50%);
  pointer-events: none;
}
.jr-hero-inner {
  max-width: 860px;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}
.jr-hero-eyebrow {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.14em;
  color: var(--jc-light);
  opacity: 0.8;
  text-transform: uppercase;
  margin-bottom: 20px;
}
.jr-hero-title {
  font-family: 'Plus Jakarta Sans', 'Noto Sans KR', 'Apple SD Gothic Neo', sans-serif;
  font-size: clamp(42px, 5.5vw, 68px);
  font-weight: 700;
  letter-spacing: -0.025em;
  line-height: 1.05;
  color: #fff;
  margin-bottom: 22px;
}
.jr-hero-title em { font-style: normal; color: var(--jc-light); }
.jr-hero-sub {
  font-size: clamp(15px, 1.8vw, 17px);
  line-height: 1.9;
  color: rgba(255,255,255,0.62);
  max-width: 500px;
}

/* ──────────────────────────────
   STATS BAR
────────────────────────────── */
.jr-statsbar {
  background: var(--jc-deep);
}
.jr-statsbar-inner {
  max-width: 860px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
}
.jr-sbar {
  padding: 28px 32px;
  border-right: 1px solid rgba(255,255,255,0.1);
  text-align: center;
}
.jr-sbar:last-child { border-right: none; }
.jr-sbar-num {
  font-size: 28px;
  font-weight: 900;
  letter-spacing: -0.04em;
  color: #fff;
  line-height: 1;
  margin-bottom: 5px;
}
.jr-sbar-unit { font-size: 16px; font-weight: 700; }
.jr-sbar-label { font-size: 12px; font-weight: 500; color: rgba(255,255,255,0.5); }

/* ──────────────────────────────
   NOTICE
────────────────────────────── */
.jr-notice {
  background: #fffbef;
  border-bottom: 1px solid #e8d98a;
  padding: 16px 40px;
}
.jr-notice-inner {
  max-width: 860px;
  margin: 0 auto;
  display: flex;
  align-items: baseline;
  gap: 10px;
}
.jr-notice-badge {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: #856400;
  background: #f0d84a30;
  border: 1px solid #c9a80060;
  padding: 3px 8px;
  border-radius: 5px;
  white-space: nowrap;
  flex-shrink: 0;
}
.jr-notice p {
  font-size: 13.5px;
  line-height: 1.7;
  color: #5a4500;
}
.jr-notice strong { font-weight: 700; }

/* ──────────────────────────────
   ABOUT SECTION
────────────────────────────── */
.jr-about {
  padding: 80px 40px;
  background: #fff;
}
.jr-about-inner {
  max-width: 860px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 5fr 6fr;
  gap: 72px;
  align-items: start;
}
.jr-label {
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: 0.12em;
  color: var(--jc-mid);
  text-transform: uppercase;
  margin-bottom: 14px;
}
.jr-h2 {
  font-size: clamp(22px, 2.8vw, 30px);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.3;
  color: var(--jc-ink);
  margin-bottom: 18px;
}
.jr-body {
  font-size: 14.5px;
  line-height: 1.95;
  color: var(--jc-muted);
}

.jr-items { display: flex; flex-direction: column; gap: 0; }
.jr-item {
  display: flex;
  gap: 18px;
  align-items: flex-start;
  padding: 22px 0;
  border-bottom: 1px solid var(--jc-line);
}
.jr-item:first-child { padding-top: 0; }
.jr-item:last-child { border-bottom: none; padding-bottom: 0; }
.jr-item-num {
  width: 26px; height: 26px;
  border-radius: 7px;
  background: var(--jc-deep);
  color: #fff;
  font-size: 11px;
  font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  margin-top: 1px;
}
.jr-item-title {
  font-size: 14.5px;
  font-weight: 700;
  color: var(--jc-ink);
  margin-bottom: 5px;
}
.jr-item-desc {
  font-size: 13.5px;
  line-height: 1.75;
  color: var(--jc-muted);
}

/* ──────────────────────────────
   PROGRAMS SECTION
────────────────────────────── */
.jr-programs {
  padding: 72px 40px;
  background: var(--jc-bg);
  border-top: 1px solid var(--jc-line);
}
.jr-programs-head {
  max-width: 860px;
  margin: 0 auto 36px;
}
.jr-programs-head .jr-h2 { margin-bottom: 8px; }
.jr-programs-desc {
  font-size: 14px;
  line-height: 1.8;
  color: var(--jc-muted);
}

.jr-cards {
  max-width: 860px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
}
.jr-card {
  background: #fff;
  border: 1px solid var(--jc-line);
  border-radius: 14px;
  padding: 26px 22px;
  display: flex;
  flex-direction: column;
  transition: box-shadow .2s, border-color .2s, transform .2s;
}
.jr-card:hover {
  border-color: var(--jc-mid);
  box-shadow: 0 8px 28px rgba(0,79,104,0.1);
  transform: translateY(-2px);
}
.jr-card-flag { font-size: 24px; margin-bottom: 10px; }
.jr-card-region {
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--jc-mid);
  margin-bottom: 3px;
}
.jr-card-name {
  font-size: 17px;
  font-weight: 800;
  letter-spacing: -0.02em;
  color: var(--jc-ink);
  margin-bottom: 16px;
}
.jr-card-link {
  display: flex;
  align-items: center;
  gap: 7px;
  font-size: 13px;
  color: var(--jc-muted);
  text-decoration: none;
  margin-top: 5px;
  transition: color .15s;
  word-break: break-all;
}
.jr-card-link:hover { color: var(--jc-deep); }
.jr-card-link svg {
  width: 13px; height: 13px;
  stroke: var(--jc-mid);
  fill: none;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
  flex-shrink: 0;
}
.jr-card-note {
  margin-top: 12px;
  font-size: 11px;
  font-weight: 700;
  color: var(--jc-deep);
  background: #e8f4f9;
  display: inline-block;
  padding: 4px 9px;
  border-radius: 6px;
}

/* ── 반응형 ── */
@media (max-width: 700px) {
  .jr-hero { padding: 120px 24px 64px; }
  .jr-statsbar-inner { grid-template-columns: 1fr; }
  .jr-sbar { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.1); }
  .jr-sbar:last-child { border-bottom: none; }
  .jr-notice { padding: 14px 24px; }
  .jr-about { padding: 56px 24px; }
  .jr-about-inner { grid-template-columns: 1fr; gap: 40px; }
  .jr-programs { padding: 56px 24px; }
  .jr-cards { grid-template-columns: 1fr; }
}
</style>

<div class="jr">

  <!-- HERO -->
  <div class="jr-hero">
    <div class="jr-hero-inner">
      <p class="jr-hero-eyebrow">Ministry · SYME</p>
      <h1 class="jr-hero-title">Jr. <em>SYME</em></h1>
      <p class="jr-hero-sub">
        <span class="wl-ko">중·고등학생을 위한 영어 제자훈련 집중 프로그램.<br>말씀과 훈련으로 가득한 3주가 다음 세대를 세웁니다.</span>
        <span class="wl-en">An intensive English discipleship training program<br>for middle &amp; high school students — 3 weeks of God's Word.</span>
      </p>
    </div>
  </div>

  <!-- STATS BAR -->
  <div class="jr-statsbar">
    <div class="jr-statsbar-inner">
      <div class="jr-sbar">
        <div class="jr-sbar-num"><span class="wl-ko">중·고등</span><span class="wl-en">Gr. 7–12</span></div>
        <div class="jr-sbar-label"><span class="wl-ko">학생 대상</span><span class="wl-en">Students</span></div>
      </div>
      <div class="jr-sbar">
        <div class="jr-sbar-num">3<span class="jr-sbar-unit"><span class="wl-ko">주</span><span class="wl-en"> wks</span></span></div>
        <div class="jr-sbar-label"><span class="wl-ko">집중 훈련</span><span class="wl-en">Intensive Program</span></div>
      </div>
      <div class="jr-sbar">
        <div class="jr-sbar-num"><span class="wl-ko">방학</span><span class="wl-en">2×</span></div>
        <div class="jr-sbar-label"><span class="wl-ko">여름 · 겨울 각 1회</span><span class="wl-en">Summer &amp; Winter</span></div>
      </div>
    </div>
  </div>

  <!-- NOTICE -->
  <div class="jr-notice">
    <div class="jr-notice-inner">
      <span class="jr-notice-badge"><span class="wl-ko">공지</span><span class="wl-en">NOTICE</span></span>
      <p>
        <span class="wl-ko"><strong>한국 SYME는 현재 잠정 중단 중입니다.</strong> 그 동안 중·고등학생을 대상으로 Jr. SYME를 운영하고 있습니다.</span>
        <span class="wl-en"><strong>SYME Korea is currently on a temporary hold.</strong> In the meantime, Jr. SYME is available for middle &amp; high school students.</span>
      </p>
    </div>
  </div>

  <!-- ABOUT -->
  <div class="jr-about">
    <div class="jr-about-inner">
      <div>
        <p class="jr-label">About Jr. SYME</p>
        <h2 class="jr-h2">
          <span class="wl-ko">복음으로 세워지는<br>다음 세대 리더</span>
          <span class="wl-en">Raising the Next Generation<br>of Gospel-Centered Leaders</span>
        </h2>
        <p class="jr-body">
          <span class="wl-ko">Jr. SYME는 방학을 활용한 3주 영어 제자훈련 프로그램입니다. 언어 학습을 넘어, Word of Life의 검증된 성경 커리큘럼 안에서 말씀에 깊이 뿌리내리고 복음을 전하는 리더로 성장하는 것을 목표로 합니다.</span>
          <span class="wl-en">Jr. SYME is a 3-week English discipleship training program during school breaks. Beyond language learning, students grow deep in God's Word through Word of Life's proven curriculum — equipped as leaders ready to share the Gospel.</span>
        </p>
      </div>

      <div class="jr-items">
        <div class="jr-item">
          <div class="jr-item-num">01</div>
          <div>
            <p class="jr-item-title"><span class="wl-ko">영어 집중 환경</span><span class="wl-en">English Immersion</span></p>
            <p class="jr-item-desc"><span class="wl-ko">모든 강의와 활동이 영어로 진행됩니다. 자연스러운 환경 속에서 언어와 신앙이 함께 성장합니다.</span><span class="wl-en">All sessions are in English — faith and language grow together in a natural immersion environment.</span></p>
          </div>
        </div>
        <div class="jr-item">
          <div class="jr-item-num">02</div>
          <div>
            <p class="jr-item-title"><span class="wl-ko">말씀 중심 커리큘럼</span><span class="wl-en">Word-Centered Curriculum</span></p>
            <p class="jr-item-desc"><span class="wl-ko">성경 묵상, 말씀 암송, 소그룹 나눔을 통해 하나님의 말씀 위에 삶을 세웁니다.</span><span class="wl-en">Daily devotions, Scripture memory, and small groups — building lives on the foundation of God's Word.</span></p>
          </div>
        </div>
        <div class="jr-item">
          <div class="jr-item-num">03</div>
          <div>
            <p class="jr-item-title"><span class="wl-ko">공동체와 제자훈련</span><span class="wl-en">Community &amp; Discipleship</span></p>
            <p class="jr-item-desc"><span class="wl-ko">또래와 함께하는 3주간의 공동체 생활로 서로 세우고 도전하며 성장합니다.</span><span class="wl-en">3 weeks of community life with peers — challenging and building each other in faith and character.</span></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- RELATED PROGRAMS -->
  <div class="jr-programs">
    <div class="jr-programs-head">
      <p class="jr-label">Word of Life Worldwide</p>
      <h2 class="jr-h2">
        <span class="wl-ko">더 깊은 훈련을 원하신다면</span>
        <span class="wl-en">Looking for a Deeper Experience?</span>
      </h2>
      <p class="jr-programs-desc">
        <span class="wl-ko">Jr. SYME 외에도 전 세계 Word of Life 훈련 프로그램을 살펴보세요. 제주 월비를 제외한 해외 프로그램은 영어 문의만 가능합니다.</span>
        <span class="wl-en">Explore other Word of Life training programs worldwide. International programs (except Jeju WOLBI) accept English inquiries only.</span>
      </p>
    </div>

    <div class="jr-cards">

      <div class="jr-card">
        <div class="jr-card-flag">🇹🇼</div>
        <p class="jr-card-region">Taiwan</p>
        <p class="jr-card-name">SYME Taiwan</p>
        <a class="jr-card-link" href="https://syme.woltaiwan.com/en/home" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          syme.woltaiwan.com
        </a>
        <a class="jr-card-link" href="mailto:symetaiwan@gmail.com">
          <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          symetaiwan@gmail.com
        </a>
        <span class="jr-card-note"><span class="wl-ko">영어 문의만 가능</span><span class="wl-en">English only</span></span>
      </div>

      <div class="jr-card">
        <div class="jr-card-flag">🇰🇷</div>
        <p class="jr-card-region">Jeju, Korea</p>
        <p class="jr-card-name">WOLBI Jeju</p>
        <a class="jr-card-link" href="https://www.wolbijeju.org" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          wolbijeju.org
        </a>
        <a class="jr-card-link" href="mailto:wolbijeju.contact@gmail.com">
          <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          wolbijeju.contact@gmail.com
        </a>
      </div>

      <div class="jr-card">
        <div class="jr-card-flag">🇺🇸</div>
        <p class="jr-card-region">United States</p>
        <p class="jr-card-name">WOLBI USA</p>
        <a class="jr-card-link" href="https://wordoflife.edu" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
          wordoflife.edu
        </a>
        <a class="jr-card-link" href="mailto:admissions@wol.org">
          <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
          admissions@wol.org
        </a>
        <span class="jr-card-note"><span class="wl-ko">영어 문의만 가능</span><span class="wl-en">English only</span></span>
      </div>

    </div>
  </div>

</div>

</BaseLayout>
