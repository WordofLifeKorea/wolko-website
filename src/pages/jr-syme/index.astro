---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Jr. SYME — Word of Life Korea"
  description="Jr. SYME — 중학생을 위한 영어 제자훈련학교. 복음과 영어, 삶의 변화를 경험하세요."
  activeNav="ministry"
>

<style>
  :root {
    --c-deep: #004f68; --c-mid: #0a5b76; --c-light: #73d1f5;
    --c-bg: #f4f8fb; --c-white: #ffffff;
    --c-text: #152028; --c-muted: #5b6b78;
    --c-line: rgba(0,79,104,0.12);
    --r-xl: 28px; --r-lg: 20px;
  }

  .hero {
    position:relative; overflow:hidden;
    padding:160px 24px 100px; text-align:center;
    background:
      linear-gradient(180deg, rgba(5,24,36,0.44) 0%, rgba(5,24,36,0.62) 100%),
      url("https://wolko.synology.me/Web_Contents/Photos/SYME/SYME_Banner.jpg") center / cover no-repeat;
    background-color:#0a5b76;
  }
  .hero::before {
    content:""; position:absolute; inset:0;
    background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);
    background-size:60px 60px; pointer-events:none;
  }
  .hero-inner { position:relative; z-index:2; max-width:880px; margin:0 auto; }
  .hero-eyebrow {
    display:inline-flex; align-items:center; gap:8px; padding:7px 16px; border-radius:999px;
    background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.22);
    font-size:11px; font-weight:800; letter-spacing:0.09em; color:rgba(255,255,255,0.9);
    margin-bottom:22px; text-transform:uppercase;
  }
  .hero-eyebrow-dot { width:6px; height:6px; border-radius:50%; background:var(--c-light); }
  .hero-inner h1 {
    font-size:clamp(36px,5.5vw,60px); font-weight:800; line-height:1.13;
    letter-spacing:-0.04em; color:#fff; margin-bottom:18px;
    text-shadow:0 6px 24px rgba(0,0,0,0.26);
  }
  .hero-inner h1 em { font-style:normal; color:#9ae3ff; display:block; }
  .hero-sub { font-size:17px; line-height:1.88; color:rgba(255,255,255,0.82); max-width:640px; margin:0 auto; }
  .hero-btns { display:flex; justify-content:center; gap:12px; flex-wrap:wrap; margin-top:32px; }
  .btn-primary {
    display:inline-flex; align-items:center; gap:8px; padding:15px 28px; border-radius:999px;
    background:#fff; color:var(--c-deep); font-size:14px; font-weight:800;
    text-decoration:none; box-shadow:0 10px 28px rgba(0,0,0,0.18); transition:transform .18s, box-shadow .18s;
  }
  .btn-primary:hover { transform:translateY(-2px); box-shadow:0 16px 36px rgba(0,0,0,0.22); }

  .hero-stats {
    position:relative; z-index:2; display:flex; justify-content:center;
    margin:56px auto 0; max-width:760px;
    background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.16);
    border-radius:18px; backdrop-filter:blur(8px); overflow:hidden;
  }
  .hero-stat { flex:1; padding:20px 14px; text-align:center; border-right:1px solid rgba(255,255,255,0.12); }
  .hero-stat:last-child { border-right:none; }
  .hero-stat-icon { font-size:20px; margin-bottom:6px; }
  .hero-stat-label { font-size:11px; font-weight:700; color:rgba(255,255,255,0.72); line-height:1.4; }

  .section { padding:96px 24px; }
  .section--alt { background:var(--c-bg); }
  .page-wrap { max-width:1140px; margin:0 auto; }

  .sec-badge {
    display:inline-block; padding:7px 14px; border-radius:999px;
    background:rgba(0,79,104,0.08); color:var(--c-deep);
    font-size:11px; font-weight:800; letter-spacing:0.06em;
  }
  .sec-title {
    font-size:clamp(28px,4vw,44px); font-weight:800; line-height:1.2;
    letter-spacing:-0.035em; color:var(--c-text); margin:14px 0 16px;
  }
  .sec-desc { font-size:16px; line-height:1.9; color:var(--c-muted); max-width:700px; }

  .quote-bar {
    background:linear-gradient(135deg, #083d51 0%, var(--c-deep) 100%);
    padding:36px 24px; text-align:center;
  }
  .quote-text { font-size:18px; font-style:italic; color:rgba(255,255,255,0.92); max-width:680px; margin:0 auto 10px; line-height:1.7; }
  .quote-attr { font-size:12px; font-weight:700; letter-spacing:0.06em; color:rgba(255,255,255,0.55); text-transform:uppercase; }

  .intro-card {
    position:relative; background:linear-gradient(180deg,#fff 0%,#f6f9fb 100%);
    border:1px solid var(--c-line); border-radius:var(--r-xl); padding:44px 42px 38px;
    box-shadow:0 22px 56px rgba(16,32,40,0.08); overflow:hidden; margin-top:48px;
  }
  .intro-card::before { content:""; position:absolute; top:0; left:0; right:0; height:5px; background:linear-gradient(90deg, var(--c-deep) 0%, var(--c-mid) 55%, var(--c-light) 100%); }
  .intro-card p { font-size:17px; line-height:2.0; color:#3a4e58; margin-bottom:14px; }
  .intro-card p:last-child { margin-bottom:0; }

  .features-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:18px; margin-top:48px; }
  .feature-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-xl);
    padding:32px 28px; display:flex; flex-direction:column; gap:12px;
    box-shadow:0 4px 18px rgba(0,79,104,0.07); transition:transform .22s, box-shadow .22s;
    position:relative; overflow:hidden;
  }
  .feature-card::after { content:""; position:absolute; right:-20px; bottom:-24px; width:90px; height:90px; border-radius:50%; background:rgba(0,79,104,0.04); }
  .feature-card:hover { transform:translateY(-4px); box-shadow:0 12px 36px rgba(0,79,104,0.14); }
  .feature-icon { font-size:26px; }
  .feature-tag { font-size:11px; font-weight:800; letter-spacing:0.06em; color:var(--c-mid); }
  .feature-title { font-size:18px; font-weight:800; color:var(--c-text); }
  .feature-desc { font-size:14px; line-height:1.82; color:var(--c-muted); }

  /* Schedule */
  .schedule-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:16px; margin-top:48px; }
  .schedule-item {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-lg);
    padding:24px 22px; box-shadow:0 3px 12px rgba(0,79,104,0.06);
  }
  .schedule-day { font-size:11px; font-weight:800; letter-spacing:0.07em; color:var(--c-mid); text-transform:uppercase; margin-bottom:8px; }
  .schedule-title { font-size:16px; font-weight:800; color:var(--c-text); margin-bottom:6px; }
  .schedule-desc { font-size:13px; line-height:1.75; color:var(--c-muted); }

  /* Pathway */
  .pathway {
    display:flex; flex-direction:column; gap:0; margin-top:48px;
    border:1px solid var(--c-line); border-radius:var(--r-xl); overflow:hidden;
    box-shadow:0 6px 24px rgba(0,79,104,0.08);
  }
  .pathway-step { display:flex; gap:24px; padding:28px 32px; background:var(--c-white); align-items:flex-start; border-bottom:1px solid var(--c-line); }
  .pathway-step:last-child { border-bottom:none; }
  .pathway-icon { width:48px; height:48px; min-width:48px; border-radius:14px; background:rgba(0,79,104,0.08); color:var(--c-deep); display:flex; align-items:center; justify-content:center; font-size:22px; }
  .pathway-content { flex:1; }
  .pathway-title { font-size:17px; font-weight:800; color:var(--c-text); margin-bottom:6px; }
  .pathway-desc { font-size:14px; line-height:1.8; color:var(--c-muted); }
  .pathway-arrow { font-size:12px; font-weight:800; color:var(--c-mid); margin-top:6px; }

  .cta-section { background:linear-gradient(135deg, var(--c-deep) 0%, var(--c-mid) 100%); padding:88px 24px; text-align:center; }
  .cta-section h2 { font-size:clamp(26px,3.5vw,42px); font-weight:800; color:#fff; margin-bottom:14px; letter-spacing:-0.03em; }
  .cta-section p { font-size:16px; color:rgba(255,255,255,0.78); max-width:560px; margin:0 auto 40px; line-height:1.85; }
  .btn-white {
    display:inline-flex; align-items:center; gap:8px; padding:16px 30px; border-radius:999px;
    background:#fff; color:var(--c-deep); font-size:15px; font-weight:800;
    text-decoration:none; box-shadow:0 8px 24px rgba(0,0,0,0.18); transition:transform .18s, box-shadow .18s;
  }
  .btn-white:hover { transform:translateY(-2px); box-shadow:0 14px 32px rgba(0,0,0,0.22); }
  .cta-contact { font-size:13px; color:rgba(255,255,255,0.65); margin-top:24px; line-height:1.9; }
  .cta-contact a { color:rgba(255,255,255,0.9); font-weight:800; text-decoration:none; }

  .lang-en .wl-ko { display:none; }
  body:not(.lang-en) .wl-en { display:none; }
</style>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">
      <span class="hero-eyebrow-dot"></span>
      <span>Jr. SYME · School of Youth Ministry in English</span>
    </div>
    <h1>
      <span class="wl-ko">복음과 영어, 두 언어로<br>성장하는 여름<em>Jr. SYME</em></span>
      <span class="wl-en">Growing in the Gospel<br>and in English<em>Jr. SYME</em></span>
    </h1>
    <p class="hero-sub">
      <span class="wl-ko">중학생을 위한 영어 제자훈련 프로그램 — 복음을 듣고, 영어로 나누고, 새로운 비전을 품는 여름을 경험하세요.</span>
      <span class="wl-en">An English discipleship program for middle school students — hear the Gospel, share it in English, and discover a new vision for your life this summer.</span>
    </p>
    <div class="hero-btns">
      <a href="/contact" class="btn-primary">
        <span class="wl-ko">프로그램 문의 →</span>
        <span class="wl-en">Program Inquiry →</span>
      </a>
    </div>
  </div>
  <div class="hero-stats">
    <div class="hero-stat">
      <div class="hero-stat-icon">🧑‍🎓</div>
      <div class="hero-stat-label"><span class="wl-ko">중학생 대상<br>방학 집중 프로그램</span><span class="wl-en">For Middle Schoolers<br>Intensive Break Program</span></div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-icon">🌐</div>
      <div class="hero-stat-label"><span class="wl-ko">영어 몰입 환경<br>원어민 선교사 팀</span><span class="wl-en">English Immersion<br>Native Missionary Team</span></div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-icon">✝️</div>
      <div class="hero-stat-label"><span class="wl-ko">복음 중심<br>제자훈련</span><span class="wl-en">Gospel-Centered<br>Discipleship</span></div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-icon">🌱</div>
      <div class="hero-stat-label"><span class="wl-ko">SYME 입문 과정<br>월비 준비 프로그램</span><span class="wl-en">SYME Entry Program<br>WOLBI Preparation</span></div>
    </div>
  </div>
</section>

<!-- QUOTE -->
<div class="quote-bar">
  <p class="quote-text">
    <span class="wl-ko">"복음은 언어의 경계를 넘어 다음 세대의 마음에 가닿습니다."</span>
    <span class="wl-en">"The Gospel reaches the hearts of the next generation across every language barrier."</span>
  </p>
  <p class="quote-attr">
    <span class="wl-ko">— Jr. SYME 사역의 정신</span>
    <span class="wl-en">— The spirit of Jr. SYME</span>
  </p>
</div>

<!-- INTRO -->
<section class="section section--alt">
  <div class="page-wrap">
    <span class="sec-badge"><span class="wl-ko">프로그램 소개</span><span class="wl-en">About Jr. SYME</span></span>
    <h2 class="sec-title">
      <span class="wl-ko">영어라는 도구로 복음을 배우고 나누는 프로그램</span>
      <span class="wl-en">Learning and Sharing the Gospel Through English</span>
    </h2>
    <div class="intro-card">
      <p>
        <span class="wl-ko">Jr. SYME(School of Youth Ministry in English)는 중학생들을 위한 방학 집중 제자훈련 프로그램입니다. 영어를 단순한 언어 교육의 도구가 아닌, 복음을 전하는 통로로 활용합니다. 원어민 선교사들과 함께 생활하며 영어로 성경을 배우고, 복음을 나누는 훈련을 받게 됩니다.</span>
        <span class="wl-en">Jr. SYME (School of Youth Ministry in English) is an intensive discipleship program during school breaks for middle school students. English is used not merely as a language skill, but as a vehicle for sharing the Gospel. Students live alongside native-speaking missionaries, learning the Bible in English and receiving training in how to share their faith.</span>
      </p>
      <p>
        <span class="wl-ko">이 프로그램은 SYME(고등학생 대상)로 이어지는 입문 과정이기도 합니다. 복음을 처음 듣는 학생부터 이미 믿음이 있는 학생까지, 모두가 하나님 말씀 안에서 더 깊이 성장할 수 있도록 설계되었습니다.</span>
        <span class="wl-en">This program also serves as a gateway to SYME (for high school students). Whether a student is hearing the Gospel for the first time or already has faith, Jr. SYME is designed to help every participant grow deeper in God's Word.</span>
      </p>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section class="section">
  <div class="page-wrap">
    <span class="sec-badge"><span class="wl-ko">프로그램 특징</span><span class="wl-en">Program Highlights</span></span>
    <h2 class="sec-title">
      <span class="wl-ko">Jr. SYME에서 경험하는 것들</span>
      <span class="wl-en">What You'll Experience at Jr. SYME</span>
    </h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">✝️</div>
        <div class="feature-tag"><span class="wl-ko">복음</span><span class="wl-en">Gospel</span></div>
        <div class="feature-title"><span class="wl-ko">복음 중심 말씀</span><span class="wl-en">Gospel-Centered Teaching</span></div>
        <div class="feature-desc"><span class="wl-ko">선교사님들이 전하는 영어 성경 말씀을 통해 복음의 핵심을 명확하게 이해하고 개인적으로 받아들이는 기회를 갖습니다.</span><span class="wl-en">Through Bible teaching delivered in English by missionaries, students gain a clear understanding of the Gospel and an opportunity to receive it personally.</span></div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🌐</div>
        <div class="feature-tag"><span class="wl-ko">영어</span><span class="wl-en">English</span></div>
        <div class="feature-title"><span class="wl-ko">영어 몰입 생활</span><span class="wl-en">English Immersion Life</span></div>
        <div class="feature-desc"><span class="wl-ko">원어민 선교사들과 함께 생활하며 자연스럽게 영어를 사용하고, 다양한 문화적 경험을 통해 더 넓은 시야를 갖게 됩니다.</span><span class="wl-en">Living alongside native missionary staff, students use English naturally in daily life and gain a broader perspective through meaningful cultural exchange.</span></div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🤝</div>
        <div class="feature-tag"><span class="wl-ko">관계</span><span class="wl-en">Community</span></div>
        <div class="feature-title"><span class="wl-ko">소그룹 공동체</span><span class="wl-en">Small Group Community</span></div>
        <div class="feature-desc"><span class="wl-ko">소그룹 나눔과 공동 생활을 통해 진정한 우정과 믿음의 공동체를 경험하며, 삶의 고민을 복음 안에서 나눕니다.</span><span class="wl-en">Through small group sharing and communal living, students experience genuine friendship and a faith community where life's questions are shared within the Gospel.</span></div>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🌱</div>
        <div class="feature-tag"><span class="wl-ko">성장</span><span class="wl-en">Growth</span></div>
        <div class="feature-title"><span class="wl-ko">다음 단계로의 연결</span><span class="wl-en">Gateway to the Next Step</span></div>
        <div class="feature-desc"><span class="wl-ko">Jr. SYME는 SYME, 월비 등으로 이어지는 제자훈련의 첫 단계입니다. 복음을 받아들인 학생들이 지속적으로 성장할 수 있도록 연결합니다.</span><span class="wl-en">Jr. SYME is the first step in a discipleship journey leading to SYME and WOLBI. Students who receive the Gospel are connected to ongoing opportunities for growth.</span></div>
      </div>
    </div>
  </div>
</section>

<!-- DAILY SCHEDULE SAMPLE -->
<section class="section section--alt">
  <div class="page-wrap">
    <span class="sec-badge"><span class="wl-ko">하루 일과</span><span class="wl-en">Daily Schedule</span></span>
    <h2 class="sec-title">
      <span class="wl-ko">하루하루가 복음과 함께합니다</span>
      <span class="wl-en">Every Day Lived With the Gospel</span>
    </h2>
    <p class="sec-desc">
      <span class="wl-ko">복음 말씀, 영어 수업, 소그룹 나눔, 활동이 하나로 이어지는 하루를 경험하게 됩니다.</span>
      <span class="wl-en">Each day flows naturally between Gospel teaching, English classes, small group sharing, and activities — all woven together.</span>
    </p>
    <div class="schedule-grid">
      <div class="schedule-item">
        <div class="schedule-day"><span class="wl-ko">아침</span><span class="wl-en">Morning</span></div>
        <div class="schedule-title"><span class="wl-ko">경건의 시간 & 말씀</span><span class="wl-en">Devotions & Bible Teaching</span></div>
        <div class="schedule-desc"><span class="wl-ko">하루를 말씀으로 시작합니다. 선교사님들의 영어 성경 말씀 시간입니다.</span><span class="wl-en">The day begins with the Word. Bible teaching in English delivered by missionary staff.</span></div>
      </div>
      <div class="schedule-item">
        <div class="schedule-day"><span class="wl-ko">오전</span><span class="wl-en">Late Morning</span></div>
        <div class="schedule-title"><span class="wl-ko">영어 수업 & 활동</span><span class="wl-en">English Classes & Activities</span></div>
        <div class="schedule-desc"><span class="wl-ko">원어민 선생님과 함께하는 영어 수업 및 다양한 팀 활동을 통해 자연스러운 영어 사용을 경험합니다.</span><span class="wl-en">English classes with native speakers and team activities provide a natural environment for using English.</span></div>
      </div>
      <div class="schedule-item">
        <div class="schedule-day"><span class="wl-ko">오후</span><span class="wl-en">Afternoon</span></div>
        <div class="schedule-title"><span class="wl-ko">소그룹 나눔 & 레크리에이션</span><span class="wl-en">Small Groups & Recreation</span></div>
        <div class="schedule-desc"><span class="wl-ko">소그룹 안에서 삶을 나누고 복음에 대해 대화하며, 오후 활동으로 즐거운 공동체를 경험합니다.</span><span class="wl-en">Small group discussions on faith and life, followed by afternoon activities that build community.</span></div>
      </div>
      <div class="schedule-item">
        <div class="schedule-day"><span class="wl-ko">저녁</span><span class="wl-en">Evening</span></div>
        <div class="schedule-title"><span class="wl-ko">집회 & 공동체 시간</span><span class="wl-en">Evening Rally & Community</span></div>
        <div class="schedule-desc"><span class="wl-ko">저녁 집회를 통해 복음의 초대와 응답의 시간을 갖고, 함께 교제하며 하루를 마무리합니다.</span><span class="wl-en">An evening rally with a Gospel invitation, followed by fellowship to close the day together.</span></div>
      </div>
    </div>
  </div>
</section>

<!-- PATHWAY -->
<section class="section">
  <div class="page-wrap">
    <span class="sec-badge"><span class="wl-ko">성장 경로</span><span class="wl-en">Growth Pathway</span></span>
    <h2 class="sec-title">
      <span class="wl-ko">Jr. SYME는 더 큰 여정의 시작입니다</span>
      <span class="wl-en">Jr. SYME Is the Beginning of a Larger Journey</span>
    </h2>
    <div class="pathway">
      <div class="pathway-step">
        <div class="pathway-icon">🌱</div>
