<script is:inline>
async function handleSubmit(e) {
  e.preventDefault();
  var form = e.target;
  var btn  = form.querySelector(‘.ct-form-btn’);
  var btnOriginal = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = ‘<span style="opacity:.7">전송 중...</span>’;

  var name    = form.querySelector(‘#ct-name’).value.trim();
  var email   = form.querySelector(‘#ct-email’).value.trim();
  var phone   = (form.querySelector(‘#ct-phone’).value || ‘’).trim();
  var type    = document.getElementById(‘ct-type-val’).value;
  var message = form.querySelector(‘#ct-msg’).value.trim();

  try {
    var res = await fetch(‘/api/contact’, {
      method: ‘POST’,
      headers: { ‘Content-Type’: ‘application/json’ },
      body: JSON.stringify({ name: name, email: email, phone: phone, type: type, message: message }),
    });

    if (!res.ok) {
      var errData = await res.json().catch(function() { return {}; });
      throw new Error(errData.error || ‘전송 실패’);
    }

    var d = document.createElement(‘div’);
    d.style.cssText = ‘text-align:center;padding:56px 0;’;
    var koP = document.createElement(‘p’);
    koP.className = ‘wl-ko’;
    koP.style.cssText = ‘font-size:18px;font-weight:700;color:#004f68;line-height:1.6;’;
    koP.innerHTML = ‘문의가 접수되었습니다.<br>영업일 기준 1–2일 내로 연락 드리겠습니다.’;
    var enP = document.createElement(‘p’);
    enP.className = ‘wl-en’;
    enP.style.cssText = ‘font-size:18px;font-weight:700;color:#004f68;line-height:1.6;’;
    enP.innerHTML = "Your message has been received.<br>We’ll be in touch within 1–2 business days.";
    var icon = document.createElement(‘div’);
    icon.style.cssText = ‘font-size:52px;margin-bottom:16px;’;
    icon.textContent = ‘✅’;
    d.appendChild(icon);
    d.appendChild(koP);
    d.appendChild(enP);
    form.innerHTML = ‘’;
    form.appendChild(d);

  } catch (err) {
    btn.disabled = false;
    btn.innerHTML = btnOriginal;
    alert(‘전송 중 오류가 발생했습니다. 이메일로 직접 연락해 주세요 — wolkorea1@gmail.com\n\nAn error occurred. Please email us at wolkorea1@gmail.com’);
  }
}
</script>

