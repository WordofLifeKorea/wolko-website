              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div>
              <div class="ct-info-label">Email</div>
              <div class="ct-info-val"><a href="mailto:wolkorea@gmail.com">wolkorea@gmail.com</a></div>
            </div>
          </div>
          <div class="ct-info-row">
            <div class="ct-info-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div>
              <div class="ct-info-label"><span class="wl-ko">운영 시간</span><span class="wl-en">Office Hours</span></div>
              <div class="ct-info-val">
                <span class="wl-ko">월–금 09:00–18:00</span>
                <span class="wl-en">Mon–Fri 9 AM – 6 PM</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- CONTACT FORM -->
    <p class="ct-section-title">
      <span class="wl-ko">문의 보내기</span>
      <span class="wl-en">Send a Message</span>
    </p>
    <div class="ct-form-wrap">
      <form name="contact" method="POST" data-netlify="true" action="/contact/success"
            onsubmit="handleSubmit(event)">
        <input type="hidden" name="form-name" value="contact" />
        <input type="hidden" name="type" id="ct-type-val" value="general" />

        <!-- 문의 유형 선택 -->
        <p class="ct-type-label">
          <span class="wl-ko">문의 유형 선택</span><span class="wl-en">Inquiry Type</span>
        </p>
        <div class="ct-type-grid" id="ctTypeGrid">

          <div class="ct-type-card selected" data-value="general" onclick="selectType(this)">
            <!-- message-square -->
            <svg class="ct-type-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
            <span class="ct-type-name-ko">일반 문의</span>
            <span class="ct-type-name-en">General</span>
          </div>

          <div class="ct-type-card" data-value="ministry" onclick="selectType(this)">
            <!-- users -->
            <svg class="ct-type-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <span class="ct-type-name-ko">사역 협력</span>
            <span class="ct-type-name-en">Partnership</span>
          </div>

          <div class="ct-type-card" data-value="wolbi" onclick="selectType(this)">
            <!-- graduation-cap -->
            <svg class="ct-type-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
              <path d="M6 12v5c3 3 9 3 12 0v-5"/>
            </svg>
            <span class="ct-type-name-ko">제주월비 입학</span>
            <span class="ct-type-name-en">WOLBI</span>
          </div>

          <div class="ct-type-card" data-value="camp" onclick="selectType(this)">
            <!-- tent / triangle -->
            <svg class="ct-type-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3L2 21h20L12 3z"/>
              <path d="M10 21v-5a2 2 0 0 1 4 0v5"/>
            </svg>
            <span class="ct-type-name-ko">캠프 신청</span>
            <span class="ct-type-name-en">Camp</span>
          </div>

          <div class="ct-type-card" data-value="mission" onclick="selectType(this)">
            <!-- globe -->
            <svg class="ct-type-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <span class="ct-type-name-ko">선교팀</span>
            <span class="ct-type-name-en">Mission</span>
          </div>

          <div class="ct-type-card" data-value="give" onclick="selectType(this)">
            <!-- heart -->
            <svg class="ct-type-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
            </svg>
            <span class="ct-type-name-ko">후원</span>
            <span class="ct-type-name-en">Giving</span>
          </div>

          <div class="ct-type-card" data-value="prayer" onclick="selectType(this)">
            <!-- book-open -->
            <svg class="ct-type-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
              <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
            </svg>
            <span class="ct-type-name-ko">기도 제목</span>
            <span class="ct-type-name-en">Prayer</span>
          </div>

          <div class="ct-type-card" data-value="other" onclick="selectType(this)">
            <!-- edit -->
            <svg class="ct-type-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
              <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
            </svg>
            <span class="ct-type-name-ko">기타</span>
            <span class="ct-type-name-en">Other</span>
          </div>

        </div>
        <hr class="ct-type-divider" />

        <!-- 기본 정보 -->
        <div class="ct-form-grid">
          <div class="ct-field">
            <label for="ct-name">
              <span class="wl-ko">이름 *</span><span class="wl-en">Name *</span>
            </label>
            <input type="text" id="ct-name" name="name" required
              placeholder="홍길동 / John Smith" />
          </div>
          <div class="ct-field">
            <label for="ct-email">
              <span class="wl-ko">이메일 *</span><span class="wl-en">Email *</span>
            </label>
            <input type="email" id="ct-email" name="email" required
              placeholder="example@email.com" />
          </div>
          <div class="ct-field">
            <label for="ct-phone">
              <span class="wl-ko">연락처</span><span class="wl-en">Phone</span>
            </label>
            <input type="tel" id="ct-phone" name="phone"
              placeholder="010-0000-0000" />
          </div>
          <div class="ct-field full">
            <label for="ct-msg">
              <span class="wl-ko">내용 *</span><span class="wl-en">Message *</span>
            </label>
            <textarea id="ct-msg" name="message" required
              placeholder="문의 내용을 자유롭게 작성해 주세요. / Please write your message freely."></textarea>
          </div>
        </div>
        <button type="submit" class="ct-form-btn">
          <span class="wl-ko">문의 보내기</span><span class="wl-en">Send Message</span>
        </button>
        <p class="ct-form-note">
          <span class="wl-ko">📌 보내주신 문의는 영업일 기준 1–2일 내로 답변 드리겠습니다. 긴급한 사항은 전화로 연락해 주세요.</span>
          <span class="wl-en">📌 We typically respond within 1–2 business days. For urgent matters, please call us directly.</span>
        </p>
      </form>
    </div>

  </div>
</section>

</div><!-- end lang-root -->

<script is:inline>
function selectType(card) {
  document.querySelectorAll('.ct-type-card').forEach(c => c.classList.remove('selected'));
  card.classList.add('selected');
  document.getElementById('ct-type-val').value = card.dataset.value;
}

function handleSubmit(e) {
  e.preventDefault();
  const form = e.target;
  const data = new FormData(form);
  fetch('/', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: new URLSearchParams(data).toString(),
  })
  .then(() => {
    form.innerHTML = '<div style="text-align:center;padding:48px 0;"><div style="font-size:48px;margin-bottom:16px;">✅</div><p style="font-size:18px;font-weight:800;color:#004f68;" class="wl-ko">문의가 접수되었습니다.<br>곧 연락 드리겠습니다.</p><p style="font-size:18px;font-weight:800;color:#004f68;" class="wl-en">Your message has been received.<br>We\'ll be in touch soon.</p></div>';
  })
  .catch(() => {
    alert('전송 중 오류가 발생했습니다. 이메일로 직접 연락해 주세요.\nAn error occurred. Please contact us via email.');
  });
}
</script>

</BaseLayout>
