---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="Contact — Word of Life Korea"
  description="월코에 문의하거나 연락하세요. 평택 본부와 제주 사무소로 언제든지 연락 주세요."
  activeNav="connect"
>

<link rel="stylesheet" href="/phone-input.css?v=4">
<script is:inline src="/phone-input.js?v=2" defer></script>
<script is:inline>
  // 캠프 신청 화면에서 "문의 남기기"로 넘어오면 이 탭의 임시 저장소에 담긴 내용으로 문의 양식을 미리 채운다(한 번만 쓰고 지운다).
  window.addEventListener('DOMContentLoaded', function () {
    var data = null;
    try { data = JSON.parse(sessionStorage.getItem('wolko-contact-prefill') || 'null'); sessionStorage.removeItem('wolko-contact-prefill'); } catch (e) {}
    if (!data) return;
    var set = function (id, value) { var el = document.getElementById(id); if (el && value) el.value = value; };
    set('ct-type-select', data.type); set('ct-name', data.name); set('ct-email', data.email); set('ct-phone', data.phone); set('ct-msg', data.message);
    var msg = document.getElementById('ct-msg'); if (msg) { try { msg.focus(); msg.setSelectionRange(msg.value.length, msg.value.length); } catch (e) {} }
  });
</script>

<style>
  /* 색은 감싸는 클래스에 둔다 — 사역 페이지와 같은 값 */
  .ct {
    --ct-deep:#004f68; --ct-navy:#0b2430; --ct-ink:#10252e;
    --ct-text:#4a5d66; --ct-muted:#587383; --ct-label:#5a7380;
    --ct-line:#d6dee2; --ct-field:#cdd7dc; --ct-soft:#f6f9fb; --ct-fill:#f3f7f9;
    font-family:var(--ff-sans); color:var(--ct-ink); background:#fff;
    word-break:keep-all; overflow:hidden;
  }
  .ct-shell { width:min(1200px, calc(100% - 48px)); margin-inline:auto; }

  /* ── 작은 표시 + 제목 ── */
  .ct-eyebrow { display:flex; align-items:center; gap:12px; color:var(--ct-deep); font-size:13px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; }
  .ct-eyebrow::before { content:''; width:28px; height:1px; background:currentColor; }
  .ct-title { margin-top:20px; font-family:var(--ff-serif); font-size:clamp(30px, 3.4vw, 46px); font-weight:700; line-height:1.22; letter-spacing:-.03em; color:var(--ct-navy); }
  .ct-arrow { width:14px; height:14px; flex:none; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:square; }

  /* ── QUICK CONTACT ── */
  .ct-qc-sec { padding:120px 0 104px; }
  .ct-qc-head { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:80px; align-items:end; }

  /* 카카오 채널 — 옅은 바탕 한 줄 */
  .ct-qc-kakao {
    display:flex; align-items:center; gap:16px;
    padding:20px 24px; margin-top:0;
    background:var(--ct-fill); border-radius:2px;
    color:var(--ct-ink); text-decoration:none;
    transition:background-color .2s;
  }
  .ct-qc-kakao:hover { background:#e9f0f3; }
  .ct-qc-kakao-icon {
    width:40px; height:40px; border-radius:2px;
    background:#FEE500; color:#391b1b;
    display:flex; align-items:center; justify-content:center; flex-shrink:0;
  }
  .ct-qc-kakao-icon svg { width:19px; height:19px; }
  .ct-qc-kakao-text { flex:1; min-width:0; }
  .ct-qc-kakao-title { font-size:16px; font-weight:700; color:var(--ct-navy); line-height:1.4; }
  .ct-qc-kakao-sub   { font-size:14px; color:var(--ct-muted); margin-top:2px; line-height:1.5; }
  .ct-qc-kakao-go {
    display:inline-flex; align-items:center; gap:10px; flex-shrink:0;
    font-size:14px; font-weight:700; color:var(--ct-deep);
    transition:gap .25s;
  }
  .ct-qc-kakao:hover .ct-qc-kakao-go { gap:14px; }

  /* 두 사무소 — 굵은 윗줄 + 가는 줄로 나뉜 항목 */
  .ct-qc-cols {
    margin-top:64px;
    display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:0 56px;
  }
  .ct-qc-col { border-top:2px solid var(--ct-navy); }
  .ct-qc-col-head {
    padding:22px 0 18px;
    font-family:var(--ff-serif); font-size:clamp(22px, 2vw, 26px); font-weight:700;
    letter-spacing:-.03em; color:var(--ct-navy); line-height:1.3;
  }
  .ct-qc-row {
    display:grid; grid-template-columns:96px minmax(0,1fr) auto; align-items:baseline; gap:16px;
    padding:16px 0;
    border-top:1px solid var(--ct-line);
    color:var(--ct-ink); text-decoration:none;
  }
  .ct-qc-col .ct-qc-row:last-child { border-bottom:1px solid var(--ct-line); }
  .ct-qc-lbl { font-size:12px; font-weight:700; color:var(--ct-label); letter-spacing:.06em; text-transform:uppercase; }
  .ct-qc-val {
    font-size:16px; font-weight:600; color:var(--ct-ink); line-height:1.55;
    overflow-wrap:anywhere; transition:color .2s;
  }
  a.ct-qc-row:hover .ct-qc-val { color:var(--ct-deep); text-decoration:underline; text-underline-offset:4px; text-decoration-thickness:1px; }
  .ct-qc-hint { font-size:13px; color:var(--ct-muted); white-space:nowrap; }

  /* ── FORM ── */
  .ct-form-sec { padding:112px 0 120px; background:var(--ct-soft); }
  .ct-form-layout {
    display:grid; grid-template-columns:minmax(0,4fr) minmax(0,8fr); gap:80px; align-items:start;
    scroll-margin-top:100px;
  }
  .ct-form-side { position:sticky; top:110px; }
  .ct-form-wrap { background:#fff; border:1px solid var(--ct-line); border-radius:2px; padding:48px; }

  /* 응답 안내 — 옅은 바탕 + 고른 테두리 */
  .ct-form-note {
    display:flex; align-items:flex-start; gap:12px; margin-top:28px;
    font-size:14.5px; color:var(--ct-text); line-height:1.75;
    padding:18px 20px; background:#fff;
    border:1px solid var(--ct-line); border-radius:2px;
  }
  .ct-form-note-icon {
    display:inline-grid; place-items:center; flex:0 0 20px;
    width:20px; height:20px; margin-top:3px; border-radius:2px;
    border:1px solid var(--ct-deep); color:var(--ct-deep);
    font-family:var(--ff-serif); font-size:12px; font-weight:700; line-height:1;
  }

  /* 문의 유형 */
  .ct-dropdown-wrap { margin-bottom:24px; }
  .ct-dropdown-label, .ct-field label {
    display:block; margin-bottom:8px;
    font-size:13px; font-weight:700; color:var(--ct-navy); letter-spacing:.02em;
  }
  /* 문의 유형: 펼침 목록 대신 모든 항목이 보이는 네모 칸 — 고르면 남색으로 채워진다 */
  .ct-type { margin:0; padding:0; border:0; min-width:0; }
  .ct-type-groups { display:grid; gap:16px; }
  .ct-type-group-label { margin-bottom:8px; font-size:12px; font-weight:600; color:var(--ct-label); }
  .ct-type-options { display:flex; flex-wrap:wrap; gap:8px; }
  .ct-type-opt { position:relative; display:block; cursor:pointer; }
  .ct-type-opt input { position:absolute; opacity:0; width:1px; height:1px; pointer-events:none; }
  .ct-type-opt span.ct-type-tile {
    display:inline-flex; align-items:center; gap:8px; height:44px; padding:0 16px;
    border:1px solid var(--ct-field); border-radius:2px; background:#fff;
    font-size:14.5px; font-weight:600; color:var(--ct-ink);
    transition:border-color .18s, background-color .18s, color .18s;
  }
  .ct-type-tile svg { width:14px; height:14px; flex:none; fill:none; stroke:currentColor; stroke-width:2; stroke-linecap:square; display:none; }
  .ct-type-opt:hover span.ct-type-tile { border-color:var(--ct-deep); }
  .ct-type-opt input:checked + span.ct-type-tile { background:var(--ct-deep); border-color:var(--ct-deep); color:#fff; }
  .ct-type-opt input:checked + span.ct-type-tile svg { display:block; }
  .ct-type-opt input:focus-visible + span.ct-type-tile { outline:2px solid var(--ct-deep); outline-offset:2px; }

  /* 입력 칸 */
  .ct-form-grid {
    display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:24px 20px; margin-bottom:28px;
  }
  .ct-field { display:flex; flex-direction:column; min-width:0; }
  .ct-field.full { grid-column:1/-1; }
  .ct-field label { margin-bottom:8px; }
  .ct-field input, .ct-field textarea {
    width:100%; height:48px; padding:0 14px; border:1px solid var(--ct-field);
    border-radius:2px; font-size:15px; color:var(--ct-ink);
    background:#fff; transition:border-color .2s, box-shadow .2s;
    font-family:inherit; outline:none; box-sizing:border-box;
  }
  .ct-field textarea { height:auto; min-height:180px; padding:12px 14px; line-height:1.7; resize:vertical; }
  .ct-field input:focus, .ct-field textarea:focus { border-color:var(--ct-deep); box-shadow:0 0 0 3px rgba(0,79,104,.12); }
  .ct-field input::placeholder, .ct-field textarea::placeholder { color:#8a9ba3; }
  /* 전화번호 앞 국가 선택칸 (스크립트가 만든다) — 입력칸과 같은 모양 */
  .ct-field :global(.ip-cc) { height:48px; border:1px solid var(--ct-field); border-radius:2px; }
  .ct-field :global(.ip-cc:focus) { border-color:var(--ct-deep); box-shadow:0 0 0 3px rgba(0,79,104,.12); }

  .ct-form-footer { display:flex; align-items:center; gap:20px; flex-wrap:wrap; }
  .ct-form-btn {
    display:inline-flex; align-items:center; justify-content:space-between; gap:14px;
    height:52px; padding:0 24px; border-radius:2px;
    background:var(--ct-deep); color:#fff; border:none; cursor:pointer;
    font-size:15px; font-weight:700;
    transition:background-color .2s, gap .25s;
    font-family:inherit; flex-shrink:0;
  }
  .ct-form-btn:hover { background:#00384a; gap:18px; }
  .ct-form-btn:disabled { cursor:default; }
  .ct-form-btn:focus-visible { outline:2px solid var(--ct-deep); outline-offset:3px; }

  /* 개인정보 안내 */
  .ct-privacy {
    margin-top:20px; padding-top:18px; border-top:1px solid var(--ct-line);
    display:flex; align-items:flex-start; gap:8px;
    font-size:13px; color:var(--ct-muted); line-height:1.7;
  }
  .ct-privacy-icon {
    display:inline-flex; align-items:center; justify-content:center;
    width:18px; height:18px; margin-top:2px; border-radius:2px;
    border:1px solid var(--ct-label); flex-shrink:0;
    font-size:11px; font-weight:700; color:var(--ct-label);
    cursor:default; position:relative;
  }
  .ct-privacy-tooltip {
    position:absolute; bottom:calc(100% + 8px); left:50%;
    transform:translateX(-50%);
    background:var(--ct-navy); color:#fff;
    font-size:12px; font-weight:400; line-height:1.6;
    padding:8px 12px; border-radius:2px;
    white-space:nowrap; pointer-events:none;
    opacity:0; transition:opacity .18s;
    z-index:10;
  }
  .ct-privacy-tooltip::after {
    content:""; position:absolute; top:100%; left:50%;
    transform:translateX(-50%);
    border:5px solid transparent;
    border-top-color:var(--ct-navy);
  }
  .ct-privacy-icon:hover .ct-privacy-tooltip { opacity:1; }

  /* 스크롤하면 떠오르기 — 스크립트가 .ct-rv 를 붙일 때만 */
  .ct-rv { opacity:0; transform:translateY(28px); transition:opacity 1.1s cubic-bezier(.2,.7,.2,1) var(--rd, 0s), transform 1.1s cubic-bezier(.2,.7,.2,1) var(--rd, 0s); }
  .ct-rv.is-in { opacity:1; transform:none; }

  /* ── RESPONSIVE ── */
  @media(max-width:980px) {
    .ct-qc-head { grid-template-columns:minmax(0,1fr); gap:28px; align-items:start; }
    .ct-form-layout { grid-template-columns:minmax(0,1fr); gap:40px; }
    .ct-form-side { position:static; }
  }
  @media(max-width:860px) {
    .ct-qc-cols { grid-template-columns:minmax(0,1fr); gap:48px; }
  }
  @media(max-width:740px) {
    .ct-shell { width:calc(100% - 40px); }
    .ct-qc-sec { padding:72px 0 64px; }
    .ct-qc-cols { margin-top:48px; }
    .ct-qc-row { grid-template-columns:76px minmax(0,1fr); gap:4px 12px; }
    .ct-qc-hint { grid-column:2; white-space:normal; }
    .ct-qc-kakao { padding:16px; gap:14px; }
    .ct-qc-kakao-go { display:none; }
    .ct-form-sec { padding:64px 0 72px; }
    .ct-form-wrap { padding:28px 20px; }
    .ct-form-btn { width:100%; }
  }
  @media(max-width:640px) {
    .ct-privacy-tooltip {
      left:0; transform:none;
      white-space:normal; width:max-content; max-width:min(78vw, 260px);
    }
    .ct-privacy-tooltip::after { left:8px; transform:none; }
    .ct-form-grid { grid-template-columns:minmax(0,1fr); } /* 1fr 은 안쪽(전화번호 칸 등) 최소폭만큼 늘어나 모바일에서 화면 밖으로 넘쳤다 */
  }
  @media (prefers-reduced-motion: reduce) {
    .ct-qc-kakao, .ct-qc-kakao-go, .ct-form-btn, .ct-qc-val { transition:none; }
  }
</style>

<div id="lang-root" class="ct">

<!-- HERO -->
<PageHero variant="band" image="https://wolko.synology.me/Web_Contents/Photos/Camp_Ministry/Union_Camp.jpg" pos="50% 45%">
  <Fragment slot="eyebrow"><span class="wl-ko">문의</span><span class="wl-en">Contact</span></Fragment>
  <Fragment slot="title">
    <span class="wl-ko">궁금한 점이 있으신가요?</span>
    <span class="wl-en">Reach Out. We're Listening.</span>
  </Fragment>
  <Fragment slot="desc">
    <span class="wl-ko">선교 동역, 후원, 기도 제목까지, 어떤 이유로 연락 주셔도 성심껏 응답하겠습니다.</span>
    <span class="wl-en">From ministry inquiries and partnership to prayer requests, every message matters to us, and we'll respond with care.</span>
  </Fragment>
</PageHero>

<!-- QUICK CONTACT -->
<section class="ct-qc-sec">
  <div class="ct-shell">

    <div class="ct-qc-head">
      <div>
        <p class="ct-eyebrow"><span class="wl-ko">빠른 연락처</span><span class="wl-en">Quick Contact</span></p>
        <h2 class="ct-title"><span class="wl-ko">평택 본부와<br>제주 월비</span><span class="wl-en">Pyeongtaek HQ<br>&amp; Jeju WOLBI</span></h2>
      </div>

      <!-- KakaoTalk -->
      <a class="ct-qc-kakao" href="http://pf.kakao.com/_Rxidxkxj" target="_blank" rel="noopener">
        <div class="ct-qc-kakao-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 3C6.477 3 2 6.582 2 11c0 2.82 1.7 5.3 4.27 6.84-.19.7-.69 2.54-.79 2.93-.12.48.18.47.38.34.16-.1 2.54-1.72 3.57-2.42.51.07 1.04.11 1.57.11 5.523 0 10-3.582 10-8S17.523 3 12 3z"/></svg>
        </div>
        <div class="ct-qc-kakao-text">
          <div class="ct-qc-kakao-title">KakaoTalk <span class="wl-ko">카카오 채널</span><span class="wl-en">Kakao Channel</span></div>
          <div class="ct-qc-kakao-sub"><span class="wl-ko">채팅으로 가장 빠르게 문의하세요</span><span class="wl-en">The fastest way to reach us</span></div>
        </div>
        <div class="ct-qc-kakao-go">
          <span><span class="wl-ko">채널 방문</span><span class="wl-en">Visit Channel</span></span>
