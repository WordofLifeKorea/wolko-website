---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact — Word of Life Korea"
  description="월코에 문의하거나 연락하세요. 평택 본부와 제주 사무소로 언제든지 연락 주세요."
  activeNav="connect"
>

<style>
  :root {
    --d:#004f68; --m:#007ea1; --l:#73d1f5;
    --r:#c42a36; --k:#0d1b24; --s:#3d5a6a;
    --bg:#f4f8fb; --line:rgba(0,79,104,0.1);
  }

  /* ── HERO ── */
  .ct-hero {
    background: linear-gradient(135deg, #0a1e2b 0%, #004f68 60%, #006a8a 100%);
    padding: 140px 24px 100px;
    text-align: center;
    position: relative;
    overflow: hidden;
  }
  .ct-hero::before {
    content:""; position:absolute; inset:0;
    background-image: radial-gradient(circle at 20% 50%, rgba(115,209,245,0.07) 0%, transparent 55%),
                      radial-gradient(circle at 80% 30%, rgba(115,209,245,0.05) 0%, transparent 50%);
    pointer-events:none;
  }
  .ct-hero::after {
    content:""; position:absolute; inset:0;
    background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px);
    background-size: 60px 60px; pointer-events:none;
  }
  .ct-hero-inner { position:relative; z-index:2; max-width:720px; margin:0 auto; }
  .ct-eyebrow {
    display:inline-flex; align-items:center; gap:8px;
    padding:6px 16px; border-radius:999px;
    background:rgba(115,209,245,0.15); border:1px solid rgba(115,209,245,0.3);
    font-size:11px; font-weight:700; letter-spacing:0.1em; color:var(--l);
    text-transform:uppercase; margin-bottom:20px;
  }
  .ct-hero h1 {
    font-size: clamp(34px, 5vw, 54px); font-weight:700; line-height:1.15;
    color:#fff; margin-bottom:16px; letter-spacing:-0.03em;
  }
  .ct-hero h1 em { font-style:normal; color:var(--l); }
  .ct-hero-sub {
    font-size:17px; line-height:1.85; color:rgba(255,255,255,0.78);
    max-width:580px; margin:0 auto;
  }

  /* ── SECTION ── */
  .ct-section { padding:80px 24px; background:var(--bg); }
  .ct-section-inner { max-width:1060px; margin:0 auto; }

  /* ── SECTION HEADER ── */
  .ct-sh {
    display:flex; align-items:baseline; gap:12px;
    margin-bottom:28px;
  }
  .ct-sh-label {
    font-size:10px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--m);
  }
  .ct-sh-title {
    font-size:clamp(20px, 2.5vw, 26px); font-weight:700;
    color:var(--k); letter-spacing:-0.02em;
  }

  /* ── QUICK CONTACT — floating cards ── */
  .ct-strip {
    display:grid;
    grid-template-columns: repeat(5, 1fr);
    gap:14px;
    margin-bottom:56px;
  }
  .ct-strip-item {
    display:flex; flex-direction:column;
    padding:26px 22px 24px;
    background:#fff;
    border-radius:20px;
    border:1px solid var(--line);
    box-shadow:0 2px 16px rgba(0,79,104,0.06);
    text-decoration:none;
    position:relative; overflow:hidden;
    transition:transform .22s cubic-bezier(.34,1.3,.64,1), box-shadow .22s ease;
    gap:18px;
  }
  /* gradient shine overlay on hover */
  .ct-strip-item::before {
    content:""; position:absolute; inset:0;
    background:linear-gradient(135deg, rgba(0,126,161,0.05) 0%, transparent 70%);
    opacity:0; transition:opacity .22s;
    pointer-events:none; border-radius:inherit;
  }
  /* bottom accent line */
  .ct-strip-item::after {
    content:""; position:absolute; bottom:0; left:16px; right:16px;
    height:2px; border-radius:2px 2px 0 0;
    background:linear-gradient(90deg, var(--d), var(--m));
    transform:scaleX(0); transform-origin:left;
    transition:transform .25s cubic-bezier(.34,1.2,.64,1);
  }
  .ct-strip-item:hover {
    transform:translateY(-6px);
    box-shadow:0 16px 40px rgba(0,79,104,0.13);
  }
  .ct-strip-item:hover::before { opacity:1; }
  .ct-strip-item:hover::after  { transform:scaleX(1); }

  /* icon */
  .ct-strip-icon {
    width:48px; height:48px; border-radius:14px;
    display:flex; align-items:center; justify-content:center;
    flex-shrink:0;
    transition:transform .22s cubic-bezier(.34,1.3,.64,1);
  }
  .ct-strip-item:hover .ct-strip-icon { transform:scale(1.1); }
  .ct-strip-icon svg { width:22px; height:22px; }
  .ct-strip-icon.phone {
    background:linear-gradient(135deg,#e8f4f9 0%,#c8e8f5 100%);
    color:var(--d);
    box-shadow:0 2px 8px rgba(0,79,104,0.12);
  }
  .ct-strip-icon.email {
    background:linear-gradient(135deg,#fdf0f1 0%,#fadde0 100%);
    color:var(--r);
    box-shadow:0 2px 8px rgba(196,42,54,0.12);
  }
  .ct-strip-icon.yt {
    background:linear-gradient(135deg,#fff0f0 0%,#ffdada 100%);
    color:#dc2626;
    box-shadow:0 2px 8px rgba(220,38,38,0.12);
  }

  .ct-strip-body { flex:1; min-width:0; }
  .ct-strip-label {
    font-size:10px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase;
    color:var(--s); margin-bottom:5px;
  }
  .ct-strip-val {
    font-size:14px; font-weight:600; color:var(--k);
    white-space:nowrap; overflow:hidden; text-overflow:ellipsis;
    line-height:1.35;
  }
  .ct-strip-sub {
    font-size:11px; font-weight:400; color:var(--s); margin-top:4px; line-height:1.4;
  }

  /* external link arrow badge */
  .ct-strip-arrow {
    position:absolute; top:18px; right:18px;
    width:24px; height:24px; border-radius:50%;
    background:rgba(0,79,104,0.06);
    display:flex; align-items:center; justify-content:center;
    opacity:0; transform:translate(4px,-4px);
    transition:opacity .2s, transform .2s;
  }
  .ct-strip-arrow svg { width:12px; height:12px; stroke:var(--m); }
  .ct-strip-item:hover .ct-strip-arrow { opacity:1; transform:translate(0,0); }

  /* ── OFFICE CARDS ── */
  .ct-offices {
    display:grid; grid-template-columns:1fr 1fr;
    gap:20px; margin-bottom:56px;
  }
  .ct-office {
    background:#fff; border-radius:20px;
    border:1px solid var(--line);
    box-shadow:0 4px 20px rgba(0,79,104,0.06);
    overflow:hidden;
    transition:box-shadow .2s, transform .2s;
  }
  .ct-office:hover { transform:translateY(-3px); box-shadow:0 12px 36px rgba(0,79,104,0.12); }

  /* accent strip at top */
  .ct-office-accent {
    height:5px;
    background:linear-gradient(90deg, var(--d) 0%, var(--m) 100%);
  }

  .ct-office-head {
    padding:28px 32px 22px;
    border-bottom:1px solid var(--line);
    display:flex; align-items:flex-start; gap:16px;
  }
  .ct-office-badge-icon {
    width:48px; height:48px; border-radius:14px; flex-shrink:0;
    background:linear-gradient(135deg, var(--d) 0%, var(--m) 100%);
    display:flex; align-items:center; justify-content:center;
  }
  .ct-office-badge-icon svg { width:22px; height:22px; stroke:#fff; fill:none; }
  .ct-office-head-text {}
  .ct-office-tag {
    font-size:10px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase;
    color:var(--m); margin-bottom:4px;
  }
  .ct-office-head h2 { font-size:18px; font-weight:700; color:var(--k); margin:0 0 3px; letter-spacing:-0.01em; }
  .ct-office-head p { font-size:13px; font-weight:400; color:var(--s); margin:0; line-height:1.6; }

  .ct-office-body { padding:8px 32px 24px; }
  .ct-info-row {
    display:flex; align-items:center; gap:14px;
    padding:13px 0; border-bottom:1px solid var(--line);
  }
  .ct-info-row:last-child { border-bottom:none; padding-bottom:0; }
  .ct-info-icon {
    width:32px; height:32px; border-radius:8px;
    background:rgba(0,79,104,0.06); display:flex; align-items:center; justify-content:center;
    flex-shrink:0; color:var(--m);
  }
  .ct-info-icon svg { width:15px; height:15px; }
  .ct-info-label { font-size:10px; font-weight:700; color:var(--s); letter-spacing:0.10em; text-transform:uppercase; margin-bottom:2px; }
  .ct-info-val { font-size:14px; font-weight:500; color:var(--k); line-height:1.6; }
  .ct-info-val a { color:var(--d); text-decoration:none; }
  .ct-info-val a:hover { text-decoration:underline; }

  /* ── FORM ── */
  .ct-form-wrap {
    background:#fff; border-radius:20px; padding:48px;
    box-shadow:0 4px 24px rgba(0,79,104,0.07);
    border:1px solid var(--line);
  }

  /* ── INQUIRY DROPDOWN ── */
  .ct-dropdown-wrap { margin-bottom:28px; }
  .ct-dropdown-label {
    font-size:11px; font-weight:700; color:var(--d);
    letter-spacing:0.08em; text-transform:uppercase; margin-bottom:10px;
    display:block;
  }
  .ct-select-wrap { position:relative; }
  .ct-select-wrap select {
    width:100%; padding:13px 44px 13px 16px;
    border:1.5px solid rgba(0,79,104,0.18);
    border-radius:12px; font-size:15px; color:var(--k);
    background:#fafcfe; font-family:inherit; font-weight:400;
    outline:none; cursor:pointer;
    appearance:none; -webkit-appearance:none;
    transition:border-color .2s, box-shadow .2s;
  }
  .ct-select-wrap select:focus {
    border-color:var(--m); box-shadow:0 0 0 3px rgba(0,126,161,0.1); background:#fff;
  }
  .ct-select-chevron {
    position:absolute; right:14px; top:50%; transform:translateY(-50%);
    pointer-events:none; color:var(--s);
  }
  .ct-select-chevron svg { width:18px; height:18px; display:block; }

  /* Form grid */
  .ct-form-grid {
    display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:20px;
  }
  .ct-field { display:flex; flex-direction:column; gap:8px; }
  .ct-field.full { grid-column:1/-1; }
  .ct-field label {
    font-size:11px; font-weight:700; color:var(--d); letter-spacing:0.08em; text-transform:uppercase;
  }
  .ct-field input, .ct-field textarea {
    width:100%; padding:13px 16px; border:1.5px solid rgba(0,79,104,0.18);
    border-radius:10px; font-size:15px; color:var(--k);
    background:#fafcfe; transition:border-color .2s, box-shadow .2s;
    font-family:inherit; outline:none; box-sizing:border-box;
  }
  .ct-field input:focus, .ct-field textarea:focus {
    border-color:var(--m); box-shadow:0 0 0 3px rgba(0,126,161,0.1);
    background:#fff;
  }
  .ct-field textarea { resize:vertical; min-height:130px; }

  .ct-form-footer {
    display:flex; align-items:flex-start; gap:20px; flex-wrap:wrap;
  }
  .ct-form-btn {
    display:inline-flex; align-items:center; gap:10px;
    padding:14px 36px; border-radius:999px;
    background:var(--d); color:#fff; border:none; cursor:pointer;
    font-size:15px; font-weight:700; letter-spacing:0.02em;
    transition:background .2s, transform .2s;
    font-family:inherit; flex-shrink:0;
  }
  .ct-form-btn:hover { background:var(--m); transform:translateY(-2px); }
  .ct-form-note {
    font-size:13px; color:var(--s); line-height:1.7;
    padding:12px 16px; background:rgba(0,79,104,0.04);
    border-radius:10px; border-left:3px solid var(--m);
    flex:1; min-width:220px;
  }

  /* privacy consent */
  .ct-privacy {
    margin-top:16px;
    display:flex; align-items:center; gap:7px;
    font-size:12px; color:var(--s); line-height:1.6;
  }
  .ct-privacy-icon {
    display:inline-flex; align-items:center; justify-content:center;
    width:16px; height:16px; border-radius:50%;
    border:1.5px solid var(--s); flex-shrink:0;
    font-size:10px; font-weight:700; color:var(--s);
    cursor:default; position:relative;
  }
  .ct-privacy-tooltip {
    position:absolute; bottom:calc(100% + 8px); left:50%;
    transform:translateX(-50%);
    background:var(--k); color:#fff;
    font-size:11.5px; font-weight:400; line-height:1.6;
    padding:8px 12px; border-radius:8px;
    white-space:nowrap; pointer-events:none;
    opacity:0; transition:opacity .18s;
    box-shadow:0 4px 16px rgba(0,0,0,0.18);
    z-index:10;
  }
  .ct-privacy-tooltip::after {
    content:""; position:absolute; top:100%; left:50%;
    transform:translateX(-50%);
    border:5px solid transparent;
    border-top-color:var(--k);
  }
  .ct-privacy-icon:hover .ct-privacy-tooltip { opacity:1; }

  /* ── RESPONSIVE ── */
  @media(max-width:1000px) {
    .ct-strip { grid-template-columns:repeat(3,1fr); }
    .ct-strip-item:nth-child(4),
    .ct-strip-item:nth-child(5) { grid-column:auto; }
  }
  @media(max-width:860px) {
    .ct-offices { grid-template-columns:1fr; }
  }
  @media(max-width:700px) {
    .ct-strip { grid-template-columns:1fr 1fr; gap:10px; }
    .ct-strip-item:nth-child(5) { grid-column:1/-1; }
  }
  @media(max-width:640px) {
    .ct-form-wrap { padding:28px 20px; }
    .ct-form-grid { grid-template-columns:1fr; }
    .ct-office-body { padding:8px 20px 20px; }
    .ct-office-head { padding:22px 20px 18px; }
  }
</style>

<div id="lang-root">

<!-- HERO -->
<section class="ct-hero">
  <div class="ct-hero-inner">
    <div class="ct-eyebrow">Contact</div>
    <h1>
      <span class="wl-ko">궁금한 점이<br><em>있으신가요?</em></span>
      <span class="wl-en">Reach Out.<br><em>We're Listening.</em></span>
    </h1>
    <p class="ct-hero-sub">
      <span class="wl-ko">선교 동역, 후원, 기도 제목까지 — 어떤 이유로 연락 주셔도 성심껏 응답하겠습니다.</span>
      <span class="wl-en">From ministry inquiries and partnership to prayer requests — every message matters to us, and we'll respond with care.</span>
    </p>
  </div>
</section>

<!-- MAIN SECTION -->
<section class="ct-section">
  <div class="ct-section-inner">

    <!-- QUICK CONTACT STRIP -->
    <div class="ct-sh" style="margin-bottom:20px;">
      <span class="ct-sh-label"><span class="wl-ko">빠른 연락처</span><span class="wl-en">Quick Contact</span></span>
    </div>
    <div class="ct-strip">

      <a class="ct-strip-item" href="tel:070-4190-6084">
        <div class="ct-strip-arrow"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></div>
        <div class="ct-strip-icon phone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 12 19.79 19.79 0 0 1 1.93 3.42 2 2 0 0 1 3.89 1.25h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <div class="ct-strip-body">
          <div class="ct-strip-label"><span class="wl-ko">평택 본부</span><span class="wl-en">Pyeongtaek HQ</span></div>
          <div class="ct-strip-val">070-4190-6084</div>
          <div class="ct-strip-sub"><span class="wl-ko">화–금 09:00–17:00</span><span class="wl-en">Tue–Fri 9–5 PM</span></div>
        </div>
      </a>

      <a class="ct-strip-item" href="tel:064-799-3707">
        <div class="ct-strip-arrow"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></div>
        <div class="ct-strip-icon phone">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.99 12 19.79 19.79 0 0 1 1.93 3.42 2 2 0 0 1 3.89 1.25h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 8.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
          </svg>
        </div>
        <div class="ct-strip-body">
          <div class="ct-strip-label"><span class="wl-ko">제주 월비</span><span class="wl-en">Jeju WOLBI</span></div>
          <div class="ct-strip-val">064-799-3707</div>
          <div class="ct-strip-sub"><span class="wl-ko">화–금 09:00–17:00</span><span class="wl-en">Tue–Fri 9–5 PM</span></div>
        </div>
      </a>

      <a class="ct-strip-item" href="mailto:wolkorea1@gmail.com">
        <div class="ct-strip-arrow"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></div>
        <div class="ct-strip-icon email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
