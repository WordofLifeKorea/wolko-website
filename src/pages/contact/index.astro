<script is:inline>
(function applyInquiryPreset() {
  var typeSelect = document.getElementById('ct-type-select');
  if (!typeSelect) return;

  var requestedType = new URLSearchParams(window.location.search).get('type');
  var isAllowedType = Array.from(typeSelect.options).some(function(option) {
    return option.value === requestedType;
  });
  if (!isAllowedType) return;

  typeSelect.value = requestedType;
})();

// 문의 유형 칸 ↔ 숨은 select: 칸을 고르면 select 값이 바뀌고, 주소의 ?type= 이나 이어쓰기가 select 를 바꾸면 칸도 따라간다.
(function syncInquiryTiles() {
  var sel = document.getElementById('ct-type-select');
  var picks = [].slice.call(document.querySelectorAll('input[name="ct-type-pick"]'));
  if (!sel || !picks.length) return;
  function fromSelect() { picks.forEach(function (r) { r.checked = r.value === sel.value; }); }
  picks.forEach(function (r) {
    r.addEventListener('change', function () { if (r.checked) sel.value = r.value; });
  });
  sel.addEventListener('change', fromSelect);
  fromSelect();
  document.addEventListener('DOMContentLoaded', fromSelect);
  window.addEventListener('load', fromSelect);
})();

function ctIsEn() { return document.documentElement.classList.contains('lang-en'); }
function ctT(ko, en) { return ctIsEn() ? en : ko; }

// 선택 목록·입력 안내문·브라우저 입력 확인 메시지도 지금 언어 하나만 보이게 맞춘다
function ctSyncLang() {
  var en = ctIsEn();
  document.querySelectorAll('#ct-type-select option[data-ko]').forEach(function(o) { o.textContent = en ? o.dataset.en : o.dataset.ko; });
  document.querySelectorAll('[data-ph-ko]').forEach(function(el) { el.setAttribute('placeholder', en ? el.dataset.phEn : el.dataset.phKo); });
}
ctSyncLang();
new MutationObserver(ctSyncLang).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
document.addEventListener('DOMContentLoaded', ctSyncLang);
(function localizeValidation() {
  var form = document.querySelector('.ct-form-wrap form');
  if (!form) return;
  form.addEventListener('invalid', function(ev) {
    var el = ev.target;
    el.setCustomValidity('');
    if (el.validity.valueMissing) el.setCustomValidity(ctT('이 항목을 입력해 주세요.', 'Please fill out this field.'));
    else if (el.validity.typeMismatch) el.setCustomValidity(ctT('올바른 이메일 주소를 입력해 주세요.', 'Please enter a valid email address.'));
  }, true);
  form.addEventListener('input', function(ev) { ev.target.setCustomValidity && ev.target.setCustomValidity(''); });
})();

// 사이트 공통 입력칸은 34px 로 맞춰져 있다 — 이 문의 양식은 큰 칸(.wl-tall)을 쓴다.
// 문의 유형 선택칸과 전화번호 앞 국가 선택칸(phone-input.js 가 만든다)도 같은 높이로 맞춘다.
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('#ct-type-select, .ct-field .ip-cc').forEach(function (el) { el.classList.add('wl-tall'); });
});

// 문의 페이지 움직임: 스크롤하면 제목과 연락처 묶음이 아래에서 차례로 떠오른다(입력 양식 안쪽은 움직이지 않는다).
// 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다.
(function () {
  if (!('IntersectionObserver' in window)) return;
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var items = [].slice.call(document.querySelectorAll('.ct-qc-head > *, .ct-qc-col, .ct-form-side > *, .ct-form-wrap'));
  items.forEach(function (el) {
    var sib = el.parentNode.children, i = [].indexOf.call(sib, el);
    el.style.setProperty('--rd', Math.min(i, 6) * 0.08 + 's');
    el.classList.add('ct-rv');
  });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  items.forEach(function (el) { io.observe(el); });
})();

async function handleSubmit(e) {
  e.preventDefault();
  var form = e.target;
  var btn  = form.querySelector('.ct-form-btn');
  var btnOriginal = btn.innerHTML;
  btn.disabled = true;
  btn.innerHTML = '<span style="opacity:.7">' + ctT('전송 중...', 'Sending...') + '</span>';

  var name    = form.querySelector('#ct-name').value.trim();
  var email   = form.querySelector('#ct-email').value.trim();
  var phone   = (form.querySelector('#ct-phone').value || '').trim();
  var type    = document.getElementById('ct-type-select').value;
  var message = form.querySelector('#ct-msg').value.trim();

  try {
    var res = await fetch('/api/contact', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      // website: 사람에게는 보이지 않는 칸(자동 입력 방지) / lang: 지금 보고 있는 사이트 언어(문의 담당자 배정에 참고)
      body: JSON.stringify({ name: name, email: email, phone: phone, type: type, message: message, website: (form.querySelector('#ct-website') || {}).value || '', lang: (document.documentElement.classList.contains('lang-en') || document.body.classList.contains('lang-en')) ? 'en' : 'ko' }),
    });

    if (!res.ok) {
      var errData = await res.json().catch(function() { return {}; });
      throw new Error(errData.error || ctT('전송 실패', 'Send failed'));
    }

    // 접수 완료 — 양식 자리에 안내 문장만 남긴다(왼쪽 정렬, 굵은 윗줄)
    var d = document.createElement('div');
    d.style.cssText = 'padding:40px 0 32px;border-top:2px solid #0b2430;';
    var koP = document.createElement('p');
    koP.className = 'wl-ko';
    koP.style.cssText = "font-family:var(--ff-serif);font-size:24px;font-weight:700;letter-spacing:-.02em;color:#0b2430;line-height:1.55;";
    koP.innerHTML = '문의가 접수되었습니다.<br>영업일 기준 1-2일 내로 연락 드리겠습니다.';
    var enP = document.createElement('p');
    enP.className = 'wl-en';
    enP.style.cssText = "font-family:var(--ff-serif);font-size:24px;font-weight:700;letter-spacing:-.02em;color:#0b2430;line-height:1.55;";
    enP.innerHTML = "Your message has been received.<br>We’ll be in touch within 1–2 business days.";
    d.appendChild(koP);
    d.appendChild(enP);
    form.innerHTML = '';
    form.appendChild(d);

  } catch (err) {
    btn.disabled = false;
    btn.innerHTML = btnOriginal;
    alert(ctT('전송 중 오류가 발생했습니다. 이메일로 직접 연락해 주세요 - wolkorea1@gmail.com', 'An error occurred. Please email us at wolkorea1@gmail.com'));
  }
}
</script>

