          <div class="ct-qc-lbl"><span class="wl-ko">전화</span><span class="wl-en">Phone</span></div>
          <div class="ct-qc-val">031-611-9216</div>
          <div class="ct-qc-hint"><span class="wl-ko">화–금 09–17</span><span class="wl-en">Tue–Fri 9–5</span></div>
        </a>
