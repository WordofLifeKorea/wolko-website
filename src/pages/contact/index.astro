      <a class="ct-strip-item" href="https://www.youtube.com/@wordoflifebibleinstituteje1608" target="_blank" rel="noopener">
        <div class="ct-strip-arrow"><svg viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg></div>
        <div class="ct-strip-icon yt">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <polygon points="10 8 16 12 10 16 10 8" fill="currentColor" stroke="none"/>
          </svg>
        </div>
        <div class="ct-strip-body">
          <div class="ct-strip-label">YouTube</div>
          <div class="ct-strip-val">WOLBI Jeju</div>
          <div class="ct-strip-sub"><span class="wl-ko">제주 사역 영상</span><span class="wl-en">Jeju Campus Videos</span></div>
        </div>
      </a>

    </div>

    <!-- CONTACT FORM -->
    <div class="ct-sh">
      <span class="ct-sh-label"><span class="wl-ko">문의 보내기</span><span class="wl-en">Send a Message</span></span>
    </div>
    <div class="ct-form-wrap">
      <form onsubmit="handleSubmit(event)">
        <input type="hidden" name="type" id="ct-type-val" value="general" />

        <!-- 문의 유형 드롭다운 -->
        <div class="ct-dropdown-wrap">
          <label class="ct-dropdown-label" for="ct-type-select">
            <span class="wl-ko">문의 유형</span><span class="wl-en">Inquiry Type</span>
          </label>
          <div class="ct-select-wrap">
            <select id="ct-type-select" onchange="document.getElementById('ct-type-val').value=this.value">
              <optgroup label="─────────────────────────">
                <option value="general">일반 문의 / General Inquiry</option>
                <option value="ministry">사역 협력 / Ministry Partnership</option>
                <option value="mission">선교팀 / Mission Team</option>
