</section>

<!-- CONTACT FORM -->
<section class="ct-form-sec">
  <div class="ct-shell ct-form-layout" id="contact-form">

    <div class="ct-form-side">
      <p class="ct-eyebrow"><span class="wl-ko">문의 보내기</span><span class="wl-en">Send a Message</span></p>
      <h2 class="ct-title"><span class="wl-ko">문의 남기기</span><span class="wl-en">Leave a Message</span></h2>
      <p class="ct-form-note">
        <span class="ct-form-note-icon" aria-hidden="true">i</span>
        <span>
          <span class="wl-ko">보내주신 문의는 영업일 기준 1–2일 내로 답변 드리겠습니다. 긴급한 사항은 전화로 연락해 주세요.</span>
          <span class="wl-en">We typically respond within 1–2 business days. For urgent matters, please call us directly.</span>
        </span>
      </p>
    </div>

    <div class="ct-form-wrap">
      <form onsubmit="handleSubmit(event)">
        <!-- 문의 유형 드롭다운 -->
        <!-- 문의 유형: 보이는 선택 칸과 숨은 select 가 같은 값을 쓴다 (보내기 · ?type= · 이어쓰기는 select 값) -->
        <div class="ct-dropdown-wrap">
          <fieldset class="ct-type">
            <legend class="ct-dropdown-label"><span class="wl-ko">문의 유형</span><span class="wl-en">Inquiry Type</span></legend>
            <div class="ct-type-groups">
              <div class="ct-type-group">
