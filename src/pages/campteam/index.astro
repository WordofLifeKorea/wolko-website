---
import CampTeamLayout from '../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="캠프팀 홈" active="home">
  <div class="top">
    <div><div class="h1row"><h1 data-t="homeTitle"></h1><span class="qh" data-h="pageHome"></span></div><div class="sub" id="homeSub"></div></div>
    <div class="actions"><button class="btn" id="editHome" type="button" hidden></button><span class="qh" data-h="editHome"></span></div>
  </div>
  <div id="todayBox"></div>
  <div class="editbar" id="editBar" hidden></div>
  <div class="dash" id="homeGrid"></div>
  <script is:inline slot="scripts" src="/campteam/home.js?v=12"></script>
</CampTeamLayout>
