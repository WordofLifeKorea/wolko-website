---
import CampTeamLayout from '../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="캠프팀 홈" active="home">
  <div class="top">
    <div><h1 data-t="homeTitle"></h1><div class="sub" id="homeSub"></div></div>
  </div>
  <section class="stats" id="stats"></section>
  <div class="grid">
    <section class="card"><h2><span data-t="activeCamps"></span><a href="/campteam/camps/" data-t="allCamps"></a></h2><div id="camps"></div></section>
    <section class="card"><h2><span data-t="upcoming"></span><a href="/campteam/tasks/" data-t="allCamps"></a></h2><div id="deadlines"></div></section>
    <section class="card"><h2><span data-t="attention"></span><a href="/campteam/tasks/" data-t="allCamps"></a></h2><div id="attention"></div></section>
    <section class="card"><h2><span data-t="agenda"></span><a href="/campteam/meetings/" data-t="allCamps"></a></h2><div id="agenda"></div></section>
    <section class="card full">
      <div class="two">
        <div><h2><span data-t="recentMeetings"></span><a href="/campteam/meetings/" data-t="allCamps"></a></h2><div id="meetings"></div></div>
        <div><h2><span data-t="recentFiles"></span><a href="/campteam/files/" data-t="allCamps"></a></h2><div id="files"></div></div>
      </div>
    </section>
    <section class="card full"><h2 data-t="budget"></h2><div id="budget"></div></section>
  </div>
  <script is:inline slot="scripts" src="/campteam/home.js?v=1"></script>
</CampTeamLayout>
