---
import CampTeamLayout from '../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="일정 · 업무" active="tasks">
  <div class="top">
    <div><h1 data-t="tasksTitle"></h1><div class="sub" data-t="tasksSub"></div></div>
    <div class="actions"><button class="btn" id="addEvent" hidden data-t="addEvent"></button><button class="btn pri" id="addTask" hidden data-t="addTask"></button></div>
  </div>
  <div class="hintbox" id="viewOnly" data-t="viewOnly" hidden style="margin-bottom:14px"></div>
  <div class="tabs" id="tabs">
    <button class="tab on" data-tab="list" data-t="tabList"></button>
    <button class="tab" data-tab="cal" data-t="tabCal"></button>
    <button class="tab" data-tab="tpl" data-t="tabTpl"></button>
    <button class="tab" data-tab="imp" data-t="tabImp" id="impTab" hidden></button>
  </div>

  <section id="paneList">
    <div class="pills" id="pills"></div>
    <div class="filters t">
      <input id="tq" type="search" maxlength="80" data-t-ph="searchPh">
      <select id="tcamp"></select><select id="tstatus"></select><select id="tpri"></select><select id="towner"></select><select id="tsort"></select>
    </div>
    <div id="tlist"></div>
  </section>

  <section id="paneCal" hidden>
    <div class="cal-head"><button class="btn sm" id="calPrev">‹</button><h2 id="calTitle"></h2><button class="btn sm" id="calNext">›</button><button class="btn sm" id="calToday" data-t="today"></button>
      <span style="margin-left:auto" class="seg"><button class="btn sm" id="viewGrid" data-t="viewGrid"></button> <button class="btn sm" id="viewAgenda" data-t="viewAgenda"></button></span></div>
    <div id="calBody"></div>
    <div class="legend" id="legend"></div>
  </section>

  <section id="paneTpl" hidden>
    <div class="actions" style="margin-bottom:12px"><button class="btn" id="addTpl" hidden data-t="addTpl"></button></div>
    <div id="tplList"></div>
  </section>

  <section id="paneImp" hidden>
    <div class="card">
      <h2 data-t="impTitle"></h2>
      <div class="hintbox" data-t="impHelp" style="margin-bottom:10px"></div>
      <textarea class="big" id="csv" placeholder="Task,Owner,Due,Status,Camp,Priority,Source,Notes"></textarea>
      <div class="actions" style="margin-top:10px"><button class="btn" id="impPreview" data-t="impPreview"></button><button class="btn pri" id="impRun" hidden data-t="impRun"></button></div>
      <div id="impOut" style="margin-top:12px"></div>
    </div>
  </section>

  <dialog id="dlg" class="wide">
    <h3 id="dlgTitle"></h3>
    <form id="dlgForm" class="form" method="dialog"><div id="dlgFields" class="form"></div><div class="err" id="dlgErr" hidden></div>
      <div class="dlg-actions" id="dlgActions"></div></form>
  </dialog>
  <script is:inline slot="scripts" src="/campteam/tasks.js?v=1"></script>
</CampTeamLayout>
