---
import CampTeamLayout from '../../layouts/CampTeamLayout.astro';
---
<CampTeamLayout title="캠프별 공간" active="camps">
  <div class="top"><div><div class="h1row"><h1 id="spTitle">…</h1><span class="qh" data-h="campSpace"></span></div><div class="sub" id="spSub"></div></div><div class="actions" id="spActions"></div></div>
  <section class="stats" id="spStats"></section>
  <div class="editbar" id="spEditBar" hidden></div>
  <div id="spCamps"></div>
  <div id="spPortal" style="margin-bottom:16px"></div>
  <div class="grid" id="spGrid"></div>
  <dialog id="dlg" class="wide">
    <h3 id="dlgTitle"></h3>
    <form id="dlgForm" class="form" method="dialog"><div id="dlgFields" class="form"></div><div class="err" id="dlgErr" hidden></div><div class="dlg-actions" id="dlgActions"></div></form>
  </dialog>
  <script is:inline slot="scripts" src="/campteam/space-portal.js?v=4"></script>
  <script is:inline slot="scripts" src="/campteam/space.js?v=4"></script>
</CampTeamLayout>
