---
// 추천서 작성 — 스태프 지원서를 낸 사람의 추천인이 메일로 받은 개인 링크(?t=…)로 들어온다. 검색엔진에 올리지 않는다.
// 답변은 functions/api/apply/reference.js 가 암호화해 저장하고, 포탈 섬김 지원 신청서에서 검토 담당자만 본다.
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta name="referrer" content="no-referrer">
  <title>Confidential Reference · 추천서 — Word of Life Korea</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+KR:wght@400;500;700&family=Dancing+Script:wght@600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/apply.css?v=2">
  <link rel="stylesheet" href="/reference.css?v=2">
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
</head>
<body class="rf">
  <header class="ap-top">
    <div class="ap-top-in">
      <span class="ap-brand"><img src="/images/WOLKO Circle.png" alt=""><span><b>Word of Life Korea</b><small>월코</small></span></span>
      <div class="ap-lang" role="group" aria-label="Language"><button type="button" data-lang="en">English</button><button type="button" data-lang="ko">한국어</button></div>
    </div>
  </header>

  <main class="rf-main">
    <article class="rf-doc" id="rfDoc">
      <div class="rf-letterhead">
        <div><p class="rf-org">WORD OF LIFE KOREA</p><h1 data-i="title">Confidential Reference Form</h1><p class="rf-sub" data-i="sub">Staff Application · 스태프 지원서 추천서</p></div>
        <span class="rf-stamp" data-i="stamp">CONFIDENTIAL</span>
      </div>
      <p class="rf-status" id="rfStatus" data-i="loading">Loading…</p>
      <div id="rfBody" hidden>
        <table class="rf-meta">
          <tr><th data-i="applicant">Applicant</th><td id="rfApplicant">—</td></tr>
          <tr><th data-i="referee">Referee</th><td id="rfReferee">—</td></tr>
          <tr><th data-i="position">Position applied for</th><td data-i="positionV">Staff — Word of Life Korea</td></tr>
          <tr><th data-i="due">Link valid until</th><td id="rfDue">—</td></tr>
        </table>
        <div class="rf-intro" data-i="intro">The applicant named above has applied to serve with Word of Life Korea, a ministry that reaches and disciples young people, and has listed you as a reference. Please answer candidly. Your reference is confidential: it is read only by our reviewers and is never shared with the applicant.</div>
        <form id="rfForm" novalidate>
          <div id="rfSections"></div>
          <div class="rf-sign">
            <div class="rf-sign-line"><span class="rf-sign-preview" id="rfSignPreview"></span></div>
            <div class="rf-sign-meta"><span data-i="signedBy">Signature of referee</span><span id="rfDate"></span></div>
          </div>
          <p class="ap-err" id="rfErr" role="alert" hidden></p>
          <div class="ap-actions"><span class="ap-saved" data-i="secure">Submitted securely · 암호화하여 저장됩니다</span><button type="submit" class="ap-btn primary" id="rfSubmit" data-i="submit">Submit Reference</button></div>
        </form>
      </div>
      <div class="rf-done" id="rfDone" hidden>
        <div class="ap-done-mark" aria-hidden="true">✓</div>
        <h2 data-i="doneTitle">Thank you for your reference</h2>
        <p data-i="doneLead">Your reference has been submitted securely. We are grateful for the time you took to help us care for the young people we serve.</p>
      </div>
    </article>
  </main>
  <footer class="ap-foot"><span>© Word of Life Korea · 월코</span><span data-i="footNote">This form is confidential and used only for staff selection.</span></footer>
  <script is:inline src="/reference.js?v=1" defer></script>
</body>
</html>
