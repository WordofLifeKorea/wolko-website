---
// 차량 QR → 사용 전 사진 → 로그인 계정에 연결된 사용 일지.
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <script is:inline src="/wolko-lang-sync.js?v=2"></script>
  <title>차량 사용 일지 — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolko-lang-toggle.css?v=2">
  <link rel="stylesheet" href="/car-log.css?v=7">
  <link rel="stylesheet" href="/wolko-rail.css?v=15">
  <link rel="stylesheet" href="/wolko-header.css?v=12">
  <link rel="stylesheet" href="/wolko-ui.css?v=2">
  <link rel="stylesheet" href="/wolko-layout.css?v=13">
  <script src="/wolko-rail.js?v=24" defer></script>
  <script src="/car-log.js?v=5" defer></script>
  <meta name="theme-color" content="#004f68">
</head>
<body>
  <header class="car-header">
    <a class="car-header-logo" href="/portal" title="WOLKO 포탈로 돌아가기">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <span data-t="pageTitle">차량 스케줄</span>
    </a>
    <div class="car-header-right">
      <div class="wl-lang-toggle" role="group" aria-label="Language">
        <button type="button" class="wl-lang-btn" id="langKoBtn" aria-label="한국어" title="한국어"><img src="https://flagcdn.com/w20/kr.png" alt=""><span>KO</span></button>
        <button type="button" class="wl-lang-btn" id="langEnBtn" aria-label="English" title="English"><img src="https://flagcdn.com/w20/us.png" alt=""><span>EN</span></button>
      </div>
    </div>
  </header>

  <main class="log-wrap">
    <nav class="car-view-tabs car-view-tabs-4" aria-label="차량 메뉴" data-t-aria="menuLabel">
      <a class="car-view-tab" href="/car-drive/">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <span data-t="tabDrive">운행 스케줄</span>
      </a>
      <a class="car-view-tab is-active" href="/car-log/" aria-current="page">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg>
        <span data-t="tabLog">사용 일지</span>
      </a>
      <a class="car-view-tab" href="/car/">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        <span data-t="tabReservations">예약현황</span>
      </a>
      <a class="car-view-tab" href="/car/?view=maintenance">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
        <span data-t="tabMaintenance">정비 관리</span>
      </a>
    </nav>
    <p class="wl-lead" data-t="intro">운행 전 사진 한 장으로 사용 시각과 목적을 남깁니다.</p>

    <p class="log-loading" id="loadStatus" data-t="loading">일지를 불러오는 중…</p>

    <section class="log-panel" id="loginPanel" hidden>
      <div class="log-panel-head"><span class="log-step">01</span><h2 data-t="loginTitle">포탈 로그인</h2></div>
      <p class="log-help" data-t="loginHelp">차량 QR을 새 탭에서 열었다면 다시 로그인해야 할 수 있습니다. 기록자는 로그인 계정으로 자동 저장됩니다.</p>
      <form id="loginForm" class="log-form">
        <label><span data-t="email">이메일</span><input id="loginEmail" type="email" autocomplete="username" required></label>
        <label><span data-t="password">비밀번호</span><input id="loginPassword" type="password" autocomplete="current-password" required></label>
        <button class="log-primary" type="submit" data-t="loginBtn">로그인하고 계속하기</button>
      </form>
      <p class="log-error" id="loginError" role="alert"></p>
    </section>

    <div id="logApp" hidden>
      <section class="log-panel">
        <div class="log-panel-head"><span class="log-step">01</span><h2 data-t="recordTitle">운행 전 기록</h2></div>
        <p class="log-user"><span data-t="recorder">기록자</span> <strong id="currentUser"></strong></p>
        <form id="usageForm" class="log-form">
          <label><span data-t="vehicleLabel">차량 선택</span>
            <select id="vehicleSelect" name="vehicleId" required></select>
          </label>
          <fieldset class="log-purpose">
            <legend data-t="purposeLegend">사용 목적</legend>
            <div class="log-purpose-options">
              <label><input type="radio" name="useType" value="ministry" required><span data-t="ministry">사역용</span></label>
              <label><input type="radio" name="useType" value="personal" required><span data-t="personal">개인용</span></label>
            </div>
          </fieldset>
          <div class="log-photo-step">
            <strong data-t="photoTitle">운행 전 사진</strong>
            <p data-t="photoHelp">계기판이나 차량 상태가 보이도록 찍어 주세요. 사용 목적을 고르면 카메라를 열 수 있습니다.</p>
            <input id="photoInput" type="file" accept="image/*" capture="environment" hidden>
            <button id="photoButton" class="log-secondary" type="button" disabled data-t="photoBtn">카메라 열기 · 사진 선택</button>
            <img id="photoPreview" class="log-preview" alt=""  hidden>
            <p class="log-time" id="photoTime" aria-live="polite"></p>
          </div>
          <button id="saveButton" class="log-primary" type="submit" disabled data-t="save">사용 일지 저장</button>
        </form>
        <p class="log-error" id="formError" role="alert"></p>
      </section>

      <section class="log-panel log-history">
        <div class="log-panel-head"><span class="log-step">02</span><h2 data-t="historyTitle">최근 사용 내역</h2><button id="clearAllBtn" class="log-clear" type="button" hidden data-t="clearAll">전체 비우기</button></div>
        <p class="log-help" data-t="historyHelp">기록은 로그인 계정과 함께 저장됩니다. 사진은 포탈 사용자만 볼 수 있습니다.</p>
        <div id="entryList" class="log-entries"></div>
      </section>

      <details class="log-panel log-qr">
        <summary data-t="qrTitle">차량에 부착할 QR 코드</summary>
        <p class="log-help" data-t="qrHelp">고정 차량의 코드를 인쇄해 각 차량에 부착하세요. 스캔하면 해당 차량이 자동 선택됩니다.</p>
        <div class="log-qr-grid">
          <div><img src="/images/car-qr-silver-van.svg" alt="Silver Van 사용 일지 QR 코드"><strong>Silver Van</strong></div>
          <div><img src="/images/car-qr-santa-fe.svg" alt="Santa Fe 사용 일지 QR 코드"><strong>Santa Fe</strong></div>
        </div>
        <button class="log-secondary log-print" id="printQrButton" type="button" data-t="qrPrint">QR 코드 인쇄</button>
      </details>
    </div>
  </main>

  <div id="photoDialog" class="log-photo-dialog" hidden role="dialog" aria-modal="true" aria-label="차량 사진" data-t-aria="photoDialog">
    <button id="closePhoto" type="button" aria-label="사진 닫기" data-t-aria="closePhoto">×</button>
    <img id="fullPhoto" alt="차량 사용 전 사진">
  </div>
</body>
</html>
