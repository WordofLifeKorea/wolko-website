---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="청소년 사역 — Word of Life Korea"
  description="교회에서 세워지고, 친구에게 이어지는 복음 — 월코 청소년 사역"
  activeNav="ministry"
>

<!-- WOLKO 청소년사역 본문 | 캠프 디자인 언어 + 레이아웃 변형 | 플로팅 바 분리 -->
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700;900&family=Noto+Sans+KR:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,700;0,800;1,700&family=Playfair+Display:ital,wght@0,700;1,400;1,700&display=swap');

/* ══ 언어 표시/숨김 ══ */
.wl-ko { display: block; }
.wl-en { display: none; }
span.wl-ko { display: inline; }
span.wl-en { display: none; }
.lang-en .wl-ko { display: none !important; }
.lang-en .wl-en { display: block !important; }
.lang-en span.wl-en { display: inline !important; }

/* ══ WRAP ══ */
.wym-wrap {
  --c-deep:   #004f68;
  --c-mid:    #007ea1;
  --c-light:  #73d1f5;
  --c-red:    #c42a36;
  --c-red-dk: #a82330;
  --c-white:  #ffffff;
  --c-off:    #f5fafd;
  --c-pale:   #eef7fb;
  --c-text:   #111820;
  --c-sub:    #334a56;
  --c-muted:  #6b8896;
  --c-border: rgba(0,79,104,0.12);
  --f-serif:  'Playfair Display', 'Noto Serif KR', Georgia, serif;
  --f-sans:   'Noto Sans KR', sans-serif;
  --sp-xs: 8px; --sp-sm: 16px; --sp-md: 24px;
  --sp-lg: 40px; --sp-xl: 64px; --sp-2xl: 96px; --sp-3xl: 140px;
  --max-w: 1100px; --pad-h: 48px;
  font-family: var(--f-sans);
  font-weight: 400;
  color: var(--c-text);
  background: var(--c-white);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  width: 100%;
}
.wym-wrap *, .wym-wrap *::before, .wym-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }
.wym-wrap img { display: block; width: 100%; }
.wym-wrap a { text-decoration: none; color: inherit; }
.wym-wrap ul { list-style: none; }

/* reveal */
.wym-wrap .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
.wym-wrap .reveal.visible { opacity: 1; transform: none; }
.wym-wrap .reveal-delay-1 { transition-delay: .10s; }
.wym-wrap .reveal-delay-2 { transition-delay: .20s; }
.wym-wrap .reveal-delay-3 { transition-delay: .30s; }

/* 공통 */
.wym-wrap .section-label {
  display: inline-flex; align-items: center; gap: var(--sp-sm);
  font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--c-mid); margin-bottom: var(--sp-sm);
}
.wym-wrap .section-label::before { content: ''; width: 14px; height: 2px; background: var(--c-red); flex-shrink: 0; }
.wym-wrap .section-title {
  font-family: var(--f-serif); font-size: clamp(30px, 4vw, 50px);
  font-weight: 700; color: var(--c-deep); line-height: 1.14;
  letter-spacing: -0.025em; word-break: keep-all;
}
.wym-wrap .section-desc { font-size: 16px; line-height: 1.9; color: var(--c-sub); word-break: keep-all; }
.wym-wrap .accent-line { width: 48px; height: 3px; background: linear-gradient(90deg, var(--c-red), var(--c-mid)); border-radius: 2px; margin: var(--sp-md) 0 var(--sp-lg); }
.wym-wrap .full-bleed { margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }

/* ── HERO ── */
.wym-wrap .hero {
  position: relative; min-height: 100vh; background: var(--c-deep);
  display: flex; align-items: center; overflow: hidden;
}
.wym-wrap .hero { margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wym-wrap .hero-bg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.20; }
.wym-wrap .hero::before {
  content: ''; position: absolute; inset: 0; z-index: 1;
  background: linear-gradient(105deg,
    rgba(0,20,32,0.88) 0%,
    rgba(0,40,55,0.72) 45%,
    rgba(0,79,104,0.28) 65%,
    transparent 80%);
}
.wym-wrap .hero::after {
  content: ''; position: absolute; inset: 0; z-index: 1;
  background: radial-gradient(ellipse 60% 70% at 80% 40%, rgba(0,126,161,0.30) 0%, transparent 60%);
  pointer-events: none;
}
.wym-wrap .hero-cross { position: absolute; right: 5%; bottom: 8%; opacity: 0.05; font-size: 280px; color: var(--c-white); line-height: 1; user-select: none; pointer-events: none; z-index: 1; }
.wym-wrap .hero-inner { position: relative; z-index: 2; width: 100%; max-width: var(--max-w); margin: 0 auto; padding: 120px var(--pad-h) 180px; max-width: 720px; margin-left: max(var(--pad-h), calc(50vw - 550px + var(--pad-h))); }
.wym-wrap .hero-badge {
  display: inline-flex; align-items: center; gap: var(--sp-sm);
  background: rgba(115,209,245,0.12); border: 1px solid rgba(115,209,245,0.26);
  color: var(--c-light); font-size: 11px; font-weight: 500; letter-spacing: 0.2em;
  text-transform: uppercase; padding: 8px 18px; border-radius: 100px; margin-bottom: var(--sp-lg);
}
.wym-wrap .hero-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--c-light); }
.wym-wrap .hero-title { font-family: 'Plus Jakarta Sans', 'Noto Sans KR', sans-serif; font-size: clamp(40px, 6vw, 74px); font-weight: 700; color: var(--c-white); line-height: 1.08; letter-spacing: -0.025em; margin-bottom: var(--sp-md); word-break: keep-all; }
.wym-wrap .hero-title em { font-style: italic; color: var(--c-light); display: block; }
.wym-wrap .hero-subtitle { font-size: clamp(14px, 1.6vw, 16px); color: rgba(255,255,255,0.80); font-weight: 400; line-height: 1.85; margin-bottom: var(--sp-xl); word-break: keep-all; max-width: 540px; }
.wym-wrap .hero-cta-group { display: flex; gap: var(--sp-sm); flex-wrap: wrap; }
.wym-wrap .btn-primary { display: inline-flex; align-items: center; gap: var(--sp-sm); background: var(--c-red); color: #fff; font-size: 14px; font-weight: 600; letter-spacing: 0.04em; padding: 15px 30px; border-radius: 4px; transition: background .25s, transform .2s; }
.wym-wrap .btn-primary:hover { background: var(--c-red-dk); transform: translateY(-2px); }
.wym-wrap .btn-secondary { display: inline-flex; align-items: center; gap: var(--sp-sm); background: transparent; color: #fff; font-size: 14px; font-weight: 500; letter-spacing: 0.04em; padding: 15px 30px; border-radius: 4px; border: 1.5px solid rgba(255,255,255,0.40); transition: border-color .25s, background .25s; }
.wym-wrap .btn-secondary:hover { border-color: var(--c-light); background: rgba(115,209,245,0.08); }

/* hero stats bar */
.wym-wrap .hero-stats { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,12,22,0.75); backdrop-filter: blur(12px); border-top: 1px solid rgba(115,209,245,0.12); z-index: 3; }
.wym-wrap .hero-stats-inner { max-width: var(--max-w); margin: 0 auto; padding: 0 var(--pad-h); display: flex; }
.wym-wrap .hero-stat { flex: 1; padding: var(--sp-md) 0; display: flex; flex-direction: column; gap: 4px; border-right: 1px solid rgba(115,209,245,0.10); }
.wym-wrap .hero-stat:first-child { padding-right: var(--sp-lg); }
.wym-wrap .hero-stat:not(:first-child) { padding-left: var(--sp-lg); }
.wym-wrap .hero-stat:last-child { border-right: none; }
.wym-wrap .hero-stat-num { font-family: var(--f-serif); font-size: 18px; font-weight: 700; color: var(--c-light); }
.wym-wrap .hero-stat-label { font-size: 12px; color: rgba(255,255,255,0.72); font-weight: 400; }

/* ── QUICK ── */
.wym-wrap .quick-section { padding: var(--sp-2xl) var(--pad-h); }
.wym-wrap .quick-section { margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; background: var(--c-off); border-bottom: 1px solid var(--c-border); }
.wym-wrap .quick-inner { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 0; }
.wym-wrap .quick-item { padding: var(--sp-lg) var(--sp-xl) var(--sp-lg) 0; border-right: 1px solid var(--c-border); padding-right: var(--sp-xl); display: flex; flex-direction: column; gap: 10px; cursor: pointer; transition: background .25s; position: relative; }
.wym-wrap .quick-item:last-child { border-right: none; padding-right: 0; padding-left: var(--sp-xl); }
.wym-wrap .quick-item:nth-child(2) { padding-left: var(--sp-xl); }
.wym-wrap .quick-big-num { font-family: var(--f-serif); font-size: 56px; font-weight: 700; line-height: 1; color: rgba(0,79,104,0.10); letter-spacing: -0.04em; position: absolute; top: var(--sp-lg); right: var(--sp-md); }
.wym-wrap .quick-item:last-child .quick-big-num { right: 0; }
.wym-wrap .quick-kicker { font-size: 10px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: var(--c-mid); }
.wym-wrap .quick-name { font-family: var(--f-serif); font-size: 24px; font-weight: 700; color: var(--c-deep); line-height: 1.2; letter-spacing: -0.015em; }
.wym-wrap .quick-desc { font-size: 14px; line-height: 1.85; color: var(--c-muted); word-break: keep-all; flex: 1; }
.wym-wrap .quick-arrow { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--c-mid); letter-spacing: 0.06em; transition: gap .2s, color .2s; }
.wym-wrap .quick-arrow::after { content: '→'; }
.wym-wrap .quick-item:hover .quick-arrow { gap: 10px; color: var(--c-deep); }

/* ── INTRO ── */
.wym-wrap .intro { position: relative; padding: var(--sp-3xl) var(--pad-h); overflow: hidden; }
.wym-wrap .intro { margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wym-wrap .intro::before { content: ''; position: absolute; top: 0; right: 0; width: 54%; height: 100%; background: var(--c-pale); clip-path: ellipse(100% 120% at 100% 50%); pointer-events: none; }
.wym-wrap .intro-grid { position: relative; z-index: 1; max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: calc(var(--sp-3xl) + 48px); align-items: center; }
.wym-wrap .intro-img-wrap { position: relative; }
.wym-wrap .intro-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 8px; display: block; position: relative; z-index: 1; }
.wym-wrap .intro-img-frame { position: absolute; top: -18px; right: -18px; bottom: 18px; left: 18px; border: 2px solid rgba(0,126,161,0.14); border-radius: 8px; pointer-events: none; }
.wym-wrap .intro-quote { position: absolute; bottom: -22px; right: -28px; background: var(--c-deep); color: var(--c-white); padding: var(--sp-md) var(--sp-lg); border-radius: 6px; max-width: 230px; z-index: 2; box-shadow: 0 16px 48px rgba(0,30,45,0.22); }
.wym-wrap .intro-quote-icon { font-family: var(--f-serif); font-size: 40px; line-height: 1; color: var(--c-light); opacity: 0.5; margin-bottom: 6px; }
.wym-wrap .intro-quote-text { font-size: 13px; font-style: italic; line-height: 1.65; color: rgba(255,255,255,0.82); }
.wym-wrap .intro-quote-source { font-size: 11px; color: var(--c-light); margin-top: var(--sp-sm); font-weight: 500; }

/* ── HIGHLIGHTS ── */
.wym-wrap .highlights { background: var(--c-deep); padding: var(--sp-3xl) var(--pad-h); position: relative; overflow: hidden; }
.wym-wrap .highlights { margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wym-wrap .highlights::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 100% at 90% 50%, rgba(0,126,161,0.32) 0%, transparent 60%); pointer-events: none; }
.wym-wrap .highlights-inner { position: relative; z-index: 1; max-width: var(--max-w); margin: 0 auto; }
.wym-wrap .highlights-top { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--sp-2xl); gap: var(--sp-md); }
.wym-wrap .highlights-title { font-family: var(--f-serif); font-size: clamp(28px, 3.5vw, 46px); color: var(--c-white); line-height: 1.16; font-weight: 700; letter-spacing: -0.02em; }
.wym-wrap .highlights-sub { font-size: 14px; color: rgba(255,255,255,0.70); line-height: 1.75; max-width: 260px; text-align: right; word-break: keep-all; }
.wym-wrap .highlights-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(115,209,245,0.10); border-radius: 8px; overflow: hidden; }
.wym-wrap .hi-card { background: rgba(0,10,20,0.35); padding: var(--sp-xl) var(--sp-lg); display: flex; flex-direction: column; gap: var(--sp-sm); transition: background .3s; }
.wym-wrap .hi-card:hover { background: rgba(0,126,161,0.22); }
.wym-wrap .hi-num { font-family: var(--f-serif); font-size: 28px; font-weight: 700; color: var(--c-light); line-height: 1; }
.wym-wrap .hi-label { font-size: 14px; font-weight: 500; color: var(--c-white); }
.wym-wrap .hi-desc { font-size: 13px; color: rgba(255,255,255,0.70); line-height: 1.7; font-weight: 400; word-break: keep-all; }

/* ── STORY ── */
.wym-wrap .story-section { padding: var(--sp-3xl) var(--pad-h); background: var(--c-white); }
.wym-wrap .story-section { margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wym-wrap .story-header { max-width: var(--max-w); margin: 0 auto var(--sp-2xl); }
.wym-wrap .story-row { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 0; align-items: stretch; border-radius: 12px; overflow: hidden; margin-bottom: 28px; border: 1px solid var(--c-border); }
.wym-wrap .story-row:last-child { margin-bottom: 0; }
.wym-wrap .story-row.flip { direction: rtl; }
.wym-wrap .story-row.flip > * { direction: ltr; }
.wym-wrap .story-img-wrap { position: relative; overflow: hidden; min-height: 360px; }
.wym-wrap .story-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s ease; }
.wym-wrap .story-row:hover .story-img { transform: scale(1.04); }
.wym-wrap .story-body { padding: var(--sp-xl) var(--sp-2xl); display: flex; flex-direction: column; justify-content: center; background: var(--c-white); }
.wym-wrap .story-row.flip .story-body { background: var(--c-off); }
.wym-wrap .story-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-mid); margin-bottom: var(--sp-md); }
.wym-wrap .story-pill::before { content: ''; width: 12px; height: 2px; background: var(--c-red); }
.wym-wrap .story-title { font-family: var(--f-serif); font-size: clamp(22px,2.4vw,30px); font-weight: 700; color: var(--c-deep); margin-bottom: var(--sp-md); line-height: 1.22; letter-spacing: -0.02em; }
.wym-wrap .story-desc { font-size: 14px; line-height: 1.85; color: var(--c-sub); word-break: keep-all; margin-bottom: var(--sp-md); }
.wym-wrap .story-list { display: flex; flex-direction: column; gap: 8px; }
.wym-wrap .story-list li { font-size: 13px; line-height: 1.7; color: var(--c-muted); padding-left: 14px; position: relative; }
.wym-wrap .story-list li::before { content: ''; position: absolute; left: 0; top: 9px; width: 5px; height: 5px; border-radius: 50%; background: var(--c-red); opacity: 0.7; }

/* ── FEATURES ── */
.wym-wrap .features { background: var(--c-pale); padding: var(--sp-3xl) var(--pad-h); }
.wym-wrap .features { margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wym-wrap .features-layout { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 320px 1fr; gap: var(--sp-3xl); align-items: start; }
.wym-wrap .features-sticky { position: sticky; top: 100px; }
.wym-wrap .timeline { display: flex; flex-direction: column; position: relative; }
.wym-wrap .timeline::before { content: ''; position: absolute; left: 27px; top: 0; bottom: 0; width: 2px; background: linear-gradient(180deg, var(--c-red) 0%, var(--c-mid) 50%, rgba(0,79,104,0.12) 100%); }
.wym-wrap .tl-item { display: grid; grid-template-columns: 56px 1fr; gap: var(--sp-md); padding-bottom: var(--sp-xl); position: relative; }
.wym-wrap .tl-item:last-child { padding-bottom: 0; }
.wym-wrap .tl-dot { width: 56px; height: 56px; border-radius: 50%; background: linear-gradient(135deg, var(--c-deep), #0a5b76); color: rgba(255,255,255,0.9); font-size: 13px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; z-index: 1; box-shadow: 0 4px 16px rgba(0,79,104,0.22); }
.wym-wrap .tl-body { background: var(--c-white); border-radius: 12px; padding: var(--sp-md) var(--sp-lg); border: 1px solid var(--c-border); transition: box-shadow .25s, border-color .25s; }
.wym-wrap .tl-item:hover .tl-body { box-shadow: 0 8px 28px rgba(0,79,104,0.10); border-color: rgba(0,79,104,0.20); }
.wym-wrap .tl-title { font-size: 17px; font-weight: 700; color: var(--c-deep); margin-bottom: 10px; line-height: 1.35; letter-spacing: -0.01em; }
.wym-wrap .tl-desc { font-size: 14px; color: var(--c-sub); line-height: 1.85; word-break: keep-all; }

/* ── CTA ── */
.wym-wrap .cta-section { background: var(--c-deep); padding: var(--sp-3xl) var(--pad-h) 0; position: relative; overflow: hidden; }
.wym-wrap .cta-section { margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wym-wrap .cta-section::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 100% at 10% 50%, rgba(0,126,161,0.28) 0%, transparent 60%); pointer-events: none; }
.wym-wrap .cta-inner { position: relative; z-index: 1; max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--sp-3xl); align-items: center; padding-bottom: var(--sp-3xl); }
.wym-wrap .cta-label { display: inline-flex; align-items: center; gap: var(--sp-sm); font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--c-light); margin-bottom: var(--sp-sm); }
.wym-wrap .cta-label::before { content: ''; width: 14px; height: 2px; background: var(--c-red); flex-shrink: 0; }
.wym-wrap .cta-title { font-family: var(--f-serif); font-size: clamp(28px, 3.5vw, 46px); font-weight: 700; color: var(--c-white); line-height: 1.18; margin-bottom: var(--sp-sm); letter-spacing: -0.02em; word-break: keep-all; }
.wym-wrap .cta-desc { font-size: 15px; line-height: 1.85; color: rgba(255,255,255,0.58); word-break: keep-all; }
.wym-wrap .cta-cards { display: flex; flex-direction: column; gap: var(--sp-sm); }
.wym-wrap .cta-card { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: var(--sp-md) var(--sp-lg); display: flex; align-items: center; gap: var(--sp-md); transition: background .25s, border-color .25s, transform .2s; cursor: pointer; }
.wym-wrap .cta-card:hover { background: rgba(255,255,255,0.12); border-color: rgba(115,209,245,0.28); transform: translateX(4px); }
.wym-wrap .cta-card-label { font-size: 14px; font-weight: 600; color: var(--c-white); margin-bottom: 3px; }
.wym-wrap .cta-card-sub { font-size: 12px; color: rgba(255,255,255,0.70); }
.wym-wrap .cta-card-arrow { margin-left: auto; color: rgba(255,255,255,0.32); font-size: 18px; transition: color .2s, transform .2s; }
.wym-wrap .cta-card:hover .cta-card-arrow { color: var(--c-light); transform: translateX(4px); }
.wym-wrap .contact-bar { background: rgba(0,10,20,0.55); padding: var(--sp-lg) var(--pad-h); border-top: 1px solid rgba(115,209,245,0.10); position: relative; z-index: 1; }
.wym-wrap .contact-bar-inner { max-width: var(--max-w); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-md); flex-wrap: wrap; }
.wym-wrap .contact-label { font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-light); margin-bottom: 6px; }
.wym-wrap .contact-info { font-size: 13px; color: rgba(255,255,255,0.75); font-weight: 400; }
.wym-wrap .contact-info strong { color: var(--c-white); font-weight: 500; }
.wym-wrap .contact-divider { width: 1px; height: 36px; background: rgba(115,209,245,0.12); }
.wym-wrap .btn-contact { display: inline-flex; align-items: center; gap: var(--sp-sm); background: var(--c-red); color: var(--c-white); font-size: 13px; font-weight: 600; letter-spacing: 0.05em; padding: 13px 26px; border-radius: 4px; white-space: nowrap; transition: background .25s, transform .2s; }
.wym-wrap .btn-contact:hover { background: var(--c-red-dk); transform: translateY(-2px); }

/* ══ RESPONSIVE ══ */
@media (max-width: 960px) {
  .wym-wrap { --sp-3xl: 96px; --sp-2xl: 72px; --pad-h: 28px; }
