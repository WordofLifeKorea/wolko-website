---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

// 교회와 협력하는 방법 — 교회가 월코에 요청할 수 있는 것 · 함께하는 순서 · 협력 교회 · 문의
// 내용은 사이트에 이미 있는 것만 옮겼다: 청소년 사역(/youth), 캠프(/camp), 사역 소개(/ministry), SYME(/jr-syme),
// 그리고 포탈 CRS 12단계(사역 소개 프레젠테이션 · 복음 대화 훈련 · 캠프·이벤트 참여 · Core Training · 월코 커리큘럼 · 선교사 설교).
// TODO 사무실 확인:
//  - 교회 요청을 받는 실제 창구(문의 페이지 하나로 충분한지, 담당자 · 연락처를 따로 둘지)
//  - 각 요청(전도 이벤트 · 리더 훈련 · 복음 대화 훈련 · 커리큘럼 · 선교사 방문)에 드는 비용 · 준비물 · 최소 인원 · 가능 지역
//  - 캠프 단체 참가 조건(인원 · 할인 · 인솔 교사 기준)과 신청 방법
//  - 월코 커리큘럼을 교회에 어떻게 제공하는지(교재 · 교육 · 언어)
//  - '함께하는 순서' 다섯 단계가 실제 진행과 맞는지, 요청부터 진행까지 보통 걸리는 기간
const offers = [
  {
    num: '01', ko: '전도 이벤트', en: 'Outreach Events',
    dKo: '복음을 들은 학생들이 친구를 초대하고, 이벤트 안에서 친구가 친구에게 복음을 전하는 자리를 교회와 함께 준비합니다.',
    dEn: 'We plan events with your church where students invite friends and the Gospel passes naturally from friend to friend.',
    href: '/youth#step-friend', linkKo: '청소년 사역에서 보기', linkEn: 'See in Youth Ministry',
  },
  {
    num: '02', ko: '선생님 · 리더 훈련', en: 'Teacher & Leader Training',
    dKo: '청소년부 선생님과 리더가 먼저 복음으로 세워지도록 돕고, 실제 사역에 필요한 훈련(Core Training)을 제공합니다.',
    dEn: 'We help youth teachers and leaders be established in the Gospel first, and equip them through practical training (Core Training).',
    href: '/youth#step-leader', linkKo: '리더 훈련 보기', linkEn: 'See Leader Training',
  },
  {
    num: '03', ko: '복음 대화 훈련', en: 'Gospel Conversation Training',
    dKo: '학생들이 친구에게 어떻게 복음을 나눌지 배우고, 실제로 복음을 나눠 보는 시간을 갖습니다.',
    dEn: 'Students learn how to share the Gospel with a friend, and practice real Gospel conversations.',
    href: '/youth#step-student', linkKo: '학생 사역 보기', linkEn: 'See Student Ministry',
  },
  {
    num: '04', ko: '캠프 단체 참가', en: 'Camps for Your Group',
    dKo: '교회 청소년부가 영어캠프 · 제주캠프 · 연합캠프에 함께 참가해, 말씀과 공동체 안에서 삶의 전환점을 경험하도록 돕습니다.',
    dEn: 'Your youth group can join our English, Jeju, and Unity Camps together and encounter life change in the Word and community.',
    href: '/camp#upcoming-camps', linkKo: '캠프 일정 보기', linkEn: 'See Camp Dates',
  },
  {
    num: '05', ko: '월코 커리큘럼', en: 'WOLKO Curriculum',
    dKo: 'Word of Life의 검증된 성경 커리큘럼을 교회 안에서 사용할 수 있도록 안내합니다.',
    dEn: "We help your church use Word of Life's proven Bible curriculum in its own ministry.",
    href: '/jr-syme', linkKo: 'SYME 제자훈련 보기', linkEn: 'See SYME Discipleship',
  },
  {
    num: '06', ko: '사역 소개 · 선교사 말씀', en: 'Ministry Presentation & Preaching',
    dKo: '월코 선교사가 교회를 찾아가 다음 세대 사역을 소개하고, 예배에서 말씀을 전합니다.',
    dEn: "A WOLKO missionary can visit your church to share about next-generation ministry and preach in your service.",
    href: '/ministry', linkKo: '월코 사역 전체 보기', linkEn: 'See All Ministries',
  },
];

const steps = [
  { ko: '문의', en: 'Reach Out', dKo: '교회의 상황과 바라는 사역을 문의 페이지로 알려 주세요.', dEn: "Tell us about your church and what you hope for through the contact page." },
  { ko: '만남', en: 'Meet', dKo: '월코 선교사가 목사님 · 담당 사역자와 만나 이야기를 나눕니다.', dEn: 'A WOLKO missionary meets with your pastor or ministry leader.' },
  { ko: '계획', en: 'Plan', dKo: '교회에 맞는 사역과 일정을 함께 정합니다.', dEn: 'Together we choose the right ministry and schedule for your church.' },
  { ko: '진행', en: 'Serve', dKo: '훈련 · 이벤트 · 캠프를 교회와 함께 진행합니다.', dEn: 'We carry out the training, event, or camp alongside your church.' },
  { ko: '이후 연결', en: 'Follow Through', dKo: '복음을 들은 학생들이 교회 공동체 안에서 계속 자라도록 함께 돕습니다.', dEn: 'We keep helping students who heard the Gospel grow within your church community.' },
];
---

<BaseLayout
  title="교회와 함께 — Word of Life Korea"
  description="전도 이벤트, 선생님·리더 훈련, 캠프 단체 참가, 월코 커리큘럼까지 — 교회가 월코와 함께 다음 세대를 섬기는 방법을 소개합니다."
  activeNav="ministry"
  noindex
>
  <link rel="stylesheet" href="/partner-churches.css?v=25">
  <div class="churches">
    <PageHero align="center" image="/images/heroes/cross.jpg" pos="50% 40%">
      <Fragment slot="eyebrow"><span class="wl-ko">교회와 함께</span><span class="wl-en">For Churches</span></Fragment>
      <Fragment slot="title">
        <span class="wl-ko">교회와 함께 <br class="ph-br"><em>다음 세대를 세웁니다</em></span>
        <span class="wl-en">Serving the Next Generation <br class="ph-br"><em>Together with Your Church</em></span>
      </Fragment>
      <Fragment slot="bar">
        <p class="ph-sub">
          <span class="wl-ko">월코는 지역 교회를 대신하지 않고, 교회 곁에서 함께 섬깁니다. 교회가 월코와 협력할 수 있는 방법을 소개합니다.</span>
          <span class="wl-en">WOLKO doesn't replace the local church — we serve alongside it. Here is how your church can partner with WOLKO.</span>
        </p>
        <div class="ph-actions">
          <a class="ph-cta" href="#ch-offers"><span class="wl-ko">협력 방법 보기</span><span class="wl-en">See How to Partner</span><svg aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M8 2v11M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/></svg></a>
          <a class="ph-cta ph-cta--ghost" href="/contact"><span class="wl-ko">협력 문의</span><span class="wl-en">Contact Us</span></a>
        </div>
      </Fragment>
    </PageHero>

    <!-- 교회가 월코에 요청할 수 있는 것 -->
    <section class="ch-offers" id="ch-offers">
      <div class="ch-shell">
        <div class="ch-head">
          <div>
            <p class="ch-eyebrow"><span class="wl-ko">요청할 수 있는 것</span><span class="wl-en">What We Offer</span></p>
            <h2 class="ch-title"><span class="wl-ko">교회가 월코에<br>요청할 수 있는 것</span><span class="wl-en">What Your Church<br>Can Ask Us For</span></h2>
          </div>
          <p class="ch-lead">
            <span class="wl-ko">교회의 청소년부와 다음 세대 사역에 필요한 것을 골라 문의해 주세요. 한 가지부터 시작해도 좋아요.</span>
            <span class="wl-en">Choose what your youth ministry needs and reach out. Starting with just one is perfectly fine.</span>
          </p>
        </div>
        <ol class="ch-grid">
          {offers.map((o) => (
            <li class="ch-card">
              <span class="ch-num">{o.num}</span>
              <h3><span class="wl-ko">{o.ko}</span><span class="wl-en">{o.en}</span></h3>
              <p><span class="wl-ko">{o.dKo}</span><span class="wl-en">{o.dEn}</span></p>
              <a class="ch-link" href={o.href}>
                <span><span class="wl-ko">{o.linkKo}</span><span class="wl-en">{o.linkEn}</span></span>
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 함께하는 순서 -->
    <section class="ch-steps">
      <div class="ch-shell">
        <div class="ch-head">
          <div>
            <p class="ch-eyebrow"><span class="wl-ko">함께하는 순서</span><span class="wl-en">How It Works</span></p>
            <h2 class="ch-title"><span class="wl-ko">문의부터 이후 연결까지</span><span class="wl-en">From First Contact<br>to Follow-Through</span></h2>
          </div>
        </div>
        <ol class="ch-flow">
          {steps.map((s, i) => (
            <li>
              <span class="ch-flow-num">{String(i + 1).padStart(2, '0')}</span>
              <strong><span class="wl-ko">{s.ko}</span><span class="wl-en">{s.en}</span></strong>
              <p><span class="wl-ko">{s.dKo}</span><span class="wl-en">{s.dEn}</span></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 협력 교회 — 홈과 같은 /partner-churches.js 가 이름을 채운다(목록이 없으면 이 구역은 숨은 채로 둔다) -->
    <section class="pc-band" id="partnerChurches" aria-labelledby="pcTitle" hidden>
      <div class="pc-inner">
        <div class="pc-head">
          <p class="ch-eyebrow"><span class="wl-ko">협력 교회</span><span class="wl-en">Partner Churches</span></p>
          <h2 class="ch-title ch-title--sm" id="pcTitle">
            <span class="wl-ko">월코와 함께<br>협력하는 교회</span>
            <span class="wl-en">Churches Partnering<br>with WOLKO</span>
          </h2>
          <p class="pc-sub">
            <span class="wl-ko"><b class="pc-count"></b>개의 교회가 한 마음으로 다음 세대를 함께 섬기고 있어요.</span>
            <span class="wl-en"><b class="pc-count"></b> churches serving the next generation together.</span>
          </p>
        </div>
        <ul class="pc-names" id="pcNames" aria-label="Partner churches"></ul>
      </div>
    </section>
    <script is:inline src="/partner-churches.js?v=18" defer></script>

    <!-- 문의 -->
    <section class="ch-closing">
      <div class="ch-shell ch-closing-inner">
        <div>
          <p class="ch-eyebrow ch-eyebrow--light"><span class="wl-ko">협력 문의</span><span class="wl-en">Partner With Us</span></p>
          <h2 class="ch-title ch-title--light"><span class="wl-ko">우리 교회에 맞는 협력을<br>함께 찾아보세요</span><span class="wl-en">Let's find the right partnership<br>for your church</span></h2>
        </div>
        <div class="ch-actions">
          <a class="ch-btn ch-btn--light" href="/contact?type=ministry#contact-form">
            <span><span class="wl-ko">문의하기</span><span class="wl-en">Contact Us</span></span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
          </a>
          <a class="ch-btn ch-btn--ghost" href="/ministry"><span class="wl-ko">월코 사역 보기</span><span class="wl-en">Our Ministries</span></a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline>
    // 교회와 함께 페이지 움직임: 스크롤하면 글과 칸이 아래에서 차례로 떠오른다.
    // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var items = [].slice.call(document.querySelectorAll('.ch-head > *, .ch-card, .ch-flow > li, .ch-closing-inner > *'));
      items.forEach(function (el) {
        var sib = el.parentNode.children, i = [].indexOf.call(sib, el);
        el.style.setProperty('--d', Math.min(i, 6) * 0.08 + 's');
        el.classList.add('ch-rv');
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      items.forEach(function (el) { io.observe(el); });
    })();
  </script>

  <style>
    .churches {
      --ch-deep: #004f68;
      --ch-navy: #0b2430;
      --ch-ink: #10252e;
      --ch-text: #4a5d66;
      --ch-label: #5a7380;
      --ch-line: #d6dee2;
      --ch-soft: #f6f9fb;
      color: var(--ch-ink);
      background: #fff;
      font-family: var(--ff-sans);
      word-break: keep-all;
      overflow: hidden;
    }
    .ch-shell { width: min(1200px, calc(100% - 48px)); margin-inline: auto; }
    .churches svg { width: 14px; height: 14px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: square; }

    /* 작은 표시 — 앞에 가는 선 */
    .ch-eyebrow { display: flex; align-items: center; gap: 12px; color: var(--ch-deep); font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .ch-eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; }
    .ch-eyebrow--light { color: #8fd0e4; }
    .ch-title { margin-top: 20px; font-family: var(--ff-serif); font-size: clamp(30px, 3.2vw, 44px); font-weight: 700; line-height: 1.24; letter-spacing: -.03em; color: var(--ch-navy); }
    .ch-title--sm { font-size: clamp(28px, 2.8vw, 38px); }
    .ch-title--light { color: #fff; }
    .ch-head { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 64px; align-items: end; }
    .ch-lead { color: #3e535d; font-size: 17px; line-height: 1.85; }

    /* 요청할 수 있는 것 — 여섯 칸 */
    .ch-offers { padding: 120px 0 104px; scroll-margin-top: 40px; }
    .ch-grid { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px 40px; }
    .ch-card { display: flex; flex-direction: column; padding-top: 22px; border-top: 2px solid var(--ch-navy); }
    .ch-num { font-family: var(--ff-serif); font-size: 14px; color: var(--ch-deep); }
    .ch-card h3 { margin-top: 12px; font-family: var(--ff-serif); font-size: 22px; font-weight: 700; line-height: 1.3; letter-spacing: -.02em; color: var(--ch-navy); }
    .ch-card p { margin-top: 12px; flex: 1; font-size: 15px; line-height: 1.8; color: var(--ch-text); }
    .ch-link { margin-top: 18px; display: inline-flex; align-items: center; gap: 8px; width: fit-content; color: var(--ch-deep); font-size: 14px; font-weight: 700; text-decoration: none; }
    .ch-link:hover span { text-decoration: underline; text-underline-offset: 4px; }
    /* 보이는 글줄은 그대로, 눌리는 자리만 위아래로 넓혀 높이 44px (위는 설명 글 여백 18px, 아래는 칸 사이 48px 안) */
    .ch-link { position: relative; }
    .ch-link::after { content: ''; position: absolute; left: 0; right: 0; top: min(0px, calc(50% - 22px)); bottom: min(0px, calc(50% - 22px)); }

    /* 함께하는 순서 — 다섯 걸음 가로 줄 */
    .ch-steps { padding: 104px 0; background: var(--ch-soft); }
    .ch-flow { list-style: none; margin: 56px 0 0; padding: 0; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 2px solid var(--ch-navy); }
    .ch-flow li { position: relative; padding: 24px 20px 4px 0; }
    .ch-flow li + li { padding-left: 20px; border-left: 1px solid var(--ch-line); }
    .ch-flow-num { font-family: var(--ff-serif); font-size: 14px; color: var(--ch-deep); }
    .ch-flow strong { display: block; margin-top: 10px; font-size: 19px; font-weight: 800; letter-spacing: -.02em; color: var(--ch-navy); }
    .ch-flow p { margin-top: 10px; font-size: 14.5px; line-height: 1.75; color: var(--ch-text); }

    /* 협력 교회 띠는 /partner-churches.css 를 그대로 쓰고, 이 페이지에서는 바탕만 흰색 */
    .churches .pc-band { background: #fff; }

    /* 문의 — 남색 띠. 단추 높이는 height 로 준다(공용 wolko-ui.css 의 min-height !important 가 min-height 52px 를 36px 로 덮어써서) */
    .ch-closing { padding: 104px 0; background: var(--ch-navy); color: #fff; }
    .ch-closing-inner { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }
    .ch-actions { display: flex; flex-wrap: wrap; gap: 12px; }
    .ch-btn { display: inline-flex; align-items: center; justify-content: center; gap: 10px; height: 52px; padding: 0 26px; border-radius: var(--ws-radius-sm, 8px); font-size: 15px; font-weight: 700; text-decoration: none; transition: background .2s, color .2s; }
    .ch-btn--light { background: #fff; color: var(--ch-navy); }
    .ch-btn--light:hover { background: #e7f3f7; }
    .ch-btn--ghost { border: 1px solid rgba(255,255,255,.45); color: #fff; }
    .ch-btn--ghost:hover { background: rgba(255,255,255,.08); }

    /* 스크롤하면 떠오르기 — 스크립트가 .ch-rv 를 붙일 때만 */
    .ch-rv { opacity: 0; transform: translateY(24px); transition: opacity 1s cubic-bezier(.2,.7,.2,1) var(--d, 0s), transform 1s cubic-bezier(.2,.7,.2,1) var(--d, 0s); }
    .ch-rv.is-in { opacity: 1; transform: none; }

    @media (max-width: 980px) {
      .ch-head { grid-template-columns: 1fr; gap: 20px; align-items: start; }
      .ch-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .ch-flow { grid-template-columns: 1fr; }
      .ch-flow li, .ch-flow li + li { display: grid; grid-template-columns: 44px minmax(0, 1fr); column-gap: 8px; padding: 18px 0; border-left: 0; border-bottom: 1px solid var(--ch-line); }
      .ch-flow-num { grid-row: span 2; padding-top: 4px; }
      .ch-flow strong { margin-top: 0; }
      .ch-flow p { margin-top: 6px; }
      .ch-closing-inner { flex-direction: column; align-items: flex-start; }
    }
    @media (max-width: 740px) {
      .ch-shell { width: calc(100% - 40px); }
      .ch-offers { padding: 72px 0 64px; }
      .ch-grid { grid-template-columns: 1fr; gap: 36px; margin-top: 40px; }
      .ch-card h3 { font-size: 20px; }
      .ch-lead { font-size: 15.5px; }
      .ch-steps, .ch-closing { padding: 72px 0; }
      .ch-flow { margin-top: 36px; }
      .ch-flow strong { font-size: 17px; }
      .ch-actions { width: 100%; }
      .ch-btn { flex: 1 1 100%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .ch-rv { opacity: 1; transform: none; transition: none; }
      .ch-btn { transition: none; }
    }
  </style>
</BaseLayout>
