const processors = [
  { name: 'Cloudflare, Inc.', jobKo: '홈페이지 운영, 신청 자료 저장', jobEn: 'Website hosting and storing submissions', where: '미국 등 / USA and others', itemsKo: '위 표의 신청 · 지원 · 문의 정보', itemsEn: 'Information in the table above' },
  { name: 'Google LLC', jobKo: '신청 자료 관리(구글 스프레드시트), 접수 알림 메일 수신(Gmail), 광고 효과 측정(구글 광고), 사진 · 영상 공유(유튜브)', jobEn: 'Managing submissions (Google Sheets), receiving submission notices (Gmail), measuring ad results (Google Ads), photo / video sharing (YouTube)', where: '미국 / USA', itemsKo: '신청 · 지원 · 문의 정보 / 쿠키 · 접속 기록 / 동의하신 캠프 영상', itemsEn: 'Registration, application and enquiry details / cookies and visit logs / camp videos you agreed to share' },
  { name: 'Resend, Inc.', jobKo: '접수 확인 · 안내 이메일, 협회 담당자용 접수 알림 이메일 발송', jobEn: 'Sending confirmation emails and submission-notice emails to WOLKO staff', where: '미국 / USA', itemsKo: '신청 · 지원 · 문의 · 참석 접수 때 적은 내용(접수 알림 메일에는 접수 내용이 담깁니다)', itemsEn: 'What you submit in registrations, applications, enquiries and RSVPs (notice emails contain the submission details)' },
  { name: '네이버 카페 · Naver Cafe', jobKo: '동의하신 캠프 사진 · 영상 게시', jobEn: 'Posting camp photos and videos you agreed to share', where: '대한민국 / Korea', itemsKo: '동의하신 캠프 사진 · 영상', itemsEn: 'Camp photos and videos you agreed to share' },
  { name: 'Anthropic PBC', jobKo: '신청서에 글로 쓴 답의 한 · 영 번역, 캠프 운영 업무 보조', jobEn: 'Korean–English translation of written answers, camp-team work assistance', where: '미국 / USA', itemsKo: '신청 · 지원서의 글로 쓴 답(메모 · 교회 · 학교 · 자기소개 등)', itemsEn: 'Written answers in forms (notes, church, school, self-introduction, etc.)' },
  { name: '(주)솔라피 SOLAPI', jobKo: '알림톡 · 문자 발송', jobEn: 'Sending KakaoTalk notices and text messages', where: '대한민국 / Korea', itemsKo: '이름, 연락처, 안내 내용', itemsEn: 'Name, phone, message content' },
