---
// WOLKO 허브 — 내부 도구 모음 런처. 이메일+비밀번호 승인 로그인.
// 관리자(wol.org 전용)/상담사, 첫 화면에서 트랙을 나눠 가입/로그인. 공유 비밀번호 로그인 없음.
// No BaseLayout; standalone page (wolkoadmin/car와 동일한 패턴)
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>WOLKO 허브</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/hub.css?v=8">
  <link rel="stylesheet" href="/wolko-auth.css?v=1">
  <link rel="manifest" href="/hub-manifest.json">
  <meta name="theme-color" content="#004f68">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="WOLKO">
  <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
</head>
<body>

  <!-- ── 로그인 방법 선택 (기본) ── -->
  <div class="login-screen" id="choiceScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-t="choiceTitle">허브 로그인</p>
      <p class="login-description" data-t="choiceDesc">로그인 방법을 선택하세요.</p>
      <button class="login-btn" onclick="openAuthScreen('admin', 'emailScreen')" data-t="adminChoiceBtn">관리자 로그인 · 가입 (wol.org)</button>
      <button class="login-signup" onclick="openAuthScreen('counselor', 'emailScreen')" data-t="counselorChoiceBtn">상담사 가입 · 로그인</button>
    </div>
  </div>

  <!-- ── 이메일+비밀번호 로그인 (관리자/상담사 공용, 문구만 다름) ── -->
  <div class="login-screen hidden" id="emailScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" id="emailScreenTitle">허브 로그인</p>
      <p class="login-description" id="emailScreenDesc">가입하신 이메일과 비밀번호로 로그인하세요.</p>
      <div class="login-input-wrap">
        <input class="login-input" type="email" id="emailInput" placeholder="you@example.com" autocomplete="email">
      </div>
      <div class="login-input-wrap">
        <input class="login-input" type="password" id="loginPwInput" placeholder="••••••••" autocomplete="current-password">
      </div>
      <p class="login-error" id="emailError"></p>
      <button class="login-btn" id="emailBtn" onclick="doAccountLogin()" data-t="loginBtn">로그인</button>
      <button class="login-link-btn" onclick="openAuthScreen(authMode, 'signupScreen')" data-t="goSignupBtn">계정이 없으신가요? 가입하기</button>
      <button class="login-link-btn login-link-btn-sub" onclick="showScreen('choiceScreen')" data-t="backToChoiceBtn">다른 방법으로</button>
    </div>
  </div>

  <!-- ── 이메일+비밀번호 가입 (관리자/상담사 공용, 문구만 다름) ── -->
  <div class="login-screen hidden" id="signupScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" id="signupScreenTitle">허브 가입</p>
      <p class="login-description" id="signupScreenDesc">이메일과 비밀번호를 등록하면 마스터 관리자 승인 후 로그인할 수 있습니다.</p>
      <div class="login-input-wrap">
        <input class="login-input" type="email" id="signupEmailInput" placeholder="you@example.com" autocomplete="email">
      </div>
      <div class="login-input-wrap">
        <input class="login-input" type="password" id="signupPwInput" placeholder="8자 이상" autocomplete="new-password">
      </div>
      <p class="login-error" id="signupError"></p>
      <button class="login-btn" id="signupBtn" onclick="doSignup()" data-t="signupBtn">가입 요청</button>
      <button class="login-link-btn" onclick="openAuthScreen(authMode, 'emailScreen')" data-t="backToLoginBtn">이미 계정이 있으신가요? 로그인</button>
      <button class="login-link-btn login-link-btn-sub" onclick="showScreen('choiceScreen')" data-t="backToChoiceBtn">다른 방법으로</button>
    </div>
  </div>

  <!-- ── 발송/대기 안내 ── -->
  <div class="login-screen hidden" id="statusScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" id="statusTitle"></p>
      <p class="login-description" id="statusDesc"></p>
      <button class="login-btn" onclick="showScreen('choiceScreen')" data-t="backBtn">뒤로</button>
    </div>
  </div>

  <div class="hub-shell" id="hubShell" hidden>
    <nav class="hub-sidebar">
      <a class="hub-sidebar-brand" href="/">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <span class="hub-sidebar-brand-text">
          <span class="hub-sidebar-brand-name" data-t="headerTitle">WOLKO 허브</span>
          <span class="hub-sidebar-brand-sub">Word of Life Korea</span>
        </span>
      </a>

      <p class="hub-nav-label" data-t="navLabel">도구</p>
      <div class="hub-nav" id="hubNav"></div>

      <div class="hub-sidebar-foot">
        <button class="hub-sidebar-lang" id="pendingBtn" onclick="openPendingPanel()" hidden>
          <span data-t="pendingLabel">승인 대기</span>
          <span class="hub-pending-badge" id="pendingCount"></span>
        </button>
        <div class="hub-lang-toggle" role="group" aria-label="Language">
          <button class="hub-lang-btn" id="langKoBtn" onclick="setHubLang('ko')" aria-label="한국어" title="한국어">
            <img src="https://flagcdn.com/w20/kr.png" alt="" width="16" height="12"> KO
          </button>
          <button class="hub-lang-btn" id="langEnBtn" onclick="setHubLang('en')" aria-label="English" title="English">
            <img src="https://flagcdn.com/w20/us.png" alt="" width="16" height="12"> EN
          </button>
        </div>
        <button class="hub-sidebar-lang" onclick="doLogout()" data-t="logout">로그아웃</button>
      </div>
    </nav>

    <main class="hub-main">
      <div class="hub-wrap">
        <p class="hub-kicker" data-t="kicker">WOLKO INTERNAL</p>
        <p class="hub-title" data-t="pageTitle">내부 도구</p>
        <p class="hub-subtitle" data-t="subtitle">사용할 도구를 선택하세요. 각 도구는 자체 로그인이 필요합니다.</p>

        <div class="hub-grid" id="hubGrid"></div>
      </div>
    </main>
  </div>

  <!-- ── 승인 대기 목록 (master 전용) ── -->
  <div class="hub-pending-overlay hidden" id="pendingModal">
    <div class="hub-pending-card">
      <div class="hub-pending-head">
        <p data-t="pendingListTitle">승인 대기 목록</p>
        <button class="hub-modal-close" onclick="closePendingPanel()" aria-label="close">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M1.5 1.5l12 12M13.5 1.5l-12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div id="pendingList"></div>
    </div>
  </div>

  <div class="hub-toast" id="hubToast"></div>

  <script is:inline>
    const ICONS = {
      clipboard: '<path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1z"/><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><path d="M9 12h6M9 16h6"/>',
      users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
      car: '<path d="M14 16H9m10 0h2v-3.15a1 1 0 0 0-.84-.99L18 11.5l-2.35-3.13a1 1 0 0 0-.8-.4H6.5a2 2 0 0 0-1.79 1.11L3.6 11.5A5 5 0 0 0 3 14v2h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/>',
      landmark: '<path d="M3 22h18M6 18V11M10 18V11M14 18V11M18 18V11M12 2 3 7h18z"/>',
      calendar: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
    };

    const TOOLS = [
      { href: '/wolkoadmin', color: '#004f68', icon: 'clipboard',
        title_ko: '월코캠프 관리', title_en: 'WOLKO Camp Admin',
        desc_ko: '캠프 신청 현황 · 확정 관리', desc_en: 'Camp registration & confirmation' },
      { href: '/campstaff', color: '#0077a3', icon: 'users',
        title_ko: '캠프 카운슬러', title_en: 'Camp Counselor',
        desc_ko: '카운슬러 상담기록 · 팀 현황', desc_en: 'Counselor records & team status' },
      { href: '/car', color: '#c17a1f', icon: 'car',
        title_ko: '차량 스케줄', title_en: 'Vehicle Schedule',
        desc_ko: '차량 예약 · 정비 관리', desc_en: 'Reservations & maintenance' },
      { href: '/schedule', color: '#1da462', icon: 'calendar',
        title_ko: '스태프 캘린더', title_en: 'Staff Calendar',
        desc_ko: '스태프 일정 공유 캘린더', desc_en: 'Shared staff schedule calendar' },
      { href: '/crs', color: '#7a5fc4', icon: 'landmark',
        title_ko: 'CRS', title_en: 'CRS',
        desc_ko: 'Church Relationship System', desc_en: 'Church Relationship System' },
    ];

    const HUB_T = {
      ko: {
        headerTitle: 'WOLKO 허브',
        navLabel: '도구',
        kicker: 'WOLKO 내부용',
        pageTitle: '내부 도구',
        subtitle: '사용할 도구를 선택하세요. 각 도구는 자체 로그인이 필요합니다.',
        recentBadge: '최근 사용',
        choiceTitle: '허브 로그인',
        choiceDesc: '로그인 방법을 선택하세요.',
        adminChoiceBtn: '관리자 로그인 · 가입 (wol.org)',
        counselorChoiceBtn: '상담사 가입 · 로그인',
        emailLoginTitle: '허브 로그인',
        adminLoginDesc: 'wol.org 이메일과 비밀번호로 로그인하세요.',
        counselorLoginDesc: '가입하신 이메일과 비밀번호로 로그인하세요.',
        goSignupBtn: '계정이 없으신가요? 가입하기',
        backToChoiceBtn: '다른 방법으로',
        adminSignupTitle: '관리자 가입',
        adminSignupDesc: 'wol.org 이메일과 비밀번호를 등록하면 마스터 관리자 승인 후 로그인할 수 있습니다.',
        counselorSignupTitle: '상담사 가입',
        counselorSignupDesc: '이메일과 비밀번호를 등록하면 마스터 관리자 승인 후 로그인할 수 있습니다.',
        signupBtn: '가입 요청',
        signupSending: '요청 중…',
        backToLoginBtn: '이미 계정이 있으신가요? 로그인',
        emailRequired: '이메일을 입력해 주세요.',
        emailInvalid: '올바른 이메일 주소를 입력해 주세요.',
        adminDomainRequired: '관리자 가입은 wol.org 이메일만 가능합니다.',
        passwordRequired: '비밀번호를 입력해 주세요.',
        passwordInvalid: '비밀번호는 8자 이상의 영문/숫자/특수문자로 입력해 주세요.',
        backBtn: '뒤로',
        signupApprovedTitle: '가입이 완료되었습니다',
        signupApprovedDesc: '이제 방금 등록한 이메일과 비밀번호로 로그인할 수 있습니다.',
        pendingStatusTitle: '승인 대기 중',
        pendingStatusDesc: '마스터 관리자 승인 후 로그인할 수 있습니다. 승인되면 이메일로 안내해 드립니다.',
        loginBtn: '로그인',
        loginVerifying: '확인 중…',
        loginWrong: '비밀번호가 올바르지 않습니다.',
        logout: '로그아웃',
        pendingLabel: '승인 대기',
        pendingListTitle: '승인 대기 목록',
        pendingEmpty: '대기 중인 요청이 없습니다.',
        approveBtn: '승인',
        rejectBtn: '거부',
        roleAdmin: '관리자',
        roleCounselor: '상담사',
        roleMaster: '마스터',
        rolePlaceholder: '역할 선택',
        requestedPrefix: '요청',
        approvedToast: '승인했습니다.',
        rejectedToast: '거부했습니다.',
        roleRequiredToast: '역할을 선택해 주세요.',
      },
      en: {
        headerTitle: 'WOLKO Hub',
        navLabel: 'Tools',
        kicker: 'WOLKO Internal',
        pageTitle: 'Internal Tools',
        subtitle: 'Pick a tool below. Each one has its own login.',
        recentBadge: 'Recent',
        choiceTitle: 'Hub Login',
        choiceDesc: 'Choose how you want to log in.',
        adminChoiceBtn: 'Admin Login · Sign Up (wol.org)',
        counselorChoiceBtn: 'Counselor Sign Up · Login',
        emailLoginTitle: 'Hub Login',
        adminLoginDesc: 'Log in with your wol.org email and password.',
        counselorLoginDesc: 'Log in with the email and password you signed up with.',
        goSignupBtn: "Don't have an account? Sign up",
        backToChoiceBtn: 'Choose a different way',
        adminSignupTitle: 'Admin Sign Up',
        adminSignupDesc: 'Register your wol.org email and a password. A master admin must approve access before you can log in.',
        counselorSignupTitle: 'Counselor Sign Up',
        counselorSignupDesc: 'Register an email and password. A master admin must approve access before you can log in.',
        signupBtn: 'Request access',
        signupSending: 'Requesting…',
        backToLoginBtn: 'Already have an account? Log in',
        emailRequired: 'Please enter your email.',
        emailInvalid: 'Please enter a valid email address.',
        adminDomainRequired: 'Admin sign-up requires a wol.org email.',
        passwordRequired: 'Please enter a password.',
        passwordInvalid: 'Password must be at least 8 characters (letters/numbers/symbols).',
        backBtn: 'Back',
        signupApprovedTitle: 'Sign-up complete',
        signupApprovedDesc: 'You can now log in with the email and password you just registered.',
        pendingStatusTitle: 'Awaiting approval',
        pendingStatusDesc: "You'll be able to log in once a master admin approves your access. We'll email you when that happens.",
        loginBtn: 'Login',
        loginVerifying: 'Verifying…',
        loginWrong: 'Incorrect password.',
        logout: 'Log out',
        pendingLabel: 'Pending',
        pendingListTitle: 'Pending Requests',
        pendingEmpty: 'No pending requests.',
        approveBtn: 'Approve',
        rejectBtn: 'Reject',
        roleAdmin: 'Admin',
        roleCounselor: 'Counselor',
        roleMaster: 'Master',
        rolePlaceholder: 'Select role',
        requestedPrefix: 'Requested',
        approvedToast: 'Approved.',
        rejectedToast: 'Rejected.',
        roleRequiredToast: 'Please select a role.',
      },
    };

    // wolko.org 본사이트와 언어 설정을 공유(wolko-lang). 허브 자체 기본값은 영어.
    let hubLang = localStorage.getItem('wolko-lang') || localStorage.getItem('wolkoHubLang') || 'en';
    let currentSession = null; // { email, role }
    const $ = id => document.getElementById(id);
    function t(key) { return HUB_T[hubLang]?.[key] ?? HUB_T.ko[key] ?? key; }

    function showToast(msg, isError) {
      const el = $('hubToast');
      el.textContent = msg;
      el.classList.toggle('is-error', !!isError);
      el.classList.add('is-visible');
      clearTimeout(showToast._t);
      showToast._t = setTimeout(() => el.classList.remove('is-visible'), 3000);
    }

    function markVisited(href) {
      try { localStorage.setItem('wolko-hub-last', href); } catch (e) {}
    }

    function renderGrid() {
      let lastHref = '';
      try { lastHref = localStorage.getItem('wolko-hub-last') || ''; } catch (e) {}
      $('hubGrid').innerHTML = TOOLS.map(tool => `
        <a class="hub-card" href="${tool.href}" style="--tool-color:${tool.color}" onclick="markVisited('${tool.href}')">
          <span class="hub-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${ICONS[tool.icon] || ''}</svg>
          </span>
          <span class="hub-card-body">
            <span class="hub-card-title-row">
              <p class="hub-card-title">${hubLang === 'en' ? tool.title_en : tool.title_ko}</p>
              ${tool.href === lastHref ? `<span class="hub-card-badge">${t('recentBadge')}</span>` : ''}
            </span>
            <p class="hub-card-desc">${hubLang === 'en' ? tool.desc_en : tool.desc_ko}</p>
          </span>
          <span class="hub-card-arrow">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      `).join('');
    }

    function renderNav() {
      $('hubNav').innerHTML = TOOLS.map(tool => `
        <a class="hub-nav-item" href="${tool.href}" style="--item-color:${tool.color}" onclick="markVisited('${tool.href}')">
          <span class="hub-nav-item-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${ICONS[tool.icon] || ''}</svg>
          </span>
          <span class="hub-nav-item-label">${hubLang === 'en' ? tool.title_en : tool.title_ko}</span>
        </a>
      `).join('');
    }

    function applyLangToDOM() {
      document.documentElement.lang = hubLang === 'en' ? 'en' : 'ko';
      document.title = hubLang === 'en' ? 'WOLKO Hub' : 'WOLKO 허브';
      document.querySelectorAll('[data-t]').forEach(el => {
        el.textContent = t(el.getAttribute('data-t'));
      });
      $('langKoBtn').classList.toggle('is-active', hubLang === 'ko');
      $('langEnBtn').classList.toggle('is-active', hubLang === 'en');
      renderNav();
      renderGrid();
      updateAuthScreenText();
    }
    function setHubLang(lang) {
      hubLang = lang;
      localStorage.setItem('wolko-lang', hubLang);
      localStorage.removeItem('wolkoHubLang');
      applyLangToDOM();
    }

    /* ── 화면 전환 ── */
    const SCREENS = ['choiceScreen', 'emailScreen', 'signupScreen', 'statusScreen'];
    function showScreen(id) {
      SCREENS.forEach(s => {
        $(s).style.display = s === id ? 'flex' : 'none';
        $(s).classList.toggle('hidden', s !== id);
      });
    }

    /* ── 관리자/상담사 트랙 선택 — 로그인은 실질적으로 역할 무관하지만
       화면 문구(설명/placeholder)와 가입 시 요청 역할을 이 값으로 결정 ── */
    let authMode = 'admin'; // 'admin' | 'counselor'
    function openAuthScreen(mode, screenId) {
      authMode = mode;
      $('emailError').textContent = '';
      $('signupError').textContent = '';
      updateAuthScreenText();
      showScreen(screenId);
    }
    function updateAuthScreenText() {
      const isAdmin = authMode === 'admin';
      $('emailScreenTitle').textContent = t('emailLoginTitle');
      $('emailScreenDesc').textContent = isAdmin ? t('adminLoginDesc') : t('counselorLoginDesc');
      $('emailInput').placeholder = isAdmin ? 'you@wol.org' : 'you@example.com';
      $('signupScreenTitle').textContent = isAdmin ? t('adminSignupTitle') : t('counselorSignupTitle');
      $('signupScreenDesc').textContent = isAdmin ? t('adminSignupDesc') : t('counselorSignupDesc');
      $('signupEmailInput').placeholder = isAdmin ? 'you@wol.org' : 'you@example.com';
    }

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    /* ── 이메일+비밀번호 로그인 ── */
    async function doAccountLogin() {
      const email = $('emailInput').value.trim().toLowerCase();
      const password = $('loginPwInput').value;
      const errEl = $('emailError');
      errEl.textContent = '';
      if (!email) { errEl.textContent = t('emailRequired'); return; }
      if (!EMAIL_RE.test(email)) { errEl.textContent = t('emailInvalid'); return; }
      if (!password) { errEl.textContent = t('passwordRequired'); return; }

      const btn = $('emailBtn');
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = t('loginVerifying');

      try {
        const res = await fetch('/api/hub/account-login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('loginWrong'));
        applySession(data);
        showHub();
      } catch (e) {
        errEl.textContent = e.message;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    }
    $('emailInput').addEventListener('keydown', e => { if (e.key === 'Enter') doAccountLogin(); });
    $('loginPwInput').addEventListener('keydown', e => { if (e.key === 'Enter') doAccountLogin(); });

    /* ── 이메일+비밀번호 가입 ── */
    async function doSignup() {
      const email = $('signupEmailInput').value.trim().toLowerCase();
      const password = $('signupPwInput').value;
      const errEl = $('signupError');
      errEl.textContent = '';
      if (!email) { errEl.textContent = t('emailRequired'); return; }
      if (!EMAIL_RE.test(email)) { errEl.textContent = t('emailInvalid'); return; }
      if (authMode === 'admin' && !email.endsWith('@wol.org')) { errEl.textContent = t('adminDomainRequired'); return; }
      if (!password) { errEl.textContent = t('passwordRequired'); return; }

      const btn = $('signupBtn');
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = t('signupSending');

      try {
        const res = await fetch('/api/hub/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password, requestedRole: authMode }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('passwordInvalid'));

        if (data.status === 'pending') {
          $('statusTitle').textContent = t('pendingStatusTitle');
          $('statusDesc').textContent = t('pendingStatusDesc');
        } else {
          $('statusTitle').textContent = t('signupApprovedTitle');
          $('statusDesc').textContent = t('signupApprovedDesc');
        }
        $('signupEmailInput').value = '';
        $('signupPwInput').value = '';
        showScreen('statusScreen');
      } catch (e) {
        errEl.textContent = e.message;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    }
    $('signupPwInput').addEventListener('keydown', e => { if (e.key === 'Enter') doSignup(); });

    function applySession(data) {
      currentSession = { email: data.email, role: data.role };
      sessionStorage.setItem('wolko-hub-token', data.hubToken);
      sessionStorage.setItem('wolko-hub-email', data.email || '');
      sessionStorage.setItem('wolko-hub-role', data.role || '');
      if (data.adminToken) sessionStorage.setItem('wolko-admin-token', data.adminToken);
      if (data.carToken) sessionStorage.setItem('wolko-car-token', data.carToken);
    }

    function doLogout() {
      sessionStorage.removeItem('wolko-hub-token');
      sessionStorage.removeItem('wolko-hub-email');
      sessionStorage.removeItem('wolko-hub-role');
      sessionStorage.removeItem('wolko-admin-token');
      sessionStorage.removeItem('wolko-car-token');
      location.reload();
    }

    function showHub() {
      SCREENS.forEach(s => { $(s).style.display = 'none'; });
      $('hubShell').hidden = false;
      $('pendingBtn').hidden = currentSession?.role !== 'master';
      if (currentSession?.role === 'master') refreshPendingCount();
    }

    function isHubTokenValid(token) {
      try {
        const decoded = atob(token);
        const lastColon = decoded.lastIndexOf(':');
        const data = decoded.slice(0, lastColon);
        const parts = data.split(':');
        if (parts[0] !== 'wolko-hub' || parts.length !== 4) return false;
        const expires = parseInt(parts[3], 10);
        return !!expires && Date.now() < expires;
      } catch (e) {
        return false;
      }
    }

    /* ── 승인 대기 패널 (master 전용) ── */
    function authHeaders() {
      return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + sessionStorage.getItem('wolko-hub-token') };
    }
    function formatRequestedAt(iso) {
      if (!iso) return '';
      try { return new Date(iso).toLocaleString(hubLang === 'en' ? 'en-US' : 'ko-KR'); } catch (e) { return ''; }
    }
    async function refreshPendingCount() {
      try {
        const res = await fetch('/api/hub/pending', { headers: authHeaders() });
        if (!res.ok) return;
        const data = await res.json();
        const pendingCount = (data.accounts || []).filter(a => a.status === 'pending').length;
        const badge = $('pendingCount');
        badge.textContent = pendingCount || '';
        badge.classList.toggle('hidden', !pendingCount);
      } catch (e) {}
    }
    function renderPendingItem(a) {
      const isWol = /@wol\.org$/i.test(a.email);
      const requested = a.requestedRole === 'admin' && isWol ? 'admin' : (a.requestedRole === 'counselor' ? 'counselor' : '');
      const adminOption = isWol ? `<option value="admin"${requested === 'admin' ? ' selected' : ''}>${t('roleAdmin')}</option>` : '';
      const counselorOption = `<option value="counselor"${requested === 'counselor' ? ' selected' : ''}>${t('roleCounselor')}</option>`;
      const placeholderOption = `<option value="" disabled${requested ? '' : ' selected'}>${t('rolePlaceholder')}</option>`;
      const requestedLabel = a.requestedRole === 'admin' ? t('roleAdmin') : a.requestedRole === 'counselor' ? t('roleCounselor') : '';
      const meta = [formatRequestedAt(a.requestedAt), requestedLabel ? `${t('requestedPrefix')}: ${requestedLabel}` : ''].filter(Boolean).join(' · ');
      return `
          <div class="hub-pending-item">
            <div>
              <p class="hub-pending-email">${esc(a.email)}</p>
              <p class="hub-pending-role">${esc(meta)}</p>
            </div>
            <div class="hub-pending-actions">
              <select class="hub-pending-role-select">
                ${placeholderOption}${adminOption}${counselorOption}
              </select>
              <button class="hub-pending-approve" onclick="respondToRequest('${esc(a.email)}','approve',this)">${t('approveBtn')}</button>
              <button class="hub-pending-reject" onclick="respondToRequest('${esc(a.email)}','reject',this)">${t('rejectBtn')}</button>
            </div>
          </div>`;
    }
    async function openPendingPanel() {
      $('pendingModal').classList.remove('hidden');
      $('pendingList').innerHTML = '';
      try {
        const res = await fetch('/api/hub/pending', { headers: authHeaders() });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        const pending = (data.accounts || []).filter(a => a.status === 'pending');
        if (!pending.length) {
          $('pendingList').innerHTML = `<p class="hub-pending-empty">${t('pendingEmpty')}</p>`;
          return;
        }
        $('pendingList').innerHTML = pending.map(renderPendingItem).join('');
      } catch (e) {
        $('pendingList').innerHTML = `<p class="hub-pending-empty">${esc(e.message || '')}</p>`;
      }
    }
    function closePendingPanel() {
      $('pendingModal').classList.add('hidden');
    }
    async function respondToRequest(email, action, btnEl) {
      let role;
      if (action === 'approve') {
        const select = btnEl.closest('.hub-pending-actions').querySelector('.hub-pending-role-select');
        role = select.value;
        if (!role) { showToast(t('roleRequiredToast'), true); return; }
      }
      try {
        const res = await fetch('/api/hub/approve', {
          method: 'POST',
          headers: authHeaders(),
          body: JSON.stringify({ email, action, role }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        showToast(action === 'approve' ? t('approvedToast') : t('rejectedToast'));
        openPendingPanel();
        refreshPendingCount();
      } catch (e) {
        showToast(e.message || '', true);
      }
    }
    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    }

    /* ── 초기화 ── */
    async function initAuthFlow() {
      const hubToken = sessionStorage.getItem('wolko-hub-token') || '';
      if (hubToken && isHubTokenValid(hubToken)) {
        currentSession = {
          email: sessionStorage.getItem('wolko-hub-email') || '',
          role: sessionStorage.getItem('wolko-hub-role') || '',
        };
        showHub();
        return;
      }
      showScreen('choiceScreen');
    }

    applyLangToDOM();
    initAuthFlow();
  </script>
</body>
</html>
