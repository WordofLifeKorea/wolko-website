---
// WOLKO 허브 — 내부 도구 모음 런처. 비공개 주소, 각 도구는 자체 로그인을 그대로 사용.
// No BaseLayout; standalone page (wolkoadmin/car와 동일한 패턴)
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>WOLKO 허브</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/hub.css?v=5">
  <link rel="stylesheet" href="/wolko-auth.css?v=1">
  <link rel="manifest" href="/hub-manifest.json">
  <meta name="theme-color" content="#004f68">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="WOLKO">
  <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
</head>
<body>

  <!-- ── 보안 질문 (기기당 최초 1회) ── -->
  <div class="login-screen" id="securityScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-t="securityTitle">보안 질문</p>
      <p class="login-description" data-t="securityQuestion">월코센터 wifi 이름은 무엇인가요?</p>
      <div class="login-input-wrap">
        <input class="login-input" type="text" id="securityInput" autocomplete="off">
      </div>
      <p class="login-error" id="securityError"></p>
      <button class="login-btn" id="securityBtn" onclick="checkSecurityAnswer()" data-t="continueBtn">계속</button>
    </div>
  </div>

  <!-- ── 비밀번호 로그인 ── -->
  <div class="login-screen hidden" id="loginScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-t="loginTitle">허브 로그인</p>
      <div class="login-input-wrap">
        <input class="login-input" type="password" id="pwInput" autocomplete="current-password">
      </div>
      <p class="login-error" id="loginError"></p>
      <button class="login-btn" id="loginBtn" onclick="doLogin()" data-t="loginBtn">로그인</button>
    </div>
  </div>

  <div class="hub-shell" id="hubShell" hidden>
    <nav class="hub-sidebar">
      <a class="hub-sidebar-brand" href="/">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <span class="hub-sidebar-brand-text">
          <span class="hub-sidebar-brand-name" data-t="headerTitle">WOLKO 허브</span>
          <span class="hub-sidebar-brand-sub">Word of Life Korea</span>
        </span>
      </a>

      <p class="hub-nav-label" data-t="navLabel">도구</p>
      <div class="hub-nav" id="hubNav"></div>

      <div class="hub-sidebar-foot">
        <button class="hub-sidebar-lang" onclick="toggleHubLang()" title="Language">
          <span id="langToggleLabel">EN</span>
        </button>
        <button class="hub-sidebar-lang" onclick="doLogout()" data-t="logout">로그아웃</button>
      </div>
    </nav>

    <main class="hub-main">
      <div class="hub-wrap">
        <p class="hub-kicker" data-t="kicker">WOLKO INTERNAL</p>
        <p class="hub-title" data-t="pageTitle">내부 도구</p>
        <p class="hub-subtitle" data-t="subtitle">사용할 도구를 선택하세요. 각 도구는 자체 로그인이 필요합니다.</p>

        <div class="hub-grid" id="hubGrid"></div>

        <p class="hub-note">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          <span data-t="note">이 페이지를 홈 화면에 추가하면 앱처럼 아이콘 하나로 모든 도구에 바로 접근할 수 있습니다.</span>
        </p>
      </div>
    </main>
  </div>

  <script is:inline>
    const ICONS = {
      clipboard: '<path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1z"/><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><path d="M9 12h6M9 16h6"/>',
      users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
      car: '<path d="M14 16H9m10 0h2v-3.15a1 1 0 0 0-.84-.99L18 11.5l-2.35-3.13a1 1 0 0 0-.8-.4H6.5a2 2 0 0 0-1.79 1.11L3.6 11.5A5 5 0 0 0 3 14v2h2"/><circle cx="6.5" cy="16.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/>',
      calendar: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path d="M16 2v4M8 2v4M3 10h18"/>',
      landmark: '<path d="M3 22h18M6 18V11M10 18V11M14 18V11M18 18V11M12 2 3 7h18z"/>',
    };

    const TOOLS = [
      { href: '/wolkoadmin', color: '#004f68', icon: 'clipboard',
        title_ko: '관리자', title_en: 'Admin',
        desc_ko: '캠프 신청 현황 · 확정 관리', desc_en: 'Camp registration & confirmation' },
      { href: '/campstaff', color: '#0077a3', icon: 'users',
        title_ko: '캠프 진행', title_en: 'Camp Progress',
        desc_ko: '카운슬러 상담기록 · 팀 현황', desc_en: 'Counselor records & team status' },
      { href: '/car', color: '#c17a1f', icon: 'car',
        title_ko: '차량 스케줄', title_en: 'Vehicle Schedule',
        desc_ko: '차량 예약 · 정비 관리', desc_en: 'Reservations & maintenance' },
      { href: '/schedule-planner', color: '#1da462', icon: 'calendar',
        title_ko: '스케줄 플래너', title_en: 'Schedule Planner',
        desc_ko: '스태프 일정 · 차량 운행 계획', desc_en: 'Staff & van schedules' },
      { href: '/crs', color: '#7a5fc4', icon: 'landmark',
        title_ko: 'CRS', title_en: 'CRS',
        desc_ko: 'Church Relationship System', desc_en: 'Church Relationship System' },
    ];

    const HUB_T = {
      ko: {
        headerTitle: 'WOLKO 허브',
        navLabel: '도구',
        kicker: 'WOLKO 내부용',
        pageTitle: '내부 도구',
        subtitle: '사용할 도구를 선택하세요. 각 도구는 자체 로그인이 필요합니다.',
        note: '이 페이지를 홈 화면에 추가하면 앱처럼 아이콘 하나로 모든 도구에 바로 접근할 수 있습니다.',
        recentBadge: '최근 사용',
        securityTitle: '보안 질문',
        securityQuestion: '월코센터 wifi 이름은 무엇인가요?',
        securityWrong: '답이 올바르지 않습니다.',
        continueBtn: '계속',
        loginTitle: '허브 로그인',
        loginBtn: '로그인',
        loginVerifying: '확인 중…',
        loginRequired: '비밀번호를 입력해 주세요.',
        loginWrong: '비밀번호가 올바르지 않습니다.',
        logout: '로그아웃',
      },
      en: {
        headerTitle: 'WOLKO Hub',
        navLabel: 'Tools',
        kicker: 'WOLKO Internal',
        pageTitle: 'Internal Tools',
        subtitle: 'Pick a tool below. Each one has its own login.',
        note: 'Add this page to your home screen to access every tool from a single app icon.',
        recentBadge: 'Recent',
        securityTitle: 'Security Question',
        securityQuestion: 'What is the WOLKO center wifi name?',
        securityWrong: 'That answer is not correct.',
        continueBtn: 'Continue',
        loginTitle: 'Hub Login',
        loginBtn: 'Login',
        loginVerifying: 'Verifying…',
        loginRequired: 'Please enter a password.',
        loginWrong: 'Incorrect password.',
        logout: 'Log out',
      },
    };

    // wolko.org 본사이트와 언어 설정을 공유(wolko-lang) — 어느 쪽에서 바꾸든 서로 이어짐
    let hubLang = localStorage.getItem('wolko-lang') || localStorage.getItem('wolkoHubLang') || 'ko';
    const $ = id => document.getElementById(id);
    function t(key) { return HUB_T[hubLang]?.[key] ?? HUB_T.ko[key] ?? key; }

    function markVisited(href) {
      try { localStorage.setItem('wolko-hub-last', href); } catch (e) {}
    }

    function renderGrid() {
      let lastHref = '';
      try { lastHref = localStorage.getItem('wolko-hub-last') || ''; } catch (e) {}
      $('hubGrid').innerHTML = TOOLS.map(tool => `
        <a class="hub-card" href="${tool.href}" style="--tool-color:${tool.color}" onclick="markVisited('${tool.href}')">
          <span class="hub-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${ICONS[tool.icon] || ''}</svg>
          </span>
          <span class="hub-card-body">
            <span class="hub-card-title-row">
              <p class="hub-card-title">${hubLang === 'en' ? tool.title_en : tool.title_ko}</p>
              ${tool.href === lastHref ? `<span class="hub-card-badge">${t('recentBadge')}</span>` : ''}
            </span>
            <p class="hub-card-desc">${hubLang === 'en' ? tool.desc_en : tool.desc_ko}</p>
          </span>
          <span class="hub-card-arrow">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>
      `).join('');
    }

    function renderNav() {
      $('hubNav').innerHTML = TOOLS.map(tool => `
        <a class="hub-nav-item" href="${tool.href}" style="--item-color:${tool.color}" onclick="markVisited('${tool.href}')">
          <span class="hub-nav-item-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${ICONS[tool.icon] || ''}</svg>
          </span>
          <span class="hub-nav-item-label">${hubLang === 'en' ? tool.title_en : tool.title_ko}</span>
        </a>
      `).join('');
    }

    function applyLangToDOM() {
      document.documentElement.lang = hubLang === 'en' ? 'en' : 'ko';
      document.title = hubLang === 'en' ? 'WOLKO Hub' : 'WOLKO 허브';
      document.querySelectorAll('[data-t]').forEach(el => {
        el.textContent = t(el.getAttribute('data-t'));
      });
      $('langToggleLabel').textContent = hubLang === 'ko' ? 'EN' : '한';
      renderNav();
      renderGrid();
    }
    function toggleHubLang() {
      hubLang = hubLang === 'ko' ? 'en' : 'ko';
      localStorage.setItem('wolko-lang', hubLang);
      localStorage.removeItem('wolkoHubLang');
      applyLangToDOM();
    }

    /* ── 보안 질문 (기기당 최초 1회) ── */
    const WIFI_ANSWER = 'wolkomesh';
    function checkSecurityAnswer() {
      const val = $('securityInput').value.trim().toLowerCase();
      if (val === WIFI_ANSWER) {
        try { localStorage.setItem('wolko-hub-device-verified', 'true'); } catch (e) {}
        $('securityScreen').classList.add('hidden');
        setTimeout(() => $('securityScreen').style.display = 'none', 400);
        $('loginScreen').classList.remove('hidden');
      } else {
        $('securityError').textContent = t('securityWrong');
      }
    }
    $('securityInput').addEventListener('keydown', e => { if (e.key === 'Enter') checkSecurityAnswer(); });

    /* ── 비밀번호 로그인 (세션마다) ── */
    function isHubTokenValid(token) {
      try {
        const decoded = atob(token);
        const lastColon = decoded.lastIndexOf(':');
        const data = decoded.slice(0, lastColon);
        const parts = data.split(':');
        if (parts[0] !== 'wolko-hub') return false;
        const expires = parseInt(parts[1], 10);
        return !!expires && Date.now() < expires;
      } catch (e) {
        return false;
      }
    }

    function showHub() {
      $('securityScreen').style.display = 'none';
      $('loginScreen').style.display = 'none';
      $('hubShell').hidden = false;
    }

    async function doLogin() {
      const pw = $('pwInput').value;
      const btn = $('loginBtn');
      const errEl = $('loginError');
      if (!pw) { errEl.textContent = t('loginRequired'); return; }

      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = t('loginVerifying');
      errEl.textContent = '';

      try {
        const res = await fetch('/api/hub/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pw }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('loginWrong'));

        // 허브 로그인 한 번으로 관리자/차량/스케줄 플래너까지 자동 로그인되도록
        // 각 도구가 실제로 확인하는 storage 키에 그대로 심어둔다.
        sessionStorage.setItem('wolko-hub-token', data.hubToken);
        sessionStorage.setItem('wolko-admin-token', data.adminToken);
        sessionStorage.setItem('wolko-car-token', data.carToken);
        try { localStorage.setItem('wolko_schedule_planner_token', data.schedulePlannerToken); } catch (e) {}

        showHub();
      } catch (e) {
        errEl.textContent = e.message;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    }
    $('pwInput').addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });

    function doLogout() {
      sessionStorage.removeItem('wolko-hub-token');
      sessionStorage.removeItem('wolko-admin-token');
      sessionStorage.removeItem('wolko-car-token');
      try { localStorage.removeItem('wolko_schedule_planner_token'); } catch (e) {}
      location.reload();
    }

    function initAuthFlow() {
      const hubToken = sessionStorage.getItem('wolko-hub-token') || '';
      if (hubToken && isHubTokenValid(hubToken)) {
        showHub();
        return;
      }
      let deviceVerified = false;
      try { deviceVerified = localStorage.getItem('wolko-hub-device-verified') === 'true'; } catch (e) {}
      if (deviceVerified) {
        $('securityScreen').style.display = 'none';
        $('loginScreen').classList.remove('hidden');
      }
      // deviceVerified가 아니면 기본 상태(보안 질문 화면)를 그대로 둠
    }

    applyLangToDOM();
    initAuthFlow();
  </script>
</body>
</html>
