---
// 캠프 스태프 · 크루 서약서 — 신청할 때 읽고, 동의하고, 손가락(폰)이나 마우스(컴퓨터)로 서명한다.
// 문서 내용: functions/lib/staffAgreements.js (공개 페이지와 서버가 같은 글을 쓴다) · 저장: functions/api/agreements/sign.js
// 관리자 보기: 포탈 /portal/agreements/. 검색에는 나오지 않게 해 두었고(noindex), 스태프 · 크루에게만 링크로 보낸다.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { docList, docSections, ROLE_LABEL } from '../../../functions/lib/staffAgreements.js';
import { campEndDate } from '../../../functions/lib/campDates.js';

// 문장이 끝나는 '.' · '!' · '?' 뒤의 공백은 줄바꿈으로 바꿔 한 문장씩 한 줄에 보이게 한다(원문의 줄바꿈은 그대로 둔다)
const sentences = (t) => String(t || '').replace(/([.!?])[ \t]+(?=\S)/g, '$1\n');

// 초안(draft) 문서는 공개 페이지에 넣지 않는다. WOLKO_SHOW_DRAFTS=1 로 만든 로컬 미리보기에서만 보인다.
const docs = docList({ includeDrafts: process.env.WOLKO_SHOW_DRAFTS === '1' });
// 캠프마다 쓰는 서약서(아동보호 서약서)에서 고를 캠프. 끝난 캠프는 화면에서(오늘 날짜로) 걸러낸다
const camps = (await getCollection('camp_schedules'))
  .filter(({ id }) => !/test/i.test(id))   // 지원 목록에서 숨긴 캠프(제주 문의 등)도 서약은 해야 하므로 끝나지 않은 캠프는 모두 고를 수 있다
  .map(({ id, data }) => ({ id, ko: data.title_ko, en: data.title_en, start: String(data.start_date || '').slice(0, 10), end: campEndDate(String(data.start_date || ''), data.date_ko || '') }))
  .sort((a, b) => (a.start || '9999').localeCompare(b.start || '9999'));
const data = JSON.stringify({ camps, docs: docs.map((d) => ({ id: d.id, version: d.version, perCamp: !!d.perCamp, ko: d.ko, en: d.en, sections: docSections(d), declaration: d.declaration || null })) }).replace(/</g, '\\u003c');
---

<BaseLayout
  title="스태프 · 크루 서약서 | WOLKO"
  description="월코 캠프 스태프와 크루가 읽고 동의하고 서명하는 서약 문서입니다."
  activeNav=""
  noindex
>
  <PageHero variant="plain">
    <Fragment slot="eyebrow"><span class="wl-ko">월코 캠프 스태프 · 크루</span><span class="wl-en">WOLKO Camp Staff &amp; Crew</span></Fragment>
    <Fragment slot="title">
      <span class="wl-ko"><em>서약서</em></span>
      <span class="wl-en"><em>Agreements</em></span>
    </Fragment>
    <Fragment slot="desc">
      <span class="wl-ko"><span class="sa-ln">캠프에서 섬기는 모든 분이 읽고 동의하며 서명하는 문서예요.</span><span class="sa-ln">폰에서는 손가락으로, 컴퓨터에서는 마우스로 서명하시면 돼요.</span></span>
      <span class="wl-en"><span class="sa-ln">Everyone who serves at camp reads, agrees to and signs these documents.</span><span class="sa-ln">Sign with your finger on a phone, or with your mouse on a computer.</span></span>
    </Fragment>
  </PageHero>

<!-- 서명판과 완료 화면은 스크립트가 다루는 부분이 많아 Astro 의 쪽 안 스타일이 닿지 않는다 — 전역으로 두되 이름은 모두 sa- 로 시작 -->
<style is:global>
  .sa {
    --sa-deep:#004f68; --sa-navy:#0b2430; --sa-ink:#10252e; --sa-body:#3e535d; --sa-muted:#587383;
    --sa-line:#d6dee2; --sa-field:#cdd7dc; --sa-soft:#f6f9fb; --sa-error:#a3262f;
    padding: 56px 0 96px; background: #fff; color: var(--sa-ink); font-family: var(--ff-sans); word-break: keep-all;
  }
  /* 읽는 칸(880px)을 화면 가운데에 — 넓은 화면에서 왼쪽으로 치우쳐 보이지 않게 */
  .sa-shell { width: min(1200px, calc(100% - 48px)); margin: 0 auto; display: grid; gap: 40px; }
  .sa-shell > * { width: 100%; max-width: 880px; min-width: 0; justify-self: center; }
  .sa-need { border: 1px solid var(--sa-line); border-radius: var(--ws-radius-sm, 8px); background: var(--sa-soft); padding: 18px 22px; }
  .sa-need-title { margin: 0 0 10px; font-size: 15px; line-height: 1.7; font-weight: 700; color: var(--sa-navy); }
  .sa-need-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 8px; }
  .sa-need-list li { margin: 0; }
  .sa-need-btn { width: 100%; min-height: 56px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 10px 16px; background: #fff; border: 1px solid var(--sa-line); border-radius: var(--ws-radius-sm, 8px); font: inherit; font-size: 15.5px; text-align: left; color: var(--sa-ink); cursor: pointer; }
  .sa-need-btn:hover { background: var(--sa-soft); }
  .sa-need-btn:focus-visible { outline: 2px solid var(--sa-deep); outline-offset: 2px; }
  .sa-need-btn[aria-expanded="true"] { border-color: var(--sa-deep); box-shadow: 0 0 0 1px var(--sa-deep); }
  .sa-need-name { font-weight: 700; flex: 1; min-width: 0; }
  .sa-need-btn::after { content: ''; flex: none; width: 8px; height: 8px; margin: -3px 2px 0 0; border-right: 2px solid var(--sa-muted); border-bottom: 2px solid var(--sa-muted); transform: rotate(45deg); transition: transform .2s; }
  .sa-need-btn[aria-expanded="true"]::after { transform: rotate(225deg); margin-top: 3px; }
  .sa-need-tag { display: inline-flex; align-items: center; height: 24px; margin-left: 8px; padding: 0 10px; border: 1px solid var(--sa-field); border-radius: var(--ws-radius-sm, 8px); font-size: 12.5px; font-weight: 800; color: var(--sa-deep); vertical-align: 2px; white-space: nowrap; }
  .sa-need { scroll-margin-top: 96px; }
  .sa-need-hint { margin: 10px 0 0; font-size: 13.5px; color: var(--sa-muted); }
  .sa-doc[hidden] { display: none; }
  .sa-need-state:empty { display: none; }
  .sa-need.is-locked .sa-need-btn { opacity: .55; }
  .sa-need-state { flex: none; display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border: 1px solid var(--sa-field); border-radius: var(--ws-radius-sm, 8px); font-size: 12.5px; font-weight: 800; color: var(--sa-muted); }
  .sa-need-list li.is-done .sa-need-state { border-color: var(--sa-deep); background: var(--sa-deep); color: #fff; }
  .sa-need-done { margin: 12px 0 0; font-size: 14.5px; font-weight: 700; color: var(--sa-deep); }
  .sa-need-done[hidden] { display: none; }
  .sa-who { border: 1px solid var(--sa-line); border-radius: var(--ws-radius-sm, 8px); background: #fff; padding: 22px; display: grid; gap: 14px; scroll-margin-top: 96px; }
  .sa-who-title { margin: 0; font-size: 18px; font-weight: 800; color: var(--sa-navy); }
  .sa-who form { display: grid; gap: 14px; }
  .sa-who form[hidden], .sa-who-summary[hidden] { display: none; }
  .sa-who-summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .sa-who-text { font-size: 15px; font-weight: 700; color: var(--sa-navy); overflow-wrap: anywhere; }
  .sa-who-status { margin: 0; font-size: 13px; color: var(--sa-muted); }
  .sa-already { padding: 28px; display: grid; gap: 12px; justify-items: center; text-align: center; }
  .sa-already[hidden] { display: none; }
  .sa-already strong { font-size: 18px; color: var(--sa-navy); }
  .sa-already p { margin: 0; font-size: 14.5px; line-height: 1.8; color: var(--sa-body); }
  .sa-already .sa-actions { width: min(420px, 100%); }
  .sa-doc { scroll-margin-top: 96px; border: 1px solid var(--sa-line); border-radius: var(--ws-radius-sm, 8px); background: #fff; }
  .sa-doc-head { padding: 24px 28px 8px; }
  .sa-doc-head h2 { margin: 0; font-family: var(--ff-serif); font-size: 26px; font-weight: 800; letter-spacing: -.02em; color: var(--sa-navy); }
  .sa-doc-head p { margin: 10px 0 0; font-size: 15px; line-height: 1.8; color: var(--sa-body); }
  /* 항목마다 체크박스: 읽고 하나씩 체크한다(모두 체크해야 서명 가능). 소제목은 가는 선 + 글자 */
  .sa-items { margin: 0; padding: 6px 28px 10px; list-style: none; }
  .sa-items li { padding: 0; border-top: 1px solid #e6edf0; font-size: 15px; line-height: 1.85; color: var(--sa-ink); }
  .sa-items li .wl-ko, .sa-items li .wl-en { white-space: pre-line; }
  .sa-ln { display: block; }   /* 위쪽 큰 제목 아래 설명: 문장마다 한 줄(좁은 화면에서도 합쳐지지 않게 br 대신 블록) */
  .sa-item { position: relative; display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 14px; padding: 15px 0; cursor: pointer; }
  .sa-item input { position: absolute; opacity: 0; width: 20px; height: 20px; margin: 0; left: 0; top: 19px; cursor: pointer; }
  .sa-item-box { position: relative; width: 20px; height: 20px; margin-top: 4px; box-sizing: border-box; border: 1.5px solid #8fabb8; border-radius: 6px; background: #fff; transition: background-color .18s, border-color .18s; }
  .sa-item-box::after { content: ''; position: absolute; left: 5.5px; top: 1.5px; width: 5px; height: 9.5px; border: solid #fff; border-width: 0 2.2px 2.2px 0; transform: rotate(45deg) scale(0); opacity: 0; transition: transform .26s cubic-bezier(.34, 1.56, .64, 1) .04s, opacity .12s; }   /* 체크 표시: 탄력 있게 나타난다 */
  .sa-item:hover .sa-item-box { border-color: var(--sa-deep); }
  .sa-item input:checked + .sa-item-box { border-color: var(--sa-deep); background: var(--sa-deep); animation: saPop .3s ease; }
  .sa-item input:checked + .sa-item-box::after { transform: rotate(45deg) scale(1); opacity: 1; }
  @keyframes saPop { 0% { transform: scale(1); } 40% { transform: scale(.84); } 100% { transform: scale(1); } }
  @media (prefers-reduced-motion: reduce) { .sa-item-box, .sa-item-box::after { transition: none; } .sa-item input:checked + .sa-item-box { animation: none; } }
  .sa-item input:focus-visible + .sa-item-box { outline: 3px solid rgba(0, 79, 104, .35); outline-offset: 2px; }
  .sa-items li.sa-sec { display: block; padding: 26px 0 6px; border-top: 0; font-size: 16.5px; font-weight: 800; letter-spacing: -.01em; color: var(--sa-navy); }
  .sa-items li.sa-sec > span::before { content: ''; display: inline-block; width: 24px; height: 2px; margin: 0 12px 4px 0; background: var(--sa-deep); vertical-align: middle; }
  .sa-items li.sa-sec + li { border-top: 0; }
  .sa-ack { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin: 4px 28px 0; font-size: 14px; font-weight: 700; color: var(--sa-body); }
  .sa-ack-count { flex: none; margin-left: auto; text-align: right; white-space: nowrap; }
  .sa-ack b { color: var(--sa-deep); font-variant-numeric: tabular-nums; }
  .sa-ack.is-done { color: var(--sa-deep); }
  .sa-ack-err { margin: 6px 28px 0; }
  .sa-doc.is-ack-error .sa-item input:not(:checked) + .sa-item-box { border-color: var(--sa-error); }   /* 서명 시도 때 아직 체크하지 않은 항목을 붉은 테두리로 */
  .sa-pledge { white-space: pre-line; margin: 8px 28px 0; padding: 16px 18px; background: var(--sa-soft); border: 1px solid var(--sa-line); border-radius: var(--ws-radius-sm, 8px); font-size: 15px; line-height: 1.8; color: var(--sa-navy); font-weight: 600; }
  .sa-form { padding: 24px 28px 28px; display: grid; gap: 16px; }
  .sa-form h3 { margin: 0; font-size: 17px; font-weight: 800; color: var(--sa-navy); }
  .sa-field label, .sa-legend { display: block; margin: 0 0 6px; font-size: 14px; font-weight: 700; color: var(--sa-navy); }
  .sa-req { color: var(--sa-error); }
  .sa-field input[type="text"], .sa-field input[type="email"] {
    width: 100%; padding: 0 12px;   /* 높이는 사이트 공통 입력칸 34px(wolko-ui.css) */ border: 1px solid var(--sa-field); border-radius: var(--ws-radius-sm, 8px);
    font: 500 16px var(--ff-sans); color: var(--sa-ink); background: #fff; outline: none; box-sizing: border-box;
  }
  .sa-field select {
    width: 100%; padding: 0 12px;   /* 높이는 사이트 공통 입력칸 34px(wolko-ui.css) */ border: 1px solid var(--sa-field); border-radius: var(--ws-radius-sm, 8px);
    font: 500 16px var(--ff-sans); color: var(--sa-ink); background: #fff; outline: none; box-sizing: border-box;
  }
  .sa-field select:focus { border-color: var(--sa-deep); box-shadow: 0 0 0 1px var(--sa-deep); }
  .sa-field select.is-invalid { border-color: var(--sa-error); box-shadow: 0 0 0 1px var(--sa-error); }
  .sa-field input:focus { border-color: var(--sa-deep); box-shadow: 0 0 0 1px var(--sa-deep); }
  .sa-field input.is-invalid { border-color: var(--sa-error); box-shadow: 0 0 0 1px var(--sa-error); }
  .sa-field input[readonly] { background: var(--sa-soft); color: var(--sa-body); }
  .sa-roles { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; border: 0; padding: 0; margin: 0; min-width: 0; }
  .sa-role { position: relative; }
  .sa-role input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .sa-role > span { display: flex; align-items: center; justify-content: center; height: 36px; border: 1px solid var(--sa-field); border-radius: var(--ws-radius-sm, 8px); background: #fff; font-size: 14px; font-weight: 700; color: var(--sa-body); }
  .sa-role input:checked + span { border-color: var(--sa-deep); background: var(--sa-deep); color: #fff; }
  .sa-role input:focus-visible + span { outline: 2px solid var(--sa-deep); outline-offset: 2px; }
  .sa-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .sa-note { margin: 6px 0 0; font-size: 13px; line-height: 1.7; color: var(--sa-muted); }
  .sa-check { display: flex; align-items: flex-start; gap: 12px; cursor: pointer; font-size: 14px; line-height: 1.7; color: var(--sa-body); }
  .sa-check input { width: 20px; height: 20px; margin: 2px 0 0; flex: none; accent-color: var(--sa-deep); }
  .sa-check a { color: var(--sa-deep); text-decoration: underline; text-underline-offset: 3px; }
  .sa-check strong { color: var(--sa-navy); }
  .sa-sign-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 8px; }
  .sa-pad { position: relative; border: 1px dashed var(--sa-field); border-radius: var(--ws-radius-sm, 8px); background: #fff; }
  .sa-pad.is-invalid { border-color: var(--sa-error); box-shadow: 0 0 0 1px var(--sa-error); }
  .sa-pad canvas { display: block; width: 100%; height: 180px; touch-action: none; cursor: crosshair; border-radius: var(--ws-radius-sm, 8px); }
  .sa-pad-hint { position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); text-align: center; font-size: 14px; color: var(--sa-muted); pointer-events: none; }
  .sa-pad.has-ink .sa-pad-hint { display: none; }
  .sa-pad-line { position: absolute; left: 16px; right: 16px; bottom: 36px; height: 1px; background: var(--sa-line); pointer-events: none; }
  .sa-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px; height: 44px; min-height: 44px !important; padding: 0 20px; flex: none;
    border: 1px solid var(--sa-deep); border-radius: var(--ws-radius-sm, 8px); background: var(--sa-deep); color: #fff; font: inherit; font-size: 14.5px; font-weight: 700; cursor: pointer; white-space: nowrap;
  }
  .sa-btn:hover { background: #003d52; border-color: #003d52; }
  .sa-btn.ghost { background: #fff; color: var(--sa-navy); border-color: var(--sa-field); }
  .sa-btn.ghost:hover { background: var(--sa-soft); }
  .sa-btn:disabled { opacity: .55; cursor: default; }
  .sa-actions { display: grid; grid-template-columns: minmax(0, 1fr); gap: 12px; }
  .sa-actions .sa-btn { height: 52px; min-height: 52px !important; width: 100%; font-size: 15.5px; }
  .sa-err { margin: 6px 0 0; font-size: 13px; line-height: 1.6; color: var(--sa-error); font-weight: 600; }
  .sa-err[hidden] { display: none; }
  .sa-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .sa-done { padding: 32px 28px 36px; text-align: center; display: grid; gap: 12px; justify-items: center; }
  .sa-done[hidden], .sa-form[hidden] { display: none; }
  .sa-done-icon { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--sa-deep); border-radius: 50%; color: var(--sa-deep); }
  .sa-done-icon svg { width: 26px; height: 26px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .sa-done h3 { margin: 0; font-size: 20px; color: var(--sa-navy); }
  .sa-done p { margin: 0; font-size: 14.5px; line-height: 1.8; color: var(--sa-body); }
  .sa-code { display: inline-block; padding: 8px 16px; border: 1px solid var(--sa-line); border-radius: var(--ws-radius-sm, 8px); background: var(--sa-soft); font-size: 20px; font-weight: 800; letter-spacing: .08em; color: var(--sa-navy); font-variant-numeric: tabular-nums; }
  .sa-done .sa-actions { width: min(420px, 100%); }
  @media (max-width: 640px) {
    .sa { padding: 32px 0 72px; }
    .sa-shell { width: calc(100% - 32px); gap: 28px; }
    .sa-doc-head, .sa-form, .sa-done, .sa-already { padding-left: 18px; padding-right: 18px; }
    .sa-who { padding: 18px; }
    .sa-items { padding: 2px 18px 8px; } .sa-item { grid-template-columns: 20px minmax(0, 1fr); gap: 12px; }
    .sa-ack { margin: 4px 18px 0; } .sa-ack-err { margin: 6px 18px 0; }
    .sa-pledge { margin: 8px 18px 0; }
    .sa-two { grid-template-columns: minmax(0, 1fr); }
    .sa-pad canvas { height: 160px; }
  }
</style>

<section class="sa">
  <div class="sa-shell">
    <section class="sa-who" data-who aria-labelledby="sa-who-title">
      <h2 class="sa-who-title" id="sa-who-title"><span class="wl-ko">내 정보</span><span class="wl-en">Your information</span></h2>
      <form data-who-form novalidate>
        <fieldset class="sa-roles" aria-label="구분 / Role">
          {Object.entries(ROLE_LABEL).map(([value, label]) => (
            <label class="sa-role"><input type="radio" name="who-role" value={value}><span><span class="wl-ko">{label.ko}</span><span class="wl-en">{label.en}</span></span></label>
          ))}
        </fieldset>
        <p class="sa-err" data-who-err="role" hidden></p>
        <div class="sa-two">
          <div class="sa-field">
            <label for="sa-who-name"><span class="wl-ko">이름</span><span class="wl-en">Full name</span><span class="sa-req" aria-hidden="true"> *</span></label>
            <input class="wl-tall" type="text" id="sa-who-name" name="who-name" maxlength="60" autocomplete="name">
            <p class="sa-err" data-who-err="name" hidden></p>
          </div>
          <div class="sa-field">
            <label for="sa-who-email"><span class="wl-ko">이메일</span><span class="wl-en">Email</span><span class="sa-req" aria-hidden="true"> *</span></label>
            <input class="wl-tall" type="email" id="sa-who-email" name="who-email" maxlength="100" autocomplete="email" inputmode="email">
            <p class="sa-err" data-who-err="email" hidden></p>
          </div>
        </div>
        <p class="sa-err" data-who-err="form" role="alert" hidden></p>
        <div class="sa-actions"><button type="submit" class="sa-btn" data-who-go><span class="wl-ko">확인하고 시작하기</span><span class="wl-en">Continue</span></button></div>
        <p class="sa-note" data-crew-note style="margin:0" hidden><span class="wl-ko">크루(미성년자)는 지원서에서 보호자 동의를 따로 받아요. 신청하실 때 적은 이메일을 그대로 써 주세요.</span><span class="wl-en">Crew members (minors) also need separate guardian consent, which is collected in the application. Please use the same email you used when you applied.</span></p>
      </form>
      <div class="sa-who-summary" data-who-summary hidden>
        <span class="sa-who-text" data-who-text></span>
        <button type="button" class="sa-btn ghost" data-who-edit style="height:36px;min-height:36px !important;padding:0 14px;font-size:13.5px"><span class="wl-ko">정보 고치기</span><span class="wl-en">Change</span></button>
      </div>
      <p class="sa-who-status" data-who-status role="status" aria-live="polite" hidden></p>
    </section>
    <div class="sa-need is-locked" data-need data-total={docs.length}>
      <p class="sa-need-title">
        <span class="wl-ko">필수 서약서 {docs.length}개 · 스태프와 크루로 섬기는 모든 분은 캠프 트레이닝 위크에 아래 서약서를 모두 작성합니다.</span>
        <span class="wl-en">{docs.length} required agreements · everyone who serves as staff or crew completes all of the agreements below during Camp Training Week.</span>
      </p>
      <ol class="sa-need-list">
        {docs.map((doc) => (
          <li data-need-doc={doc.id}>
            <button type="button" class="sa-need-btn" data-open-doc={doc.id} aria-expanded="false" aria-controls={`doc-${doc.id}`}>
              <span class="sa-need-name"><span class="wl-ko">{doc.ko.title}</span><span class="wl-en">{doc.en.title}</span>{doc.perCamp && <span class="sa-need-tag"><span class="wl-ko">캠프마다 작성</span><span class="wl-en">Every camp</span></span>}</span>
              <span class="sa-need-state" data-need-state></span>
            </button>
          </li>
        ))}
      </ol>
      <p class="sa-need-hint" data-need-hint>
        <span class="sa-hint-locked"><span class="wl-ko">위에 이름과 이메일을 입력하면 서약서를 열 수 있어요.</span><span class="wl-en">Enter your name and email above to open the agreements.</span></span>
        <span class="sa-hint-open" hidden><span class="wl-ko">서약서를 눌러 내용을 읽고 서명해 주세요.</span><span class="wl-en">Tap an agreement to read it and sign.</span></span>
      </p>
      <p class="sa-need-done" data-need-done hidden>
        <span class="wl-ko">모든 서약서를 작성하셨어요. 감사합니다!</span>
        <span class="wl-en">You have completed all the agreements. Thank you!</span>
      </p>
    </div>
    {docs.map((doc) => (
      <article class="sa-doc" id={`doc-${doc.id}`} data-doc={doc.id} data-version={doc.version} hidden>
        <div class="sa-doc-head">
          <h2><span class="wl-ko">{doc.ko.title}</span><span class="wl-en">{doc.en.title}</span></h2>
          <p><span class="wl-ko">{doc.ko.intro}</span><span class="wl-en">{doc.en.intro}</span></p>
        </div>
        <div class="sa-already" data-already hidden>
          <strong><span class="wl-ko">이미 작성하셨습니다</span><span class="wl-en">You have already signed this</span></strong>
          <p data-already-at></p>
          <div class="sa-actions">
            <button type="button" class="sa-btn" data-next hidden><span class="wl-ko">다음 서약서 작성하기</span><span class="wl-en">Next agreement</span></button>
            <button type="button" class="sa-btn ghost" data-back><span class="wl-ko">서약서 목록으로</span><span class="wl-en">Back to the list</span></button>
          </div>
        </div>

        <p class="sa-ack" data-ack data-total={docSections(doc).reduce((n, sec) => n + sec.items.length, 0)}><span class="sa-ack-text"><span class="wl-ko">각 항목을 읽고 하나씩 체크해 주세요</span><span class="wl-en">Read each item and tick it</span></span><span class="sa-ack-count" aria-label="체크한 항목 / Items ticked"><b data-ack-n>0</b> / {docSections(doc).reduce((n, sec) => n + sec.items.length, 0)}</span></p>
        <p class="sa-err sa-ack-err" data-err="items" role="alert" hidden></p>
        <ol class="sa-items">
          {docSections(doc).map((sec) => (
            <>
              {sec.ko && <li class="sa-sec"><span><span class="wl-ko">{sec.ko}</span><span class="wl-en">{sec.en}</span></span></li>}
              {sec.items.map((it) => (
                <li><label class="sa-item"><input type="checkbox" data-item-check><span class="sa-item-box" aria-hidden="true"></span><span><span class="wl-ko">{sentences(it.ko)}</span><span class="wl-en">{sentences(it.en)}</span></span></label></li>
              ))}
            </>
          ))}
        </ol>
        <p class="sa-pledge"><span class="wl-ko">{sentences(doc.ko.pledge)}</span><span class="wl-en">{sentences(doc.en.pledge)}</span></p>

        <form class="sa-form" novalidate data-form>
          <h3><span class="wl-ko">서명하기</span><span class="wl-en">Sign</span></h3>

          {doc.perCamp && (
            <div class="sa-field">
              <label for={`sa-camp-${doc.id}`}><span class="wl-ko">참여하는 캠프</span><span class="wl-en">Camp you are taking part in</span><span class="sa-req" aria-hidden="true"> *</span></label>
              <select class="wl-tall" id={`sa-camp-${doc.id}`} name="campId" data-camp-select><option value=""></option></select>
              <p class="sa-note"><span class="wl-ko">이 서약서는 참여하는 캠프마다 새로 작성합니다.</span><span class="wl-en">This agreement is signed again for every camp you take part in.</span></p>
              <p class="sa-err" data-camp-none hidden><span class="wl-ko">지금 서명할 수 있는 캠프가 없어요. 월코에 문의해 주세요.</span><span class="wl-en">There is no camp open for signing right now. Please contact WOLKO.</span></p>
              <p class="sa-err" data-camp-signed hidden><span class="wl-ko">이 캠프의 서약서는 이미 작성하셨습니다.</span><span class="wl-en">You have already signed this agreement for this camp.</span></p>
              <p class="sa-err" data-err="campId" hidden></p>
            </div>
          )}
          <div class="sa-field">
            <label for={`sa-date-${doc.id}`}><span class="wl-ko">날짜</span><span class="wl-en">Date</span></label>
            <input class="wl-tall" type="text" id={`sa-date-${doc.id}`} data-date readonly tabindex="-1">
          </div>
          <div class="sa-hp" aria-hidden="true"><label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>

          <div>
            <div class="sa-sign-head">
              <span class="sa-legend"><span class="wl-ko">서명</span><span class="wl-en">Signature</span><span class="sa-req" aria-hidden="true"> *</span></span>
              <button type="button" class="sa-btn ghost" data-clear style="height:36px;min-height:36px !important;padding:0 14px;font-size:13.5px"><span class="wl-ko">다시 쓰기</span><span class="wl-en">Clear</span></button>
            </div>
            <div class="sa-pad" data-padbox>
              <canvas data-pad aria-label="서명 칸 / Signature pad"></canvas>
              <span class="sa-pad-line"></span>
              <span class="sa-pad-hint"><span class="wl-ko">여기에 손가락이나 마우스로 서명해 주세요</span><span class="wl-en">Sign here with your finger or mouse</span></span>
            </div>
            <p class="sa-err" data-err="signature" hidden></p>
          </div>

          {doc.declaration && (
            <>
              <label class="sa-check">
                <input type="checkbox" name="declared">
                <span><strong class="wl-ko">{doc.declaration.ko}</strong><strong class="wl-en">{doc.declaration.en}</strong></span>
              </label>
              <p class="sa-err" data-err="declared" hidden></p>
            </>
          )}
          <label class="sa-check">
            <input type="checkbox" name="agree">
            <span><strong class="wl-ko">위 문서를 모두 읽었으며, 내용에 동의합니다.</strong><strong class="wl-en">I have read the whole document above and I agree with it.</strong></span>
          </label>
          <p class="sa-err" data-err="agree" hidden></p>
          <label class="sa-check">
            <input type="checkbox" name="consent">
            <span>
              <span class="wl-ko">이름 · 이메일 · 서명 그림을 서약 확인과 보관에 쓰는 것에 동의합니다. 삭제를 요청하실 때까지 보관해요. <a href="/privacy" target="_blank" rel="noopener">개인정보처리방침</a></span>
              <span class="wl-en">I agree to my name, email and signature image being used to confirm and keep this agreement. Kept until you ask us to delete it. <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a></span>
            </span>
          </label>
          <p class="sa-err" data-err="consent" hidden></p>
          <p class="sa-err" data-err="form" role="alert" hidden></p>

          <div class="sa-actions">
            <button type="submit" class="sa-btn" data-submit><span class="wl-ko">서명 제출</span><span class="wl-en">Submit signature</span></button>
          </div>
        </form>

        <div class="sa-done" data-done hidden>
          <div class="sa-done-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
          <h3 tabindex="-1" data-done-title><span class="wl-ko">서명이 완료되었어요</span><span class="wl-en">Your signature has been recorded</span></h3>
          <p><span class="wl-ko">확인번호</span><span class="wl-en">Reference code</span></p>
          <span class="sa-code" data-code></span>
          <p data-signed-at></p>
          <div class="sa-actions">
            <button type="button" class="sa-btn" data-again hidden><span class="wl-ko">다른 캠프 서약서도 작성하기</span><span class="wl-en">Sign for another camp</span></button>
            <button type="button" class="sa-btn" data-next hidden><span class="wl-ko">다음 서약서 작성하기</span><span class="wl-en">Next agreement</span></button>
            <button type="button" class="sa-btn ghost" data-print><span class="wl-ko">서명본 인쇄 · PDF로 저장</span><span class="wl-en">Print or save signed copy as PDF</span></button>
            <button type="button" class="sa-btn ghost" data-back><span class="wl-ko">서약서 목록으로</span><span class="wl-en">Back to the list</span></button>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

</BaseLayout>

<script is:inline type="application/json" id="sa-data" set:html={data}></script>

<script is:inline>
(function () {
  var DOCS = {}, CAMPS = [];
  try { var PAGE = JSON.parse(document.getElementById('sa-data').textContent); CAMPS = PAGE.camps || []; PAGE.docs.forEach(function (d) { DOCS[d.id] = d; }); } catch (e) {}
  var isEn = function () {
    var el = document.getElementById('lang-root');
    return !!((el && el.classList.contains('lang-en')) || document.body.classList.contains('lang-en') || document.documentElement.classList.contains('lang-en'));
  };
  var T = function (ko, en) { return isEn() ? en : ko; };
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]; }); };
  var EMAIL_RE = /^[^\s@<>]+@[^\s@<>]+\.[^\s@<>]+$/;

  /* 오늘 날짜(한국 시간) */
  function todayKst() {
    try {
      var p = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Seoul', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
      return p.replace(/-/g, '. ') + '.';
    } catch (e) { var d = new Date(); return d.getFullYear() + '. ' + String(d.getMonth() + 1).padStart(2, '0') + '. ' + String(d.getDate()).padStart(2, '0') + '.'; }
  }
  function signedAtText(iso) {
    try { return new Intl.DateTimeFormat(isEn() ? 'en-US' : 'ko-KR', { timeZone: 'Asia/Seoul', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(iso)) + ' (KST)'; } catch (e) { return iso; }
  }

  /* ───── 서명판: 손가락 · 펜 · 마우스. 획을 0~1 좌표로 기억해 두어 화면 크기가 바뀌어도(폰을 돌려도) 다시 그린다 ───── */
  function Pad(canvas, box) {
    var ctx = canvas.getContext('2d');
    var strokes = [], cur = null, cssW = 0, cssH = 0, dpr = 1;
    function size() {
      var r = canvas.getBoundingClientRect();
      cssW = Math.max(1, r.width); cssH = Math.max(1, r.height); dpr = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.round(cssW * dpr); canvas.height = Math.round(cssH * dpr);
      redraw();
    }
    function line(c, w, h, scale) {
      c.lineCap = 'round'; c.lineJoin = 'round'; c.strokeStyle = '#0b2430'; c.lineWidth = 2.6 * scale;
      strokes.forEach(function (s) {
        if (!s.length) return;
        c.beginPath();
        c.moveTo(s[0][0] * w, s[0][1] * h);
        if (s.length === 1) c.lineTo(s[0][0] * w + 0.1, s[0][1] * h);
        for (var i = 1; i < s.length - 1; i++) {   // 가운데 점을 이어 부드럽게
          c.quadraticCurveTo(s[i][0] * w, s[i][1] * h, (s[i][0] + s[i + 1][0]) / 2 * w, (s[i][1] + s[i + 1][1]) / 2 * h);
        }
        if (s.length > 1) c.lineTo(s[s.length - 1][0] * w, s[s.length - 1][1] * h);
        c.stroke();
      });
    }
    function redraw() { ctx.setTransform(1, 0, 0, 1, 0, 0); ctx.clearRect(0, 0, canvas.width, canvas.height); line(ctx, canvas.width, canvas.height, dpr); box.classList.toggle('has-ink', strokes.length > 0); }
    function pt(e) { var r = canvas.getBoundingClientRect(); return [Math.min(1, Math.max(0, (e.clientX - r.left) / r.width)), Math.min(1, Math.max(0, (e.clientY - r.top) / r.height))]; }
    canvas.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      e.preventDefault(); try { canvas.setPointerCapture(e.pointerId); } catch (x) {}
      cur = [pt(e)]; strokes.push(cur); box.classList.add('has-ink'); box.classList.remove('is-invalid'); redraw();
    });
    canvas.addEventListener('pointermove', function (e) { if (!cur) return; e.preventDefault(); cur.push(pt(e)); redraw(); });
    var end = function (e) { if (!cur) return; cur = null; };
    canvas.addEventListener('pointerup', end); canvas.addEventListener('pointercancel', end); canvas.addEventListener('lostpointercapture', end);
    canvas.addEventListener('touchmove', function (e) { e.preventDefault(); }, { passive: false });   // 서명하는 동안 화면이 스크롤되지 않게
    window.addEventListener('resize', size);
    if (window.ResizeObserver) new ResizeObserver(size).observe(canvas);
    size();
    return {
      clear: function () { strokes = []; cur = null; redraw(); },
      /* 점이 어느 정도 이어진 획이 있어야 서명으로 본다(점 하나 톡 찍은 것은 제외) */
      hasInk: function () { var n = 0; strokes.forEach(function (s) { n += s.length; }); return n >= 8; },
      /* 흰 바탕에 그려 PNG 로 — 어디에 붙여도 잘 보이게 */
      toPng: function () {
        var w = Math.round(cssW * dpr), h = Math.round(cssH * dpr);
        var out = document.createElement('canvas'); out.width = w; out.height = h;
        var c = out.getContext('2d'); c.fillStyle = '#fff'; c.fillRect(0, 0, w, h); line(c, w, h, dpr);
        return out.toDataURL('image/png');
      },
    };
  }

  /* ───── 서명본 인쇄(새 창에 문서 전체 + 서명 그림 + 확인번호) ───── */
  var sentences = function (t) { return String(t || '').replace(/([.!?])[ \t]+(?=\S)/g, '$1\n'); };   // 화면과 같이 문장마다 줄바꿈
  function printCopy(doc, rec) {
    var w = window.open('', '_blank');
    if (!w) { alert(T('팝업이 막혀 있어요. 이 사이트의 팝업을 허용한 뒤 다시 눌러 주세요.', 'Pop-ups are blocked. Please allow pop-ups for this site and try again.')); return; }
    var n0 = 0;
    var items = function (k) { n0 = 0; return doc.sections.map(function (sec) { return (sec[k] ? '<li class="sec"><span>' + esc(sec[k]) + '</span></li>' : '') + sec.items.map(function (it) { n0++; return '<li><b>' + String(n0).padStart(2, '0') + '</b><span>' + esc(sentences(it[k])) + '</span></li>'; }).join(''); }).join(''); };
    var decl = function (k) { return doc.declaration ? '<p class="pledge">' + esc(doc.declaration[k]) + '</p>' : ''; };
    var roleLabel = rec.role === 'crew' ? '크루 Crew' : '스태프 Staff';
    // (여는 태그를 둘로 나눠 쓴 것은 '전체 페이지는 스크롤 잠금 스크립트를 불러온다'는 검사가 이 글자열을 쪽 전체로 오해하지 않게 하려는 것)
    w.document.write('<!doctype html><' + 'html lang="ko"><head><meta charset="utf-8"><title>' + esc(doc.ko.title) + ' — ' + esc(rec.name) + '</title><style>'
      + 'body{font:14px/1.75 "Noto Sans KR",system-ui,sans-serif;color:#10252e;max-width:760px;margin:32px auto;padding:0 24px}h1{font-size:22px;margin:0 0 4px}h2{font-size:15px;margin:28px 0 6px;color:#3e535d}p{margin:6px 0}'
      + 'ol{list-style:none;padding:0;margin:8px 0}li{display:grid;grid-template-columns:34px 1fr;gap:10px;padding:8px 0;border-top:1px solid #d6dee2}li b{color:#004f68}li span,.pledge{white-space:pre-line}li.sec{display:block;font-weight:800;padding-top:16px}'
      + '.pledge{padding:10px 14px;border:1px solid #d6dee2;background:#f6f9fb;font-weight:600;white-space:pre-line}.sig{margin-top:24px;border:1px solid #d6dee2;padding:14px 18px;page-break-inside:avoid}.sig img{display:block;max-width:360px;width:100%;height:auto;border-bottom:1px solid #9fb0b8;margin:8px 0}'
      + '.meta{display:grid;grid-template-columns:120px 1fr;gap:4px 12px;font-size:13px}.meta dt{color:#587383}.meta dd{margin:0;font-weight:600}.en{margin-top:36px;border-top:2px solid #10252e;padding-top:8px}@media print{body{margin:0}}'
      + '</style></head><body>'
      + '<h1>' + esc(doc.ko.title) + '</h1><p>' + esc(doc.ko.intro) + '</p><ol>' + items('ko') + '</ol>' + decl('ko') + '<p class="pledge">' + esc(sentences(doc.ko.pledge)) + '</p>'
      + '<div class="en"><h1>' + esc(doc.en.title) + '</h1><p>' + esc(doc.en.intro) + '</p><ol>' + items('en') + '</ol>' + decl('en') + '<p class="pledge">' + esc(sentences(doc.en.pledge)) + '</p></div>'
      + '<div class="sig"><img alt="signature" src="' + rec.signature + '"><dl class="meta">'
      + '<dt>이름 / Name</dt><dd>' + esc(rec.name) + '</dd><dt>구분 / Role</dt><dd>' + roleLabel + '</dd><dt>이메일 / Email</dt><dd>' + esc(rec.email) + '</dd>'
      + (rec.camp ? '<dt>캠프 / Camp</dt><dd>' + esc(rec.camp) + '</dd>' : '')
      + '<dt>서명 시각 / Signed</dt><dd>' + esc(signedAtText(rec.signedAt)) + '</dd><dt>확인번호 / Code</dt><dd>' + esc(rec.code) + '</dd><dt>문서 버전 / Version</dt><dd>' + esc(doc.version) + '</dd></dl></div>'
      + '<script>window.onload=function(){setTimeout(function(){window.print()},300)}<\/script></body></html>');
    w.document.close();
  }

  /* ───── 내 정보(이름 · 이메일 · 구분) → 이미 서명한 서약서 확인 → 아직인 것만 서명 ───── */
  var STATE = { info: null, signed: {} };   // info = { role, name, email } · signed = 서버가 알려 준 '이미 서명한' 서약서 { faith: { at }, childprotection: { 캠프id: { at } } }
  var WHO_KEY = 'wolko-agreements-who';
  var QS = (function () { try { return new URLSearchParams(location.search); } catch (e) { return new URLSearchParams(''); } })();
  var whoEl = document.querySelector('[data-who]'), whoForm = whoEl.querySelector('[data-who-form]'), whoSummary = whoEl.querySelector('[data-who-summary]');
  var needEl = document.querySelector('[data-need]');
  var articles = Array.prototype.slice.call(document.querySelectorAll('.sa-doc'));
  var doneIds = {};     // 이 사람이 서명한(캠프마다 쓰는 서약서는 한 캠프라도) 서약서
  var pendingOpen = ''; // 정보를 넣기 전에 열려던 서약서(주소의 #doc-…)
  var lastOpenerId = '';
  function whoErr(field, msg) { var el = whoEl.querySelector('[data-who-err="' + field + '"]'); if (el) { el.textContent = msg; el.hidden = !msg; } var input = whoForm.elements['who-' + field]; if (input && input.classList) input.classList.toggle('is-invalid', !!msg); }
  var whoStatusPair = null;
  function whoStatus(ko, en) { whoStatusPair = ko ? [ko, en] : null; var el = whoEl.querySelector('[data-who-status]'); el.textContent = ko ? T(ko, en) : ''; el.hidden = !ko; }
  function whoSummaryText() { return STATE.info ? STATE.info.name + ' · ' + STATE.info.email + ' · ' + roleLabel(STATE.info.role) : ''; }
  function refreshLangText() {   // 한 · 영 전환 때 JS 가 쓴 문구(내 정보 요약 · 작성 시각 · 확인 실패 안내)도 바꾼다
    if (STATE.info) whoEl.querySelector('[data-who-text]').textContent = whoSummaryText();
    if (whoStatusPair) whoStatus(whoStatusPair[0], whoStatusPair[1]);
    articles.forEach(function (a) { var d = DOCS[a.dataset.doc], at = !d.perCamp && STATE.signed[d.id]; if (at) a.querySelector('[data-already-at]').textContent = signedAtText(at.at); });
  }
