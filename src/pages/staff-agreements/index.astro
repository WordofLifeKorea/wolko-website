      form.scrollIntoView({ block: 'start', behavior: 'smooth' });
    });
    Array.prototype.forEach.call(article.querySelectorAll('[data-next]'), function (btn) { btn.addEventListener('click', function (e) { var id = e.currentTarget.dataset.nextDoc; if (id) openDoc(id); }); });
    Array.prototype.forEach.call(article.querySelectorAll('[data-back]'), function (btn) { btn.addEventListener('click', function () { openDoc(null, false); needEl.scrollIntoView({ block: 'start', behavior: 'smooth' }); }); });
  });

  // 목록의 항목을 누르면 그 서약서만 열리고, 같은 항목을 다시 누르면 닫힌다(이름 · 이메일을 넣기 전에는 정보 입력으로 안내)
  Array.prototype.forEach.call(document.querySelectorAll('[data-open-doc]'), function (b) {
    b.addEventListener('click', function () {
      var id = b.dataset.openDoc, a = articles.filter(function (x) { return x.dataset.doc === id; })[0];
      lastOpenerId = id;
      openDoc(a && !a.hidden ? null : id);
    });
  });
  window.addEventListener('hashchange', function () { var m = location.hash.match(/^#doc-([a-z0-9]+)$/); if (m && DOCS[m[1]]) openDoc(m[1]); });   // 열려 있는 탭에 링크를 붙여 넣어도 열린다

  /* ───── 시작: 주소의 ?name&email&role · 이 탭에서 전에 넣은 정보로 미리 채우고, 다 있으면 바로 확인한다 ───── */
  (function init() {
    // 주소에 이름 · 이메일이 있으면 그것만 쓴다(저장해 둔 다른 사람의 정보와 섞지 않는다)
    var fromUrl = !!(QS.get('name') || QS.get('email'));
    var saved = null; if (!fromUrl) { try { saved = JSON.parse(sessionStorage.getItem(WHO_KEY) || 'null'); } catch (e) {} }
    var name = (QS.get('name') || (saved && saved.name) || '').slice(0, 60), email = (QS.get('email') || (saved && saved.email) || '').slice(0, 100), role = QS.get('role') || (saved && saved.role) || '';
    whoForm.elements['who-name'].value = name; whoForm.elements['who-email'].value = email;
    if (role === 'staff' || role === 'crew') { var r = whoForm.querySelector('input[name="who-role"][value="' + role + '"]'); if (r) { r.checked = true; var cn0 = whoForm.querySelector('[data-crew-note]'); if (cn0) cn0.hidden = role !== 'crew'; } }
    var hashId = (location.hash.match(/^#doc-([a-z0-9]+)$/) || [])[1];
    if (hashId && DOCS[hashId]) pendingOpen = hashId;
    var campParam = QS.get('camp');
    if (campParam && openCamps().some(function (c) { return c.id === campParam; })) articles.forEach(function (a) { var sel = a.querySelector('[data-camp-select]'); if (sel) sel.value = campParam; });
    if (name.trim().length >= 2 && EMAIL_RE.test(email.trim().toLowerCase()) && (role === 'staff' || role === 'crew')) continueWho({ role: role, name: name.trim().replace(/\s+/g, ' '), email: email.trim().toLowerCase() });
    else renderList();
  })();
})();
</script>
