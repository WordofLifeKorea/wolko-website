---
// 경비 리포트(Expense Report) — 포탈 세션으로 접속. 제출 → 승인(master/admin) → 송금 처리(회계 담당)
// No BaseLayout; standalone page (car/wolkoadmin과 동일한 패턴)
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>경비 리포트 — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/expense.css?v=14">
  <link rel="stylesheet" href="/wolko-lang-toggle.css?v=2">
  <link rel="stylesheet" href="/wolko-rail.css?v=11">
  <script src="/wolko-rail.js?v=11" defer></script>
  <meta name="theme-color" content="#004f68">
  <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
  <script is:inline src="/wolko-session.js?v=1"></script>
</head>
<body>
  <header class="ex-header">
    <a class="ex-title" href="/portal" title="WOLKO Portal" aria-label="WOLKO Portal"><img src="/images/WOLKO Circle.png" alt="WOLKO">Expense Report</a>
    <div style="display:flex;align-items:center;gap:16px;">
      <span class="ex-user" id="exUser"></span>
      <div class="wl-lang-toggle" role="group" aria-label="Language">
        <button type="button" class="wl-lang-btn" id="langKoBtn" data-lang="ko" aria-label="한국어" title="한국어"><img src="https://flagcdn.com/w20/kr.png" alt=""><span>KO</span></button>
        <button type="button" class="wl-lang-btn" id="langEnBtn" data-lang="en" aria-label="English" title="English"><img src="https://flagcdn.com/w20/us.png" alt=""><span>EN</span></button>
      </div>
    </div>
  </header>

  <main class="ex-wrap">
    <nav class="ex-tabs" id="exTabs"></nav>
    <section id="exView"></section>
  </main>
  <div class="ex-toast" id="exToast"></div>

  <script is:inline>
    /* ── 계정과목(Account) 목록 — 관리 번호 포함. 추가/변경은 여기서만 하면 됨 ── */
    const ACCOUNTS = [
      'WOLKO (8021)', 'Car Gas (8400)', 'Car Maintenance (8500)', 'Car Tax (8320)',
      'Junior Camp (8040)', 'Ministry Center Expense (8289)', 'Student Ministries (8042)',
      'SYME Equipment (8395)', 'SYME Program Event (8974)', 'SYME Food (8968)',
      'Missionary Account (8025)', 'Teacher (8052)', 'Pyeongtaek EM (8067)', 'Other/Unknown',
    ];
    const OTHER = '__other';
    /* ── 번역 사전 (한국어/English). 화면 문구는 전부 여기서만 관리 ── */
    const T = {
      ko: {
        pageTitle: '경비 리포트 — WOLKO',
        tabNew: '새 리포트', tabEdit: '리포트 수정', tabMine: '내 리포트', tabApprove: '승인 대기', tabAcct: '회계 업무', tabAll: '전체 리포트',
        st_submitted: '승인 대기', st_approved: '승인됨 · 송금 대기', st_processed: '송금 처리 완료', st_rejected: '반려됨',
        acctPh: 'Account · 계정과목', acctPrev: '이전 계정과목 (직접 입력)', currency: '통화', amountPh: '금액', delRow: '항목 삭제',
        acctOtherPh: '계정과목 직접 입력 (예: Supplies (5250))', itemPh: '구매 품목명 (예: 캠프 간식)', purposePh: '구매 목적 (예: 스태프 야식)', thItem: '품목 · 목적',
        attachTitle: '영수증 첨부', attach: '영수증', less: '접기', remove: '삭제',
        wherePh: 'Where · 장소 (선택)', rowProjPh: '이 항목만 다른 Project (선택)',
        titleNew: '새 경비 리포트', titleEdit: '경비 리포트 수정',
        subNew: n => n + ' 님 명의로 제출됩니다. 기준 통화는 원화(₩)이고, 달러($) 항목은 영수 날짜 환율로 자동 환산돼요.',
        lblDesc: 'Description<span class="ko">설명</span>', descPh: '예: 9월 캠프 준비 경비',
        lblProject: 'Project<span class="ko">프로젝트 (마지막 값 기억)</span>', projPh: '예: 1552044602 - Kim, Hwan Kyu',
        addRow: '＋ 항목 추가', cancelEdit: '수정 취소', submitEdit: '수정 후 다시 제출', submit: '경비 리포트 제출', totalKrw: '합계 (KRW)',
        rateSaved: '저장된 환율', rateLoading: '환율 조회 중…', rateLatest: '최신 환율',
        rateAsOf: d => d + ' 기준', rateBiz: d => d + ' 기준(영업일)', rateFail: '자동 조회 실패 — 직접 입력', rateManual: '직접 입력', rateAria: '환율',
        noteRejected: '반려 사유',
        noteApproved: (n, d) => n + ' 님이 ' + d + '에 승인했습니다.',
        noteProcessed: (d, n) => d + ' 송금 처리 완료 (' + n + ')',
        btnResubmit: '수정 후 재제출', btnEdit: '수정', btnWithdraw: '철회', btnCopy: '복사해서 새로 작성',
        btnApprove: '승인', btnReject: '반려', btnProcess: '송금 처리 완료', noDesc: '(설명 없음)',
        submittedOn: d => d + ' 제출',
        emptyApprove: '승인 대기 중인 리포트가 없습니다 ✓', recent: '최근 처리한 리포트',
        fTodo: '송금 대기', fDone: '송금 완료', fAll: '전체', csv: 'CSV 내보내기',
        countLine: (n, sum) => n + '건 · ' + sum, emptyFilter: '해당하는 리포트가 없습니다.', emptyMine: '아직 제출한 리포트가 없습니다.',
        loading: '불러오는 중…', allPeople: '모든 제출자', allTotal: (n, sum) => n + '건 · ' + sum, userAcct: ' · 회계',
        uploading: '영수증 업로드 중…', max5: '항목당 영수증은 최대 5개까지 첨부할 수 있어요.', attached: '영수증이 첨부되었습니다.',
        pvNoLoad: '미리보기를 불러올 수 없습니다.', pvOpenFail: '영수증을 열 수 없습니다.', pvNewTab: '새 탭', pvSave: '저장', pvClose: '닫기', pvPrev: '이전', pvNext: '다음',
        pvBadImg: '이 형식은 미리볼 수 없어요. 위의 "저장"으로 받아서 확인해 주세요.', pvUnsupported: '미리보기를 지원하지 않는 형식입니다. "저장"으로 받아 주세요.',
        tResubmitted: '수정되어 다시 제출되었습니다.', tSubmitted: '제출되었습니다. 관리자에게 알림이 전송됩니다.',
        tCopied: '지난 리포트를 복사했어요. 금액·날짜를 확인해 주세요.', cWithdraw: '이 리포트를 철회(삭제)할까요?', tWithdrawn: '철회되었습니다.',
        tApproved: '승인했습니다. 회계 담당자에게 알림이 전송됩니다.', pReject: '반려 사유를 입력해 주세요.', tRejected: '반려했습니다.',
        cProcess: '송금을 마쳤나요? "송금 처리 완료"로 처리합니다.', tProcessed: '송금 처리 완료로 처리했습니다.',
        btnTrash: '삭제', btnRestore: '복구', fTrash: '삭제됨', emptyTrash: '삭제된 리포트가 없습니다.',
        cTrash: '이 리포트를 삭제할까요?\n영수증까지 통째로 백업되어 "삭제됨"에서 언제든 복구할 수 있어요.', tTrashed: '삭제했습니다. "삭제됨"에서 복구할 수 있어요.',
        cRestore: '이 리포트를 복구할까요?', tRestored: '복구했습니다.',
        noteTrashed: (n, d) => '삭제됨 — ' + n + ' · ' + d,
        errLogin: '로그인이 필요합니다.', errReq: '요청에 실패했습니다.',
      },
      en: {
        pageTitle: 'Expense Report — WOLKO',
        tabNew: 'New report', tabEdit: 'Edit report', tabMine: 'My reports', tabApprove: 'To approve', tabAcct: 'Accounting', tabAll: 'All reports',
        st_submitted: 'Pending approval', st_approved: 'Approved · awaiting payment', st_processed: 'Payment completed', st_rejected: 'Rejected',
        acctPh: 'Account', acctPrev: 'Previous account (custom)', currency: 'Currency', amountPh: 'Amount', delRow: 'Remove item',
        acctOtherPh: 'Enter account (e.g. Supplies (5250))', itemPh: 'Item purchased (e.g. camp snacks)', purposePh: 'Purpose (e.g. staff late-night meal)', thItem: 'Item · Purpose',
        attachTitle: 'Attach receipt', attach: 'Receipt', less: 'Less', remove: 'Remove',
        wherePh: 'Where (optional)', rowProjPh: 'Different project for this item (optional)',
        titleNew: 'New expense report', titleEdit: 'Edit expense report',
        subNew: n => 'Submitted under ' + n + '. The base currency is KRW (₩); dollar ($) items are converted automatically at the exchange rate on the receipt date.',
        lblDesc: 'Description', descPh: 'e.g. September camp supplies',
        lblProject: 'Project<span class="ko">remembers last value</span>', projPh: 'e.g. 1552044602 - Kim, Hwan Kyu',
        addRow: '+ Add item', cancelEdit: 'Cancel edit', submitEdit: 'Save & resubmit', submit: 'Submit expense report', totalKrw: 'Total (KRW)',
        rateSaved: 'Saved rate', rateLoading: 'Fetching rate…', rateLatest: 'Latest rate',
        rateAsOf: d => 'as of ' + d, rateBiz: d => 'as of ' + d + ' (prev. business day)', rateFail: 'Auto lookup failed — enter manually', rateManual: 'Entered manually', rateAria: 'Exchange rate',
        noteRejected: 'Reason for rejection',
        noteApproved: (n, d) => 'Approved by ' + n + ' on ' + d + '.',
        noteProcessed: (d, n) => 'Payment completed on ' + d + ' (' + n + ')',
        btnResubmit: 'Edit & resubmit', btnEdit: 'Edit', btnWithdraw: 'Withdraw', btnCopy: 'Copy as new',
        btnApprove: 'Approve', btnReject: 'Reject', btnProcess: 'Mark payment completed', noDesc: '(No description)',
        submittedOn: d => 'Submitted ' + d,
        emptyApprove: 'No reports are waiting for approval ✓', recent: 'Recently processed',
        fTodo: 'To pay', fDone: 'Paid', fAll: 'All', csv: 'Export CSV',
        countLine: (n, sum) => n + (n === 1 ? ' report · ' : ' reports · ') + sum, emptyFilter: 'No matching reports.', emptyMine: 'You have not submitted any reports yet.',
        loading: 'Loading…', allPeople: 'All submitters', allTotal: (n, sum) => n + (n === 1 ? ' report · ' : ' reports · ') + sum, userAcct: ' · Accounting',
        uploading: 'Uploading receipt…', max5: 'You can attach up to 5 receipts per item.', attached: 'Receipt attached.',
        pvNoLoad: 'Cannot load the preview.', pvOpenFail: 'Cannot open the receipt.', pvNewTab: 'New tab', pvSave: 'Save', pvClose: 'Close', pvPrev: 'Previous', pvNext: 'Next',
        pvBadImg: 'This format cannot be previewed. Use "Save" above to download it.', pvUnsupported: 'Preview is not supported for this file type. Use "Save" to download it.',
        tResubmitted: 'Updated and resubmitted.', tSubmitted: 'Submitted. Approvers have been notified.',
        tCopied: 'Copied the previous report. Please check the amounts and dates.', cWithdraw: 'Withdraw (delete) this report?', tWithdrawn: 'Withdrawn.',
        tApproved: 'Approved. Accountants have been notified.', pReject: 'Enter the reason for rejection.', tRejected: 'Rejected.',
        cProcess: 'Have you finished sending the payment? It will be marked as payment completed.', tProcessed: 'Marked as payment completed.',
        btnTrash: 'Delete', btnRestore: 'Restore', fTrash: 'Deleted', emptyTrash: 'No deleted reports.',
        cTrash: 'Delete this report?\nIt is backed up with its receipts and can be restored from "Deleted" anytime.', tTrashed: 'Deleted. You can restore it from "Deleted".',
        cRestore: 'Restore this report?', tRestored: 'Restored.',
        noteTrashed: (n, d) => 'Deleted — ' + n + ' · ' + d,
        errLogin: 'Please sign in.', errReq: 'Request failed.',
      },
    };
    let lang = (() => { try { return localStorage.getItem('wolko-lang') === 'en' ? 'en' : 'ko'; } catch { return 'ko'; } })();
    function t(key, ...args) {
      const v = T[lang][key] ?? T.ko[key] ?? key;
      return typeof v === 'function' ? v(...args) : v;
    }
    const rateText = n => !n ? '' : n.k === 'asof' ? t('rateAsOf', n.d) : n.k === 'biz' ? t('rateBiz', n.d) : t(n.k);
    const LS = { project: 'wolko-expense-project', projects: 'wolko-expense-projects' };

    const $ = id => document.getElementById(id);
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    const usdFmt = n => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const krw = n => '₩' + Math.round(Number(n || 0)).toLocaleString('ko-KR');
    const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
    const lsGet = (k, fb = '') => { try { return localStorage.getItem(k) ?? fb; } catch { return fb; } };
    const lsSet = (k, v) => { try { localStorage.setItem(k, v); } catch {} };
    const fmtDate = iso => iso ? new Date(iso).toLocaleDateString(lang === 'en' ? 'en-US' : 'ko-KR', { year: 'numeric', month: 'short', day: 'numeric' }) : '';

    const token = () => sessionStorage.getItem('wolko-hub-token') || '';
    const hdr = () => ({ 'Content-Type': 'application/json', Authorization: 'Bearer ' + token() });

    let me = null;
    let counts = { mine: 0, approve: 0, accounting: 0 };
    let tab = 'new';
    let data = { mine: [], approve: [], accounting: [], all: [], trash: [] };
    let form = null;
    let acctFilter = 'todo';

    function toast(msg, isError) {
      const el = $('exToast');
      el.textContent = msg;
      el.classList.toggle('error', !!isError);
      el.classList.add('show');
      clearTimeout(toast.t);
      toast.t = setTimeout(() => el.classList.remove('show'), 2800);
    }

    async function api(path, opts = {}) {
      const res = await fetch(path, { ...opts, headers: { ...hdr(), ...(opts.headers || {}) } });
      if (res.status === 401) { sessionStorage.removeItem('wolko-hub-token'); location.replace('/portal'); throw new Error(t('errLogin')); }
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || t('errReq'));
      return body;
    }

    /* ─────────── 폼 상태 ─────────── */
    // 기준 통화는 KRW. USD 항목은 영수 날짜 기준 환율(1 USD = rate KRW)로 환산한다.
    function blankRow(prev) {
      return { account: prev?.account || '', currency: 'KRW', amount: '', rate: '', rateNote: null, item: '', ministryPurpose: '', when: today(), where: '', project: '', receipts: [], more: false };
    }
    function newForm() {
      // 마지막으로 쓴 값이 있으면 그걸, 없으면 로그인한 어카운트 홀더 이름을 기본값으로 채운다
      return { editingId: null, description: '', project: lsGet(LS.project) || me?.name || '', rows: [blankRow()] };
    }
    function formFromReport(r, asCopy) {
      return {
        editingId: asCopy ? null : r.id,
        description: r.description || '',
        project: r.project || '',
        rows: r.rows.map(x => ({
          account: x.account, currency: x.currency || 'KRW', amount: String(x.amount),
          rate: asCopy || !x.rate ? '' : String(x.rate), rateNote: asCopy || !x.rate ? null : { k: 'rateSaved' },
          item: x.item || '', ministryPurpose: x.ministryPurpose, when: asCopy ? today() : (x.when || today()),
          where: x.where || '', project: x.project || '',
          receipts: asCopy ? [] : (x.receipts || []).map(f => ({ ...f })),
          more: !!(x.where || x.project),
        })),
      };
    }
    const isKnownAccount = a => !a || ACCOUNTS.includes(a);

    function rowKrw(r) {
      const amt = Number(r.amount);
      if (!(amt > 0)) return 0;
      if (r.currency === 'KRW') return Math.round(amt);
      const rate = Number(r.rate);
      return rate > 0 ? Math.round(amt * rate) : 0;
    }
    function formTotal() { return form.rows.reduce((s, r) => s + rowKrw(r), 0); }

    /* 영수 날짜 기준 환율 자동 조회 (서버가 주말/휴일은 직전 영업일로 맞춰줌) */
    const rateTimers = new WeakMap();
    function scheduleRate(r, immediate) {
      clearTimeout(rateTimers.get(r));
      if (r.currency !== 'USD' || !r.when) return;
      const run = async () => {
        const wanted = r.when;
        r.rateNote = { k: 'rateLoading' }; paintRates();
        try {
          const out = await api('/api/expense/rate?date=' + encodeURIComponent(wanted));
          if (r.when !== wanted || r.currency !== 'USD') return; // 그 사이 바뀜
          r.rate = String(out.rate);
          r.rateNote = out.source === 'latest' ? { k: 'rateLatest' } : (out.date === wanted ? { k: 'asof', d: wanted.slice(5) } : { k: 'biz', d: out.date.slice(5) });
        } catch (e) { r.rateNote = { k: 'rateFail' }; }
        paintRates(); refreshComputed();
      };
      if (immediate) run(); else rateTimers.set(r, setTimeout(run, 350));
    }

    /* ─────────── 렌더링: 새 리포트 ─────────── */
    function renderTabs() {
      const tabs = [{ id: 'new', label: form?.editingId ? t('tabEdit') : t('tabNew') }, { id: 'mine', label: t('tabMine'), n: counts.mine }];
      if (me.isApprover) tabs.push({ id: 'approve', label: t('tabApprove'), n: counts.approve });
      if (me.isAccountant) tabs.push({ id: 'accounting', label: t('tabAcct'), n: counts.accounting });
      if (me.canViewAll) tabs.push({ id: 'all', label: t('tabAll') });
      $('exTabs').innerHTML = tabs.map(x => `<button class="ex-tab ${x.id === 'new' ? (form?.editingId ? 'ex-tab-new is-edit' : 'ex-tab-new') : ''} ${x.id === tab ? 'active' : ''}" data-tab="${x.id}">${esc(x.label)}${x.n ? `<span class="ex-badge">${x.n}</span>` : ''}</button>`).join('');
    }

    function projectOptions() {
      let list = [];
      try { list = JSON.parse(lsGet(LS.projects, '[]')); } catch {}
      return list.map(p => `<option value="${esc(p)}">`).join('');
    }

    function rowHtml(r, i) {
      const known = isKnownAccount(r.account);
      const sel = known ? r.account : OTHER;
      return `
      <div class="ex-row" data-i="${i}">
        <div class="ex-line ex-l1">
          <span class="ex-num">${i + 1}</span>
          <input class="ex-input ex-w-date" data-f="when" type="date" value="${esc(r.when)}" aria-label="When">
          <select class="ex-select ex-grow" data-f="accountSel" aria-label="Account">
            <option value="">${t('acctPh')}</option>
            ${ACCOUNTS.map(a => `<option value="${esc(a)}" ${sel === a ? 'selected' : ''}>${esc(a)}</option>`).join('')}
            ${known ? '' : `<option value="${OTHER}" selected>${t('acctPrev')}</option>`}
          </select>
          <div class="ex-amount">
            <select class="ex-select" data-f="currency" aria-label="${t('currency')}"><option value="KRW" ${r.currency === 'KRW' ? 'selected' : ''}>₩</option><option value="USD" ${r.currency === 'USD' ? 'selected' : ''}>$</option></select>
            <input class="ex-input" data-f="amount" type="number" inputmode="decimal" min="0" step="any" placeholder="${t('amountPh')}" value="${esc(r.amount)}" aria-label="Amount">
          </div>
          ${form.rows.length > 1 ? `<button class="ex-x" data-act="del-row" data-i="${i}" aria-label="${t('delRow')}">×</button>` : '<span class="ex-x-space"></span>'}
        </div>
        <input class="ex-input" style="margin-top:8px" data-f="accountOther" placeholder="${t('acctOtherPh')}" value="${esc(known ? '' : r.account)}" ${sel === OTHER ? '' : 'hidden'}>
        <div class="ex-line ex-l2">
          <input class="ex-input ex-grow ex-item" data-f="item" placeholder="${t('itemPh')}" value="${esc(r.item)}" maxlength="120">
          <input class="ex-input ex-grow" data-f="ministryPurpose" placeholder="${t('purposePh')}" value="${esc(r.ministryPurpose)}" maxlength="500">
          <label class="ex-btn sm ex-attach" title="${t('attachTitle')}">📎 ${t('attach')}${r.receipts.length ? ' ' + r.receipts.length : ''}<input type="file" data-f="receipt" accept="image/*,application/pdf" multiple hidden></label>
          <button class="ex-btn sm ex-more-btn" data-act="toggle-more" data-i="${i}" aria-expanded="${r.more}">${r.more ? t('less') : '⋯'}</button>
        </div>
        ${r.receipts.length ? `<div class="ex-receipts">${r.receipts.map((f, k) => `<span class="ex-chip"><span class="ex-chip-main" data-act="open-receipt" data-rid="${esc(form.editingId || '')}" data-fid="${esc(f.id)}" data-name="${esc(f.name)}" data-type="${esc(f.type)}">${thumbHtml(f)}${esc(f.name)}</span><button data-act="del-receipt" data-i="${i}" data-k="${k}" aria-label="${t('remove')}">×</button></span>`).join('')}</div>` : ''}
        <div class="ex-rateline" data-rateline ${r.currency === 'USD' ? '' : 'hidden'}></div>
        <div class="ex-more" ${r.more ? '' : 'hidden'}>
          <input class="ex-input" data-f="where" placeholder="${t('wherePh')}" value="${esc(r.where)}">
          <input class="ex-input" data-f="project" placeholder="${t('rowProjPh')}" value="${esc(r.project)}">
        </div>
      </div>`;
    }

    function renderNew() {
      const editing = !!form.editingId;
      $('exView').innerHTML = `
      <div class="ex-card">
        <h2>${editing ? t('titleEdit') : t('titleNew')}</h2>
        <p class="ex-sub">${esc(t('subNew', me.name))}</p>
        <div class="ex-grid">
          <div class="ex-field">
            <label>${t('lblDesc')}</label>
            <input class="ex-input" id="fDesc" value="${esc(form.description)}" placeholder="${t('descPh')}">
          </div>
          <div class="ex-field">
            <label>${t('lblProject')}</label>
            <input class="ex-input" id="fProject" list="fProjectList" value="${esc(form.project)}" placeholder="${t('projPh')}">
            <datalist id="fProjectList">${projectOptions()}</datalist>
