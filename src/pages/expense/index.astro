---
// 경비 리포트(Expense Report) — 포탈 세션으로 접속. 제출 → 승인(master/admin) → 장부 반영(회계 담당)
// No BaseLayout; standalone page (car/wolkoadmin과 동일한 패턴)
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>경비 리포트 — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/expense.css?v=2">
  <meta name="theme-color" content="#004f68">
  <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
  <script is:inline src="/wolko-session.js?v=1"></script>
</head>
<body>
  <header class="ex-header">
    <div class="ex-title"><img src="/images/WOLKO Circle.png" alt="WOLKO">Expense Report</div>
    <div style="display:flex;align-items:center;gap:16px;">
      <span class="ex-user" id="exUser"></span>
      <a href="/portal">← 포탈</a>
    </div>
  </header>

  <main class="ex-wrap">
    <nav class="ex-tabs" id="exTabs"></nav>
    <section id="exView"></section>
  </main>
  <div class="ex-toast" id="exToast"></div>

  <script is:inline>
    /* ── 계정과목(Account) 목록 — 관리 번호 포함. 추가/변경은 여기서만 하면 됨 ── */
    const ACCOUNTS = [
      'WOLKO (8021)', 'Car Gas (8400)', 'Car Maintenance (8500)', 'Car Tax (8320)',
      'Junior Camp (8040)', 'Ministry Center Expense (8289)', 'Student Ministries (8042)',
      'SYME Equipment (8395)', 'SYME Program Event (8974)', 'SYME Food (8968)',
      'Missionary Account (8025)', 'Teacher (8052)', 'Pyeongtaek EM (8067)', 'Other/Unknown',
    ];
    const OTHER = '__other';
    const STATUS_LABEL = { submitted: '승인 대기', approved: '승인됨 · 장부 대기', processed: '장부 반영 완료', rejected: '반려됨' };
    const LS = { project: 'wolko-expense-project', projects: 'wolko-expense-projects' };

    const $ = id => document.getElementById(id);
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    const usdFmt = n => '$' + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const krw = n => '₩' + Math.round(Number(n || 0)).toLocaleString('ko-KR');
    const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
    const lsGet = (k, fb = '') => { try { return localStorage.getItem(k) ?? fb; } catch { return fb; } };
    const lsSet = (k, v) => { try { localStorage.setItem(k, v); } catch {} };
    const fmtDate = iso => iso ? new Date(iso).toLocaleDateString('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' }) : '';

    const token = () => sessionStorage.getItem('wolko-hub-token') || '';
    const hdr = () => ({ 'Content-Type': 'application/json', Authorization: 'Bearer ' + token() });

    let me = null;
    let counts = { mine: 0, approve: 0, accounting: 0 };
    let tab = 'new';
    let data = { mine: [], approve: [], accounting: [] };
    let form = null;
    let acctFilter = 'todo';

    function toast(msg, isError) {
      const el = $('exToast');
      el.textContent = msg;
      el.classList.toggle('error', !!isError);
      el.classList.add('show');
      clearTimeout(toast.t);
      toast.t = setTimeout(() => el.classList.remove('show'), 2800);
    }

    async function api(path, opts = {}) {
      const res = await fetch(path, { ...opts, headers: { ...hdr(), ...(opts.headers || {}) } });
      if (res.status === 401) { sessionStorage.removeItem('wolko-hub-token'); location.replace('/portal'); throw new Error('로그인이 필요합니다.'); }
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || '요청에 실패했습니다.');
      return body;
    }

    /* ─────────── 폼 상태 ─────────── */
    // 기준 통화는 KRW. USD 항목은 영수 날짜 기준 환율(1 USD = rate KRW)로 환산한다.
    function blankRow(prev) {
      return { account: prev?.account || '', currency: 'KRW', amount: '', rate: '', rateNote: '', ministryPurpose: '', when: today(), where: '', project: '', receipts: [], more: false };
    }
    function newForm() {
      return { editingId: null, description: '', project: lsGet(LS.project), rows: [blankRow()] };
    }
    function formFromReport(r, asCopy) {
      return {
        editingId: asCopy ? null : r.id,
        description: r.description || '',
        project: r.project || '',
        rows: r.rows.map(x => ({
          account: x.account, currency: x.currency || 'KRW', amount: String(x.amount),
          rate: asCopy || !x.rate ? '' : String(x.rate), rateNote: asCopy || !x.rate ? '' : '저장된 환율',
          ministryPurpose: x.ministryPurpose, when: asCopy ? today() : (x.when || today()),
          where: x.where || '', project: x.project || '',
          receipts: asCopy ? [] : (x.receipts || []).map(f => ({ ...f })),
          more: !!(x.where || x.project),
        })),
      };
    }
    const isKnownAccount = a => !a || ACCOUNTS.includes(a);

    function rowKrw(r) {
      const amt = Number(r.amount);
      if (!(amt > 0)) return 0;
      if (r.currency === 'KRW') return Math.round(amt);
      const rate = Number(r.rate);
      return rate > 0 ? Math.round(amt * rate) : 0;
    }
    function formTotal() { return form.rows.reduce((s, r) => s + rowKrw(r), 0); }

    /* 영수 날짜 기준 환율 자동 조회 (서버가 주말/휴일은 직전 영업일로 맞춰줌) */
    const rateTimers = new WeakMap();
    function scheduleRate(r, immediate) {
      clearTimeout(rateTimers.get(r));
      if (r.currency !== 'USD' || !r.when) return;
      const run = async () => {
        const wanted = r.when;
        r.rateNote = '환율 조회 중…'; paintRates();
        try {
          const out = await api('/api/expense/rate?date=' + encodeURIComponent(wanted));
          if (r.when !== wanted || r.currency !== 'USD') return; // 그 사이 바뀜
          r.rate = String(out.rate);
          r.rateNote = out.source === 'latest' ? '최신 환율' : (out.date === wanted ? wanted.slice(5) + ' 기준' : out.date.slice(5) + ' 기준(영업일)');
        } catch (e) { r.rateNote = '자동 조회 실패 — 직접 입력'; }
        paintRates(); refreshComputed();
      };
      if (immediate) run(); else rateTimers.set(r, setTimeout(run, 350));
    }

    /* ─────────── 렌더링: 새 리포트 ─────────── */
    function renderTabs() {
      const tabs = [{ id: 'new', label: form?.editingId ? '리포트 수정' : '새 리포트' }, { id: 'mine', label: '내 리포트', n: counts.mine }];
      if (me.isApprover) tabs.push({ id: 'approve', label: '승인 대기', n: counts.approve });
      if (me.isAccountant) tabs.push({ id: 'accounting', label: '회계 장부', n: counts.accounting });
      if (me.role === 'master') tabs.push({ id: 'staff', label: '회계 담당 지정' });
      $('exTabs').innerHTML = tabs.map(t => `<button class="ex-tab ${t.id === tab ? 'active' : ''}" data-tab="${t.id}">${esc(t.label)}${t.n ? `<span class="ex-badge">${t.n}</span>` : ''}</button>`).join('');
    }

    function projectOptions() {
      let list = [];
      try { list = JSON.parse(lsGet(LS.projects, '[]')); } catch {}
      return list.map(p => `<option value="${esc(p)}">`).join('');
    }

    function rowHtml(r, i) {
      const known = isKnownAccount(r.account);
      const sel = known ? r.account : OTHER;
      return `
      <div class="ex-row" data-i="${i}">
        <div class="ex-line">
          <span class="ex-num">${i + 1}</span>
          <input class="ex-input ex-w-date" data-f="when" type="date" value="${esc(r.when)}" aria-label="When">
          <select class="ex-select ex-grow" data-f="accountSel" aria-label="Account">
            <option value="">Account · 계정과목</option>
            ${ACCOUNTS.map(a => `<option value="${esc(a)}" ${sel === a ? 'selected' : ''}>${esc(a)}</option>`).join('')}
            ${known ? '' : `<option value="${OTHER}" selected>이전 계정과목 (직접 입력)</option>`}
          </select>
          <div class="ex-amount">
            <select class="ex-select" data-f="currency" aria-label="통화"><option value="KRW" ${r.currency === 'KRW' ? 'selected' : ''}>₩</option><option value="USD" ${r.currency === 'USD' ? 'selected' : ''}>$</option></select>
            <input class="ex-input" data-f="amount" type="number" inputmode="decimal" min="0" step="any" placeholder="금액" value="${esc(r.amount)}" aria-label="Amount">
          </div>
          ${form.rows.length > 1 ? `<button class="ex-x" data-act="del-row" data-i="${i}" aria-label="항목 삭제">×</button>` : '<span class="ex-x-space"></span>'}
        </div>
        <input class="ex-input" style="margin-top:8px" data-f="accountOther" placeholder="계정과목 직접 입력 (예: Supplies (5250))" value="${esc(known ? '' : r.account)}" ${sel === OTHER ? '' : 'hidden'}>
        <div class="ex-line" style="margin-top:8px">
          <input class="ex-input ex-grow" data-f="ministryPurpose" placeholder="Ministry Purpose · 사역 목적" value="${esc(r.ministryPurpose)}" maxlength="500">
          <label class="ex-btn sm ex-attach" title="영수증 첨부">📎 영수증${r.receipts.length ? ' ' + r.receipts.length : ''}<input type="file" data-f="receipt" accept="image/*,application/pdf" multiple hidden></label>
          <button class="ex-btn sm ex-more-btn" data-act="toggle-more" data-i="${i}" aria-expanded="${r.more}">${r.more ? '접기' : '⋯'}</button>
        </div>
        ${r.receipts.length ? `<div class="ex-receipts">${r.receipts.map((f, k) => `<span class="ex-chip">${esc(f.name)}<button data-act="del-receipt" data-i="${i}" data-k="${k}" aria-label="삭제">×</button></span>`).join('')}</div>` : ''}
        <div class="ex-rateline" data-rateline ${r.currency === 'USD' ? '' : 'hidden'}></div>
        <div class="ex-more" ${r.more ? '' : 'hidden'}>
          <input class="ex-input" data-f="where" placeholder="Where · 장소 (선택)" value="${esc(r.where)}">
          <input class="ex-input" data-f="project" placeholder="이 항목만 다른 Project (선택)" value="${esc(r.project)}">
        </div>
      </div>`;
    }

    function renderNew() {
      const editing = !!form.editingId;
      $('exView').innerHTML = `
      <div class="ex-card">
        <h2>${editing ? '경비 리포트 수정' : '새 경비 리포트'}</h2>
        <p class="ex-sub">${esc(me.name)} 님 명의로 제출됩니다. 기준 통화는 원화(₩)이고, 달러($) 항목은 영수 날짜 환율로 자동 환산돼요.</p>
        <div class="ex-grid">
          <div class="ex-field">
            <label>Description<span class="ko">설명</span></label>
            <input class="ex-input" id="fDesc" value="${esc(form.description)}" placeholder="예: 9월 캠프 준비 경비">
          </div>
          <div class="ex-field">
            <label>Project<span class="ko">프로젝트 (마지막 값 기억)</span></label>
            <input class="ex-input" id="fProject" list="fProjectList" value="${esc(form.project)}" placeholder="예: 1552044602 - Kim, Hwan Kyu">
            <datalist id="fProjectList">${projectOptions()}</datalist>
          </div>
        </div>
        <div class="ex-rows" id="fRows">${form.rows.map(rowHtml).join('')}</div>
        <div style="margin-top:12px"><button class="ex-btn" data-act="add-row">＋ 항목 추가</button></div>
        <div class="ex-total-bar">
          <div class="ex-total" id="fTotal"></div>
          <div class="ex-actions" style="margin:0">
            ${editing ? '<button class="ex-btn" data-act="cancel-edit">수정 취소</button>' : ''}
            <button class="ex-btn primary" id="fSubmit" data-act="submit">${editing ? '수정 후 다시 제출' : '경비 리포트 제출'}</button>
          </div>
        </div>
      </div>`;
      form.rows.forEach(r => { if (r.currency === 'USD' && !Number(r.rate)) scheduleRate(r, true); });
      paintRates(); refreshComputed();
    }

    /* USD 줄의 환율 안내줄: "$25.00 × [1355.05] = ₩33,876 · 09-25 기준" */
    function paintRates() {
      document.querySelectorAll('.ex-row').forEach(el => {
        const r = form.rows[+el.dataset.i], line = el.querySelector('[data-rateline]');
        if (!r || !line) return;
        line.hidden = r.currency !== 'USD';
        if (r.currency !== 'USD') return;
        if (!line.dataset.ready) {
          line.innerHTML = '<span data-r-usd></span> × <input class="ex-rate-input" data-f="rate" type="number" inputmode="decimal" step="any" min="0" aria-label="환율"> = <b data-r-krw></b><span class="ex-rate-note" data-r-note></span>';
          line.dataset.ready = '1';
        }
        line.querySelector('[data-r-usd]').textContent = usdFmt(Number(r.amount) || 0);
        const inp = line.querySelector('[data-f="rate"]');
        if (document.activeElement !== inp) inp.value = r.rate;
        line.querySelector('[data-r-krw]').textContent = krw(rowKrw(r));
        line.querySelector('[data-r-note]').textContent = r.rateNote ? ' · ' + r.rateNote : '';
      });
    }

    function refreshComputed() {
      paintRates();
      const t = $('fTotal');
      if (t) t.innerHTML = '<small>합계 (KRW)</small>' + krw(formTotal());
    }

    /* ─────────── 렌더링: 리포트 카드 ─────────── */
    function projectOf(rep, row) { return row.project || rep.project || ''; }

    function receiptChips(rep, row) {
      return (row.receipts || []).map(f => `<span class="ex-chip link" data-act="open-receipt" data-rid="${esc(rep.id)}" data-fid="${esc(f.id)}">📎 ${esc(f.name)}</span>`).join('');
    }

    function reportCard(rep, mode) {
      const rows = rep.rows.map(r => `
        <tr>
          <td>${esc(r.when || '')}</td>
          <td>${esc(r.account)}${projectOf(rep, r) ? `<div class="ex-meta">${esc(projectOf(rep, r))}</div>` : ''}</td>
          <td>${esc(r.ministryPurpose)}${r.where ? `<div class="ex-meta">📍 ${esc(r.where)}</div>` : ''}<div class="ex-receipts" style="margin-top:6px">${receiptChips(rep, r)}</div></td>
          <td class="r">${krw(r.amountKrw)}${r.currency === 'USD' ? `<div class="ex-meta">${usdFmt(r.amount)} × ${Number(r.rate).toLocaleString('ko-KR')}</div>` : ''}</td>
        </tr>`).join('');

      let notes = '';
      if (rep.status === 'rejected') notes = `<div class="ex-note reject"><b>반려 사유</b> — ${esc(rep.reviewNote)} <span class="ex-meta">(${esc(rep.reviewedByName || '')} · ${fmtDate(rep.reviewedAt)})</span></div>`;
      else if (rep.status === 'approved') notes = `<div class="ex-note ok">${esc(rep.reviewedByName || '')} 님이 ${fmtDate(rep.reviewedAt)}에 승인했습니다.${rep.reviewNote ? ' — ' + esc(rep.reviewNote) : ''}</div>`;
      else if (rep.status === 'processed') notes = `<div class="ex-note ok">${fmtDate(rep.processedAt)} 장부 반영 완료 (${esc(rep.processedByName || '')})${rep.processNote ? ' — ' + esc(rep.processNote) : ''}</div>`;

      let actions = '';
      if (mode === 'mine') {
        if (rep.status === 'rejected') actions += `<button class="ex-btn primary sm" data-act="edit" data-id="${esc(rep.id)}">수정 후 재제출</button>`;
        if (rep.status === 'submitted') actions += `<button class="ex-btn sm" data-act="edit" data-id="${esc(rep.id)}">수정</button>`;
        if (rep.status === 'submitted' || rep.status === 'rejected') actions += `<button class="ex-btn sm danger" data-act="withdraw" data-id="${esc(rep.id)}">철회</button>`;
        actions += `<button class="ex-btn sm" data-act="copy" data-id="${esc(rep.id)}">복사해서 새로 작성</button>`;
      } else if (mode === 'approve' && rep.status === 'submitted') {
        actions = `<button class="ex-btn green sm" data-act="approve" data-id="${esc(rep.id)}">승인</button><button class="ex-btn danger sm" data-act="reject" data-id="${esc(rep.id)}">반려</button>`;
      } else if (mode === 'accounting' && rep.status === 'approved') {
        actions = `<button class="ex-btn green sm" data-act="process" data-id="${esc(rep.id)}">장부 반영 완료 처리</button>`;
      }

      return `
      <article class="ex-card">
        <div class="ex-report-head">
          <div>
            <div class="ex-report-title">${esc(rep.description || '(설명 없음)')}</div>
            <div class="ex-meta">${mode === 'mine' ? '' : esc(rep.submitterName) + ' · '}${fmtDate(rep.submittedAt)} 제출${rep.project ? ' · ' + esc(rep.project) : ''}</div>
          </div>
          <div>
            <div class="ex-report-total">${krw(rep.total)}</div>
            <span class="ex-status ${rep.status}">${STATUS_LABEL[rep.status]}</span>
          </div>
        </div>
        <div class="ex-table-wrap"><table class="ex-table">
          <thead><tr><th>When</th><th>Account</th><th>Ministry Purpose</th><th style="text-align:right">Amount</th></tr></thead>
          <tbody>${rows}</tbody>
        </table></div>
        ${notes}
        ${actions ? `<div class="ex-actions">${actions}</div>` : ''}
      </article>`;
    }

    function renderList(mode) {
      let list = data[mode];
      if (mode === 'approve') {
        const pending = list.filter(r => r.status === 'submitted');
        const done = list.filter(r => r.status !== 'submitted');
        $('exView').innerHTML =
          (pending.length ? pending.map(r => reportCard(r, mode)).join('') : '<div class="ex-empty">승인 대기 중인 리포트가 없습니다 ✓</div>') +
          (done.length ? `<p class="ex-sub" style="margin:22px 0 10px">최근 처리한 리포트</p>` + done.map(r => reportCard(r, mode)).join('') : '');
        return;
      }
      if (mode === 'accounting') {
        const shown = list.filter(r => acctFilter === 'all' || (acctFilter === 'todo' ? r.status === 'approved' : r.status === 'processed'));
        const byAcct = {};
        shown.forEach(r => r.rows.forEach(x => { byAcct[x.account] = (byAcct[x.account] || 0) + x.amountKrw; }));
        const sum = shown.reduce((s, r) => s + r.total, 0);
        $('exView').innerHTML = `
          <div class="ex-card">
            <div class="ex-filter">
              <button class="ex-tab ${acctFilter === 'todo' ? 'active' : ''}" data-filter="todo">장부 대기</button>
              <button class="ex-tab ${acctFilter === 'done' ? 'active' : ''}" data-filter="done">반영 완료</button>
              <button class="ex-tab ${acctFilter === 'all' ? 'active' : ''}" data-filter="all">전체</button>
              <span style="flex:1"></span>
              <button class="ex-btn sm" data-act="csv" ${shown.length ? '' : 'disabled'}>CSV 내보내기</button>
            </div>
            <div><b>${shown.length}건 · ${krw(sum)}</b></div>
            <div class="ex-summary">${Object.entries(byAcct).sort((a, b) => b[1] - a[1]).map(([k, v]) => `<span class="ex-sum-chip">${esc(k)} <b>${krw(v)}</b></span>`).join('')}</div>
          </div>
          ${shown.length ? shown.map(r => reportCard(r, mode)).join('') : '<div class="ex-empty">해당하는 리포트가 없습니다.</div>'}`;
        return;
      }
      $('exView').innerHTML = list.length ? list.map(r => reportCard(r, mode)).join('') : '<div class="ex-empty">아직 제출한 리포트가 없습니다.</div>';
    }

    async function renderStaff() {
      $('exView').innerHTML = '<div class="ex-empty">불러오는 중…</div>';
      try {
        const { accounts } = await api('/api/hub/accountant');
        $('exView').innerHTML = `
          <div class="ex-card">
            <h2>회계 담당 지정</h2>
            <p class="ex-sub">회계 담당자로 지정된 계정은 승인된 경비 리포트를 열람하고 장부 반영 처리를 할 수 있으며, 경비가 승인될 때마다 알림 메일을 받습니다.</p>
            ${accounts.length ? accounts.map(a => `
              <div class="ex-toggle-row">
                <div><b>${esc(a.name || a.email)}</b><div class="ex-meta">${esc(a.email)} · ${a.role === 'admin' ? '관리자' : '상담사'}</div></div>
                <button class="ex-btn sm ${a.isAccountant ? 'green' : ''}" data-act="toggle-acct" data-email="${esc(a.email)}" data-on="${a.isAccountant ? 1 : 0}">${a.isAccountant ? '회계 담당 ✓' : '지정'}</button>
              </div>`).join('') : '<div class="ex-empty">승인된 계정이 없습니다.</div>'}
          </div>`;
      } catch (e) { toast(e.message, true); }
    }

    /* ─────────── 데이터 로딩 / 화면 전환 ─────────── */
    async function refreshCounts() {
      const c = await api('/api/expense/reports?scope=counts');
      me = c.me; counts = { mine: c.mine, approve: c.approve, accounting: c.accounting };
      $('exUser').textContent = me.name + (me.isAccountant ? ' · 회계' : '');
    }
    async function load(scope) {
      const r = await api('/api/expense/reports?scope=' + scope);
      data[scope] = r.reports;
    }
    async function show(next) {
      tab = next;
      try {
        await refreshCounts();
        if (tab === 'mine') await load('mine');
        if (tab === 'approve') await load('approve');
        if (tab === 'accounting') await load('accounting');
      } catch (e) { toast(e.message, true); }
      renderTabs();
      if (tab === 'new') renderNew();
      else if (tab === 'staff') renderStaff();
      else renderList(tab);
      window.scrollTo({ top: 0 });
    }

    /* ─────────── 영수증 업로드 (이미지는 줄여서 올림) ─────────── */
    function shrinkImage(file) {
      return new Promise(resolve => {
        if (!file.type.startsWith('image/') || file.type === 'image/heic') return resolve(file);
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
          const max = 1600, scale = Math.min(1, max / Math.max(img.width, img.height));
          const c = document.createElement('canvas');
          c.width = Math.round(img.width * scale); c.height = Math.round(img.height * scale);
          c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
          c.toBlob(b => { URL.revokeObjectURL(url); resolve(b ? new File([b], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' }) : file); }, 'image/jpeg', 0.82);
        };
        img.onerror = () => { URL.revokeObjectURL(url); resolve(file); };
        img.src = url;
      });
    }
    const toDataUrl = file => new Promise((res, rej) => { const fr = new FileReader(); fr.onload = () => res(fr.result); fr.onerror = rej; fr.readAsDataURL(file); });

    async function uploadReceipts(i, files) {
      const row = form.rows[i];
      for (const original of files) {
        if (row.receipts.length >= 5) { toast('항목당 영수증은 최대 5개까지 첨부할 수 있어요.', true); break; }
        try {
          toast('영수증 업로드 중…');
          const file = await shrinkImage(original);
          const data = await toDataUrl(file);
          const out = await api('/api/expense/receipt', { method: 'POST', body: JSON.stringify({ name: file.name, type: file.type, data }) });
          row.receipts.push({ id: out.id, name: out.name, type: out.type });
        } catch (e) { toast(e.message, true); }
      }
      const rowsEl = $('fRows'); const scroll = window.scrollY;
      rowsEl.innerHTML = form.rows.map(rowHtml).join('');
      refreshComputed(); window.scrollTo({ top: scroll });
      toast('영수증이 첨부되었습니다.');
    }

    async function openReceipt(reportId, fileId) {
      const w = window.open('', '_blank');
      try {
        const res = await fetch(`/api/expense/receipt?reportId=${encodeURIComponent(reportId)}&fileId=${encodeURIComponent(fileId)}`, { headers: { Authorization: 'Bearer ' + token() } });
        if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || '영수증을 열 수 없습니다.');
        const url = URL.createObjectURL(await res.blob());
        if (w) w.location = url; else location.href = url;
      } catch (e) { if (w) w.close(); toast(e.message, true); }
    }

    /* ─────────── 제출 ─────────── */
    async function submitForm() {
      const btn = $('fSubmit'); btn.disabled = true;
      try {
        const payload = {
          id: form.editingId, description: form.description.trim(), project: form.project.trim(),
          rows: form.rows.map(r => ({ ...r, amount: Number(r.amount), rate: Number(r.rate) || 0 })),
        };
        await api('/api/expense/reports', { method: form.editingId ? 'PUT' : 'POST', body: JSON.stringify(payload) });
        if (form.project.trim()) {
          lsSet(LS.project, form.project.trim());
          let list = []; try { list = JSON.parse(lsGet(LS.projects, '[]')); } catch {}
          lsSet(LS.projects, JSON.stringify([form.project.trim(), ...list.filter(p => p !== form.project.trim())].slice(0, 8)));
        }
        toast(form.editingId ? '수정되어 다시 제출되었습니다.' : '제출되었습니다. 관리자에게 알림이 전송됩니다.');
        form = newForm();
        await show('mine');
      } catch (e) { toast(e.message, true); btn.disabled = false; }
    }

    /* ─────────── CSV ─────────── */
    function exportCsv() {
      const shown = data.accounting.filter(r => acctFilter === 'all' || (acctFilter === 'todo' ? r.status === 'approved' : r.status === 'processed'));
      const head = ['Report ID', 'Status', 'Submitted', 'Submitter', 'Project', 'Date', 'Account', 'Ministry Purpose', 'Where', 'Currency', 'Original Amount', 'Exchange Rate (KRW/USD)', 'KRW Amount'];
      const lines = [head];
      shown.forEach(r => r.rows.forEach(x => lines.push([r.id, STATUS_LABEL[r.status], r.submittedAt.slice(0, 10), r.submitterName, x.project || r.project || '', x.when, x.account, x.ministryPurpose, x.where, x.currency, x.amount, x.rate || '', x.amountKrw])));
      const csv = '﻿' + lines.map(l => l.map(v => `"${String(v ?? '').replace(/"/g, '""')}"`).join(',')).join('\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      a.download = `WOLKO_expense_${today()}.csv`; a.click();
    }

    /* ─────────── 이벤트 ─────────── */
    document.addEventListener('click', async e => {
      const tabBtn = e.target.closest('[data-tab]');
      if (tabBtn) { if (tabBtn.dataset.tab === 'new' && !form) form = newForm(); return show(tabBtn.dataset.tab); }
      const f = e.target.closest('[data-filter]');
      if (f) { acctFilter = f.dataset.filter; return renderList('accounting'); }

      const el = e.target.closest('[data-act]');
      if (!el) return;
      const act = el.dataset.act, i = +el.dataset.i, id = el.dataset.id;
      const find = mode => data[mode].find(r => r.id === id);

      try {
        if (act === 'add-row') { form.rows.push(blankRow(form.rows[form.rows.length - 1])); renderNew(); }
        else if (act === 'del-row') { form.rows.splice(i, 1); renderNew(); }
        else if (act === 'toggle-more') { form.rows[i].more = !form.rows[i].more; $('fRows').innerHTML = form.rows.map(rowHtml).join(''); refreshComputed(); }
        else if (act === 'del-receipt') {
          form.rows[i].receipts.splice(+el.dataset.k, 1);
          $('fRows').innerHTML = form.rows.map(rowHtml).join(''); refreshComputed();
        }
        else if (act === 'submit') await submitForm();
        else if (act === 'cancel-edit') { form = newForm(); renderTabs(); renderNew(); }
        else if (act === 'open-receipt') await openReceipt(el.dataset.rid, el.dataset.fid);
        else if (act === 'edit') { form = formFromReport(find('mine'), false); tab = 'new'; renderTabs(); renderNew(); window.scrollTo({ top: 0 }); }
        else if (act === 'copy') { form = formFromReport(find('mine'), true); tab = 'new'; renderTabs(); renderNew(); window.scrollTo({ top: 0 }); toast('지난 리포트를 복사했어요. 금액·날짜를 확인해 주세요.'); }
        else if (act === 'withdraw') {
          if (!confirm('이 리포트를 철회(삭제)할까요?')) return;
          await api('/api/expense/reports?id=' + encodeURIComponent(id), { method: 'DELETE' });
          toast('철회되었습니다.'); await show('mine');
        }
        else if (act === 'approve') { await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'approve' }) }); toast('승인했습니다. 회계 담당자에게 알림이 전송됩니다.'); await show('approve'); }
        else if (act === 'reject') {
          const note = prompt('반려 사유를 입력해 주세요.'); if (note === null) return;
          await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'reject', note }) }); toast('반려했습니다.'); await show('approve');
        }
        else if (act === 'process') {
          if (!confirm('장부에 반영을 마쳤나요? "반영 완료"로 처리합니다.')) return;
          await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'process' }) }); toast('장부 반영 완료로 처리했습니다.'); await show('accounting');
        }
        else if (act === 'csv') exportCsv();
        else if (act === 'toggle-acct') {
          await api('/api/hub/accountant', { method: 'POST', body: JSON.stringify({ email: el.dataset.email, isAccountant: el.dataset.on !== '1' }) });
          await renderStaff();
        }
      } catch (err) { toast(err.message, true); }
    });

    document.addEventListener('input', e => {
      const t = e.target;
      if (t.id === 'fDesc') form.description = t.value;
      else if (t.id === 'fProject') form.project = t.value;
      else if (t.dataset.f) {
        const rowEl = t.closest('.ex-row'); if (!rowEl) return;
        const r = form.rows[+rowEl.dataset.i], f = t.dataset.f;
        if (f === 'accountSel') {
          const other = rowEl.querySelector('[data-f="accountOther"]');
          if (t.value === OTHER) { other.hidden = false; other.focus(); r.account = other.value.trim(); }
          else { other.hidden = true; r.account = t.value; }
        }
        else if (f === 'accountOther') r.account = t.value.trim();
        else if (f === 'receipt') { uploadReceipts(+rowEl.dataset.i, [...t.files]); t.value = ''; }
        else if (f === 'currency') { r.currency = t.value; if (r.currency === 'USD') { r.rate = ''; scheduleRate(r, true); } else r.rateNote = ''; refreshComputed(); }
        else if (f === 'when') { r.when = t.value; if (r.currency === 'USD') { r.rate = ''; scheduleRate(r); } }
        else if (f === 'rate') { r.rate = t.value; r.rateNote = '직접 입력'; const n = rowEl.querySelector('[data-r-note]'); if (n) n.textContent = ' · 직접 입력'; refreshComputed(); }
        else { r[f] = t.value; refreshComputed(); }
      }
    });

    /* ─────────── 시작 ─────────── */
    (async function init() {
      if (!token()) return location.replace('/portal');
      try {
        await refreshCounts();
        form = newForm();
        await show(counts.approve > 0 && me.isApprover ? 'approve' : (counts.accounting > 0 && me.isAccountant ? 'accounting' : 'new'));
      } catch (e) { toast(e.message, true); }
    })();
  </script>
</body>
</html>
