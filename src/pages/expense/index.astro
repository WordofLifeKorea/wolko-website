---
import { ACCOUNTS as CFG_ACCOUNTS, CAMPUSES as CFG_CAMPUSES } from '../../lib/expense-config.js';
// 경비 리포트(Expense Report) — 포탈 세션으로 접속. 제출 → 승인·카테고리 확정(관리자) → 송금 처리(회계 담당)
// No BaseLayout; standalone page (car/wolkoadmin과 동일한 패턴)
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>경비 리포트 — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/expense.css?v=34">
  <link rel="stylesheet" href="/wolko-lang-toggle.css?v=2">
  <link rel="stylesheet" href="/wolko-rail.css?v=12">
  <script src="/wolko-rail.js?v=14" defer></script>
  <meta name="theme-color" content="#004f68">
  <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
  <script is:inline src="/wolko-session.js?v=1"></script>
</head>
<body>
  <header class="ex-header">
    <a class="ex-title" href="/portal" title="WOLKO Portal" aria-label="WOLKO Portal"><img src="/images/WOLKO Circle.png" alt="WOLKO">Expense Report</a>
    <div style="display:flex;align-items:center;gap:16px;">
      <span class="ex-user" id="exUser"></span>
      <div class="wl-lang-toggle" role="group" aria-label="Language">
        <button type="button" class="wl-lang-btn" id="langKoBtn" data-lang="ko" aria-label="한국어" title="한국어"><img src="https://flagcdn.com/w20/kr.png" alt=""><span>KO</span></button>
        <button type="button" class="wl-lang-btn" id="langEnBtn" data-lang="en" aria-label="English" title="English"><img src="https://flagcdn.com/w20/us.png" alt=""><span>EN</span></button>
      </div>
    </div>
  </header>

  <main class="ex-wrap">
    <nav class="ex-tabs" id="exTabs"></nav>
    <section id="exView"></section>
  </main>
  <div class="ex-toast" id="exToast"></div>

  <script type="application/json" id="exCfg" set:html={JSON.stringify({ ACCOUNTS: CFG_ACCOUNTS, CAMPUSES: CFG_CAMPUSES })}></script>
  <script is:inline>
    /* ── 계정과목/캠퍼스는 src/lib/expense-config.js 에서 서버와 공유 ── */
    const CFG = JSON.parse(document.getElementById('exCfg').textContent);
    const CAMPUSES = CFG.CAMPUSES;
    const APPROVAL_ACCOUNTS = CFG.ACCOUNTS;                                 // 승인자가 확정할 수 있는 전체 목록(Other/Unknown 포함)
    /* ── 번역 사전 (한국어/English). 화면 문구는 전부 여기서만 관리 ── */
