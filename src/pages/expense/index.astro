        campus_wolko: 'Pyeongtaek', campus_jeju: 'Jeju', btnTrashAll: 'Delete all', cTrashAll: 'This deletes ALL current reports.\n(They are backed up and can be restored one by one from "Deleted")\n\nType DELETE to continue.', tTrashAll: n => n + ' report(s) deleted.',
        catConfirm: 'Confirm', catDone: '✓ Confirmed', catConfirmAll: 'Confirm all categories', catPick: 'Select category',
        catNeed: 'Confirm the category of every item before approving.', catDelegate: 'Delegate categories to accounting', catAuto: '✓ Delegated', catDelegated: '✓ Delegated to accounting (cancel)', catDelegateNote: 'Items you have not confirmed are confirmed automatically, and only their category | code is delegated to accounting.', delegatedWait: 'Pick and save the category | code for the items the approver did not confirm before marking payment done.', catNeedAll: 'Pick a category for every item.',
        catHint: 'Pick a category for every item and press Confirm before approving. Items with a memo must be confirmed.',
        catSubmitted: a => 'Submitted as: ' + a,
        gN: n => n + (n === 1 ? ' report' : ' reports'), gPeople: n => n + (n === 1 ? ' person' : ' people'), gEmpty: 'No reports to show.', gItems: n => n + (n === 1 ? ' item' : ' items'),
        errLogin: 'Please sign in.', errReq: 'Request failed.',
      },
    };
    let lang = (() => { try { return localStorage.getItem('wolko-lang') === 'en' ? 'en' : 'ko'; } catch { return 'ko'; } })();
    function t(key, ...args) {
      const v = T[lang][key] ?? T.ko[key] ?? key;
      return typeof v === 'function' ? v(...args) : v;
    }
    const rateText = n => !n ? '' : n.k === 'asof' ? t('rateAsOf', n.d) : n.k === 'biz' ? t('rateBiz', n.d) : t(n.k);
    const LS = { draft: 'wolko-expense-draft:', project: 'wolko-expense-project', projects: 'wolko-expense-projects', sources: 'wolko-expense-sources' };
    const DEFAULT_SOURCE = ''; // 처음엔 안내 문구가 떠 있고, 작성자가 고른다
    const SRC_PRESETS = ['개인 사역계좌', '월코']; // 나머지는 '직접 입력'
    const SRC_CUSTOM = '__custom';
    const srcShow = v => v === '개인 사역계좌' ? t('srcPersonal') : v === '월코' ? t('srcWolko') : v;
    const srcIsCustom = r => !!r.srcCustom || (!!r.source && !SRC_PRESETS.includes(r.source));
    const SRC_EXAMPLES_KO = ['월코캠', '개인 사역계좌', '월코 계좌', 'Student Ministry', 'SF1', 'Vietnam Camp'];
    const SRC_EXAMPLES_EN = ['WOLKO Camp', 'Personal ministry account', 'WOLKO account', 'Student Ministry', 'SF1', 'Vietnam Camp'];

    const $ = id => document.getElementById(id);
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    // 외화 금액 표기: $25.00 · C$25.00 · ₫1,250,000
    const fxFmt = (c, n) => FX[c].symbol + Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: FX[c].digits, maximumFractionDigits: FX[c].digits });
    const rateFmt = n => Number(n).toLocaleString('ko-KR', { maximumFractionDigits: 4 });
    const krw = n => '₩' + Math.round(Number(n || 0)).toLocaleString('ko-KR');
    const today = () => { const d = new Date(); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
    const lsGet = (k, fb = '') => { try { return localStorage.getItem(k) ?? fb; } catch { return fb; } };
    const lsSet = (k, v) => { try { localStorage.setItem(k, v); } catch {} };
    const fmtDate = iso => iso ? new Date(iso).toLocaleDateString(lang === 'en' ? 'en-US' : 'ko-KR', { year: 'numeric', month: 'short', day: 'numeric' }) : '';

    const token = () => sessionStorage.getItem('wolko-hub-token') || '';
    const hdr = () => ({ 'Content-Type': 'application/json', Authorization: 'Bearer ' + token() });

    let me = null;
    let counts = { mine: 0, approve: 0, accounting: 0, alerts: [] };
    const SEEN_KEY = 'wolko-expense-seen';
    const seenAt = () => { try { return Number(localStorage.getItem(SEEN_KEY)) || 0; } catch (e) { return 0; } };
    const markSeen = () => { try { localStorage.setItem(SEEN_KEY, String(Date.now())); } catch (e) {} };
    const unseenAlerts = () => (counts.alerts || []).filter(a => new Date(a.at).getTime() > seenAt()).length;
    let tab = 'new';
    let data = { mine: [], approve: [], accounting: [], all: [], trash: [] };
    let form = null;
    let acctFilter = 'todo';

    function toast(msg, isError) {
      const el = $('exToast');
      el.textContent = msg;
      el.classList.toggle('error', !!isError);
      el.classList.add('show');
      clearTimeout(toast.t);
      toast.t = setTimeout(() => el.classList.remove('show'), 2800);
    }

    async function api(path, opts = {}) {
      const res = await fetch(path, { ...opts, headers: { ...hdr(), ...(opts.headers || {}) } });
      if (res.status === 401) { sessionStorage.removeItem('wolko-hub-token'); location.replace('/portal'); throw new Error(t('errLogin')); }
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || t('errReq'));
      return body;
    }

    /* ─────────── 폼 상태 ─────────── */
    // 기준 통화는 KRW. USD 항목은 영수 날짜 기준 환율(1 USD = rate KRW)로 환산한다.
    function blankRow(prev) {
      return { source: prev ? prev.source : DEFAULT_SOURCE, srcCustom: !!prev?.srcCustom, memo: '', currency: 'KRW', amount: '', rate: '', rateNote: null, item: '', ministryPurpose: '', when: today(), where: '', project: '', receipts: [], more: false };
    }
    // 이름이 등록되지 않아 이메일이 이름 자리에 들어온 경우는 설명 기본값에서 제외
    const myName = () => (me?.name && !String(me.name).includes('@') ? me.name : '');
    function newForm() {
      // 마지막으로 쓴 값이 있으면 그걸, 없으면 로그인한 어카운트 홀더 이름을 기본값으로 채운다
      return { editingId: null, description: myName() ? myName() + ' ' : '', project: myName() || lsGet(LS.project), rows: [blankRow()] };
    }
    /* ─────────── 작성 중 자동 저장 (새로고침·뒤로가기·브라우저 종료 후에도 복원) ─────────── */
    // 서버의 임시 영수증이 3일 뒤 삭제되므로 초안도 같은 기간만 보관한다. 수정 중인 리포트는 저장하지 않는다.
    const DRAFT_TTL = 3 * 24 * 3600 * 1000;
    const draftKey = () => LS.draft + (me?.email || '');
    let uploadsBusy = 0;
    function saveDraft() {
      if (!form || !me || form.editingId) return;
      if (JSON.stringify(form) === JSON.stringify(newForm())) { try { localStorage.removeItem(draftKey()); } catch {} return; }
      lsSet(draftKey(), JSON.stringify({ t: Date.now(), form }));
    }
    let draftTimer = 0;
    function scheduleDraft() { clearTimeout(draftTimer); draftTimer = setTimeout(saveDraft, 400); }
    function loadDraft() {
      try {
        const d = JSON.parse(lsGet(draftKey(), 'null'));
        if (!d || !d.form || Date.now() - d.t > DRAFT_TTL || !Array.isArray(d.form.rows) || !d.form.rows.length) return null;
        return { ...d.form, editingId: null, rows: d.form.rows.map(r => { const o = { ...blankRow(), ...r, receipts: Array.isArray(r.receipts) ? r.receipts : [] }; o.source = legacySource(o); delete o.account; delete o.otherSel; return o; }) };
      } catch { return null; }
    }
    addEventListener('pagehide', () => { clearTimeout(draftTimer); saveDraft(); });
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') { clearTimeout(draftTimer); saveDraft(); } });
    addEventListener('beforeunload', e => { if (uploadsBusy) { clearTimeout(draftTimer); saveDraft(); e.preventDefault(); e.returnValue = ''; } });

    function formFromReport(r, asCopy) {
      return {
        editingId: asCopy ? null : r.id,
        description: r.description || '',
        project: r.project || '',
        rows: r.rows.map(x => ({
          source: x.source || x.account || '', memo: x.memo || '', currency: x.currency || 'KRW', amount: String(x.amount),
          rate: asCopy || !x.rate ? '' : String(x.rate), rateNote: asCopy || !x.rate ? null : { k: 'rateSaved' },
          item: x.item || '', ministryPurpose: x.ministryPurpose, when: asCopy ? today() : (x.when || today()),
          where: x.where || '', project: x.project || '',
          receipts: asCopy ? [] : (x.receipts || []).map(f => ({ ...f })),
          more: !!(x.where || x.project),
        })),
      };
    }
    // 예전 화면(계정과목 드롭다운)으로 저장된 값은 '작성자 입력'으로 옮긴다
    const legacySource = r => r.source || r.account || '';

    function rowKrw(r) {
      const amt = Number(r.amount);
      if (!(amt > 0)) return 0;
      if (r.currency === 'KRW') return Math.round(amt);
      const rate = Number(r.rate);
      return rate > 0 ? Math.round(amt * rate) : 0;
    }
    function formTotal() { return form.rows.reduce((s, r) => s + rowKrw(r), 0); }

    /* 영수 날짜 기준 환율 자동 조회 (서버가 주말/휴일은 직전 영업일로 맞춰줌) */
    const rateTimers = new WeakMap();
    function scheduleRate(r, immediate) {
      clearTimeout(rateTimers.get(r));
      if (!isFx(r.currency) || !r.when) return;
      const run = async () => {
        const wanted = r.when;
        r.rateNote = { k: 'rateLoading' }; paintRates();
        try {
          const cur = r.currency;
          const out = await api('/api/expense/rate?date=' + encodeURIComponent(wanted) + '&currency=' + encodeURIComponent(cur));
          if (r.when !== wanted || r.currency !== cur) return; // 그 사이 바뀜
          r.rate = String(out.rate);
          r.rateNote = out.source === 'latest' ? { k: 'rateLatest' } : (out.date === wanted ? { k: 'asof', d: wanted.slice(5) } : { k: 'biz', d: out.date.slice(5) });
        } catch (e) { r.rateNote = { k: 'rateFail' }; }
        paintRates(); refreshComputed();
      };
      if (immediate) run(); else rateTimers.set(r, setTimeout(run, 350));
    }

    /* ─────────── 렌더링: 새 리포트 ─────────── */
    function renderTabs() {
      const tabs = [{ id: 'new', label: form?.editingId ? t('tabEdit') : t('tabNew') }, { id: 'mine', label: t('tabMine'), n: unseenAlerts() }];
      if (me.isApprover) tabs.push({ id: 'approve', label: t('tabApprove'), n: counts.approve });
      if (me.isAccountant) tabs.push({ id: 'accounting', label: t('tabAcct'), n: counts.accounting });
      if (me.canViewAll) tabs.push({ id: 'all', label: t('tabAll') });
      $('exTabs').innerHTML = tabs.map(x => `<button class="ex-tab ${x.id === 'new' ? (form?.editingId ? 'ex-tab-new is-edit' : 'ex-tab-new') : ''} ${x.id === tab ? 'active' : ''}" data-tab="${x.id}">${esc(x.label)}${x.n ? `<span class="ex-badge">${x.n}</span>` : ''}</button>`).join('');
    }

    function projectOptions() {
      let list = [];
      try { list = JSON.parse(lsGet(LS.projects, '[]')); } catch {}
      return list.map(p => `<option value="${esc(p)}">`).join('');
    }

    function sourceOptions() {
      let used = []; try { used = JSON.parse(lsGet(LS.sources, '[]')); } catch {}
      return [...new Set([...used, ...(lang === 'en' ? SRC_EXAMPLES_EN : SRC_EXAMPLES_KO)])].map(v => `<option value="${esc(v)}">`).join('');
    }

    function rowHtml(r, i) {
      return `
      <div class="ex-row" data-i="${i}">
        <div class="ex-line ex-l1">
          <span class="ex-num">${i + 1}</span>
          <input class="ex-input ex-w-date" data-f="when" data-datepick type="text" readonly inputmode="none" autocomplete="off" value="${esc(r.when)}" aria-label="When">
          <div class="ex-srcwrap ${srcIsCustom(r) ? 'is-custom' : ''}">
            <select class="ex-select ex-srcsel ${!srcIsCustom(r) && !r.source ? 'is-empty' : ''}" data-f="srcSel" aria-label="${esc(t('srcLbl'))}">
              <option value="" disabled hidden ${!srcIsCustom(r) && !r.source ? 'selected' : ''}>${esc(t('srcSelPh'))}</option>
              ${SRC_PRESETS.map(v => `<option value="${esc(v)}" ${!srcIsCustom(r) && r.source === v ? 'selected' : ''}>${esc(srcShow(v))}</option>`).join('')}
              <option value="${SRC_CUSTOM}" ${srcIsCustom(r) ? 'selected' : ''}>${esc(t('srcCustomOpt'))}</option>
            </select>
            <input class="ex-input ex-source" data-f="source" list="fSrcList" placeholder="${esc(t('srcPh'))}" value="${esc(srcIsCustom(r) ? r.source : '')}" maxlength="160" aria-label="${esc(t('srcLbl'))}" ${srcIsCustom(r) ? '' : 'hidden'}>
          </div>
          <div class="ex-amount">
            <input class="ex-input" data-f="amount" type="number" inputmode="decimal" min="0" step="any" placeholder="${t('amountPh')}" value="${esc(r.amount)}" aria-label="Amount">
            <select class="ex-select" data-f="currency" aria-label="${t('currency')}"><option value="KRW" ${r.currency === 'KRW' ? 'selected' : ''}>₩ KRW</option>${Object.keys(FX).map(c => `<option value="${c}" ${r.currency === c ? 'selected' : ''}>${FX[c].symbol} ${c}</option>`).join('')}</select>
          </div>
          ${form.rows.length > 1 ? `<button class="ex-x" data-act="del-row" data-i="${i}" aria-label="${t('delRow')}">×</button>` : '<span class="ex-x-space"></span>'}
        </div>
        <div class="ex-lmemo"><input class="ex-input" data-f="memo" placeholder="${t('memoPh')}" value="${esc(r.memo)}" maxlength="300" aria-label="${t('memoLbl')}"></div>
        <div class="ex-line ex-l2">
          <input class="ex-input ex-grow ex-item" data-f="item" placeholder="${t('itemPh')}" value="${esc(r.item)}" maxlength="120">
          <input class="ex-input ex-grow" data-f="ministryPurpose" placeholder="${t('purposePh')}" value="${esc(r.ministryPurpose)}" maxlength="500">
          <label class="ex-btn sm ex-attach" title="${t('attachTitle')}">📎 ${t('attach')}${r.receipts.length ? ' ' + r.receipts.length : ''}<input type="file" data-f="receipt" accept="image/*,application/pdf" multiple hidden></label>
          <button class="ex-btn sm ex-more-btn" data-act="toggle-more" data-i="${i}" aria-expanded="${r.more}">${r.more ? t('less') : '⋯'}</button>
        </div>
        ${r.receipts.length ? `<div class="ex-receipts">${r.receipts.map((f, k) => `<span class="ex-chip"><span class="ex-chip-main" data-act="open-receipt" data-rid="${esc(form.editingId || '')}" data-fid="${esc(f.id)}" data-name="${esc(f.name)}" data-type="${esc(f.type)}">${thumbHtml(f)}${esc(f.name)}</span><button data-act="del-receipt" data-i="${i}" data-k="${k}" aria-label="${t('remove')}">×</button></span>`).join('')}</div>` : ''}
        <div class="ex-rateline" data-rateline ${isFx(r.currency) ? '' : 'hidden'}></div>
        <div class="ex-more" ${r.more ? '' : 'hidden'}>
          <input class="ex-input" data-f="where" placeholder="${t('wherePh')}" value="${esc(r.where)}">
          <input class="ex-input" data-f="project" placeholder="${t('rowProjPh')}" value="${esc(r.project)}">
        </div>
      </div>`;
    }

    function renderNew() {
      const editing = !!form.editingId;
      $('exView').innerHTML = `
      <div class="ex-card">
        <h2>${editing ? t('titleEdit') : t('titleNew')}</h2>
        <p class="ex-sub ex-submitter">${esc(t('subNew', me.name))}</p>
        <div class="ex-fxnote">
          <span class="ex-fx-base"><em>${esc(t('fxBase'))}</em> <b>${esc(t('fxBaseVal'))}</b></span>
          <span class="ex-fx-auto">${esc(t('fxAuto'))}</span>
          <span class="ex-fx-chips" aria-hidden="true">${Object.keys(FX).map(c => `<i>${esc(FX[c].symbol)} ${c}</i>`).join('')}</span>
        </div>
        <div class="ex-grid">
          <div class="ex-field">
            <label>${t('lblDesc')}</label>
            <input class="ex-input" id="fDesc" value="${esc(form.description)}" placeholder="${t('descPh')}">
          </div>
          <div class="ex-field">
            <label>${t('lblProject')}</label>
            <input class="ex-input" id="fProject" list="fProjectList" value="${esc(form.project)}" placeholder="${t('projPh')}">
            <datalist id="fProjectList">${projectOptions()}</datalist>
          </div>
        </div>
        <datalist id="fSrcList">${sourceOptions()}</datalist>
        <div class="ex-rows" id="fRows">${form.rows.map(rowHtml).join('')}</div>
        <div style="margin-top:12px"><button class="ex-btn" data-act="add-row">${t('addRow')}</button></div>
        <div class="ex-total-bar">
          <div class="ex-total" id="fTotal"></div>
          <div class="ex-actions" style="margin:0">
            ${editing ? `<button class="ex-btn" data-act="cancel-edit">${t('cancelEdit')}</button>` : `<button class="ex-btn" data-act="reset-draft">${t('resetDraft')}</button>`}
            <button class="ex-btn primary" id="fSubmit" data-act="submit">${editing ? t('submitEdit') : t('submit')}</button>
          </div>
        </div>
      </div>`;
      form.rows.forEach(r => { if (isFx(r.currency) && !Number(r.rate)) scheduleRate(r, true); });
      paintRates(); refreshComputed();
    }

    /* USD 줄의 환율 안내줄: "$25.00 × [1355.05] = ₩33,876 · 09-25 기준" */
    function paintRates() {
      document.querySelectorAll('.ex-row').forEach(el => {
        const r = form.rows[+el.dataset.i], line = el.querySelector('[data-rateline]');
        if (!r || !line) return;
        line.hidden = !isFx(r.currency);
        if (!isFx(r.currency)) return;
        if (!line.dataset.ready) {
          line.innerHTML = '<span data-r-usd></span> × <input class="ex-rate-input" data-f="rate" type="number" inputmode="decimal" step="any" min="0" aria-label="' + t('rateAria') + '"> = <b data-r-krw></b><span class="ex-rate-note" data-r-note></span>';
          line.dataset.ready = '1';
        }
        line.querySelector('[data-r-usd]').textContent = fxFmt(r.currency, Number(r.amount) || 0);
        const inp = line.querySelector('[data-f="rate"]');
        if (document.activeElement !== inp) inp.value = r.rate;
        line.querySelector('[data-r-krw]').textContent = krw(rowKrw(r));
        line.querySelector('[data-r-note]').textContent = r.rateNote ? ' · ' + rateText(r.rateNote) : '';
      });
    }

    function refreshComputed() {
      paintRates();
      hydrateDraftThumbs();
      const totalEl = $('fTotal');
      if (totalEl) totalEl.innerHTML = '<small>' + t('totalKrw') + '</small>' + krw(formTotal());
    }

    /* ─────────── 렌더링: 리포트 카드 ─────────── */
    function projectOf(rep, row) { return row.project || rep.project || ''; }

    // 승인 전에는 작성자가 적은 내용(source)을, 승인 후에는 확정된 카테고리를 보여주고 서로 다르면 작성자 입력도 함께 보여준다
    const subText = r => srcShow(r.source || r.submittedAccount || '');
    const catView = r => r.account
      ? esc(r.account) + (subText(r) && subText(r) !== r.account ? `<div class="ex-meta">${esc(t('srcSubmitted', subText(r)))}</div>` : '')
      : `${esc(srcShow(r.source || ''))}<div class="ex-meta">${esc(t('catUnset'))}</div>`;
    const catKey = r => r.account || t('catUnset');
    const memoHtml = r => (r.memo ? `<div class="ex-memo">${esc(r.memo)}</div>` : '')
      + (r.approverMemo ? `<div class="ex-memo ap"><b>✔ ${esc(t('aMemoLbl'))}</b> ${esc(r.approverMemo)}</div>` : '');
    // 보기 화면: 영수증은 왼쪽 썸네일 타일로 (이미지는 불러와서 채우고, PDF 등은 아이콘)
    function receiptChips(rep, row) {
      const tiles = (row.receipts || []).map(f => {
        const img = (f.type || '').startsWith('image/'), pdf = /pdf/i.test(f.type || '');
        return `<span class="ex-rthumb" data-act="open-receipt" data-rid="${esc(rep.id)}" data-fid="${esc(f.id)}" data-name="${esc(f.name)}" data-type="${esc(f.type)}" title="${esc(f.name)}">${img ? '' : (pdf ? 'PDF' : '📎')}</span>`;
      }).join('');
      return `<div class="ex-receipts ex-rcol">${tiles || '<span class="ex-rthumb none">—</span>'}</div>`;
    }
    const itemWrap = (rep, r, body) => `<div class="ex-itemrow">${receiptChips(rep, r)}<div class="ex-itembody">${body}</div></div>`;

    /* 승인 화면: 항목별 카테고리 확정 상태 (제출자가 고른 값이 기본값) */
    const catState = {};
    function catStateFor(rep) {
      return catState[rep.id] ??= { delegated: false, needCheck: rep.rows.map(x => !!x.memo), accounts: rep.rows.map(x => APPROVAL_ACCOUNTS.includes(x.account) ? x.account : ''), confirmed: rep.rows.map(() => false), memos: rep.rows.map(() => '') };
    }
    // 위임하면 카테고리 없이도 승인할 수 있지만, 제출자 메모가 있는 항목은 승인자가 꼭 확인해야 한다
    // 위임하면 확인하지 않은 항목은 자동으로 확인 처리되므로 바로 승인할 수 있다
    const approvalReady = st => st.delegated || (st.accounts.every(Boolean) && st.confirmed.every(Boolean));
    const autoRow = (st, i) => st.delegated && !st.confirmed[i];
    function paintApproval(id) {
      const art = document.querySelector('[data-rep="' + id + '"]'), st = catState[id];
      if (!art || !st) return;
      st.accounts.forEach((a, i) => {
        const btn = art.querySelector('[data-act="confirm-cat"][data-i="' + i + '"]');
        if (btn) { btn.classList.toggle('done', st.confirmed[i]); btn.textContent = st.confirmed[i] ? t('catDone') : t('catConfirm'); }
      });
      const ab = art.querySelector('[data-act="approve"]'); if (ab) ab.disabled = !approvalReady(st);
    }
    function catCell(rep, r, i, st) {
      const cur = st.accounts[i];
      return `<div class="ex-cat">
          <div class="ex-src"><b>${esc(srcShow(r.source || r.submittedAccount || r.account || ''))}</b></div>
          <select class="ex-select-plain" data-cat="${i}" data-repid="${esc(rep.id)}" aria-label="${esc(t('catPick'))}">
            <option value="">${esc(t('catPick'))}</option>
            ${APPROVAL_ACCOUNTS.map(a => `<option value="${esc(a)}" ${cur === a ? 'selected' : ''}>${esc(a)}</option>`).join('')}
          </select>
          <div class="ex-cat-confirm">
            <input class="ex-input ex-amemo" data-amemo="${i}" data-repid="${esc(rep.id)}" placeholder="${esc(t('aMemoPh'))}" value="${esc(st.memos[i])}" maxlength="300">
            <button class="ex-btn sm ex-confirm ${st.confirmed[i] || autoRow(st, i) ? 'done' : ''}" data-act="confirm-cat" data-id="${esc(rep.id)}" data-i="${i}" ${autoRow(st, i) && !st.accounts[i] ? 'disabled' : ''}>${st.confirmed[i] ? t('catDone') : autoRow(st, i) ? t('catAuto') : t('catConfirm')}</button>
          </div>
        </div>`;
    }

    // 카드 머리 한 줄: 제출자 · 캠퍼스 · 제출일 · 프로젝트 — 제목/제출자와 같은 말은 반복하지 않는다
    function metaParts(rep, mode) {
      const title = (rep.description || '').trim();
      const parts = [];
      if (mode !== 'mine' && rep.submitterName && rep.submitterName !== title) parts.push(rep.submitterName);
      if (mode !== 'mine') parts.push(t('campus_' + (rep.campus === 'jeju' ? 'jeju' : 'wolko')));
      parts.push(t('submittedOn', fmtDate(rep.submittedAt)));
      const proj = (rep.project || '').trim();
      if (proj && proj !== rep.submitterName && proj !== title) parts.push(proj);
      return parts;
    }
    const rowProject = (rep, r) => { const p = projectOf(rep, r); return p && p !== rep.submitterName && p !== (rep.description || '').trim() ? p : ''; };

    function reportCard(rep, mode, trashInfo) {
      const approving = mode === 'approve' && rep.status === 'submitted';
      const st = approving ? catStateFor(rep) : null;
      const rows = rep.rows.map((r, i) => `
        <tr>
          <td>${esc(r.when || '')}</td>
          <td>${approving ? catCell(rep, r, i, st) : catView(r)}${rowProject(rep, r) ? `<div class="ex-meta">${esc(rowProject(rep, r))}</div>` : ''}</td>
          <td>${itemWrap(rep, r, `${r.item ? `<b>${esc(r.item)}</b>${r.ministryPurpose ? `<div class="ex-meta">${esc(r.ministryPurpose)}</div>` : ''}` : esc(r.ministryPurpose)}${r.where ? `<div class="ex-meta">📍 ${esc(r.where)}</div>` : ''}${memoHtml(r)}`)}</td>
          <td class="r">${krw(r.amountKrw)}${isFx(r.currency) ? `<div class="ex-meta">${fxFmt(r.currency, r.amount)} × ${rateFmt(r.rate)}</div>` : ''}</td>
        </tr>`).join('');

      let notes = '';
      if (rep.status === 'submitted' && rep.returnNote) notes = `<div class="ex-note reject">${esc(t('noteReturned', rep.returnedByName || '', rep.returnNote))} <span class="ex-meta">(${fmtDate(rep.returnedAt)})</span></div>`;
      else if (rep.status === 'rejected') notes = `<div class="ex-note reject"><b>${t('noteRejected')}</b> — ${esc(rep.reviewNote)} <span class="ex-meta">(${esc(rep.reviewedByName || '')} · ${fmtDate(rep.reviewedAt)})</span></div>`;
      else if (rep.status === 'approved') notes = `<div class="ex-note ok">${esc(t('noteApproved', rep.reviewedByName || '', fmtDate(rep.reviewedAt)))}${rep.reviewNote ? ' — ' + esc(rep.reviewNote) : ''}</div>`;
      else if (rep.status === 'processed') notes = (rep.reviewedByName ? `<div class="ex-note ok">${esc(t('noteApproved', rep.reviewedByName, fmtDate(rep.reviewedAt)))}</div>` : '') + `<div class="ex-note ok">${esc(t('noteProcessed', fmtDate(rep.processedAt), rep.processedByName || ''))}${rep.processNote ? ' — ' + esc(rep.processNote) : ''}</div>`;

      let actions = '';
      if (mode === 'mine') {
        if (rep.status === 'rejected') actions += `<button class="ex-btn primary sm" data-act="edit" data-id="${esc(rep.id)}">${t('btnResubmit')}</button>`;
        if (rep.status === 'submitted') actions += `<button class="ex-btn sm" data-act="edit" data-id="${esc(rep.id)}">${t('btnEdit')}</button>`;
        if (rep.status === 'submitted' || rep.status === 'rejected') actions += `<button class="ex-btn sm danger" data-act="withdraw" data-id="${esc(rep.id)}">${t('btnWithdraw')}</button>`;
        actions += `<button class="ex-btn sm" data-act="copy" data-id="${esc(rep.id)}">${t('btnCopy')}</button>`;
      } else if (approving) {
        const ready = approvalReady(st);
        actions = `<button class="ex-btn sm ex-delegate ${st.delegated ? 'on' : ''}" data-act="delegate" data-id="${esc(rep.id)}">${t(st.delegated ? 'catDelegated' : 'catDelegate')}</button><span style="flex:1"></span><button class="ex-btn danger sm" data-act="reject" data-id="${esc(rep.id)}">${t('btnReject')}</button><button class="ex-btn green sm" data-act="approve" data-id="${esc(rep.id)}" ${ready ? '' : 'disabled'}>${t('btnApprove')}</button>`;
      } else if (mode === 'accounting') {
        if (rep.status === 'approved') actions = `<button class="ex-btn green sm" data-act="process" data-id="${esc(rep.id)}">${t('btnProcess')}</button>`;
        actions += `<button class="ex-btn danger sm" data-act="trash" data-id="${esc(rep.id)}">${t('btnTrash')}</button>`;
      } else if (mode === 'trash') {
        actions = `<button class="ex-btn green sm" data-act="restore" data-id="${esc(rep.id)}">${t('btnRestore')}</button>`;
        notes = `<div class="ex-note reject">${esc(t('noteTrashed', trashInfo?.deletedByName || '', fmtDate(trashInfo?.deletedAt)))}</div>` + notes;
      }

      return `
      <article class="ex-card" data-rep="${esc(rep.id)}">
        <div class="ex-report-head">
          <div>
            <div class="ex-report-title">${esc(rep.description || t('noDesc'))}</div>
            <div class="ex-meta">${metaParts(rep, mode).map(esc).join(' · ')}</div>
          </div>
          <div>
            <div class="ex-report-total">${krw(rep.total)}</div>
            <span class="ex-status ${rep.status}">${t('st_' + rep.status)}</span>
          </div>
        </div>
        <div class="ex-table-wrap"><table class="ex-table">
          <thead><tr><th>${t('thWhen')}</th><th>${t('thCat')}</th><th>${t('thItem')}</th><th style="text-align:right">${t('thAmt')}</th></tr></thead>
          <tbody>${rows}</tbody>
        </table></div>
        ${approving ? `<p class="ex-sub" style="margin:12px 0 0">${esc(t(st.delegated ? 'catDelegateNote' : 'catHint'))}</p>` : ''}
        ${notes}
        ${actions ? `<div class="ex-actions">${actions}</div>` : ''}
      </article>`;
    }

    /* 기간 필터(제출일 기준) + 계정과목별 합계 — 회계 업무와 전체 리포트가 함께 쓴다 */
    let period = { from: '', to: '' };
    const dayOf = iso => { const d = new Date(iso); d.setMinutes(d.getMinutes() - d.getTimezoneOffset()); return d.toISOString().slice(0, 10); };
    const inPeriod = r => { const d = dayOf(r.submittedAt); return (!period.from || d >= period.from) && (!period.to || d <= period.to); };
    function monthRange(offset) {
      const n = new Date(), a = new Date(n.getFullYear(), n.getMonth() + offset, 1), b = new Date(n.getFullYear(), n.getMonth() + offset + 1, 0);
      const f = d => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
      return { from: f(a), to: f(b) };
    }
    function periodHtml() {
      const cur = monthRange(0), prev = monthRange(-1), is = r => period.from === r.from && period.to === r.to;
      return `<div class="ex-filter ex-period">
        <span class="ex-period-lbl">${t('pLabel')}</span>
        <input type="text" readonly data-datepick inputmode="none" autocomplete="off" class="ex-select-plain ex-date" id="pFrom" value="${esc(period.from)}" aria-label="from">
        <span>${t('pTo')}</span>
        <input type="text" readonly data-datepick inputmode="none" autocomplete="off" class="ex-select-plain ex-date" id="pTo" value="${esc(period.to)}" aria-label="to">
        <button class="ex-tab ${is(cur) ? 'active' : ''}" data-period="this">${t('pThis')}</button>
        <button class="ex-tab ${is(prev) ? 'active' : ''}" data-period="last">${t('pLast')}</button>
        <button class="ex-tab ${!period.from && !period.to ? 'active' : ''}" data-period="all">${t('pAll')}</button>
      </div>`;
    }
    function acctChips(shown) {
      const byAcct = {};
      shown.forEach(r => r.rows.forEach(x => { byAcct[catKey(x)] = (byAcct[catKey(x)] || 0) + x.amountKrw; }));
      return `<div class="ex-summary">${Object.entries(byAcct).sort((a, b) => b[1] - a[1]).map(([k, v]) => `<span class="ex-sum-chip">${esc(k)} <b>${krw(v)}</b></span>`).join('')}</div>`;
    }

    function renderList(mode) {
      let list = data[mode];
      if (mode === 'approve') {
        const pending = list.filter(r => r.status === 'submitted');
        const done = list.filter(r => r.status !== 'submitted');
        $('exView').innerHTML =
          (pending.length ? pending.map(r => reportCard(r, mode)).join('') : `<div class="ex-empty">${t('emptyApprove')}</div>`) +
          (done.length ? `<p class="ex-sub" style="margin:22px 0 10px">${t('recent')}</p>` + done.map(r => reportCard(r, mode)).join('') : '');
        return;
      }
      if (mode === 'accounting') return renderGrouped('accounting');
      $('exView').innerHTML = list.length ? list.map(r => reportCard(r, mode)).join('') : `<div class="ex-empty">${t('emptyMine')}</div>`;
    }

    /* ─── 회계 업무(회계 담당) / 전체 리포트(관리자·회계): 캠퍼스 → 사람별 카드 → 제출 건 한 줄씩 ─── */
    let allStatus = 'all';
    const G = { campus: 'wolko', open: new Set() };
    const myCampus = () => (me?.campus === 'jeju' ? 'jeju' : 'wolko');
    const campusOf = r => (r.campus === 'jeju' ? 'jeju' : 'wolko');
    const modeStatus = mode => (mode === 'accounting' ? acctFilter : allStatus);
    function gFiltered(mode, campus) {
      const base = mode === 'accounting' ? data.accounting : data.all;
      const s = modeStatus(mode);
      return base.filter(r => (!campus || campusOf(r) === campus) && (mode !== 'accounting' || inPeriod(r)) && (s === 'all'
        || (mode === 'accounting' ? (s === 'todo' ? r.status === 'approved' : s === 'done' ? r.status === 'processed' : true) : r.status === s)));
    }
    const shortDate = iso => { if (!iso) return ''; const d = new Date(iso); return lang === 'en' ? d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : (d.getMonth() + 1) + '.' + d.getDate(); };

    function detailHtml(rep, mode) {
      const items = rep.rows.map(r => `
        <div class="ex-d-item">
          <div class="ex-d-main"><b>${esc(r.item || r.ministryPurpose)}</b>${r.item && r.ministryPurpose ? ` <span class="ex-meta">— ${esc(r.ministryPurpose)}</span>` : ''}</div>
          <div class="ex-d-amt">${krw(r.amountKrw)}${isFx(r.currency) ? `<span class="ex-meta"> (${fxFmt(r.currency, r.amount)} × ${rateFmt(r.rate)})</span>` : ''}</div>
          <div class="ex-d-sub ex-meta">${esc(r.when || '')} · ${r.account ? esc(r.account) : esc(srcShow(r.source || '')) + ' (' + esc(t('catUnset')) + ')'}${r.account && subText(r) && subText(r) !== r.account ? ' (' + esc(t('srcSubmitted', subText(r))) + ')' : ''}${r.where ? ' · 📍 ' + esc(r.where) : ''}</div>
          ${memoHtml(r)}
          ${(r.receipts || []).length ? receiptChips(rep, r) : ''}
        </div>`).join('');
      const bySub = {};
      rep.rows.forEach(r => { bySub[catKey(r)] = (bySub[catKey(r)] || 0) + r.amountKrw; });
      const subtotal = Object.keys(bySub).length > 1 || rep.rows.length > 1
        ? `<div class="ex-summary" style="margin:10px 0 4px">${Object.entries(bySub).sort((a, b) => b[1] - a[1]).map(([k, v]) => `<span class="ex-sum-chip">${esc(k)} <b>${krw(v)}</b></span>`).join('')}</div>` : '';
      let note = '';
      if (rep.status === 'rejected') note = `<div class="ex-note reject"><b>${t('noteRejected')}</b> — ${esc(rep.reviewNote)}</div>`;
      else if (rep.status === 'approved') note = `<div class="ex-note ok">${esc(t('noteApproved', rep.reviewedByName || '', fmtDate(rep.reviewedAt)))}</div>`;
      else if (rep.status === 'processed') note = (rep.reviewedByName ? `<div class="ex-note ok">${esc(t('noteApproved', rep.reviewedByName, fmtDate(rep.reviewedAt)))}</div>` : '') + `<div class="ex-note ok">${esc(t('noteProcessed', fmtDate(rep.processedAt), rep.processedByName || ''))}</div>`;
      const locked = rep.status === 'approved' || rep.status === 'processed';
      const waiting = rep.status === 'approved' && rep.categoryDelegated && rep.rows.some(r => !APPROVAL_ACCOUNTS.includes(r.account));
      // 회계 담당만 마지막에 카테고리(코드)를 고칠 수 있고, 그 외 내용은 승인 후 고정
      const recat = locked && me?.isAccountant && (mode === 'accounting' || mode === 'all') ? `
        <div class="ex-recat" data-recat="${esc(rep.id)}">
          <p class="ex-recat-title">${esc(t('recatTitle'))}</p>
          ${waiting ? `<p class="ex-recat-wait">${esc(t('delegatedWait'))}</p>` : ''}
          ${rep.rows.map((r, i) => `<label class="ex-recat-row"><span>${esc(r.item || r.ministryPurpose || '')} <b>${krw(r.amountKrw)}</b></span>
            <select class="ex-select-plain" data-recat-i="${i}">${APPROVAL_ACCOUNTS.includes(r.account) ? '' : `<option value="" selected>${esc(t('catPick'))}</option>`}${APPROVAL_ACCOUNTS.map(a => `<option value="${esc(a)}" ${r.account === a ? 'selected' : ''}>${esc(a)}</option>`).join('')}</select></label>`).join('')}
          <button class="ex-btn sm" data-act="recat-save" data-id="${esc(rep.id)}">${esc(t('recatSave'))}</button>
        </div>` : '';
      const lockNote = locked ? `<div class="ex-meta ex-locked">${esc(t('lockedNote'))}</div>` : '';
      let action = '<div class="ex-actions">';
      if (me?.isAccountant && (mode === 'accounting' || mode === 'all') && rep.status === 'approved') action += `<button class="ex-btn danger sm" data-act="acct-return" data-id="${esc(rep.id)}">${t('btnReturn')}</button>`;
      if (mode === 'accounting' && rep.status === 'approved') action += `<button class="ex-btn green sm" data-act="process" data-id="${esc(rep.id)}" ${waiting ? 'disabled title="' + esc(t('delegatedWait')) + '"' : ''}>${t('btnProcess')}</button>`;
      // 삭제(백업 후 이동)는 회계 담당자만 — 회계 업무와 전체 리포트 모두에서
      if (me?.isAccountant && (mode === 'accounting' || mode === 'all')) action += `<button class="ex-btn danger sm" data-act="trash" data-id="${esc(rep.id)}">${t('btnTrash')}</button>`;
      action += '</div>';
      return items + subtotal + note + lockNote + recat + action;
    }

    function renderGrouped(mode) {
      const statuses = mode === 'accounting'
        ? [['todo', 'fTodo'], ['done', 'fDone'], ['all', 'fAll'], ['trash', 'fTrash']].map(([k, l]) => ['data-filter', k, l])
        : [['all', 'fAll'], ['submitted', 'st_submitted'], ['approved', 'st_approved'], ['processed', 'st_processed'], ['rejected', 'st_rejected']].filter(([k]) => k !== 'submitted' || me.isApprover).map(([k, l]) => ['data-allstatus', k, l]);
      const cur = modeStatus(mode);
      const chips = statuses.map(([attr, k, label]) => `<button class="ex-tab ${cur === k ? 'active' : ''}" ${attr}="${k}">${t(label)}</button>`).join('');
      const inTrash = mode === 'accounting' && acctFilter === 'trash';

      // 삭제 보관함은 캠퍼스/사람 구분 없이 기존 카드 목록 그대로
      if (inTrash) {
        $('exView').innerHTML = `
          <div class="ex-card ex-gbar"><div class="ex-filter" style="margin:0">${chips}</div></div>
          ${data.trash.length ? data.trash.map(x => reportCard(x.report, 'trash', x)).join('') : `<div class="ex-empty">${t('emptyTrash')}</div>`}`;
        return;
      }

      const list = gFiltered(mode, G.campus);
      const sum = list.reduce((s, r) => s + r.total, 0);
      const byPerson = new Map();
      list.forEach(r => { if (!byPerson.has(r.submitterEmail)) byPerson.set(r.submitterEmail, { email: r.submitterEmail, name: r.submitterName, reports: [] }); byPerson.get(r.submitterEmail).reports.push(r); });
      const people = [...byPerson.values()].sort((a, b) => String(a.name).localeCompare(String(b.name), 'ko'));

      const cards = people.map(p => {
        const total = p.reports.reduce((s, r) => s + r.total, 0);
        const todo = p.reports.filter(r => r.status === 'approved').length;
        return `
        <section class="ex-person">
          <header class="ex-person-head">
            <span class="ex-avatar">${esc(String(p.name).trim().charAt(0).toUpperCase())}</span>
            <div class="ex-person-name"><b>${esc(p.name)}</b><div class="ex-meta">${esc(t('gN', p.reports.length))}${todo ? ' · ' + esc(t('st_approved')) + ' ' + todo : ''}</div></div>
            <div class="ex-person-total">${krw(total)}</div>
          </header>
          <ul class="ex-subs">
            ${p.reports.map(r => `
            <li>
              <button type="button" class="ex-sub-row" data-toggle="${esc(r.id)}" aria-expanded="${G.open.has(r.id)}">
                <span class="ex-sub-date">${esc(shortDate(r.submittedAt))}</span>
                <span class="ex-sub-desc">${esc(r.description || t('noDesc'))}<span class="ex-meta"> · ${esc(t('gItems', r.rows.length))}${r.reviewedByName ? ' · ' + esc(t('approvedBy', r.reviewedByName)) : ''}</span></span>
                <span class="ex-sub-dl" role="button" tabindex="0" data-act="xlsx-rep" data-id="${esc(r.id)}">${t('xlsxForm')}</span>
                <span class="ex-sub-amt">${krw(r.total)}</span>
                <span class="ex-status mini ${r.status}">${t('st_' + r.status)}</span>
              </button>
              <div class="ex-detail" id="d-${esc(r.id)}" ${G.open.has(r.id) ? '' : 'hidden'}>${detailHtml(r, mode)}</div>
            </li>`).join('')}
          </ul>
        </section>`;
      }).join('');

      $('exView').innerHTML = `
        <div class="ex-card ex-gbar">
          <div class="ex-seg" role="group">${[...CAMPUSES].sort((a, b) => (b === myCampus()) - (a === myCampus())).map(c => `<button type="button" class="ex-seg-btn ${G.campus === c ? 'active' : ''}" data-gcampus="${c}">${t('campus_' + c)}<span class="ex-seg-n">${gFiltered(mode, c).length}</span></button>`).join('')}</div>
          <div class="ex-filter" style="margin:12px 0 0">
            ${chips}
            <span style="flex:1"></span>
            <button class="ex-btn sm" data-act="csv-g" ${list.length ? '' : 'disabled'}>${t('csv')}</button>
            ${mode === 'accounting' && me.isAccountant ? `<button class="ex-btn sm" data-act="trash-all">${t('btnTrashAll')}</button>` : ''}
          </div>
          ${mode === 'accounting' ? `${periodHtml()}
          <div><b>${esc(t('gPeople', people.length))} · ${esc(t('countLine', list.length, krw(sum)))}</b></div>
          ${acctChips(list)}` : ''}
        </div>
        ${people.length ? `<div class="ex-gcards">${cards}</div>` : `<div class="ex-empty">${t('gEmpty')}</div>`}`;
    }
    const renderAll = () => renderGrouped('all');

    /* ─────────── 데이터 로딩 / 화면 전환 ─────────── */
    let countsAt = 0;
    async function refreshCounts(force) {
      if (!force && me && Date.now() - countsAt < 20000) return; // 탭을 옮길 때마다 서버를 부르지 않는다(배지는 20초마다 갱신)
      countsAt = Date.now();
      const c = await api('/api/expense/reports?scope=counts');
      me = c.me;
      if (!G.campusInit) { G.campusInit = true; G.campus = me.campus === 'jeju' ? 'jeju' : 'wolko'; } // 내 소속 캠퍼스 정보를 먼저 보여준다
      counts = { mine: c.mine, approve: c.approve, accounting: c.accounting };
      paintUser();
    }
    async function load(scope) {
      const r = await api('/api/expense/reports?scope=' + scope);
      data[scope] = r.reports;
    }
    async function show(next) {
      tab = next;
      try {
        await refreshCounts();
        if (tab === 'mine') { await load('mine'); markSeen(); }
        if (tab === 'approve') await load('approve');
        if (tab === 'accounting') await load('accounting');
        if (tab === 'all') await load('all');
      } catch (e) { toast(e.message, true); }
      renderTabs();
      if (tab === 'new') renderNew();
      else if (tab === 'all') renderAll();
      else renderList(tab);
      window.scrollTo({ top: 0 });
    }

    /* ─────────── 영수증 업로드 (이미지는 줄여서 올림) ─────────── */
    function shrinkImage(file) {
      return new Promise(resolve => {
        if (!file.type.startsWith('image/') || file.type === 'image/heic') return resolve(file);
        const img = new Image();
        const url = URL.createObjectURL(file);
        img.onload = () => {
          const max = 1600, scale = Math.min(1, max / Math.max(img.width, img.height));
          const c = document.createElement('canvas');
          c.width = Math.round(img.width * scale); c.height = Math.round(img.height * scale);
          c.getContext('2d').drawImage(img, 0, 0, c.width, c.height);
          c.toBlob(b => { URL.revokeObjectURL(url); resolve(b ? new File([b], file.name.replace(/\.\w+$/, '') + '.jpg', { type: 'image/jpeg' }) : file); }, 'image/jpeg', 0.82);
        };
        img.onerror = () => { URL.revokeObjectURL(url); resolve(file); };
        img.src = url;
      });
    }
    const toDataUrl = file => new Promise((res, rej) => { const fr = new FileReader(); fr.onload = () => res(fr.result); fr.onerror = rej; fr.readAsDataURL(file); });

    async function uploadReceipts(i, files) {
      const row = form.rows[i];
      uploadsBusy++;
      for (const original of files) {
        if (row.receipts.length >= 5) { toast(t('max5'), true); break; }
        try {
          toast(t('uploading'));
          const file = await shrinkImage(original);
          const data = await toDataUrl(file);
          const out = await api('/api/expense/receipt', { method: 'POST', body: JSON.stringify({ name: file.name, type: file.type, data }) });
          row.receipts.push({ id: out.id, name: out.name, type: out.type });
          blobCache.set(out.id, { url: URL.createObjectURL(file), type: file.type, name: out.name });
        } catch (e) { toast(e.message, true); }
      }
      uploadsBusy--; saveDraft();
      const rowsEl = $('fRows'); const scroll = window.scrollY;
      rowsEl.innerHTML = form.rows.map(rowHtml).join('');
      refreshComputed(); window.scrollTo({ top: scroll });
      toast(t('attached'));
    }

    /* ─────────── 영수증 미리보기 ─────────── */
    const blobCache = new Map(); // fileId → { url, type, name }
    function thumbHtml(f) {
      const c = blobCache.get(f.id);
      return c && (c.type || '').startsWith('image/') ? '<img class="ex-thumb" alt="" src="' + c.url + '">' : '📎 ';
    }
    async function receiptBlob(rid, f) {
      if (blobCache.has(f.fid)) return blobCache.get(f.fid);
      const get = q => fetch('/api/expense/receipt?' + q + '&fileId=' + encodeURIComponent(f.fid), { headers: { Authorization: 'Bearer ' + token() } });
      // 제출된 리포트의 영수증이면 리포트 기준으로, 아직 제출 전(작성 중 임시 저장)이면 내 임시 파일로 불러온다
      let res = rid ? await get('reportId=' + encodeURIComponent(rid)) : null;
      if (!res || !res.ok) res = await get('draft=1');
      if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || t('pvOpenFail'));
      const blob = await res.blob();
      const item = { url: URL.createObjectURL(blob), type: blob.type || f.type, name: f.name };
      blobCache.set(f.fid, item);
      return item;
    }
    // 작성 중이던 리포트를 다시 열면 이미지 썸네일이 비어 있으므로, 임시 파일을 불러와 채운다 (실패해도 조용히 둔다)
    const thumbTried = new Set();
    function hydrateDraftThumbs() {
      document.querySelectorAll('#fRows .ex-chip-main[data-fid]').forEach(el => {
        const fid = el.dataset.fid;
        if (blobCache.has(fid) || thumbTried.has(fid) || !(el.dataset.type || '').startsWith('image/')) return;
        thumbTried.add(fid);
        receiptBlob(el.dataset.rid, { fid, name: el.dataset.name, type: el.dataset.type }).then(item => {
          const first = el.firstChild;
          if (first && first.nodeType === 3 && first.textContent.includes('📎')) {
            const img = document.createElement('img'); img.className = 'ex-thumb'; img.alt = ''; img.src = item.url;
            first.replaceWith(img);
          }
        }).catch(() => {});
      });
    }
    // 보기 화면의 영수증 타일(.ex-rthumb)에 이미지 썸네일을 채운다 (화면이 다시 그려질 때마다)
    function hydrateViewThumbs() {
      document.querySelectorAll('#exView .ex-rthumb[data-fid]').forEach(el => {
        if (el.dataset.loaded || !(el.dataset.type || '').startsWith('image/')) return;
        el.dataset.loaded = '1';
        receiptBlob(el.dataset.rid, { fid: el.dataset.fid, name: el.dataset.name, type: el.dataset.type }).then(item => {
          el.style.backgroundImage = 'url("' + item.url + '")'; el.classList.add('has-img');
        }).catch(() => { el.textContent = '📎'; });
      });
    }
    new MutationObserver(hydrateViewThumbs).observe($('exView'), { childList: true, subtree: true });
    const pv = { list: [], i: 0, seq: 0 };
    function ensurePreviewModal() {
      if ($('exPreview')) return;
      const el = document.createElement('div');
      el.id = 'exPreview'; el.className = 'ex-pv'; el.hidden = true;
      el.innerHTML = '<div class="ex-pv-bar"><span class="ex-pv-title" id="pvTitle"></span><span class="ex-pv-count" id="pvCount"></span>' +
        '<a class="ex-btn sm" id="pvOpen" target="_blank" rel="noopener"></a><a class="ex-btn sm" id="pvDl"></a>' +
        '<button class="ex-btn sm" data-pv="close">✕</button></div>' +
        '<div class="ex-pv-stage" id="pvStage"></div>' +
        '<button class="ex-pv-nav prev" data-pv="prev">‹</button><button class="ex-pv-nav next" data-pv="next">›</button>';
      document.body.appendChild(el);
      paintPreviewLabels();
      el.addEventListener('click', e => {
        const act = e.target.closest('[data-pv]')?.dataset.pv;
        if (act === 'close' || e.target === el || e.target.id === 'pvStage') closePreview();
        else if (act === 'prev') stepPreview(-1);
        else if (act === 'next') stepPreview(1);
      });
    }
    function paintPreviewLabels() {
      if (!$('exPreview')) return;
      $('pvOpen').textContent = t('pvNewTab'); $('pvDl').textContent = t('pvSave');
      document.querySelector('[data-pv="close"]').setAttribute('aria-label', t('pvClose'));
      document.querySelector('[data-pv="prev"]').setAttribute('aria-label', t('pvPrev'));
      document.querySelector('[data-pv="next"]').setAttribute('aria-label', t('pvNext'));
    }
    function openPreview(list, i) { ensurePreviewModal(); pv.list = list; pv.i = i; $('exPreview').hidden = false; document.body.style.overflow = 'hidden'; paintPreview(); }
    function closePreview() { const el = $('exPreview'); if (el) el.hidden = true; document.body.style.overflow = ''; pv.seq++; }
    function stepPreview(d) { const n = pv.list.length; if (n < 2) return; pv.i = (pv.i + d + n) % n; paintPreview(); }
    async function paintPreview() {
      const f = pv.list[pv.i], seq = ++pv.seq, stage = $('pvStage');
      $('pvTitle').textContent = f.name;
      $('pvCount').textContent = pv.list.length > 1 ? (pv.i + 1) + ' / ' + pv.list.length : '';
      document.querySelectorAll('.ex-pv-nav').forEach(b => { b.hidden = pv.list.length < 2; });
      stage.innerHTML = '<div class="ex-pv-msg">' + t('loading') + '</div>';
      try {
        const item = await receiptBlob(f.rid, f);
        if (seq !== pv.seq) return;
        $('pvOpen').href = item.url; $('pvDl').href = item.url; $('pvDl').download = item.name;
        const mime = item.type || '';
        stage.innerHTML = '';
        if (mime.startsWith('image/')) {
          const img = document.createElement('img');
          img.src = item.url; img.alt = item.name; img.className = 'ex-pv-img';
          img.onerror = () => { stage.innerHTML = '<div class="ex-pv-msg">' + t('pvBadImg') + '</div>'; };
          stage.appendChild(img);
        } else if (mime === 'application/pdf') {
          const fr = document.createElement('iframe');
          fr.src = item.url; fr.className = 'ex-pv-frame'; fr.title = item.name;
          stage.appendChild(fr);
        } else {
          stage.innerHTML = '<div class="ex-pv-msg">' + t('pvUnsupported') + '</div>';
        }
      } catch (e) { if (seq === pv.seq) stage.innerHTML = '<div class="ex-pv-msg">' + esc(e.message) + '</div>'; }
    }
    document.addEventListener('keydown', e => {
      const el = $('exPreview'); if (!el || el.hidden) return;
      if (e.key === 'Escape') closePreview();
      else if (e.key === 'ArrowLeft') stepPreview(-1);
      else if (e.key === 'ArrowRight') stepPreview(1);
    });
    function openReceiptFrom(el) {
      const chips = [...el.closest('.ex-receipts').querySelectorAll('[data-fid]')];
      const list = chips.map(c => ({ rid: c.dataset.rid, fid: c.dataset.fid, name: c.dataset.name || 'receipt', type: c.dataset.type || '' }));
      openPreview(list, Math.max(0, chips.indexOf(el)));
    }

    /* ─────────── 제출 ─────────── */
    async function submitForm() {
      const btn = $('fSubmit'); btn.disabled = true;
      try {
        const payload = {
          id: form.editingId, description: form.description.trim(), project: form.project.trim(),
          rows: form.rows.map(r => ({ ...r, amount: Number(r.amount), rate: Number(r.rate) || 0 })),
        };
        await api('/api/expense/reports', { method: form.editingId ? 'PUT' : 'POST', body: JSON.stringify(payload) });
        if (form.project.trim()) {
          lsSet(LS.project, form.project.trim());
          let list = []; try { list = JSON.parse(lsGet(LS.projects, '[]')); } catch {}
          lsSet(LS.projects, JSON.stringify([form.project.trim(), ...list.filter(p => p !== form.project.trim())].slice(0, 8)));
        }
        try { // 자주 쓰는 입력은 다음에 자동완성으로 제안
          let used = []; try { used = JSON.parse(lsGet(LS.sources, '[]')); } catch {}
          const add = form.rows.map(r => (r.source || '').trim()).filter(Boolean);
          lsSet(LS.sources, JSON.stringify([...new Set([...add, ...used])].slice(0, 12)));
        } catch {}
        toast(form.editingId ? t('tResubmitted') : t('tSubmitted'));
        form = newForm();
        await show('mine');
      } catch (e) { toast(e.message, true); btn.disabled = false; }
    }

    /* ─────────── CSV ─────────── */
    /* 사람별 시트로 된 FIELD EXPENSE REPORT 양식 엑셀 — 라이브러리는 누를 때만 불러온다 */
    const loadScript = src => new Promise((res, rej) => {
      if (document.querySelector(`script[data-src="${src}"]`)) return res();
      const el = document.createElement('script'); el.src = src; el.dataset.src = src; el.onload = res; el.onerror = rej; document.head.appendChild(el);
    });
    async function exportXlsxForm(list, label) {
      toast(t('xlsxBusy'));
      try {
        if (!window.ExcelJS) await loadScript('https://cdnjs.cloudflare.com/ajax/libs/exceljs/4.4.0/exceljs.min.js');
        if (!window.WolkoExpenseXlsx) await loadScript('/expense-xlsx.js?v=1');
        const byPerson = new Map();
        list.forEach(r => { if (!byPerson.has(r.submitterEmail)) byPerson.set(r.submitterEmail, { name: r.submitterName, reports: [] }); byPerson.get(r.submitterEmail).reports.push(r); });
        const people = [...byPerson.values()].sort((a, b) => String(a.name).localeCompare(String(b.name), 'ko'));
        const wb = window.WolkoExpenseXlsx.build(window.ExcelJS, people, { today: today(), optionsText: APPROVAL_ACCOUNTS.filter(a => a !== "Other/Unknown").join(', ') + ', OTHER' });
        const buf = await wb.xlsx.writeBuffer();
        const a = document.createElement('a');
        a.href = URL.createObjectURL(new Blob([buf], { type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' }));
        a.download = `WOLKO_expense_form_${label ? label.replace(/[^\w가-힣-]+/g, '_') + '_' : ''}${today()}.xlsx`; a.click();
      } catch (e) { console.error(e); toast(t('xlsxFail'), true); }
    }

    function exportCsv(shown) {
      const head = ['Report ID', 'Campus', 'Status', 'Submitted', 'Submitter', 'Project', 'Date', 'Category (confirmed)', 'Submitted by (ministry/account)', 'Item', 'Purpose', 'Memo', 'Approver Memo', 'Where', 'Currency', 'Original Amount', 'Exchange Rate (KRW per 1 unit)', 'KRW Amount'];
      const lines = [head];
      shown.forEach(r => r.rows.forEach(x => lines.push([r.id, campusOf(r) === 'jeju' ? 'JEJU' : 'PYEONGTAEK', t('st_' + r.status), r.submittedAt.slice(0, 10), r.submitterName, x.project || r.project || '', x.when, x.account || '', subText(x), x.item || '', x.ministryPurpose, x.memo || '', x.approverMemo || '', x.where, x.currency, x.amount, x.rate || '', x.amountKrw])));
      const csv = '﻿' + lines.map(l => l.map(v => `"${String(v ?? '').replace(/"/g, '""')}"`).join(',')).join('\n');
      const a = document.createElement('a');
      a.href = URL.createObjectURL(new Blob([csv], { type: 'text/csv;charset=utf-8' }));
      a.download = `WOLKO_expense_${today()}.csv`; a.click();
    }

    /* ─────────── 언어 전환 ─────────── */
    function paintUser() { if (me) $('exUser').textContent = me.name + (me.isAccountant ? t('userAcct') : ''); }
    function applyStatic() {
      document.documentElement.lang = lang;
      document.title = t('pageTitle');
      document.querySelectorAll('[data-t]').forEach(el => { el.textContent = t(el.dataset.t); });
      $('langKoBtn').classList.toggle('is-active', lang === 'ko');
      $('langEnBtn').classList.toggle('is-active', lang === 'en');
      paintPreviewLabels();
    }
    function setLang(next) {
      if (next === lang) return;
      lang = next;
      try { localStorage.setItem('wolko-lang', lang); } catch {}
      applyStatic();
      if (!me) return;
      paintUser(); renderTabs();
      if (tab === 'new') renderNew(); else if (tab === 'all') renderAll(); else renderList(tab);
      if ($('exPreview') && !$('exPreview').hidden) paintPreview();
    }

    /* ─────────── 뒤로가기: 화면 이동 기록을 남겨 포탈 대신 직전 화면으로 돌아간다 ─────────── */
    const navState = () => ({ ex: 1, tab, campus: G.campus, acct: acctFilter, all: allStatus });
    function pushNav() {
      const cur = history.state, now = navState();
      if (cur && cur.ex && ['tab', 'campus', 'acct', 'all'].every(k => cur[k] === now[k])) return;
      history.pushState(now, '');
    }
    addEventListener('popstate', async e => {
      const st = e.state;
      if (!st || !st.ex || !me) return;
      G.campus = st.campus; acctFilter = st.acct; allStatus = st.all;
      if (st.tab === 'new' && !form) form = newForm();
      await show(st.tab);
    });

    /* 선교 항목·계좌 칸에 포커스가 가면 작성 안내를 말풍선으로 보여준다 (자동완성 목록과 겹치지 않게 칸 위쪽에) */
    let srcTipEl = null, srcTipFor = null;
    function placeSrcTip() {
      if (!srcTipEl || !srcTipFor) return;
      const r = srcTipFor.getBoundingClientRect(), tip = srcTipEl;
      tip.style.maxWidth = Math.min(460, innerWidth - 24) + 'px';
      const h = tip.offsetHeight, above = r.top > h + 16;
      tip.style.left = Math.max(12, Math.min(r.left, innerWidth - tip.offsetWidth - 12)) + 'px';
      tip.style.top = (above ? r.top - h - 10 : r.bottom + 10) + 'px';
      tip.dataset.pos = above ? 'above' : 'below';
    }
    function showSrcTip(input) {
      if (!srcTipEl) { srcTipEl = document.createElement('div'); srcTipEl.className = 'ex-tip'; srcTipEl.setAttribute('role', 'tooltip'); document.body.appendChild(srcTipEl); }
      srcTipFor = input; srcTipEl.innerHTML = t('srcTip'); srcTipEl.hidden = false; placeSrcTip();
    }
    function hideSrcTip() { if (srcTipEl) srcTipEl.hidden = true; srcTipFor = null; }
    document.addEventListener('focusin', e => { if (e.target.matches?.('[data-f="source"]')) showSrcTip(e.target); });
    document.addEventListener('focusout', e => { if (e.target.matches?.('[data-f="source"]')) hideSrcTip(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') hideSrcTip(); });
    addEventListener('scroll', placeSrcTip, { passive: true });
    addEventListener('resize', placeSrcTip);

    /* ─────────── 이벤트 ─────────── */
    document.addEventListener('click', async e => {
      const lb = e.target.closest('[data-lang]');
      if (lb) return setLang(lb.dataset.lang);
      const tabBtn = e.target.closest('[data-tab]');
      if (tabBtn) { if (tabBtn.dataset.tab === 'new' && !form) form = newForm(); tab = tabBtn.dataset.tab; pushNav(); return show(tabBtn.dataset.tab); }
      const gc = e.target.closest('[data-gcampus]');
      if (gc) { G.campus = gc.dataset.gcampus; pushNav(); return renderGrouped(tab); }
      const xl = e.target.closest('[data-act="xlsx-rep"]');
      if (xl) { const r = [...data.all, ...data.accounting].find(x => x.id === xl.dataset.id); if (r) exportXlsxForm([r], r.submitterName); return; }
      const tg = e.target.closest('[data-toggle]');
      if (tg) {
        const rid = tg.dataset.toggle, box = document.getElementById('d-' + rid);
        const open = box.hidden; box.hidden = !open; tg.setAttribute('aria-expanded', String(open));
        if (open) G.open.add(rid); else G.open.delete(rid);
        return;
      }
      const pb = e.target.closest('[data-period]');
      if (pb) { period = pb.dataset.period === 'all' ? { from: '', to: '' } : monthRange(pb.dataset.period === 'last' ? -1 : 0); return rerenderStats(); }
      const sb = e.target.closest('[data-allstatus]');
      if (sb) { allStatus = sb.dataset.allstatus; pushNav(); return renderAll(); }
      const f = e.target.closest('[data-filter]');
      if (f) { acctFilter = f.dataset.filter; pushNav(); if (acctFilter === 'trash') { try { data.trash = (await api('/api/expense/reports?scope=trash')).trash; } catch (er) { toast(er.message, true); } } return renderList('accounting'); }

      const el = e.target.closest('[data-act]');
      if (!el) return;
      const act = el.dataset.act, i = +el.dataset.i, id = el.dataset.id;
      const find = mode => data[mode].find(r => r.id === id);

      try {
        if (act === 'add-row') { form.rows.push(blankRow(form.rows[form.rows.length - 1])); renderNew(); }
        else if (act === 'del-row') { form.rows.splice(i, 1); renderNew(); }
        else if (act === 'toggle-more') { form.rows[i].more = !form.rows[i].more; $('fRows').innerHTML = form.rows.map(rowHtml).join(''); refreshComputed(); }
        else if (act === 'del-receipt') {
          form.rows[i].receipts.splice(+el.dataset.k, 1);
          $('fRows').innerHTML = form.rows.map(rowHtml).join(''); refreshComputed();
        }
        else if (act === 'submit') await submitForm();
        else if (act === 'cancel-edit') { form = newForm(); renderTabs(); renderNew(); }
        else if (act === 'reset-draft') { if (!confirm(t('cResetDraft'))) return; form = newForm(); saveDraft(); renderNew(); }
        else if (act === 'open-receipt') openReceiptFrom(el);
        else if (act === 'edit') { form = formFromReport(find('mine'), false); tab = 'new'; renderTabs(); renderNew(); window.scrollTo({ top: 0 }); }
        else if (act === 'copy') { form = formFromReport(find('mine'), true); tab = 'new'; renderTabs(); renderNew(); window.scrollTo({ top: 0 }); toast(t('tCopied')); }
        else if (act === 'withdraw') {
          if (!confirm(t('cWithdraw'))) return;
          await api('/api/expense/reports?id=' + encodeURIComponent(id), { method: 'DELETE' });
          toast(t('tWithdrawn')); await show('mine');
        }
        else if (act === 'approve') {
          const st = catState[id];
          if (!st || !approvalReady(st)) { toast(t('catNeed'), true); return; }
          await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'approve', delegate: st.delegated, categories: st.accounts.map((a, i) => (st.delegated && !st.confirmed[i] ? '' : a)), approverMemos: st.memos, checks: st.confirmed.map((c, i) => c || autoRow(st, i)), autoChecks: st.confirmed.map((c, i) => autoRow(st, i)) }) });
          delete catState[id]; toast(t('tApproved')); await show('approve');
        }
        else if (act === 'reject') {
          const note = prompt(t('pReject')); if (note === null) return;
          await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'reject', note }) }); toast(t('tRejected')); await show('approve');
        }
        else if (act === 'process') {
          if (!confirm(t('cProcess'))) return;
          await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'process' }) }); toast(t('tProcessed')); await show('accounting');
        }
        else if (act === 'acct-return') {
          const note = prompt(t('pReturn')); if (note === null || !note.trim()) return;
          await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'return', note: note.trim() }) });
          toast(t('tReturned')); await show(tab === 'all' ? 'all' : 'accounting');
        }
        else if (act === 'trash') {
          if (!confirm(t('cTrash'))) return;
          await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'trash' }) }); toast(t('tTrashed')); await show(tab === 'all' ? 'all' : 'accounting');
        }
        else if (act === 'restore') {
          if (!confirm(t('cRestore'))) return;
          await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'restore' }) }); toast(t('tRestored'));
          data.trash = (await api('/api/expense/reports?scope=trash')).trash; await show('accounting'); acctFilter = 'trash'; renderList('accounting');
        }
        else if (act === 'trash-all') {
          const typed = prompt(t('cTrashAll')); if (typed === null) return;
          if (!['삭제', 'DELETE'].includes(typed.trim())) return;
          let total = 0, remaining = 1;
          while (remaining > 0) {
            const out = await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ action: 'trash-all', confirm: 'DELETE-ALL' }) });
            total += out.count; remaining = out.count ? out.remaining : 0;
            toast(t('tTrashAll', total));
          }
          data.trash = []; await show('accounting');
        }
        else if (act === 'recat-save') {
          const box = el.closest('[data-recat]');
          const cats = [...box.querySelectorAll('[data-recat-i]')].map(s => s.value);
          if (cats.some(c => !c)) { toast(t('catNeedAll'), true); return; }
          const out = await api('/api/expense/reports', { method: 'PATCH', body: JSON.stringify({ id, action: 'recategorize', categories: cats }) });
          [data.all, data.accounting].forEach(list => { const i = list.findIndex(x => x.id === id); if (i >= 0) list[i] = { ...list[i], rows: out.report.rows }; });
          toast(t('tRecat', out.changed)); renderGrouped(tab);
        }
        else if (act === 'csv-g') exportCsv(gFiltered(tab, G.campus));
        else if (act === 'confirm-cat') {
          const st = catState[id]; if (!st) return;
          if (!st.accounts[i] && !(st.delegated && st.needCheck[i])) { toast(t('catPick'), true); return; }
          st.confirmed[i] = !st.confirmed[i]; paintApproval(id);
        }
        else if (act === 'delegate') {
          const st = catState[id]; if (!st) return;
          st.delegated = !st.delegated;
          renderList('approve');
        }
        else if (act === 'confirm-all') {
          const st = catState[id]; if (!st) return;
          if (st.accounts.some(a => !a)) { toast(t('catNeed'), true); return; }
          st.confirmed = st.confirmed.map(() => true); paintApproval(id);
        }
      } catch (err) { toast(err.message, true); }
      scheduleDraft();
    });

    const rerenderStats = () => (tab === 'all' ? renderAll() : renderList('accounting'));
    document.addEventListener('keydown', e => { if ((e.key === 'Enter' || e.key === ' ') && e.target.matches?.('.ex-sub-dl')) { e.preventDefault(); e.target.click(); } });
    document.addEventListener('change', e => {
      const sel = e.target.closest('[data-cat]');
      if (sel) { const st = catState[sel.dataset.repid]; if (st) { st.accounts[+sel.dataset.cat] = sel.value; st.confirmed[+sel.dataset.cat] = false; paintApproval(sel.dataset.repid); } }
      else if (e.target.id === 'pFrom' || e.target.id === 'pTo') { period[e.target.id === 'pFrom' ? 'from' : 'to'] = e.target.value; rerenderStats(); }
    });

    document.addEventListener('input', e => {
      const el = e.target;
      if (el.dataset.amemo !== undefined) { const st = catState[el.dataset.repid]; if (st) st.memos[+el.dataset.amemo] = el.value; return; }
      if (el.id === 'fDesc') form.description = el.value;
      else if (el.id === 'fProject') form.project = el.value;
      else if (el.dataset.f) {
        const rowEl = el.closest('.ex-row'); if (!rowEl) return;
        const r = form.rows[+rowEl.dataset.i], f = el.dataset.f;
        if (f === 'srcSel') {
          const txt = rowEl.querySelector('[data-f="source"]');
          el.closest('.ex-srcwrap').classList.toggle('is-custom', el.value === SRC_CUSTOM);
          if (el.value === SRC_CUSTOM) { r.srcCustom = true; r.source = ''; txt.value = ''; txt.hidden = false; txt.focus(); }
          else { r.srcCustom = false; r.source = el.value; txt.hidden = true; hideSrcTip(); el.classList.remove('is-empty'); }
        }
        else if (f === 'receipt') { uploadReceipts(+rowEl.dataset.i, [...el.files]); el.value = ''; }
        else if (f === 'currency') { r.currency = el.value; if (isFx(r.currency)) { r.rate = ''; scheduleRate(r, true); } else r.rateNote = null; refreshComputed(); }
        else if (f === 'when') { r.when = el.value; if (isFx(r.currency)) { r.rate = ''; scheduleRate(r); } }
        else if (f === 'rate') { r.rate = el.value; r.rateNote = { k: 'rateManual' }; const n = rowEl.querySelector('[data-r-note]'); if (n) n.textContent = ' · ' + t('rateManual'); refreshComputed(); }
        else { r[f] = el.value; refreshComputed(); }
      }
      scheduleDraft();
    });

    /* ─────────── 시작 ─────────── */
    (async function init() {
      applyStatic();
      if (!token()) return location.replace('/portal');
      try {
        await refreshCounts();
        form = newForm();
        const draft = loadDraft();
        if (draft) { form = draft; await show('new'); history.replaceState(navState(), ''); toast(t('tDraftRestored')); return; }
        await show(counts.approve > 0 && me.isApprover ? 'approve' : (counts.accounting > 0 && me.isAccountant ? 'accounting' : 'new'));
        history.replaceState(navState(), '');
      } catch (e) { toast(e.message, true); }
    })();
  </script>
</body>
</html>
