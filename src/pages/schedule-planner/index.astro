    }

    function renderDay() {
      const date = els.selectedDate.value;
      const dayEvents = sortedEvents(filteredEvents().filter(event => event.date === date));
      const ko = currentLang === 'ko';
      const periods = [
        { key:'am',      label: ko ? '오전' : 'Morning' },
        { key:'pm',      label: ko ? '오후' : 'Afternoon' },
        { key:'evening', label: ko ? '저녁' : 'Evening' },
        { key:'none',    label: ko ? '시간 미정' : 'Unscheduled' },
      ];
      const grouped = {};
      dayEvents.forEach(e => {
        const p = periodOf(e);
        if (!grouped[p]) grouped[p] = [];
        grouped[p].push(e);
      });
      const body = dayEvents.length
        ? `<div class="tl">
            ${periods.filter(p => (grouped[p.key] || []).length).map(p => `
              <div class="tl-period">${escapeHtml(p.label)}</div>
              ${grouped[p.key].map(event => `
                <div class="tl-row">
                  <div class="tl-time">${escapeHtml(eventTime(event))}</div>
                  <div class="tl-card ${escapeHtml(event.type || '')}" data-edit="${escapeHtml(event.id)}">
                    <div>
                      <div class="tl-card-title">${escapeHtml(evText(event, 'title'))}<span class="tl-type-badge">${escapeHtml(typeLabel(event.type))}</span></div>
                      ${eventMeta(event) ? `<div class="tl-card-meta">${eventMeta(event)}</div>` : ''}
                    </div>
                    <button type="button" class="tl-edit-btn" data-edit="${escapeHtml(event.id)}">${escapeHtml(tr('edit'))}</button>
                  </div>
                </div>
              `).join('')}
            `).join('')}
          </div>`
        : `<div class="empty">${escapeHtml(tr('noDayEvents'))}</div>`;
      document.getElementById('view-day').innerHTML = `
        <div class="tab-section">
          <div class="tab-head">
            <div class="day-nav-wrap">
              <button type="button" class="day-nav-btn" data-day-nav="-1">&#8249;</button>
              <div>
                <div class="tab-title">${escapeHtml(tr('dayTitle', dayName(date)))}</div>
                <div class="tab-subtitle">${escapeHtml(date)}</div>
              </div>
              <button type="button" class="day-nav-btn" data-day-nav="1">&#8250;</button>
            </div>
            <span class="tab-count">${dayEvents.length}</span>
          </div>
          ${body}
        </div>
      `;
    }

    function dowShort(iso) {
      return new Intl.DateTimeFormat(currentLang === 'ko' ? 'ko-KR' : 'en-US', { weekday: 'short' }).format(new Date(`${iso}T00:00:00`));
    }
    function pdfDates() {
      const fromPdfs = normalizeSchedulePdfs().map(pdf => pdf.date);
      const fromEvents = [...(plan.events || []), ...(plan.transportPlans || [])].map(item => item.date);
      const dates = [...new Set([els.selectedDate.value || todayIso(), ...fromPdfs, ...fromEvents].filter(Boolean))].sort();
      return dates;
    }

