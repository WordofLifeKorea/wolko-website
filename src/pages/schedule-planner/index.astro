---
const pageTitle = 'WOLKO Schedule Planner';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Noto+Sans+KR:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolko-auth.css?v=1">
  <style is:global>
    :root {
      --blue:#004f68;
      --blue-lt:#0077a3;
      --teal:#009b94;
      --bg:#f4f6f8;
      --card:#fff;
      --border:#e4eaee;
      --text:#1a2d38;
      --muted:#6c8290;
      --light:#8fa8b5;
      --red:#c42a36;
      --green:#239c5d;
      --orange:#d9870d;
      --shadow:0 2px 12px rgba(0,79,104,.05);
      --shadow-card:0 10px 28px rgba(0,79,104,.07);
      --shadow-soft:0 4px 14px rgba(0,79,104,.045);
      --radius-lg:20px;
      --radius-md:14px;
      --radius-sm:12px;
      --space-page:28px;
      --space-card:20px;
      --sans:'Montserrat',sans-serif;
      --body:'Noto Sans KR',sans-serif;
    }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; background:var(--bg); color:var(--text); font-family:var(--body); line-height:1.5; }
    button,input,select,textarea { font:500 13px/1.35 var(--body); }
    button { cursor:pointer; }
    .login-screen {
      position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:20px;
      background:linear-gradient(145deg,#003d52,#00627f);
    }
    .login-screen.hidden { opacity:0; pointer-events:none; transition:.3s ease; }
    .login-card {
      width:min(420px,100%); border-radius:24px; background:#fff; padding:42px 36px 34px; text-align:center;
      box-shadow:0 24px 70px rgba(0,0,0,.24);
    }
    .login-logo { display:flex; align-items:center; justify-content:center; gap:12px; margin-bottom:22px; }
    .login-logo img { height:38px; }
    .login-logo-name { color:var(--blue); font:800 19px/1 var(--sans); letter-spacing:.02em; }
    .login-title { margin:0 0 26px; color:var(--muted); font-size:13px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; }
    .login-input { width:100%; height:52px; border:1.5px solid #d7e2e7; border-radius:14px; padding:0 16px; outline:none; }
    .login-input:focus { border-color:var(--blue); }
    .login-error { min-height:20px; margin:10px 0 14px; color:var(--red); font-size:12px; font-weight:500; }
    .login-btn,.primary {
      min-height:40px; border:0; border-radius:var(--radius-sm); background:var(--blue); color:#fff; padding:10px 18px;
      font-weight:700; letter-spacing:.01em; transition:background .18s ease,transform .12s ease,box-shadow .18s ease;
    }
    .login-btn { width:100%; height:48px; }
    .login-close-btn { width:100%; margin-top:10px; }
    .login-btn:hover,.primary:hover { background:var(--blue-lt); }
    .secondary,.ghost {
      min-height:40px; border:1px solid #d7e4e9; border-radius:var(--radius-sm); background:#fff; color:var(--blue);
      padding:9px 14px; font-weight:600; letter-spacing:.01em; transition:border-color .18s ease,background .18s ease,color .18s ease;
    }
    .ghost { background:#f8fbfc; color:var(--muted); }
    .secondary:hover,.ghost:hover { border-color:#b8d6df; background:#f7fbfd; color:var(--blue); }
    .danger { color:var(--red); border-color:#f1c9cf; background:#fff8f9; }
    .topbar {
      position:sticky; top:0; z-index:50; min-height:64px; display:flex; align-items:center; justify-content:space-between; gap:18px;
      padding:10px 32px; background:var(--blue); color:#fff; box-shadow:0 2px 12px rgba(0,79,104,.25);
    }
    .brand { display:flex; align-items:center; gap:10px; min-width:0; }
    .brand img { height:30px; flex:0 0 auto; }
    .brand h1 { margin:0; color:rgba(255,255,255,.92); font:700 14px/1 var(--sans); letter-spacing:.04em; }
    .brand p { margin:3px 0 0; color:rgba(255,255,255,.62); font:500 10px/1 var(--sans); letter-spacing:.08em; text-transform:uppercase; }
    .toolbar { display:flex; align-items:center; justify-content:flex-end; gap:8px; flex-wrap:wrap; min-width:0; }
    .toolbar button,.toolbar input,.toolbar select {
      min-height:34px; border:1px solid rgba(255,255,255,.25); border-radius:100px; padding:6px 12px;
      background:rgba(255,255,255,.15); color:#fff; font-size:12px; font-weight:600;
    }
    .toolbar input { width:160px; color:#fff; color-scheme:dark; }
    .toolbar input[type="file"] { display:none; }
    .toolbar select { color-scheme:dark; cursor:pointer; max-width:200px; }
    #importHistoryDeleteBtn { background:rgba(239,68,68,.25); border-color:rgba(239,68,68,.4); padding:6px 11px; }
    #importHistoryDeleteBtn:hover { background:rgba(239,68,68,.45); }
    .date-picker {
      position:relative; flex:0 0 420px; max-width:100%; min-height:58px; padding:7px 9px 7px 12px;
      border:1px solid rgba(255,255,255,.48); border-radius:18px; background:#fff; color:var(--text);
      box-shadow:0 10px 26px rgba(0,30,44,.18);
    }
    .toolbar .date-picker-main {
      width:100%; min-height:44px; display:grid; grid-template-columns:34px minmax(0,1fr) auto; align-items:center; gap:10px;
      border:0; border-radius:14px; background:transparent; color:var(--text); padding:0; text-align:left;
    }
    .date-picker-icon {
      width:34px; height:34px; display:inline-flex; align-items:center; justify-content:center; border-radius:12px;
      background:linear-gradient(135deg,var(--blue),var(--blue-lt)); color:#fff; box-shadow:0 6px 14px rgba(0,79,104,.18);
    }
    .date-picker-icon svg { width:18px; height:18px; }
    .date-picker-copy { min-width:0; display:grid; gap:3px; }
    .date-picker-label {
      color:var(--light); font:800 10px/1 var(--sans); letter-spacing:.08em; text-transform:uppercase;
    }
    .date-summary {
      overflow:hidden; color:var(--blue); font:900 14px/1.2 var(--body); letter-spacing:-.01em;
      white-space:nowrap; text-overflow:ellipsis;
    }
    .date-picker-value {
      display:inline-flex; align-items:center; min-height:34px; border:1px solid #d9e5ea; border-radius:999px;
      background:#f8fbfc; color:var(--muted); padding:0 11px; font:800 12px/1 var(--sans); white-space:nowrap;
    }
    .date-picker input[type="hidden"] { display:none; }
    .calendar-popover {
      position:absolute; top:calc(100% + 9px); left:0; right:auto; z-index:160; width:100%; min-width:360px; max-width:calc(100vw - 36px);
      border:1px solid #d8e5ea; border-radius:20px; background:#fff; color:var(--text);
      box-shadow:0 24px 70px rgba(0,30,44,.28); padding:14px;
    }
    .calendar-popover::before {
      content:""; position:absolute; top:-7px; left:28px; width:14px; height:14px;
      border-left:1px solid #d8e5ea; border-top:1px solid #d8e5ea; background:#fff; transform:rotate(45deg);
    }
    .calendar-popover[hidden] { display:none; }
    .calendar-head { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:12px; }
    .calendar-title { color:var(--text); font:900 18px/1.1 var(--body); letter-spacing:-.03em; }
    .calendar-controls { display:flex; align-items:center; gap:6px; }
    .toolbar .calendar-nav,
    .toolbar .calendar-today {
      min-height:34px; border:1px solid #d8e5ea; border-radius:11px; background:#f8fbfc; color:var(--blue);
      padding:0 10px; font:900 12px/1 var(--body);
    }
    .toolbar .calendar-nav { width:34px; padding:0; }
    .toolbar .calendar-nav:hover,
    .toolbar .calendar-today:hover { border-color:#b8d6df; background:#eef8fb; }
    .calendar-weekdays,
    .calendar-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:6px; }
    .calendar-weekdays { margin-bottom:7px; }
    .calendar-weekday {
      display:flex; align-items:center; justify-content:center; height:24px; color:var(--light);
      font:900 11px/1 var(--sans); letter-spacing:.04em;
    }
    .toolbar .calendar-day {
      position:relative; min-height:42px; border:1px solid transparent; border-radius:13px; background:#fff; color:var(--text);
      padding:0; font:800 14px/1 var(--body); transition:background .15s,border-color .15s,color .15s,transform .15s;
    }
    .toolbar .calendar-day:hover { border-color:#b8d6df; background:#f3fbfd; color:var(--blue); transform:translateY(-1px); }
    .calendar-day.is-outside { color:#b7c4cb; }
    .calendar-day.is-today { border-color:#c9e8ef; background:#f3fbfd; color:var(--blue); }
    .calendar-day.is-selected { border-color:var(--blue); background:var(--blue); color:#fff; box-shadow:0 8px 18px rgba(0,79,104,.22); }
    .calendar-day-count {
      position:absolute; right:5px; bottom:5px; min-width:16px; height:16px; display:inline-flex; align-items:center; justify-content:center;
      border-radius:999px; background:#e3a60f; color:#fff; font:900 9px/1 var(--sans); padding:0 4px;
    }
    .calendar-day.is-selected .calendar-day-count { background:#fff; color:var(--blue); }
    .lang-toggle { min-width:42px; text-align:center; }
    .lang-toggle.active { background:#fff; color:var(--blue); }
    .page { max-width:min(1480px,calc(100vw - 32px)); margin:0 auto; padding:var(--space-page) 18px 90px; }
    .hero {
      display:grid; grid-template-columns:minmax(0,1fr) auto; gap:20px; align-items:end; margin-bottom:20px;
      padding:24px; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--card); box-shadow:var(--shadow-card);
    }
    .hero h2 { margin:0; color:var(--text); font:900 clamp(22px,3vw,30px)/1.18 var(--sans); letter-spacing:-.02em; }
    .hero p { margin:9px 0 0; max-width:780px; color:var(--muted); font-size:13.5px; line-height:1.7; font-weight:400; }
    .stats { display:flex; gap:10px; flex-wrap:wrap; justify-content:flex-end; }
    .stat { min-width:112px; border:1px solid var(--border); border-radius:var(--radius-md); background:#f8fafb; padding:13px 15px; text-align:right; }
    .stat strong { display:block; color:var(--blue); font:900 24px/1 var(--sans); letter-spacing:-.02em; }
    .stat span { display:block; margin-top:6px; color:var(--light); font:700 10px/1 var(--sans); letter-spacing:.08em; }
    .layout { display:grid; grid-template-columns:372px minmax(0,1fr); gap:20px; align-items:start; }
    .layout.sidebar-collapsed { grid-template-columns:0 minmax(0,1fr); gap:0; }
    .layout aside { overflow:hidden; transition:opacity .22s ease; }
    .layout.sidebar-collapsed aside { opacity:0; pointer-events:none; }
    .panel-collapse-btn {
      flex-shrink:0; width:28px; height:28px; display:flex; align-items:center; justify-content:center;
      border:1px solid var(--border); border-radius:8px; background:#f4f6f8; color:var(--muted);
      font-size:13px; cursor:pointer; transition:background .15s,color .15s;
    }
    .panel-collapse-btn:hover { background:var(--blue); color:#fff; border-color:var(--blue); }
    .sidebar-reopen-tab {
      position:fixed; left:0; top:50%; transform:translateY(-50%);
      z-index:90; display:none; writing-mode:vertical-rl; align-items:center; justify-content:center;
      background:var(--blue); color:#fff; border:none; border-radius:0 8px 8px 0;
      padding:16px 8px; font:600 11px/1 var(--body); letter-spacing:.06em; cursor:pointer;
      box-shadow:3px 0 14px rgba(0,79,104,.22);
    }
    body.sidebar-collapsed .sidebar-reopen-tab { display:flex; }
    .panel {
      border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--card); box-shadow:var(--shadow-card); overflow:hidden;
    }
    .panel-head {
      display:flex; align-items:center; justify-content:space-between; gap:12px; padding:18px var(--space-card); border-bottom:1px solid var(--border); background:#fff;
    }
    .panel-head h3 { margin:0; color:var(--text); font-size:16px; font-weight:700; letter-spacing:-.01em; }
    .panel-body { padding:var(--space-card); }
    .form-grid { display:grid; gap:14px; }
    .field { display:grid; gap:8px; }
    .field.two { grid-template-columns:1fr 1fr; gap:10px; }
    .field label { color:var(--muted); font-size:11.5px; font-weight:600; letter-spacing:.035em; }
    input,select,textarea {
      width:100%; min-height:42px; border:1.5px solid #d9e5ea; border-radius:var(--radius-sm); background:#fafcfd; color:var(--text);
      padding:10px 12px; outline:none; transition:border-color .18s ease,background .18s ease,box-shadow .18s ease;
    }
    textarea { min-height:92px; resize:vertical; line-height:1.65; }
    input:focus,select:focus,textarea:focus { border-color:var(--blue); background:#fff; box-shadow:0 0 0 3px rgba(0,79,104,.09); }
    .form-actions { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; margin-top:4px; }
    .schedule-tools { display:flex; align-items:center; justify-content:flex-end; gap:8px; flex-wrap:wrap; }
    .schedule-tools select {
      width:auto; min-width:150px; min-height:40px; border:1.5px solid #d9e5ea; border-radius:999px;
      background:#fff; color:var(--blue); padding:8px 34px 8px 13px; font-size:12px; font-weight:800;
    }
    .schedule-tools button {
      min-height:40px; border-radius:999px; padding:8px 14px; font-size:12px; font-weight:800;
    }
    .schedule-tools button:disabled,.schedule-danger-tools button:disabled { opacity:.45; cursor:not-allowed; }
    .schedule-danger-tools {
      display:flex; align-items:center; justify-content:flex-end; gap:8px; flex-wrap:wrap;
      padding:10px 16px; border-bottom:1px solid var(--border); background:#fff;
    }
    .schedule-danger-label {
      margin-right:auto; color:var(--light); font:800 10px/1 var(--sans); letter-spacing:.1em; text-transform:uppercase;
    }
    .schedule-danger-tools button {
      min-height:34px; border-radius:999px; padding:7px 12px; font-size:11.5px; font-weight:800;
    }
    .schedule-danger-tools .restore-btn { border-color:#b8dfe6; background:#e9f8fb; color:var(--blue); }
    .source-badge {
      display:inline-flex; align-items:center; margin-right:7px; border-radius:999px; background:#e9f8fb; color:var(--blue);
      padding:2px 8px; font-size:10px; font-weight:900; letter-spacing:.02em; vertical-align:middle;
    }
    .tabs { display:flex; gap:8px; flex-wrap:wrap; padding:14px 16px; border-bottom:1px solid var(--border); background:#fbfdfe; }
    .tab {
      display:inline-flex; align-items:center; justify-content:center;
      min-height:36px; border:1px solid #d7e4e9; border-radius:999px; background:#fff; color:var(--muted); padding:8px 14px;
      font-size:12px; font-weight:600; transition:border-color .18s ease,background .18s ease,color .18s ease,box-shadow .18s ease;
    }
    .tab:hover { border-color:#bed6df; background:#f7fbfd; color:var(--blue); }
    .tab.active { border-color:#b8dfe6; background:#e9f8fb; color:var(--blue); box-shadow:0 4px 12px rgba(0,79,104,.06); }
    .view { display:none; padding:18px; }
    .view.active { display:block; }
    .day-list { display:grid; gap:10px; }
    .schedule-card {
      display:grid; grid-template-columns:86px minmax(0,1fr) auto; gap:12px; align-items:center;
      border:1px solid #dfe9ee; border-left:6px solid var(--blue); border-radius:var(--radius-md); background:#fff; padding:14px 15px;
      box-shadow:var(--shadow-soft);
    }
    .schedule-card.transport { border-left-color:var(--orange); }
    .schedule-card.meeting { border-left-color:var(--teal); }
    .schedule-card.meal { border-left-color:var(--green); }
    .schedule-card.prep { border-left-color:#6366f1; }
    .schedule-card.free { border-left-color:#94a3b8; }
    .time { color:var(--blue); font:700 13px/1.35 var(--sans); }
    .item-title { font-size:14px; font-weight:700; color:var(--text); letter-spacing:-.01em; }
    .meta { margin-top:5px; color:var(--muted); font-size:12px; font-weight:400; line-height:1.55; }
    .mini-actions { display:flex; gap:6px; flex-wrap:wrap; justify-content:flex-end; }
    .mini-actions button { min-height:30px; border:1px solid #d8e5ea; border-radius:999px; background:#fff; color:var(--blue); padding:6px 10px; font-size:11px; font-weight:600; }
    /* ── Timeline (Day view) ─────────────────────────── */
    .tl { background:#fff; border:1px solid #dbe7ec; border-radius:var(--radius-lg); padding:4px 20px 20px; box-shadow:var(--shadow-soft); }
    .tl-period { font:600 10px/1 var(--sans); letter-spacing:.12em; text-transform:uppercase; color:var(--muted); padding:18px 0 10px; border-top:1px solid #edf2f5; }
    .tl-period:first-child { border-top:none; padding-top:14px; }
    .tl-row { display:grid; grid-template-columns:52px 1fr; gap:14px; align-items:center; padding:3px 0; }
    .tl-time { font:500 12px/1.4 var(--sans); color:var(--blue); text-align:right; letter-spacing:-.01em; white-space:nowrap; }
    .tl-card { display:grid; grid-template-columns:1fr auto; gap:10px; align-items:center; border-radius:12px; padding:11px 14px; cursor:pointer; transition:box-shadow .15s,transform .12s; background:#e9f8fb; }
    .tl-card:hover { transform:translateY(-1px); box-shadow:0 4px 18px rgba(0,0,0,.08); }
    .tl-card.meal { background:#f0fdf4; }
    .tl-card.transport { background:#fff7ed; }
    .tl-card.meeting { background:#f0fdfa; }
    .tl-card.prep { background:#f5f3ff; }
    .tl-card.free { background:#f8fafc; }
    .tl-card-title { font:600 13.5px/1.3 var(--sans); color:var(--text); letter-spacing:-.01em; }
    .tl-type-badge { display:inline-block; margin-left:7px; vertical-align:middle; font:500 10px/1 var(--sans); letter-spacing:.04em; border-radius:4px; padding:2px 6px; background:#b8eaf0; color:#004f68; }
    .tl-card.meal .tl-type-badge { background:#dcfce7; color:#166534; }
    .tl-card.transport .tl-type-badge { background:#ffedd5; color:#9a3412; }
    .tl-card.meeting .tl-type-badge { background:#ccfbf1; color:#0f766e; }
    .tl-card.prep .tl-type-badge { background:#ede9fe; color:#4338ca; }
    .tl-card.free .tl-type-badge { background:#f1f5f9; color:#64748b; }
    .tl-card-meta { margin-top:3px; font:400 11.5px/1.45 var(--sans); color:var(--muted); }
    .tl-edit-btn { flex-shrink:0; min-height:28px; border:1px solid rgba(0,0,0,.1); border-radius:999px; background:rgba(255,255,255,.7); color:var(--muted); padding:5px 10px; font-size:11px; font-weight:600; white-space:nowrap; }
    .week-grid { display:grid; grid-template-columns:repeat(7,minmax(200px,1fr)); gap:14px; overflow:auto; padding-bottom:6px; }
    .week-day {
      min-height:360px; border:1px solid #dbe7ec; border-radius:var(--radius-lg); background:#fff;
      overflow:hidden; box-shadow:var(--shadow-soft); display:flex; flex-direction:column;
    }
    .week-day.is-today { border-color:var(--blue); box-shadow:0 0 0 2px rgba(0,79,104,.15),var(--shadow-soft); }
    .week-day-head {
      display:flex; align-items:center; justify-content:space-between; gap:8px; padding:14px 16px;
      border-bottom:1px solid var(--border); background:#fff; flex-shrink:0;
    }
    .week-day.is-today .week-day-head { background:var(--blue); }
    .week-day-date { display:flex; flex-direction:column; gap:3px; }
    .week-day-dow { font:600 10px/1 var(--sans); letter-spacing:.1em; text-transform:uppercase; color:var(--muted); }
    .week-day.is-today .week-day-dow { color:rgba(255,255,255,.7); }
    .week-day-num { font:700 22px/1 var(--sans); letter-spacing:-.02em; color:var(--blue); }
    .week-day.is-today .week-day-num { color:#fff; }
    .week-count { flex:0 0 auto; border-radius:999px; background:#e9f8fb; color:var(--blue); padding:6px 10px; font-size:11px; font-weight:500; }
    .week-day.is-today .week-count { background:rgba(255,255,255,.25); color:#fff; }
    .week-items { display:flex; flex-direction:column; gap:7px; padding:12px; flex:1; }
    .week-item {
      border-left:4px solid var(--blue); border-radius:0 10px 10px 0;
      background:#f8fafb; padding:9px 11px; cursor:pointer;
      transition:transform .12s ease,box-shadow .12s ease,background .12s ease;
    }
    .week-item:hover { transform:translateX(3px); background:#fff; box-shadow:0 2px 10px rgba(0,79,104,.1); }
    .week-item.transport { border-left-color:#f97316; background:#fff7ed; }
    .week-item.meeting { border-left-color:#14b8a6; background:#f0fdfa; }
    .week-item.meal { border-left-color:#22c55e; background:#f0fdf4; }
    .week-item.prep { border-left-color:#6366f1; background:#f5f3ff; }
    .week-item.free { border-left-color:#94a3b8; background:#f8fafc; }
    .week-item-time { color:var(--muted); font:500 10px/1 var(--sans); letter-spacing:.02em; margin-bottom:5px; }
    .week-item-title { color:var(--text); font-size:12.5px; font-weight:600; line-height:1.38; word-break:keep-all; }
    .week-item-tag { display:inline-block; margin-top:5px; border-radius:4px; background:rgba(0,79,104,.07); color:var(--muted); padding:2px 6px; font-size:10px; font-weight:400; letter-spacing:.03em; }
    .week-empty {
      display:flex; align-items:center; justify-content:center; flex:1; min-height:80px;
      border:1.5px dashed #d5e4ea; border-radius:10px; color:var(--light); font-size:12px; font-weight:400;
    }
    .van-grid { display:grid; gap:12px; }
    .van-row { border:1px solid var(--border); border-radius:var(--radius-md); background:#fbfcfd; overflow:hidden; box-shadow:var(--shadow-soft); }
    .van-row-head { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:13px 15px; background:#fff; border-bottom:1px solid var(--border); }
    .van-row-head strong { color:var(--blue); font-weight:700; }
    .van-trips { display:grid; gap:9px; padding:12px 14px; }
    .van-trip { border-radius:var(--radius-sm); background:#fff4df; padding:10px 12px; font-size:12px; font-weight:400; line-height:1.55; }
    .tab-section { display:grid; gap:14px; }
    .tab-head {
      display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;
      border:1px solid #dbe7ec; border-radius:var(--radius-lg); background:linear-gradient(135deg,#fff,#f4fbfd); padding:15px 17px;
      box-shadow:var(--shadow-soft);
    }
    .tab-title { color:var(--blue); font:700 16px/1.2 var(--sans); letter-spacing:-.01em; }
    .tab-subtitle { margin-top:5px; color:var(--muted); font-size:12px; font-weight:400; line-height:1.45; }
    .tab-count { border-radius:999px; background:#e9f8fb; color:var(--blue); padding:6px 11px; font-size:11px; font-weight:500; }
    .day-nav-wrap { display:flex; align-items:center; gap:10px; }
    .day-nav-btn { width:32px; height:32px; border:1px solid #dbe7ec; border-radius:8px; background:#fff; color:var(--blue); font-size:14px; cursor:pointer; display:flex; align-items:center; justify-content:center; transition:background .15s,border-color .15s; flex-shrink:0; }
    .day-nav-btn:hover { background:#e9f8fb; border-color:var(--blue); }
    .table-card { border:1px solid #dbe7ec; border-radius:var(--radius-lg); background:#fff; overflow:hidden; box-shadow:var(--shadow-soft); }
    .list-table,.workbook-table { width:100%; border-collapse:separate; border-spacing:0; min-width:760px; background:#fff; }
    .list-table th,.list-table td,.workbook-table th,.workbook-table td {
      border-bottom:1px solid #edf3f6; padding:12px 14px; text-align:left; vertical-align:top; font-size:12px; line-height:1.55;
    }
    .list-table th,.workbook-table th {
      position:sticky; top:0; z-index:1; color:var(--blue); background:#f4fbfd; font-weight:700; letter-spacing:.02em;
    }
    .list-table tbody tr:hover,.workbook-table tbody tr:hover { background:#fbfdfe; }
    .workbook-title {
      border-bottom:1px solid #edf3f6; background:#fbfdfe; color:var(--blue); padding:12px 14px;
      font-size:13px; font-weight:700;
    }
    .matrix { display:grid; gap:14px; }
    .matrix-card { border:1px solid #dbe7ec; border-radius:var(--radius-lg); background:#fff; overflow:hidden; box-shadow:var(--shadow-soft); }
    .matrix-head {
      display:flex; align-items:center; justify-content:space-between; gap:10px; padding:15px 17px;
      background:linear-gradient(135deg,#eaf8fb,#fff); color:var(--blue); font-weight:700;
    }
    .matrix-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(220px,1fr)); gap:12px; padding:14px; border-top:1px solid var(--border); background:#fbfdfe; }
    .matrix-van { min-height:180px; border:1px solid #dbe7ec; border-radius:var(--radius-md); background:#fff; padding:14px; box-shadow:var(--shadow-soft); }
    .matrix-van strong { display:block; color:var(--blue); margin-bottom:10px; font-size:14px; }
    .matrix-van textarea { min-height:104px; margin-top:8px; }
    .section-divider { height:1px; background:var(--border); margin:18px 0; }
    .scroll-x { overflow:auto; border:0; border-radius:0; }
    .van-editor { display:grid; gap:12px; }
    .van-edit-row {
      display:grid; grid-template-columns:minmax(0,1.2fr) 80px minmax(0,1fr) auto; gap:10px; align-items:center;
      border:1px solid #dbe7ec; border-radius:var(--radius-md); background:#fff; padding:12px; box-shadow:var(--shadow-soft);
    }
    .empty { padding:28px; border:1px dashed #ccdce3; border-radius:var(--radius-md); color:var(--light); text-align:center; font-weight:400; background:#fbfdfe; }
    .save-state { color:rgba(255,255,255,.7); font-size:11px; font-weight:400; max-width:420px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; flex-shrink:1; min-width:0; }
    .print-summary { display:none; }
    @media (max-width:1100px) {
      .layout { grid-template-columns:1fr; }
      .hero { grid-template-columns:1fr; }
      .stats { justify-content:flex-start; }
    }
    @media (max-width:720px) {
      :root { --space-page:20px; --space-card:16px; }
      .topbar { height:auto; min-height:60px; align-items:flex-start; flex-direction:column; padding:14px 18px; }
      .toolbar { justify-content:flex-start; }
      .toolbar button,.toolbar input { min-height:32px; font-size:11.5px; }
      .date-picker {
        width:100%; flex:1 1 100%; padding:10px;
      }
      .toolbar .date-picker-main { grid-template-columns:34px minmax(0,1fr); }
      .date-picker-value { grid-column:1 / -1; justify-content:center; min-height:36px; }
      .calendar-popover { left:50%; right:auto; width:100%; min-width:0; max-width:100%; transform:translateX(-50%); }
      .calendar-popover::before { left:24px; }
      .date-summary { font-size:15px; }
      .page { max-width:100%; padding:20px 12px 70px; }
      .hero { border-radius:18px; padding:18px; }
      .hero h2 { font-size:22px; }
      .hero p { font-size:13px; }
      .stats { width:100%; }
      .stat { flex:1 1 30%; min-width:0; text-align:left; }
      .panel { border-radius:18px; }
      .panel-head { padding:16px; }
      .schedule-tools { width:100%; justify-content:flex-start; }
      .schedule-tools select { flex:1 1 160px; min-width:0; }
      .schedule-danger-tools { justify-content:flex-start; padding:10px 12px; }
      .schedule-danger-label { flex:1 1 100%; margin-right:0; }
      .view { padding:14px; }
      .tabs { padding:12px; }
      .tab { flex:1 1 calc(50% - 8px); justify-content:center; }
      .tab-head { border-radius:14px; padding:13px; }
      .tab-title { font-size:15px; }
      .table-card { border-radius:14px; }
      .matrix-grid { grid-template-columns:1fr; padding:12px; }
      .matrix-head { align-items:flex-start; flex-direction:column; }
      .schedule-card { grid-template-columns:1fr; }
      .mini-actions { justify-content:flex-start; }
      .field.two,.van-edit-row { grid-template-columns:1fr; }
      .week-grid { grid-template-columns:1fr; gap:12px; overflow:visible; }
      .week-day { min-height:0; border-radius:18px; }
      .week-day-head { padding:14px 16px; }
      .week-day-num { font-size:20px; }
      .week-items { padding:10px; }
      .week-item { padding:10px 12px; }
      .week-item-title { font-size:14px; }
      .week-empty { min-height:58px; }
    }
    @media print {
      @page { size:A4 landscape; margin:9mm; }
      * { -webkit-print-color-adjust:exact; print-color-adjust:exact; }
      body { background:#fff; color:#111827; font-size:9.5px; }
      .login-screen,
      .topbar,
      .layout > aside,
      .tabs,
      .schedule-tools,
      .panel-head .form-actions,
      .mini-actions,
      .save-state { display:none !important; }
      .page { max-width:none; width:100%; padding:0; }
      .hero {
        display:block; margin:0 0 6mm; padding:0 0 4mm; border:0; border-bottom:2px solid #004f68;
        border-radius:0; box-shadow:none;
      }
      .hero h2 { font-size:18px; line-height:1.15; }
      .hero p { display:none; }
      .stats { display:none; }
      .print-summary { display:block; margin-top:2mm; color:#334155; font-size:9px; font-weight:700; }
      .layout { display:block; }
      .panel { border:0; border-radius:0; box-shadow:none; overflow:visible; }
      .panel > .panel-head { display:block; padding:0 0 3mm; border:0; }
      .panel > .panel-head h3 { font-size:12px; color:#004f68; }
      .view { display:none !important; padding:0; }
      .view.active { display:block !important; }
      .day-list { gap:2mm; }
      .schedule-card {
        break-inside:avoid; page-break-inside:avoid; grid-template-columns:18mm minmax(0,1fr); gap:3mm;
        border:1px solid #cbd5e1; border-left:4px solid #004f68; border-radius:5px; padding:2.2mm 2.6mm;
      }
      .time { font-size:9px; color:#004f68; }
      .item-title { font-size:10px; }
      .meta { font-size:8.5px; line-height:1.35; margin-top:1mm; }
      .tl { border:0; border-radius:0; box-shadow:none; padding:0; display:flex; flex-direction:column; gap:0; }
      .tl-period { padding:2mm 0 1mm; border-top:1px solid #e2e8f0; font-size:7px; color:#64748b; }
      .tl-period:first-child { border-top:0; padding-top:0; }
      .tl-row { grid-template-columns:14mm 1fr; gap:2mm; padding:1px 0; }
      .tl-time { font-size:8px; }
      .tl-card { display:grid; grid-template-columns:1fr; gap:2mm; border-radius:3px; padding:1.5mm 2mm; break-inside:avoid; }
      .tl-card-title { font-size:8.5px; }
      .tl-type-badge { font-size:7px; padding:1px 3px; margin-left:4px; }
      .tl-card-meta { font-size:7.5px; margin-top:0.5mm; }
      .tl-edit-btn { display:none; }
      .week-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:1.8mm; overflow:visible; }
      .week-day { min-height:0; border:1px solid #cbd5e1; border-radius:4px; break-inside:avoid; page-break-inside:avoid; display:block; }
      .week-day-head { padding:1.6mm; color:#004f68; }
      .week-day-dow { font-size:7px; }
      .week-day-num { font-size:11px; }
      .week-items { gap:1.2mm; padding:1.5mm; }
      .week-item { border-left:3px solid #004f68; border-radius:0 3px 3px 0; background:#eef8fb; padding:1.4mm; font-size:7.8px; line-height:1.25; }
      .week-item-time { font-size:7px; margin-bottom:1px; }
      .week-item-title { font-size:7.8px; }
      .week-item-tag { display:none; }
      .van-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:2mm; }
      .van-row { border:1px solid #cbd5e1; border-radius:5px; break-inside:avoid; page-break-inside:avoid; }
      .van-row-head { padding:2mm; }
      .van-trips { gap:1.5mm; padding:2mm; }
      .van-trip { border:1px solid #ead7ad; border-radius:4px; background:#fff7df; padding:1.8mm; font-size:8px; line-height:1.35; }
      .scroll-x { overflow:visible; border:0; }
      .list-table { min-width:0; width:100%; table-layout:fixed; }
      .list-table th,
      .list-table td { padding:1.7mm 1.4mm; font-size:7.8px; line-height:1.25; word-break:break-word; }
      .list-table th { background:#eef8fb; color:#004f68; }
      .workbook-title { padding:1.8mm; font-size:10px; }
      .workbook-table { min-width:0; table-layout:fixed; }
      .workbook-table th,.workbook-table td { padding:1.8mm 1.5mm; font-size:8px; line-height:1.28; word-break:break-word; }
      .list-table th:nth-child(8),
      .list-table td:nth-child(8),
      .workbook-table th:last-child,
      .workbook-table td:last-child { display:none; }
      .matrix-grid { grid-template-columns:repeat(4,1fr); }
      .matrix-card { break-inside:avoid; page-break-inside:avoid; }
      .matrix-head { padding:1.8mm; font-size:9px; }
      .matrix-van { min-height:0; padding:1.8mm; font-size:8px; }
      .matrix-van textarea,
      .matrix-van input,
      .matrix-head button { display:none; }
      #view-fleet .van-editor { display:grid; grid-template-columns:repeat(2,1fr); gap:2mm; }
      #view-fleet .van-edit-row { display:block; border:1px solid #cbd5e1; border-radius:5px; padding:2mm; }
      #view-fleet input,
      #view-fleet button { display:none; }
      #view-fleet .van-edit-row::before { content:'차량'; display:block; color:#004f68; font-weight:900; }
    }
    .sp-dialog-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:999; display:flex; align-items:center; justify-content:center; }
    .sp-dialog { background:#fff; border-radius:16px; padding:28px 28px 20px; max-width:360px; width:90%; box-shadow:0 8px 40px rgba(0,0,0,.18); }
    .sp-dialog-title { font:700 16px/1.3 var(--sans); color:var(--blue); margin-bottom:8px; }
    .sp-dialog-msg { font-size:13.5px; color:var(--text); line-height:1.6; margin-bottom:22px; }
    .sp-dialog-btns { display:flex; gap:8px; justify-content:flex-end; flex-wrap:wrap; }
    .sp-dialog-btns button { border-radius:100px; padding:8px 18px; font:600 13px/1 var(--sans); cursor:pointer; border:1px solid transparent; }
    .sp-btn-yes { background:var(--blue); color:#fff; }
    .sp-btn-yes:hover { background:#004f68; }
    .sp-btn-no { background:#f1f5f9; color:var(--text); border-color:#dbe7ec; }
    .sp-btn-no:hover { background:#e2eaf0; }
    .sp-btn-cancel { background:transparent; color:var(--muted); border-color:#dbe7ec; }
    .sp-btn-cancel:hover { background:#f8fafc; }
  </style>
</head>
<body>
  <div class="login-screen hidden" id="loginScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-ko="스케줄 플래너 로그인" data-en="Schedule Planner Login">스케줄 플래너 로그인</p>
      <p class="login-description" data-ko="스태프 일정과 차량 운영 계획을 관리합니다." data-en="Manage staff schedules and van operations.">스태프 일정과 차량 운영 계획을 관리합니다.</p>
      <input class="login-input" id="passwordInput" type="password" data-ph-ko="관리자 비밀번호" data-ph-en="Admin password" placeholder="관리자 비밀번호" autocomplete="current-password">
      <p class="login-error" id="loginError"></p>
      <button class="login-btn" id="loginBtn" type="button" data-ko="로그인" data-en="Sign In">로그인</button>
      <button class="ghost login-close-btn" id="loginCloseBtn" type="button" data-ko="보기로 돌아가기" data-en="Back to View">보기로 돌아가기</button>
    </div>
  </div>

  <header class="topbar">
    <div class="brand">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <div>
        <h1 data-ko="WOLKO 스케줄 플래너" data-en="WOLKO Schedule Planner">WOLKO 스케줄 플래너</h1>
        <p data-ko="스태프 & 차량 운영" data-en="Staff & Vans Operations">스태프 & 차량 운영</p>
      </div>
    </div>
    <div class="toolbar">
      <div class="date-picker" id="datePicker">
        <button class="date-picker-main" id="calendarToggle" type="button" aria-haspopup="dialog" aria-expanded="false">
          <span class="date-picker-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <rect x="4" y="5.5" width="16" height="14" rx="2.5" stroke="currentColor" stroke-width="2"/>
              <path d="M8 3.5v4M16 3.5v4M4.5 10h15" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="date-picker-copy">
            <span class="date-picker-label" data-ko="기준 날짜" data-en="Schedule Date">기준 날짜</span>
            <span class="date-summary" id="dateSummary">-</span>
          </span>
          <span class="date-picker-value" id="dateValue">-</span>
        </button>
        <input id="selectedDate" type="hidden">
        <div class="calendar-popover" id="calendarPopover" role="dialog" aria-label="Schedule calendar" hidden>
          <div class="calendar-head">
            <strong class="calendar-title" id="calendarTitle">-</strong>
            <div class="calendar-controls">
              <button class="calendar-nav" id="calendarPrev" type="button" aria-label="Previous month">‹</button>
              <button class="calendar-today" id="calendarToday" type="button" data-ko="오늘" data-en="Today">오늘</button>
              <button class="calendar-nav" id="calendarNext" type="button" aria-label="Next month">›</button>
            </div>
          </div>
          <div class="calendar-weekdays" id="calendarWeekdays"></div>
          <div class="calendar-grid" id="calendarGrid"></div>
        </div>
      </div>
      <button class="lang-toggle" type="button" id="langToggleBtn">EN</button>
      <button type="button" id="saveBtn" data-ko="저장" data-en="Save">저장</button>
      <button type="button" id="importBtn" data-ko="PDF/HTML 가져오기" data-en="Import PDF/HTML">PDF/HTML 가져오기</button>
      <select id="importHistorySelect" style="display:none"></select>
      <button type="button" id="importHistoryLoadBtn" style="display:none" data-ko="적용" data-en="Load">적용</button>
      <button type="button" id="importHistoryDeleteBtn" style="display:none">✕</button>
      <input id="excelInput" type="file" accept=".pdf,.html,.htm">
      <button type="button" id="logoutBtn" data-ko="로그아웃" data-en="Log Out">로그아웃</button>
      <span class="save-state" id="saveState" style="display:none">로그인 필요</span>
    </div>
  </header>

  <main class="page">
    <section class="hero">
      <div>
        <h2 id="planTitleView">WOLKO Staff Schedule</h2>
        <p data-ko="스태프 일정과 여러 밴 운행 계획을 한 곳에서 정리합니다. 일간/주간 시간표를 보며 담당자, 차량, 출발지와 도착지를 함께 관리할 수 있습니다." data-en="Organize staff schedules and multiple van plans in one place. Manage daily and weekly schedules with staff, vehicles, departure points, and destinations.">스태프 일정과 여러 밴 운행 계획을 한 곳에서 정리합니다. 일간/주간 시간표를 보며 담당자, 차량, 출발지와 도착지를 함께 관리할 수 있습니다.</p>
        <div class="print-summary" id="printSummary">WOLKO Schedule Planner</div>
      </div>
      <div class="stats">
        <div class="stat"><strong id="statToday">0</strong><span data-ko="오늘 일정" data-en="TODAY">오늘 일정</span></div>
        <div class="stat"><strong id="statWeek">0</strong><span data-ko="이번 주" data-en="THIS WEEK">이번 주</span></div>
        <div class="stat"><strong id="statVans">0</strong><span data-ko="차량" data-en="VANS">차량</span></div>
      </div>
    </section>

    <section class="layout">
      <aside class="panel">
        <div class="panel-head">
          <h3 data-ko="운영표 입력" data-en="Operations Entry">운영표 입력</h3>
          <div style="display:flex;gap:8px;align-items:center;">
            <button class="ghost" id="resetEventBtn" type="button" data-ko="새 일정" data-en="New Item">새 일정</button>
            <button class="panel-collapse-btn" type="button" id="sidebarCollapseBtn" title="입력창 닫기">◀</button>
          </div>
        </div>
        <div class="panel-body">
          <div class="form-grid">
            <div class="field">
              <label for="planTitle" data-ko="플랜 이름" data-en="Plan Name">플랜 이름</label>
              <input id="planTitle" data-ph-ko="예: 2026 여름 캠프 운영 일정" data-ph-en="Example: 2026 Summer Camp Operations" placeholder="예: 2026 여름 캠프 운영 일정">
            </div>
            <div class="field">
              <label for="eventTitle" data-ko="스케줄" data-en="Schedule">스케줄</label>
              <input id="eventTitle" data-ph-ko="예: 공항 픽업, OAE 훈련" data-ph-en="Example: Meet the SF Team, OAE Training" placeholder="예: 공항 픽업, OAE 훈련">
            </div>
            <div class="field two">
              <div class="field">
                <label for="eventDate" data-ko="날짜" data-en="Date">날짜</label>
                <input id="eventDate" type="date">
              </div>
              <div class="field">
                <label for="eventTimeText" data-ko="시간" data-en="Time">시간</label>
                <input id="eventTimeText" data-ph-ko="예: 3:20-4:15" data-ph-en="Example: 3:20-4:15" placeholder="예: 3:20-4:15">
              </div>
            </div>
            <div class="field two">
              <div class="field">
                <label for="eventStart" data-ko="시작 정렬용" data-en="Start Sort Time">시작 정렬용</label>
                <input id="eventStart" type="time">
              </div>
              <div class="field">
                <label for="eventEnd" data-ko="종료 정렬용" data-en="End Sort Time">종료 정렬용</label>
                <input id="eventEnd" type="time">
              </div>
            </div>
            <div class="field">
              <label for="eventType" data-ko="분류" data-en="Category">분류</label>
              <select id="eventType">
                <option value="program" data-ko="프로그램" data-en="Program">프로그램</option>
