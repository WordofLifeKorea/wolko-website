    function todayIso() {
      return new Date().toISOString().slice(0, 10);
    }

    function addDays(iso, count) {
      const date = new Date(`${iso}T00:00:00`);
      date.setDate(date.getDate() + count);
      return date.toISOString().slice(0, 10);
    }

    function weekStart(iso) {
      const date = new Date(`${iso}T00:00:00`);
      const day = date.getDay();
      date.setDate(date.getDate() - day);
      return date.toISOString().slice(0, 10);
    }

    function dayName(iso) {
      return new Intl.DateTimeFormat(currentLang === 'ko' ? 'ko-KR' : 'en-US', { month: 'numeric', day: 'numeric', weekday: 'short' }).format(new Date(`${iso}T00:00:00`));
    }

    function dateSummary(iso) {
      const date = new Date(`${iso || todayIso()}T00:00:00`);
      return new Intl.DateTimeFormat(currentLang === 'ko' ? 'ko-KR' : 'en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
      }).format(date);
    }

    function parseIsoDate(iso) {
      const [year, month, day] = String(iso || todayIso()).split('-').map(Number);
      return new Date(year, (month || 1) - 1, day || 1);
    }

    function isoFromDate(date) {
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }

    function firstOfMonth(iso) {
      const date = parseIsoDate(iso);
      return isoFromDate(new Date(date.getFullYear(), date.getMonth(), 1));
    }

    function shiftCalendarMonth(delta) {
      const date = parseIsoDate(calendarMonth || firstOfMonth(els.selectedDate.value || todayIso()));
      calendarMonth = isoFromDate(new Date(date.getFullYear(), date.getMonth() + delta, 1));
      renderCalendar();
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
    }

    function vanName(vanId) {
      if (!vanId) return '';
      return plan.vans.find(van => van.id === vanId)?.name || vanId;
    }

    function eventTime(event) {
      if (event.start && event.end) return `${event.start}–${event.end}`;
      if (event.start) return event.start;
      return event.timeText || '';
    }

    function normalizeClock(value) {
      const match = String(value || '').match(/(\d{1,2})(?::(\d{2}))?/);
      if (!match) return '';
      return `${String(parseInt(match[1], 10)).padStart(2, '0')}:${match[2] || '00'}`;
    }

    function clockRange(value) {
      const matches = [...String(value || '').matchAll(/(\d{1,2})(?::(\d{2}))?/g)];
      return {
        start: matches[0] ? `${String(parseInt(matches[0][1], 10)).padStart(2, '0')}:${matches[0][2] || '00'}` : '',
        end: matches[1] ? `${String(parseInt(matches[1][1], 10)).padStart(2, '0')}:${matches[1][2] || '00'}` : '',
      };
    }

    // 캠프 일정 오전/오후 자동 판단: 1~5시 → 오후(+12), 나머지 그대로
    function autoAdjustHour(hhmm) {
      if (!hhmm) return hhmm;
      const [hStr, mStr] = String(hhmm).split(':');
      const h = parseInt(hStr, 10);
      if (isNaN(h)) return hhmm;
      return `${String(h >= 1 && h <= 5 ? h + 12 : h).padStart(2, '0')}:${mStr || '00'}`;
    }

    function slugKey(value) {
      return String(value || '')
        .toLowerCase()
        .replace(/&/g, 'and')
        .replace(/[^a-z0-9가-힯]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'unknown';
    }

    function normalizeSchedulePdfs(target = plan) {
      const list = Array.isArray(target.schedulePdfs) ? target.schedulePdfs : [];
      const legacy = target.schedulePdf?.url ? [target.schedulePdf] : [];
      const seen = new Set();
      target.schedulePdfs = [...legacy, ...list]
        .map(pdf => ({
          date: /^\d{4}-\d{2}-\d{2}$/.test(pdf?.date || '') ? pdf.date : (els.selectedDate?.value || todayIso()),
          url: pdf?.url || '',
          filename: pdf?.filename || 'schedule.pdf',
          uploadedAt: pdf?.uploadedAt || '',
        }))
        .filter(pdf => pdf.date && pdf.url && !seen.has(`${pdf.date}:${pdf.url}`) && seen.add(`${pdf.date}:${pdf.url}`))
        .sort((a, b) => a.date.localeCompare(b.date) || a.filename.localeCompare(b.filename));
      target.schedulePdf = null;
      return target.schedulePdfs;
    }

    function pdfForDate(date = els.selectedDate.value) {
      return normalizeSchedulePdfs().find(pdf => pdf.date === date) || null;
    }

    async function loadPdfJs() {
      if (window.pdfjsLib) return window.pdfjsLib;
      const pdfjs = await import(/* @vite-ignore */ 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.min.mjs');
      pdfjs.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.worker.min.mjs';
      window.pdfjsLib = pdfjs;
      return pdfjs;
    }

    function weekdayIndexFromToken(value) {
      const key = String(value || '').trim().toLowerCase().replace(/[().,\s]/g, '');
      const map = {
        sun:0, sunday:0, 일:0, 일요일:0,
        mon:1, monday:1, 월:1, 월요일:1,
        tue:2, tues:2, tuesday:2, 화:2, 화요일:2,
        wed:3, weds:3, wednesday:3, 수:3, 수요일:3,
        thu:4, thur:4, thurs:4, thursday:4, 목:4, 목요일:4,
        fri:5, friday:5, 금:5, 금요일:5,
        sat:6, saturday:6, 토:6, 토요일:6,
      };
      return Object.prototype.hasOwnProperty.call(map, key) ? map[key] : null;
    }

    function weekdayTokenFromLine(line) {
      const text = String(line || '');
      const parenthesized = text.match(/\((월|화|수|목|금|토|일|mon(?:day)?|tue(?:s|sday)?|wed(?:s|nesday)?|thu(?:r|rs|rsday)?|fri(?:day)?|sat(?:urday)?|sun(?:day)?)\)/i);
      if (parenthesized) return parenthesized[1];
      const explicit = text.match(/\b(mon(?:day)?|tue(?:s|sday)?|wed(?:s|nesday)?|thu(?:r|rs|rsday)?|fri(?:day)?|sat(?:urday)?|sun(?:day)?)\b|([월화수목금토일]요일)/i);
      return explicit?.[1] || explicit?.[2] || '';
    }

    function isoForParts(year, month, day) {
      const y = parseInt(year, 10);
      const m = parseInt(month, 10);
      const d = parseInt(day, 10);
      if (!y || m < 1 || m > 12 || d < 1 || d > 31) return '';
      const date = new Date(y, m - 1, d);
      if (date.getFullYear() !== y || date.getMonth() !== m - 1 || date.getDate() !== d) return '';
      return isoFromDate(date);
    }

    function weekdayIndexForIso(iso) {
      return parseIsoDate(iso).getDay();
    }

    function detectDateInLine(line, fallbackYear) {
      const text = String(line || '').replace(/\s+/g, ' ').trim();
      const weekdayToken = weekdayTokenFromLine(text);
      const foundWeekday = weekdayIndexFromToken(weekdayToken);
      const selectedYear = parseInt(fallbackYear || (els.selectedDate.value || todayIso()).slice(0, 4), 10);
      const monthNames = {
        jan:1, january:1, feb:2, february:2, mar:3, march:3, apr:4, april:4,
        may:5, jun:6, june:6, jul:7, july:7, aug:8, august:8, sep:9, sept:9,
        september:9, oct:10, october:10, nov:11, november:11, dec:12, december:12,
      };
      const patterns = [
        { re: /\b(20\d{2})\s*[.\-/년]\s*(\d{1,2})\s*[.\-/월]\s*(\d{1,2})\s*일?\b/, map: m => [m[1], m[2], m[3]] },
        { re: /(\d{1,2})\s*월\s*(\d{1,2})\s*일?/, map: m => [selectedYear, m[1], m[2]] },
        { re: /(?:^|[^\d])(\d{1,2})\s*[.\/-]\s*(\d{1,2})(?:\s*[.])?(?=$|[^\d])/, map: m => [selectedYear, m[1], m[2]] },
        {
          re: /\b(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\.?\s+(\d{1,2})(?:,\s*(20\d{2}))?\b/i,
          map: m => [m[3] || selectedYear, monthNames[m[1].toLowerCase().replace('.', '')], m[2]],
        },
      ];
      for (const pattern of patterns) {
        const match = text.match(pattern.re);
        if (!match) continue;
        const [year, month, day] = pattern.map(match);
        const iso = isoForParts(year, month, day);
        if (!iso) continue;
        const expectedWeekday = weekdayIndexForIso(iso);
        return {
          date: iso,
          foundWeekday,
          expectedWeekday,
          hasWeekday: foundWeekday !== null,
          mismatch: foundWeekday !== null && foundWeekday !== expectedWeekday,
          source: text,
        };
      }
      return null;
    }

    async function analyzeSchedulePdf(file) {
      const pdfjs = await loadPdfJs();
      const pdf = await pdfjs.getDocument({ data: await file.arrayBuffer() }).promise;
      const fallbackYear = (els.selectedDate.value || todayIso()).slice(0, 4);
      const detected = [];
      const seen = new Set();
      for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
        const page = await pdf.getPage(pageNumber);
        const content = await page.getTextContent();
        const lines = [];
        let lastY = null;
        let line = [];
        content.items.forEach(item => {
          const y = Math.round(item.transform?.[5] || 0);
          if (lastY !== null && Math.abs(y - lastY) > 5 && line.length) {
            lines.push(line.join(' '));
            line = [];
          }
          line.push(item.str);
          lastY = y;
        });
        if (line.length) lines.push(line.join(' '));
        const match = lines.map(value => detectDateInLine(value, fallbackYear)).find(Boolean);
        if (match && !seen.has(match.date)) {
          seen.add(match.date);
          detected.push({ ...match, page: pageNumber });
        }
      }
      return detected.sort((a, b) => a.date.localeCompare(b.date));
    }

    function weekdayShortByIndex(index) {
      const base = '2026-07-05';
      return dowShort(addDays(base, index));
    }

    function reviewPdfDetections(file, detections, fallbackReason = '') {
      return new Promise(resolve => {
        const fallbackDate = pendingPdfDate || els.selectedDate.value || todayIso();
        const items = detections.length ? detections : [{
          date: fallbackDate,
          page: 1,
          source: tr('pdfDetectFallback', dayName(fallbackDate)),
          fallback: true,
        }];
        els.pdfDetectTitle.textContent = tr('pdfDetectTitle');
        els.pdfDetectCopy.textContent = detections.length
          ? tr('pdfDetectCopy', { count: detections.length, filename: file.name })
          : (fallbackReason || tr('pdfDetectNone', file.name));
        els.pdfDetectApply.textContent = tr('pdfDetectApply');
        els.pdfDetectCancel.textContent = tr('pdfDetectCancel');
        els.pdfDetectList.innerHTML = items.map(item => {
          const expected = item.expectedWeekday !== undefined ? weekdayShortByIndex(item.expectedWeekday) : dowShort(item.date);
          const found = item.hasWeekday ? weekdayShortByIndex(item.foundWeekday) : '';
          const warning = item.mismatch ? tr('pdfDetectWeekdayMismatch', { expected, found }) : '';
          return `
            <div class="pdf-detect-row">
              <div>
                <strong>${escapeHtml(`${dayName(item.date)} · ${item.date}`)}</strong>
                <span>${escapeHtml(item.source || '')}</span>
                ${warning ? `<div class="pdf-detect-warn">${escapeHtml(warning)}</div>` : ''}
              </div>
              <div class="pdf-detect-page">${escapeHtml(tr('pdfDetectPage', item.page))}</div>
            </div>
          `;
        }).join('');
        els.pdfDetectDialog.hidden = false;
        const cleanup = result => {
          els.pdfDetectDialog.hidden = true;
          els.pdfDetectApply.removeEventListener('click', onApply);
          els.pdfDetectCancel.removeEventListener('click', onCancel);
          resolve(result);
        };
        const onApply = () => cleanup(items);
        const onCancel = () => cleanup(null);
        els.pdfDetectApply.addEventListener('click', onApply);
        els.pdfDetectCancel.addEventListener('click', onCancel);
      });
    }

    async function uploadSchedulePdf(file) {
      if (!/\.pdf$/i.test(file.name) && file.type !== 'application/pdf') {
        throw new Error(tr('unsupportedImportFile'));
      }
      const form = new FormData();
      form.append('file', file);
      const res = await fetch('/api/schedule-planner/upload', {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: form,
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          token = '';
          applyAuthState();
          showLogin(() => els.pdfInput.click());
        }
        throw new Error(data.error || tr('importFailed'));
      }
      return data.pdf;
    }

    function setSchedulePdfForDate(date, pdf) {
      const targetDate = /^\d{4}-\d{2}-\d{2}$/.test(date || '') ? date : (els.selectedDate.value || todayIso());
      plan.schedulePdfs = normalizeSchedulePdfs().filter(item => item.date !== targetDate);
      plan.schedulePdfs.push({ ...pdf, date: targetDate });
      plan.schedulePdfs.sort((a, b) => a.date.localeCompare(b.date) || a.filename.localeCompare(b.filename));
      plan.schedulePdf = null;
    }

    function deleteSchedulePdfForDate(date) {
      const targetDate = /^\d{4}-\d{2}-\d{2}$/.test(date || '') ? date : (els.selectedDate.value || todayIso());
      if (!pdfForDate(targetDate)) {
        setState(tr('deleteNone'));
        return;
      }
      if (!confirm(tr('deletePdfConfirm', dayName(targetDate)))) return;
      saveDeleteBackup(`pdf:${targetDate}`);
      plan.schedulePdfs = normalizeSchedulePdfs().filter(pdf => pdf.date !== targetDate);
      markDirty();
      setState(tr('deletePdfDone', dayName(targetDate)));
    }

    function startPdfUpload(date = els.selectedDate.value || todayIso()) {
      pendingPdfDate = /^\d{4}-\d{2}-\d{2}$/.test(date || '') ? date : (els.selectedDate.value || todayIso());
      if (!requireEditor(() => startPdfUpload(pendingPdfDate))) return;
      els.pdfInput.click();
    }

    function periodOf(event) {
      const t = timeSortValue(event);
      if (t === '99:99') return 'none';
      const h = parseInt(t.split(':')[0], 10);
      if (h < 12) return 'am';
      if (h < 18) return 'pm';
      return 'evening';
    }

    function timeSortValue(event) {
      const raw = event.start || normalizeClock(event.timeText);
      const value = autoAdjustHour(raw);
      const parts = String(value || '').split(':').map(Number);
      if (parts.length < 2 || Number.isNaN(parts[0]) || Number.isNaN(parts[1])) return '99:99';
      return `${String(parts[0]).padStart(2, '0')}:${String(parts[1]).padStart(2, '0')}`;
    }

    function sortedEvents(events = plan.events) {
      return [...events].sort((a, b) => `${a.date} ${timeSortValue(a)}`.localeCompare(`${b.date} ${timeSortValue(b)}`));
    }

    function sourceLabel(item) {
      return item?.sourceGroupLabel || item?.sourceSheet || '';
    }

    function sourceKey(item) {
      return item?.sourceGroupKey || (sourceLabel(item) ? `sheet-${slugKey(sourceLabel(item))}` : '');
    }

    function groupOptions() {
      const map = new Map();
      [...(plan.events || []), ...(plan.transportPlans || [])].forEach(item => {
        const label = sourceLabel(item);
        const key = sourceKey(item);
        if (label && key) map.set(key, label);
      });
      return [...map.entries()].map(([key, label]) => ({ key, label })).sort((a, b) => a.label.localeCompare(b.label));
    }

    function matchesGroupFilter(item) {
      return currentGroupFilter === 'all' || sourceKey(item) === currentGroupFilter;
    }

    function filteredEvents(events = plan.events) {
      return (events || []).filter(matchesGroupFilter);
    }

    function filteredTransportPlans() {
      return (plan.transportPlans || []).filter(matchesGroupFilter);
    }

    function nearestDayWithEvents(fromIso, dir) {
      const dates = [...new Set(plan.events.map(e => e.date))].sort();
      if (!dates.length) return fromIso;
      return dir > 0
        ? (dates.find(d => d > fromIso) || fromIso)
        : ([...dates].reverse().find(d => d < fromIso) || fromIso);
    }

    function weekEvents() {
      const start = weekStart(els.selectedDate.value);
      const end = addDays(start, 6);
      return filteredEvents().filter(event => event.date >= start && event.date <= end);
    }

    function setState(text) {
      els.saveState.textContent = text;
    }

    function markDirty() {
      setState(tr('saveNeeded'));
      render();
    }

    function clonePlanSnapshot() {
      return JSON.parse(JSON.stringify({
        title: plan.title || 'WOLKO Staff Schedule',
        vans: Array.isArray(plan.vans) ? plan.vans : [],
        events: Array.isArray(plan.events) ? plan.events : [],
        people: Array.isArray(plan.people) ? plan.people : [],
        transportPlans: Array.isArray(plan.transportPlans) ? plan.transportPlans : [],
        schedulePdf: null,
        schedulePdfs: normalizeSchedulePdfs().map(pdf => ({ ...pdf })),
        updatedAt: plan.updatedAt || '',
      }));
    }

    function saveDeleteBackup(reason) {
      try {
        localStorage.setItem(DELETE_BACKUP_KEY, JSON.stringify({
          reason,
          savedAt: new Date().toISOString(),
          plan: clonePlanSnapshot(),
        }));
      } catch (error) {
        console.warn('Delete backup save failed:', error);
      }
    }

    function hasDeleteBackup() {
      try { return !!JSON.parse(localStorage.getItem(DELETE_BACKUP_KEY) || 'null')?.plan; }
      catch { return false; }
    }

    function deleteSelectedDayData() {
      const date = els.selectedDate.value || todayIso();
      const beforeEvents = plan.events.length;
      const beforePlans = (plan.transportPlans || []).length;
      const beforePdfs = normalizeSchedulePdfs().length;
      const filterLabel = currentGroupFilter === 'all'
        ? ''
        : groupOptions().find(group => group.key === currentGroupFilter)?.label || '';
      const shouldDeleteItem = item => item.date === date && matchesGroupFilter(item);
      const count = plan.events.filter(shouldDeleteItem).length
        + (plan.transportPlans || []).filter(shouldDeleteItem).length
        + (currentGroupFilter === 'all' ? normalizeSchedulePdfs().filter(pdf => pdf.date === date).length : 0);
      if (!count) {
        setState(tr('deleteNone'));
        return;
      }
      if (!confirm(tr('deleteDayConfirm', { date, count, filter: filterLabel }))) return;
      saveDeleteBackup(`day:${date}`);
      plan.events = plan.events.filter(item => !shouldDeleteItem(item));
      plan.transportPlans = (plan.transportPlans || []).filter(item => !shouldDeleteItem(item));
      if (currentGroupFilter === 'all') plan.schedulePdfs = normalizeSchedulePdfs().filter(pdf => pdf.date !== date);
      if (editingId && !plan.events.some(item => item.id === editingId)) clearForm();
      markDirty();
      setState(tr('deleteDayDone', (beforeEvents - plan.events.length) + (beforePlans - plan.transportPlans.length) + (beforePdfs - normalizeSchedulePdfs().length)));
    }

    function deleteAllData() {
      const totals = {
        events: plan.events.length,
        people: (plan.people || []).length,
        vans: (plan.vans || []).length,
        plans: (plan.transportPlans || []).length,
        pdf: normalizeSchedulePdfs().length,
      };
      if (!totals.events && !totals.people && !totals.vans && !totals.plans && !totals.pdf) {
        setState(tr('deleteNone'));
        return;
      }
      if (!confirm(tr('deleteAllConfirm', totals))) return;
      saveDeleteBackup('all');
      plan.events = [];
      plan.people = [];
      plan.vans = [];
      plan.transportPlans = [];
      plan.schedulePdf = null;
      plan.schedulePdfs = [];
      currentGroupFilter = 'all';
      clearForm();
      markDirty();
      setState(tr('deleteAllDone'));
    }

    function restoreLastDelete() {
      let backup;
      try { backup = JSON.parse(localStorage.getItem(DELETE_BACKUP_KEY) || 'null'); }
      catch { backup = null; }
      if (!backup?.plan) {
        setState(tr('restoreNone'));
        return;
      }
      plan = backup.plan;
      plan.people = Array.isArray(plan.people) ? plan.people : [];
      plan.vans = Array.isArray(plan.vans) ? plan.vans : [];
      plan.events = Array.isArray(plan.events) ? plan.events : [];
      plan.transportPlans = Array.isArray(plan.transportPlans) ? plan.transportPlans : [];
      normalizeSchedulePdfs();
      els.planTitle.value = plan.title || '';
      currentGroupFilter = 'all';
      clearForm();
      try { localStorage.removeItem(DELETE_BACKUP_KEY); } catch {}
      markDirty();
      setState(tr('restoreDone'));
    }

    function evText(ev, field) {
      if (currentLang === 'en' && ev._en?.[field]) return ev._en[field];
      return ev[field] || '';
    }

    function eventMeta(event) {
      const bits = [];
      const source = sourceLabel(event);
      const staff = evText(event, 'staff');
      const from = evText(event, 'from');
      const to = evText(event, 'to');
      const passengers = evText(event, 'passengers');
      const notes = evText(event, 'notes');
      if (source) bits.push(source);
      if (staff) bits.push(`${tr('staff')}: ${staff}`);
      if (event.vanId) bits.push(`${tr('vehicle')}: ${vanName(event.vanId)}`);
      if (from || to) bits.push(`${from || tr('fromUnknown')} → ${to || tr('toUnknown')}`);
      if (passengers) bits.push(`${tr('people')}: ${passengers}`);
      if (notes) bits.push(notes);
      return bits.map(escapeHtml).join(' · ');
    }

    function eventCard(event) {
      return `
        <article class="schedule-card ${escapeHtml(event.type)}">
          <div class="time">${escapeHtml(eventTime(event))}</div>
          <div>
            <div class="item-title">${escapeHtml(evText(event, 'title'))} <span class="meta">· ${escapeHtml(typeLabel(event.type))}</span></div>
            <div class="meta">${eventMeta(event) || tr('noDetails')}</div>
          </div>
          <div class="mini-actions">
            <button type="button" data-edit="${escapeHtml(event.id)}">${escapeHtml(tr('edit'))}</button>
          </div>
        </article>
      `;
    }

