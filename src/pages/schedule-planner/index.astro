    function closeCalendar() {
      els.calendarPopover.hidden = true;
      els.calendarToggle.setAttribute('aria-expanded', 'false');
    }

    function toggleCalendar() {
      const isOpen = !els.calendarPopover.hidden;
      if (isOpen) {
        closeCalendar();
        return;
      }
      calendarMonth = firstOfMonth(els.selectedDate.value || todayIso());
      renderCalendar();
      els.calendarPopover.hidden = false;
      els.calendarToggle.setAttribute('aria-expanded', 'true');
    }

    function selectScheduleDate(iso, options = {}) {
      els.selectedDate.value = iso || todayIso();
      els.eventDate.value = els.selectedDate.value;
      calendarMonth = firstOfMonth(els.selectedDate.value);
      if (options.close !== false) closeCalendar();
      render();
    }

    function renderCalendar() {
      const selectedIso = els.selectedDate.value || todayIso();
      const today = todayIso();
      const monthIso = calendarMonth || firstOfMonth(selectedIso);
      const monthDate = parseIsoDate(monthIso);
      const firstVisible = new Date(monthDate.getFullYear(), monthDate.getMonth(), 1 - monthDate.getDay());
      const eventCounts = filteredEvents().reduce((counts, event) => {
        if (event.date) counts[event.date] = (counts[event.date] || 0) + 1;
        return counts;
      }, {});
      const locale = currentLang === 'ko' ? 'ko-KR' : 'en-US';
      els.calendarTitle.textContent = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long' }).format(monthDate);
      els.calendarWeekdays.innerHTML = (currentLang === 'ko'
        ? ['일', '월', '화', '수', '목', '금', '토']
        : ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
      ).map(day => `<span class="calendar-weekday">${escapeHtml(day)}</span>`).join('');
      els.calendarGrid.innerHTML = Array.from({ length: 42 }, (_, index) => {
        const date = new Date(firstVisible.getFullYear(), firstVisible.getMonth(), firstVisible.getDate() + index);
        const iso = isoFromDate(date);
        const count = eventCounts[iso] || 0;
        const classes = [
          'calendar-day',
          date.getMonth() !== monthDate.getMonth() ? 'is-outside' : '',
          iso === selectedIso ? 'is-selected' : '',
          iso === today ? 'is-today' : '',
        ].filter(Boolean).join(' ');
        const aria = `${new Intl.DateTimeFormat(locale, { month: 'long', day: 'numeric', weekday: 'long' }).format(date)}${count ? `, ${count}` : ''}`;
        return `
          <button class="${classes}" type="button" data-calendar-date="${escapeHtml(iso)}" aria-label="${escapeHtml(aria)}">
            <span>${date.getDate()}</span>
            ${count ? `<span class="calendar-day-count">${count}</span>` : ''}
          </button>
        `;
      }).join('');
      els.dateSummary.textContent = dateSummary(selectedIso);
      els.dateValue.textContent = selectedIso;
    }

    function renderStats() {
      const todayCount = filteredEvents().filter(event => event.date === els.selectedDate.value).length;
      const weekCount = weekEvents().length;
      const viewLabels = COPY[currentLang].printView;
      renderCalendar();
      els.statToday.textContent = todayCount;
      els.statWeek.textContent = weekCount;
      els.statVans.textContent = plan.vans.length;
      els.planTitleView.textContent = plan.title || 'WOLKO Staff Schedule';
      els.printSummary.textContent = tr('printSummary', {
        view: viewLabels[currentView] || viewLabels.day,
        date: els.selectedDate.value,
        today: todayCount,
        week: weekCount,
        vans: plan.vans.length,
      });
    }

    function render() {
      renderVansSelect();
      renderFilterControls();
      renderStats();
      renderDay();
      renderWeek();
      renderVans();
      renderPeople();
      renderList();
      renderFleet();
      els.restoreDeleteBtn.disabled = !hasDeleteBackup();
      document.querySelectorAll('.view').forEach(view => view.classList.toggle('active', view.id === `view-${currentView}`));
      document.querySelectorAll('.tab').forEach(tab => tab.classList.toggle('active', tab.dataset.view === currentView));
      if (els.eventVan.dataset.value !== undefined) {
        els.eventVan.value = els.eventVan.dataset.value;
        delete els.eventVan.dataset.value;
      }
    }

    function readForm() {
      const parsed = clockRange(els.eventTimeText.value);
      const existing = editingId ? plan.events.find(item => item.id === editingId) : null;
      return {
        id: editingId || crypto.randomUUID(),
        title: els.eventTitle.value.trim(),
        type: els.eventType.value,
        date: els.eventDate.value,
        timeText: els.eventTimeText.value.trim(),
        start: parsed.start || els.eventStart.value,
        end: parsed.end || els.eventEnd.value,
        staff: els.eventStaff.value.trim(),
        vanId: els.eventVan.value,
        from: els.eventFrom.value.trim(),
        to: els.eventTo.value.trim(),
        passengers: els.eventPassengers.value.trim(),
        notes: els.eventNotes.value.trim(),
        sourceSheet: existing?.sourceSheet || '',
        sourceGroupKey: existing?.sourceGroupKey || '',
        sourceGroupLabel: existing?.sourceGroupLabel || '',
      };
    }

    function clearForm() {
      editingId = '';
      els.eventTitle.value = '';
      els.eventType.value = 'program';
      els.eventDate.value = els.selectedDate.value;
      els.eventTimeText.value = '09:00';
      els.eventStart.value = '09:00';
      els.eventEnd.value = '10:00';
      els.eventStaff.value = '';
      els.eventVan.value = '';
      els.eventFrom.value = '';
      els.eventTo.value = '';
      els.eventPassengers.value = '';
      els.eventNotes.value = '';
      els.addEventBtn.textContent = tr('addSchedule');
      els.deleteEventBtn.hidden = true;
    }

    function editEvent(id) {
      const event = plan.events.find(item => item.id === id);
      if (!event) return;
      editingId = event.id;
      els.eventTitle.value = evText(event, 'title');
      els.eventType.value = event.type || 'program';
      els.eventDate.value = event.date || els.selectedDate.value;
      els.eventTimeText.value = eventTime(event);
      els.eventStart.value = event.start || '09:00';
      els.eventEnd.value = event.end || '10:00';
      els.eventStaff.value = evText(event, 'staff');
      els.eventVan.dataset.value = event.vanId || '';
      els.eventFrom.value = evText(event, 'from');
      els.eventTo.value = evText(event, 'to');
      els.eventPassengers.value = evText(event, 'passengers');
      els.eventNotes.value = evText(event, 'notes');
      els.addEventBtn.textContent = tr('updateSchedule');
      els.deleteEventBtn.hidden = false;
      renderVansSelect();
    }

    function showLogin(action = null) {
      pendingEditorAction = action;
      els.loginError.textContent = tr('editLoginRequired');
      els.loginScreen.classList.remove('hidden');
      setTimeout(() => els.passwordInput.focus(), 30);
    }

    function hideLogin() {
      els.loginScreen.classList.add('hidden');
      els.loginError.textContent = '';
      els.passwordInput.value = '';
    }

    function requireEditor(action = null) {
      if (token) return true;
      showLogin(action);
      return false;
    }

    async function login() {
      els.loginBtn.disabled = true;
      els.loginError.textContent = '';
      try {
        const res = await fetch('/api/schedule-planner/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: els.passwordInput.value.trim() }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || tr('loginFailed'));
        token = data.token;
        localStorage.setItem(TOKEN_KEY, token);
        hideLogin();
        applyAuthState();
        await loadPlan();
        const action = pendingEditorAction;
        pendingEditorAction = null;
        if (typeof action === 'function') setTimeout(action, 0);
      } catch (error) {
        els.loginError.textContent = error.message;
      } finally {
        els.loginBtn.disabled = false;
      }
    }

    const PASSWORD_ALLOWED_RE = /^[\x21-\x7E]*$/;
    function cleanPasswordValue(value) {
      return String(value || '').replace(/[^\x21-\x7E]/g, '');
    }
    function warnPasswordLanguage() {
      els.loginError.textContent = tr('passwordLanguageWarning');
    }
    function enforceAsciiPasswordInput(input) {
      input.setAttribute('inputmode', 'latin');
      input.setAttribute('pattern', '[\\x21-\\x7E]*');
      input.addEventListener('beforeinput', event => {
        if (event.data && !PASSWORD_ALLOWED_RE.test(event.data)) {
          event.preventDefault();
          warnPasswordLanguage();
        }
      });
      input.addEventListener('paste', event => {
        const text = event.clipboardData?.getData('text') || '';
        const clean = cleanPasswordValue(text);
        if (text !== clean) {
          event.preventDefault();
          const start = input.selectionStart ?? input.value.length;
          const end = input.selectionEnd ?? start;
          input.setRangeText(clean, start, end, 'end');
          input.dispatchEvent(new Event('input', { bubbles: true }));
          warnPasswordLanguage();
        }
      });
      input.addEventListener('input', () => {
        const clean = cleanPasswordValue(input.value);
        if (input.value !== clean) {
          input.value = clean;
          warnPasswordLanguage();
        }
      });
    }

    async function loadPlan() {
      setState(tr('loading'));
      const headers = token ? { Authorization: `Bearer ${token}` } : {};
      const res = await fetch('/api/schedule-planner/data', { headers });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          token = '';
          applyAuthState();
          showLogin();
          throw new Error(data.error || tr('loginNeeded'));
        }
        setState(data.error || tr('loadFailed'));
        throw new Error(data.error || tr('loadFailed'));
      }
      plan = data.plan || plan;
      plan.people = Array.isArray(plan.people) ? plan.people : [];
      plan.transportPlans = Array.isArray(plan.transportPlans) ? plan.transportPlans : [];
      els.planTitle.value = plan.title || '';
      setState(plan.updatedAt ? `${tr('saved')} ${new Date(plan.updatedAt).toLocaleString(currentLang === 'ko' ? 'ko-KR' : 'en-US')}` : (token ? tr('editMode') : tr('viewMode')));
      render();
    }

    async function savePlan() {
      if (!requireEditor(savePlan)) return;
      plan.title = els.planTitle.value.trim() || 'WOLKO Staff Schedule';
      setState(tr('saving'));
      els.saveBtn.disabled = true;
      try {
        const res = await fetch('/api/schedule-planner/data', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ plan }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (res.status === 401) {
            localStorage.removeItem(TOKEN_KEY);
            token = '';
            applyAuthState();
            showLogin(savePlan);
          }
          throw new Error(data.error || tr('saveFailed'));
        }
        plan = data.plan;
        els.planTitle.value = plan.title || '';
        setState(`${tr('saved')} ${new Date(plan.updatedAt).toLocaleString(currentLang === 'ko' ? 'ko-KR' : 'en-US')}`);
        render();
      } catch (error) {
        setState(error.message);
      } finally {
        els.saveBtn.disabled = false;
      }
    }

    function exportCsv() {
      const headers = ['date','time','type','schedule','staff','van','from','to','passengers','details'];
      const rows = sortedEvents().map(event => [
        event.date, eventTime(event), typeLabel(event.type), evText(event, 'title'), evText(event, 'staff'),
        vanName(event.vanId), evText(event, 'from'), evText(event, 'to'), evText(event, 'passengers'), evText(event, 'notes'),
      ]);
      const csv = [headers, ...rows].map(row => row.map(value => `"${String(value || '').replace(/"/g, '""')}"`).join(',')).join('\n');
      const blob = new Blob([`\ufeff${csv}`], { type: 'text/csv;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `wolko-schedule-${els.selectedDate.value || todayIso()}.csv`;
      a.click();
      URL.revokeObjectURL(url);
    }

    const SIDEBAR_KEY = 'wolko_schedule_planner_sidebar';
    let sidebarOpen = localStorage.getItem(SIDEBAR_KEY) !== 'closed';
    function applySidebar() {
      els.layout.classList.toggle('sidebar-collapsed', !sidebarOpen);
      document.body.classList.toggle('sidebar-collapsed', !sidebarOpen);
    }
    els.sidebarCollapseBtn.addEventListener('click', () => {
      sidebarOpen = false;
      localStorage.setItem(SIDEBAR_KEY, 'closed');
      applySidebar();
    });
    els.sidebarReopenTab.addEventListener('click', () => {
      sidebarOpen = true;
      localStorage.setItem(SIDEBAR_KEY, 'open');
      applySidebar();
    });
    applySidebar();

    els.loginBtn.addEventListener('click', login);
    els.loginCloseBtn.addEventListener('click', () => {
      pendingEditorAction = null;
      hideLogin();
      applyAuthState();
    });
    enforceAsciiPasswordInput(els.passwordInput);
    els.passwordInput.addEventListener('keydown', event => { if (event.key === 'Enter') login(); });
    els.calendarToggle.addEventListener('click', toggleCalendar);
    els.calendarPrev.addEventListener('click', () => shiftCalendarMonth(-1));
    els.calendarNext.addEventListener('click', () => shiftCalendarMonth(1));
    els.calendarToday.addEventListener('click', () => selectScheduleDate(todayIso()));
    els.calendarGrid.addEventListener('click', event => {
      const button = event.target.closest('[data-calendar-date]');
      if (!button) return;
      selectScheduleDate(button.dataset.calendarDate);
    });
    document.addEventListener('click', event => {
      if (!els.datePicker.contains(event.target)) closeCalendar();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeCalendar();
    });
    els.langToggleBtn.addEventListener('click', () => setLanguage(currentLang === 'ko' ? 'en' : 'ko'));
    els.saveBtn.addEventListener('click', savePlan);
    els.importBtn.addEventListener('click', () => {
      if (!requireEditor(() => els.excelInput.click())) return;
      els.excelInput.click();
    });
    els.groupFilterSelect.addEventListener('change', () => {
      currentGroupFilter = els.groupFilterSelect.value || 'all';
      render();
    });
    els.dateJumpSelect.addEventListener('change', () => {
      if (els.dateJumpSelect.value) selectScheduleDate(els.dateJumpSelect.value, { close: false });
    });
    function resetHistorySelection() {
      els.importHistorySelect.value = '';
      els.importHistoryLoadBtn.style.display = 'none';
      els.importHistoryDeleteBtn.style.display = 'none';
    }

    async function applyHistoryEntry(id) {
      const entry = loadImportHistory().find(e => e.id === id);
      resetHistorySelection();
      if (!entry) return;
      if ((plan.events.length || plan.people.length) && !confirm(tr('importHistoryConfirm'))) return;
      const s = entry.snapshot;
      const imported = {
        events: (s.events || []).map(e => ({ ...e })),
        people: s.people || [],
        vans: s.vans || [],
        transportPlans: s.transportPlans || [],
      };
      if (currentLang === 'ko') {
        const answer = await askTranslate();
        if (answer === 'cancel') return;
        if (answer === 'yes') { setState(tr('translating')); await translateImported(imported); }
      }
      plan.events = imported.events;
      plan.people = imported.people;
      if (imported.vans.length) plan.vans = imported.vans;
      plan.transportPlans = imported.transportPlans;
      currentView = plan.events.length ? 'day' : (plan.people.length ? 'people' : 'vans');
      markDirty();
    }

    els.importHistorySelect.addEventListener('change', () => {
      const has = !!els.importHistorySelect.value;
      els.importHistoryLoadBtn.style.display = has ? '' : 'none';
      els.importHistoryDeleteBtn.style.display = has ? '' : 'none';
    });

    els.importHistoryLoadBtn.addEventListener('click', () => {
      const id = els.importHistorySelect.value;
      if (id) {
        if (!requireEditor(() => applyHistoryEntry(id))) return;
        applyHistoryEntry(id);
      }
    });

    els.importHistoryDeleteBtn.addEventListener('click', () => {
      const id = els.importHistorySelect.value;
      if (!id) return;
      const history = loadImportHistory().filter(e => e.id !== id);
      try { localStorage.setItem(IMPORT_HISTORY_KEY, JSON.stringify(history)); } catch {}
      resetHistorySelection();
      renderImportHistorySelect();
    });
    els.excelInput.addEventListener('change', async () => {
      const file = els.excelInput.files?.[0];
      if (!file) return;
      if (!requireEditor()) {
        els.excelInput.value = '';
        return;
      }
      setState(tr('importLoading'));
      els.importBtn.disabled = true;
      try {
        const imported = await importPlannerFile(file);
        if (currentLang === 'ko') {
          const answer = await askTranslate();
          if (answer === 'cancel') { setState(''); return; }
          if (answer === 'yes') { setState(tr('translating')); await translateImported(imported); }
        }
        saveImportToHistory(file.name, imported);
        renderImportHistorySelect();
        plan.events = imported.events;
        plan.people = imported.people;
        if (imported.vans.length) plan.vans = imported.vans;
        plan.transportPlans = imported.transportPlans;
        currentView = imported.events.length ? 'day' : (imported.people.length ? 'people' : 'vans');
        markDirty();
        setState(tr('importDone', { events: imported.events.length, people: imported.people.length, plans: imported.transportPlans.length }));
      } catch (error) {
        setState(error.message || tr('importFailed'));
      } finally {
        els.importBtn.disabled = false;
        els.excelInput.value = '';
      }
    });
    els.logoutBtn.addEventListener('click', () => {
      if (!token) {
        showLogin();
        return;
      }
      localStorage.removeItem(TOKEN_KEY);
      token = '';
      applyAuthState();
    });
    els.selectedDate.addEventListener('change', () => {
      els.eventDate.value = els.selectedDate.value;
      render();
    });
    els.todayBtn.addEventListener('click', () => {
      selectScheduleDate(todayIso(), { close: false });
    });
    els.deleteDayBtn.addEventListener('click', () => {
      if (!requireEditor(deleteSelectedDayData)) return;
      deleteSelectedDayData();
    });
    els.deleteAllBtn.addEventListener('click', () => {
      if (!requireEditor(deleteAllData)) return;
      deleteAllData();
    });
    els.restoreDeleteBtn.addEventListener('click', () => {
      if (!requireEditor(restoreLastDelete)) return;
      restoreLastDelete();
    });
    els.printBtn.addEventListener('click', () => window.print());
    els.resetEventBtn.addEventListener('click', clearForm);
    els.planTitle.addEventListener('input', () => {
      if (!requireEditor()) {
        els.planTitle.value = plan.title || '';
        return;
      }
      plan.title = els.planTitle.value.trim() || 'WOLKO Staff Schedule';
      markDirty();
    });
    els.addEventBtn.addEventListener('click', () => {
      if (!requireEditor(() => els.addEventBtn.click())) return;
      const event = readForm();
      if (!event.title || !event.date || !event.timeText) {
        setState(tr('titleRequired'));
        return;
      }
      const index = plan.events.findIndex(item => item.id === event.id);
      if (index >= 0) plan.events[index] = event;
      else plan.events.push(event);
      clearForm();
      markDirty();
    });
    els.deleteEventBtn.addEventListener('click', () => {
      if (!requireEditor(() => els.deleteEventBtn.click())) return;
      if (!editingId) return;
      plan.events = plan.events.filter(event => event.id !== editingId);
      clearForm();
      markDirty();
    });
    els.addPersonBtn.addEventListener('click', () => {
      if (!requireEditor(() => els.addPersonBtn.click())) return;
      const name = els.personName.value.trim();
      if (!name) {
        setState(tr('personRequired'));
        return;
      }
      plan.people = Array.isArray(plan.people) ? plan.people : [];
      const sameGroup = plan.people.filter(person => person.group === els.personGroup.value);
      plan.people.push({
        id: crypto.randomUUID(),
        group: els.personGroup.value,
        no: sameGroup.length + 1,
        name,
        gender: els.personGender.value.trim(),
        age: els.personAge.value.trim(),
        shirt: els.personShirt.value.trim(),
        birthday: els.personBirthday.value.trim(),
        note: els.personNote.value.trim(),
      });
      els.personName.value = '';
      els.personGender.value = '';
      els.personAge.value = '';
      els.personShirt.value = '';
      els.personBirthday.value = '';
      els.personNote.value = '';
      currentView = 'people';
      markDirty();
    });
    els.addTransportBtn.addEventListener('click', () => {
      if (!requireEditor(() => els.addTransportBtn.click())) return;
      const title = els.transportTitle.value.trim();
      if (!title) {
        setState(tr('transportRequired'));
        return;
      }
      plan.transportPlans = Array.isArray(plan.transportPlans) ? plan.transportPlans : [];
      const assignments = {};
      plan.vans.forEach(van => {
        assignments[van.id] = { driver: van.driver || '', passengers: '', notes: '' };
      });
      plan.transportPlans.push({
        id: crypto.randomUUID(),
        title,
        date: els.selectedDate.value,
        description: els.transportDescription.value.trim(),
        assignments,
      });
      els.transportTitle.value = '';
      els.transportDescription.value = '';
      currentView = 'vans';
      markDirty();
    });
    document.addEventListener('click', event => {
      const dayNav = event.target.closest('[data-day-nav]')?.dataset.dayNav;
      if (dayNav) {
        selectScheduleDate(nearestDayWithEvents(els.selectedDate.value || todayIso(), parseInt(dayNav, 10)));
        return;
      }
      const editId = event.target.closest('[data-edit]')?.dataset.edit;
      if (editId) editEvent(editId);
      const tab = event.target.closest('.tab');
      if (tab?.dataset.view) {
        currentView = tab.dataset.view;
        render();
      }
      const removeVan = event.target.closest('[data-remove-van]')?.dataset.removeVan;
      if (removeVan) {
        if (!requireEditor(() => event.target.closest('[data-remove-van]')?.click())) return;
        plan.vans = plan.vans.filter(van => van.id !== removeVan);
        plan.events = plan.events.map(item => item.vanId === removeVan ? { ...item, vanId: '' } : item);
        markDirty();
      }
      if (event.target.id === 'addVanBtn') {
        if (!requireEditor(() => document.getElementById('addVanBtn')?.click())) return;
        plan.vans.push({ id: crypto.randomUUID(), name: `${tr('vehicle')} ${plan.vans.length + 1}`, seats: 0, driver: '', memo: '' });
        markDirty();
      }
      const removePerson = event.target.closest('[data-remove-person]')?.dataset.removePerson;
      if (removePerson) {
        if (!requireEditor(() => event.target.closest('[data-remove-person]')?.click())) return;
        plan.people = (plan.people || []).filter(person => person.id !== removePerson);
        markDirty();
      }
      const removeTransport = event.target.closest('[data-remove-transport]')?.dataset.removeTransport;
      if (removeTransport) {
        if (!requireEditor(() => event.target.closest('[data-remove-transport]')?.click())) return;
        plan.transportPlans = (plan.transportPlans || []).filter(item => item.id !== removeTransport);
        markDirty();
      }
    });
    document.addEventListener('input', event => {
      const assignField = event.target.dataset.assignField;
      if (assignField) {
        if (!requireEditor()) {
          renderVans();
          return;
        }
        const transport = (plan.transportPlans || []).find(item => item.id === event.target.dataset.transportId);
        if (!transport) return;
        const vanId = event.target.dataset.vanId;
        transport.assignments = transport.assignments || {};
        transport.assignments[vanId] = transport.assignments[vanId] || { driver: '', passengers: '', notes: '' };
        transport.assignments[vanId][assignField] = event.target.value;
        setState(tr('saveNeeded'));
        return;
      }
      const field = event.target.dataset.vanField;
      const vanId = event.target.dataset.vanId;
      if (!field || !vanId) return;
      if (!requireEditor()) {
        renderFleet();
        return;
      }
      const van = plan.vans.find(item => item.id === vanId);
      if (!van) return;
      van[field] = field === 'seats' ? Math.max(0, parseInt(event.target.value, 10) || 0) : event.target.value.trim();
      setState(tr('saveNeeded'));
      renderVansSelect();
      renderStats();
    });

    els.selectedDate.value = todayIso();
    clearForm();
    applyLanguage();
    render();
    loadPlan().catch(error => {
      setState(error.message || tr('loadFailed'));
    });
  </script>
</body>
</html>
