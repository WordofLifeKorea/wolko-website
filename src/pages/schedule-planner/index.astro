    function renderDay() {
      const date = els.selectedDate.value;
      const dayEvents = sortedEvents(filteredEvents().filter(event => event.date === date));
      const ko = currentLang === 'ko';
      const periods = [
        { key:'am',      label: ko ? '오전' : 'Morning' },
        { key:'pm',      label: ko ? '오후' : 'Afternoon' },
        { key:'evening', label: ko ? '저녁' : 'Evening' },
        { key:'none',    label: ko ? '시간 미정' : 'Unscheduled' },
      ];
      const grouped = {};
      dayEvents.forEach(e => {
        const p = periodOf(e);
        if (!grouped[p]) grouped[p] = [];
        grouped[p].push(e);
      });
      const body = dayEvents.length
        ? `<div class="tl">
            ${periods.filter(p => (grouped[p.key] || []).length).map(p => `
              <div class="tl-period">${escapeHtml(p.label)}</div>
              ${grouped[p.key].map(event => `
                <div class="tl-row">
                  <div class="tl-time">${escapeHtml(eventTime(event))}</div>
                  <div class="tl-card ${escapeHtml(event.type || '')}" data-edit="${escapeHtml(event.id)}">
                    <div>
                      <div class="tl-card-title">${escapeHtml(evText(event, 'title'))}<span class="tl-type-badge">${escapeHtml(typeLabel(event.type))}</span></div>
                      ${eventMeta(event) ? `<div class="tl-card-meta">${eventMeta(event)}</div>` : ''}
                    </div>
                    <button type="button" class="tl-edit-btn" data-edit="${escapeHtml(event.id)}">${escapeHtml(tr('edit'))}</button>
                  </div>
                </div>
              `).join('')}
