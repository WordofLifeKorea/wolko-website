</head>
<body>
  <div class="login-screen hidden" id="loginScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-ko="스케줄 플래너 로그인" data-en="Schedule Planner Login">스케줄 플래너 로그인</p>
      <p class="login-description" data-ko="스태프 일정과 차량 운영 계획을 관리합니다." data-en="Manage staff schedules and van operations.">스태프 일정과 차량 운영 계획을 관리합니다.</p>
      <input class="login-input" id="passwordInput" type="password" data-ph-ko="관리자 비밀번호" data-ph-en="Admin password" placeholder="관리자 비밀번호" autocomplete="current-password">
      <p class="login-error" id="loginError"></p>
      <button class="login-btn" id="loginBtn" type="button" data-ko="로그인" data-en="Sign In">로그인</button>
      <button class="ghost login-close-btn" id="loginCloseBtn" type="button" data-ko="보기로 돌아가기" data-en="Back to View">보기로 돌아가기</button>
    </div>
  </div>

  <header class="topbar">
    <a class="brand" href="/hub" title="WOLKO 허브로 돌아가기" style="text-decoration:none">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <div>
        <h1 data-ko="WOLKO 스케줄 플래너" data-en="WOLKO Schedule Planner">WOLKO 스케줄 플래너</h1>
        <p data-ko="스태프 & 차량 운영" data-en="Staff & Vans Operations">스태프 & 차량 운영</p>
      </div>
    </a>
    <div class="toolbar">
      <div class="date-picker" id="datePicker">
