      .week-item-time { font-size:7px; margin-bottom:1px; }
      .week-item-title { font-size:7.8px; }
      .week-item-tag { display:none; }
      .van-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:2mm; }
      .van-row { border:1px solid #cbd5e1; border-radius:5px; break-inside:avoid; page-break-inside:avoid; }
      .van-row-head { padding:2mm; }
      .van-trips { gap:1.5mm; padding:2mm; }
      .van-trip { border:1px solid #ead7ad; border-radius:4px; background:#fff7df; padding:1.8mm; font-size:8px; line-height:1.35; }
      .scroll-x { overflow:visible; border:0; }
