    function closeCalendar() {
      els.calendarPopover.hidden = true;
      els.calendarToggle.setAttribute('aria-expanded', 'false');
    }

    function toggleCalendar() {
      const isOpen = !els.calendarPopover.hidden;
      if (isOpen) {
        closeCalendar();
        return;
      }
      calendarMonth = firstOfMonth(els.selectedDate.value || todayIso());
      renderCalendar();
      els.calendarPopover.hidden = false;
      els.calendarToggle.setAttribute('aria-expanded', 'true');
    }

    function selectScheduleDate(iso, options = {}) {
      els.selectedDate.value = iso || todayIso();
      els.eventDate.value = els.selectedDate.value;
      calendarMonth = firstOfMonth(els.selectedDate.value);
      if (options.close !== false) closeCalendar();
      render();
    }

    function renderCalendar() {
      const selectedIso = els.selectedDate.value || todayIso();
      const today = todayIso();
      const monthIso = calendarMonth || firstOfMonth(selectedIso);
      const monthDate = parseIsoDate(monthIso);
      const firstVisible = new Date(monthDate.getFullYear(), monthDate.getMonth(), 1 - monthDate.getDay());
      const eventCounts = (plan.events || []).reduce((counts, event) => {
        if (event.date) counts[event.date] = (counts[event.date] || 0) + 1;
        return counts;
      }, {});
      const locale = currentLang === 'ko' ? 'ko-KR' : 'en-US';
      els.calendarTitle.textContent = new Intl.DateTimeFormat(locale, { year: 'numeric', month: 'long' }).format(monthDate);
      els.calendarWeekdays.innerHTML = (currentLang === 'ko'
        ? ['일', '월', '화', '수', '목', '금', '토']
        : ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat']
      ).map(day => `<span class="calendar-weekday">${escapeHtml(day)}</span>`).join('');
      els.calendarGrid.innerHTML = Array.from({ length: 42 }, (_, index) => {
        const date = new Date(firstVisible.getFullYear(), firstVisible.getMonth(), firstVisible.getDate() + index);
        const iso = isoFromDate(date);
        const count = eventCounts[iso] || 0;
        const classes = [
          'calendar-day',
          date.getMonth() !== monthDate.getMonth() ? 'is-outside' : '',
          iso === selectedIso ? 'is-selected' : '',
          iso === today ? 'is-today' : '',
        ].filter(Boolean).join(' ');
        const aria = `${new Intl.DateTimeFormat(locale, { month: 'long', day: 'numeric', weekday: 'long' }).format(date)}${count ? `, ${count}` : ''}`;
        return `
          <button class="${classes}" type="button" data-calendar-date="${escapeHtml(iso)}" aria-label="${escapeHtml(aria)}">
            <span>${date.getDate()}</span>
            ${count ? `<span class="calendar-day-count">${count}</span>` : ''}
          </button>
        `;
      }).join('');
      els.dateSummary.textContent = dateSummary(selectedIso);
      els.dateValue.textContent = selectedIso;
    }

    function renderStats() {
      const todayCount = plan.events.filter(event => event.date === els.selectedDate.value).length;
      const weekCount = weekEvents().length;
      const viewLabels = COPY[currentLang].printView;
      renderCalendar();
      els.statToday.textContent = todayCount;
      els.statWeek.textContent = weekCount;
      els.statVans.textContent = plan.vans.length;
      els.planTitleView.textContent = plan.title || 'WOLKO Staff Schedule';
      els.printSummary.textContent = tr('printSummary', {
        view: viewLabels[currentView] || viewLabels.day,
        date: els.selectedDate.value,
        today: todayCount,
        week: weekCount,
        vans: plan.vans.length,
      });
    }

    function render() {
      renderVansSelect();
      renderStats();
      renderDay();
      renderWeek();
      renderVans();
      renderPeople();
      renderList();
      renderFleet();
      document.querySelectorAll('.view').forEach(view => view.classList.toggle('active', view.id === `view-${currentView}`));
