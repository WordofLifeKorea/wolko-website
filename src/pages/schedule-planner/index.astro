                <div class="pdf-viewer-meta">${escapeHtml(pdf.uploadedAt ? new Date(pdf.uploadedAt).toLocaleString(currentLang === 'ko' ? 'ko-KR' : 'en-US') : '')}</div>
              </div>
              <div class="mini-actions">
                <a class="secondary" href="${escapeHtml(pdf.url)}" target="_blank" rel="noopener">${escapeHtml(tr('pdfOpen'))}</a>
                <button class="secondary danger" type="button" data-delete-pdf-date="${escapeHtml(date)}">${escapeHtml(tr('deletePdf'))}</button>
              </div>
            </div>
            <iframe class="pdf-frame" src="${escapeHtml(pdf.url)}" title="${escapeHtml(pdf.filename || 'PDF Schedule')}"></iframe>
          </div>
