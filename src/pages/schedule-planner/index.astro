            <div class="pdf-empty-actions">
              <button class="secondary" type="button" data-upload-pdf-date="${escapeHtml(date)}">${escapeHtml(tr('uploadPdfForDate', dayName(date)))}</button>
            </div>
          </div>`}
        </div>
      `;
