    function eventMeta(event) {
      const bits = [];
      if (event.staff) bits.push(`${tr('staff')}: ${event.staff}`);
      if (event.vanId) bits.push(`${tr('vehicle')}: ${vanName(event.vanId)}`);
      if (event.from || event.to) bits.push(`${event.from || tr('fromUnknown')} → ${event.to || tr('toUnknown')}`);
      if (event.passengers) bits.push(`${tr('people')}: ${event.passengers}`);
      if (event.notes) bits.push(event.notes);
      return bits.map(escapeHtml).join(' · ');
    }

