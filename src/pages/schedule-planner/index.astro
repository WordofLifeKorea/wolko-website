    }
    @media (max-width:720px) {
      :root { --space-page:20px; --space-card:16px; }
      .topbar { height:auto; min-height:60px; align-items:flex-start; flex-direction:column; padding:14px 18px; }
      .toolbar { justify-content:flex-start; }
      .toolbar button,.toolbar input { min-height:32px; font-size:11.5px; }
      .date-picker {
        width:100%; flex:1 1 100%; padding:10px;
      }
