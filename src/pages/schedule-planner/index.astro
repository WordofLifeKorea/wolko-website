                <button class="pdf-date-btn${itemDate === date ? ' active' : ''}" type="button" data-pdf-date="${escapeHtml(itemDate)}">
                  ${escapeHtml(dayName(itemDate))}
                  <span>${itemPdf ? escapeHtml(itemPdf.filename || 'schedule.pdf') : escapeHtml(currentLang === 'ko' ? 'PDF 없음' : 'No PDF')}</span>
                </button>
              `;
