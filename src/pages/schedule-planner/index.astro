    .pdf-detect-copy { margin-top:7px; color:var(--muted); font-size:13px; line-height:1.55; }
    .pdf-detect-body { overflow:auto; padding:16px 22px; display:grid; gap:10px; }
    .pdf-detect-row {
      display:grid; grid-template-columns:minmax(0,1fr) auto; gap:12px; align-items:center;
