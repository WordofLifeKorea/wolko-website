      els.eventVan.innerHTML = `<option value="">${escapeHtml(tr('noVehicle'))}</option>${plan.vans.map(van => `<option value="${escapeHtml(van.id)}">${escapeHtml(van.name)}</option>`).join('')}`;
    }

    function renderFilterControls() {
      const groups = groupOptions();
      if (currentGroupFilter !== 'all' && !groups.some(group => group.key === currentGroupFilter)) currentGroupFilter = 'all';
      els.groupFilterSelect.innerHTML = `<option value="all">${escapeHtml(tr('groupFilterAll'))}</option>`
        + groups.map(group => `<option value="${escapeHtml(group.key)}" ${group.key === currentGroupFilter ? 'selected' : ''}>${escapeHtml(group.label)}</option>`).join('');
