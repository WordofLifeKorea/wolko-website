    .pdf-empty-actions { display:flex; justify-content:center; margin-top:12px; }
    .pdf-frame { width:100%; height:min(78vh,900px); border:0; display:block; background:#f8fafc; }
    .pdf-detect-backdrop {
      position:fixed; inset:0; z-index:1100; display:flex; align-items:center; justify-content:center; padding:18px;
      background:rgba(0,35,48,.52); backdrop-filter:blur(5px);
    }
    .pdf-detect-backdrop[hidden] { display:none; }
    .pdf-detect-modal {
      width:min(720px,100%); max-height:min(84vh,760px); display:grid; grid-template-rows:auto minmax(0,1fr) auto;
      border-radius:24px; background:#fff; box-shadow:0 24px 70px rgba(0,0,0,.28); overflow:hidden;
