    function todayIso() {
      return new Date().toISOString().slice(0, 10);
    }

    function addDays(iso, count) {
      const date = new Date(`${iso}T00:00:00`);
      date.setDate(date.getDate() + count);
      return date.toISOString().slice(0, 10);
    }

    function weekStart(iso) {
      const date = new Date(`${iso}T00:00:00`);
      const day = date.getDay();
      date.setDate(date.getDate() - day);
      return date.toISOString().slice(0, 10);
    }

    function dayName(iso) {
      return new Intl.DateTimeFormat(currentLang === 'ko' ? 'ko-KR' : 'en-US', { month: 'numeric', day: 'numeric', weekday: 'short' }).format(new Date(`${iso}T00:00:00`));
    }

    function dateSummary(iso) {
      const date = new Date(`${iso || todayIso()}T00:00:00`);
      return new Intl.DateTimeFormat(currentLang === 'ko' ? 'ko-KR' : 'en-US', {
        weekday: 'short',
        month: 'short',
        day: 'numeric',
      }).format(date);
    }

    function parseIsoDate(iso) {
      const [year, month, day] = String(iso || todayIso()).split('-').map(Number);
      return new Date(year, (month || 1) - 1, day || 1);
    }

    function isoFromDate(date) {
      return `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
    }

    function firstOfMonth(iso) {
      const date = parseIsoDate(iso);
      return isoFromDate(new Date(date.getFullYear(), date.getMonth(), 1));
    }

    function shiftCalendarMonth(delta) {
      const date = parseIsoDate(calendarMonth || firstOfMonth(els.selectedDate.value || todayIso()));
      calendarMonth = isoFromDate(new Date(date.getFullYear(), date.getMonth() + delta, 1));
      renderCalendar();
    }

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
    }

    function vanName(vanId) {
      if (!vanId) return '';
      return plan.vans.find(van => van.id === vanId)?.name || vanId;
    }

    function eventTime(event) {
      if (event.start && event.end) return `${event.start}–${event.end}`;
      if (event.start) return event.start;
      return event.timeText || '';
    }

    function normalizeClock(value) {
      const match = String(value || '').match(/(\d{1,2})(?::(\d{2}))?/);
      if (!match) return '';
      return `${String(parseInt(match[1], 10)).padStart(2, '0')}:${match[2] || '00'}`;
    }

    function clockRange(value) {
      const matches = [...String(value || '').matchAll(/(\d{1,2})(?::(\d{2}))?/g)];
      return {
        start: matches[0] ? `${String(parseInt(matches[0][1], 10)).padStart(2, '0')}:${matches[0][2] || '00'}` : '',
        end: matches[1] ? `${String(parseInt(matches[1][1], 10)).padStart(2, '0')}:${matches[1][2] || '00'}` : '',
      };
    }

    // 캠프 일정 오전/오후 자동 판단: 1~5시 → 오후(+12), 나머지 그대로
    function autoAdjustHour(hhmm) {
      if (!hhmm) return hhmm;
      const [hStr, mStr] = String(hhmm).split(':');
      const h = parseInt(hStr, 10);
      if (isNaN(h)) return hhmm;
      return `${String(h >= 1 && h <= 5 ? h + 12 : h).padStart(2, '0')}:${mStr || '00'}`;
    }

    function slugKey(value) {
      return String(value || '')
        .toLowerCase()
        .replace(/&/g, 'and')
        .replace(/[^a-z0-9가-힯]+/g, '-')
        .replace(/^-+|-+$/g, '') || 'unknown';
    }

    function isMostlyDateSheetName(name) {
      const value = String(name || '').trim();
      return /^(sun|mon|tue|wed|thu|fri|sat)(day)?$/i.test(value)
        || /^[월화수목금토일](요일)?$/.test(value)
        || /\b\d{1,2}[./\-]\d{1,2}\b/.test(value)
        || /\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?\s*\d{1,2}\b/i.test(value)
        || /\d{1,2}\s*월\s*\d{1,2}/.test(value);
    }

    function sourceGroupFromText(...parts) {
      const raw = parts.map(part => String(part || '')).join(' ');
      const value = raw.toLowerCase().replace(/[_-]+/g, ' ');
      const compact = value.replace(/\s+/g, '');
      const exact = (key, label) => ({ key, label });
      if (/\bsf\s*#?\s*1\b/i.test(raw) || /student\s*fusion\s*(team\s*)?1/i.test(raw) || compact.includes('sf1')) {
        return exact('student-fusion-team-1', 'Student Fusion Team 1');
      }
      if (/\bsf\s*#?\s*2\b/i.test(raw) || /student\s*fusion\s*(team\s*)?2/i.test(raw) || compact.includes('sf2')) {
        return exact('student-fusion-team-2', 'Student Fusion Team 2');
      }
      if (/wolko\s*camp|english\s*wolko|월코\s*캠프/i.test(raw)) {
        return exact('english-wolko-camp', 'English WOLKO Camp');
      }
      if (/student\s*fusion|\bsf\b/i.test(raw)) {
        return exact('student-fusion', 'Student Fusion');
      }
      if (/wolko|월코/i.test(raw)) {
        return exact('wolko', 'WOLKO');
      }
      return null;
    }

    function sourceGroupForSheet(sheetName) {
      const matched = sourceGroupFromText(sheetName);
      if (matched) return matched;
      if (isMostlyDateSheetName(sheetName)) return { key: '', label: '' };
      const label = cellText(sheetName);
      return label ? { key: `sheet-${slugKey(label)}`, label } : { key: '', label: '' };
    }

    function cellText(value) {
      return String(value ?? '').trim();
    }

    function formatExcelTime(value) {
      const raw = cellText(value);
      const n = Number(raw);
      if (Number.isFinite(n) && n >= 0 && n < 1) {
        const total = Math.round(n * 24 * 60);
        return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
      }
      return raw.replace(/^(\d{1,2}:\d{2}):00$/, '$1');
    }

    function parseSheetDate(sheetName) {
      const year = parseInt((els.selectedDate.value || todayIso()).slice(0, 4), 10);
      const name = String(sheetName || '');
      const ymd = (m, d) => m >= 1 && m <= 12 && d >= 1 && d <= 31
        ? `${year}-${String(m).padStart(2,'0')}-${String(d).padStart(2,'0')}` : null;
      // "7월 28일" or "7월28일"
      let r = name.match(/(\d{1,2})\s*월\s*(\d{1,2})/);
      if (r) return ymd(+r[1], +r[2]) || els.selectedDate.value || todayIso();
      // "7/28" or "07.28" or "7-28"
      r = name.match(/(\d{1,2})[/.\-](\d{1,2})/);
      if (r) return ymd(+r[1], +r[2]) || els.selectedDate.value || todayIso();
      // "Jul 28" or "July 28"
      const months = {
        jan:1,january:1,feb:2,february:2,mar:3,march:3,apr:4,april:4,
        may:5,jun:6,june:6,jul:7,july:7,aug:8,august:8,sep:9,sept:9,
        september:9,oct:10,october:10,nov:11,november:11,dec:12,december:12,
      };
      r = name.match(/\b([A-Za-z]+)\s+(\d{1,2})/);
      if (r) { const m = months[r[1].toLowerCase()]; if (m) return ymd(m, +r[2]) || els.selectedDate.value || todayIso(); }
      return els.selectedDate.value || todayIso();
    }

    function inferType(title, details) {
      const value = `${title} ${details}`.toLowerCase();
      if (/depart|arrive|airport|van|transport|station|subway|train|vehicle|dorm/.test(value)) return 'transport';
      if (/breakfast|brunch|lunch|dinner|bbq|meal/.test(value)) return 'meal';
      if (/meeting|debrief|announcement/.test(value)) return 'meeting';
      if (/prep|training|practice|orientation/.test(value)) return 'prep';
      return 'program';
    }

    function readUint16(view, offset) {
      return view.getUint16(offset, true);
    }

    function readUint32(view, offset) {
      return view.getUint32(offset, true);
    }

    async function inflateZipEntry(bytes, method) {
      if (method === 0) return bytes;
      if (method !== 8 || !window.DecompressionStream) {
        throw new Error(tr('zipUnsupported'));
      }
      const stream = new Blob([bytes]).stream().pipeThrough(new DecompressionStream('deflate-raw'));
      return new Uint8Array(await new Response(stream).arrayBuffer());
    }

    async function unzipXlsx(buffer) {
      const bytes = new Uint8Array(buffer);
      const view = new DataView(buffer);
      let eocd = -1;
      for (let i = bytes.length - 22; i >= 0; i -= 1) {
        if (readUint32(view, i) === 0x06054b50) {
          eocd = i;
          break;
        }
      }
      if (eocd < 0) throw new Error(tr('invalidXlsx'));
      const entries = readUint16(view, eocd + 10);
      let cursor = readUint32(view, eocd + 16);
      const decoder = new TextDecoder();
      const files = {};
      for (let i = 0; i < entries; i += 1) {
        if (readUint32(view, cursor) !== 0x02014b50) break;
        const method = readUint16(view, cursor + 10);
        const compressedSize = readUint32(view, cursor + 20);
        const nameLen = readUint16(view, cursor + 28);
        const extraLen = readUint16(view, cursor + 30);
        const commentLen = readUint16(view, cursor + 32);
        const localOffset = readUint32(view, cursor + 42);
        const name = decoder.decode(bytes.slice(cursor + 46, cursor + 46 + nameLen));
        const localNameLen = readUint16(view, localOffset + 26);
        const localExtraLen = readUint16(view, localOffset + 28);
        const dataStart = localOffset + 30 + localNameLen + localExtraLen;
        const compressed = bytes.slice(dataStart, dataStart + compressedSize);
        files[name] = decoder.decode(await inflateZipEntry(compressed, method));
        cursor += 46 + nameLen + extraLen + commentLen;
      }
      return files;
    }

    function relMap(xml) {
      const doc = new DOMParser().parseFromString(xml || '', 'application/xml');
      const map = {};
      Array.from(doc.getElementsByTagName('Relationship')).forEach(rel => {
        map[rel.getAttribute('Id')] = rel.getAttribute('Target');
      });
      return map;
    }

    function sharedStrings(xml) {
      if (!xml) return [];
      const doc = new DOMParser().parseFromString(xml, 'application/xml');
      return Array.from(doc.getElementsByTagName('si')).map(si => si.textContent || '');
    }

    function columnIndex(ref) {
      const letters = String(ref || '').match(/[A-Z]+/)?.[0] || 'A';
      return [...letters].reduce((sum, ch) => sum * 26 + ch.charCodeAt(0) - 64, 0) - 1;
    }

    function parseWorksheet(xml, shared) {
      const doc = new DOMParser().parseFromString(xml, 'application/xml');
      const rowMap = {};
      Array.from(doc.getElementsByTagName('row')).forEach(xmlRow => {
        // r 속성은 1-based 실제 행 번호 → 0-based 인덱스로 변환
        const rowIdx = parseInt(xmlRow.getAttribute('r') || '1', 10) - 1;
        const values = [];
        Array.from(xmlRow.getElementsByTagName('c')).forEach(cell => {
          const index = columnIndex(cell.getAttribute('r'));
          const type = cell.getAttribute('t');
          const v = cell.getElementsByTagName('v')[0]?.textContent || '';
          values[index] = type === 's' ? (shared[parseInt(v, 10)] || '') : (type === 'inlineStr' ? cell.textContent || '' : v);
        });
        rowMap[rowIdx] = values;
      });
      if (!Object.keys(rowMap).length) return [];
      const maxIdx = Math.max(...Object.keys(rowMap).map(Number));
      return Array.from({ length: maxIdx + 1 }, (_, i) => rowMap[i] || []);
    }

    async function readWorkbook(buffer) {
      const files = await unzipXlsx(buffer);
      const workbookXml = files['xl/workbook.xml'];
      if (!workbookXml) throw new Error(tr('workbookReadFailed'));
      const workbookDoc = new DOMParser().parseFromString(workbookXml, 'application/xml');
      const rels = relMap(files['xl/_rels/workbook.xml.rels']);
      const shared = sharedStrings(files['xl/sharedStrings.xml']);
      return Array.from(workbookDoc.getElementsByTagName('sheet')).map(sheet => {
        const name = sheet.getAttribute('name') || 'Sheet';
        const relId = sheet.getAttribute('r:id') || sheet.getAttribute('id');
        const target = rels[relId] || '';
        const path = target.startsWith('xl/') ? target : `xl/${target.replace(/^\/?xl\//, '')}`;
        return { name, rows: parseWorksheet(files[path] || '', shared) };
      });
    }

    function importPeopleSheet(rows, sheetName = '') {
      const people = [];
      rows.slice(2).forEach(row => {
        const sfName = cellText(row[1]);
        if (sfName && sfName.toLowerCase() !== 'first') {
          people.push({
            id: crypto.randomUUID(),
            group: 'sf',
            no: parseInt(cellText(row[0]), 10) || people.filter(person => person.group === 'sf').length + 1,
            name: sfName,
            gender: cellText(row[2]),
            age: cellText(row[3]),
            shirt: cellText(row[4]),
            birthday: cellText(row[5]),
            note: cellText(row[6]),
          });
        }
        const wolkoName = cellText(row[9]);
        if (wolkoName && !/k\(t-size\)/i.test(wolkoName)) {
          people.push({
            id: crypto.randomUUID(),
            group: 'wolko',
            no: parseInt(cellText(row[8]), 10) || people.filter(person => person.group === 'wolko').length + 1,
            name: wolkoName,
            gender: cellText(row[10]),
            age: '',
            shirt: '',
            birthday: '',
            note: cellText(row[11]),
          });
        }
      });
      const fixedLayoutPeople = people.filter(person => person.name);
      if (fixedLayoutPeople.length) return fixedLayoutPeople;

      const headerIndex = rows.findIndex(row => row.some(cell => /name|이름|성명|camper|student|member|참가자|팀원|staff|스태프/i.test(cellText(cell))));
      const headers = (rows[headerIndex] || []).map(cell => cellText(cell).toLowerCase());
      const findCol = patterns => headers.findIndex(header => patterns.some(pattern => pattern.test(header)));
      const nameCol = findCol([/name/, /이름/, /성명/, /camper/, /student/, /member/, /참가자/, /팀원/, /staff/, /스태프/]);
      const genderCol = findCol([/gender/, /sex/, /성별/]);
      const ageCol = findCol([/age/, /grade/, /나이/, /학년/]);
      const shirtCol = findCol([/shirt/, /size/, /티셔츠/, /사이즈/]);
      const birthdayCol = findCol([/birth/, /birthday/, /dob/, /생년월일/, /생일/]);
      const noteCol = findCol([/note/, /memo/, /remark/, /메모/, /비고/]);
      const groupCol = findCol([/team/, /group/, /camp/, /팀/, /조/, /캠프/]);
      const fallbackNameCol = nameCol >= 0 ? nameCol : rows.reduce((best, row, ri) => {
        if (ri <= headerIndex) return best;
        row.forEach((cell, ci) => {
          const text = cellText(cell);
          if (!text || /^\d+$/.test(text) || parseDateFromTextLine(text) || /\d{1,2}:\d{2}/.test(text)) return;
          best.counts[ci] = (best.counts[ci] || 0) + 1;
          if ((best.counts[ci] || 0) > (best.counts[best.col] || 0)) best.col = ci;
        });
        return best;
      }, { col: 0, counts: {} }).col;
      const startIndex = headerIndex >= 0 ? headerIndex + 1 : 0;
      const sheetGroup = sourceGroupForSheet(sheetName);
      const groupName = (row) => cellText(row[groupCol]) || sheetGroup.label || sheetName;

      return rows.slice(startIndex).map((row, index) => {
        const name = cellText(row[fallbackNameCol]);
        if (!name || /name|이름|성명|camper|student|member|참가자|팀원/i.test(name)) return null;
        const matchedGroup = sourceGroupFromText(groupName(row), row.join(' '));
        return {
          id: crypto.randomUUID(),
          group: matchedGroup?.key?.includes('wolko') ? 'wolko' : 'sf',
          no: parseInt(cellText(row[0]), 10) || index + 1,
          name,
          gender: genderCol >= 0 ? cellText(row[genderCol]) : '',
          age: ageCol >= 0 ? cellText(row[ageCol]) : '',
          shirt: shirtCol >= 0 ? cellText(row[shirtCol]) : '',
          birthday: birthdayCol >= 0 ? cellText(row[birthdayCol]) : '',
          note: noteCol >= 0 ? cellText(row[noteCol]) : groupName(row),
        };
      }).filter(person => person?.name);
    }

    function importScheduleSheet(sheetName, rows) {
      const year = parseInt((els.selectedDate.value || todayIso()).slice(0, 4), 10);
      let currentDate = parseSheetDate(sheetName);
      const sheetGroup = sourceGroupForSheet(sheetName);

      // 시간값 판별: Excel 소수(0~1) 또는 HH:MM 패턴
      const looksLikeTime = v => {
        if (v === undefined || v === null || v === '') return false;
        const n = Number(v);
        if (Number.isFinite(n) && n > 0 && n < 1) return true;
        return /^\d{1,2}:\d{2}/.test(String(v));
      };

      // 행에서 날짜 감지 (시간 열이 비어있고 날짜 패턴이 있는 행 = 날짜 헤더)
      const parseDateFromRow = (row, tCol) => {
        if (looksLikeTime(row[tCol])) return null; // 시간값 있으면 이벤트 행
        const texts = (row || []).filter(v => v !== undefined && v !== null && v !== '').map(v => cellText(v));
        if (!texts.length || texts.length > 5) return null;
        const combined = texts.join(' ');
        let m = combined.match(/(\d{1,2})\s*월\s*(\d{1,2})/);
        if (m) { const mo=+m[1],d=+m[2]; if(mo>=1&&mo<=12&&d>=1&&d<=31) return `${year}-${String(mo).padStart(2,'0')}-${String(d).padStart(2,'0')}`; }
        m = combined.match(/\b(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\s+(\d{1,2})\b/i);
        if (m) { const mos={jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12}; const mo=mos[m[1].toLowerCase().slice(0,3)]; if(mo) return `${year}-${String(mo).padStart(2,'0')}-${String(+m[2]).padStart(2,'0')}`; }
        return null;
      };

      // 데이터 시작 행과 시간 열을 자동 탐지
      let dataStart = 0;
      let timeCol = -1;
      for (let ri = 0; ri < Math.min(rows.length, 15); ri++) {
        const row = rows[ri] || [];
        for (let ci = 0; ci < Math.min(row.length, 5); ci++) {
          if (looksLikeTime(row[ci])) { timeCol = ci; dataStart = ri; break; }
        }
        if (timeCol >= 0) break;
      }
      if (timeCol < 0) { timeCol = 1; dataStart = 3; }

      let dateCol = -1;
      const headerRow = rows[Math.max(0, dataStart - 1)] || [];
      headerRow.forEach((cell, ci) => {
        if (/date|day|날짜|요일/i.test(cellText(cell)) && ci !== timeCol) dateCol = ci;
      });
      if (dateCol < 0) {
        let best = { col: -1, count: 0 };
        for (let ci = 0; ci < Math.min(8, Math.max(...rows.map(row => row.length), 0)); ci += 1) {
          if (ci === timeCol) continue;
          const count = rows.slice(dataStart, dataStart + 20).filter(row => parseDateFromTextLine(cellText(row[ci]))).length;
          if (count > best.count) best = { col: ci, count };
        }
        if (best.count >= 2) dateCol = best.col;
      }

      const namedTitleCol = headerRow.findIndex(cell => /activity|schedule|program|title|event|일정|프로그램|활동|제목|내용/i.test(cellText(cell)));
      let titleCol = namedTitleCol >= 0 && namedTitleCol !== timeCol && namedTitleCol !== dateCol ? namedTitleCol : timeCol + 1;
      if (titleCol === dateCol) titleCol += 1;
      const namedDetailsCol = headerRow.findIndex(cell => /detail|note|memo|location|place|비고|메모|장소|세부/i.test(cellText(cell)));
      let detailsCol = namedDetailsCol >= 0 && namedDetailsCol !== timeCol && namedDetailsCol !== dateCol && namedDetailsCol !== titleCol
        ? namedDetailsCol : titleCol + 1;
      if (detailsCol === dateCol || detailsCol === timeCol) detailsCol += 1;

      console.log(`[Import] "${sheetName}" → date:${currentDate} timeCol:${timeCol} dataStart:${dataStart}`);

      const events = [];
      rows.slice(dataStart).forEach(row => {
        // 날짜 헤더 행 감지
        const dateFromRow = parseDateFromRow(row, timeCol);
        if (dateFromRow) { currentDate = dateFromRow; console.log(`[Import] 날짜 변경 → ${currentDate}`); return; }

        const timeText = formatExcelTime(row[timeCol]);
        const title = cellText(row[titleCol]);
        const details = cellText(row[detailsCol]);
        const rowDate = dateCol >= 0 ? parseDateFromTextLine(cellText(row[dateCol])) : null;
        if (rowDate) currentDate = rowDate;
        if (!timeText || !title || /^(time|시간)/i.test(timeText) || /^(time|시간|일정|schedule)/i.test(title)) return;
        const parsed = clockRange(timeText);
        const rowGroup = sourceGroupFromText(sheetName, title, details, row.join(' ')) || sheetGroup;
        events.push({
          id: crypto.randomUUID(),
          title,
          type: inferType(title, details),
          date: currentDate,
          timeText,
          start: autoAdjustHour(parsed.start),
          end: autoAdjustHour(parsed.end),
          staff: '',
          vanId: '',
          from: '',
          to: '',
          passengers: '',
          notes: details,
          sourceSheet: sheetName,
          sourceGroupKey: rowGroup.key,
          sourceGroupLabel: rowGroup.label,
        });
      });
      return events;
    }

    function importTransportSheet(sheetName, rows) {
      const title = cellText(rows[1]?.[1]) || sheetName;
      const sheetGroup = sourceGroupForSheet(sheetName);
      const names = rows[2] || [];
      const drivers = rows[3] || [];
      const importedVans = [];
      for (let col = 1; col < Math.min(names.length, 12); col += 1) {
        const name = cellText(names[col]);
        if (!name || /student fusion|wol staff/i.test(name)) continue;
        importedVans.push({
          id: `import-van-${crypto.randomUUID()}`,
          name,
          seats: 0,
          driver: cellText(drivers[col]).replace(/^D\s*-\s*/i, ''),
          memo: '',
          col,
        });
      }
      if (!importedVans.length) {
        const vehicleName = value => /van|vehicle|car|bus|밴|차량|버스|호차|기사|driver/i.test(cellText(value));
        const headerRowIndex = rows.findIndex(row => row.filter(vehicleName).length >= 2);
        if (headerRowIndex >= 0) {
          const header = rows[headerRowIndex] || [];
          header.forEach((cell, col) => {
            const name = cellText(cell);
            if (col === 0 || !vehicleName(name)) return;
            importedVans.push({
              id: `import-van-${crypto.randomUUID()}`,
              name,
              seats: 0,
              driver: '',
              memo: '',
              col,
            });
          });
          const driverRow = rows.slice(headerRowIndex + 1, headerRowIndex + 4)
            .find(row => /driver|기사|운전자/i.test(row.map(cellText).join(' ')));
          importedVans.forEach(van => {
            van.driver = cellText(driverRow?.[van.col]).replace(/^D\s*-\s*/i, '');
          });
        } else {
          rows.forEach((row, index) => {
            const text = row.map(cellText).filter(Boolean).join(' · ');
            if (!/van|vehicle|car|bus|밴|차량|버스|호차/i.test(text)) return;
            const name = row.map(cellText).find(vehicleName) || `${tr('vehicle')} ${index + 1}`;
            importedVans.push({
              id: `import-van-${crypto.randomUUID()}`,
              name,
              seats: 0,
              driver: (text.match(/(?:driver|기사|운전자)\s*[:：-]?\s*([^·]+)/i)?.[1] || '').trim(),
              memo: '',
              col: -1,
              rowText: text,
            });
          });
        }
      }
      const vans = importedVans.map(({ col, ...van }) => van);
      const assignments = {};
      importedVans.forEach(van => {
        assignments[van.id] = {
          driver: van.driver,
          passengers: van.col >= 0
            ? rows.slice(4).map(row => cellText(row[van.col])).filter(Boolean).join('\n')
            : (van.rowText || '').replace(van.name, '').trim(),
          notes: '',
        };
      });
      return {
        vans,
        transportPlan: {
          id: crypto.randomUUID(),
          title,
          date: els.selectedDate.value || todayIso(),
          description: cellText(rows[2]?.[8]),
          vanIds: vans.map(v => v.id),
          assignments,
          sourceSheet: sheetName,
          sourceGroupKey: sheetGroup.key,
          sourceGroupLabel: sheetGroup.label,
        },
      };
    }

    function isScheduleSheetName(name) {
      if (/schedule|일정|운영표/i.test(name)) return true;
      // "Jul 4", "July 4", "07/04", "7.4" 형태의 날짜 시트명
      if (/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?\s*\d{1,2}\b/i.test(name)) return true;
      if (/\b\d{1,2}[./]\d{1,2}\b/.test(name)) return true;
      return false;
    }

    function isPeopleSheetName(name) {
      return /people|person|list|명단|인원/i.test(name);
    }

    function sheetText(sheet) {
      return `${sheet.name || ''} ${(sheet.rows || []).map(row => row.map(cellText).join(' ')).join(' ')}`.toLowerCase();
    }

    function countTimeCells(rows) {
      return (rows || []).reduce((count, row) => count + row.filter(value => {
        const text = formatExcelTime(value);
        const n = Number(value);
        return (Number.isFinite(n) && n > 0 && n < 1) || /\b\d{1,2}:\d{2}\b/.test(text) || /\b\d{1,2}\s*(am|pm)\b/i.test(text);
      }).length, 0);
    }

    function countHeaderMatches(rows, patterns) {
      return (rows || []).slice(0, 8).reduce((count, row) => count + row.filter(cell => {
        const text = cellText(cell);
        return patterns.some(pattern => pattern.test(text));
      }).length, 0);
    }

    function inferSheetCategory(sheet) {
      const rows = sheet.rows || [];
      const text = sheetText(sheet);
      const timeCount = countTimeCells(rows);
      const dateCount = rows.flat().filter(cell => parseDateFromTextLine(cellText(cell))).length;
      const scores = {
        schedule: 0,
        people: 0,
        transport: 0,
      };

      if (isScheduleSheetName(sheet.name)) scores.schedule += 5;
      if (isPeopleSheetName(sheet.name)) scores.people += 5;
      if (/transport|vehicle|van|driver|passenger|pickup|drop.?off|차량|운행|배차|픽업|드라이버|기사|탑승/i.test(sheet.name)) scores.transport += 6;

      scores.schedule += Math.min(timeCount, 8);
      scores.schedule += Math.min(dateCount, 4);
      scores.schedule += countHeaderMatches(rows, [/time/i, /schedule/i, /program/i, /activity/i, /시간/, /일정/, /프로그램/]) * 2;

      scores.people += countHeaderMatches(rows, [/name/i, /gender/i, /age/i, /grade/i, /shirt/i, /birth/i, /team/i, /member/i, /이름/, /성별/, /학년/, /나이/, /티셔츠/, /생년월일/, /팀원/, /명단/]) * 2;
      scores.transport += countHeaderMatches(rows, [/van/i, /vehicle/i, /car/i, /bus/i, /driver/i, /passenger/i, /from/i, /to/i, /밴/, /차량/, /버스/, /기사/, /운전자/, /탑승/, /출발/, /도착/]) * 2;

      if (/breakfast|lunch|dinner|worship|meeting|orientation|activity|session|meal|식사|예배|모임|오리엔테이션|프로그램/.test(text)) scores.schedule += 3;
      if (/first|last|male|female|student|staff|camper|grade|shirt|birthday|학생|스태프|캠퍼|남|여|학년/.test(text)) scores.people += 3;
      if (/driver|passenger|airport|station|pickup|drop.?off|route|차량|기사|탑승|공항|역|픽업|드랍|노선/.test(text)) scores.transport += 4;

      if (scores.transport >= scores.schedule && scores.transport >= scores.people && scores.transport >= 5) return 'transport';
      if (scores.people >= scores.schedule && scores.people >= scores.transport && scores.people >= 5) return 'people';
      if (scores.schedule >= 4) return 'schedule';
      return 'ignore';
    }

    function importSheetsAutomatically(sheets) {
      const imported = { events: [], people: [], vans: [], transportPlans: [], sheetLog: [] };
      console.group('[Schedule Planner] Auto Import');
      sheets.forEach(sheet => {
        const cat = inferSheetCategory(sheet);
        console.log(`Sheet: "${sheet.name}" → ${cat}`);
        if (cat === 'people') {
          const before = imported.people.length;
          imported.people.push(...importPeopleSheet(sheet.rows, sheet.name));
          imported.sheetLog.push(`인원: "${sheet.name}" → ${imported.people.length - before}명`);
        } else if (cat === 'schedule') {
          const before = imported.events.length;
          imported.events.push(...importScheduleSheet(sheet.name, sheet.rows));
          imported.sheetLog.push(`일정: "${sheet.name}" → ${imported.events.length - before}개`);
        } else if (cat === 'transport') {
          const transport = importTransportSheet(sheet.name, sheet.rows);
          if (transport.vans.length) {
            imported.vans.push(...transport.vans);
            imported.transportPlans.push(transport.transportPlan);
            imported.sheetLog.push(`차량: "${sheet.name}" → 밴 ${transport.vans.length}대`);
          } else {
            imported.sheetLog.push(`차량: "${sheet.name}" → 인식된 차량 없음`);
          }
        } else {
          imported.sheetLog.push(`무시됨: "${sheet.name}"`);
        }
      });
      console.groupEnd();
      return imported;
    }

    function loadImportHistory() {
      try { return JSON.parse(localStorage.getItem(IMPORT_HISTORY_KEY) || '[]'); }
      catch { return []; }
    }

    function saveImportToHistory(filename, imported) {
      const history = loadImportHistory();
      const entry = {
        id: crypto.randomUUID(),
        name: filename.replace(/\.(xlsx?|pdf|html?)$/i, ''),
        date: new Date().toISOString(),
        snapshot: {
          events: imported.events,
          people: imported.people,
          vans: imported.vans,
          transportPlans: imported.transportPlans,
        },
      };
      history.unshift(entry);
      if (history.length > MAX_IMPORT_HISTORY) history.splice(MAX_IMPORT_HISTORY);
      try { localStorage.setItem(IMPORT_HISTORY_KEY, JSON.stringify(history)); } catch (e) {
        console.warn('Import history save failed (storage full?):', e);
      }
    }

    function renderImportHistorySelect() {
      const history = loadImportHistory();
      const sel = els.importHistorySelect;
      if (!history.length) { sel.style.display = 'none'; return; }
      const locale = currentLang === 'ko' ? 'ko-KR' : 'en-US';
      sel.innerHTML = `<option value="">${escapeHtml(tr('importHistoryLabel'))}</option>`
        + history.map(e => {
            const d = new Date(e.date);
            const dateStr = d.toLocaleDateString(locale, { month: 'short', day: 'numeric' })
              + ' ' + d.toLocaleTimeString(locale, { hour: '2-digit', minute: '2-digit' });
            return `<option value="${escapeHtml(e.id)}">${escapeHtml(e.name)} · ${dateStr}</option>`;
          }).join('');
      sel.style.display = '';
    }

    // 'yes' | 'no' | 'cancel' 을 resolve 하는 3분기 다이얼로그
    function askTranslate() {
      return new Promise(resolve => {
        const dlg = document.getElementById('translateDialog');
        const yes = document.getElementById('translateDialogYes');
        const no = document.getElementById('translateDialogNo');
        const cancel = document.getElementById('translateDialogCancel');
        dlg.style.display = 'flex';
        const done = v => { dlg.style.display = 'none'; resolve(v); };
        const yH = () => done('yes');
        const nH = () => done('no');
        const cH = () => done('cancel');
        yes.addEventListener('click', yH, { once: true });
        no.addEventListener('click', nH, { once: true });
        cancel.addEventListener('click', cH, { once: true });
      });
    }

    function needsTranslation(text) {
      if (!text || typeof text !== 'string' || !text.trim()) return false;
      if (/[가-힯ᄀ-ᇿ㄰-㆏]/.test(text)) return false;
      return /[a-zA-Z]{2,}/.test(text);
    }

    async function translateImported(imported) {
      const fields = ['title', 'notes', 'from', 'to', 'staff', 'passengers'];
      const targets = [];
      imported.events.forEach((ev, ei) => {
        fields.forEach(f => {
          if (needsTranslation(ev[f])) targets.push({ ei, f, text: ev[f] });
        });
      });
      if (!targets.length) { console.log('[Translate] 번역할 영어 텍스트 없음'); return; }
      console.log(`[Translate] ${targets.length}개 항목 번역 요청`);

      let apiKey = localStorage.getItem(ANTHROPIC_KEY_LS);
      if (!apiKey) {
        apiKey = prompt('Anthropic API 키를 입력하세요.\n(브라우저에 저장되며 다음부터는 묻지 않습니다)');
        if (!apiKey) { alert('번역을 건너뜁니다. (API 키 없음)'); return; }
        localStorage.setItem(ANTHROPIC_KEY_LS, apiKey.trim());
      }

      const translationPrompt = `You are translating English camp schedule text to Korean.
Rules:
- Translate each item to natural Korean.
- Keep proper nouns (names of people, places like "WOLKO Center", "Songtan") as-is.
- Keep time expressions as-is.
- Return ONLY a valid JSON array of translated strings, same length and order as input.
- No explanation, no markdown, no extra text.

Input: ${JSON.stringify(targets.map(t => t.text))}`;

      try {
        const res = await fetch('https://api.anthropic.com/v1/messages', {
          method: 'POST',
          headers: {
            'x-api-key': apiKey.trim(),
            'anthropic-version': '2023-06-01',
            'anthropic-dangerous-direct-browser-access': 'true',
            'content-type': 'application/json',
          },
          body: JSON.stringify({
            model: 'claude-sonnet-4-6',
            max_tokens: 4096,
            messages: [{ role: 'user', content: translationPrompt }],
          }),
        });
        if (!res.ok) {
          const errBody = await res.text().catch(() => '');
          console.error('[Translate] API 오류', res.status, errBody);
          if (res.status === 401) {
            localStorage.removeItem(ANTHROPIC_KEY_LS);
            alert(`API 키가 올바르지 않습니다. 다음 번역 시 다시 입력하세요.\n${errBody.slice(0, 100)}`);
          } else {
            alert(`번역 실패 (${res.status})\n${errBody.slice(0, 200)}`);
          }
          return;
        }
        const data = await res.json();
        let raw = data.content?.[0]?.text?.trim() || '[]';
        const fenced = raw.match(/```(?:json)?\s*([\s\S]*?)\s*```/);
        if (fenced) raw = fenced[1].trim();
        let translations;
        try { translations = JSON.parse(raw); } catch { alert('번역 결과 파싱 오류'); return; }
        if (!Array.isArray(translations)) { alert('번역 결과 형식 오류'); return; }
        while (translations.length < targets.length) translations.push(targets[translations.length].text);
        translations = translations.slice(0, targets.length);
        console.log('[Translate] 완료:', translations);
        translations.forEach((translated, i) => {
          if (translated) {
            const { ei, f } = targets[i];
            const ev = imported.events[ei];
            if (!ev._en) ev._en = {};
            ev._en[f] = ev[f];
            ev[f] = translated;
          }
        });
      } catch (err) {
        console.error('[Translate] 네트워크 오류:', err);
        alert(`번역 오류: ${err.message}`);
      }
    }

    function parseDateFromTextLine(line) {
      const year = parseInt((els.selectedDate.value || todayIso()).slice(0, 4), 10);
      const value = String(line || '');
      const ymd = (m, d) => m >= 1 && m <= 12 && d >= 1 && d <= 31
        ? `${year}-${String(m).padStart(2, '0')}-${String(d).padStart(2, '0')}` : null;
      let match = value.match(/\b(20\d{2})[./-](\d{1,2})[./-](\d{1,2})\b/);
      if (match) return `${match[1]}-${String(+match[2]).padStart(2, '0')}-${String(+match[3]).padStart(2, '0')}`;
      match = value.match(/(\d{1,2})\s*월\s*(\d{1,2})/);
      if (match) return ymd(+match[1], +match[2]);
      match = value.match(/\b(\d{1,2})[./-](\d{1,2})\b/);
      if (match) return ymd(+match[1], +match[2]);
      const months = { jan:1,feb:2,mar:3,apr:4,may:5,jun:6,jul:7,aug:8,sep:9,oct:10,nov:11,dec:12 };
      match = value.match(/\b(jan(?:uary)?|feb(?:ruary)?|mar(?:ch)?|apr(?:il)?|may|jun(?:e)?|jul(?:y)?|aug(?:ust)?|sep(?:t(?:ember)?)?|oct(?:ober)?|nov(?:ember)?|dec(?:ember)?)\s+(\d{1,2})\b/i);
      if (match) return ymd(months[match[1].toLowerCase().slice(0, 3)], +match[2]);
      return null;
    }

    function normalizeNaturalClock(value) {
      const raw = String(value || '').trim().toLowerCase();
      const match = raw.match(/^(\d{1,2})(?::(\d{2}))?\s*(am|pm)?$/i);
      if (!match) return normalizeClock(raw);
      let hour = parseInt(match[1], 10);
      const minute = match[2] || '00';
      const meridiem = match[3];
      if (meridiem === 'pm' && hour < 12) hour += 12;
      if (meridiem === 'am' && hour === 12) hour = 0;
      return `${String(hour).padStart(2, '0')}:${minute}`;
    }

    function normalizeNaturalTimeRange(start, end) {
      const startTime = normalizeNaturalClock(start);
      const endTime = end ? normalizeNaturalClock(end) : '';
      return endTime ? `${startTime}-${endTime}` : startTime;
    }

    function textRowsFromPlainText(text) {
      return String(text || '')
        .replace(/\r/g, '\n')
        .split('\n')
        .map(line => line.replace(/\s+/g, ' ').trim())
        .filter(Boolean)
        .map(line => {
          const date = parseDateFromTextLine(line);
          if (date) return [line];
          const time = line.match(/^(\d{1,2}(?::\d{2})?\s*(?:am|pm)?)(?:\s*[-–~]\s*(\d{1,2}(?::\d{2})?\s*(?:am|pm)?))?\s+(.+)$/i);
          if (!time) return ['', line, ''];
          const timeText = normalizeNaturalTimeRange(time[1], time[2]);
          const rest = time[3].trim();
          const parts = rest.split(/\s{2,}| {1,}[-|•]\s*/).filter(Boolean);
          return ['', timeText, parts[0] || rest, parts.slice(1).join(' · ')];
        });
    }

    function importedFromTextDocument(filename, text) {
      const lines = String(text || '')
        .replace(/\r/g, '\n')
        .split('\n')
        .map(line => line.replace(/\s+/g, ' ').trim())
        .filter(Boolean);
      const sections = [];
      let current = { name: filename, lines: [] };
      const pushCurrent = () => {
        if (current.lines.length) sections.push({
          name: current.name,
          rows: textRowsFromPlainText(current.lines.join('\n')),
        });
      };
      lines.forEach(line => {
        const headingSheet = { name: line, rows: [[line]] };
        const isHeading = line.length < 80
          && !/^(\d{1,2}(?::\d{2})?\s*(?:am|pm)?)/i.test(line)
          && inferSheetCategory(headingSheet) !== 'ignore';
        if (isHeading && current.lines.length) {
          pushCurrent();
          current = { name: line, lines: [] };
        } else {
          current.lines.push(line);
        }
      });
      pushCurrent();
      const sheets = sections.length ? sections : [{ name: filename, rows: textRowsFromPlainText(text) }];
      return importSheetsAutomatically(sheets);
    }

    function rowsFromHtmlTable(table) {
      return [...table.querySelectorAll('tr')].map(row => (
        [...row.querySelectorAll('th,td')].map(cell => cell.textContent.replace(/\s+/g, ' ').trim())
      )).filter(row => row.some(Boolean));
    }

    async function importHtmlFile(file) {
      const html = await file.text().catch(() => '');
      if (!html) throw new Error(tr('htmlReadFailed'));
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const tables = [...doc.querySelectorAll('table')].map((table, index) => ({
        name: table.getAttribute('aria-label') || table.querySelector('caption')?.textContent?.trim() || `${file.name} ${index + 1}`,
        rows: rowsFromHtmlTable(table),
      })).filter(sheet => sheet.rows.length);
      if (tables.length) {
        return importSheetsAutomatically(tables);
      }
      return importedFromTextDocument(file.name, doc.body?.innerText || html);
    }

    async function loadPdfJs() {
      if (window.pdfjsLib) return window.pdfjsLib;
      const pdfjs = await import(/* @vite-ignore */ 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.min.mjs');
      pdfjs.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/4.10.38/pdf.worker.min.mjs';
      window.pdfjsLib = pdfjs;
      return pdfjs;
    }

    async function importPdfFile(file) {
      try {
        const pdfjs = await loadPdfJs();
        const pdf = await pdfjs.getDocument({ data: await file.arrayBuffer() }).promise;
        const lines = [];
        for (let pageNumber = 1; pageNumber <= pdf.numPages; pageNumber += 1) {
          const page = await pdf.getPage(pageNumber);
          const content = await page.getTextContent();
          let lastY = null;
          let line = [];
          content.items.forEach(item => {
            const y = Math.round(item.transform?.[5] || 0);
            if (lastY !== null && Math.abs(y - lastY) > 4 && line.length) {
              lines.push(line.join(' '));
              line = [];
            }
            line.push(item.str);
            lastY = y;
          });
          if (line.length) lines.push(line.join(' '));
        }
        const text = lines.join('\n');
        if (!text.trim()) throw new Error(tr('pdfLoadFailed'));
        return importedFromTextDocument(file.name, text);
      } catch (error) {
        throw new Error(error.message || tr('pdfLoadFailed'));
      }
    }

    async function importPlannerFile(file) {
      if (/\.pdf$/i.test(file.name) || file.type === 'application/pdf') return importPdfFile(file);
      if (/\.html?$/i.test(file.name) || /text\/html/i.test(file.type)) return importHtmlFile(file);
      if (/\.xlsx$/i.test(file.name)) return importExcelFile(file);
      throw new Error(tr('unsupportedImportFile'));
    }

    async function importExcelFile(file) {
      const sheets = await readWorkbook(await file.arrayBuffer());
      return importSheetsAutomatically(sheets);
    }

    function periodOf(event) {
      const t = timeSortValue(event);
      if (t === '99:99') return 'none';
      const h = parseInt(t.split(':')[0], 10);
      if (h < 12) return 'am';
      if (h < 18) return 'pm';
      return 'evening';
    }

    function timeSortValue(event) {
      const raw = event.start || normalizeClock(event.timeText);
      const value = autoAdjustHour(raw);
      const parts = String(value || '').split(':').map(Number);
      if (parts.length < 2 || Number.isNaN(parts[0]) || Number.isNaN(parts[1])) return '99:99';
      return `${String(parts[0]).padStart(2, '0')}:${String(parts[1]).padStart(2, '0')}`;
    }

    function sortedEvents(events = plan.events) {
      return [...events].sort((a, b) => `${a.date} ${timeSortValue(a)}`.localeCompare(`${b.date} ${timeSortValue(b)}`));
    }

    function sourceLabel(item) {
      return item?.sourceGroupLabel || item?.sourceSheet || '';
    }

    function sourceKey(item) {
      return item?.sourceGroupKey || (sourceLabel(item) ? `sheet-${slugKey(sourceLabel(item))}` : '');
    }

    function groupOptions() {
      const map = new Map();
      [...(plan.events || []), ...(plan.transportPlans || [])].forEach(item => {
        const label = sourceLabel(item);
        const key = sourceKey(item);
        if (label && key) map.set(key, label);
      });
      return [...map.entries()].map(([key, label]) => ({ key, label })).sort((a, b) => a.label.localeCompare(b.label));
    }

    function matchesGroupFilter(item) {
      return currentGroupFilter === 'all' || sourceKey(item) === currentGroupFilter;
    }

    function filteredEvents(events = plan.events) {
      return (events || []).filter(matchesGroupFilter);
    }

    function filteredTransportPlans() {
      return (plan.transportPlans || []).filter(matchesGroupFilter);
    }

    function nearestDayWithEvents(fromIso, dir) {
      const dates = [...new Set(plan.events.map(e => e.date))].sort();
      if (!dates.length) return fromIso;
      return dir > 0
        ? (dates.find(d => d > fromIso) || fromIso)
        : ([...dates].reverse().find(d => d < fromIso) || fromIso);
    }

    function weekEvents() {
      const start = weekStart(els.selectedDate.value);
      const end = addDays(start, 6);
      return filteredEvents().filter(event => event.date >= start && event.date <= end);
    }

    function setState(text) {
      els.saveState.textContent = text;
    }

    function markDirty() {
      setState(tr('saveNeeded'));
      render();
    }

    function clonePlanSnapshot() {
      return JSON.parse(JSON.stringify({
        title: plan.title || 'WOLKO Staff Schedule',
        vans: Array.isArray(plan.vans) ? plan.vans : [],
        events: Array.isArray(plan.events) ? plan.events : [],
        people: Array.isArray(plan.people) ? plan.people : [],
        transportPlans: Array.isArray(plan.transportPlans) ? plan.transportPlans : [],
        updatedAt: plan.updatedAt || '',
      }));
    }

    function saveDeleteBackup(reason) {
      try {
        localStorage.setItem(DELETE_BACKUP_KEY, JSON.stringify({
          reason,
          savedAt: new Date().toISOString(),
          plan: clonePlanSnapshot(),
        }));
      } catch (error) {
        console.warn('Delete backup save failed:', error);
      }
    }

    function hasDeleteBackup() {
      try { return !!JSON.parse(localStorage.getItem(DELETE_BACKUP_KEY) || 'null')?.plan; }
      catch { return false; }
    }

    function deleteSelectedDayData() {
      const date = els.selectedDate.value || todayIso();
      const beforeEvents = plan.events.length;
      const beforePlans = (plan.transportPlans || []).length;
      const filterLabel = currentGroupFilter === 'all'
        ? ''
        : groupOptions().find(group => group.key === currentGroupFilter)?.label || '';
      const shouldDeleteItem = item => item.date === date && matchesGroupFilter(item);
      const count = plan.events.filter(shouldDeleteItem).length
        + (plan.transportPlans || []).filter(shouldDeleteItem).length;
      if (!count) {
        setState(tr('deleteNone'));
        return;
      }
      if (!confirm(tr('deleteDayConfirm', { date, count, filter: filterLabel }))) return;
      saveDeleteBackup(`day:${date}`);
      plan.events = plan.events.filter(item => !shouldDeleteItem(item));
      plan.transportPlans = (plan.transportPlans || []).filter(item => !shouldDeleteItem(item));
      if (editingId && !plan.events.some(item => item.id === editingId)) clearForm();
      markDirty();
      setState(tr('deleteDayDone', (beforeEvents - plan.events.length) + (beforePlans - plan.transportPlans.length)));
    }

    function deleteAllData() {
      const totals = {
        events: plan.events.length,
        people: (plan.people || []).length,
        vans: (plan.vans || []).length,
        plans: (plan.transportPlans || []).length,
      };
      if (!totals.events && !totals.people && !totals.vans && !totals.plans) {
        setState(tr('deleteNone'));
        return;
      }
      if (!confirm(tr('deleteAllConfirm', totals))) return;
      saveDeleteBackup('all');
      plan.events = [];
      plan.people = [];
      plan.vans = [];
      plan.transportPlans = [];
      currentGroupFilter = 'all';
      clearForm();
      markDirty();
      setState(tr('deleteAllDone'));
    }

    function restoreLastDelete() {
      let backup;
      try { backup = JSON.parse(localStorage.getItem(DELETE_BACKUP_KEY) || 'null'); }
      catch { backup = null; }
      if (!backup?.plan) {
        setState(tr('restoreNone'));
        return;
      }
      plan = backup.plan;
      plan.people = Array.isArray(plan.people) ? plan.people : [];
      plan.vans = Array.isArray(plan.vans) ? plan.vans : [];
      plan.events = Array.isArray(plan.events) ? plan.events : [];
      plan.transportPlans = Array.isArray(plan.transportPlans) ? plan.transportPlans : [];
      els.planTitle.value = plan.title || '';
      currentGroupFilter = 'all';
      clearForm();
      try { localStorage.removeItem(DELETE_BACKUP_KEY); } catch {}
      markDirty();
      setState(tr('restoreDone'));
    }

    function evText(ev, field) {
      if (currentLang === 'en' && ev._en?.[field]) return ev._en[field];
      return ev[field] || '';
    }

    function eventMeta(event) {
      const bits = [];
      const source = sourceLabel(event);
      const staff = evText(event, 'staff');
      const from = evText(event, 'from');
      const to = evText(event, 'to');
      const passengers = evText(event, 'passengers');
      const notes = evText(event, 'notes');
      if (source) bits.push(source);
      if (staff) bits.push(`${tr('staff')}: ${staff}`);
      if (event.vanId) bits.push(`${tr('vehicle')}: ${vanName(event.vanId)}`);
      if (from || to) bits.push(`${from || tr('fromUnknown')} → ${to || tr('toUnknown')}`);
      if (passengers) bits.push(`${tr('people')}: ${passengers}`);
      if (notes) bits.push(notes);
      return bits.map(escapeHtml).join(' · ');
    }

