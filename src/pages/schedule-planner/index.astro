    .pdf-date-btn {
      border:1px solid #dbe7ec; border-radius:12px; background:#fff; color:var(--muted); padding:9px 10px;
      font:700 12px/1.25 var(--sans); cursor:pointer; text-align:left; transition:.15s ease;
    }
    .pdf-date-btn:hover { border-color:#9ccbd8; color:var(--blue); transform:translateY(-1px); }
