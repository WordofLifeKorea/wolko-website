---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import GospelRelay from '../../components/GospelRelay.astro';

// 사명 아래 '그래서 월코는 이런 자리를 섬깁니다' — 듣고(캠프) → 자라고(청소년·월비) → 전하고(Jr. SYME) 순서
const missionWorks = [
  { href: '/camp', img: '/images/ministries/camp.jpg', ko: '캠프 사역', en: 'Camp Ministry', roleKo: '복음을 듣고 삶의 전환점을 맞도록', roleEn: 'Where youth hear the Gospel and find a turning point' },
  { href: '/youth', img: '/images/ministries/youth.jpg', ko: '청소년 사역', en: 'Youth Ministry', roleKo: '교회와 일상에서 믿음이 자라도록', roleEn: 'Where faith grows in church and everyday life' },
  { href: '/wolbi-jeju', img: '/images/ministries/wolbi.jpg', ko: '제주 월비', en: 'WOLBI Jeju', roleKo: '말씀 위에 깊이 뿌리내리도록', roleEn: 'Where students are rooted deeply in the Word' },
  { href: '/jr-syme', img: '/images/ministries/syme.jpg', ko: 'Jr. SYME', en: 'Jr. SYME', roleKo: '복음을 전하는 리더로 서도록', roleEn: 'Where students grow into leaders who share the Gospel' },
];
---

<BaseLayout
  title="월코소개 — Word of Life Korea"
  description="복음으로 다음 세대를 세웁니다 — Word of Life Korea (월코)의 소개, 핵심 가치, 비전"
  activeNav="about"
>
<Fragment slot="head">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Noto+Serif+KR:wght@400;600;700&family=Playfair+Display:ital,wght@1,500&display=swap">
</Fragment>

<style>
  :root {
    --primary: #004f68; --primary-deep: #083d51; --primary-mid: #0a5b76;
    --primary-soft: rgba(0,79,104,0.08); --primary-line: rgba(0,79,104,0.13);
    --text: #152028; --muted: #5b6973; --bg: #f6f9fb; --white: #ffffff;
    --r-xl: 30px; --r-lg: 24px; --r-md: 18px; --r-sm: 12px;
    --sec-y: 112px; --sec-y-tight: 96px;
  }

  .page-wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

  /* ── 글꼴 — 홈 화면과 같게: 제목·숫자는 G마켓 산스, 본문은 Pretendard (편지 카드의 손글씨 느낌 글꼴은 그대로) ── */
  .section { font-family: var(--ff-sans); }
  .section-title, .history-year, .history-card h3,
  .value-title, .value-num, .commit-card h4, .commit-num, .values-big, .mission-statement, .vision-statement { font-family: var(--ff-serif); }

  /* ── 움직임 — 자바스크립트가 html 에 .wl-motion 을 붙일 때만 (움직임 줄이기 설정이면 붙이지 않아 처음부터 다 보인다) ── */
  /* 스크롤하면 하나씩 떠오른다 — 같은 줄의 카드는 --d 만큼 늦게 */
  :global(.wl-motion) .rv { opacity: 0; transform: translateY(32px); transition: opacity 1.2s cubic-bezier(.2,.7,.2,1), transform 1.2s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0s); }
  :global(.wl-motion) .rv.is-in { opacity: 1; transform: none; }

  /* ── 공통 섹션 — 사역 페이지와 같은 머리: 앞에 가는 선이 붙은 작은 표시, 왼쪽 제목, 오른쪽 설명 ── */
  .section { padding:var(--sec-y) 24px; }
  .section--alt { background:var(--white); }
  .section--bg { background:var(--bg); }
  .section-badge { display:flex; align-items:center; gap:12px; width:fit-content; color:var(--primary); font-size:13px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; }
  .section-badge::before { content:""; width:28px; height:1px; background:currentColor; }
  .section-title { margin-top:20px; font-size:clamp(30px, 3.4vw, 44px); font-weight:700; line-height:1.22; letter-spacing:-0.03em; color:#0b2430; }
  .section-desc { font-size:17px; line-height:1.85; color:#3e535d; }
  .sec-head { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,6fr); gap:24px 80px; align-items:end; }
  .sec-head .section-desc { max-width:560px; }

  /* ── WHO WE ARE: 편지 위 제목만 가운데 정렬 ── */
  .who-head { text-align:center; }
  .who-head .section-badge { margin:0 auto; }
  .who-head .section-badge::after { content:""; width:28px; height:1px; background:currentColor; }
  .who-title .accent { display:block; }
  .who-title-rule { width:1px; height:40px; margin:24px auto 0; background:rgba(0,79,104,0.3); }

  /* ── 봉투 → 편지: 화면에 들어오면 한 번, 정해진 순서로 재생 (봉인 → 덮개 → 편지가 나옴 → 펼쳐짐) ── */
  .intro-single-wrap { position:relative; isolation:isolate; }
  .letter-anim { position:relative; z-index:2; transform-origin:50% 0; will-change:transform, clip-path; }
  .env { display:none; position:absolute; pointer-events:none; }
  .intro-single-wrap.is-anim .env { display:block; }
  .env-back, .env-front, .env-flap { position:absolute; }
  .env-back { inset:0; z-index:1; border-radius:8px; background:linear-gradient(180deg,#e7d8b4,#dcc99f); box-shadow:0 30px 50px -26px rgba(70,45,10,0.5), 0 0 0 1px rgba(150,115,60,0.25); }
  .env-front { inset:0; z-index:3; border-radius:8px; background:linear-gradient(180deg,#f6ecd5,#efe1c0); clip-path:polygon(0 0,50% 56%,100% 0,100% 100%,0 100%); }
  .env-front svg { position:absolute; inset:0; width:100%; height:100%; }
  .env-flap { left:0; right:0; top:0; height:56%; z-index:4; transform-origin:50% 0; transform:perspective(1100px) rotateX(0deg); background:linear-gradient(180deg,#f3e7ca,#e9d8b2); clip-path:polygon(0 0,100% 0,50% 100%); }
  .env-seal { position:absolute; z-index:5; left:50%; top:56%; width:54px; height:54px; margin:-27px 0 0 -27px; border-radius:50%; background:#fff url('/images/WOLKO%20Circle.png') center/38px no-repeat; border:3px solid #f6ecd5; box-shadow:0 8px 16px -6px rgba(0,79,104,0.5), 0 0 0 1px rgba(0,79,104,0.18); }
  .env-burst { position:absolute; z-index:5; left:50%; top:56%; width:54px; height:54px; margin:-27px 0 0 -27px; border-radius:50%; border:2px solid rgba(214,170,90,.85); opacity:0; }
  @media (max-width:640px) { .env-seal, .env-burst { width:44px; height:44px; margin:-22px 0 0 -22px; } .env-seal { background-size:30px; } }
  /* ── INTRO: 초청장 같은 편지 ── */
  .intro-single-wrap { max-width:860px; margin:76px auto 0; }
  .intro-card {
    --paper:#fffdf8; --ink:#34444c; --teal:#004f68;
    position:relative; padding:76px 64px 52px; border-radius:6px;
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(115,209,245,0.10) 0%, transparent 55%),
      radial-gradient(100% 80% at 100% 100%, rgba(240,200,140,0.14) 0%, transparent 55%),
      var(--paper);
    border:1px solid rgba(60,70,60,0.10);
    box-shadow:0 1px 0 rgba(255,255,255,0.9) inset, 0 28px 60px -22px rgba(16,32,40,0.22), 0 6px 16px rgba(16,32,40,0.06);
    transform:rotate(-0.35deg); transition:transform .35s ease, box-shadow .35s ease;
    font-family:'Noto Serif KR', 'Nanum Myeongjo', serif;
  }
  .intro-card:hover { transform:rotate(0deg) translateY(-3px); box-shadow:0 1px 0 rgba(255,255,255,0.9) inset, 0 34px 70px -22px rgba(16,32,40,0.26), 0 8px 20px rgba(16,32,40,0.07); }
  /* 편지지의 안쪽 테두리 */
  .intro-card::before { content:""; position:absolute; inset:14px; border:1px solid rgba(0,79,104,0.20); border-radius:2px; pointer-events:none; }
  /* 위쪽 가운데: 밀랍 도장처럼 찍힌 월코 로고 */
  .intro-card::after { content:""; position:absolute; top:-34px; left:50%; width:68px; height:68px; margin-left:-34px; border-radius:50%; background:#fff url('/images/WOLKO%20Circle.png') center/46px no-repeat; border:3px solid #fffdf8; box-shadow:0 10px 22px -6px rgba(0,79,104,0.45), 0 0 0 1px rgba(0,79,104,0.18); pointer-events:none; }
  .intro-card > * { position:relative; z-index:1; }
  .intro-greet { margin:0 0 26px; font-size:21px; font-weight:600; color:var(--teal); letter-spacing:-0.01em; }
  .intro-card p:not(.intro-greet) { font-size:17.5px; line-height:2.15; color:var(--ink); word-break:keep-all; }
  .intro-card p + p { margin-top:18px; }
  .intro-closing { margin-top:34px !important; font-size:16.5px !important; color:#5b6c75 !important; font-style:normal; }
  /* 편지 끝 서명 — 영문 서명 · 가는 선 · "월코 드림" */
  .intro-card-sig { margin-top:22px; display:flex; justify-content:flex-end; align-items:center; gap:18px; color:var(--teal); }
  .intro-sign-text { display:flex; flex-direction:column; align-items:flex-end; }
  .intro-sign-name { font-family:'Playfair Display', 'Noto Serif KR', serif; font-style:italic; font-weight:500; font-synthesis:none; font-size:32px; line-height:1.2; letter-spacing:.005em; color:#0a4c63; }
  .intro-sign-by { align-self:stretch; margin-top:10px; padding-top:9px; border-top:1px solid rgba(0,79,104,0.28); text-align:right; font-family:'Noto Serif KR', 'Nanum Myeongjo', serif; font-size:15px; font-weight:600; letter-spacing:.12em; color:#5b6c75; }
  .intro-sign-by .wl-en { font:600 11px/1.4 Montserrat, sans-serif; letter-spacing:.22em; }

  .sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }

  /* ── HISTORY: 세로 연대표 — 가운데 선에 점, 글과 사진이 번갈아 양쪽에 ── */
  .history-grid { position:relative; max-width:1240px; margin:72px auto 0; }
  .history-grid::before { content:""; position:absolute; left:50%; top:0; bottom:0; width:2px; margin-left:-1px; background:#0b2430; }
  .history-card { position:relative; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:0 120px; align-items:center; }
  .history-card + .history-card { margin-top:72px; }
  .history-card::before { content:""; position:absolute; left:50%; top:50%; width:18px; height:18px; margin:-9px 0 0 -9px; border-radius:50%; background:var(--primary); box-shadow:0 0 0 6px var(--bg), 0 0 0 7px var(--primary); }
  .history-card--camp .history-text { text-align:right; }
  .history-card--institute .history-text { order:2; }
  .history-text { display:flex; flex-direction:column; gap:12px; }
  .history-year { font-size:clamp(64px, 6.4vw, 92px); font-weight:700; letter-spacing:-0.04em; line-height:1; color:var(--primary); font-variant-numeric:tabular-nums; margin-bottom:6px; }
  .history-tag { font-size:12px; font-weight:700; letter-spacing:0.12em; color:#5a7380; }
  .history-card h3 { font-size:28px; font-weight:700; letter-spacing:-0.02em; color:#0b2430; line-height:1.3; }
  .history-card p { font-size:15.5px; line-height:1.9; color:#4a5d66; }
  .history-photo { margin:0; aspect-ratio:16 / 10; overflow:hidden; background:#0b1e27; }
  .history-photo img { width:100%; height:100%; object-fit:cover; display:block; }
  .history-photo { position:relative; }
  .history-photo figcaption { position:absolute; left:0; right:0; bottom:0; padding:22px 14px 9px; background:linear-gradient(transparent, rgba(5,20,28,.72)); color:rgba(255,255,255,.92); font-size:12px; font-weight:600; line-height:1.4; }

  /* ── CORE VALUES: 왼쪽은 테두리만 있는 큰 "5" 와 제목, 오른쪽은 다섯 줄 표 ── */
  .values-layout { max-width:1240px; margin:0 auto; display:grid; grid-template-columns:minmax(0,4fr) minmax(0,8fr); gap:80px; align-items:start; }
  .values-big { margin-top:16px; font-family:var(--ff-serif); font-size:clamp(180px, 18vw, 260px); font-weight:700; line-height:.85; letter-spacing:-0.06em; color:transparent; -webkit-text-stroke:2px var(--primary); }
  .values-side .section-title { margin-top:24px; font-size:clamp(28px, 2.6vw, 36px); }
  .values-grid { list-style:none; margin:0; padding:0; border-top:2px solid #0b2430; }
  .value-card { display:grid; grid-template-columns:72px 240px minmax(0,1fr); gap:0 24px; align-items:baseline; padding:28px 0; border-bottom:1px solid #d6dee2; }
  .value-num { font-size:15px; font-weight:700; color:var(--primary); }
  .value-title { font-size:24px; font-weight:700; letter-spacing:-0.02em; color:#0b2430; line-height:1.3; }
  .value-desc { font-size:16px; line-height:1.75; color:#4a5d66; }

  /* ── VISION & MISSION: 사진 위 비전 → 같은 어두운 바탕에 사명과 그림 (한 섹션) ── */
  .vm { padding:0; background:#052833; color:#fff; overflow:hidden; }
  .vm-wrap { max-width:1240px; margin:0 auto; }
  .vm-vision { position:relative; padding:136px 0 168px; background:#052833 url('/images/heroes/worship.jpg') 50% 32% / cover no-repeat; }
  .vm-vision::before { content:""; position:absolute; inset:0; background:linear-gradient(90deg, rgba(5,40,51,0.92) 0%, rgba(5,40,51,0.72) 46%, rgba(5,40,51,0.36) 100%); }
  .vm-vision::after { content:""; position:absolute; left:0; right:0; bottom:0; height:220px; background:linear-gradient(180deg, rgba(5,40,51,0), #052833); }
  .vm-vision .vm-wrap { position:relative; z-index:1; }
  .vm-label { margin:0; font-family:var(--ff-sans); font-size:16px; font-weight:700; letter-spacing:-0.01em; color:#f3dca6; }
  .vision-statement { max-width:820px; margin:22px 0 0; font-family:var(--ff-serif); font-size:clamp(34px, 4.3vw, 62px); font-weight:700; line-height:1.26; letter-spacing:-0.035em; color:#fff; word-break:keep-all; }
  .vm-flow { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:56px; align-items:center; padding-top:8px; padding-bottom:96px; }
  .vm-flow-text { display:flex; flex-direction:column; align-items:flex-start; gap:20px; }
  .vm-steps { display:flex; flex-wrap:wrap; align-items:center; gap:10px 16px; margin:0; font-family:var(--ff-serif); font-size:clamp(26px, 2.4vw, 34px); font-weight:700; letter-spacing:-0.03em; color:#fff; }
  .vm-flow .vm-steps { gap:10px 12px; font-size:clamp(24px, 2.1vw, 30px); }
  .vm-step { display:inline-flex; align-items:center; gap:8px; white-space:nowrap; }
  .vm-step-num { display:inline-flex; align-items:center; justify-content:center; width:24px; height:24px; border-radius:50%; border:1.5px solid #f3dca6; box-sizing:border-box; color:#f3dca6; font:700 12px/1 var(--ff-sans); letter-spacing:0; }
  /* 세 걸음은 그림 속 1·2·3 표시와 같은 때에 밝아진다 — 지연(--d)은 GospelRelay 의 steps 값과 맞춘다 (GospelRelay 가 section 에 is-armed / is-on / is-fading 을 붙임) */
  .vm.is-armed .vm-step { opacity:.35; transition:opacity .9s ease; }
  .vm.is-armed.is-on .vm-step { animation:vm-step .6s ease-out var(--d) both; }
  .vm.is-armed.is-fading .vm-step { animation:none; opacity:.35; }
  @keyframes vm-step { from { opacity:.35; } to { opacity:1; } }
  .vm-step-arrow { width:20px; height:12px; fill:none; stroke:#f3dca6; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .vm-flow-desc { margin:0; font-size:16px; line-height:1.75; color:rgba(255,255,255,0.78); word-break:keep-all; }
  .vm-mission { padding-top:72px; padding-bottom:128px; border-top:1px solid rgba(255,255,255,0.14); }
  .mission-statement { max-width:900px; margin:20px 0 0; font-family:var(--ff-serif); font-size:clamp(24px, 2.6vw, 36px); font-weight:700; line-height:1.45; letter-spacing:-0.025em; color:#fff; word-break:keep-all; }
  .vm-mission-lead { margin:48px 0 0; font-size:15px; font-weight:600; color:rgba(255,255,255,0.62); }
  .vm-works { list-style:none; display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:0 28px; margin:16px 0 0; padding:0; }
  .vm-work { display:grid; grid-template-columns:minmax(0,1fr) auto; grid-template-areas:"photo photo" "num arrow" "name name" "role role"; gap:10px 12px; height:100%; padding:0 0 26px; color:#fff; text-decoration:none; transition:border-color .2s; }
  .vm-work-photo { grid-area:photo; display:block; aspect-ratio:4 / 3; overflow:hidden; margin-bottom:10px; background:#0b2430; border-bottom:2px solid rgba(243,220,166,0.55); transition:border-color .2s; }
  .vm-work-photo img { display:block; width:100%; height:100%; object-fit:cover; transition:transform .6s cubic-bezier(.2,.7,.2,1); }
  .vm-work:hover .vm-work-photo { border-bottom-color:#f3dca6; }
  .vm-work:hover .vm-work-photo img { transform:scale(1.04); }
  .vm-work:focus-visible { outline:2px solid var(--blue-light); outline-offset:4px; }
  .vm-work-num { grid-area:num; font-size:13px; font-weight:700; letter-spacing:.08em; color:#f3dca6; }
  .vm-work-arrow { grid-area:arrow; width:16px; height:16px; color:rgba(255,255,255,0.55); transition:transform .2s, color .2s; }
  .vm-work:hover .vm-work-arrow { transform:translateX(4px); color:#f3dca6; }
  .vm-work-name { grid-area:name; font-family:var(--ff-serif); font-size:22px; font-weight:700; letter-spacing:-0.02em; }
  .vm-work-role { grid-area:role; font-size:15px; line-height:1.6; color:rgba(255,255,255,0.72); word-break:keep-all; }
  .vm-legend { list-style:none; align-self:stretch; display:flex; flex-direction:column; gap:12px; margin:10px 0 0; padding:24px 0 0; border-top:1px solid rgba(255,255,255,0.14); }
  .vm-legend li { display:flex; align-items:center; gap:14px; font-size:15px; color:rgba(255,255,255,0.78); }
  .vm-legend svg { flex:none; overflow:visible; }
  .vm-legend .lg-ghost { fill:rgba(255,255,255,.03); stroke:rgba(255,255,255,.3); stroke-width:1; }
  .vm-legend .lg-ghost-p { fill:rgba(255,255,255,.4); }
  .vm-legend .lg-lit { fill:#f3dca6; stroke:rgba(255,246,220,.9); stroke-width:1; filter:drop-shadow(0 0 5px rgba(243,220,166,.55)); }
  .vm-legend .lg-lit-p { fill:#0b3442; }
  .vm-legend .is-arc svg { fill:none; stroke:#f3dca6; stroke-width:1.8; stroke-linecap:round; }

  /* ── COMMITMENTS: 2×2 — 테두리만 있는 큰 번호, 굵은 윗선 ── */
  .commit-inner { max-width:1240px; margin:56px auto 0; }
  .commit-grid { display:grid; grid-template-columns:1fr 1fr; gap:0 72px; }
  .commit-card { padding:40px 0 44px; border-top:2px solid #0b2430; display:grid; grid-template-columns:120px minmax(0,1fr); column-gap:20px; row-gap:12px; align-content:start; }
  .commit-num { grid-row:1 / span 2; font-size:80px; font-weight:700; line-height:.9; letter-spacing:-0.04em; color:transparent; -webkit-text-stroke:1.5px var(--primary); }
  .commit-card h4 { grid-column:2; font-size:22px; font-weight:700; letter-spacing:-0.02em; color:#0b2430; line-height:1.4; }
  .commit-card p { grid-column:2; font-size:15.5px; line-height:1.85; color:#4a5d66; }

  /* ── 반응형 ── */
  @media (max-width:1050px) {
    .vm-works { grid-template-columns:repeat(2, minmax(0,1fr)); }
  }
  @media (max-width:1050px) {
    .value-card { grid-template-columns:56px minmax(0,1fr); row-gap:6px; }
    .value-desc { grid-column:2; }
    .history-card { gap:0 88px; }
  }
  @media (max-width:860px) {
    .sec-head { grid-template-columns:1fr; }
    .history-grid::before, .history-card::before { display:none; }
    .history-card { grid-template-columns:1fr; gap:24px; padding-top:28px; border-top:2px solid #0b2430; }
    .history-card + .history-card { margin-top:56px; }
    .history-card--camp .history-text { text-align:left; }
    .history-card--institute .history-text { order:0; }
    .values-layout { grid-template-columns:1fr; gap:36px; }
    .values-big { font-size:160px; }
    .commit-grid { grid-template-columns:1fr; }
  }
  @media (max-width:640px) {
    .section-title { font-size:30px; }
