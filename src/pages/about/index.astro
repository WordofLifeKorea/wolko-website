---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="월코소개 — Word of Life Korea"
  description="복음으로 다음 세대를 세웁니다 — 월코(한국생명의말씀협회)의 소개, 핵심 가치, 비전, 신앙고백"
  activeNav="about"
>

<style>
  :root {
    --primary: #004f68; --primary-deep: #083d51; --primary-mid: #0a5b76;
    --primary-soft: rgba(0,79,104,0.08); --primary-line: rgba(0,79,104,0.13);
    --text: #152028; --muted: #5b6973; --bg: #f6f9fb; --white: #ffffff;
    --r-xl: 30px; --r-lg: 24px; --r-md: 18px; --r-sm: 12px;
    --sec-y: 112px; --sec-y-tight: 96px;
  }

  .page-wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

  /* ── HERO ── */
  .ab-hero {
    position: relative; overflow: hidden;
    padding: 160px 24px 110px; text-align: center;
    background:
      linear-gradient(180deg, rgba(7,26,36,0.38) 0%, rgba(7,26,36,0.48) 40%, rgba(7,26,36,0.68) 100%),
      url("https://wolko.synology.me/Web_Contents/Photos/Youth_Ministry/Banner%202.png") center / cover no-repeat;
  }
  .ab-hero::before {
    content:""; position:absolute; inset:0;
    background: radial-gradient(circle at 82% 18%, rgba(255,255,255,0.10), transparent 28%),
                radial-gradient(circle at 16% 82%, rgba(255,255,255,0.06), transparent 24%);
    pointer-events:none;
  }
  .hero-grid-bg {
    position:absolute; inset:0;
    background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px),
                      linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px);
    background-size:60px 60px; pointer-events:none;
  }
  .hero-inner { position:relative; z-index:2; max-width:880px; margin:0 auto; }
  .hero-eyebrow {
    display:inline-flex; align-items:center; gap:8px; padding:8px 16px; border-radius:999px;
    background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.2);
    font-size:12px; font-weight:800; letter-spacing:0.08em; color:rgba(255,255,255,0.92); margin-bottom:24px;
  }
  .hero-eyebrow-dot { width:6px; height:6px; border-radius:50%; background:#7fd4f0; }
  .hero-inner h1 {
    font-size:clamp(40px,6vw,62px); font-weight:800; line-height:1.12;
    letter-spacing:-0.04em; color:#fff; margin-bottom:20px;
    text-shadow:0 8px 26px rgba(0,0,0,0.22);
  }
  .hero-inner h1 em { font-style:normal; color:#9ae3ff; display:block; }
  .hero-sub {
    font-size:17px; line-height:1.9; color:rgba(255,255,255,0.80);
    max-width:580px; margin:0 auto 0; text-shadow:0 2px 12px rgba(0,0,0,0.18);
  }
  .hero-cta {
    display:inline-flex; align-items:center; gap:8px; margin-top:36px; padding:15px 28px;
    border-radius:999px; background:#fff; color:var(--primary); font-size:14px; font-weight:800;
    text-decoration:none; box-shadow:0 8px 24px rgba(0,0,0,0.14);
    transition:transform .18s, box-shadow .18s;
  }
  .hero-cta:hover { transform:translateY(-2px); box-shadow:0 14px 32px rgba(0,0,0,0.18); }
  .hero-stats {
    position:relative; z-index:2; display:flex; justify-content:center; gap:0;
    margin:52px auto 0; max-width:600px;
    background:rgba(255,255,255,0.08); border:1px solid rgba(255,255,255,0.14);
    border-radius:18px; backdrop-filter:blur(8px); overflow:hidden;
  }
  .hero-stat { flex:1; padding:20px 16px; text-align:center; border-right:1px solid rgba(255,255,255,0.10); }
  .hero-stat:last-child { border-right:none; }
  .hero-stat-num { font-size:26px; font-weight:800; letter-spacing:-0.03em; color:#fff; display:block; line-height:1; margin-bottom:5px; }
  .hero-stat-label { font-size:11px; font-weight:700; color:rgba(255,255,255,0.60); }

  /* ── 공통 섹션 ── */
  .section { padding:var(--sec-y) 24px; }
  .section--alt { background:var(--white); }
  .section--bg { background:var(--bg); }
  .section-badge {
    display:block; width:fit-content; padding:8px 15px; border-radius:999px;
    background:var(--primary-soft); color:var(--primary);
    font-size:12px; font-weight:800; letter-spacing:0.05em; margin:0 auto 18px;
  }
  .section-title {
    font-size:40px; font-weight:800; line-height:1.22;
    letter-spacing:-0.035em; color:#0f1b22; margin-bottom:18px; text-align:center;
  }
  .section-desc { font-size:17px; line-height:1.9; color:var(--muted); max-width:720px; margin:0 auto; text-align:center; }

  /* ── INTRO ── */
  .intro-single-wrap { max-width:980px; margin:56px auto 0; }
  .intro-card {
    position:relative; background:linear-gradient(180deg, rgba(255,255,255,0.98), rgba(248,251,253,0.98));
    border:1px solid rgba(0,79,104,0.12); border-radius:32px; padding:44px 42px 38px;
    box-shadow:0 22px 56px rgba(16,32,40,0.08), 0 8px 20px rgba(16,32,40,0.04);
    overflow:hidden; transition:transform .24s, box-shadow .24s, border-color .24s;
  }
  .intro-card:hover { transform:translateY(-4px); box-shadow:0 30px 70px rgba(16,32,40,0.11); border-color:rgba(0,79,104,0.18); }
  .intro-card::before { content:""; position:absolute; top:0; left:0; right:0; height:6px; background:linear-gradient(90deg, #004f68 0%, #0a5b76 55%, #73d1f5 100%); }
  .intro-card::after { content:""; position:absolute; right:-46px; bottom:-56px; width:220px; height:220px; border-radius:50%; background:radial-gradient(circle, rgba(0,79,104,0.10) 0%, transparent 70%); pointer-events:none; }
  .intro-card > * { position:relative; z-index:1; }
  .intro-card p { font-size:18px; line-height:2.02; color:#3a4e58; }
  .intro-card-sig { margin-top:28px; padding-top:18px; border-top:1px solid rgba(0,79,104,0.10); display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; font-size:14px; font-weight:800; color:var(--primary); }

  /* ── HISTORY ── */
  .history-grid { max-width:1240px; margin:56px auto 0; display:grid; grid-template-columns:1fr 1fr; gap:20px; }
  .history-card { position:relative; border-radius:var(--r-xl); padding:44px 40px; overflow:hidden; display:flex; flex-direction:column; gap:16px; }
  .history-card--camp { background:linear-gradient(145deg, #0a5b76 0%, #004f68 100%); box-shadow:0 24px 56px rgba(0,79,104,0.22); }
  .history-card--institute { background:linear-gradient(145deg, #083d51 0%, #052b3a 100%); box-shadow:0 24px 56px rgba(5,43,58,0.24); }
  .history-card::before { content:""; position:absolute; right:-60px; bottom:-60px; width:240px; height:240px; border-radius:50%; background:rgba(255,255,255,0.06); }
  .history-card > * { position:relative; z-index:1; }
  .history-year { font-size:56px; font-weight:900; letter-spacing:-0.05em; color:rgba(255,255,255,0.18); line-height:1; }
  .history-tag { font-size:11px; font-weight:800; letter-spacing:0.1em; color:rgba(255,255,255,0.55); }
  .history-card h3 { font-size:26px; font-weight:800; letter-spacing:-0.03em; color:#fff; line-height:1.25; }
  .history-card p { font-size:15px; line-height:1.88; color:rgba(255,255,255,0.76); }

  /* ── CORE VALUES ── */
  .values-grid { max-width:1240px; margin:56px auto 0; display:grid; grid-template-columns:repeat(5, minmax(0,1fr)); gap:16px; }
  .value-card {
    background:#f6f9fb; border:1px solid var(--primary-line); border-radius:var(--r-lg);
    padding:28px 22px; display:flex; flex-direction:column; gap:14px;
    transition:transform .22s, background .22s, box-shadow .22s, border-color .22s;
    cursor:default; position:relative; overflow:hidden;
  }
  .value-card::after { content:""; position:absolute; right:-24px; bottom:-32px; width:100px; height:100px; border-radius:50%; background:rgba(0,79,104,0.05); transition:transform .22s; }
  .value-card:hover { background:linear-gradient(180deg, #0a5b76 0%, #004f68 100%); border-color:transparent; box-shadow:0 20px 48px rgba(0,79,104,0.22); transform:translateY(-5px); }
  .value-card:hover::after { transform:scale(1.3); }
  .value-card:hover .value-num { color:rgba(255,255,255,0.5); }
  .value-card:hover .value-title, .value-card:hover .value-desc { color:#fff; }
  .value-card:hover .value-desc { color:rgba(255,255,255,0.82); }
  .value-card:hover .value-icon-wrap { background:rgba(255,255,255,0.14); color:#fff; }
  .value-icon-wrap { width:44px; height:44px; border-radius:13px; background:var(--primary-soft); color:var(--primary); display:flex; align-items:center; justify-content:center; transition:background .22s, color .22s; position:relative; z-index:1; }
  .value-num { font-size:11px; font-weight:800; letter-spacing:0.06em; color:var(--primary); transition:color .22s; position:relative; z-index:1; }
  .value-title { font-size:18px; font-weight:800; letter-spacing:-0.02em; color:#102028; line-height:1.3; transition:color .22s; position:relative; z-index:1; }
  .value-desc { font-size:14px; line-height:1.8; color:var(--muted); transition:color .22s; position:relative; z-index:1; }

  /* ── VISION & MISSION ── */
  .vismis-inner { max-width:1240px; margin:0 auto; }
  .vismis-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:56px; }
  .vismis-card { position:relative; border-radius:var(--r-xl); padding:48px 40px; overflow:hidden; display:flex; flex-direction:column; gap:14px; }
  .vismis-card--vision { background:linear-gradient(145deg, #0a5b76 0%, #004f68 100%); box-shadow:0 24px 56px rgba(0,79,104,0.22); }
  .vismis-card--mission { background:linear-gradient(145deg, #1a4a3a 0%, #0f3328 100%); box-shadow:0 24px 56px rgba(15,51,40,0.22); }
  .vismis-card::before { content:""; position:absolute; right:-60px; bottom:-60px; width:240px; height:240px; border-radius:50%; background:rgba(255,255,255,0.06); }
  .vismis-card > * { position:relative; z-index:1; }
  .vismis-card-num { font-size:11px; font-weight:800; letter-spacing:0.1em; color:rgba(255,255,255,0.5); }
  .vismis-card h3 { font-size:28px; font-weight:800; letter-spacing:-0.03em; color:#fff; line-height:1.2; }
  .vismis-card p { font-size:16px; line-height:1.85; color:rgba(255,255,255,0.78); }

  /* ── STATEMENT OF FAITH ── */
  .faith-inner { max-width:980px; margin:56px auto 0; }
  .faith-item { display:grid; grid-template-columns:48px 1fr; gap:20px; padding:24px 0; border-bottom:1px solid var(--primary-line); align-items:start; }
  .faith-item:last-child { border-bottom:none; }
  .faith-num { width:48px; height:48px; border-radius:14px; background:var(--primary-soft); color:var(--primary); font-size:14px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; margin-top:2px; }
  .faith-text { font-size:15px; line-height:1.9; color:#3a4e58; }

  /* ── COMMITMENTS ── */
  .commit-inner { max-width:980px; margin:56px auto 0; }
  .commit-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .commit-card { background:var(--white); border:1px solid var(--primary-line); border-radius:var(--r-lg); padding:28px 26px; display:flex; flex-direction:column; gap:10px; box-shadow:0 8px 24px rgba(16,32,40,0.05); transition:transform .22s, box-shadow .22s; position:relative; overflow:hidden; }
  .commit-card::before { content:""; position:absolute; top:0; left:0; width:4px; height:100%; background:linear-gradient(180deg, var(--primary) 0%, #73d1f5 100%); }
  .commit-card:hover { transform:translateY(-3px); box-shadow:0 18px 44px rgba(0,79,104,0.10); }
  .commit-icon { width:40px; height:40px; border-radius:12px; background:var(--primary-soft); color:var(--primary); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .commit-icon svg { width:18px; height:18px; stroke:currentColor; fill:none; stroke-width:1.8; stroke-linecap:round; stroke-linejoin:round; }
  .commit-card h4 { font-size:15px; font-weight:800; letter-spacing:-0.01em; color:#102028; line-height:1.35; }
  .commit-card p { font-size:13px; line-height:1.85; color:var(--muted); }

  /* ── MINISTRIES ── */
  .ministry-inner { max-width:1240px; margin:0 auto; }
  .ministry-head { max-width:760px; margin:0 auto 56px; text-align:center; }
  .ministry-grid { display:grid; grid-template-columns:repeat(4, minmax(0,1fr)); gap:18px; }
  .ministry-card {
    background:#f6f9fb; border:1px solid var(--primary-line); border-radius:var(--r-lg);
    padding:30px 26px; display:flex; flex-direction:column; gap:12px;
    transition:transform .22s, box-shadow .22s, border-color .22s, background .22s;
    position:relative; overflow:hidden; text-decoration:none; color:inherit;
  }
  .ministry-card::after { content:""; position:absolute; right:-28px; bottom:-36px; width:130px; height:130px; border-radius:50%; background:rgba(0,79,104,0.05); pointer-events:none; transition:transform .22s; }
  .ministry-card:hover { transform:translateY(-5px); box-shadow:0 22px 52px rgba(0,79,104,0.13); border-color:rgba(0,79,104,0.2); background:var(--white); }
  .ministry-card:hover::after { transform:scale(1.2); }
  .ministry-card-icon { width:48px; height:48px; border-radius:15px; background:var(--primary-soft); color:var(--primary); display:flex; align-items:center; justify-content:center; flex-shrink:0; position:relative; z-index:1; }
  .ministry-card-tag { font-size:11px; font-weight:800; letter-spacing:0.05em; color:var(--primary); position:relative; z-index:1; }
  .ministry-card h4 { font-size:20px; font-weight:800; letter-spacing:-0.02em; color:#102028; line-height:1.3; position:relative; z-index:1; }
  .ministry-card p { font-size:14px; line-height:1.8; color:var(--muted); position:relative; z-index:1; }
  .ministry-card-arrow { margin-top:auto; padding-top:16px; font-size:13px; font-weight:800; color:var(--primary); display:flex; align-items:center; gap:5px; position:relative; z-index:1; opacity:0; transition:opacity .22s; }
  .ministry-card:hover .ministry-card-arrow { opacity:1; }

  /* ── 반응형 ── */
  @media (max-width:1050px) {
    .values-grid { grid-template-columns:repeat(3,1fr); }
    .ministry-grid { grid-template-columns:repeat(2,1fr); }
  }
  @media (max-width:860px) {
    .history-grid, .vismis-grid, .commit-grid { grid-template-columns:1fr; }
    .values-grid { grid-template-columns:repeat(2,1fr); }
  }
  @media (max-width:640px) {
    .ab-hero { padding:130px 20px 72px; }
    .hero-inner h1 { font-size:38px; }
    .hero-stats { flex-wrap:wrap; }
    .hero-stat { min-width:50%; border-right:none; border-bottom:1px solid rgba(255,255,255,0.12); }
    .hero-stat:nth-child(odd) { border-right:1px solid rgba(255,255,255,0.12); }
    .section-title { font-size:30px; }
    .values-grid { grid-template-columns:1fr; }
    .ministry-grid { grid-template-columns:1fr; }
    .history-card, .vismis-card { padding:34px 26px; }
    .intro-card { padding:34px 24px; }
    .intro-card p { font-size:15px; }
    .faith-item { grid-template-columns:40px 1fr; gap:14px; }
    .commit-grid { grid-template-columns:1fr; }
  }
</style>

<!-- ══ HERO ══ -->
<section class="ab-hero">
  <div class="hero-grid-bg"></div>
  <div class="hero-inner">
    <div class="hero-eyebrow"><span class="hero-eyebrow-dot"></span>ABOUT WORD OF LIFE KOREA</div>
    <h1>
      <span class="wl-ko">복음으로<br><em>다음 세대를 세웁니다</em></span>
      <span class="wl-en">Raising the Next Generation<br><em>Through the Gospel</em></span>
    </h1>
    <p class="hero-sub">
      <span class="wl-ko">캠프와 학생 사역을 통해 청소년과 다음 세대를<br>예수 그리스도의 제자로 세워갑니다.</span>
      <span class="wl-en">Through camps and student ministry, we raise the next generation<br>as disciples of Jesus Christ.</span>
    </p>
    <a href="/camp" class="hero-cta">
      <span class="wl-ko">사역 살펴보기</span><span class="wl-en">Explore Our Ministry</span>
      <svg viewBox="0 0 16 16" width="14" height="14" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
    <div class="hero-stats">
      <div class="hero-stat">
        <span class="hero-stat-num">1993</span>
        <span class="hero-stat-label"><span class="wl-ko">설립 연도</span><span class="wl-en">Founded</span></span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-num">80<span style="font-size:16px;font-weight:800;vertical-align:2px;">+</span></span>
        <span class="hero-stat-label"><span class="wl-ko">글로벌 사역 국가</span><span class="wl-en">Nations Worldwide</span></span>
      </div>
      <div class="hero-stat">
        <span class="hero-stat-num">4</span>
        <span class="hero-stat-label"><span class="wl-ko">주요 사역</span><span class="wl-en">Major Ministries</span></span>
      </div>
    </div>
  </div>
</section>

<!-- ══ WHO WE ARE ══ -->
<section class="section section--alt">
  <div class="page-wrap">
    <span class="section-badge">WHO WE ARE</span>
    <h2 class="section-title">
      <span class="wl-ko">다음 세대에<br>복음을 전합니다</span>
      <span class="wl-en">Reaching<br>Your Generation</span>
    </h2>
    <p class="section-desc">
      <span class="wl-ko">처음부터 하나님은 월코를 통해 전 세계 사람들을 당신께로 인도하셨습니다.</span>
      <span class="wl-en">Since day one, God has used Word of Life to bring people from all over the world to Himself.</span>
    </p>
    <div class="intro-single-wrap">
      <div class="intro-card">
        <p class="wl-ko">잭 월츤과 해리 볼백이 생명의말씀협회 사역을 시작할 때, 그들은 복음으로 그 시대의 문화에 다가가는 것에 헌신했습니다. 오늘날 생명의말씀협회는 복음으로 이 세대에 다가가고, 청소년과 가족들이 믿음을 경험할 수 있는 기회를 만들며, 아직 복음을 듣지 못한 이들에게 구원의 메시지를 전하는 목적에 여전히 헌신하고 있습니다.</p>
        <p class="wl-en">When Jack Wyrtzen and Harry Bollback began the ministry of Word of Life, they were committed to engaging their culture with the Gospel. Today, Word of Life remains committed to the purpose of reaching our generation with the Gospel — creating opportunities for youth and families to experience their faith, and share the message of salvation with those who have never heard.</p>
        <div class="intro-card-sig">
          <span class="wl-ko">한국생명의 말씀협회 (월코)</span>
          <span class="wl-en">Word of Life Korea</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══ HISTORY ══ -->
<section class="section section--bg">
  <div class="page-wrap" style="text-align:center;">
    <span class="section-badge">HISTORY</span>
    <h2 class="section-title">
      <span class="wl-ko">생명의말씀협회<br>역사</span>
      <span class="wl-en">The History of<br>Word of Life Fellowship</span>
    </h2>
    <p class="section-desc">
      <span class="wl-ko">처음부터 창립자들의 비전은 단 하나였습니다 — 이 세대를 예수 그리스도께로 인도하기 위해 무엇이든 하겠다는 것이었습니다.</span>
      <span class="wl-en">From the beginning, it was the vision of Word of Life's founders that we will do what it takes to reach this generation for Jesus Christ.</span>
    </p>
  </div>
  <div class="history-grid page-wrap">
    <div class="history-card history-card--camp">
      <div class="history-year">1946</div>
      <span class="history-tag">WORD OF LIFE CAMPS</span>
      <h3><span class="wl-ko">캠프 사역의 시작</span><span class="wl-en">Word of Life Camps</span></h3>
      <p class="wl-ko">잭 월츤과 해리는 50센트짜리 보트를 빌려 처음으로 지금의 생명의 말씀 섬에 노를 저어 갔습니다. 부지는 폐허 상태였지만, 두 사람은 누구의 기대도 뛰어넘는 비전을 그 섬에서 보았습니다. 잭은 83세의 소유주 클라크 여사에게 매매가의 5분의 1인 2만 5천 달러를 제안했고, 그녀가 이를 수락했습니다. 그날 이후로 수십만 명의 청소년들이 생명의 말씀 섬 캠프에 참가했습니다.</p>
      <p class="wl-en">Jack and Harry rented a rowboat for fifty cents and rowed over to what is now Word of Life Island for the very first time. Though the property was in shambles, the pair had a vision for that island that far exceeded anyone's expectation. Jack offered $25,000 — a fifth of the asking price — to the eighty-three-year-old owner, Miss Clark, and she accepted. Since that day, hundreds of thousands of teens have attended camp on Word of Life Island.</p>
    </div>
    <div class="history-card history-card--institute">
      <div class="history-year">1970</div>
      <span class="history-tag">WORD OF LIFE BIBLE INSTITUTE</span>
      <h3><span class="wl-ko">월비 사역의 시작</span><span class="wl-en">Word of Life Bible Institute</span></h3>
      <p class="wl-ko">브라질 상파울루에 설립된 첫 번째 캠퍼스의 모델을 따라 미국에서도 첫 번째 성경학교가 문을 열었습니다. 생명의말씀협회 성경학교는 체계적인 제자 훈련과 세계 수준의 성경 교사들로 알려져 있습니다. 오늘날 생명의말씀협회는 전 세계 14개국에 성경학교를 두고 매년 수천 명의 청소년들을 훈련하고 있으며, 성경학교는 학생들이 전 세계로 복음을 들고 나아가는 발판이 되었습니다.</p>
      <p class="wl-en">The first American Bible Institute was opened following the pattern of the original campus in Sao Paulo, Brazil. Known for structured discipleship and world-class Bible teachers, Word of Life now has Bible Institutes in 14 countries around the world, training thousands of young people each year. The Bible Institute has become a launching ground for students to take the Gospel all around the world.</p>
    </div>
  </div>
</section>

