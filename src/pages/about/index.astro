---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="월코소개 — Word of Life Korea" activeNav="about" whiteNav={true}>
  <style>
    body { background: #f6f9fb; }

    /* ── HERO ── */
    .hero {
      padding: 148px 24px 100px; text-align: center;
      background: linear-gradient(160deg, #083d51 0%, #004f68 48%, #0a6b88 100%);
      position: relative; overflow: hidden;
    }
    .hero::before { content: ""; position: absolute; top: -120px; right: -120px; width: 480px; height: 480px; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,0.055) 0%, transparent 70%); pointer-events: none; }
    .hero::after { content: ""; position: absolute; bottom: -80px; left: -80px; width: 360px; height: 360px; border-radius: 50%; background: radial-gradient(circle, rgba(255,255,255,0.04) 0%, transparent 70%); pointer-events: none; }
    .hero-grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.04) 1px, transparent 1px); background-size: 60px 60px; pointer-events: none; }
    .hero-inner { position: relative; z-index: 2; max-width: 760px; margin: 0 auto; }
    .hero-eyebrow { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 999px; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.2); font-size: 12px; font-weight: 800; letter-spacing: 0.08em; color: rgba(255,255,255,0.88); margin-bottom: 24px; font-family: 'Montserrat', sans-serif; }
    .hero-eyebrow-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue-light); }
    .hero h1 { font-size: 54px; font-weight: 800; line-height: 1.18; letter-spacing: -0.04em; color: #fff; margin-bottom: 20px; }
    .hero h1 em { font-style: normal; color: var(--blue-light); display: block; }
    .hero-sub { font-size: 17px; line-height: 1.85; color: rgba(255,255,255,0.78); max-width: 580px; margin: 0 auto 12px; }
    .hero-en { font-size: 13px; letter-spacing: 0.05em; color: rgba(255,255,255,0.42); font-style: italic; margin-bottom: 36px; display: block; }
    .hero-cta { display: inline-flex; align-items: center; gap: 8px; padding: 15px 28px; border-radius: 999px; background: #fff; color: var(--blue-dark); font-size: 15px; font-weight: 800; text-decoration: none; box-shadow: 0 12px 32px rgba(0,0,0,0.16); transition: transform 0.18s ease, box-shadow 0.18s ease; }
    .hero-cta:hover { transform: translateY(-2px); box-shadow: 0 18px 40px rgba(0,0,0,0.2); }
    .hero-stats { display: flex; justify-content: center; margin-top: 60px; max-width: 700px; margin-left: auto; margin-right: auto; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.14); border-radius: 20px; backdrop-filter: blur(8px); overflow: hidden; }
    .hero-stat { flex: 1; padding: 22px 16px; text-align: center; border-right: 1px solid rgba(255,255,255,0.12); }
    .hero-stat:last-child { border-right: none; }
    .hero-stat-num { font-size: 28px; font-weight: 800; letter-spacing: -0.03em; color: #fff; display: block; line-height: 1; margin-bottom: 6px; font-family: 'Montserrat', sans-serif; }
    .hero-stat-label { font-size: 12px; font-weight: 700; color: rgba(255,255,255,0.55); }

    /* ── 공통 섹션 ── */
    .section { padding: 96px 24px; }
    .section--white { background: #fff; }
    .section--gray { background: #f6f9fb; }
    .page-wrap { max-width: 1200px; margin: 0 auto; }
    .section-badge { display: inline-flex; align-items: center; padding: 7px 14px; border-radius: 999px; background: var(--primary-soft); color: var(--blue-dark); font-size: 12px; font-weight: 800; letter-spacing: 0.04em; margin-bottom: 16px; font-family: 'Montserrat', sans-serif; }
    .section-title { font-size: 38px; font-weight: 800; line-height: 1.22; letter-spacing: -0.035em; color: #0f1b22; margin-bottom: 14px; }
    .section-desc { font-size: 16px; line-height: 1.9; color: var(--text-mid); max-width: 640px; }

    /* ── 인사말 ── */
    .intro-card { background: #fff; border: 1px solid var(--primary-line); border-radius: var(--r-xl); padding: 38px 34px; box-shadow: var(--shadow); position: relative; overflow: hidden; max-width: 760px; margin: 52px auto 0; }
    .intro-card::after { content: ""; position: absolute; right: -40px; bottom: -50px; width: 180px; height: 180px; border-radius: 50%; background: var(--primary-soft); pointer-events: none; }
    .intro-card-lang { font-size: 11px; font-weight: 800; letter-spacing: 0.1em; color: var(--blue-dark); margin-bottom: 18px; display: block; position: relative; z-index: 1; font-family: 'Montserrat', sans-serif; }
    .intro-card p { font-size: 15.5px; line-height: 1.95; color: #3a4e58; position: relative; z-index: 1; }
    .intro-card-sig { margin-top: 22px; padding-top: 18px; border-top: 1px solid rgba(0,79,104,0.1); font-size: 14px; font-weight: 800; color: var(--blue-dark); position: relative; z-index: 1; }

    /* ── 핵심 가치 ── */
    .values-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-top: 52px; }
    .value-card { background: #f6f9fb; border: 1px solid var(--primary-line); border-radius: var(--r-lg); padding: 26px 20px; display: flex; flex-direction: column; gap: 12px; transition: transform 0.22s ease, background 0.22s ease, box-shadow 0.22s ease; position: relative; overflow: hidden; }
    .value-card:hover { background: linear-gradient(180deg, #0a5b76 0%, #004f68 100%); border-color: transparent; box-shadow: 0 20px 48px rgba(0,79,104,0.22); transform: translateY(-5px); }
    .value-card:hover .value-icon-wrap { background: rgba(255,255,255,0.14); color: #fff; }
    .value-card:hover .value-num, .value-card:hover .value-title { color: #fff; }
    .value-card:hover .value-desc { color: rgba(255,255,255,0.8); }
    .value-icon-wrap { width: 42px; height: 42px; border-radius: 12px; background: var(--primary-soft); color: var(--blue-dark); display: flex; align-items: center; justify-content: center; transition: background 0.22s ease, color 0.22s ease; }
    .value-num { font-size: 11px; font-weight: 800; letter-spacing: 0.06em; color: var(--blue-dark); font-family: 'Montserrat', sans-serif; }
    .value-title { font-size: 17px; font-weight: 800; color: #102028; line-height: 1.3; }
    .value-desc { font-size: 13.5px; line-height: 1.8; color: var(--text-mid); }

    /* ── 미션 ── */
    .mission-pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 52px; }
    .mission-pillar { border-radius: var(--r-xl); padding: 48px 40px; display: flex; flex-direction: column; gap: 16px; position: relative; overflow: hidden; }
    .mission-pillar--blue { background: linear-gradient(145deg, #0a5b76 0%, #004f68 100%); box-shadow: 0 24px 56px rgba(0,79,104,0.22); }
    .mission-pillar--green { background: linear-gradient(145deg, #1a4a3a 0%, #0f3328 100%); box-shadow: 0 24px 56px rgba(15,51,40,0.22); }
    .mission-pillar::before { content: ""; position: absolute; right: -60px; bottom: -60px; width: 240px; height: 240px; border-radius: 50%; background: rgba(255,255,255,0.06); pointer-events: none; }
    .mission-pillar > * { position: relative; z-index: 1; }
    .mission-pillar-num { font-size: 11px; font-weight: 800; letter-spacing: 0.1em; color: rgba(255,255,255,0.48); font-family: 'Montserrat', sans-serif; }
    .mission-pillar h3 { font-size: 30px; font-weight: 800; letter-spacing: -0.03em; color: #fff; line-height: 1.2; }
    .mission-pillar p { font-size: 15px; line-height: 1.85; color: rgba(255,255,255,0.76); }

    /* ── 주요사역 ── */
    .ministry-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-top: 52px; }
    .ministry-card { background: #f6f9fb; border: 1px solid var(--primary-line); border-radius: var(--r-lg); padding: 28px 24px; display: flex; flex-direction: column; gap: 10px; transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease, background 0.22s ease; position: relative; overflow: hidden; text-decoration: none; color: inherit; }
    .ministry-card:hover { transform: translateY(-5px); box-shadow: 0 22px 52px rgba(0,79,104,0.13); border-color: rgba(0,79,104,0.2); background: #fff; }
    .ministry-card-icon { width: 46px; height: 46px; border-radius: 14px; background: var(--primary-soft); color: var(--blue-dark); display: flex; align-items: center; justify-content: center; }
    .ministry-card-tag { font-size: 11px; font-weight: 800; letter-spacing: 0.05em; color: var(--blue-dark); font-family: 'Montserrat', sans-serif; }
    .ministry-card h4 { font-size: 18px; font-weight: 800; letter-spacing: -0.02em; color: #102028; line-height: 1.3; }
    .ministry-card p { font-size: 13.5px; line-height: 1.8; color: var(--text-mid); }
    .ministry-card-arrow { margin-top: auto; padding-top: 14px; font-size: 13px; font-weight: 800; color: var(--blue-dark); opacity: 0; transition: opacity 0.22s ease; }
    .ministry-card:hover .ministry-card-arrow { opacity: 1; }

    /* ── 연락처 ── */
    .contact-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 52px; }
    .contact-card { background: #fff; border: 1px solid var(--primary-line); border-radius: var(--r-xl); padding: 36px 32px; box-shadow: var(--shadow); position: relative; overflow: hidden; transition: transform 0.22s ease, box-shadow 0.22s ease; }
    .contact-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-strong); }
    .contact-card::after { content: ""; position: absolute; right: -40px; bottom: -50px; width: 180px; height: 180px; border-radius: 50%; background: var(--primary-soft); pointer-events: none; }
    .contact-card > * { position: relative; z-index: 1; }
    .contact-tag { display: inline-flex; align-items: center; padding: 6px 12px; border-radius: 999px; background: var(--primary-soft); color: var(--blue-dark); font-size: 11px; font-weight: 800; letter-spacing: 0.05em; margin-bottom: 18px; font-family: 'Montserrat', sans-serif; }
    .contact-card h3 { font-size: 20px; font-weight: 800; letter-spacing: -0.02em; color: #102028; margin-bottom: 20px; line-height: 1.3; }
    .contact-info-list { display: flex; flex-direction: column; gap: 10px; }
    .contact-info-row { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; line-height: 1.7; color: var(--text-mid); }
    .contact-info-row svg { flex-shrink: 0; margin-top: 3px; color: var(--blue-dark); opacity: 0.7; }

    /* ── CTA ── */
    .cta-section { padding: 80px 24px; background: linear-gradient(150deg, #083d51 0%, #004f68 50%, #0a6b88 100%); text-align: center; position: relative; overflow: hidden; }
    .cta-section::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 60px 60px; pointer-events: none; }
    .cta-inner { position: relative; z-index: 2; max-width: 600px; margin: 0 auto; }
    .cta-inner h2 { font-size: 36px; font-weight: 800; letter-spacing: -0.035em; color: #fff; line-height: 1.22; margin-bottom: 14px; }
    .cta-inner p { font-size: 16px; line-height: 1.85; color: rgba(255,255,255,0.74); margin-bottom: 36px; }
    .cta-buttons { display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; }
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 15px 28px; border-radius: 999px; font-size: 15px; font-weight: 800; text-decoration: none; transition: transform 0.18s ease, box-shadow 0.18s ease; }
    .btn:hover { transform: translateY(-2px); }
    .btn-white { background: #fff; color: var(--blue-dark); box-shadow: 0 12px 28px rgba(0,0,0,0.14); }
    .btn-ghost { background: rgba(255,255,255,0.1); color: #fff; border: 1px solid rgba(255,255,255,0.26); }
    .btn-ghost:hover { background: rgba(255,255,255,0.16); }

    /* ── RESPONSIVE ── */
    @media (max-width: 900px) {
      .values-grid { grid-template-columns: repeat(3, 1fr); }
      .ministry-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
      .hero { padding: 120px 20px 80px; }
      .hero h1 { font-size: 36px; }
      .hero-sub { font-size: 15px; }
      .hero-stats { flex-wrap: wrap; }
      .hero-stat { min-width: 50%; border-right: none; border-bottom: 1px solid rgba(255,255,255,0.12); }
      .hero-stat:nth-child(odd) { border-right: 1px solid rgba(255,255,255,0.12); }
      .hero-stat:last-child { border-bottom: none; }
      .section { padding: 72px 20px; }
      .section-title { font-size: 30px; }
      .values-grid { grid-template-columns: repeat(2, 1fr); }
      .mission-pillars { grid-template-columns: 1fr; }
      .mission-pillar { padding: 34px 26px; }
      .mission-pillar h3 { font-size: 26px; }
      .ministry-grid { grid-template-columns: 1fr; }
      .contact-grid { grid-template-columns: 1fr; }
      .cta-inner h2 { font-size: 28px; }
      .cta-buttons { flex-direction: column; align-items: center; }
    }
    @media (max-width: 480px) {
      .values-grid { grid-template-columns: 1fr; }
      .hero h1 { font-size: 30px; }
    }
  </style>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-grid"></div>
    <div class="hero-inner">
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        ABOUT WORD OF LIFE KOREA
      </div>
      <h1>
        <span class="wl-ko">복음으로<em>다음 세대를 세웁니다</em></span>
        <span class="wl-en">Building the<em>Next Generation</em></span>
      </h1>
      <p class="hero-sub">
        <span class="wl-ko">월코는 캠프와 학생 사역, 교회 사역을 통해 청소년과 다음 세대에게 복음을 전하고 예수 그리스도의 제자로 세워가는 사역을 감당합니다.</span>
        <span class="wl-en">WOLKO reaches youth and the next generation through camp, student, and church ministry — sharing the Gospel and raising disciples of Jesus Christ.</span>
      </p>
      <span class="hero-en">Bring Hope to the Youth of South Korea</span>
      <a href="/camp" class="hero-cta">
        <span class="wl-ko">사역 살펴보기 →</span>
        <span class="wl-en">Explore Our Ministry →</span>
      </a>
      <div class="hero-stats">
        <div class="hero-stat"><span class="hero-stat-num">5</span><span class="hero-stat-label"><span class="wl-ko">핵심 가치</span><span class="wl-en">Core Values</span></span></div>
        <div class="hero-stat"><span class="hero-stat-num">4</span><span class="hero-stat-label"><span class="wl-ko">주요 사역</span><span class="wl-en">Ministries</span></span></div>
        <div class="hero-stat"><span class="hero-stat-num">2</span><span class="hero-stat-label"><span class="wl-ko">평택 & 제주</span><span class="wl-en">Campuses</span></span></div>
        <div class="hero-stat"><span class="hero-stat-num"><span class="wl-ko">다음</span><span class="wl-en">Next</span></span><span class="hero-stat-label"><span class="wl-ko">세대를 위한 사역</span><span class="wl-en">Generation Ministry</span></span></div>
      </div>
    </div>
  </section>

  <!-- 인사말 -->
  <section class="section section--white">
    <div class="page-wrap">
      <div style="text-align:center;margin-bottom:16px;"><span class="section-badge">WELCOME MESSAGE</span></div>
      <h2 class="section-title" style="text-align:center;">
        <span class="wl-ko">월코에 오신 것을<br>환영합니다</span>
        <span class="wl-en">Welcome to<br>Word of Life Korea</span>
      </h2>
      <p class="section-desc" style="margin:0 auto;text-align:center;">
        <span class="wl-ko">한국생명의 말씀협회(월코)는 복음전파와 제자훈련에 대한 열정을 함께 나누기 원합니다. 하나님께서 월코를 통해 하시는 일을 살펴봐 주세요.</span>
        <span class="wl-en">Word of Life Korea shares a passion for evangelism and discipleship. We invite you to see what God is doing through WOLKO.</span>
      </p>
      <div class="intro-card">
        <span class="intro-card-lang">
          <span class="wl-ko">KO — 한국어</span>
          <span class="wl-en">EN — English</span>
        </span>
        <p>
          <span class="wl-ko">한국생명의 말씀협회(월코) 홈페이지에 방문하신 여러분을 환영합니다.<br><br>
          월코는 캠프, 학생 사역, 지역교회 사역, SYME(청년 제자 훈련센터), 성경학교(WOLBI) 훈련과 가족 사역을 통하여 한국의 청소년들에게 복음을 전하는 데 최선을 다하고 있습니다. 저희는 복음전파와 제자훈련에 대한 저희의 열정을 나누고 싶습니다. 잠시 시간을 내셔서 하나님께서 월코를 통해 하시는 일을 자세히 봐주시기 바랍니다.</span>
          <span class="wl-en">Welcome to the Word of Life Korea website.<br><br>
          WOLKO is committed to sharing the Gospel with the youth of Korea through camps, student ministry, local church ministry, SYME (Youth Discipleship Training Center), WOLBI (Bible Institute), and family ministry. We want to share our passion for evangelism and discipleship. Please take a moment to explore what God is doing through WOLKO.</span>
        </p>
        <div class="intro-card-sig">
          <span class="wl-ko">한국생명의 말씀협회 (월코)</span>
          <span class="wl-en">Word of Life Korea (WOLKO)</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 핵심 가치 -->
  <section class="section section--gray">
    <div class="page-wrap">
      <div style="text-align:center;margin-bottom:52px;">
        <span class="section-badge">CORE VALUES</span>
        <h2 class="section-title" style="margin-top:0;">
          <span class="wl-ko">월코가 추구하는 핵심 5가지</span>
          <span class="wl-en">5 Core Values of WOLKO</span>
        </h2>
      </div>
      <div class="values-grid">
        <div class="value-card">
          <div class="value-icon-wrap"><svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M4 4.5A2.5 2.5 0 0 0 6.5 7H20v13H6.5A2.5 2.5 0 0 1 4 17.5v-13Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <span class="value-num">01</span>
          <div class="value-title"><span class="wl-ko">성경중심</span><span class="wl-en">Scripture-Centered</span></div>
          <p class="value-desc"><span class="wl-ko">모든 사역의 중심에 변치 않는 성경의 진리가 있습니다. 성경은 우리의 기초이자 삶의 지침이며 희망의 원천입니다.</span><span class="wl-en">The unchanging truth of Scripture is at the heart of everything we do — our foundation, our guide, our hope.</span></p>
        </div>
        <div class="value-card">
          <div class="value-icon-wrap"><svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <span class="value-num">02</span>
          <div class="value-title"><span class="wl-ko">청소년 사역 중심</span><span class="wl-en">Youth-Focused</span></div>
          <p class="value-desc"><span class="wl-ko">다음 세대를 향한 열정이 월코를 움직입니다. 젊은이들 안에 그리스도를 위해 세상을 바꿀 가능성을 믿습니다.</span><span class="wl-en">A passion for the next generation drives WOLKO. We believe young people can change the world for Christ.</span></p>
        </div>
        <div class="value-card">
          <div class="value-icon-wrap"><svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M12 21s-6-3.65-6-10a3.5 3.5 0 0 1 6-2.47A3.5 3.5 0 0 1 18 11c0 6.35-6 10-6 10Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <span class="value-num">03</span>
          <div class="value-title"><span class="wl-ko">복음전파</span><span class="wl-en">Evangelism</span></div>
          <p class="value-desc"><span class="wl-ko">예수 그리스도가 해답이라는 단순하지만 삶을 바꾸는 메시지를 청소년 캠프와 국제 선교를 통해 전합니다.</span><span class="wl-en">We share the simple but life-changing message that Jesus Christ is the answer — through camps and international mission.</span></p>
        </div>
        <div class="value-card">
          <div class="value-icon-wrap"><svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="M22 10v6M2 10l10-5 10 5-10 5-10-5Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 12v5c3 3 9 3 12 0v-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <span class="value-num">04</span>
          <div class="value-title"><span class="wl-ko">제자훈련</span><span class="wl-en">Discipleship</span></div>
          <p class="value-desc"><span class="wl-ko">복음을 가르치는 데 그치지 않고, 신자들이 다른 사람들을 제자로 삼을 수 있도록 준비시키는 것이 월코의 사명입니다.</span><span class="wl-en">We don't just teach the Gospel — we equip believers to make disciples, multiplying faith in the next generation.</span></p>
        </div>
        <div class="value-card">
          <div class="value-icon-wrap"><svg viewBox="0 0 24 24" width="20" height="20" fill="none"><path d="m13 2-2 6.5H5l5.5 4-2.1 6.5L13.5 15l5.1 4-2.1-6.5L22 8.5h-6L13 2Z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
          <span class="value-num">05</span>
          <div class="value-title">High-Energy</div>
          <p class="value-desc"><span class="wl-ko">그리스도를 위해 사는 것이 가장 위대한 모험입니다. 그 흥분과 확신이 월코의 모든 사역을 이끌어갑니다.</span><span class="wl-en">Living for Christ is the greatest adventure. That excitement and conviction drives every ministry we do.</span></p>
        </div>
