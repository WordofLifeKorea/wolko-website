<!-- ══ VISION & MISSION — 사진 위 비전 → 비전이 이루어지는 모습(듣고·구원받고·전하고 + '친구에서 친구로' 그림) → 사명과 그 일을 하는 사역 ══ -->
<section class="section vm">
  <h2 class="sr-only"><span class="wl-ko">비전과 사명</span><span class="wl-en">Our Vision & Mission</span></h2>
  <div class="vm-vision">
    <div class="page-wrap vm-wrap">
      <p class="vm-label"><span class="wl-ko">우리의 비전</span><span class="wl-en">Our vision</span></p>
      <p class="vision-statement">
        <span class="wl-ko">&ldquo;모든 청소년이 예수님과 함께 다음 걸음을 내딛는 것&rdquo;</span>
        <span class="wl-en">&ldquo;Every young person taking their next step with Jesus&rdquo;</span>
      </p>
    </div>
  </div>
  <div class="page-wrap vm-wrap vm-flow">
    <div class="vm-flow-text">
      <p class="vm-steps" aria-label="듣고, 구원받고, 전하고">
        <span class="vm-step" style="--d:1.68s"><span class="vm-step-num" aria-hidden="true">1</span><span class="wl-ko">듣고</span><span class="wl-en">Hear</span></span>
        <svg class="vm-step-arrow" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h16M12 1.5 17 6l-5 4.5" /></svg>
        <span class="vm-step" style="--d:2.1s"><span class="vm-step-num" aria-hidden="true">2</span><span class="wl-ko">구원받고</span><span class="wl-en">Believe</span></span>
        <svg class="vm-step-arrow" viewBox="0 0 20 12" aria-hidden="true"><path d="M1 6h16M12 1.5 17 6l-5 4.5" /></svg>
        <span class="vm-step" style="--d:2.5s"><span class="vm-step-num" aria-hidden="true">3</span><span class="wl-ko">전하고</span><span class="wl-en">Pass it on</span></span>
      </p>
      <p class="vm-flow-desc">
        <span class="wl-ko">친구로부터 복음을 듣고 예수님을 믿어 구원받은 청소년이, 그 복음을 또 다른 친구에게 전합니다. 그렇게 복음이 친구에서 친구로 이어집니다.</span>
        <span class="wl-en">A young person hears the Gospel from a friend, believes in Jesus, and passes it on to another friend — and so the Gospel travels from friend to friend.</span>
      </p>
      <ul class="vm-legend">
        <li><svg width="26" height="26" viewBox="-13 -13 26 26" aria-hidden="true"><circle class="lg-ghost" r="12" /><use href="#rl-person" class="lg-ghost-p" transform="scale(.68)" /></svg><span class="wl-ko">아직 복음을 듣지 못한 친구</span><span class="wl-en">A friend who hasn't heard yet</span></li>
        <li class="is-lit"><svg width="26" height="26" viewBox="-13 -13 26 26" aria-hidden="true"><circle class="lg-lit" r="12" /><use href="#rl-person" class="lg-lit-p" transform="scale(.68)" /></svg><span class="wl-ko">복음을 듣고 예수님을 믿은 친구</span><span class="wl-en">A friend who heard and believed</span></li>
        <li class="is-arc"><svg width="26" height="22" viewBox="-2 0 26 22" aria-hidden="true"><path d="M2 16Q11 2 20 8" /></svg><span class="wl-ko">친구에게 전해진 복음</span><span class="wl-en">The Gospel passed to a friend</span></li>
      </ul>
    </div>
    <div class="vm-relay">
      <GospelRelay
        labelKo="가운데 먼저 믿은 한 친구에게서 세 친구, 여섯 친구, 열 친구로 원을 그리며 복음이 퍼져 나가는 그림. 위쪽 친구 곁에 듣고, 구원받고, 전하는 세 걸음이 1, 2, 3으로 표시되어 있습니다."
        labelEn="A picture of the Gospel spreading in circles from one friend who believed first, to three, six, then ten friends. Beside the top friend, the three steps of hearing, believing and passing it on are marked 1, 2 and 3."
      />
    </div>
  </div>
  <div class="page-wrap vm-wrap vm-mission">
    <h3 class="vm-label"><span class="wl-ko">우리의 사명</span><span class="wl-en">Our mission</span></h3>
    <p class="mission-statement">
      <span class="wl-ko">모든 청소년이 친구로부터 복음을 듣고 구원받아, 그 복음을 또 다른 친구에게 전할 수 있도록 돕는&nbsp;것</span>
      <span class="wl-en">To help every young person hear the Gospel from a friend, come to faith, and pass it on to the next friend</span>
    </p>
    <p class="vm-mission-lead"><span class="wl-ko">그래서 월코는 이런 자리를 섬깁니다</span><span class="wl-en">So WOLKO serves in these places</span></p>
    <ol class="vm-works">
      {missionWorks.map((w, i) => (
        <li>
          <a href={w.href} class="vm-work">
            <span class="vm-work-photo"><img src={w.img} alt="" loading="lazy" decoding="async"></span>
            <span class="vm-work-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="vm-work-name"><span class="wl-ko">{w.ko}</span><span class="wl-en">{w.en}</span></span>
            <span class="vm-work-role"><span class="wl-ko">{w.roleKo}</span><span class="wl-en">{w.roleEn}</span></span>
            <svg class="vm-work-arrow" aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/></svg>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- ══ COMMITMENTS ══ -->
<section class="section section--alt">
  <div class="page-wrap sec-head">
    <div>
    <span class="section-badge">OUR COMMITMENTS</span>
    <h2 class="section-title">
      <span class="wl-ko">지역 교회를 향한<br>월코의 약속</span>
      <span class="wl-en">Word of Life's Commitments<br>to the Local Church</span>
    </h2>
    </div>
    <p class="section-desc">
      <span class="wl-ko">월코는 복음 메시지를 전파하는 데 있어 지역 교회의 중요한 역할을 인정합니다.</span>
      <span class="wl-en">Word of Life recognizes the vital role of the local church in advancing the gospel message.</span>
    </p>
  </div>
  <div class="commit-inner page-wrap">
    <div class="commit-grid">
      <div class="commit-card">
        <span class="commit-num" aria-hidden="true">01</span>
        <h4><span class="wl-ko">지역 교회를 섬깁니다</span><span class="wl-en">Serving the Local Church</span></h4>
        <p class="wl-ko">우리의 주요 목표는 특히 청소년들에게 복음을 전하는 일에 있어 지역 교회를 섬기고 강화하며 지원하는 것입니다.</p>
        <p class="wl-en">Our primary aim is to serve, strengthen, and support local churches, particularly in reaching young people with the gospel.</p>
      </div>
      <div class="commit-card">
        <span class="commit-num" aria-hidden="true">02</span>
        <h4><span class="wl-ko">교단 소속도, 개척 단체도 아닙니다</span><span class="wl-en">Not a Church-Planting Organization</span></h4>
        <p class="wl-ko">월코는 특정 교단에 속해 있지 않고, 교회 개척을 위한 단체도 아닙니다. 대신 지역 교회와 교회 개척자들과 협력하며 청소년 사역을 돕습니다.</p>
        <p class="wl-en">Word of Life's vision is not to function as a church denomination or church planting organization. Instead, we actively partner with established local churches and church planters.</p>
      </div>
      <div class="commit-card">
        <span class="commit-num" aria-hidden="true">03</span>
        <h4><span class="wl-ko">교회를 향한 헌신된 구성원</span><span class="wl-en">Committed Church Members</span></h4>
        <p class="wl-ko">우리는 지역 교회를 매우 존중하며, 모든 월코 팀원이 지역 교회의 헌신적이고 적극적인 구성원이 되도록 기대합니다.</p>
        <p class="wl-en">We highly esteem the local church, and we expect all Word of Life team members to be dedicated and active participants in local congregations.</p>
      </div>
      <div class="commit-card">
        <span class="commit-num" aria-hidden="true">04</span>
        <h4><span class="wl-ko">지역·세계 선교에 헌신합니다</span><span class="wl-en">Committed to Local & Global Missions</span></h4>
        <p class="wl-ko">우리는 교회가 지역적으로나 세계적으로 선교사를 파송하고 지원하는 데 참여해야 한다고 굳게 믿으며, 이를 위해 파트너십을 통해 교회와 협력합니다.</p>
        <p class="wl-en">We firmly believe churches must engage in sending and supporting missionaries, locally and globally. We are committed to facilitating this mission by partnering with churches to send Word of Life missionaries across the world.</p>
      </div>
    </div>
  </div>
</section>



<script is:inline>
  // 월코소개 움직임: 히어로가 차례로 나타나고, 숫자는 화면에 보일 때 올라가며, 아래 섹션은 스크롤하면 하나씩 떠오른다.
  // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
  (function () {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    document.documentElement.classList.add('wl-motion');

    // 숫자 올라가기 — 처음엔 시작 숫자를 보여 주고, 보이면 2.4초 동안 끝 숫자까지
    // 맨 위 배너 숫자는 배너(PageHero)가 직접 올린다
    var counters = [].slice.call(document.querySelectorAll('[data-count-from]')).filter(function (el) { return !el.closest('.ph'); });
    counters.forEach(function (el) { el.dataset.countTo = el.textContent.trim(); el.textContent = el.dataset.countFrom; });
    function count(el, delay) {
      var from = +el.dataset.countFrom, to = +el.dataset.countTo, dur = 2400;
      setTimeout(function () {
        var t0 = Date.now();
        (function step() {
          var k = Math.min(1, (Date.now() - t0) / dur), e = 1 - Math.pow(1 - k, 4);
          el.textContent = Math.round(from + (to - from) * e);
          if (k < 1) setTimeout(step, 30);
        })();
      }, delay);
    }
    var cio = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        cio.unobserve(en.target);
        count(en.target, 300);
      });
    }, { threshold: 0.6 });
    counters.forEach(function (el) { cio.observe(el); });

    // 섹션 떠오르기 — 편지(봉투)는 따로 움직이니 뺀다
    // 순서: 한 섹션 안에서 작은 표시 → 제목 → 설명 → (조금 뒤) 카드가 왼쪽부터 하나씩. 같이 화면에 들어와도 이 차례대로 떠오른다.
    var groups = ['.history-grid', '.values-grid', '.commit-grid', '.vm-works'];
    var items = [];
    [].forEach.call(document.querySelectorAll('.section'), function (sec) {
      [].forEach.call(sec.querySelectorAll('.section-badge, .section-title, .who-title-rule, .section-desc, .vision-statement, .values-big'), function (el, i) {
        el.style.setProperty('--d', i * 0.14 + 's'); items.push(el);
      });
    });
    groups.forEach(function (g) {
      [].slice.call(document.querySelectorAll(g + ' > *')).forEach(function (el, i) { el.style.setProperty('--d', 0.35 + Math.min(i, 5) * 0.14 + 's'); items.push(el); });
    });
    var rio = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); rio.unobserve(en.target); } });
    }, { threshold: 0.15, rootMargin: '0px 0px -8% 0px' });
    items.forEach(function (el) {
      el.classList.add('rv'); rio.observe(el);
      // 다 떠오르면 표시를 떼어 카드 원래의 호버 움직임으로 돌려 놓는다
      el.addEventListener('transitionend', function done(e) {
        if (e.target !== el || e.propertyName !== 'transform' || !el.classList.contains('is-in')) return;
        el.removeEventListener('transitionend', done); el.classList.remove('rv', 'is-in'); el.style.removeProperty('--d');
      });
    });
  })();

  // 월코소개 편지: 화면에 들어오면 봉투가 열리고 편지가 나와 펼쳐진다 — 스크롤 위치에 묶지 않고 한 번에 끝까지 재생한다
  // (스크롤에 묶으면 멈춘 자리에서 덮개만 열린 어정쩡한 장면이 남았다). 움직임 줄이기 · 자바스크립트 꺼짐 · 이미 지나온 자리면 그냥 편지만 보인다.
  (function () {
    var stage = document.getElementById('letterStage'), letter = document.getElementById('letterAnim'), env = document.getElementById('env');
    if (!stage || !letter || !env || !letter.animate || !('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (stage.getBoundingClientRect().top < (window.innerHeight || 800) * 0.8) return;   // 새로고침 등으로 이미 보이는 자리면 재생하지 않는다
    var flap = env.querySelector('.env-flap'), seal = env.querySelector('.env-seal'), burst = env.querySelector('.env-burst');
    var card = letter.querySelector('.intro-card');
    var m = null, played = false;
    var EASE = 'cubic-bezier(.22,.8,.24,1)';
    // 단계별 시간(ms) — 모두 한 시작점에서 지연으로 건다(타이머를 안 써서 백그라운드 탭에서도 순서가 어긋나지 않는다)
    // 봉투가 떠오름 → 살짝 흔들림 → 봉인이 톡 떨어지며 금빛 고리 → 덮개 → 편지가 나옴 → 펼쳐짐 → 로고 도장 → 글이 한 줄씩
    var T = { enter: 420, wiggleAt: 380, wiggle: 420, sealAt: 760, seal: 420, flapAt: 980, flap: 600, riseAt: 1420, rise: 650, spread: 950 };
    function measure() {
      var W = stage.clientWidth, H = letter.offsetHeight, narrow = W < 560;
      var Ew = Math.min(W * (narrow ? 0.86 : 0.7), 520), Eh = Ew * 0.62;
      var top = Eh * 0.66;                                  // 봉투는 편지 칸 위쪽에 — 폰에서 편지가 길어도 봉투가 화면에 보이고, 빠져나온 편지가 위 제목에 닿지 않는다
      var s0 = (Ew * 0.82) / W;                             // 봉투 안에 들어갈 만큼 줄인 편지
      m = { W: W, H: H, Eh: Eh, s0: s0,
            vis0: (Eh * 0.72) / s0,                         // 봉투 안에 있을 때 보이는 편지 높이(줄이기 전 단위)
            yIn: top + Eh * 0.18, yOut: top - Eh * 0.62 };  // 봉투 속 → 봉투 위로 빠져나온 자리
      env.style.left = (W - Ew) / 2 + 'px'; env.style.top = top + 'px'; env.style.width = Ew + 'px'; env.style.height = Eh + 'px';
    }
    function pose(y, s, vis, r) {
      return { transform: 'translateY(' + y.toFixed(1) + 'px) scale(' + s.toFixed(4) + ') rotate(' + (r || 0) + 'deg)', clipPath: 'inset(-70px -60px ' + Math.max(0, m.H - vis).toFixed(1) + 'px -60px)' };
    }
    function setInitial() {
      measure();
      stage.classList.add('is-anim');
      stage.style.opacity = '0';                            // 봉투는 화면에 들어올 때 떠오르며 나타난다
      stage.style.transformOrigin = '50% ' + (parseFloat(env.style.top) + m.Eh / 2).toFixed(1) + 'px';
      var p = pose(m.yIn, m.s0, m.vis0);
      letter.style.transform = p.transform; letter.style.clipPath = p.clipPath; letter.style.zIndex = 2;
    }
    function finish() {
      stage.classList.remove('is-anim');
      stage.style.opacity = '';
      if (stage.getAnimations) stage.getAnimations().forEach(function (a) { a.cancel(); });
      letter.style.transform = 'none'; letter.style.clipPath = 'none'; letter.style.zIndex = '';
      if (letter.getAnimations) letter.getAnimations().forEach(function (a) { a.cancel(); });
    }
    function play() {
      if (played) return; played = true;
      setInitial();
      var spreadAt = T.riseAt + T.rise, total = spreadAt + T.spread;
      var CLOSED = 'linear-gradient(180deg,#f3e7ca,#e9d8b2)', INNER = 'linear-gradient(0deg,#d9c698,#cdb88a)';
      // 0) 봉투가 아래에서 떠오르고, 편지가 들었다는 듯 좌우로 살짝 흔들린다
      stage.animate([{ opacity: 0, translate: '0 28px' }, { opacity: 1, translate: '0 0' }], { duration: T.enter, easing: 'cubic-bezier(.2,.8,.3,1)', fill: 'forwards' });
      stage.animate([{ rotate: '0deg' }, { rotate: '-2.4deg', offset: 0.25 }, { rotate: '2deg', offset: 0.55 }, { rotate: '-.8deg', offset: 0.8 }, { rotate: '0deg' }],
        { duration: T.wiggle, delay: T.wiggleAt, easing: 'ease-in-out' });
      // 1) 봉인이 꾹 눌렸다가 톡 떨어지고, 그 자리에 금빛 고리가 퍼진다
      seal.animate([{ transform: 'scale(1)', opacity: 1 }, { transform: 'scale(.86)', opacity: 1, offset: 0.25 }, { transform: 'scale(1.18)', opacity: 1, offset: 0.5 },
        { transform: 'translateY(26px) rotate(24deg) scale(.7)', opacity: 0 }],
        { duration: T.seal, delay: T.sealAt, easing: 'ease-in', fill: 'forwards' });
      burst.animate([{ transform: 'scale(.7)', opacity: 0 }, { transform: 'scale(.9)', opacity: .9, offset: 0.15 }, { transform: 'scale(2.6)', opacity: 0 }],
        { duration: 640, delay: T.sealAt + T.seal * 0.45, easing: 'cubic-bezier(.2,.7,.3,1)', fill: 'both' });
      // 2) 덮개가 뒤로 젖혀진다 — 절반을 넘기면 안쪽 면(어두운 색)이 보이고 편지 뒤로 간다
      flap.animate([
        { transform: 'perspective(1100px) rotateX(0deg)', zIndex: 4, background: CLOSED, easing: 'cubic-bezier(.45,.05,.55,.95)' },
        { transform: 'perspective(1100px) rotateX(-90deg)', zIndex: 4, background: CLOSED, offset: 0.5 },
        { transform: 'perspective(1100px) rotateX(-90deg)', zIndex: 0, background: INNER, offset: 0.501, easing: 'cubic-bezier(.3,.6,.3,1)' },
        { transform: 'perspective(1100px) rotateX(-180deg)', zIndex: 0, background: INNER }
      ], { duration: T.flap, delay: T.flapAt, fill: 'both' });
      // 3) 편지가 봉투 앞면 뒤에서 위로 빠져나오고, 4) 앞으로 꺼내져 제 크기로 펼쳐진다
      var a = pose(m.yIn, m.s0, m.vis0), b = pose(m.yOut, m.s0, m.vis0, -1.6), c = pose(0, 1, m.H);
      var k = function (o, at, z, easing) { var f = { transform: o.transform, clipPath: o.clipPath, zIndex: z, offset: at / total }; if (easing) f.easing = easing; return f; };
      var run = letter.animate([
        k(a, 0, 2), k(a, T.riseAt, 2, 'cubic-bezier(.3,.6,.25,1)'), k(b, spreadAt, 2), k(b, spreadAt + 1, 6, EASE), k(c, total, 6)
      ], { duration: total, fill: 'forwards' });
      // 봉투는 편지가 펼쳐지기 시작할 때 아래로 내려가며 사라진다 — 봉투 전체(.env)에 투명도를 걸면 한 덩어리 층이 되어
      // 편지 아래로 깔리므로, 조각마다 따로 건다
      var drop = Math.round(m.Eh * 0.35) + 'px';
      [].forEach.call(env.querySelectorAll('.env-back, .env-front, .env-flap'), function (el) {
        el.animate([{ opacity: 1, translate: '0 0' }, { opacity: 0, translate: '0 ' + drop }], { duration: 520, delay: spreadAt, easing: 'ease-in', fill: 'forwards' });
      });
      // 5) 편지 위 월코 로고는 봉투 안에서는 숨어 있다가(봉인과 겹쳐 보이지 않게) 다 펼쳐지면 도장처럼 쿵 찍힌다
      try {
        card.animate([{ opacity: 0, transform: 'scale(1.7)' }, { opacity: 0, transform: 'scale(1.7)', offset: (total - 120) / (total + 460), easing: 'cubic-bezier(.5,0,.8,.4)' },
          { opacity: 1, transform: 'scale(.92)', offset: (total + 240) / (total + 460), easing: 'ease-out' }, { opacity: 1, transform: 'scale(1)' }],
          { duration: total + 460, pseudoElement: '::after' });
      } catch (e) {}
      // 6) 첫인사는 봉투에서 나올 때부터 보이고, 나머지 글은 펼쳐진 뒤 한 줄씩 떠오른다
      [].filter.call(card.children, function (el) { return !el.classList.contains('intro-greet') && el.offsetParent !== null; }).forEach(function (el, i) {
        el.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }],
          { duration: 520, delay: total - 260 + i * 120, easing: 'ease-out', fill: 'backwards' });
      });
      run.onfinish = finish;
    }
    setInitial();
    var io = new IntersectionObserver(function (entries) {
      if (entries[0].isIntersecting) { io.disconnect(); play(); }
    }, { rootMargin: '0px 0px -22% 0px' });                  // 편지 칸 윗부분(봉투)이 화면 아래 1/5을 넘어 올라오면 시작
    io.observe(stage);
    window.addEventListener('resize', function () { if (!played) setInitial(); });
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () { if (!played) setInitial(); });
  })();
</script>

