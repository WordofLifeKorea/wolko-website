---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

// 주요 사역 — 왼쪽 목록과 오른쪽 큰 사진이 같은 목록을 쓴다
const ministries = [
  { href: '/camp', img: '/images/ministries/camp.jpg', tag: 'CAMP MINISTRY',
    ko: '캠프 사역', en: 'Camp Ministry',
    descKo: '복음을 집중적으로 경험하는 월코의 핵심 사역입니다.', descEn: "WOLKO's signature ministry where youth encounter the Gospel in a focused setting." },
  { href: '/youth', img: '/images/ministries/youth.jpg', tag: 'STUDENT MINISTRY',
    ko: '청소년 사역 & 코어 트레이닝', en: 'Youth Ministry & Core Training',
    descKo: '교회와 일상 속에서 지속적인 신앙 성장을 돕고 복음 리더로 세웁니다.', descEn: 'Helping students grow in faith and equipping them as Gospel-centered leaders.' },
  { href: '/jr-syme', img: '/images/ministries/syme.jpg', tag: 'DISCIPLESHIP',
    ko: 'Jr. SYME', en: 'Jr. SYME',
    descKo: '중·고등학생 대상 여름·겨울방학 3주 영어 제자훈련 프로그램입니다.', descEn: 'A 3-week English discipleship training program for middle and high school students each vacation.' },
  { href: '/wolbi-jeju', img: '/images/ministries/wolbi.jpg', tag: 'BIBLE INSTITUTE',
    ko: '제주월비 (WOLBI)', en: 'WOLBI Jeju',
    descKo: '제주에서 이루어지는 깊이 있는 성경학교 훈련입니다.', descEn: 'A deep Bible training ministry in Jeju where students are grounded through the Word of God.' },
];
---

<BaseLayout
  title="월코소개 — Word of Life Korea"
  description="복음으로 다음 세대를 세웁니다 — Word of Life Korea (월코)의 소개, 핵심 가치, 비전"
  activeNav="about"
>
<Fragment slot="head">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Gowun+Batang:wght@400;700&family=Noto+Serif+KR:wght@400;600;700&family=Playfair+Display:ital,wght@1,500&display=swap">
</Fragment>

<style>
  :root {
    --primary: #004f68; --primary-deep: #083d51; --primary-mid: #0a5b76;
    --primary-soft: rgba(0,79,104,0.08); --primary-line: rgba(0,79,104,0.13);
    --text: #152028; --muted: #5b6973; --bg: #f6f9fb; --white: #ffffff;
    --r-xl: 30px; --r-lg: 24px; --r-md: 18px; --r-sm: 12px;
    --sec-y: 112px; --sec-y-tight: 96px;
  }

  .page-wrap { max-width: 1240px; margin: 0 auto; padding: 0 24px; }

  /* ── 글꼴 — 홈 화면과 같게: 제목·숫자는 G마켓 산스, 본문은 Pretendard (편지 카드의 손글씨 느낌 글꼴은 그대로) ── */
  .section { font-family: var(--ff-sans); }
  .section-title, .history-year, .history-card h3, .vismis-card h3,
  .value-title, .value-num, .commit-card h4, .commit-num, .mi-title, .ms-title { font-family: var(--ff-serif); }

  /* ── 움직임 — 자바스크립트가 html 에 .wl-motion 을 붙일 때만 (움직임 줄이기 설정이면 붙이지 않아 처음부터 다 보인다) ── */
  /* 스크롤하면 하나씩 떠오른다 — 같은 줄의 카드는 --d 만큼 늦게 */
  :global(.wl-motion) .rv { opacity: 0; transform: translateY(32px); transition: opacity 1.2s cubic-bezier(.2,.7,.2,1), transform 1.2s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0s); }
  :global(.wl-motion) .rv.is-in { opacity: 1; transform: none; }

  /* ── 공통 섹션 ── */
  .section { padding:var(--sec-y) 24px; }
  .section--alt { background:var(--white); }
  .section--bg { background:var(--bg); }
  .section-badge {
    display:block; width:fit-content; padding:8px 15px; border-radius:999px;
    background:var(--primary-soft); color:var(--primary);
    font-size:12px; font-weight:800; letter-spacing:0.05em; margin:0 auto 18px;
  }
  .section-title {
    font-size:40px; font-weight:800; line-height:1.22;
    letter-spacing:-0.035em; color:#0f1b22; margin-bottom:18px; text-align:center;
  }
  .section-desc { font-size:17px; line-height:1.9; color:var(--muted); max-width:720px; margin:0 auto; text-align:center; }

  /* ── WHO WE ARE 타이틀 강조 ── */
  .who-title .accent {
    display:block; margin-top:6px;
    background:linear-gradient(90deg, #004f68 0%, #0a5b76 55%, #16a8d8 100%);
    -webkit-background-clip:text; background-clip:text; color:transparent;
  }
  .who-title-rule { width:64px; height:5px; margin:22px auto 0; border-radius:99px; background:linear-gradient(90deg, #004f68, #73d1f5); }

  /* ── 봉투 → 편지 (스크롤) ── */
  .intro-single-wrap { position:relative; isolation:isolate; }
  .letter-anim { position:relative; z-index:2; transform-origin:50% 0; will-change:transform, clip-path; }
  .env { display:none; position:absolute; pointer-events:none; }
  .intro-single-wrap.is-anim .env { display:block; }
  .env-back, .env-front, .env-flap { position:absolute; opacity:var(--env-o,1); translate:0 var(--env-y,0px); }
  .env-back { inset:0; z-index:1; border-radius:8px; background:linear-gradient(180deg,#e7d8b4,#dcc99f); box-shadow:0 30px 50px -26px rgba(70,45,10,0.5), 0 0 0 1px rgba(150,115,60,0.25); }
  .env-front { inset:0; z-index:3; border-radius:8px; background:linear-gradient(180deg,#f6ecd5,#efe1c0); clip-path:polygon(0 0,50% 56%,100% 0,100% 100%,0 100%); }
  .env-front svg { position:absolute; inset:0; width:100%; height:100%; }
  .env-flap { left:0; right:0; top:0; height:56%; z-index:4; transform-origin:50% 0; transform:perspective(1100px) rotateX(calc(var(--flap,0) * -1deg)); background:linear-gradient(180deg,#f3e7ca,#e9d8b2); clip-path:polygon(0 0,100% 0,50% 100%); }
  .env.flap-open .env-flap { z-index:0; background:linear-gradient(0deg,#d9c698,#cdb88a); }
  .env-seal { position:absolute; z-index:5; left:50%; top:56%; width:54px; height:54px; margin:-27px 0 0 -27px; border-radius:50%; background:#fff url('/images/WOLKO%20Circle.png') center/38px no-repeat; border:3px solid #f6ecd5; box-shadow:0 8px 16px -6px rgba(0,79,104,0.5), 0 0 0 1px rgba(0,79,104,0.18); opacity:var(--seal-o,1); translate:0 var(--env-y,0px); }
  @media (max-width:640px) { .env-seal { width:44px; height:44px; margin:-22px 0 0 -22px; background-size:30px; } }
  /* ── INTRO: 초청장 같은 편지 ── */
  .intro-single-wrap { max-width:860px; margin:76px auto 0; }
  .intro-card {
    --paper:#fffdf8; --ink:#34444c; --teal:#004f68;
    position:relative; padding:76px 64px 52px; border-radius:6px;
    background:
      radial-gradient(120% 90% at 0% 0%, rgba(115,209,245,0.10) 0%, transparent 55%),
      radial-gradient(100% 80% at 100% 100%, rgba(240,200,140,0.14) 0%, transparent 55%),
      var(--paper);
    border:1px solid rgba(60,70,60,0.10);
    box-shadow:0 1px 0 rgba(255,255,255,0.9) inset, 0 28px 60px -22px rgba(16,32,40,0.22), 0 6px 16px rgba(16,32,40,0.06);
    transform:rotate(-0.35deg); transition:transform .35s ease, box-shadow .35s ease;
    font-family:'Noto Serif KR', 'Nanum Myeongjo', serif;
  }
  .intro-card:hover { transform:rotate(0deg) translateY(-3px); box-shadow:0 1px 0 rgba(255,255,255,0.9) inset, 0 34px 70px -22px rgba(16,32,40,0.26), 0 8px 20px rgba(16,32,40,0.07); }
  /* 편지지의 안쪽 테두리 */
  .intro-card::before { content:""; position:absolute; inset:14px; border:1px solid rgba(0,79,104,0.20); border-radius:2px; pointer-events:none; }
  /* 위쪽 가운데: 밀랍 도장처럼 찍힌 월코 로고 */
  .intro-card::after { content:""; position:absolute; top:-34px; left:50%; width:68px; height:68px; margin-left:-34px; border-radius:50%; background:#fff url('/images/WOLKO%20Circle.png') center/46px no-repeat; border:3px solid #fffdf8; box-shadow:0 10px 22px -6px rgba(0,79,104,0.45), 0 0 0 1px rgba(0,79,104,0.18); pointer-events:none; }
  .intro-card > * { position:relative; z-index:1; }
  .intro-greet { margin:0 0 26px; font-size:21px; font-weight:600; color:var(--teal); letter-spacing:-0.01em; }
  .intro-card p:not(.intro-greet) { font-size:17.5px; line-height:2.15; color:var(--ink); word-break:keep-all; }
  .intro-card p + p { margin-top:18px; }
  .intro-closing { margin-top:34px !important; font-size:16.5px !important; color:#5b6c75 !important; font-style:normal; }
  .intro-card-sig { margin-top:10px; display:flex; flex-direction:column; align-items:flex-end; gap:4px; color:var(--teal); }
  .intro-sign-name { font-family:'Playfair Display', 'Gowun Batang', 'Noto Serif KR', serif; font-style:italic; font-weight:500; font-synthesis:none; font-size:34px; line-height:1.25; letter-spacing:.005em; color:#0a4c63; transform:rotate(-2deg); transform-origin:right bottom; }
  .intro-sign-name .wl-ko { font-family:'Playfair Display', 'Gowun Batang', 'Noto Serif KR', serif; }
  .intro-sign-line { width:150px; height:2px; border-radius:2px; background:linear-gradient(90deg, transparent, rgba(0,79,104,0.45)); }
  .intro-sign-small { font:600 11px/1 Montserrat, sans-serif; letter-spacing:.2em; color:#7b8e98; }

  /* ── HISTORY ── */
  .history-grid { max-width:1240px; margin:56px auto 0; display:grid; grid-template-columns:1fr 1fr; gap:20px; }
  .history-card { position:relative; border-radius:var(--r-xl); padding:44px 40px; overflow:hidden; display:flex; flex-direction:column; gap:16px; }
  .history-card--camp { background:linear-gradient(145deg, #0a5b76 0%, #004f68 100%); box-shadow:0 24px 56px rgba(0,79,104,0.22); }
  .history-card--institute { background:linear-gradient(145deg, #083d51 0%, #052b3a 100%); box-shadow:0 24px 56px rgba(5,43,58,0.24); }
  .history-card::before { content:""; position:absolute; right:-60px; bottom:-60px; width:240px; height:240px; border-radius:50%; background:rgba(255,255,255,0.06); }
  .history-card > * { position:relative; z-index:1; }
  .history-year { font-size:56px; font-weight:900; letter-spacing:-0.05em; color:rgba(255,255,255,0.18); line-height:1; }
  .history-tag { font-size:11px; font-weight:800; letter-spacing:0.1em; color:rgba(255,255,255,0.55); }
  .history-card h3 { font-size:26px; font-weight:800; letter-spacing:-0.03em; color:#fff; line-height:1.25; }
  .history-card p { font-size:15px; line-height:1.88; color:rgba(255,255,255,0.76); }

  /* ── CORE VALUES ── */
  .values-grid { max-width:1240px; margin:56px auto 0; display:grid; grid-template-columns:repeat(6, minmax(0,1fr)); gap:18px; }
  .value-card { grid-column:span 2; }
  .value-card:nth-child(n+4) { grid-column:span 3; }
  .value-card {
    background:#f6f9fb; border:1px solid var(--primary-line); border-radius:var(--r-lg);
    padding:34px 32px 36px; display:flex; flex-direction:column; gap:12px;
    transition:transform .22s, background .22s, box-shadow .22s, border-color .22s;
    cursor:default; position:relative; overflow:hidden;
  }
  .value-card::after { content:""; position:absolute; right:-24px; bottom:-32px; width:100px; height:100px; border-radius:50%; background:rgba(0,79,104,0.05); transition:transform .22s; }
  .value-card:hover { background:linear-gradient(180deg, #0a5b76 0%, #004f68 100%); border-color:transparent; box-shadow:0 20px 48px rgba(0,79,104,0.22); transform:translateY(-5px); }
  .value-card:hover::after { transform:scale(1.3); }
  .value-card:hover .value-num { color:#73d1f5; transform:scale(1.05); }
  .value-card:hover .value-title, .value-card:hover .value-desc { color:#fff; }
  .value-card:hover .value-desc { color:rgba(255,255,255,0.82); }
  .value-num { font:800 56px/1 var(--ff-serif); letter-spacing:-0.04em; color:var(--primary); transition:color .22s, transform .3s; position:relative; z-index:1; margin-bottom:8px; transform-origin:left bottom; }
  .value-title { font-size:22px; font-weight:800; letter-spacing:-0.02em; color:#102028; line-height:1.3; transition:color .22s; position:relative; z-index:1; }
  .value-desc { font-size:15px; line-height:1.8; color:var(--muted); transition:color .22s; position:relative; z-index:1; }

  /* ── VISION & MISSION ── */
  .vismis-inner { max-width:1240px; margin:0 auto; }
  .vismis-grid { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:56px; }
  .vismis-card { position:relative; border-radius:var(--r-xl); padding:48px 40px; overflow:hidden; display:flex; flex-direction:column; gap:14px; }
  .vismis-card--vision { background:linear-gradient(145deg, #0a5b76 0%, #004f68 100%); box-shadow:0 24px 56px rgba(0,79,104,0.22); }
  .vismis-card--mission { background:linear-gradient(145deg, #1a4a3a 0%, #0f3328 100%); box-shadow:0 24px 56px rgba(15,51,40,0.22); }
  .vismis-card::before { content:""; position:absolute; right:-60px; bottom:-60px; width:240px; height:240px; border-radius:50%; background:rgba(255,255,255,0.06); }
  .vismis-card > * { position:relative; z-index:1; }
  .vismis-card-num { font-size:11px; font-weight:800; letter-spacing:0.1em; color:rgba(255,255,255,0.5); }
  .vismis-card h3 { font-size:28px; font-weight:800; letter-spacing:-0.03em; color:#fff; line-height:1.2; }
  .vismis-card p { font-size:16px; line-height:1.85; color:rgba(255,255,255,0.78); }

  /* ── COMMITMENTS ── */
  .commit-inner { max-width:980px; margin:56px auto 0; }
  .commit-grid { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  /* 번호는 왼쪽에 크게, 제목과 설명은 오른쪽에. 마우스를 올리면 진한 청록 카드로 바뀌고 번호는 하늘색으로 굵어진다 */
  .commit-card { background:var(--white); border:1px solid var(--primary-line); border-radius:var(--r-lg); padding:34px 32px; display:grid; grid-template-columns:84px minmax(0,1fr); column-gap:24px; row-gap:8px; align-content:center; box-shadow:0 8px 24px rgba(16,32,40,0.05); transition:transform .22s, box-shadow .22s, border-color .22s, background .22s; position:relative; overflow:hidden; }
  .commit-card::before { content:""; position:absolute; top:-72px; right:-64px; width:180px; height:180px; border-radius:50%; background:radial-gradient(circle, rgba(115,209,245,0.17) 0%, rgba(115,209,245,0) 70%); pointer-events:none; transition:transform .3s, opacity .3s; }
  .commit-card:hover { transform:translateY(-4px); background:linear-gradient(180deg, #0a5b76 0%, #004f68 100%); border-color:transparent; box-shadow:0 20px 48px rgba(0,79,104,0.22); }
  .commit-card:hover::before { transform:scale(1.3); opacity:.9; }
  .commit-card > * { position:relative; z-index:1; }
  .commit-num { grid-row:1 / span 3; align-self:start; font:800 58px/1 var(--ff-serif); letter-spacing:-0.04em; background:linear-gradient(160deg, var(--primary) 0%, #4cc1e6 100%); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; transition:transform .3s; transform-origin:left top; }
  .commit-card:hover .commit-num { background:none; -webkit-text-fill-color:#73d1f5; transform:scale(1.06); }
  .commit-card h4 { grid-column:2; font-size:20px; font-weight:800; letter-spacing:-0.01em; color:#102028; line-height:1.35; transition:color .22s; }
  .commit-card p { grid-column:2; font-size:14.5px; line-height:1.85; color:var(--muted); transition:color .22s; }
  .commit-card:hover h4 { color:#fff; }
  .commit-card:hover p { color:rgba(255,255,255,0.84); }

  /* ── MINISTRIES: 왼쪽 목록에서 고르면 오른쪽 큰 사진이 그 사역으로 바뀐다 ── */
  .ministry-inner { max-width:1240px; margin:0 auto; display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); gap:72px; }
  .ministry-side { display:flex; flex-direction:column; }
  .ministry-head .section-badge { margin-left:0; }
  .ministry-head .section-title, .ministry-head .section-desc { text-align:left; margin-left:0; }
  .ministry-head .section-desc { font-size:16px; line-height:1.8; }
  .ministry-list { list-style:none; margin:40px 0 0; padding:0; border-top:1px solid #cdd7dc; }
  .ministry-list li { position:relative; border-bottom:1px solid #cdd7dc; }
  /* 지금 보이는 사역의 밑줄 — 저절로 넘어가는 동안은 천천히 차오르고, 다 차면 다음 사역으로 */
  .ministry-list li::after { content:""; position:absolute; left:0; right:0; bottom:-1px; height:2px; background:var(--primary); transform:scaleX(0); transform-origin:left; }
  .ministry-list li.is-active::after { transform:scaleX(1); }
  .ministry-list.is-auto li.is-active::after { animation:miFill 6s linear both; }
  @keyframes miFill { from { transform:scaleX(0); } to { transform:scaleX(1); } }
  .mi { display:grid; grid-template-columns:44px minmax(0,1fr) 18px; gap:0 8px; align-items:center; padding:22px 0; color:#3c4f58; text-decoration:none; transition:color .3s; }
  .mi-num { font:700 14px/1 var(--ff-serif); color:#8a9aa2; transition:color .3s; }
  .mi-title { font-size:21px; font-weight:700; letter-spacing:-0.02em; line-height:1.35; }
  .mi-arrow { width:16px; height:16px; color:var(--primary); opacity:0; transform:translateX(-8px); transition:opacity .3s, transform .3s; }
  .mi:hover, .is-active .mi { color:var(--primary); }
  .is-active .mi-num { color:var(--primary); }
  .is-active .mi-arrow { opacity:1; transform:none; }
  .mi-thumb, .mi-tag, .mi-desc { display:none; }   /* 모바일 목록에서만 쓴다 */

  .ministry-stage { position:relative; min-height:560px; overflow:hidden; background:#0b1e27; }
  .ms { position:absolute; inset:0; opacity:0; visibility:hidden; transition:opacity .9s, visibility 0s .9s; }
  .ms.is-active { opacity:1; visibility:visible; transition:opacity .9s; }
  .ms img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; display:block; }
  .ms::after { content:""; position:absolute; left:0; right:0; bottom:0; height:62%; background:linear-gradient(0deg, rgba(5,20,28,0.86) 0%, rgba(5,20,28,0) 100%); }
  .ms-cap { position:absolute; left:44px; right:44px; bottom:40px; z-index:1; display:flex; justify-content:space-between; align-items:flex-end; gap:40px; color:#fff; }
  .ms-tag { font-size:12px; font-weight:700; letter-spacing:0.14em; color:rgba(255,255,255,0.78); }
  .ms-title { margin-top:10px; font-size:30px; font-weight:700; letter-spacing:-0.02em; line-height:1.3; color:#fff; }
  .ms-desc { margin-top:12px; max-width:420px; font-size:15.5px; line-height:1.75; color:rgba(255,255,255,0.86); }
  .ms-more { flex:none; height:48px; padding:0 20px; display:inline-flex; align-items:center; gap:12px; background:#fff; color:var(--primary); border-radius:2px; font-size:14px; font-weight:700; text-decoration:none; transition:gap .25s, background .25s; }
  .ms-more:hover { gap:16px; background:#eef6f9; color:var(--primary); }
  .ms-more svg { width:14px; height:14px; }
  /* 사진이 바뀔 때 — 사진은 살짝 당겨지며 자리 잡고, 글은 아래에서 차례로 올라온다 */
  :global(.wl-motion) .ms img { transform:scale(1.07); transition:transform 2.6s cubic-bezier(.2,.7,.2,1); }
  :global(.wl-motion) .ms.is-active img { transform:none; }
  :global(.wl-motion) .ms-cap > * > *, :global(.wl-motion) .ms-more { opacity:0; transform:translateY(18px); transition:opacity .8s cubic-bezier(.2,.7,.2,1), transform .8s cubic-bezier(.2,.7,.2,1), gap .25s, background .25s; }
  :global(.wl-motion) .ms.is-active .ms-cap > * > *, :global(.wl-motion) .ms.is-active .ms-more { opacity:1; transform:none; }
  :global(.wl-motion) .ms.is-active .ms-tag { transition-delay:.25s; }
  :global(.wl-motion) .ms.is-active .ms-title { transition-delay:.4s; }
  :global(.wl-motion) .ms.is-active .ms-desc { transition-delay:.55s; }
  :global(.wl-motion) .ms.is-active .ms-more { transition-delay:.7s, .7s, 0s, 0s; }

  /* ── 반응형 ── */
  @media (max-width:1050px) {
