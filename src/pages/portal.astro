    const svgi = (name, size) => '<svg width="' + (size || 18) + '" height="' + (size || 18) + '" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + DI[name] + '</svg>';
    function dashLocale() { return hubLang === 'en' ? 'en-US' : 'ko-KR'; }
    /** 날짜 조각 — 종일 일정은 'YYYY-MM-DD' 그대로, 시간 일정은 한국 시간 기준 */
    function kstParts(value, allDay) {
      const d = allDay ? new Date(value + 'T12:00:00+09:00') : new Date(typeof value === 'number' ? value : value);
      const f = (opts) => new Intl.DateTimeFormat(dashLocale(), Object.assign({ timeZone: KST }, opts)).format(d);
      const ymd = new Intl.DateTimeFormat('en-CA', { timeZone: KST, year: 'numeric', month: '2-digit', day: '2-digit' }).format(d);
      // 한국어의 '26일' 같은 단위가 붙지 않도록 숫자는 날짜 문자열에서 직접 꺼낸다
      return { ymd, month: hubLang === 'en' ? f({ month: 'short' }) : String(Number(ymd.slice(5, 7))), day: String(Number(ymd.slice(8, 10))), weekday: f({ weekday: 'short' }) };
    }
    function fmtTime(iso) {
      return new Intl.DateTimeFormat(dashLocale(), { timeZone: KST, hour: 'numeric', minute: '2-digit', hour12: hubLang === 'en' }).format(new Date(iso));
    }
    function daysBetween(fromYmd, toYmd) { return Math.round((Date.parse(toYmd + 'T00:00:00Z') - Date.parse(fromYmd + 'T00:00:00Z')) / 86400000); }
    function relDay(ms, today) {
      const n = daysBetween(kstParts(ms).ymd, today);
      return n <= 0 ? t('relToday') : n === 1 ? t('relYesterday') : t('relDaysAgo', n);
    }
    function dashCard(cls, color, icon, title, bodyHtml, href) {
      return '<section class="hub-dcard ' + cls + '" style="--dc:' + color + '"><div class="hub-dcard-head"><span class="hub-dicon">' + svgi(icon, 17) + '</span><h2>' + esc(title) + '</h2>'
        + (href ? '<a class="hub-dcard-more" href="' + href + '" title="' + esc(t('dashMore')) + '" aria-label="' + esc(t('dashMore')) + '">' + svgi('chev', 16) + '</a>' : '') + '</div><div class="hub-dbody">' + bodyHtml + '</div></section>';
    }
    function dashEmpty(icon, text, sub) {
      return '<div class="hub-dempty"><span class="hub-dempty-ic">' + svgi(icon, 22) + '</span><p>' + esc(text) + '</p>' + (sub ? '<small>' + esc(sub) + '</small>' : '') + '</div>';
    }
    function chips(names) { return names.map(n => '<span class="hub-chip">' + esc(n) + '</span>').join(''); }
    /** 이미 esc() 한 글에서 http(s):// · www. 주소를 새 탭으로 열리는 링크로 바꾼다 (끝의 마침표·괄호 등은 링크에서 뺀다) */
    function linkify(escaped) {
      return escaped.replace(/\b((?:https?:\/\/|www\.)[A-Za-z0-9\-._~:\/?#\[\]@!$&'()*+,;=%]+)/g, function (m) {
        const tail = (/(?:&quot;|&#39;|&gt;|&lt;|[.,;:!?)\]'])+$/.exec(m) || [''])[0];
        const url = tail ? m.slice(0, m.length - tail.length) : m;
        if (!url) return m;
        const href = /^www\./i.test(url) ? 'https://' + url : url;
        return '<a class="hub-link" href="' + href + '" target="_blank" rel="noopener noreferrer">' + url + '</a>' + tail;
      });
    }
    /** 마감일 표시 — D-3 · D-Day · D+2(지남) 와 "11/1까지" */
    function dueChip(due, today) {
      if (!due || !/^\d{4}-\d{2}-\d{2}$/.test(due)) return '';
      const n = daysBetween(today, due);
      const label = n === 0 ? t('dueToday') : n > 0 ? 'D-' + n : 'D+' + (-n);
      const md = Number(due.slice(5, 7)) + '/' + Number(due.slice(8, 10));
      const tone = n < 0 ? ' is-over' : n <= 3 ? ' is-soon' : '';
      return '<span class="hub-due' + tone + '"><b>' + esc(label) + '</b><small>' + esc(t('dueUntil', md)) + '</small></span>';
    }
    function renderNotices(d) {
      const list = d.notices;
      const form = d.canEditNotices ? '<details class="hub-notice-form"><summary>+ ' + esc(t('noticeAdd')) + '</summary>'
        + '<input id="noticeTitle" type="text" maxlength="60" placeholder="' + esc(t('noticeTitlePh')) + '">'
        + '<textarea id="noticeBody" rows="3" maxlength="600" placeholder="' + esc(t('noticeBodyPh')) + '"></textarea>'
        + '<label class="hub-notice-due"><span>' + esc(t('noticeDue')) + '</span><input id="noticeDue" type="date" aria-label="' + esc(t('noticeDue')) + '"></label>'
        + '<div class="hub-notice-opts"><select id="noticeWeek"><option value="this">' + esc(t('noticeThisWeek')) + '</option><option value="next">' + esc(t('noticeNextWeek')) + '</option></select>'
        + '<label><input id="noticePinned" type="checkbox"> ' + esc(t('noticePin')) + '</label>'
        + '<button type="button" id="noticePostBtn">' + esc(t('noticePost')) + '</button></div></details>' : '';
      let body;
      if (list === null) body = dashEmpty('bell', t('dashLoadFail'));
      else if (!list.length) body = dashEmpty('bell', t('dashNoticeEmpty'), d.canEditNotices ? '' : t('dashNoticeHint'));
      else body = '<ul class="hub-notices">' + list.map(n => '<li' + (n.pinned ? ' class="is-pinned"' : '') + '>'
        + '<div class="hub-notice-top">' + (n.pinned ? '<span class="hub-pin">' + svgi('pin', 11) + esc(t('noticePinned')) + '</span>' : '') + (n.title ? '<b>' + esc(n.title) + '</b>' : '') + dueChip(n.dueDate, d.today) + '</div>'
        + '<p>' + linkify(esc(n.body)).replace(/\n/g, '<br>') + '</p>'
        + (d.canEditNotices ? '<button type="button" class="hub-notice-del" data-del="' + esc(n.id) + '">' + esc(t('noticeDelete')) + '</button>' : '')
        + '</li>').join('') + '</ul>';
      return dashCard('hub-dcard-notice', '#f0a020', 'bell', t('dashNotices'), body + form);
    }
    /** 카드 오른쪽 아래 작은 그림 — 김이 나는 냄비(키친 듀티), 바퀴가 구르는 차(차량 운행). CSS 애니메이션만 쓰고 움직임 줄이기 설정이면 멈춘다 */
    const KITCHEN_DECO = '<span class="hub-deco hub-deco-pot" aria-hidden="true"><i></i><i></i><i></i><svg width="54" height="38" viewBox="0 0 54 38" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path class="hub-pot-lid" d="M12 9h30M27 9V6"/><path d="M9 14h36v9a10 10 0 0 1-10 10H19A10 10 0 0 1 9 23z" fill="color-mix(in srgb, currentColor 14%, #fff)"/><path d="M4 17h5M45 17h5"/></svg></span>';
    const CAR_DECO = '<span class="hub-deco hub-deco-car" aria-hidden="true"><i></i><i></i><svg width="54" height="38" viewBox="0 0 54 38" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><g class="hub-car-body"><path d="M5 25v-6a3 3 0 0 1 2.2-2.9l6.3-1.7 5-6.4A3 3 0 0 1 21 7h12a3 3 0 0 1 2.4 1.2L40 14l5 1.6A3 3 0 0 1 47 18.5V25a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2z" fill="color-mix(in srgb, currentColor 14%, #fff)"/><path d="M17.5 14.5 21 10h11l3.5 4.5z"/><g transform="translate(15 27)"><g class="hub-wheel"><circle r="4.5" fill="#fff"/><path d="M0-2.5v5M-2.5 0h5"/></g></g><g transform="translate(38 27)"><g class="hub-wheel"><circle r="4.5" fill="#fff"/><path d="M0-2.5v5M-2.5 0h5"/></g></g></g></svg></span>';
    function renderKitchen(d) {
      let body;
      if (d.kitchen === null) body = dashEmpty('utensils', t('dashLoadFail'));
      else if (!d.kitchen.length) body = dashEmpty('utensils', t('dashKitchenEmpty'));
      else body = '<ul class="hub-meals">' + d.kitchen.map(m => '<li><span class="hub-meal hub-meal-' + m.meal + '">' + esc(t(m.meal === 'am' ? 'mealAm' : m.meal === 'lunch' ? 'mealLunch' : 'mealDinner')) + '</span><div class="hub-meal-rows">'
        + (m.prep.length ? '<div><em>' + esc(t('slotPrep')) + '</em>' + chips(m.prep) + '</div>' : '')
        + (m.clean.length ? '<div><em>' + esc(t('slotClean')) + '</em>' + chips(m.clean) + '</div>' : '') + '</div></li>').join('') + '</ul>';
      return dashCard('hub-dcard-kitchen hub-dcard-compact', '#e8913a', 'utensils', t('dashKitchen'), body + KITCHEN_DECO, '/portal/kitchen');
    }
    function renderCar(d) {
      let body;
      if (d.car === null) body = dashEmpty('car', t('dashLoadFail'));
      else if (!d.car.pickup && !d.car.dropoff && !(d.car.closed && (d.car.closed.pickup || d.car.closed.dropoff))) body = dashEmpty('car', t('dashCarEmpty'));
      else {
        const row = (icon, label, who, closed) => '<li><span class="hub-run-ic">' + svgi(icon, 15) + '</span><span class="hub-run-label">' + esc(label) + '</span>'
          + (who ? '<span class="hub-chip hub-chip-strong">' + esc(who) + '</span>' : closed ? '<span class="hub-unset hub-closed">' + esc(t('dashClosed')) + '</span>' : '<span class="hub-unset">' + esc(t('dashUnset')) + '</span>') + '</li>';
        body = '<ul class="hub-runs">' + row('up', t('carPickup'), d.car.pickup, d.car.closed && d.car.closed.pickup) + row('down', t('carDropoff'), d.car.dropoff, d.car.closed && d.car.closed.dropoff) + '</ul>';
      }
      return dashCard('hub-dcard-car hub-dcard-compact', '#c24fd6', 'car', t('dashCar'), body + CAR_DECO, '/portal/car-drive');
    }
    function renderEvents(d) {
      let body;
      if (d.events === null) body = dashEmpty('calendar', t('dashEventsOff'));
      else if (!d.events.length) body = dashEmpty('calendar', t('dashEventsEmpty'));
      else body = '<ul class="hub-events">' + d.events.map(e => {
        const p = kstParts(e.start, e.allDay), isToday = p.ymd === d.today;
        const when = e.allDay ? '<span class="hub-tag">' + esc(t('allDay')) + '</span>' : '<span class="hub-time">' + esc(fmtTime(e.start)) + '</span>';
        return '<li' + (isToday ? ' class="is-today"' : '') + '><span class="hub-datetile"><small>' + esc(p.month + (hubLang === 'en' ? '' : '월')) + '</small><b>' + esc(p.day) + '</b><i>' + esc(p.weekday) + '</i></span>'
          + '<span class="hub-event-text"><b>' + esc(e.title) + (isToday ? ' <span class="hub-today-chip">' + esc(t('dashTodayChip')) + '</span>' : '') + '</b>'
          + '<small>' + when + (e.location ? '<span class="hub-loc">' + esc(e.location) + '</span>' : '') + '</small></span></li>';
      }).join('') + '</ul>';
      return dashCard('hub-dcard-events', '#3b8ff0', 'calendar', t('dashEvents'), body, '/portal/schedule');
    }
    /** CRS 12단계 이름 — src/pages/portal/crs/index.astro 의 STEPS / STEPS_KO 와 같은 순서 (카드에서 보기 좋게 줄였다) */
    const CRS_STEPS = {
      ko: ['목사님께 전화 또는 대화', '목사님 방문', '사역 소개 프레젠테이션', '복음 대화 훈련', '청소년 캠프 · 이벤트 참여', '리더 훈련 (Core Training)', '교회의 WOLKO 커리큘럼 사용', '선교사 교회 예배 설교', '후원 요청(God Ask) 프레젠테이션', '선물 전달 · 감사 표현', '교회의 WOLKO 후원', '타 교회에 WOLKO 소개'],
      en: ['Called or talked to pastor', 'Visited pastor', 'Ministry presentation', 'Gospel Conversation Training', 'Youth at camp or event', 'Core Training', 'Uses WOLKO curriculum', 'Missionary speaks at service', '\u201cGod Ask\u201d presentation', 'Gift / thank you', 'Church supports WOLKO', 'Introduces WOLKO to other churches'],
    };
    /** 마우스를 올리거나 키보드로 들어가면 보이는 교회 세부 카드 — 담임목사, 완료한 단계, 다음 추천 단계 */
    function churchPop(c, today) {
      const names = CRS_STEPS[hubLang] || CRS_STEPS.ko;
      const done = c.done || [];
      const stepRow = n => '<li><span class="hub-pop-n">' + n + '</span><span>' + esc(names[n - 1] || '') + '</span></li>';
      const track = '<ol class="hub-pop-track" aria-hidden="true">' + names.map((_, i) => '<li style="--i:' + i + '" class="' + (done.includes(i + 1) ? 'is-done' : i + 1 === c.next ? 'is-next' : '') + '">' + (i + 1) + '</li>').join('') + '</ol>';
      const recent = done.slice(-4).reverse();
      const doneHtml = done.length
        ? '<ul class="hub-pop-steps">' + recent.map(stepRow).join('') + (done.length > recent.length ? '<li class="hub-pop-more">' + esc(t('churchMore', done.length - recent.length)) + '</li>' : '') + '</ul>'
        : '<p class="hub-pop-none">' + esc(t('churchNoneYet')) + '</p>';
      const nextHtml = c.next
        ? '<ul class="hub-pop-steps hub-pop-next">' + stepRow(c.next) + '</ul>'
        : '<p class="hub-pop-none">' + esc(t('churchAllDone')) + '</p>';
      const pastor = c.pastor ? '<span class="hub-pop-pastor">' + esc(/목사|pastor/i.test(c.pastor) ? c.pastor : c.pastor + ' (' + t('churchPastorTitle') + ')') + '</span>' : '';
      const rows = [
        c.lastVisitDate ? [t('churchLastVisit'), esc(c.lastVisitDate) + (c.visitor ? ' · ' + esc(c.visitor) : '')] : null,
        [t('churchUpdated'), esc(kstParts(c.updatedAt).ymd) + ' (' + esc(relDay(c.updatedAt, today)) + ')'],
      ].filter(Boolean);
      return '<div class="hub-church-pop" role="tooltip"><div class="hub-pop-head"><b>' + esc(c.name) + '</b>' + (pastor ? '<span class="hub-pop-sep">|</span>' + pastor : '') + '</div>'
        + '<p class="hub-pop-label">' + esc(t('churchProgress')) + ' · ' + esc(t('churchStepsOf', done.length)) + '</p>' + track
        + '<p class="hub-pop-label">' + esc(t('churchDone')) + '</p>' + doneHtml
        + '<p class="hub-pop-label hub-pop-label-next">' + esc(t('churchNext')) + '</p>' + nextHtml
        + '<dl>' + rows.map(r => '<div><dt>' + esc(r[0]) + '</dt><dd>' + r[1] + '</dd></div>').join('') + '</dl></div>';
    }
    function renderChurches(d) {
      let body;
      if (d.churches === null) body = dashEmpty('church', t('dashChurchesOff'));
      else if (!d.churches.length) body = dashEmpty('church', t('dashChurchesEmpty'));
      else body = '<ul class="hub-churches">' + d.churches.map(c => '<li tabindex="0"><span class="hub-avatar">' + esc(Array.from(c.name)[0] || '') + '</span><span class="hub-church-text"><b>' + esc(c.name) + '</b>'
        + '<small>' + esc(t('churchUpdated')) + ' ' + esc(relDay(c.updatedAt, d.today)) + (c.lastVisitDate ? ' · ' + esc(t('churchVisited')) + ' ' + esc(c.lastVisitDate) : '') + '</small></span>' + churchPop(c, d.today) + '</li>').join('') + '</ul>';
      return dashCard('hub-dcard-churches', '#7b61e6', 'church', t('dashChurches'), body, '/portal/crs');
    }
    function renderDashHead(d) {
      const p = kstParts(d.today, true);
      const full = new Intl.DateTimeFormat(dashLocale(), { timeZone: KST, year: 'numeric', month: 'long', day: 'numeric', weekday: 'long' }).format(new Date(d.today + 'T12:00:00+09:00'));
      const short = ymd => { const q = kstParts(ymd, true); return hubLang === 'en' ? q.month + ' ' + q.day : q.month + '/' + q.day; };
      const end = new Date(Date.parse(d.weekStart + 'T00:00:00Z') + 6 * 86400000).toISOString().slice(0, 10);
      return '<div class="hub-dash-date"><span class="hub-dash-date-ic">' + svgi('calendar', 15) + '</span><b>' + esc(full) + '</b><span>' + esc(t('dashWeekOf', short(d.weekStart), short(end))) + '</span></div>';
    }
    function renderDash() {
      const el = $('hubDash');
      if (!el) return;
      if (!dashData) { el.innerHTML = dashFailed ? '<div class="hub-dcard hub-dcard-wide">' + dashEmpty('bell', t('dashLoadFail')) + '</div>' : ''; return; }
      // 공지를 쓰다가 언어를 바꿔도 입력한 내용은 남긴다
      const keep = { title: $('noticeTitle')?.value || '', body: $('noticeBody')?.value || '', due: $('noticeDue')?.value || '', open: $('hubDash').querySelector('.hub-notice-form')?.open };
      el.innerHTML = renderDashHead(dashData) + renderNotices(dashData) + renderEvents(dashData) + renderKitchen(dashData) + renderCar(dashData) + renderChurches(dashData);
      if ($('noticeTitle')) { $('noticeTitle').value = keep.title; $('noticeBody').value = keep.body; if ($('noticeDue')) $('noticeDue').value = keep.due; if (keep.open) el.querySelector('.hub-notice-form').open = true; }
    }
    async function loadDashboard() {
      const token = sessionStorage.getItem('wolko-hub-token');
      if (!token) return;
      try {
        const res = await fetch('/api/portal/dashboard', { headers: { 'Authorization': 'Bearer ' + token }, cache: 'no-store' });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        dashData = await res.json();
        dashFailed = false;
      } catch (e) { dashFailed = !dashData; }
      renderDash();
    }
    document.addEventListener('click', async e => {
      const del = e.target.closest && e.target.closest('.hub-notice-del');
      if (del) {
        if (!confirm(t('noticeDeleteConfirm'))) return;
        const res = await fetch('/api/portal/notices?id=' + encodeURIComponent(del.dataset.del), { method: 'DELETE', headers: authHeaders() });
        if (res.ok) { showToast(t('noticeDeleted')); loadDashboard(); } else showToast((await res.json().catch(() => ({}))).error || t('dashLoadFail'), true);
        return;
      }
      if (e.target.id === 'noticePostBtn') {
        const body = $('noticeBody').value.trim();
        if (!body) { showToast(t('noticeNeedBody'), true); return; }
        const btn = e.target; btn.disabled = true;
        try {
          const res = await fetch('/api/portal/notices', { method: 'POST', headers: authHeaders(), body: JSON.stringify({ title: $('noticeTitle').value, body, week: $('noticeWeek').value, dueDate: $('noticeDue').value, pinned: $('noticePinned').checked }) });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || t('dashLoadFail'));
          showToast(t('noticePosted'));
          $('noticeTitle').value = ''; $('noticeBody').value = ''; $('noticeDue').value = '';
          await loadDashboard();
        } catch (err) { showToast(err.message, true); }
        btn.disabled = false;
      }
    });

    function renderGrid() {
      let lastHref = '';
      try { lastHref = localStorage.getItem('wolko-hub-last') || ''; } catch (e) {}
      const card = tool => `
        <a class="hub-card" href="${tool.href}" style="--tool-color:${tool.color}" onclick="markVisited('${tool.href}')">
          <span class="hub-card-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">${ICONS[tool.icon] || ''}</svg>
          </span>
          <span class="hub-card-body">
            <span class="hub-card-title-row">
              <p class="hub-card-title">${hubLang === 'en' ? tool.title_en : tool.title_ko}</p>
              ${tool.href === lastHref ? `<span class="hub-card-badge">${t('recentBadge')}</span>` : ''}
            </span>
            <p class="hub-card-desc">${hubLang === 'en' ? tool.desc_en : tool.desc_ko}</p>
          </span>
          <span class="hub-card-arrow">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M6 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </a>`;
      $('hubGrid').innerHTML = GROUPS.map(g => `
        <section class="hub-group">
          <p class="hub-group-label">${hubLang === 'en' ? g.en : g.ko}</p>
          <div class="hub-grid">${TOOLS.filter(x => x.group === g.id).map(card).join('')}</div>
        </section>
      `).join('');
    }

    /* 경비 리포트 알림 배지 — 메일 대신 포탈에서 확인 (승인 대기 / 송금 대기 / 내 리포트 결과) */
    async function loadExpenseBadge() {
      const token = sessionStorage.getItem('wolko-hub-token');
      if (!token) return;
      try {
        const res = await fetch('/api/expense/reports?scope=counts', { headers: { 'Authorization': 'Bearer ' + token } });
        if (!res.ok) return;
        const c = await res.json();
        let seen = 0; try { seen = Number(localStorage.getItem('wolko-expense-seen')) || 0; } catch (e) {}
        const unseen = (c.alerts || []).filter(a => new Date(a.at).getTime() > seen).length;
        const n = (c.approve || 0) + (c.accounting || 0) + unseen;
        const row = document.querySelector('a.hub-card[href="/portal/expense"] .hub-card-title-row');
        if (!row || !n) return;
        row.querySelector('.hub-card-alert')?.remove();
        row.insertAdjacentHTML('beforeend', '<span class="hub-card-alert" aria-label="' + n + '">' + n + '</span>');
      } catch (e) {}
    }

    function renderNav() {
      const item = tool => `
        <a class="hub-nav-item" href="${tool.href}" style="--item-color:${tool.color}" onclick="markVisited('${tool.href}')">
          <span class="hub-nav-item-icon">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">${ICONS[tool.icon] || ''}</svg>
          </span>
          <span class="hub-nav-item-label">${hubLang === 'en' ? tool.title_en : tool.title_ko}</span>
        </a>`;
      $('hubNav').innerHTML = GROUPS.map(g => `
        <p class="hub-nav-label">${hubLang === 'en' ? g.en : g.ko}</p>
        ${TOOLS.filter(x => x.group === g.id).map(item).join('')}
      `).join('');
    }

    function applyLangToDOM() {
      document.documentElement.lang = hubLang === 'en' ? 'en' : 'ko';
      document.title = 'WOLKO Portal';
      document.querySelectorAll('[data-t]').forEach(el => {
        el.textContent = t(el.getAttribute('data-t'));
      });
      document.querySelectorAll('[data-t-title]').forEach(el => { el.title = t(el.dataset.tTitle); });
      document.querySelectorAll('[data-t-aria]').forEach(el => { el.setAttribute('aria-label', t(el.dataset.tAria)); });
      $('signupNameInput').placeholder = t('namePlaceholder');
      $('signupPhoneInput').placeholder = t('phonePlaceholder');
      $('signupPwInput').placeholder = t('signupPwPlaceholder');
      updateSignupMode(); // 언어를 바꾸면 data-t 가 버튼 글자를 되돌리므로 가입 방식에 맞는 글자로 다시 맞춘다
      $('langKoBtn').classList.toggle('is-active', hubLang === 'ko');
      $('langEnBtn').classList.toggle('is-active', hubLang === 'en');
      renderNav();
      renderGrid();
      renderDash();
      loadExpenseBadge();
    }
    function setHubLang(lang) {
      hubLang = lang;
      localStorage.setItem('wolko-lang', hubLang);
      localStorage.removeItem('wolkoHubLang');
      applyLangToDOM();
    }

    let deferredInstallPrompt = null;
    function isPortalStandalone() {
      return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    }
    function syncInstallButton() {
      const button = $('installAppBtn');
      if (button) button.hidden = isPortalStandalone();
    }
    function installHelpMessage() {
      const ua = navigator.userAgent;
      const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      const isSafari = /Safari/.test(ua) && !/Chrome|CriOS|Edg|OPR|Android/.test(ua);
      return isIOS ? t('installHelpIOS') : (isSafari ? t('installHelpSafari') : t('installHelpDefault'));
    }
    function openInstallHelp() {
      $('installHelpText').textContent = installHelpMessage();
      $('installHelpModal').classList.remove('hidden');
      document.body.classList.add('hub-modal-open');
      document.querySelector('.hub-install-close')?.focus();
    }
    function closeInstallHelp() {
      $('installHelpModal').classList.add('hidden');
      document.body.classList.remove('hub-modal-open');
      $('installAppBtn')?.focus();
    }
    async function installPortalApp() {
      if (isPortalStandalone()) return;
      if (!deferredInstallPrompt) { openInstallHelp(); return; }
      deferredInstallPrompt.prompt();
      await deferredInstallPrompt.userChoice;
      deferredInstallPrompt = null;
    }
    window.addEventListener('beforeinstallprompt', event => {
      event.preventDefault();
      deferredInstallPrompt = event;
      syncInstallButton();
    });
    window.addEventListener('appinstalled', () => {
      deferredInstallPrompt = null;
      syncInstallButton();
      showToast(t('installDone'));
    });
    window.matchMedia('(display-mode: standalone)').addEventListener?.('change', syncInstallButton);
    $('installHelpModal').addEventListener('click', event => {
      if (event.target === $('installHelpModal')) closeInstallHelp();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !$('installHelpModal').classList.contains('hidden')) closeInstallHelp();
    });

    /* ── 화면 전환 ── */
    const SCREENS = ['emailScreen', 'signupScreen', 'statusScreen', 'resetRequestScreen', 'resetNewScreen'];
    function showScreen(id) {
      SCREENS.forEach(s => {
        $(s).style.display = s === id ? 'flex' : 'none';
        $(s).classList.toggle('hidden', s !== id);
      });
    }

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const rememberedEmail = window.WolkoSession.rememberedEmail();
    $('emailInput').value = rememberedEmail;
    $('rememberEmail').checked = !!rememberedEmail;
    $('rememberEmail').addEventListener('change', () => {
      if (!$('rememberEmail').checked) window.WolkoSession.rememberEmail('', false);
    });
    function saveRememberedEmail(email) {
      window.WolkoSession.rememberEmail(email, $('rememberEmail').checked);
    }

    async function offerCredentialUpdate() {
      if (!navigator.credentials?.store || typeof window.PasswordCredential === 'undefined') return;
      try {
        const credential = new window.PasswordCredential($('portalLoginForm'));
        await navigator.credentials.store(credential);
      } catch (e) {
        // Password managers decide whether to show a save/update prompt.
      }
    }

    /* ── 이메일+비밀번호 로그인 ── */
    async function doAccountLogin() {
      const email = $('emailInput').value.trim().toLowerCase();
      const password = $('loginPwInput').value;
      const errEl = $('emailError');
      errEl.textContent = '';
      if (!email) { errEl.textContent = t('emailRequired'); return; }
      if (!EMAIL_RE.test(email)) { errEl.textContent = t('emailInvalid'); return; }
      if (!password) { errEl.textContent = t('passwordRequired'); return; }

      const btn = $('emailBtn');
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = t('loginVerifying');

      try {
        const res = await fetch('/api/hub/account-login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password }),
        });
        const data = await res.json();
        // 카운슬러 계정은 포탈 계정과 완전히 별개다: 포탈에 없는 이메일(404)일 때만 카운슬러 로그인을 시도한다.
        // (예전에는 role 이 'counselor' 인 계정도 여기로 보냈는데, 지금 'counselor'는 일반 멤버의 내부 이름이라
        //  승인된 일반 멤버가 모두 카운슬러 로그인으로 넘어가 '계정을 찾을 수 없거나 비활성화' 오류를 만났다.)
        if (res.status === 404) {
          const counselorRes = await fetch('/api/camp-progress/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ mode: 'login', email, password }),
          });
          const counselorData = await counselorRes.json();
          if (!counselorRes.ok || counselorData.role !== 'counselor' || !counselorData.token) {
            // 카운슬러 쪽에도 계정이 없을 때는 포탈의 안내(가입되지 않은 이메일)를 그대로 보여준다
            throw new Error(counselorRes.status === 401 && /찾을 수 없/.test(counselorData.error || '') ? (data.error || t('loginWrong')) : (counselorData.error || t('loginWrong')));
          }
          sessionStorage.setItem('wolko-camp-progress-token', counselorData.token);
          saveRememberedEmail(email);
          sessionStorage.setItem('wolko-camp-progress-role', 'counselor');
          sessionStorage.removeItem('wolko-hub-token');
          sessionStorage.removeItem('wolko-hub-email');
          sessionStorage.removeItem('wolko-hub-role');
          await offerCredentialUpdate();
          location.replace('/portal/campstaff');
          return;
        }
        if (!res.ok) throw new Error(data.error || t('loginWrong'));
        saveRememberedEmail(email);
        applySession(data);
        await offerCredentialUpdate();
        location.replace('/portal/?signed-in=1');
      } catch (e) {
        errEl.textContent = e.message;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    }
    $('portalLoginForm').addEventListener('submit', event => {
      event.preventDefault();
      doAccountLogin();
    });

    /* ── 이메일+비밀번호 가입 ── */
    // wolko.org · wol.org 일반 멤버는 메일 인증으로 끝난다(비밀번호는 메일의 링크에서 정한다). 그 밖의 이메일·관리자 신청은 마스터 승인.
    function isAutoSignup() {
      const email = $('signupEmailInput').value.trim().toLowerCase();
      const role = document.querySelector('input[name="signupRole"]:checked')?.value || 'member';
      return role === 'member' && /^[^\s@]+@(wolko\.org|wol\.org)$/.test(email);
    }
    function updateSignupMode() {
      const email = $('signupEmailInput').value.trim();
      const auto = isAutoSignup();
      $('signupPwWrap').hidden = auto;
      $('signupBtn').textContent = t(auto ? 'signupBtnVerify' : 'signupBtn');
      const hint = $('signupDomainHint');
      hint.hidden = !EMAIL_RE.test(email);
      const wantsAdmin = (document.querySelector('input[name="signupRole"]:checked')?.value || 'member') === 'admin';
      hint.textContent = auto ? t('domainHintOrg') : (wantsAdmin && /@(wolko\.org|wol\.org)$/i.test(email) ? t('domainHintAdmin') : t('domainHintOther'));
    }
    $('signupEmailInput').addEventListener('input', updateSignupMode);
    document.querySelectorAll('input[name="signupRole"]').forEach(r => r.addEventListener('change', updateSignupMode));
    const PHONE_RE = /^[0-9+\-\s()]{7,20}$/;
    async function doSignup() {
      const name = $('signupNameInput').value.trim();
      const phone = $('signupPhoneInput').value.trim();
      const email = $('signupEmailInput').value.trim().toLowerCase();
      const password = $('signupPwInput').value;
      const campus = document.querySelector('input[name="signupCampus"]:checked')?.value || 'wolko';
      const requestedRole = document.querySelector('input[name="signupRole"]:checked')?.value || 'member';
      const errEl = $('signupError');
      errEl.textContent = '';
      if (!name) { errEl.textContent = t('nameRequired'); return; }
      if (!phone) { errEl.textContent = t('phoneRequired'); return; }
      if (!PHONE_RE.test(phone)) { errEl.textContent = t('phoneInvalid'); return; }
      if (!email) { errEl.textContent = t('emailRequired'); return; }
      if (!EMAIL_RE.test(email)) { errEl.textContent = t('emailInvalid'); return; }
      const auto = isAutoSignup();
      if (!auto && !password) { errEl.textContent = t('passwordRequired'); return; }

      const btn = $('signupBtn');
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = t('signupSending');

      try {
        const res = await fetch('/api/hub/signup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, phone, email, password, campus, requestedRole }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('passwordInvalid'));

        if (data.status === 'verify') {
          $('statusTitle').textContent = t('verifySentTitle');
          $('statusDesc').textContent = t('verifySentDesc');
        } else if (data.status === 'pending') {
          $('statusTitle').textContent = t('pendingStatusTitle');
          $('statusDesc').textContent = t('pendingStatusDesc');
        } else {
          $('statusTitle').textContent = t('signupApprovedTitle');
          $('statusDesc').textContent = t('signupApprovedDesc');
        }
        $('signupNameInput').value = '';
        $('signupPhoneInput').value = '';
        $('signupEmailInput').value = '';
        $('signupPwInput').value = '';
        updateSignupMode();
        showScreen('statusScreen');
      } catch (e) {
        errEl.textContent = e.message;
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    }
    $('signupNameInput').addEventListener('keydown', e => { if (e.key === 'Enter') doSignup(); });
    $('signupPhoneInput').addEventListener('keydown', e => { if (e.key === 'Enter') doSignup(); });
    $('signupPwInput').addEventListener('keydown', e => { if (e.key === 'Enter') doSignup(); });

    function applySession(data) {
      currentSession = { email: data.email, role: data.role };
      sessionStorage.setItem('wolko-hub-token', data.hubToken);
      sessionStorage.setItem('wolko-hub-email', data.email || '');
      sessionStorage.setItem('wolko-hub-role', data.role || '');
      window.WolkoSession.persistLogin(!!($('keepLogin') && $('keepLogin').checked));
    }

    function doLogout() {
      /* 이 기기에 저장된 로그인 유지 정보까지 함께 지운다 */
      window.WolkoSession.logoutAll();
    }

    function showHub() {
      SCREENS.forEach(s => { $(s).style.display = 'none'; });
      $('hubShell').hidden = false;
      loadDashboard();
      $('pendingBtn').hidden = currentSession?.role !== 'master';
      if (currentSession?.role === 'master') refreshPendingCount();
      if (window.wolkoCheckPasswordReset) window.wolkoCheckPasswordReset(); // 임시 비밀번호로 들어왔다면 새 비밀번호 설정 창
    }

    function isHubTokenValid(token) {
      try {
        const decoded = atob(token);
        const lastColon = decoded.lastIndexOf(':');
        const data = decoded.slice(0, lastColon);
        const parts = data.split(':');
        if (parts[0] !== 'wolko-hub' || parts.length !== 4) return false;
        const expires = parseInt(parts[3], 10);
        return !!expires && Date.now() < expires;
      } catch (e) {
        return false;
      }
    }

    /* ── 승인 대기 패널 (master 전용) ── */
    function authHeaders() {
      return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + sessionStorage.getItem('wolko-hub-token') };
    }
    function formatRequestedAt(iso) {
      if (!iso) return '';
      try { return new Date(iso).toLocaleString(hubLang === 'en' ? 'en-US' : 'ko-KR'); } catch (e) { return ''; }
    }
    async function refreshPendingCount() {
      try {
        // 확인되기 전과 실패했을 때는 빨간 점을 숨겨 둔다 — 대기 건수가 실제로 1건 이상일 때만 숫자와 함께 보인다.
        const badge = $('pendingCount');
        const res = await fetch('/api/hub/pending', { headers: authHeaders() });
        if (!res.ok) { badge.textContent = ''; badge.classList.add('hidden'); return; }
        const data = await res.json();
        const pendingCount = (data.accounts || []).filter(a => a.status === 'pending').length;
        badge.textContent = pendingCount || '';
        badge.classList.toggle('hidden', !pendingCount);
      } catch (e) { const badge = $('pendingCount'); if (badge) { badge.textContent = ''; badge.classList.add('hidden'); } }
    }
    function renderPendingItem(a, rejected) {
      if (rejected && !a.requestedRole && a.role) a = { ...a, requestedRole: a.role }; // 다시 활성화할 때 기존 등급을 미리 골라 둔다
      // admin 역할은 @wol.org 이메일에만 부여 가능(approve.js가 다시 검증) —
      // 드롭다운에서도 애초에 고를 수 없게 옵션 자체를 숨긴다.
      const isWol = /@(wol|wolko)\.org$/i.test(a.email);
      const adminOption = a.adminAllowed ? `<option value="admin">${t('roleAdmin')}</option>` : '';
      const counselorOption = `<option value="counselor">${t('roleCounselor')}</option>`;
      const nameLine = a.name ? `${esc(a.name)}${a.phone ? ' · ' + esc(a.phone) : ''}` : '';
      const wantsAdmin = a.requestedRole === 'admin' && a.adminAllowed;
      const requestedLine = a.requestedRole ? `${t('requestedLabel')}: ${a.requestedRole === 'admin' ? t('roleAdmin') + (a.adminAllowed ? '' : ' (' + t('adminNotListed') + ')') : t('roleCounselor')}` : '';
      return `
          <div class="hub-pending-item">
            <div>
              <p class="hub-pending-email">${esc(a.email)}</p>
              ${nameLine ? `<p class="hub-pending-role">${nameLine}</p>` : ''}
              ${requestedLine ? `<p class="hub-pending-role"><b>${esc(requestedLine)}</b></p>` : ''}
              <p class="hub-pending-role">${esc(formatRequestedAt(a.requestedAt))}</p>
            </div>
            <div class="hub-pending-actions">
              <select class="hub-pending-role-select">
                <option value="" disabled ${a.requestedRole ? '' : 'selected'}>${t('rolePlaceholder')}</option>
                ${adminOption.replace('<option value="admin">', wantsAdmin ? '<option value="admin" selected>' : '<option value="admin">')}${counselorOption.replace('<option value="counselor">', a.requestedRole && !wantsAdmin ? '<option value="counselor" selected>' : '<option value="counselor">')}
              </select>
              <button class="hub-pending-approve" onclick="respondToRequest('${esc(a.email)}','approve',this)">${rejected ? t('reapproveBtn') : t('approveBtn')}</button>
              ${rejected ? '' : `<button class="hub-pending-reject" onclick="respondToRequest('${esc(a.email)}','reject',this)">${t('rejectBtn')}</button>`}
            </div>
          </div>`;
    }
    async function openPendingPanel() {
      $('pendingModal').classList.remove('hidden');
      $('pendingList').innerHTML = '';
      try {
        const res = await fetch('/api/hub/pending', { headers: authHeaders() });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        const pending = (data.accounts || []).filter(a => a.status === 'pending');
        renderResetBox((data.accounts || []).filter(a => a.status === 'approved' && a.effectiveRole !== 'master'), (data.accounts || []).filter(a => a.effectiveRole !== 'master'));
        const rejected = (data.accounts || []).filter(a => a.status === 'rejected');
        const rejectedHtml = rejected.length
          ? `<div class="hub-rejected"><h4>${t('rejectedTitle')}</h4><p class="hub-reset-help">${t('rejectedHelp')}</p>${rejected.map(a => renderPendingItem(a, true)).join('')}</div>`
          : '';
        $('pendingList').innerHTML = (pending.length ? pending.map(a => renderPendingItem(a, false)).join('') : `<p class="hub-pending-empty">${t('pendingEmpty')}</p>`) + rejectedHtml;
      } catch (e) {
        $('pendingList').innerHTML = `<p class="hub-pending-empty">${esc(e.message || '')}</p>`;
      }
    }
    function renderResetBox(accounts, allAccounts) {
      const list = accounts.slice().sort((x, y) => String(x.name || x.email).localeCompare(String(y.name || y.email), 'ko'));
      $('resetBox').innerHTML = `
        <h4>${t('resetTitle')}</h4>
        <p class="hub-reset-help">${t('resetHelp')}</p>
        <label>${t('resetPick')}<select id="resetEmail">${list.map(a => `<option value="${esc(a.email)}">${esc(a.name || a.email)} · ${esc(a.email)}</option>`).join('')}</select></label>
        <label>${t('resetTemp')}<input id="resetTemp" type="text" value="1234" autocomplete="off" autocapitalize="off"></label>
        <button type="button" class="hub-reset-btn" id="resetBtn">${t('resetBtn')}</button>
        <div class="hub-delete">
          <h4>${t('deleteTitle')}</h4>
          <p class="hub-reset-help">${t('deleteHelp')}</p>
          <label>${t('resetPick')}<select id="deleteEmail">${allAccounts.slice().sort((x, y) => String(x.name || x.email).localeCompare(String(y.name || y.email), 'ko')).map(a => `<option value="${esc(a.email)}">${esc(a.name || a.email)} · ${esc(a.email)}${a.status !== 'approved' ? ' (' + esc(a.status) + ')' : ''}</option>`).join('')}</select></label>
          <button type="button" class="hub-reset-btn hub-delete-btn" id="deleteBtn">${t('deleteBtn')}</button>
        </div>`;
      $('deleteBtn').addEventListener('click', async () => {
        const sel = $('deleteEmail');
        if (!sel.value) return;
        const typed = prompt(t('deletePrompt', sel.value));
        if (typed === null) return;
        try {
          const res = await fetch('/api/hub/delete-account', { method: 'POST', headers: authHeaders(), body: JSON.stringify({ email: sel.value, confirm: typed }) });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          showToast(t('deleteDone'));
          openPendingPanel(); refreshPendingCount();
        } catch (e) { showToast(e.message || '', true); }
      });
      $('resetBtn').addEventListener('click', async () => {
        const sel = $('resetEmail');
        if (!sel.value) return;
        const label = sel.options[sel.selectedIndex].textContent.split(' · ')[0];
        if (!confirm(t('resetConfirm', label, sel.value))) return;
        try {
          const res = await fetch('/api/hub/reset-password', { method: 'POST', headers: authHeaders(), body: JSON.stringify({ email: sel.value, tempPassword: $('resetTemp').value }) });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          showToast(t('resetDone'));
        } catch (e) { showToast(e.message || '', true); }
      });
    }
    function closePendingPanel() {
      $('pendingModal').classList.add('hidden');
    }
    async function respondToRequest(email, action, btnEl) {
      let role;
      if (action === 'approve') {
        const select = btnEl.closest('.hub-pending-actions').querySelector('.hub-pending-role-select');
        role = select.value;
        if (!role) { showToast(t('roleRequiredToast'), true); return; }
      }
      try {
        const res = await fetch('/api/hub/approve', {
          method: 'POST',
          headers: authHeaders(),
          body: JSON.stringify({ email, action, role }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        showToast(action === 'approve' ? t('approvedToast') : t('rejectedToast'));
        openPendingPanel();
        refreshPendingCount();
      } catch (e) {
        showToast(e.message || '', true);
      }
    }
    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    }

    /* ── 메일 링크로 들어온 화면: 비밀번호 재설정(?reset=) / 가입 확인(?verify=) 은 같은 비밀번호 정하기 화면을 쓴다 ── */
    const linkParams = () => new URLSearchParams(location.search);
    const verifyToken = () => linkParams().get('verify') || '';
    function setVerifyMode(on) {
      const screen = $('resetNewScreen');
      const title = screen.querySelector('.login-title'), desc = screen.querySelector('.login-description'), again = screen.querySelector('.login-link-btn');
      title.dataset.t = on ? 'verifyNewTitle' : 'resetNewTitle';
      desc.dataset.t = on ? 'verifyNewDesc' : 'resetNewDesc';
      again.dataset.t = on ? 'verifyAgainBtn' : 'resetAgainBtn';
      again.setAttribute('onclick', on ? "showScreen('signupScreen')" : "showScreen('resetRequestScreen')");
      title.textContent = t(title.dataset.t); desc.textContent = t(desc.dataset.t); again.textContent = t(again.dataset.t);
    }

    /* ── 비밀번호 재설정 (메일 링크) ── */
    $('resetRequestForm').addEventListener('submit', async event => {
      event.preventDefault();
      const msg = $('resetReqMsg'); msg.textContent = ''; msg.classList.remove('is-ok');
      const email = $('resetEmailInput').value.trim().toLowerCase();
      if (!email) { msg.textContent = t('emailRequired'); return; }
      if (!EMAIL_RE.test(email)) { msg.textContent = t('emailInvalid'); return; }
      const btn = $('resetReqBtn'); btn.disabled = true;
      try {
        const res = await fetch('/api/hub/password-reset', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'request', email }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || '');
        msg.textContent = t('resetReqSent'); msg.classList.add('is-ok');
      } catch (e) { msg.textContent = e.message || ''; }
      finally { btn.disabled = false; }
    });
    $('resetNewForm').addEventListener('submit', async event => {
      event.preventDefault();
      const msg = $('resetNewMsg'); msg.textContent = '';
      const pw = $('resetNewPw').value;
      if (pw.length < 8) { msg.textContent = t('resetShort'); return; }
      if (pw !== $('resetNewPw2').value) { msg.textContent = t('resetMismatch'); return; }
      const btn = $('resetNewBtn'); btn.disabled = true;
      try {
        const verifying = !!verifyToken();
        const token = verifying ? verifyToken() : (linkParams().get('reset') || '');
        const res = verifying
          ? await fetch('/api/hub/verify-email', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token, newPassword: pw }) })
          : await fetch('/api/hub/password-reset', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ action: 'confirm', token, newPassword: pw }) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || '');
        history.replaceState(null, '', '/portal/');
        setVerifyMode(false);
        showScreen('emailScreen');
        $('loginPwInput').value = ''; $('emailError').textContent = t(verifying ? 'verifyDoneLogin' : 'resetDoneLogin'); $('emailError').classList.add('is-ok');
      } catch (e) { msg.textContent = e.message || ''; }
      finally { btn.disabled = false; }
    });

    /* ── 초기화 ── */
    async function initAuthFlow() {
      if (verifyToken()) { setVerifyMode(true); showScreen('resetNewScreen'); return; } // 가입 확인 메일의 링크로 들어온 경우
      if (new URLSearchParams(location.search).get('reset')) { showScreen('resetNewScreen'); return; } // 메일의 재설정 링크로 들어온 경우
      const hubToken = sessionStorage.getItem('wolko-hub-token') || '';
      if (hubToken && isHubTokenValid(hubToken)) {
        currentSession = {
          email: sessionStorage.getItem('wolko-hub-email') || '',
          role: sessionStorage.getItem('wolko-hub-role') || '',
        };
        showHub();
        if (new URLSearchParams(location.search).has('signed-in')) {
          history.replaceState(null, '', '/portal/');
        }
        return;
      }
      showScreen('emailScreen');
    }

    applyLangToDOM();
    syncInstallButton();
    initAuthFlow();

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/portal-sw.js', { scope: '/portal/' })
          .catch(error => console.warn('Portal SW registration failed:', error));
      });
    }
  </script>
</body>
</html>
