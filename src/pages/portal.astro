      cb.classList.toggle('is-open', open); cb.setAttribute('aria-expanded', open ? 'true' : 'false');
      const panel = document.getElementById(cb.getAttribute('aria-controls')); if (panel) panel.classList.toggle('is-open', open);
      if (open) churchOpen.add(cb.dataset.church); else churchOpen.delete(cb.dataset.church);
    });
    document.addEventListener('click', async e => {
      const pray = e.target.closest && e.target.closest('.hub-pray-btn');
      if (pray) {
        pray.disabled = true;
        try { const out = await prayerCall('POST', '/api/portal/prayers', { action: 'pray', id: pray.dataset.pray }); const p = (dashData.prayers || []).find(x => x.id === pray.dataset.pray); if (p) { p.count = out.count; p.prayed = out.prayed; } renderDash(); }
        catch (err) { showToast(err.message, true); pray.disabled = false; }
        return;
      }
      const pedit = e.target.closest && e.target.closest('.hub-prayer-edit');
      if (pedit) { prayerEditing = pedit.dataset.edit; prayerClosed.delete(prayerEditing); renderDash(); return; }
      if (e.target.closest && e.target.closest('.hub-prayer-cancel')) { prayerEditing = null; renderDash(); return; }
      const psave = e.target.closest && e.target.closest('.hub-prayer-save');
      if (psave) {
        const f = psave.closest('.hub-prayer-editform');
        const title = f.querySelector('.pe-title').value.trim(), text = f.querySelector('.pe-text').value.trim();
        if (!title && !text) { showToast(t('prayerNeedText'), true); return; }
