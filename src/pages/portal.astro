---
// WOLKO Portal — 내부 도구 모음 런처(구 hub.astro, 주소 /hub → /portal로 통일).
// 이메일+비밀번호 승인 로그인, 단일 화면(트랙 구분 없음). 역할(admin/counselor)은
// 가입 시점엔 안 정해지고 master 승인 시 지정 — admin은 서버가 @wol.org 도메인인지
// 검증(approve.js). 공유 비밀번호 로그인 없음.
// 발표용 Resource 작업 현황 리포트는 별도 페이지(resource.astro, 구 portal.astro)로 분리돼 있다.
// No BaseLayout; standalone page (wolkoadmin/car와 동일한 패턴)
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <script is:inline src="/wolko-lang-sync.js?v=2"></script>
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
  <title>WOLKO Portal</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/hub.css?v=81">
  <link rel="stylesheet" href="/hub-sky.css?v=12">
  <script src="/hub-sky.js?v=4" defer></script>
  <link rel="stylesheet" href="/wolko-datepicker.css?v=4">
  <script src="/wolko-datepicker.js?v=4" defer></script>
  <link rel="stylesheet" href="/portal-remember.css?v=1">
  <link rel="stylesheet" href="/wolko-auth.css?v=5">
  <link rel="stylesheet" href="/wolko-ui.css?v=6">
  <link rel="stylesheet" href="/wolko-rail.css?v=24">
  <link rel="stylesheet" href="/wolko-site.css?v=3">
  <script src="/wolko-rail.js?v=44" defer></script>
  <link rel="manifest" href="/portal-manifest.json">
  <meta name="theme-color" content="#004f68">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="WOLKO">
  <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
  <script is:inline src="/wolko-session.js?v=2"></script>
<link rel="stylesheet" href="/phone-input.css?v=4">
<script is:inline src="/phone-input.js?v=2" defer></script>
</head>
<body>

  <!-- ── 이메일+비밀번호 로그인 (기본) ── -->
  <div class="login-screen" id="emailScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-t="emailLoginTitle">포탈 로그인</p>
      <p class="login-description" data-t="emailLoginDesc">가입하신 이메일과 비밀번호로 로그인하세요.</p>
      <form class="portal-login-form" id="portalLoginForm" action="/api/hub/account-login" method="post" novalidate>
        <div class="login-input-wrap">
          <input class="login-input" type="email" id="emailInput" name="username" placeholder="you@example.com" autocomplete="username" autocapitalize="none" spellcheck="false">
        </div>
        <div class="login-input-wrap">
          <input class="login-input" type="password" id="loginPwInput" name="password" placeholder="••••••••" autocomplete="current-password">
        </div>
        <label class="remember-email"><input type="checkbox" id="rememberEmail"><span data-t="rememberEmail">아이디 저장</span></label>
        <label class="remember-email"><input type="checkbox" id="keepLogin" checked><span data-t="keepLogin">로그인 유지 (90일)</span></label>
        <p class="login-error" id="emailError"></p>
        <button class="login-btn" id="emailBtn" type="submit" data-t="loginBtn">로그인</button>
      </form>
      <button class="login-link-btn" type="button" onclick="showScreen('resetRequestScreen')" data-t="forgotBtn">비밀번호를 잊으셨나요?</button>
      <button class="login-signup-btn" type="button" onclick="showScreen('signupScreen')"><span class="login-signup-hint" data-t="signupHint">계정이 없으신가요?</span><span class="login-signup-main" data-t="signupGoLabel">가입하기</span></button>
    </div>
  </div>

  <!-- ── 비밀번호를 잊었을 때: 이메일로 재설정 링크 받기 ── -->
  <div class="login-screen hidden" id="resetRequestScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-t="resetReqTitle">비밀번호 재설정</p>
      <p class="login-description" data-t="resetReqDesc">가입하신 이메일을 입력하면 새 비밀번호를 정하는 링크를 보내드려요.</p>
      <form class="portal-login-form" id="resetRequestForm" novalidate>
        <div class="login-input-wrap">
          <input class="login-input" type="email" id="resetEmailInput" placeholder="you@example.com" autocomplete="username" autocapitalize="none" spellcheck="false">
        </div>
        <p class="login-error" id="resetReqMsg" role="status"></p>
        <button class="login-btn" id="resetReqBtn" type="submit" data-t="resetReqBtn">재설정 링크 받기</button>
      </form>
      <button class="login-link-btn" type="button" onclick="showScreen('emailScreen')" data-t="backToLoginOnlyBtn">로그인으로 돌아가기</button>
    </div>
  </div>

  <!-- ── 메일의 링크로 들어와 새 비밀번호 정하기 ── -->
  <div class="login-screen hidden" id="resetNewScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-t="resetNewTitle">새 비밀번호 정하기</p>
      <p class="login-description" data-t="resetNewDesc">8자 이상으로 새 비밀번호를 입력해 주세요.</p>
      <form class="portal-login-form" id="resetNewForm" novalidate>
        <div class="login-input-wrap">
          <input class="login-input" type="password" id="resetNewPw" placeholder="••••••••" autocomplete="new-password">
        </div>
        <div class="login-input-wrap">
          <input class="login-input" type="password" id="resetNewPw2" placeholder="••••••••" autocomplete="new-password">
        </div>
        <p class="login-error" id="resetNewMsg" role="status"></p>
        <button class="login-btn" id="resetNewBtn" type="submit" data-t="resetNewBtn">비밀번호 변경</button>
      </form>
      <button class="login-link-btn" type="button" onclick="showScreen('resetRequestScreen')" data-t="resetAgainBtn">링크를 다시 받기</button>
    </div>
  </div>

  <!-- ── 이메일+비밀번호 가입 ── -->
  <div class="login-screen hidden" id="signupScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-t="signupTitle">포탈 가입</p>
      <p class="login-description" data-t="signupDesc">wolko.org · wol.org 이메일은 메일 인증만 하면 바로 가입돼요. 다른 이메일은 마스터 관리자 승인 후 로그인할 수 있어요.</p>
      <div class="login-input-wrap">
        <input class="login-input" type="text" id="signupNameInput" placeholder="이름" autocomplete="name">
      </div>
      <div class="login-input-wrap signup-campus" role="radiogroup" aria-label="소속">
        <label class="signup-campus-opt"><input type="radio" name="signupCampus" value="wolko" checked><span data-t="campusPyeongtaek">평택</span></label>
        <label class="signup-campus-opt"><input type="radio" name="signupCampus" value="jeju"><span data-t="campusJeju">제주</span></label>
      </div>
      <div class="login-input-wrap signup-role" role="radiogroup" aria-label="등급">
        <label class="signup-campus-opt"><input type="radio" name="signupRole" value="member" checked><span data-t="roleMemberOpt">일반 멤버</span></label>
        <label class="signup-campus-opt"><input type="radio" name="signupRole" value="admin"><span data-t="roleAdminOpt">관리자</span></label>
      </div>
      <p class="signup-role-hint" data-t="roleHint">관리자는 포탈 전체를 유지보수하는 역할이에요 (wolko.org·wol.org 이메일 · 마스터 승인 필요). 페이지별 세부 권한은 따로 정해요.</p>
      <div class="login-input-wrap">
        <input class="login-input" type="tel" id="signupPhoneInput" data-intl-phone placeholder="휴대폰 번호" autocomplete="tel">
      </div>
      <div class="login-input-wrap">
        <input class="login-input" type="email" id="signupEmailInput" placeholder="you@wolko.org" autocomplete="email">
      </div>
      <p class="signup-role-hint" id="signupDomainHint" hidden></p>
      <div class="login-input-wrap" id="signupPwWrap">
        <input class="login-input" type="password" id="signupPwInput" placeholder="8자 이상" autocomplete="new-password">
      </div>
      <p class="login-error" id="signupError"></p>
      <button class="login-btn" id="signupBtn" onclick="doSignup()" data-t="signupBtn">가입 요청</button>
      <button class="login-link-btn" onclick="showScreen('emailScreen')" data-t="backToLoginBtn">이미 계정이 있으신가요? 로그인</button>
    </div>
  </div>

  <!-- ── 발송/대기 안내 ── -->
  <div class="login-screen hidden" id="statusScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" id="statusTitle"></p>
      <p class="login-description" id="statusDesc"></p>
      <button class="login-btn" onclick="showScreen('emailScreen')" data-t="backBtn">뒤로</button>
    </div>
  </div>

  <div class="hub-shell" id="hubShell" hidden>
    <nav class="hub-sidebar">
      <button type="button" class="hub-burger" id="hubBurger" aria-label="메뉴 열기" aria-expanded="false" aria-controls="hubNav" onclick="toggleHubNav()"><span></span><span></span><span></span></button>
      <a class="hub-sidebar-brand" href="/">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <span class="hub-sidebar-brand-text">
          <span class="hub-sidebar-brand-name" data-t="headerTitle">WOLKO Portal</span>
          <span class="hub-sidebar-brand-sub">Word of Life Korea</span>
        </span>
      </a>

      <div class="hub-nav" id="hubNav"></div>
      <div class="hub-nav-backdrop" id="hubNavBackdrop" onclick="toggleHubNav(false)"></div>

      <div class="hub-sidebar-foot">
        <button class="hub-sidebar-lang" id="pendingBtn" onclick="openPendingPanel()" hidden>
          <span data-t="pendingLabel">승인 대기</span>
          <span class="hub-pending-badge hidden" id="pendingCount"></span>
        </button>
        <button class="hub-sidebar-lang hub-install-button" id="installAppBtn" type="button" onclick="installPortalApp()" data-t-title="installApp" data-t-aria="installApp" title="앱 설치" aria-label="앱 설치">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11"/><path d="m8 10 4 4 4-4"/><path d="M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"/></svg>
          <span class="hub-install-label" data-t="installApp">앱 설치</span>
        </button>
        <div class="hub-lang-toggle" role="group" aria-label="Language">
          <button class="hub-lang-btn" id="langKoBtn" onclick="setHubLang('ko')" aria-label="한국어" title="한국어">
            <img src="https://flagcdn.com/w20/kr.png" alt="" width="16" height="12"><span>KO</span>
          </button>
          <button class="hub-lang-btn" id="langEnBtn" onclick="setHubLang('en')" aria-label="English" title="English">
            <img src="https://flagcdn.com/w20/us.png" alt="" width="16" height="12"><span>EN</span>
          </button>
        </div>
        <button class="hub-sidebar-lang" onclick="doLogout()" data-t="logout">로그아웃</button>
      </div>
    </nav>

    <main class="hub-main">
      <div class="hub-wrap">
        <section class="hub-sky" id="hubSky" data-kind="none" data-day="1" aria-label="오늘">
          <canvas class="hub-sky-canvas" id="hubSkyCanvas" aria-hidden="true"></canvas>
          <div class="hub-sky-art" aria-hidden="true"><i class="sk-sun"></i><i class="sk-moon"></i><i class="sk-fog f1"></i><i class="sk-fog f2"></i><i class="sk-cloud c1"></i><i class="sk-cloud c2"></i><i class="sk-cloud c3"></i><i class="sk-flash"></i></div>
          <div class="hub-sky-content">
            <h1 class="hub-greeting" id="hubKicker"></h1>
            <div id="hubSkyBody"></div>
          </div>
          <div class="hub-wx" id="hubWx" hidden></div>
        </section>

        <div class="hub-dash" id="hubDash" aria-live="polite"></div>

      </div>
    </main>
  </div>

  <!-- ── 승인 대기 목록 (master 전용) ── -->
  <div class="hub-pending-overlay hidden" id="pendingModal">
    <div class="hub-pending-card">
      <div class="hub-pending-head">
        <p data-t="pendingListTitle">승인 대기 목록</p>
        <button class="hub-modal-close" onclick="closePendingPanel()" aria-label="close">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M1.5 1.5l12 12M13.5 1.5l-12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div id="pendingList"></div>
      <section class="hub-reset" id="resetBox"></section>
    </div>
  </div>

  <div class="hub-install-overlay hidden" id="installHelpModal" role="dialog" aria-modal="true" aria-labelledby="installHelpTitle">
    <section class="hub-install-card">
      <button class="hub-modal-close hub-install-close" type="button" onclick="closeInstallHelp()" data-t-aria="close" aria-label="닫기">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M1.5 1.5l12 12M13.5 1.5l-12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <img class="hub-install-icon" src="/images/portal-icon.svg" alt="">
      <h2 id="installHelpTitle" data-t="installHelpTitle">WOLKO 앱 설치</h2>
      <p id="installHelpText"></p>
      <button class="hub-install-confirm" type="button" onclick="closeInstallHelp()" data-t="close">확인</button>
    </section>
  </div>

  <div class="hub-toast" id="hubToast"></div>

  <script is:inline>
    const ICONS = {
      heart: '<path d="M12 21s-7-4.2-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.8-7 10-7 10Z"/>',
      stats: '<path d="M4 20V11M10 20V5M16 20v-7M22 20H2"/><circle cx="19" cy="6.5" r="2" fill="currentColor" stroke="none"/>',
      clipboard: '<path d="M9 4h6a1 1 0 0 1 1 1v1H8V5a1 1 0 0 1 1-1z"/><path d="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2"/><path d="m9 13.5 2 2 4-4.5"/>',
      users: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4" fill="currentColor" fill-opacity=".12"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
      car: '<path d="M14 16H9m10 0h2v-3.15a1 1 0 0 0-.84-.99L18 11.5l-2.35-3.13a1 1 0 0 0-.8-.4H6.5a2 2 0 0 0-1.79 1.11L3.6 11.5A5 5 0 0 0 3 14v2h2"/><circle cx="6.5" cy="16.5" r="2.5" fill="currentColor" stroke="none"/><circle cx="16.5" cy="16.5" r="2.5" fill="currentColor" stroke="none"/>',
      landmark: '<path d="M12 2v3M10.3 3.5h3.4"/><path d="M4 10.5 12 5l8 5.5"/><path d="M5.5 10v10h13V10"/><path d="M10 20v-6.5a2 2 0 0 1 4 0V20"/>',
      calendar: '<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path d="M16 2v4M8 2v4M3 10h18"/><rect x="7" y="13.5" width="4" height="4" rx="1" fill="currentColor" stroke="none"/>',
      chart: '<path d="M4 19V5M4 19h16"/><path d="m7 15 4-4 3 2 5-6"/><circle cx="7" cy="15" r="1" fill="currentColor" stroke="none"/><circle cx="11" cy="11" r="1" fill="currentColor" stroke="none"/><circle cx="14" cy="13" r="1" fill="currentColor" stroke="none"/><circle cx="19" cy="7" r="1" fill="currentColor" stroke="none"/>',
      receipt: '<path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6M9 16h3"/>',
      mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 7 8.5 6 8.5-6"/>',
      utensils: '<path d="M5 3v6a3 3 0 0 0 3 3v9M8 3v6M11 3v6a3 3 0 0 1-3 3"/><path d="M18 21V3c-2.5 1.5-3.5 4-3.5 7.5 0 1.5.8 2.5 3.5 2.5"/>',
      folder: '<path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
      checklist: '<path d="M8 3v3M16 3v3M4 8h16"/><rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M8.5 14.5h.01M12 14.5h.01M15.5 14.5h.01M8.5 17.5h.01M12 17.5h.01"/>',
    };

    const TOOLS = [
      { group: 'wolko', href: '/portal/schedule', color: '#22b573', icon: 'calendar',
        title_ko: '월코 캘린더', title_en: 'WOLKO Calendar',
        desc_ko: '스태프 일정 공유 캘린더', desc_en: 'Shared staff schedule calendar' },
      { group: 'wolko', href: '/portal/crs', color: '#8b6cf0', icon: 'landmark',
        title_ko: 'CRS', title_en: 'CRS',
        desc_ko: 'Church Relationship System', desc_en: 'Church Relationship System' },
      { group: 'wolko', href: '/portal/wolkoevents', color: '#f0643f', icon: 'checklist',
        title_ko: '이벤트 관리', title_en: 'Event Management',
        desc_ko: '행사 참석 신청(RSVP) 현황', desc_en: 'Event RSVP management' },
      { group: 'wolko', href: '/portal/resource', color: '#14b8c4', icon: 'chart',
        title_ko: 'Resource & Media', title_en: 'Resource & Media',
        desc_ko: '자료 제작 · 번역 진행 현황', desc_en: 'Resource production & translation progress' },
      { group: 'wolko', href: '/portal/gospel-stats', color: '#e0566c', icon: 'stats',
        title_ko: '복음 통계', title_en: 'Gospel Stats',
        desc_ko: '월간 복음 전도 보고 · 월코/제주 통계', desc_en: 'Monthly Gospel outreach report · WOLKO & Jeju stats' },
      { group: 'wolko', href: '/portal/prayers', color: '#d6567a', icon: 'heart',
        title_ko: '기도제목 나누기', title_en: 'Prayer Requests',
        desc_ko: '기도제목 나눔 · 지난 기도제목 모아 보기', desc_en: 'Share prayer requests · browse past ones' },
      { group: 'camp', href: '/portal/wolkoadmin', color: '#3b8ff0', icon: 'clipboard',
        title_ko: '캠프 관리자', title_en: 'Camp Manager',
        desc_ko: '캠프 신청 현황 · 확정 관리', desc_en: 'Camp registration & confirmation' },
      { group: 'camp', href: '/portal/campstaff', color: '#ec5fa0', icon: 'users',
        title_ko: '카운슬러', title_en: 'Counselor',
        desc_ko: '카운슬러 상담기록 · 팀 현황', desc_en: 'Counselor records & team status' },
      { group: 'camp', href: '/portal/camp-resources', color: '#9bbf1f', icon: 'folder',
