---
// WOLKO Portal — 내부 도구 모음 런처(구 hub.astro, 주소 /hub → /portal로 통일).
// 이메일+비밀번호 승인 로그인, 단일 화면(트랙 구분 없음). 역할(admin/counselor)은
// 가입 시점엔 안 정해지고 master 승인 시 지정 — admin은 서버가 @wol.org 도메인인지
// 검증(approve.js). 공유 비밀번호 로그인 없음.
// 발표용 Resource 작업 현황 리포트는 별도 페이지(resource.astro, 구 portal.astro)로 분리돼 있다.
// No BaseLayout; standalone page (wolkoadmin/car와 동일한 패턴)
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <script is:inline src="/wolko-lang-sync.js?v=3"></script>
  <script is:inline src="/wolko-busy.js?v=2"></script>
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
  <title>WOLKO Portal</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/hub.css?v=92">
  <link rel="stylesheet" href="/hub-sky.css?v=13">
  <script src="/hub-sky.js?v=6" defer></script>
  <link rel="stylesheet" href="/wolko-datepicker.css?v=4">
  <script src="/wolko-datepicker.js?v=4" defer></script>
  <link rel="stylesheet" href="/portal-remember.css?v=1">
  <link rel="stylesheet" href="/wolko-auth.css?v=5">
  <link rel="stylesheet" href="/wolko-ui.css?v=6">
  <link rel="stylesheet" href="/wolko-rail.css?v=24">
  <link rel="stylesheet" href="/wolko-site.css?v=11">
  <link rel="stylesheet" href="/wolko-login.css?v=1">
  <link rel="stylesheet" href="/portal-auth.css?v=4">
  <!-- 로그인 전 화면의 제출 단추가 보내는 동안(aria-disabled): 지금의 :disabled 모양(wolko-auth.css)과 같게 흐리고, 마우스를 올려도 색이 바뀌지 않게 -->
  <style is:inline>
    :root:root .login-screen.portal-auth .login-btn[aria-disabled="true"] { opacity: .62; cursor: not-allowed; }
    :root:root .login-screen.portal-auth .login-btn[aria-disabled="true"]:hover { background: #004f68 !important; border-color: #004f68 !important; }
    :root:root .login-screen.portal-auth .login-btn[aria-disabled="true"]:active { transform: none !important; }
  </style>
  <link rel="stylesheet" href="/wolko-customize.css?v=4">
  <script src="/wolko-customize.js?v=4" defer></script>
  <script src="/wolko-rail.js?v=49" defer></script>
  <link rel="manifest" href="/portal-manifest.json">
  <meta name="theme-color" content="#004f68">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="WOLKO">
  <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
  <script is:inline src="/wolko-session.js?v=2"></script>
<link rel="stylesheet" href="/phone-input.css?v=5">
<script is:inline src="/phone-input.js?v=3" defer></script>
</head>
<body>

  <!-- ── 로그인 전 화면들(로그인 · 가입 · 안내 · 비밀번호)의 언어 바꾸기 — 포탈에 들어가면 숨긴다 ── -->
  <div class="auth-lang" id="authLang" role="group" aria-label="Language">
    <button type="button" data-hub-lang="ko" onclick="setHubLang('ko')" lang="ko">한국어</button>
    <button type="button" data-hub-lang="en" onclick="setHubLang('en')" lang="en">English</button>
  </div>

  <!-- ── 이메일+비밀번호 로그인 (기본) ── -->
  <div class="login-screen portal-auth" id="emailScreen">
    <div class="login-card">
      <div class="login-logo"><img class="login-logo-lockup" src="/images/wolko-logo.svg?v=2" alt="WOLKO 월코 — Word of Life Korea" width="220" height="43" style="width:220px !important;height:auto !important;max-width:100% !important;border-radius:0 !important;box-shadow:none !important;background:none !important"></div>
      <h1 class="login-title" tabindex="-1" data-t="emailLoginTitle">포탈 로그인</h1>
      <p class="login-description" data-t="emailLoginDesc">가입하신 이메일과 비밀번호로 로그인하세요.</p>
      <form class="portal-login-form" id="portalLoginForm" action="/api/hub/account-login" method="post" novalidate>
        <div class="login-input-wrap">
          <label class="auth-label" for="emailInput" data-t="emailLabel">이메일</label>
          <input class="login-input" type="email" id="emailInput" name="username" placeholder="you@wolko.org" autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="emailError">
        </div>
        <div class="login-input-wrap">
          <label class="auth-label" for="loginPwInput" data-t="passwordLabel">비밀번호</label>
          <input class="login-input" type="password" id="loginPwInput" name="password" autocomplete="current-password" aria-describedby="emailError">
        </div>
        <div class="auth-checks">
          <label class="remember-email"><input type="checkbox" id="rememberEmail"><span data-t="rememberEmail">아이디 저장</span></label>
          <label class="remember-email"><input type="checkbox" id="keepLogin" checked><span data-t="keepLogin">로그인 유지 (90일)</span></label>
        </div>
        <p class="login-error" id="emailError" role="alert"></p>
        <button class="login-btn" id="emailBtn" type="submit" data-t="loginBtn">로그인</button>
      </form>
      <button class="login-link-btn" type="button" onclick="showScreen('resetRequestScreen')" data-t="forgotBtn">비밀번호를 잊으셨나요?</button>
      <button class="login-signup-btn" type="button" onclick="showScreen('signupScreen')"><span class="login-signup-hint" data-t="signupHint">계정이 없으신가요?</span><span class="login-signup-main" data-t="signupGoLabel">가입하기</span></button>
    </div>
  </div>

  <!-- ── 비밀번호를 잊었을 때: 이메일로 재설정 링크 받기 ── -->
  <div class="login-screen portal-auth hidden" id="resetRequestScreen">
    <div class="login-card">
      <div class="login-logo"><img class="login-logo-lockup" src="/images/wolko-logo.svg?v=2" alt="WOLKO 월코 — Word of Life Korea" width="220" height="43" style="width:220px !important;height:auto !important;max-width:100% !important;border-radius:0 !important;box-shadow:none !important;background:none !important"></div>
      <h1 class="login-title" tabindex="-1" data-t="resetReqTitle">비밀번호 재설정</h1>
      <p class="login-description" data-t="resetReqDesc">가입하신 이메일을 입력하면 새 비밀번호를 정하는 링크를 보내드려요.</p>
      <form class="portal-login-form" id="resetRequestForm" novalidate>
        <div class="login-input-wrap">
          <label class="auth-label" for="resetEmailInput" data-t="emailLabel">이메일</label>
          <input class="login-input" type="email" id="resetEmailInput" name="email" placeholder="you@wolko.org" autocomplete="username" autocapitalize="none" spellcheck="false" aria-describedby="resetReqMsg">
        </div>
        <p class="login-error" id="resetReqMsg" role="status"></p>
        <button class="login-btn" id="resetReqBtn" type="submit" data-t="resetReqBtn">재설정 링크 받기</button>
      </form>
      <button class="login-link-btn" type="button" onclick="showScreen('emailScreen')" data-t="backToLoginOnlyBtn">로그인으로 돌아가기</button>
    </div>
  </div>

  <!-- ── 메일의 링크로 들어와 새 비밀번호 정하기 (가입 확인 메일이면 '가입 마치기') ── -->
  <div class="login-screen portal-auth hidden" id="resetNewScreen">
    <div class="login-card">
      <div class="login-logo"><img class="login-logo-lockup" src="/images/wolko-logo.svg?v=2" alt="WOLKO 월코 — Word of Life Korea" width="220" height="43" style="width:220px !important;height:auto !important;max-width:100% !important;border-radius:0 !important;box-shadow:none !important;background:none !important"></div>
      <h1 class="login-title" tabindex="-1" data-t="resetNewTitle">새 비밀번호 정하기</h1>
      <p class="login-description" data-t="resetNewDesc">새 비밀번호를 정해 주세요.</p>
      <form class="portal-login-form" id="resetNewForm" novalidate>
        <div class="login-input-wrap">
          <label class="auth-label" for="resetNewPw"><span data-t="newPasswordLabel">새 비밀번호</span><span class="auth-label-note" data-t="passwordRule">띄어쓰기 없이 영문·숫자·기호 8자 이상</span></label>
          <input class="login-input" type="password" id="resetNewPw" autocomplete="new-password" aria-describedby="resetNewMsg">
        </div>
        <div class="login-input-wrap">
          <label class="auth-label" for="resetNewPw2" data-t="newPassword2Label">새 비밀번호 한 번 더</label>
          <input class="login-input" type="password" id="resetNewPw2" autocomplete="new-password" aria-describedby="resetNewMsg">
        </div>
        <p class="login-error" id="resetNewMsg" role="status"></p>
        <button class="login-btn" id="resetNewBtn" type="submit" data-t="resetNewBtn">비밀번호 변경</button>
      </form>
      <button class="login-link-btn" type="button" onclick="showScreen('resetRequestScreen')" data-t="resetAgainBtn">링크를 다시 받기</button>
    </div>
  </div>

  <!-- ── 이메일+비밀번호 가입 ── -->
  <div class="login-screen portal-auth hidden" id="signupScreen">
    <div class="login-card">
      <div class="login-logo"><img class="login-logo-lockup" src="/images/wolko-logo.svg?v=2" alt="WOLKO 월코 — Word of Life Korea" width="220" height="43" style="width:220px !important;height:auto !important;max-width:100% !important;border-radius:0 !important;box-shadow:none !important;background:none !important"></div>
      <h1 class="login-title" tabindex="-1" data-t="signupTitle">포탈 가입</h1>
      <form class="portal-login-form" id="signupForm" novalidate>
        <div class="login-input-wrap">
          <label class="auth-label" for="signupNameInput" data-t="nameLabel">이름</label>
          <input class="login-input" type="text" id="signupNameInput" name="name" autocomplete="name" aria-describedby="signupError">
        </div>
        <fieldset class="login-input-wrap auth-fieldset">
          <legend class="auth-label" data-t="campusLegend">소속</legend>
          <div class="signup-campus">
            <label class="signup-campus-opt"><input type="radio" name="signupCampus" value="wolko" checked><span data-t="campusPyeongtaek">평택</span></label>
            <label class="signup-campus-opt"><input type="radio" name="signupCampus" value="jeju"><span data-t="campusJeju">제주</span></label>
          </div>
        </fieldset>
        <div class="login-input-wrap">
          <label class="auth-label" for="signupPhoneInput"><span data-t="phoneLabel">휴대폰 번호</span><span class="auth-label-note" data-t="phoneWhy">급한 연락용</span></label>
          <input class="login-input" type="tel" id="signupPhoneInput" name="tel" data-intl-phone placeholder="010-1234-5678" autocomplete="tel" aria-describedby="signupError">
        </div>
        <div class="login-input-wrap">
          <label class="auth-label" for="signupEmailInput" data-t="emailLabel">이메일</label>
          <input class="login-input" type="email" id="signupEmailInput" name="email" placeholder="you@wolko.org" autocomplete="email" autocapitalize="none" spellcheck="false" aria-describedby="signupDomainHint signupError">
          <p class="signup-role-hint" id="signupDomainHint" aria-live="polite" hidden></p>
          <button type="button" class="auth-admin-link" id="adminReqBtn" hidden></button>
        </div>
        <div class="login-input-wrap" id="signupPwWrap">
          <label class="auth-label" for="signupPwInput"><span data-t="passwordLabel">비밀번호</span><span class="auth-label-note" data-t="passwordRule">띄어쓰기 없이 영문·숫자·기호 8자 이상</span></label>
          <input class="login-input" type="password" id="signupPwInput" name="new-password" autocomplete="new-password" aria-describedby="signupError">
        </div>
        <p class="login-error" id="signupError" role="alert"></p>
        <button class="login-btn" id="signupBtn" type="submit" data-t="signupBtn">가입 요청</button>
      </form>
      <button class="login-link-btn" type="button" onclick="showScreen('emailScreen')" data-t="backToLoginBtn">이미 계정이 있으신가요? 로그인</button>
    </div>
  </div>

  <!-- ── 가입 뒤 안내: 인증 메일 보냄 / 승인 기다리는 중 ── -->
  <div class="login-screen portal-auth hidden" id="statusScreen">
    <div class="login-card">
      <div class="login-logo"><img class="login-logo-lockup" src="/images/wolko-logo.svg?v=2" alt="WOLKO 월코 — Word of Life Korea" width="220" height="43" style="width:220px !important;height:auto !important;max-width:100% !important;border-radius:0 !important;box-shadow:none !important;background:none !important"></div>
      <h1 class="login-title" tabindex="-1" id="statusTitle"></h1>
      <p class="auth-status-email" id="statusEmail" hidden></p>
      <p class="login-description" id="statusDesc"></p>
      <p class="auth-status-contact" id="statusContact" hidden><span data-t="pendingContact">궁금하거나 급한 일이 있으면 메일 주세요</span> <a href="mailto:admin@wolko.org">admin@wolko.org</a></p>
      <p class="login-error" id="statusMsg" role="status"></p>
      <!-- 확인 메일 상태에서만 보인다. 남은 시간 글은 단추 밖에 두고 알림 영역이 아니라서 매초 읽히지 않는다(단추에 초점이 가면 설명으로 한 번 읽힘) -->
      <div class="auth-status-actions" id="statusActions" hidden>
        <button class="auth-secondary-btn" type="button" id="statusResendBtn" aria-describedby="statusResendWait" data-t="resendBtn">메일 다시 보내기</button>
        <p class="auth-resend-wait" id="statusResendWait" hidden></p>
        <button class="auth-secondary-btn" type="button" id="statusFixBtn" data-t="fixEmailBtn">이메일 주소 고치기</button>
      </div>
      <!-- 승인 완료: 주 단추 / 승인 대기: 테두리 단추 / 확인 메일: 글자 링크 — 모양은 showSignupStatus 가 바꾼다 -->
      <button class="login-btn" type="button" id="statusLoginBtn" onclick="showScreen('emailScreen')" data-t="toLoginBtn">로그인 화면으로</button>
    </div>
  </div>

  <div class="hub-shell" id="hubShell" hidden>
    <nav class="hub-sidebar">
      <button type="button" class="hub-burger" id="hubBurger" aria-label="메뉴 열기" aria-expanded="false" aria-controls="hubNav" onclick="toggleHubNav()"><span></span><span></span><span></span></button>
      <a class="hub-sidebar-brand" href="/">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <span class="hub-sidebar-brand-text">
          <span class="hub-sidebar-brand-name" data-t="headerTitle">WOLKO Portal</span>
          <span class="hub-sidebar-brand-sub">Word of Life Korea</span>
        </span>
      </a>
      <span class="hub-bell-slot hub-bell-slot--m" data-bell-slot="m"></span>

      <div class="hub-nav" id="hubNav"></div>
      <div class="hub-nav-backdrop" id="hubNavBackdrop" onclick="toggleHubNav(false)"></div>

      <div class="hub-sidebar-foot">
        <button class="hub-sidebar-lang" id="pendingBtn" onclick="openPendingPanel()" hidden>
          <span data-t="pendingLabel">승인 대기</span>
          <span class="hub-pending-badge hidden" id="pendingCount"></span>
        </button>
        <button class="hub-sidebar-lang hub-install-button" id="installAppBtn" type="button" onclick="installPortalApp()" data-t-title="installApp" data-t-aria="installApp" title="앱 설치" aria-label="앱 설치">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v11"/><path d="m8 10 4 4 4-4"/><path d="M5 17v2a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-2"/></svg>
          <span class="hub-install-label" data-t="installApp">앱 설치</span>
        </button>
        <div class="hub-lang-toggle" role="group" aria-label="Language">
          <button class="hub-lang-btn" id="langKoBtn" data-hub-lang="ko" onclick="setHubLang('ko')" aria-label="한국어" title="한국어">
            <img src="/images/flags/kr.svg" alt="" width="16" height="12"><span>KO</span>
          </button>
          <button class="hub-lang-btn" id="langEnBtn" data-hub-lang="en" onclick="setHubLang('en')" aria-label="English" title="English">
            <img src="/images/flags/us.svg?v=2" alt="" width="16" height="12"><span>EN</span>
          </button>
        </div>
        <button class="hub-sidebar-lang hub-foot-logout" onclick="doLogout()" data-t="logout">로그아웃</button>
      </div>
    </nav>

    <main class="hub-main">
      <!-- 컴퓨터 화면: 다른 포탈 페이지와 같은 위쪽 머리글(오른쪽에 계정 · 언어 · 로그아웃). 폰에서는 위의 가로 바가 대신한다 -->
      <header class="app-header hub-topbar">
        <a class="app-brand hub-topbar-brand" href="/portal"><img src="/images/WOLKO Circle.png" alt="WOLKO"><span data-t="homeTitle">포탈 홈</span></a>
        <div class="hub-topbar-right">
          <span class="hub-bell-slot" data-bell-slot="top"></span>
          <div class="wl-lang-toggle" role="group" aria-label="Language">
            <button type="button" class="wl-lang-btn" data-hub-lang="ko" onclick="setHubLang('ko')" aria-label="한국어" title="한국어"><img src="/images/flags/kr.svg" alt=""><span>KO</span></button>
            <button type="button" class="wl-lang-btn" data-hub-lang="en" onclick="setHubLang('en')" aria-label="English" title="English"><img src="/images/flags/us.svg?v=2" alt=""><span>EN</span></button>
          </div>
          <button type="button" class="btn-logout" onclick="doLogout()" data-t="logout">로그아웃</button>
        </div>
      </header>
      <div class="hub-wrap">
        <section class="hub-sky" id="hubSky" data-kind="none" data-day="1" aria-label="오늘">
          <canvas class="hub-sky-canvas" id="hubSkyCanvas" aria-hidden="true"></canvas>
          <div class="hub-sky-art" aria-hidden="true"><i class="sk-sun"></i><i class="sk-moon"></i><i class="sk-fog f1"></i><i class="sk-fog f2"></i><i class="sk-cloud c1"></i><i class="sk-cloud c2"></i><i class="sk-cloud c3"></i><i class="sk-flash"></i></div>
          <div class="hub-sky-content">
            <h1 class="hub-greeting" id="hubKicker"></h1>
            <div id="hubSkyBody"></div>
          </div>
          <div class="hub-wx" id="hubWx" hidden></div>
        </section>

        <div class="hub-dash" id="hubDash" aria-live="polite" data-wl-cards=".hub-dcard"></div>

      </div>
    </main>
  </div>

  <!-- ── 승인 대기 목록 (master 전용) ── -->
  <div class="hub-pending-overlay hidden" id="pendingModal">
    <div class="hub-pending-card">
      <div class="hub-pending-head">
        <p data-t="pendingListTitle">승인 대기 목록</p>
        <button class="hub-modal-close" onclick="closePendingPanel()" aria-label="close">
          <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M1.5 1.5l12 12M13.5 1.5l-12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
      <div id="pendingList"></div>
      <section class="hub-reset" id="resetBox"></section>
    </div>
  </div>

  <div class="hub-install-overlay hidden" id="installHelpModal" role="dialog" aria-modal="true" aria-labelledby="installHelpTitle">
    <section class="hub-install-card">
      <button class="hub-modal-close hub-install-close" type="button" onclick="closeInstallHelp()" data-t-aria="close" aria-label="닫기">
        <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M1.5 1.5l12 12M13.5 1.5l-12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
      <img class="hub-install-icon" src="/images/portal-icon.svg?v=2" alt="">
      <h2 id="installHelpTitle" data-t="installHelpTitle">WOLKO 앱 설치</h2>
      <p id="installHelpText"></p>
      <button class="hub-install-confirm" type="button" onclick="closeInstallHelp()" data-t="close">확인</button>
    </section>
  </div>

  <div class="hub-toast" id="hubToast"></div>

  <script is:inline>
    const ICONS = {
