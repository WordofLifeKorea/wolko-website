      + '<path d="M16.2 17.5c1.6-4 4.6-6.2 8-6.4-3.8 1.4-6 4.4-6.8 9.4-.6 3.6-.2 7.4-1.8 10.4-.8-4.2-.9-9 .6-13.4z" fill="#fff" opacity=".55"/>'
