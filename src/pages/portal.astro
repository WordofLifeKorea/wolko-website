    let accessTools = (() => { try { const tk = sessionStorage.getItem('wolko-hub-token'); const me = tk && JSON.parse(sessionStorage.getItem('wolko-hub-me:' + tk.slice(-16)) || 'null'); return me && me.tools !== undefined ? me.tools : null; } catch (e) { return null; } })();
