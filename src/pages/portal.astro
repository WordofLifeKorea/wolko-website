    /** 글의 언어 — 한글이 글자 수의 30% 이상이면 한국어(영어 글 속의 한글 이름은 무시). 서버(detectLang)와 같은 규칙 */
    function langOf(s) { const ko = (String(s).match(/[가-힣]/g) || []).length, en = (String(s).match(/[A-Za-z]/g) || []).length; return ko > 0 && ko / (ko + en) >= 0.3 ? 'ko' : 'en'; }
    /** 공지를 지금 화면 언어로 — 원문과 번역 중 화면 언어인 쪽을 보여 준다(번역이 없으면 원문) */
    function noticeText(n) {
      const orig = langOf((n.title || '') + ' ' + n.body);
