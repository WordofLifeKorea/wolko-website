          await loadDashboard();
        } catch (err) { showToast(err.message, true); }
        btn.disabled = false;
      }
    });

    async function loadExpenseBadge() {
      const token = sessionStorage.getItem('wolko-hub-token');
      if (!token) return;
      try {
        const res = await fetch('/api/expense/reports?scope=counts', { headers: { 'Authorization': 'Bearer ' + token } });
        if (!res.ok) return;
        const c = await res.json();
        let seen = 0; try { seen = Number(localStorage.getItem('wolko-expense-seen')) || 0; } catch (e) {}
        const unseen = (c.alerts || []).filter(a => new Date(a.at).getTime() > seen).length;
        const n = (c.approve || 0) + (c.accounting || 0) + unseen;
        // 경비 리포트 메뉴(사이드바 · 모바일 서랍)에 처리할 건수를 작은 빨간 숫자로 보여 준다
        document.querySelectorAll('a.hub-nav-item[href="/portal/expense"]').forEach(row => {
          row.querySelector('.hub-nav-alert')?.remove();
          if (n) row.insertAdjacentHTML('beforeend', '<span class="hub-nav-alert" aria-label="' + n + '">' + n + '</span>');
        });
      } catch (e) {}
    }

    function renderNav() {
      const item = tool => `
        <a class="hub-nav-item" href="${tool.href}" style="--item-color:${tool.color}" onclick="markVisited('${tool.href}')">
          <span class="hub-nav-item-icon">
            ${(window.WolkoArt && window.WolkoArt[tool.href]) ? '<svg class="wolko-art" width="22" height="22" viewBox="0 0 32 32" aria-hidden="true" focusable="false">' + window.WolkoArt[tool.href] + '</svg>' : '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">' + (ICONS[tool.icon] || '') + '</svg>'}
          </span>
          <span class="hub-nav-item-label">${hubLang === 'en' ? tool.title_en : tool.title_ko}</span>
        </a>`;
      $('hubNav').innerHTML = `<div class="hub-drawer-head"><img src="/images/WOLKO Circle.png" alt=""><b>WOLKO Portal</b><button type="button" class="hub-drawer-close" aria-label="${hubLang === 'en' ? 'Close menu' : '메뉴 닫기'}" onclick="toggleHubNav(false)">×</button></div>` + GROUPS.map(g => {
        const open = TOOLS.filter(x => x.group === g.id && toolOpen(x.href));
        return open.length ? `
        <p class="hub-nav-label">${hubLang === 'en' ? g.en : g.ko}</p>
        ${open.map(item).join('')}
      ` : '';
      }).join('');
    }

    // 메뉴 아이콘 일러스트는 지연 로드되는 wolko-rail.js(window.WolkoArt)에서 오므로, 문서가 다 읽힌 뒤 한 번 더 그린다
    document.addEventListener('DOMContentLoaded', () => { if (window.WolkoArt) { renderNav(); loadExpenseBadge(); } });

    /** 좁은 화면의 햄버거 메뉴 — 왼쪽에서 도구 목록(사이드바)이 밀려 나온다. 바깥을 누르거나 Esc, 메뉴를 고르면 닫힌다 */
    function toggleHubNav(force) {
      const open = typeof force === 'boolean' ? force : !document.body.classList.contains('hub-nav-open');
      document.body.classList.toggle('hub-nav-open', open);
      const b = $('hubBurger'); if (b) { b.setAttribute('aria-expanded', open ? 'true' : 'false'); b.setAttribute('aria-label', hubLang === 'en' ? (open ? 'Close menu' : 'Open menu') : (open ? '메뉴 닫기' : '메뉴 열기')); }
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape' && document.body.classList.contains('hub-nav-open')) toggleHubNav(false); });
    document.addEventListener('click', e => { if (e.target.closest && e.target.closest('.hub-nav-item') && document.body.classList.contains('hub-nav-open')) toggleHubNav(false); });
    window.addEventListener('resize', () => { if (window.innerWidth >= 768 && document.body.classList.contains('hub-nav-open')) toggleHubNav(false); });
    function applyLangToDOM() {
      document.documentElement.lang = hubLang === 'en' ? 'en' : 'ko';
      document.title = 'WOLKO Portal';
      document.querySelectorAll('[data-t]').forEach(el => {
        el.textContent = t(el.getAttribute('data-t'));
      });
      document.querySelectorAll('[data-t-title]').forEach(el => { el.title = t(el.dataset.tTitle); });
      document.querySelectorAll('[data-t-aria]').forEach(el => { el.setAttribute('aria-label', t(el.dataset.tAria)); });
      $('signupNameInput').placeholder = t('namePlaceholder');
      $('signupPhoneInput').placeholder = t('phonePlaceholder');
      $('signupPwInput').placeholder = t('signupPwPlaceholder');
      updateSignupMode(); // 언어를 바꾸면 data-t 가 버튼 글자를 되돌리므로 가입 방식에 맞는 글자로 다시 맞춘다
      document.querySelectorAll('[data-hub-lang]').forEach(b => { b.classList.toggle('is-active', b.dataset.hubLang === hubLang); b.setAttribute('aria-pressed', String(b.dataset.hubLang === hubLang)); });
      fillSignupStatusText(); // 가입 뒤 안내 화면: 제목 · 설명 · 받는 주소 줄 · 남은 시간 글을 새 언어로(보여 줄 때 한 번만 채우던 것)
      renderNav();
      renderDash();
      loadExpenseBadge();
    }
    function setHubLang(lang) {
      hubLang = lang;
      localStorage.setItem('wolko-lang', hubLang);
      localStorage.removeItem('wolkoHubLang');
      applyLangToDOM();
    }

    let deferredInstallPrompt = null;
    function isPortalStandalone() {
      return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
    }
    const SHOW_INSTALL_BUTTON = false;   // 앱 설치 버튼은 일단 숨긴다 — 다시 보이려면 true 로
    function syncInstallButton() {
      const button = $('installAppBtn');
      if (button) button.hidden = !SHOW_INSTALL_BUTTON || isPortalStandalone();
    }
    function installHelpMessage() {
      const ua = navigator.userAgent;
      const isIOS = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
      const isSafari = /Safari/.test(ua) && !/Chrome|CriOS|Edg|OPR|Android/.test(ua);
      return isIOS ? t('installHelpIOS') : (isSafari ? t('installHelpSafari') : t('installHelpDefault'));
    }
    function openInstallHelp() {
      $('installHelpText').textContent = installHelpMessage();
      $('installHelpModal').classList.remove('hidden');
      document.body.classList.add('hub-modal-open');
      document.querySelector('.hub-install-close')?.focus();
    }
    function closeInstallHelp() {
      $('installHelpModal').classList.add('hidden');
      document.body.classList.remove('hub-modal-open');
      $('installAppBtn')?.focus();
    }
    async function installPortalApp() {
      if (isPortalStandalone()) return;
      if (!deferredInstallPrompt) { openInstallHelp(); return; }
      deferredInstallPrompt.prompt();
      await deferredInstallPrompt.userChoice;
      deferredInstallPrompt = null;
    }
    window.addEventListener('beforeinstallprompt', event => {
      event.preventDefault();
      deferredInstallPrompt = event;
      syncInstallButton();
    });
    window.addEventListener('appinstalled', () => {
      deferredInstallPrompt = null;
      syncInstallButton();
      showToast(t('installDone'));
    });
    window.matchMedia('(display-mode: standalone)').addEventListener?.('change', syncInstallButton);
    $('installHelpModal').addEventListener('click', event => {
      if (event.target === $('installHelpModal')) closeInstallHelp();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !$('installHelpModal').classList.contains('hidden')) closeInstallHelp();
    });

    /* ── 화면 전환 ── */
    const SCREENS = ['emailScreen', 'signupScreen', 'statusScreen', 'resetRequestScreen', 'resetNewScreen'];
    function showScreen(id, focusTitle = true) {
      SCREENS.forEach(s => {
        $(s).style.display = s === id ? 'flex' : 'none';
        $(s).classList.toggle('hidden', s !== id);
      });
      // 누른 단추가 사라진 화면에 남지 않게, 새 화면 제목으로 초점을 옮긴다(화면 읽기 프로그램이 제목을 읽는다)
      if (focusTitle) { const title = $(id).querySelector('.login-title'); if (title) title.focus({ preventScroll: true }); $(id).scrollTop = 0; }
    }

    /* ── 로그인 전 화면의 오류 표시: 빨간 글씨 + 틀린 칸 빨간 테두리 + 그 칸으로 초점. 다시 입력하면 지운다 ── */
    function authError(el, message, field) {
      el.textContent = message; el.classList.remove('is-ok');
      if (field) { field.setAttribute('aria-invalid', 'true'); field.focus(); }
    }
    function authOk(el, message) { el.textContent = message; el.classList.add('is-ok'); }

    /* ── 보내는 동안의 제출 단추: disabled 대신 aria-disabled 로 막는다 ──
       disabled 는 누른 단추를 초점에서 빼서, 실패한 뒤 초점이 body 로 떨어진다(화면 읽기가 어디인지 잃음).
       aria-disabled 는 초점을 그대로 두고, 그동안 다시 누르거나 Enter 를 쳐도 sendLocked 에서 걸러 요청이 한 번만 간다.
       모양은 아래 <style> 의 [aria-disabled="true"] 규칙이 지금의 :disabled 모양과 같게 그린다. */
    const sendLocked = btn => btn.getAttribute('aria-disabled') === 'true';
    function lockSend(btn, on) {
      if (on) { btn.setAttribute('aria-disabled', 'true'); btn.setAttribute('aria-busy', 'true'); }
      else { btn.removeAttribute('aria-disabled'); btn.removeAttribute('aria-busy'); }
    }
    // 실패한 뒤: 오류 칸으로 옮긴 초점이 없으면 누른 단추에 둔다(사파리는 마우스로 누른 단추에 초점을 주지 않아서 body 에 남을 수 있음)
    function keepFocusOn(btn) {
      const active = document.activeElement;
      if (!active || active === document.body || active === document.documentElement) btn.focus({ preventScroll: true });
    }

    /* ── 로그인 전 화면이 서버를 부를 때의 공통 처리: 'Load failed' · 'did not match' 같은 기술 오류 문장을 화면에 내지 않는다 ──
       · 연결 자체가 안 됨(오프라인 등)        → '연결 실패' 문구(authNetFail)
       · 답이 JSON이 아님(서버 오류 페이지 등)  → '서버 문제' 문구(authServerFail)
       · 서버가 오류 글(error)을 줌             → 그 글 그대로
       · 오류 글이 없음                         → 상황에 맞는 문구(fallbackKey), 5xx 면 '서버 문제'
       화면에 내는 글은 AuthFail 에 담아 던진 것뿐이다. 그 밖의 예외는 콘솔에만 남기고 '서버 문제' 문구를 보인다. */
    class AuthFail extends Error { constructor(message, field) { super(message); this.field = field || null; } }
    async function authPost(url, body) {
      let res, data = null;
      try {
        res = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
      } catch (e) { throw new AuthFail(t('authNetFail')); }
      try { data = await res.json(); } catch (e) { data = null; }
      if (!data || typeof data !== 'object') throw new AuthFail(t('authServerFail'));
      return { res, data };
    }
    function authFailText(res, data, fallbackKey) {
      const serverText = data && typeof data.error === 'string' ? data.error.trim() : '';
      if (serverText) return serverText;
      return t(res.status >= 500 || !fallbackKey ? 'authServerFail' : fallbackKey);
    }
    function authCaught(e) {
      if (e instanceof AuthFail) return e.message;
      console.error(e);
      return t('authServerFail');
    }

    function clearAuthErrors(card) {
      card.querySelectorAll('[aria-invalid="true"]').forEach(f => f.removeAttribute('aria-invalid'));
      card.querySelectorAll('.login-error:not(.is-ok)').forEach(e => { e.textContent = ''; });
    }
    document.addEventListener('input', event => {
      const field = event.target.closest && event.target.closest('.portal-auth input');
      if (!field || field.type === 'radio' || field.type === 'checkbox') return;
      if (field.getAttribute('aria-invalid') === 'true') clearAuthErrors(field.closest('.login-card'));
    });

    const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    const rememberedEmail = window.WolkoSession.rememberedEmail();
    $('emailInput').value = rememberedEmail;
    $('rememberEmail').checked = !!rememberedEmail;
    $('rememberEmail').addEventListener('change', () => {
      if (!$('rememberEmail').checked) window.WolkoSession.rememberEmail('', false);
    });
    function saveRememberedEmail(email) {
      window.WolkoSession.rememberEmail(email, $('rememberEmail').checked);
    }

    async function offerCredentialUpdate() {
      if (!navigator.credentials?.store || typeof window.PasswordCredential === 'undefined') return;
      try {
        const credential = new window.PasswordCredential($('portalLoginForm'));
        await navigator.credentials.store(credential);
      } catch (e) {
        // Password managers decide whether to show a save/update prompt.
      }
    }

    /* ── 이메일+비밀번호 로그인 ── */
    async function doAccountLogin() {
      const btn = $('emailBtn');
      if (sendLocked(btn)) return;   // 보내는 중에 다시 누르거나 Enter — 한 번만 보낸다
      const email = $('emailInput').value.trim().toLowerCase();
      const password = $('loginPwInput').value;
      const errEl = $('emailError');
      clearAuthErrors($('emailScreen'));
      errEl.classList.remove('is-ok'); errEl.textContent = '';
      if (!email) { authError(errEl, t('emailRequired'), $('emailInput')); return; }
      if (!EMAIL_RE.test(email)) { authError(errEl, t('emailInvalid'), $('emailInput')); return; }
      if (!password) { authError(errEl, t('passwordRequired'), $('loginPwInput')); return; }

      lockSend(btn, true);
      const original = btn.textContent;
      btn.textContent = t('loginVerifying');

      try {
        const { res, data } = await authPost('/api/hub/account-login', { email, password });
        // 카운슬러 계정은 포탈 계정과 완전히 별개다: 포탈에 없는 이메일(404)일 때만 카운슬러 로그인을 시도한다.
        // (예전에는 role 이 'counselor' 인 계정도 여기로 보냈는데, 지금 'counselor'는 일반 멤버의 내부 이름이라
        //  승인된 일반 멤버가 모두 카운슬러 로그인으로 넘어가 '계정을 찾을 수 없거나 비활성화' 오류를 만났다.)
        if (res.status === 404) {
          const { res: counselorRes, data: counselorData } = await authPost('/api/camp-progress/auth', { mode: 'login', email, password });
          if (!counselorRes.ok || counselorData.role !== 'counselor' || !counselorData.token) {
            // 카운슬러 쪽에도 계정이 없을 때는 포탈의 안내(가입되지 않은 이메일)를 그대로 보여준다
            throw new AuthFail(counselorRes.status === 401 && /찾을 수 없/.test(counselorData.error || '') ? authFailText(res, data, 'loginWrong') : authFailText(counselorRes, counselorData, 'loginWrong'));
          }
          sessionStorage.setItem('wolko-camp-progress-token', counselorData.token);
          saveRememberedEmail(email);
          sessionStorage.setItem('wolko-camp-progress-role', 'counselor');
          sessionStorage.removeItem('wolko-hub-token');
          sessionStorage.removeItem('wolko-hub-email');
          sessionStorage.removeItem('wolko-hub-role');
          await offerCredentialUpdate();
          location.replace('/portal/campstaff');
          return;
        }
        if (!res.ok) throw new AuthFail(authFailText(res, data, 'loginWrong'), res.status === 401 ? $('loginPwInput') : null);
        saveRememberedEmail(email);
        applySession(data);
        await offerCredentialUpdate();
        location.replace('/portal/?signed-in=1');
      } catch (e) {
        authError(errEl, authCaught(e), e instanceof AuthFail ? e.field : null);
        keepFocusOn(btn);
      } finally {
        lockSend(btn, false);
        btn.textContent = original;
      }
    }
    $('portalLoginForm').addEventListener('submit', event => {
      event.preventDefault();
      doAccountLogin();
    });

    /* ── 이메일+비밀번호 가입 ── */
    // wolko.org · wol.org 일반 멤버는 메일 인증으로 끝난다(비밀번호는 메일의 링크에서 정한다). 그 밖의 이메일·관리자 신청은 마스터 승인.
    // 관리자 권한은 코드의 관리자 목록(functions/lib/hubAccounts.js)에 있는 분만 받는다 — 그래서 가입 화면에 '관리자'를
    // 일반 멤버와 나란히 두지 않고, wolko.org · wol.org 메일을 적었을 때만 작은 '관리자 권한이 필요하신가요?' 링크로 요청한다.
    let wantsAdmin = false;
    const isOrgEmail = email => /^[^\s@]+@(wolko\.org|wol\.org)$/i.test(email);
    function isAutoSignup() {
      return !wantsAdmin && isOrgEmail($('signupEmailInput').value.trim());
    }
    function updateSignupMode() {
      const email = $('signupEmailInput').value.trim();
      const org = isOrgEmail(email);
      if (!org) wantsAdmin = false;
      const auto = isAutoSignup();
      $('signupPwWrap').hidden = auto;
      $('signupBtn').textContent = t(auto ? 'signupBtnVerify' : 'signupBtn');
      const hint = $('signupDomainHint');
      hint.hidden = !EMAIL_RE.test(email);
      hint.textContent = auto ? t('domainHintOrg') : (wantsAdmin ? t('domainHintAdmin') : t('domainHintOther'));
      const adminBtn = $('adminReqBtn');
      adminBtn.hidden = !org;
      adminBtn.textContent = t(wantsAdmin ? 'adminReqClose' : 'adminReqOpen');
      adminBtn.setAttribute('aria-pressed', String(wantsAdmin));
    }
    $('signupEmailInput').addEventListener('input', updateSignupMode);
    $('adminReqBtn').addEventListener('click', () => {
      wantsAdmin = !wantsAdmin;
      updateSignupMode();
      if (wantsAdmin) $('signupPwInput').focus();
    });
    const PHONE_RE = /^[0-9+\-\s()]{7,20}$/;
    const PASSWORD_RE = /^[\x21-\x7E]{8,}$/;   // 서버(functions/lib/hubAccounts.js isValidPassword)와 같은 규칙: 띄어쓰기 없는 영문 · 숫자 · 기호 8자 이상
    async function doSignup() {
      const btn = $('signupBtn');
      if (sendLocked(btn)) return;   // 보내는 중에 다시 누르거나 Enter — 한 번만 보낸다
      const name = $('signupNameInput').value.trim();
      const phone = $('signupPhoneInput').value.trim();
      const email = $('signupEmailInput').value.trim().toLowerCase();
      const password = $('signupPwInput').value;
      const campus = document.querySelector('input[name="signupCampus"]:checked')?.value || 'wolko';
      const requestedRole = wantsAdmin && isOrgEmail(email) ? 'admin' : 'member';
      const errEl = $('signupError');
      clearAuthErrors($('signupScreen'));
      errEl.textContent = '';
      if (!name) { authError(errEl, t('nameRequired'), $('signupNameInput')); return; }
      if (!phone) { authError(errEl, t('phoneRequired'), $('signupPhoneInput')); return; }
      if (!PHONE_RE.test(phone)) { authError(errEl, t('phoneInvalid'), $('signupPhoneInput')); return; }
      if (!email) { authError(errEl, t('emailRequired'), $('signupEmailInput')); return; }
      if (!EMAIL_RE.test(email)) { authError(errEl, t('emailInvalid'), $('signupEmailInput')); return; }
      const auto = isAutoSignup();
      if (!auto && !password) { authError(errEl, t('passwordRequired'), $('signupPwInput')); return; }
      if (!auto && !PASSWORD_RE.test(password)) { authError(errEl, t('passwordInvalid'), $('signupPwInput')); return; }

      lockSend(btn, true);
      const original = btn.textContent;
      btn.textContent = t('signupSending');

      try {
        const { res, data } = await authPost('/api/hub/signup', { name, phone, email, password, campus, requestedRole });
        if (!res.ok) throw new AuthFail(authFailText(res, data, 'sendFail'));
        // 다시 보내기 · 주소 고치기를 위해 보낸 내용을 기억하고, 입력한 칸도 그대로 둔다(고치러 돌아와도 처음부터 다시 쓰지 않게)
        lastSignup = { name, phone, email, password, campus, requestedRole };
        showSignupStatus(data.status, email);
      } catch (e) {
        authError(errEl, authCaught(e));
        keepFocusOn(btn);
      } finally {
        lockSend(btn, false);
        btn.textContent = original;
      }
    }
    $('signupForm').addEventListener('submit', event => { event.preventDefault(); doSignup(); });

    /* ── 가입 뒤 안내: 받는 주소를 보여 주고, 메일 다시 보내기(1분 간격) · 주소 고치기 · 문의할 곳 ── */
    let lastSignup = null, resendTimer = null;
    // 안내 화면이 지금 보여 주는 상태(verify · pending · 승인)와 받는 주소. 언어를 바꾸면 applyLangToDOM 이 이것으로 글자를 다시 채운다
    let statusShown = null, resendLeft = 0;
    function fillSignupStatusText() {
      if (!statusShown) return;
      const { status, email } = statusShown;
      const verify = status === 'verify', pending = status === 'pending';
      $('statusTitle').textContent = t(verify ? 'verifySentTitle' : pending ? 'pendingStatusTitle' : 'signupApprovedTitle');
      $('statusDesc').textContent = t(verify ? 'verifySentDesc' : pending ? 'pendingStatusDesc' : 'signupApprovedDesc');
      $('statusEmail').textContent = verify ? t('sentToLine', email) : pending ? t('pendingToLine', email) : '';
      const wait = $('statusResendWait');
      if (!wait.hidden && resendLeft > 0) wait.textContent = t('resendWait', resendLeft);
      // 알림 줄(#statusMsg)도 화면이 만든 문장(다시 보냈어요 · 연결 실패 · 서버 문제 · 보내지 못함)이면 새 언어로. 서버가 준 오류 글은 그대로 둔다
      const msg = $('statusMsg');
      const key = ['resendDone', 'authNetFail', 'authServerFail', 'sendFail'].find(k => msg.textContent && (msg.textContent === HUB_T.ko[k] || msg.textContent === HUB_T.en[k]));
      if (key) msg.textContent = t(key);
    }
    function showSignupStatus(status, email) {
      const verify = status === 'verify', pending = status === 'pending';
      statusShown = { status, email };
      fillSignupStatusText();
      $('statusEmail').hidden = !(verify || pending);
      $('statusContact').hidden = !pending;
      $('statusActions').hidden = !verify;
      $('statusFixBtn').hidden = !verify;
      // 할 일이 있는 상태(확인 메일)에서는 '로그인 화면으로'를 가장 조용한 글자 링크로, 승인 대기는 테두리 단추, 승인 완료는 주 단추
      $('statusLoginBtn').className = verify ? 'login-link-btn auth-status-exit' : pending ? 'auth-secondary-btn' : 'login-btn';
      $('statusMsg').textContent = ''; $('statusMsg').classList.remove('is-ok');
      if (verify) startResendWait(); else stopResendWait();
      if (!verify && !pending) $('emailInput').value = email;
      showScreen('statusScreen');
    }
    // 기다리는 동안 disabled 대신 aria-disabled 로 막는다 — 누른 단추에 초점이 그대로 남는다(disabled 는 초점을 body 로 떨어뜨림).
    // 남은 시간은 단추 이름이 아니라 아래 작은 글(#statusResendWait)에 쓴다: 단추 이름이 매초 바뀌어 읽히지 않게.
    function setResendBlocked(on) { $('statusResendBtn').setAttribute('aria-disabled', on ? 'true' : 'false'); }
    function stopResendWait() {
      clearInterval(resendTimer); resendTimer = null; resendLeft = 0;
      const wait = $('statusResendWait'); wait.hidden = true; wait.textContent = '';
      setResendBlocked(false);
    }
    function startResendWait(seconds = 60) {
      const wait = $('statusResendWait');
      clearInterval(resendTimer);
      let left = seconds;
      const tick = () => {
        if (left <= 0) { stopResendWait(); return; }
        setResendBlocked(true);
        resendLeft = left;
        wait.hidden = false; wait.textContent = t('resendWait', left);
        left--;
      };
      tick(); resendTimer = setInterval(tick, 1000);
    }
    let resendSending = false;
    $('statusResendBtn').addEventListener('click', async () => {
      const btn = $('statusResendBtn'), msg = $('statusMsg');
      if (!lastSignup || resendSending || btn.getAttribute('aria-disabled') === 'true') return;
      resendSending = true; setResendBlocked(true); btn.setAttribute('aria-busy', 'true');
      msg.textContent = ''; msg.classList.remove('is-ok');
      try {
        const { res, data } = await authPost('/api/hub/signup', lastSignup);
        if (!res.ok) throw new AuthFail(authFailText(res, data, 'sendFail'));
        authOk(msg, t('resendDone'));
        startResendWait();
      } catch (e) { authError(msg, authCaught(e)); setResendBlocked(false); }
      finally { resendSending = false; btn.removeAttribute('aria-busy'); }
    });
    $('statusFixBtn').addEventListener('click', () => {
      showScreen('signupScreen', false);
      const field = $('signupEmailInput'); field.focus(); field.select();
    });

    function applySession(data) {
      currentSession = { email: data.email, role: data.role };
      sessionStorage.setItem('wolko-hub-token', data.hubToken);
      sessionStorage.setItem('wolko-hub-email', data.email || '');
      sessionStorage.setItem('wolko-hub-role', data.role || '');
      window.WolkoSession.persistLogin(!!($('keepLogin') && $('keepLogin').checked));
    }

    function doLogout() {
      /* 이 기기에 저장된 로그인 유지 정보까지 함께 지운다 */
      window.WolkoSession.logoutAll();
    }

    function showHub() {
      SCREENS.forEach(s => { $(s).style.display = 'none'; });
      $('hubShell').hidden = false;
      $('authLang').hidden = true;
      loadDashboard();
      $('pendingBtn').hidden = currentSession?.role !== 'master';
      if (currentSession?.role === 'master') refreshPendingCount();
      syncRole();
      if (window.wolkoCheckPasswordReset) window.wolkoCheckPasswordReset(); // 임시 비밀번호로 들어왔다면 새 비밀번호 설정 창
    }

    /* 등급은 서버(코드의 등급 목록)가 정한다 — '로그인 유지'로 예전에 저장해 둔 등급이 남아 있으면 서버 값으로 바로잡는다.
       (예: 관리자였다가 마스터가 된 계정이 다시 로그인하지 않아도 승인 대기 단추가 보이게) */
    async function syncRole() {
      try {
        const res = await fetch('/api/hub/me', { headers: authHeaders(), cache: 'no-store' });
        if (!res.ok) return;
        const me = await res.json();
        if (me && sessionStorage.getItem('wolko-hub-welcome')) { sessionStorage.removeItem('wolko-hub-welcome'); showWelcome(me.name || ''); }
        if (!me || !me.role || !currentSession || me.role === currentSession.role) return;
        currentSession.role = me.role;
        sessionStorage.setItem('wolko-hub-role', me.role);
        try { if (localStorage.getItem('wolko-hub-role') !== null) localStorage.setItem('wolko-hub-role', me.role); } catch (e) {}
        $('pendingBtn').hidden = me.role !== 'master';
        if (me.role === 'master') refreshPendingCount();
      } catch (e) {}
    }

    function showWelcome(name) {
      const box = document.createElement('div');
      box.className = 'auth-welcome'; box.setAttribute('role', 'status');
      const text = document.createElement('span'); text.textContent = t('welcomeToast', name || '');
      const close = document.createElement('button'); close.type = 'button'; close.textContent = t('welcomeClose');
      const done = () => { box.classList.add('is-leaving'); setTimeout(() => box.remove(), 300); };
      close.addEventListener('click', done);
      box.append(text, close); document.body.append(box);
      setTimeout(done, 8000);
    }

    function isHubTokenValid(token) {
      try {
        const decoded = atob(token);
        const lastColon = decoded.lastIndexOf(':');
        const data = decoded.slice(0, lastColon);
        const parts = data.split(':');
        if (parts[0] !== 'wolko-hub' || parts.length !== 4) return false;
        const expires = parseInt(parts[3], 10);
        return !!expires && Date.now() < expires;
      } catch (e) {
        return false;
      }
    }

    /* ── 승인 대기 패널 (master 전용) ── */
    function authHeaders() {
      return { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + sessionStorage.getItem('wolko-hub-token') };
    }
    function formatRequestedAt(iso) {
      if (!iso) return '';
      try { return new Date(iso).toLocaleString(hubLang === 'en' ? 'en-US' : 'ko-KR'); } catch (e) { return ''; }
    }
    async function refreshPendingCount() {
      try {
        // 확인되기 전과 실패했을 때는 빨간 점을 숨겨 둔다 — 대기 건수가 실제로 1건 이상일 때만 숫자와 함께 보인다.
        const badge = $('pendingCount');
        const res = await fetch('/api/hub/pending', { headers: authHeaders() });
        if (!res.ok) { badge.textContent = ''; badge.classList.add('hidden'); return; }
        const data = await res.json();
        const pendingCount = (data.accounts || []).filter(a => a.status === 'pending').length;
        badge.textContent = pendingCount || '';
        badge.classList.toggle('hidden', !pendingCount);
      } catch (e) { const badge = $('pendingCount'); if (badge) { badge.textContent = ''; badge.classList.add('hidden'); } }
    }
    function renderPendingItem(a, rejected) {
      if (rejected && !a.requestedRole && a.role) a = { ...a, requestedRole: a.role }; // 다시 활성화할 때 기존 등급을 미리 골라 둔다
      // admin 역할은 @wol.org 이메일에만 부여 가능(approve.js가 다시 검증) —
      // 드롭다운에서도 애초에 고를 수 없게 옵션 자체를 숨긴다.
      const isWol = /@(wol|wolko)\.org$/i.test(a.email);
      const adminOption = a.adminAllowed ? `<option value="admin">${t('roleAdmin')}</option>` : '';
      const counselorOption = `<option value="counselor">${t('roleCounselor')}</option>`;
      const nameLine = a.name ? `${esc(a.name)}${a.phone ? ' · ' + esc(a.phone) : ''}` : '';
      const wantsAdmin = a.requestedRole === 'admin' && a.adminAllowed;
      const requestedLine = a.requestedRole ? `${t('requestedLabel')}: ${a.requestedRole === 'admin' ? t('roleAdmin') + (a.adminAllowed ? '' : ' (' + t('adminNotListed') + ')') : t('roleCounselor')}` : '';
      return `
          <div class="hub-pending-item">
            <div>
              <p class="hub-pending-email">${esc(a.email)}</p>
              ${nameLine ? `<p class="hub-pending-role">${nameLine}</p>` : ''}
              ${requestedLine ? `<p class="hub-pending-role"><b>${esc(requestedLine)}</b></p>` : ''}
              <p class="hub-pending-role">${esc(formatRequestedAt(a.requestedAt))}</p>
            </div>
            <div class="hub-pending-actions">
              <select class="hub-pending-role-select">
                <option value="" disabled ${a.requestedRole ? '' : 'selected'}>${t('rolePlaceholder')}</option>
                ${adminOption.replace('<option value="admin">', wantsAdmin ? '<option value="admin" selected>' : '<option value="admin">')}${counselorOption.replace('<option value="counselor">', a.requestedRole && !wantsAdmin ? '<option value="counselor" selected>' : '<option value="counselor">')}
              </select>
              <button class="hub-pending-approve" onclick="respondToRequest('${esc(a.email)}','approve',this)">${rejected ? t('reapproveBtn') : t('approveBtn')}</button>
              ${rejected ? '' : `<button class="hub-pending-reject" onclick="respondToRequest('${esc(a.email)}','reject',this)">${t('rejectBtn')}</button>`}
            </div>
          </div>`;
    }
    async function openPendingPanel() {
      $('pendingModal').classList.remove('hidden');
      $('pendingList').innerHTML = '';
      try {
        const res = await fetch('/api/hub/pending', { headers: authHeaders() });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        const pending = (data.accounts || []).filter(a => a.status === 'pending');
        renderResetBox((data.accounts || []).filter(a => a.status === 'approved' && a.effectiveRole !== 'master'), (data.accounts || []).filter(a => a.effectiveRole !== 'master'));
        const rejected = (data.accounts || []).filter(a => a.status === 'rejected');
        const rejectedHtml = rejected.length
          ? `<div class="hub-rejected"><h4>${t('rejectedTitle')}</h4><p class="hub-reset-help">${t('rejectedHelp')}</p>${rejected.map(a => renderPendingItem(a, true)).join('')}</div>`
          : '';
        $('pendingList').innerHTML = (pending.length ? pending.map(a => renderPendingItem(a, false)).join('') : `<p class="hub-pending-empty">${t('pendingEmpty')}</p>`) + rejectedHtml;
      } catch (e) {
        $('pendingList').innerHTML = `<p class="hub-pending-empty">${esc(e.message || '')}</p>`;
      }
    }
    function renderResetBox(accounts, allAccounts) {
      const list = accounts.slice().sort((x, y) => String(x.name || x.email).localeCompare(String(y.name || y.email), 'ko'));
      $('resetBox').innerHTML = `
        <h4>${t('resetTitle')}</h4>
        <p class="hub-reset-help">${t('resetHelp')}</p>
        <label>${t('resetPick')}<select id="resetEmail">${list.map(a => `<option value="${esc(a.email)}">${esc(a.name || a.email)} · ${esc(a.email)}</option>`).join('')}</select></label>
        <label>${t('resetTemp')}<input id="resetTemp" type="text" value="1234" autocomplete="off" autocapitalize="off"></label>
        <button type="button" class="hub-reset-btn" id="resetBtn">${t('resetBtn')}</button>
        <div class="hub-delete">
          <h4>${t('deleteTitle')}</h4>
          <p class="hub-reset-help">${t('deleteHelp')}</p>
          <label>${t('resetPick')}<select id="deleteEmail">${allAccounts.slice().sort((x, y) => String(x.name || x.email).localeCompare(String(y.name || y.email), 'ko')).map(a => `<option value="${esc(a.email)}">${esc(a.name || a.email)} · ${esc(a.email)}${a.status !== 'approved' ? ' (' + esc(a.status) + ')' : ''}</option>`).join('')}</select></label>
          <button type="button" class="hub-reset-btn hub-delete-btn" id="deleteBtn">${t('deleteBtn')}</button>
        </div>`;
      $('deleteBtn').addEventListener('click', async () => {
        const sel = $('deleteEmail');
        if (!sel.value) return;
        const typed = prompt(t('deletePrompt', sel.value));
        if (typed === null) return;
        try {
          const res = await fetch('/api/hub/delete-account', { method: 'POST', headers: authHeaders(), body: JSON.stringify({ email: sel.value, confirm: typed }) });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          showToast(t('deleteDone'));
          openPendingPanel(); refreshPendingCount();
        } catch (e) { showToast(e.message || '', true); }
      });
      $('resetBtn').addEventListener('click', async () => {
        const sel = $('resetEmail');
        if (!sel.value) return;
        const label = sel.options[sel.selectedIndex].textContent.split(' · ')[0];
        if (!confirm(t('resetConfirm', label, sel.value))) return;
        try {
          const res = await fetch('/api/hub/reset-password', { method: 'POST', headers: authHeaders(), body: JSON.stringify({ email: sel.value, tempPassword: $('resetTemp').value }) });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error);
          showToast(t('resetDone'));
        } catch (e) { showToast(e.message || '', true); }
      });
    }
    function closePendingPanel() {
      $('pendingModal').classList.add('hidden');
    }
    async function respondToRequest(email, action, btnEl) {
      let role;
      if (action === 'approve') {
        const select = btnEl.closest('.hub-pending-actions').querySelector('.hub-pending-role-select');
        role = select.value;
        if (!role) { showToast(t('roleRequiredToast'), true); return; }
      }
      try {
        const res = await fetch('/api/hub/approve', {
          method: 'POST',
          headers: authHeaders(),
          body: JSON.stringify({ email, action, role }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error);
        showToast(action === 'approve' ? t('approvedToast') : t('rejectedToast'));
        openPendingPanel();
        refreshPendingCount();
      } catch (e) {
        showToast(e.message || '', true);
      }
    }
    function esc(s) {
      return String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    }

    /* ── 메일 링크로 들어온 화면: 비밀번호 재설정(?reset=) / 가입 확인(?verify=) 은 같은 비밀번호 정하기 화면을 쓴다 ── */
    const linkParams = () => new URLSearchParams(location.search);
    const verifyToken = () => linkParams().get('verify') || '';
    function setVerifyMode(on) {
      const screen = $('resetNewScreen');
      const title = screen.querySelector('.login-title'), desc = screen.querySelector('.login-description'), again = screen.querySelector('.login-link-btn');
      title.dataset.t = on ? 'verifyNewTitle' : 'resetNewTitle';
      desc.dataset.t = on ? 'verifyNewDesc' : 'resetNewDesc';
      again.dataset.t = on ? 'verifyAgainBtn' : 'resetAgainBtn';
      again.setAttribute('onclick', on ? "showScreen('signupScreen')" : "showScreen('resetRequestScreen')");
      const btn = $('resetNewBtn'); btn.dataset.t = on ? 'verifyFinishBtn' : 'resetNewBtn';
      title.textContent = t(title.dataset.t); desc.textContent = t(desc.dataset.t); again.textContent = t(again.dataset.t); btn.textContent = t(btn.dataset.t);
    }

    /* ── 비밀번호 재설정 (메일 링크) ── */
    $('resetRequestForm').addEventListener('submit', async event => {
      event.preventDefault();
      const btn = $('resetReqBtn');
      if (sendLocked(btn)) return;   // 보내는 중에 다시 누르거나 Enter — 한 번만 보낸다
      const msg = $('resetReqMsg'); msg.textContent = ''; msg.classList.remove('is-ok');
      const email = $('resetEmailInput').value.trim().toLowerCase();
      if (!email) { authError(msg, t('emailRequired'), $('resetEmailInput')); return; }
      if (!EMAIL_RE.test(email)) { authError(msg, t('emailInvalid'), $('resetEmailInput')); return; }
      lockSend(btn, true);
      try {
        const { res, data } = await authPost('/api/hub/password-reset', { action: 'request', email });
        if (!res.ok) throw new AuthFail(authFailText(res, data, 'sendFail'));
        authOk(msg, t('resetReqSent'));
      } catch (e) { authError(msg, authCaught(e)); keepFocusOn(btn); }
      finally { lockSend(btn, false); }
    });
    $('resetNewForm').addEventListener('submit', async event => {
      event.preventDefault();
      const btn = $('resetNewBtn');
      if (sendLocked(btn)) return;   // 보내는 중에 다시 누르거나 Enter — 한 번만 보낸다
      const msg = $('resetNewMsg'); clearAuthErrors($('resetNewScreen')); msg.textContent = '';
      const pw = $('resetNewPw').value;
      if (!PASSWORD_RE.test(pw)) { authError(msg, t('resetShort'), $('resetNewPw')); return; }
      if (pw !== $('resetNewPw2').value) { authError(msg, t('resetMismatch'), $('resetNewPw2')); return; }
      lockSend(btn, true);
      try {
        const verifying = !!verifyToken();
        const token = verifying ? verifyToken() : (linkParams().get('reset') || '');
        const { res, data } = verifying
          ? await authPost('/api/hub/verify-email', { token, newPassword: pw })
          : await authPost('/api/hub/password-reset', { action: 'confirm', token, newPassword: pw });
        if (!res.ok) throw new AuthFail(authFailText(res, data));
        history.replaceState(null, '', '/portal/');
        setVerifyMode(false);
        if (data.email) $('emailInput').value = data.email;
        if (verifying) { try { sessionStorage.setItem('wolko-hub-welcome', '1'); } catch (e) {} }   // 가입을 막 마친 사람 — 첫 로그인 때 환영 인사
        showScreen('emailScreen', false);
        $('loginPwInput').value = ''; authOk($('emailError'), t(verifying ? 'verifyDoneLogin' : 'resetDoneLogin'));
        ($('emailInput').value ? $('loginPwInput') : $('emailInput')).focus();
      } catch (e) { authError(msg, authCaught(e)); keepFocusOn(btn); }
      finally { lockSend(btn, false); }
    });

    /* ── 초기화 ── */
    async function initAuthFlow() {
      if (verifyToken()) { setVerifyMode(true); showScreen('resetNewScreen', false); return; } // 가입 확인 메일의 링크로 들어온 경우
      if (new URLSearchParams(location.search).get('reset')) { showScreen('resetNewScreen', false); return; } // 메일의 재설정 링크로 들어온 경우
      const hubToken = sessionStorage.getItem('wolko-hub-token') || '';
      if (hubToken && isHubTokenValid(hubToken)) {
        currentSession = {
          email: sessionStorage.getItem('wolko-hub-email') || '',
          role: sessionStorage.getItem('wolko-hub-role') || '',
        };
        showHub();
        if (new URLSearchParams(location.search).has('signed-in')) {
          history.replaceState(null, '', '/portal/');
        }
        return;
      }
      showScreen('emailScreen', false);
    }

    applyLangToDOM();
    syncInstallButton();
    initAuthFlow();

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/portal-sw.js', { scope: '/portal/' })
          .catch(error => console.warn('Portal SW registration failed:', error));
      });
    }
  </script>
</body>
</html>
