        const li = nsave.closest('li'), body = li.querySelector('.ne-body').value.trim();
        if (!body) { showToast(t('noticeNeedBody'), true); return; }
        nsave.disabled = true;
        try {
          const res = await fetch('/api/portal/notices', { method: 'POST', headers: authHeaders(), body: JSON.stringify({ action: 'edit', id: nsave.dataset.nsave, title: li.querySelector('.ne-title').value, body, dueDate: li.querySelector('.ne-due').value, pinned: li.querySelector('.ne-pin').checked, campus: li.querySelector('.ne-campus').value }) });
          const data = await res.json().catch(() => ({}));
