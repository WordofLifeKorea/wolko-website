---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="자료실 | WOLKO"
  description="WOLKO 자료실 — 매일묵상집과 캠프 자료실을 이용할 수 있습니다."
  activeNav="resources"
>
  <section class="resources-hero">
    <div class="resources-hero-inner">
      <h1>
        <span class="wl-ko">자료실</span>
        <span class="wl-en">Resources</span>
      </h1>
      <p class="hero-sub">
        <span class="wl-ko">매일묵상집과 캠프 자료실을 확인하세요.</span>
        <span class="wl-en">Browse Q.T books and camp resources.</span>
      </p>
    </div>
  </section>

  <div class="resources-grid-wrap">
    <div class="resources-grid">
      <a href="/resources/qt-book" class="res-card">
        <div class="res-icon">📖</div>
        <div class="res-label">
          <span class="wl-ko">매일묵상집</span>
          <span class="wl-en">Q.T Book</span>
        </div>
        <div class="res-arrow">→</div>
      </a>
      <a href="/camp-resources" class="res-card">
        <div class="res-icon">🔒</div>
        <div class="res-label">
          <span class="wl-ko">캠프 자료실</span>
          <span class="wl-en">Camp Resources</span>
        </div>
        <div class="res-arrow">→</div>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .resources-hero {
    background: linear-gradient(135deg, #004f68 0%, #007a9a 100%);
    color: #fff;
    padding: 64px 24px 48px;
    text-align: center;
  }
  .resources-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .resources-hero h1 {
    font-size: 2.4rem;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: -0.5px;
  }
  .hero-sub {
    font-size: 1.05rem;
    opacity: 0.88;
    line-height: 1.6;
    margin: 0;
  }

  .resources-grid-wrap {
    max-width: 860px;
    margin: 0 auto;
    padding: 56px 24px 80px;
  }
  .resources-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
  }
  .res-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    padding: 40px 24px 32px;
    background: #f7fbfd;
    border: 1.5px solid #d0e8f0;
    border-radius: 14px;
    text-decoration: none;
    color: #004f68;
    transition: box-shadow 0.18s, border-color 0.18s, transform 0.18s;
  }
  .res-card:hover {
    box-shadow: 0 8px 28px rgba(0,79,104,0.13);
    border-color: #007a9a;
    transform: translateY(-3px);
  }
  .res-icon {
    font-size: 2.4rem;
  }
  .res-label {
    font-size: 1.15rem;
    font-weight: 700;
    text-align: center;
  }
  .res-arrow {
    font-size: 1.1rem;
    opacity: 0.5;
  }

  @media (max-width: 600px) {
    .resources-hero h1 { font-size: 1.8rem; }
    .resources-hero { padding: 48px 16px 36px; }
    .resources-grid-wrap { padding: 36px 16px 60px; }
  }
</style>
