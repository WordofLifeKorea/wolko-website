---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="자료실 | WOLKO"
  description="WOLKO 자료실 — QT북/교재, 커리큘럼, 사역 양식을 제공합니다."
  activeNav="resources"
>
  <section class="resources-hero">
    <div class="resources-hero-inner">
      <h1>
        <span class="wl-ko">자료실</span>
        <span class="wl-en">Resources</span>
      </h1>
      <p class="hero-sub">
        <span class="wl-ko">WOLKO에서 제공하는 교재, 커리큘럼, 사역 양식을 다운로드 하세요.</span>
        <span class="wl-en">Download QT books, curriculum materials, and ministry forms from WOLKO.</span>
      </p>
    </div>
  </section>

  <div class="resources-container">

    <!-- QT북 / 교재 -->
    <section id="qt" class="resources-section">
      <h2 class="section-title">
        <span class="section-icon">📖</span>
        <span class="wl-ko">QT북 / 교재</span>
        <span class="wl-en">QT Books / Materials</span>
      </h2>
      <div class="empty-state">
        <p class="wl-ko">준비 중입니다. 곧 자료가 업로드될 예정입니다.</p>
        <p class="wl-en">Coming soon. Materials will be uploaded shortly.</p>
      </div>
    </section>

    <div class="section-divider"></div>

    <!-- 커리큘럼 -->
    <section id="curriculum" class="resources-section">
      <h2 class="section-title">
        <span class="section-icon">📋</span>
        <span class="wl-ko">커리큘럼</span>
        <span class="wl-en">Curriculum</span>
      </h2>
      <div class="empty-state">
        <p class="wl-ko">준비 중입니다. 곧 자료가 업로드될 예정입니다.</p>
        <p class="wl-en">Coming soon. Materials will be uploaded shortly.</p>
      </div>
    </section>

    <div class="section-divider"></div>

    <!-- 사역 양식 -->
    <section id="forms" class="resources-section">
      <h2 class="section-title">
        <span class="section-icon">📄</span>
        <span class="wl-ko">사역 양식</span>
        <span class="wl-en">Ministry Forms</span>
      </h2>
      <div class="empty-state">
        <p class="wl-ko">준비 중입니다. 곧 자료가 업로드될 예정입니다.</p>
        <p class="wl-en">Coming soon. Materials will be uploaded shortly.</p>
      </div>
    </section>

  </div>
</BaseLayout>

<style>
  .resources-hero {
    background: linear-gradient(135deg, #004f68 0%, #007a9a 100%);
    color: #fff;
    padding: 64px 24px 48px;
    text-align: center;
  }
  .resources-hero-inner {
    max-width: 720px;
    margin: 0 auto;
  }
  .resources-hero h1 {
    font-size: 2.4rem;
    font-weight: 700;
    margin: 0 0 16px;
    letter-spacing: -0.5px;
  }
  .hero-sub {
    font-size: 1.05rem;
    opacity: 0.88;
    line-height: 1.6;
    margin: 0;
  }

  .resources-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }

  .resources-section {
    padding: 8px 0 32px;
    scroll-margin-top: 80px;
  }

  .section-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 1.4rem;
    font-weight: 700;
    color: #004f68;
    margin: 0 0 24px;
    padding-bottom: 12px;
    border-bottom: 2px solid #e0eef3;
  }
  .section-icon {
    font-size: 1.3rem;
  }

  .empty-state {
    background: #f7fbfd;
    border: 1px dashed #b0d4e0;
    border-radius: 10px;
    padding: 36px 24px;
    text-align: center;
    color: #6b8fa0;
  }
  .empty-state p {
    margin: 0;
    font-size: 0.97rem;
  }

  .section-divider {
    height: 1px;
    background: #e8f2f7;
    margin: 8px 0 40px;
  }

  @media (max-width: 600px) {
    .resources-hero h1 { font-size: 1.8rem; }
    .resources-hero { padding: 48px 16px 36px; }
    .resources-container { padding: 32px 16px 60px; }
  }
</style>
