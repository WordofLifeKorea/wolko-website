---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout
  title="그 외 자료들 | WOLKO 자료실"
  description="WOLKO 그 외 자료들 (Etc.) 다운로드 페이지입니다."
  activeNav="resources"
>
  <PageHero variant="plain">
    <Fragment slot="eyebrow"><a href="/resources"><span class="wl-ko">자료실</span><span class="wl-en">Resources</span></a></Fragment>
    <Fragment slot="title">
      <span class="wl-ko">그 외 자료들</span>
      <span class="wl-en">Etc.</span>
    </Fragment>
  </PageHero>

  <div class="res-container">
    <div class="empty-state">
      <p class="wl-ko">준비 중입니다. 곧 자료가 업로드될 예정입니다.</p>
      <p class="wl-en">Coming soon. Materials will be uploaded shortly.</p>
    </div>
  </div>
</BaseLayout>

<style>
  .res-container {
    max-width: 860px;
    margin: 0 auto;
    padding: 48px 24px 80px;
  }
  .empty-state {
    background: #f7fbfd;
    border: 1px dashed #b0d4e0;
    border-radius: 10px;
    padding: 48px 24px;
    text-align: center;
    color: #6b8fa0;
  }
  .empty-state p {
    margin: 0;
    font-size: 0.97rem;
  }

  @media (max-width: 600px) {
    .res-container { padding: 32px 16px 60px; }
  }
</style>
