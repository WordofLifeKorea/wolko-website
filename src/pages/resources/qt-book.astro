---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="매일묵상집 | WOLKO 자료실"
  description="WOLKO 매일묵상집 (Q.T Book) 다운로드 페이지입니다."
  activeNav="resources"
>
  <section class="qt-hero">
    <div class="qt-hero-inner">
      <a href="/resources" class="breadcrumb">
        <span class="wl-ko">← 자료실</span>
        <span class="wl-en">← Resources</span>
      </a>
      <div class="hero-row">
        <div>
          <h1>
            <span class="res-emoji">📖</span>
            <span class="wl-ko">매일묵상집</span>
            <span class="wl-en">Q.T Book</span>
          </h1>
          <p>
            <span class="wl-ko">업로드된 매일묵상집 PDF를 다운로드할 수 있습니다.</span>
            <span class="wl-en">Download uploaded Q.T book PDF files.</span>
          </p>
        </div>
        <button class="admin-toggle" id="adminToggle" type="button">관리 로그인</button>
      </div>
    </div>
  </section>

  <main class="qt-container">
    <section class="admin-panel" id="adminPanel" hidden>
      <div class="panel-head">
        <div>
          <h2>파일 업로드</h2>
          <p>PDF 파일을 선택하면 목록에 바로 추가됩니다.</p>
        </div>
        <button class="ghost-btn" id="logoutBtn" type="button">관리 종료</button>
      </div>
      <form class="upload-form" id="uploadForm">
        <label>
          <span>제목</span>
          <input id="titleInput" type="text" placeholder="예: 2026년 7월 매일묵상집" maxlength="160">
        </label>
        <label>
          <span>월</span>
          <input id="monthInput" type="month">
        </label>
        <label class="file-field">
          <span>PDF 파일</span>
          <input id="fileInput" type="file" accept=".pdf,application/pdf">
        </label>
        <button class="primary-btn" id="uploadBtn" type="submit">업로드</button>
      </form>
      <p class="status-line" id="uploadStatus"></p>
    </section>

    <p class="load-error" id="loadError" hidden></p>
    <section class="qt-list" id="qtList" aria-live="polite"></section>
  </main>

  <div class="login-screen" id="loginScreen" hidden>
    <div class="login-card">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <h2>관리 로그인</h2>
      <p>매일묵상집 파일 업로드 권한이 필요합니다.</p>
      <input id="passwordInput" type="password" placeholder="공유 비밀번호" autocomplete="current-password">
      <p class="login-error" id="loginError"></p>
      <button class="primary-btn" id="loginBtn" type="button">확인</button>
      <button class="ghost-btn" id="loginCancelBtn" type="button">취소</button>
    </div>
  </div>
</BaseLayout>

<style>
  .qt-hero {
    background: linear-gradient(135deg, #004f68 0%, #007a9a 100%);
    color: #fff;
    padding: 48px 24px 40px;
  }
  .qt-hero-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .breadcrumb {
    display: inline-block;
    color: rgba(255,255,255,0.76);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 14px;
    transition: color 0.15s;
  }
  .breadcrumb:hover { color: #fff; }
  .hero-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
  }
  .qt-hero h1 {
    font-size: 2rem;
    font-weight: 700;
    margin: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .qt-hero p {
    margin: 12px 0 0;
    color: rgba(255,255,255,0.82);
    line-height: 1.65;
  }
  .res-emoji { font-size: 1.8rem; }

  .qt-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 42px 24px 80px;
  }
  .admin-toggle,
  .primary-btn,
  .ghost-btn,
  .download-btn,
  .delete-btn {
    min-height: 40px;
    border-radius: 9px;
    padding: 0 16px;
    font-weight: 700;
    border: 0;
    cursor: pointer;
  }
  .admin-toggle {
    background: rgba(255,255,255,0.16);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.34);
    white-space: nowrap;
  }
  .admin-toggle:hover { background: rgba(255,255,255,0.24); }
  .primary-btn {
    background: #004f68;
    color: #fff;
  }
  .primary-btn:hover { background: #007a9a; }
  .primary-btn:disabled { opacity: 0.56; cursor: not-allowed; }
  .ghost-btn {
    background: #f7fbfd;
    color: #004f68;
    border: 1px solid #d4e7ee;
  }
  .ghost-btn:hover { background: #edf7fa; }

  .admin-panel {
    margin-bottom: 24px;
    border: 1px solid #d9e9ef;
    border-radius: 12px;
    padding: 22px;
    background: #f8fcfd;
  }
  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }
  .panel-head h2 {
    margin: 0;
    color: #004f68;
    font-size: 1.15rem;
  }
  .panel-head p {
    margin: 6px 0 0;
    color: #6b8794;
    font-size: 0.92rem;
  }
  .upload-form {
    display: grid;
    grid-template-columns: 1.4fr 180px 1fr auto;
    gap: 12px;
    align-items: end;
  }
  .upload-form label {
    display: grid;
    gap: 7px;
    color: #45616f;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .upload-form input {
    width: 100%;
    min-height: 42px;
    border: 1px solid #cfdfe6;
    border-radius: 9px;
    padding: 0 12px;
    color: #1d3340;
    background: #fff;
  }
  .file-field input {
    padding: 9px 10px;
  }
  .status-line {
    min-height: 20px;
    margin: 12px 0 0;
    color: #6b8794;
    font-size: 0.9rem;
  }
  .status-line.is-error,
  .login-error {
    color: #c42a36;
  }

  .load-error {
    margin: 0 0 18px;
    padding: 12px 14px;
    border: 1px solid #f0cbd0;
    border-radius: 9px;
    background: #fff8f9;
    color: #c42a36;
  }
  .qt-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(148px, 1fr));
    gap: 34px 22px;
    align-items: start;
  }
  .empty-state {
    border: 1px solid #dbe9ee;
    border-radius: 12px;
    background: #fff;
    padding: 18px;
    box-shadow: 0 6px 18px rgba(0,79,104,0.06);
  }
  .qt-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .qt-item:hover .qt-book {
    transform: translateY(-7px) rotate(-1deg);
    box-shadow: 10px 20px 40px rgba(0,79,104,0.22);
  }
  .qt-book-link {
    position: relative;
    color: inherit;
    text-decoration: none;
  }
  .qt-book-link::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -9px;
    width: 142px;
    height: 8px;
    transform: translateX(-50%);
    border-radius: 999px;
    background: linear-gradient(90deg, rgba(0,79,104,0.08), rgba(0,79,104,0.2), rgba(0,79,104,0.08));
  }
  .qt-book {
    width: 116px;
    height: 158px;
    display: flex;
    margin: 0 auto;
    border-radius: 4px 7px 7px 4px;
    box-shadow: 5px 8px 20px rgba(0,0,0,0.15);
    transition: transform 0.25s cubic-bezier(.22,.68,0,1.2), box-shadow 0.25s;
  }
  .qt-book-spine {
    width: 22px;
    flex-shrink: 0;
    border-radius: 4px 0 0 4px;
    background: linear-gradient(180deg, #004f68 0%, #0a5b76 100%);
    box-shadow: inset -3px 0 6px rgba(0,0,0,0.24);
  }
  .qt-book-cover {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 7px;
    padding: 14px 10px;
    border: 1px solid rgba(0,79,104,0.18);
    border-left: 0;
    border-radius: 0 7px 7px 0;
    background:
      linear-gradient(145deg, rgba(255,255,255,0.76), rgba(255,255,255,0) 48%),
      linear-gradient(135deg, #e8f4f8 0%, #cce5f0 100%);
  }
  .qt-book-mark {
    width: 26px;
    height: 34px;
    border-radius: 50% 50% 44% 44%;
    background: rgba(0,79,104,0.13);
    color: #004f68;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
  }
  .qt-book-month {
    color: #004f68;
    font-size: 12px;
    font-weight: 900;
    line-height: 1.25;
  }
  .qt-book-type {
    color: #6b8794;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
  }
  .qt-title {
    margin: 0;
    color: #163542;
    font-size: 0.96rem;
    font-weight: 800;
    line-height: 1.38;
    word-break: keep-all;
  }
  .qt-meta {
    display: flex;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 6px;
    color: #6b8794;
    font-size: 0.78rem;
  }
  .qt-actions {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }
  .download-btn {
    display: none;
    background: #004f68;
    color: #fff;
    text-decoration: none;
  }
  .download-btn:hover { background: #007a9a; }
  .delete-btn {
    min-height: 30px;
    padding: 0 11px;
    font-size: 0.78rem;
    background: #fff5f6;
    color: #c42a36;
    border: 1px solid #f0cbd0;
  }
  .delete-btn:hover { background: #fdecee; }
  .empty-state {
    text-align: center;
    color: #6b8794;
  }
  .empty-state p {
    margin: 0;
  }

  .login-screen {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0,25,35,0.62);
    backdrop-filter: blur(8px);
  }
  .login-screen[hidden] { display: none; }
  .login-card {
    width: min(390px, 100%);
    border-radius: 16px;
    background: #fff;
    padding: 30px 28px 26px;
    text-align: center;
    box-shadow: 0 24px 70px rgba(0,0,0,0.24);
  }
  .login-card img {
    height: 44px;
    margin-bottom: 12px;
  }
  .login-card h2 {
    margin: 0 0 8px;
    color: #004f68;
    font-size: 1.25rem;
  }
  .login-card p {
    margin: 0 0 16px;
    color: #6b8794;
    font-size: 0.92rem;
  }
  .login-card input {
    width: 100%;
    height: 48px;
    border: 1px solid #cfdfe6;
    border-radius: 10px;
    padding: 0 14px;
    margin-bottom: 8px;
  }
  .login-error {
    min-height: 20px;
    font-size: 0.86rem;
  }
  .login-card .primary-btn,
  .login-card .ghost-btn {
    width: 100%;
    margin-top: 8px;
  }

  @media (max-width: 760px) {
    .qt-hero { padding: 36px 16px 30px; }
    .hero-row,
    .panel-head {
      align-items: stretch;
      flex-direction: column;
    }
    .qt-hero h1 { font-size: 1.6rem; }
    .qt-container { padding: 30px 16px 60px; }
    .upload-form {
      grid-template-columns: 1fr;
    }
    .qt-item {
      gap: 11px;
    }
    .qt-actions {
      justify-content: center;
    }
    .download-btn,
    .delete-btn {
      flex: 0 0 auto;
    }
  }
</style>

<script>
  const TOKEN_KEY = 'wolko_qt_book_token';
  const MAX_SIZE = 35 * 1024 * 1024;

  const els = {
    adminToggle: document.getElementById('adminToggle'),
    adminPanel: document.getElementById('adminPanel'),
    logoutBtn: document.getElementById('logoutBtn'),
    uploadForm: document.getElementById('uploadForm'),
    uploadBtn: document.getElementById('uploadBtn'),
    uploadStatus: document.getElementById('uploadStatus'),
    titleInput: document.getElementById('titleInput'),
    monthInput: document.getElementById('monthInput'),
    fileInput: document.getElementById('fileInput'),
    qtList: document.getElementById('qtList'),
    loadError: document.getElementById('loadError'),
    loginScreen: document.getElementById('loginScreen'),
    passwordInput: document.getElementById('passwordInput'),
    loginBtn: document.getElementById('loginBtn'),
    loginCancelBtn: document.getElementById('loginCancelBtn'),
    loginError: document.getElementById('loginError'),
  };

  let items = [];
  let token = localStorage.getItem(TOKEN_KEY) || '';
  let adminMode = false;

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }

  function formatBytes(size) {
    if (!size) return '';
    if (size >= 1024 * 1024) return `${(size / 1024 / 1024).toFixed(1)}MB`;
    return `${Math.max(1, Math.round(size / 1024))}KB`;
  }

  function formatMonth(month) {
    if (!month) return '';
    const match = String(month).match(/^(\d{4})-(\d{2})$/);
    if (!match) return month;
    return `${match[1]}년 ${Number(match[2])}월`;
  }

  function setAdminMode(next) {
    adminMode = next;
    els.adminPanel.hidden = !adminMode;
    els.adminToggle.textContent = adminMode ? '관리 중' : '관리 로그인';
    render();
  }

  function showLogin(message = '') {
    els.loginError.textContent = message;
    els.passwordInput.value = '';
    els.loginScreen.hidden = false;
    setTimeout(() => els.passwordInput.focus(), 20);
  }

  function logout() {
    token = '';
    localStorage.removeItem(TOKEN_KEY);
    setAdminMode(false);
  }

  function setUploadStatus(message, isError = false) {
    els.uploadStatus.textContent = message;
    els.uploadStatus.classList.toggle('is-error', isError);
  }

  function render() {
    if (!items.length) {
      els.qtList.innerHTML = `
        <div class="empty-state">
          <p>아직 업로드된 매일묵상집이 없습니다.</p>
        </div>
      `;
      return;
    }

    els.qtList.innerHTML = items.map(item => `
      <article class="qt-item">
        <a class="qt-book-link" href="${escapeHtml(item.url)}" target="_blank" rel="noopener" aria-label="${escapeHtml(item.title)} 열기">
          <div class="qt-book">
            <div class="qt-book-spine"></div>
            <div class="qt-book-cover">
              <span class="qt-book-mark">✦</span>
              <span class="qt-book-month">${escapeHtml(formatMonth(item.month) || 'QT')}</span>
              <span class="qt-book-type">PDF</span>
            </div>
          </div>
        </a>
        <div class="qt-info">
          <h2 class="qt-title">${escapeHtml(item.title)}</h2>
          <div class="qt-meta">
            ${item.filename ? `<span>${escapeHtml(item.filename)}</span>` : ''}
            ${item.size ? `<span>${escapeHtml(formatBytes(item.size))}</span>` : ''}
            ${item.uploadedAt ? `<span>${escapeHtml(new Date(item.uploadedAt).toLocaleDateString('ko-KR'))}</span>` : ''}
          </div>
        </div>
        <div class="qt-actions">
          <a class="download-btn" href="${escapeHtml(item.url)}" target="_blank" rel="noopener">열기</a>
          ${adminMode ? `<button class="delete-btn" type="button" data-delete="${escapeHtml(item.id)}">삭제</button>` : ''}
        </div>
      </article>
    `).join('');
  }

  async function loadItems() {
    try {
      const res = await fetch('/api/qt-book/data');
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || '목록을 불러오지 못했습니다.');
      items = Array.isArray(data.items) ? data.items : [];
      els.loadError.hidden = true;
      render();
    } catch (error) {
      els.loadError.textContent = error.message;
      els.loadError.hidden = false;
    }
  }

  async function login() {
    els.loginBtn.disabled = true;
    els.loginError.textContent = '';
    try {
      const res = await fetch('/api/qt-book/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: els.passwordInput.value.trim() }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || '로그인하지 못했습니다.');
      token = data.token;
      localStorage.setItem(TOKEN_KEY, token);
      els.loginScreen.hidden = true;
      setAdminMode(true);
    } catch (error) {
      els.loginError.textContent = error.message;
    } finally {
      els.loginBtn.disabled = false;
    }
  }

  async function uploadFile(event) {
    event.preventDefault();
    const file = els.fileInput.files?.[0];
    if (!file) {
      setUploadStatus('PDF 파일을 선택해주세요.', true);
      return;
    }
    if (!/\.pdf$/i.test(file.name) && file.type !== 'application/pdf') {
      setUploadStatus('PDF 파일만 업로드할 수 있습니다.', true);
      return;
    }
    if (file.size > MAX_SIZE) {
      setUploadStatus('파일이 너무 큽니다. (최대 35MB)', true);
      return;
    }

    els.uploadBtn.disabled = true;
    setUploadStatus('업로드 중...');
    try {
      const form = new FormData();
      form.append('title', els.titleInput.value.trim());
      form.append('month', els.monthInput.value);
      form.append('file', file);
      const res = await fetch('/api/qt-book/upload', {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: form,
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) {
        logout();
        showLogin(data.error || '다시 로그인해주세요.');
        return;
      }
      if (!res.ok) throw new Error(data.error || '업로드하지 못했습니다.');
      items = Array.isArray(data.items) ? data.items : items;
      els.uploadForm.reset();
      setUploadStatus('업로드되었습니다.');
      render();
    } catch (error) {
      setUploadStatus(error.message, true);
    } finally {
      els.uploadBtn.disabled = false;
    }
  }

  async function deleteItem(id) {
    if (!confirm('이 매일묵상집 파일을 삭제하시겠습니까?')) return;
    try {
      const res = await fetch(`/api/qt-book/data?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` },
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) {
        logout();
        showLogin(data.error || '다시 로그인해주세요.');
        return;
      }
      if (!res.ok) throw new Error(data.error || '삭제하지 못했습니다.');
      items = Array.isArray(data.items) ? data.items : items.filter(item => item.id !== id);
      render();
    } catch (error) {
      alert(error.message);
    }
  }

  els.adminToggle.addEventListener('click', () => {
    if (token) {
      setAdminMode(true);
      return;
    }
    showLogin();
  });
  els.logoutBtn.addEventListener('click', logout);
  els.loginBtn.addEventListener('click', login);
  els.loginCancelBtn.addEventListener('click', () => { els.loginScreen.hidden = true; });
  els.passwordInput.addEventListener('keydown', event => {
    if (event.key === 'Enter') login();
  });
  els.uploadForm.addEventListener('submit', uploadFile);
  els.qtList.addEventListener('click', event => {
    const button = event.target.closest('[data-delete]');
    if (!button) return;
    deleteItem(button.dataset.delete);
  });

  loadItems();
  if (token) setAdminMode(true);
</script>
