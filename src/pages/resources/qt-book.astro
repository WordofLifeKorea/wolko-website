    #fb-arrow-prev { left: 6px; }
    #fb-arrow-next { right: 6px; }
  }
</style>

<script>
  const TOKEN_KEY = 'wolko_qt_book_token';
  const MAX_SIZE = 35 * 1024 * 1024;
  const PDFJS_SRC = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
  const PDFJS_WORKER = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  const DB_NAME = 'wolko-qt-book-pdf-v1';
  const STORE_NAME = 'pages';

  const els = {
    adminToggle: document.getElementById('adminToggle'),
    adminPanel: document.getElementById('adminPanel'),
    logoutBtn: document.getElementById('logoutBtn'),
    uploadForm: document.getElementById('uploadForm'),
    uploadBtn: document.getElementById('uploadBtn'),
    uploadStatus: document.getElementById('uploadStatus'),
    titleInput: document.getElementById('titleInput'),
    monthInput: document.getElementById('monthInput'),
    fileInput: document.getElementById('fileInput'),
    filePickBtn: document.getElementById('filePickBtn'),
    fileNameText: document.getElementById('fileNameText'),
    qtList: document.getElementById('qtList'),
    archiveCount: document.getElementById('archiveCount'),
    loadError: document.getElementById('loadError'),
    viewerEmpty: document.getElementById('viewerEmpty'),
    viewerContent: document.getElementById('viewerContent'),
    reportTitle: document.getElementById('reportTitle'),
    reportDate: document.getElementById('reportDate'),
    reportDownload: document.getElementById('reportDownload'),
    container: document.getElementById('flipbook-container'),
    loadingEl: document.getElementById('fb-loading'),
    flipBookEl: document.getElementById('flip-book'),
    pageInfo: document.getElementById('fb-page-info'),
    dotsBar: document.getElementById('fb-dots'),
    loginScreen: document.getElementById('loginScreen'),
    passwordInput: document.getElementById('passwordInput'),
    loginBtn: document.getElementById('loginBtn'),
    loginCancelBtn: document.getElementById('loginCancelBtn'),
    loginError: document.getElementById('loginError'),
  };

  let items = [];
  let token = localStorage.getItem(TOKEN_KEY) || '';
  let adminMode = false;
  let currentItemId = '';
  let db = null;
  let pdfScriptPromise = null;
  let isMobile = window.innerWidth < 768;
  let SCALE = isMobile ? 2.0 : 3.0;
  let displayVh = 80;
  let mobilePages = [];
  let mobilePage = 0;
  let allPages = [];
  let spreadIdx = 0;
  let totalSpreads = 0;
  let touchReset = () => {};

  function escapeHtml(value) {
    return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
  }

  function formatBytes(size) {
    if (!size) return '';
    if (size >= 1024 * 1024) return `${(size / 1024 / 1024).toFixed(1)}MB`;
    return `${Math.max(1, Math.round(size / 1024))}KB`;
  }

  function formatMonth(month) {
    if (!month) return '';
    const match = String(month).match(/^(\d{4})-(\d{2})$/);
    if (!match) return month;
    return `${match[1]}년 ${Number(match[2])}월`;
  }

  function bookMonth(month) {
    const match = String(month || '').match(/^(\d{4})-(\d{2})$/);
    if (!match) return { year: 'QT', month: 'PDF' };
    return { year: match[1], month: `${Number(match[2])}월` };
  }

  function uploadedDate(item) {
    if (!item.uploadedAt) return '';
    try {
      return new Date(item.uploadedAt).toLocaleDateString('ko-KR');
    } catch {
      return '';
    }
  }

  function setAdminMode(next) {
    adminMode = next;
    els.adminPanel.hidden = !adminMode;
    els.adminToggle.textContent = adminMode ? '관리 중' : '관리 로그인';
    renderShelf();
  }

  function showLogin(message = '') {
    els.loginError.textContent = message;
    els.passwordInput.value = '';
    els.loginScreen.hidden = false;
    setTimeout(() => els.passwordInput.focus(), 20);
  }

  function logout() {
    token = '';
    localStorage.removeItem(TOKEN_KEY);
    setAdminMode(false);
  }

  function setUploadStatus(message, isError = false) {
    els.uploadStatus.textContent = message;
    els.uploadStatus.classList.toggle('is-error', isError);
  }

  function renderShelf() {
    els.archiveCount.textContent = `${items.length} PDF`;

    if (!items.length) {
      currentItemId = '';
      els.qtList.innerHTML = `
        <div class="empty-state">
          <p>아직 업로드된 매일묵상집이 없습니다.</p>
        </div>
      `;
      els.viewerContent.hidden = true;
      els.viewerEmpty.hidden = false;
      return;
    }

    if (!currentItemId || !items.some(item => item.id === currentItemId)) {
      currentItemId = items[0].id;
    }

    els.qtList.innerHTML = items.map(item => {
      const label = bookMonth(item.month);
      const isCurrent = item.id === currentItemId;
      return `
        <article class="qt-card${isCurrent ? ' current' : ''}" data-id="${escapeHtml(item.id)}">
          <button class="qt-card-button" type="button" data-select="${escapeHtml(item.id)}" aria-label="${escapeHtml(item.title)} 보기">
            <div class="qt-book" aria-hidden="true">
              <div class="qt-book-spine"></div>
              <div class="qt-book-cover">
                <span class="qt-book-month">${escapeHtml(label.month)}</span>
                <span class="qt-book-year">${escapeHtml(label.year)}</span>
                <span class="qt-book-type">PDF</span>
              </div>
            </div>
            <div>
              <h2 class="qt-title">${escapeHtml(item.title)}</h2>
              <div class="qt-date">${escapeHtml(formatMonth(item.month) || uploadedDate(item))}</div>
              <div class="qt-meta">
                ${item.size ? `${escapeHtml(formatBytes(item.size))}` : ''}
              </div>
            </div>
            <span class="qt-current-badge">현재 보는 중</span>
          </button>
          ${adminMode ? `<div class="qt-actions"><button class="delete-btn" type="button" data-delete="${escapeHtml(item.id)}">삭제</button></div>` : ''}
        </article>
      `;
    }).join('');
  }

  function markCurrentCard() {
    els.qtList.querySelectorAll('.qt-card').forEach(card => {
      card.classList.toggle('current', card.dataset.id === currentItemId);
    });
  }

  function selectItem(item, shouldScroll = false) {
    if (!item?.url) return;
    currentItemId = item.id;
    markCurrentCard();
    els.viewerEmpty.hidden = true;
    els.viewerContent.hidden = false;
    els.reportTitle.textContent = item.title || '매일묵상집';
    els.reportDate.textContent = formatMonth(item.month) || uploadedDate(item);
    els.reportDownload.href = item.url;
    els.container.dataset.pdf = item.url;
    touchReset();
    loadPdf(item.url).then(() => {
      if (shouldScroll) els.container.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  }

  async function loadItems() {
    try {
      const res = await fetch('/api/qt-book/data');
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || '목록을 불러오지 못했습니다.');
      items = Array.isArray(data.items) ? data.items : [];
      els.loadError.hidden = true;
      renderShelf();
      if (items.length) selectItem(items.find(item => item.id === currentItemId) || items[0]);
    } catch (error) {
      els.loadError.textContent = error.message;
      els.loadError.hidden = false;
      renderShelf();
    }
  }

  async function login() {
    els.loginBtn.disabled = true;
    els.loginError.textContent = '';
    try {
      const res = await fetch('/api/qt-book/auth', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password: els.passwordInput.value.trim() }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || '로그인하지 못했습니다.');
      token = data.token;
      localStorage.setItem(TOKEN_KEY, token);
      els.loginScreen.hidden = true;
      setAdminMode(true);
    } catch (error) {
      els.loginError.textContent = error.message;
    } finally {
      els.loginBtn.disabled = false;
    }
  }

  async function uploadFile(event) {
    event.preventDefault();
    const file = els.fileInput.files?.[0];
    if (!file) {
      setUploadStatus('PDF 파일을 선택해주세요.', true);
      return;
    }
    if (!/\.pdf$/i.test(file.name) && file.type !== 'application/pdf') {
      setUploadStatus('PDF 파일만 업로드할 수 있습니다.', true);
      return;
    }
    if (file.size > MAX_SIZE) {
      setUploadStatus('파일이 너무 큽니다. (최대 35MB)', true);
      return;
    }

    els.uploadBtn.disabled = true;
    setUploadStatus('업로드 중...');
    try {
      const form = new FormData();
      form.append('title', els.titleInput.value.trim());
      form.append('month', els.monthInput.value);
      form.append('file', file);
      const res = await fetch('/api/qt-book/upload', {
        method: 'POST',
        headers: { Authorization: `Bearer ${token}` },
        body: form,
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) {
        logout();
        showLogin(data.error || '다시 로그인해주세요.');
        return;
      }
      if (!res.ok) throw new Error(data.error || '업로드하지 못했습니다.');
      items = Array.isArray(data.items) ? data.items : items;
      currentItemId = items[0]?.id || '';
      els.uploadForm.reset();
      els.fileNameText.textContent = '선택된 파일 없음';
      setUploadStatus('업로드되었습니다.');
      renderShelf();
      if (items.length) selectItem(items[0], true);
    } catch (error) {
      setUploadStatus(error.message, true);
    } finally {
      els.uploadBtn.disabled = false;
    }
  }

  async function deleteItem(id) {
    if (!confirm('이 매일묵상집 파일을 삭제하시겠습니까?')) return;
    try {
      const res = await fetch(`/api/qt-book/data?id=${encodeURIComponent(id)}`, {
        method: 'DELETE',
        headers: { Authorization: `Bearer ${token}` },
      });
      const data = await res.json().catch(() => ({}));
      if (res.status === 401) {
        logout();
        showLogin(data.error || '다시 로그인해주세요.');
        return;
      }
      if (!res.ok) throw new Error(data.error || '삭제하지 못했습니다.');
      items = Array.isArray(data.items) ? data.items : items.filter(item => item.id !== id);
      if (currentItemId === id) currentItemId = items[0]?.id || '';
      renderShelf();
      if (items.length) selectItem(items.find(item => item.id === currentItemId) || items[0]);
    } catch (error) {
      alert(error.message);
    }
  }

  function loadScript(src) {
    if (window.pdfjsLib) return Promise.resolve();
    if (!pdfScriptPromise) {
      pdfScriptPromise = new Promise((res, rej) => {
        const s = document.createElement('script');
        s.src = src;
        s.onload = res;
        s.onerror = rej;
        document.head.appendChild(s);
      }).then(() => {
        window.pdfjsLib.GlobalWorkerOptions.workerSrc = PDFJS_WORKER;
      });
    }
    return pdfScriptPromise;
  }

  function showSpinner() {
    els.loadingEl.innerHTML = '<div class="fb-spinner"></div><span>PDF를 불러오는 중입니다...</span>';
    els.loadingEl.style.display = 'flex';
    els.flipBookEl.style.display = 'none';
  }

  function showError(message) {
    els.loadingEl.innerHTML = `<span style="color:#c42a36;text-align:center;padding:0 20px;">${message}</span>`;
    els.loadingEl.style.display = 'flex';
    els.flipBookEl.style.display = 'none';
  }

  function openDB() {
    return new Promise((res, rej) => {
      const req = indexedDB.open(DB_NAME, 1);
      req.onupgradeneeded = event => {
        event.target.result.createObjectStore(STORE_NAME, { keyPath: 'key' });
      };
      req.onsuccess = event => res(event.target.result);
      req.onerror = () => rej(null);
    });
  }

  function getCache(database, key) {
    return new Promise(res => {
      try {
        const tx = database.transaction(STORE_NAME, 'readonly');
        const req = tx.objectStore(STORE_NAME).get(key);
        req.onsuccess = () => res(req.result || null);
        req.onerror = () => res(null);
      } catch {
        res(null);
      }
    });
  }

  function setCache(database, key, data) {
    try {
      const tx = database.transaction(STORE_NAME, 'readwrite');
      tx.objectStore(STORE_NAME).put({ key, data, ts: Date.now() });
    } catch {}
  }

  function renderPage(pdfDoc, pageNum) {
    return pdfDoc.getPage(pageNum).then(page => {
      const vp = page.getViewport({ scale: SCALE });
      const canvas = document.createElement('canvas');
      canvas.width = vp.width;
      canvas.height = vp.height;
      const ctx = canvas.getContext('2d', { alpha: false });
      ctx.imageSmoothingEnabled = true;
      ctx.imageSmoothingQuality = 'high';
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      return page.render({
        canvasContext: ctx,
        viewport: vp,
        intent: 'print',
      }).promise.then(() => ({ url: canvas.toDataURL('image/png'), w: vp.width, h: vp.height }));
    });
  }

  function buildDots(count, onDotClick) {
    els.dotsBar.innerHTML = '';
    if (count <= 1) return;
    if (count > 12) {
      const span = document.createElement('span');
      span.className = 'fb-dots-text';
      span.id = 'fb-dots-text-el';
      els.dotsBar.appendChild(span);
      return;
    }
    for (let i = 0; i < count; i += 1) {
      const btn = document.createElement('button');
      btn.className = 'fb-dot';
      btn.setAttribute('aria-label', `${i + 1}번째`);
      btn.addEventListener('click', () => onDotClick(i));
      els.dotsBar.appendChild(btn);
    }
  }

  function updateDots(activeIdx, total) {
    const textEl = document.getElementById('fb-dots-text-el');
    if (textEl) {
      textEl.textContent = `${activeIdx + 1} / ${total}`;
      return;
    }
    els.dotsBar.querySelectorAll('.fb-dot').forEach((dot, i) => {
      dot.classList.toggle('active', i === activeIdx);
    });
  }

  function buildMobileViewer(pages) {
    mobilePages = pages;
    mobilePage = 0;
    els.flipBookEl.innerHTML = '';
    els.flipBookEl.style.cssText = 'display:flex;align-items:center;justify-content:center;width:100%;';

    const img = document.createElement('img');
    img.id = 'mob-page-img';
    img.style.cssText = 'max-width:calc(100% - 56px);height:auto;display:block;border-radius:8px;box-shadow:0 4px 24px rgba(0,0,0,0.45);user-select:none;-webkit-user-drag:none;';
    img.draggable = false;
    img.src = pages[0].url;
    els.flipBookEl.appendChild(img);

    buildDots(pages.length, goMobilePage);
    updateMobileNav();
    els.loadingEl.style.display = 'none';
    els.flipBookEl.style.display = 'flex';
  }

  function updateMobileNav() {
    const total = mobilePages.length;
    els.pageInfo.textContent = `${mobilePage + 1} / ${total}`;
    const atFirst = mobilePage === 0;
    const atLast = mobilePage >= total - 1;
    document.getElementById('fb-prev').disabled = atFirst;
    document.getElementById('fb-first').disabled = atFirst;
    document.getElementById('fb-next').disabled = atLast;
    document.getElementById('fb-last').disabled = atLast;
    document.getElementById('fb-arrow-prev').disabled = atFirst;
    document.getElementById('fb-arrow-next').disabled = atLast;
    updateDots(mobilePage, total);
  }

  function goMobilePage(i) {
    if (i < 0 || i >= mobilePages.length) return;
    mobilePage = i;
    const img = document.getElementById('mob-page-img');
    if (img) img.src = mobilePages[i].url;
    updateMobileNav();
  }

  function buildDesktopViewer(pages) {
    allPages = pages;
    spreadIdx = 0;
    totalSpreads = 1 + Math.ceil((pages.length - 1) / 2);
    els.flipBookEl.innerHTML = '';
    els.flipBookEl.style.cssText = 'display:flex;align-items:center;justify-content:center;width:100%;height:100%;';

    const left = document.createElement('img');
    left.id = 'desk-left';
    left.className = 'spread-img';
    left.draggable = false;
    const right = document.createElement('img');
    right.id = 'desk-right';
    right.className = 'spread-img';
    right.draggable = false;
    els.flipBookEl.appendChild(left);
    els.flipBookEl.appendChild(right);

    buildDots(totalSpreads, goDesktopSpread);
    applySpreadImages();
    els.loadingEl.style.display = 'none';
    els.flipBookEl.style.display = 'flex';
  }

  function applySpreadImages() {
    const left = document.getElementById('desk-left');
    const right = document.getElementById('desk-right');
    if (!left || !right) return;

    if (spreadIdx === 0) {
      left.style.display = 'none';
      right.className = 'spread-img spread-img-cover';
      right.src = allPages[0].url;
      right.style.display = 'block';
    } else {
      const leftIdx = spreadIdx * 2 - 1;
      const rightIdx = spreadIdx * 2;
      left.className = 'spread-img spread-img-left';
      right.className = 'spread-img spread-img-right';
      if (leftIdx < allPages.length) {
        left.src = allPages[leftIdx].url;
        left.style.display = 'block';
      } else {
        left.style.display = 'none';
      }
      if (rightIdx < allPages.length) {
        right.src = allPages[rightIdx].url;
        right.style.display = 'block';
      } else {
        right.style.display = 'none';
      }
    }
    updateDesktopNav();
  }

  function updateDesktopNav() {
    const firstPage = spreadIdx === 0 ? 1 : spreadIdx * 2;
    const lastPage = spreadIdx === 0 ? 1 : Math.min(spreadIdx * 2 + 1, allPages.length);
    els.pageInfo.textContent = `${firstPage}${lastPage > firstPage ? `-${lastPage}` : ''} / ${allPages.length}`;
    const atFirst = spreadIdx === 0;
    const atLast = spreadIdx >= totalSpreads - 1;
    document.getElementById('fb-prev').disabled = atFirst;
    document.getElementById('fb-first').disabled = atFirst;
    document.getElementById('fb-next').disabled = atLast;
    document.getElementById('fb-last').disabled = atLast;
    document.getElementById('fb-arrow-prev').disabled = atFirst;
    document.getElementById('fb-arrow-next').disabled = atLast;
    updateDots(spreadIdx, totalSpreads);
  }

  function goDesktopSpread(idx) {
    if (idx < 0 || idx >= totalSpreads || idx === spreadIdx) return;
    spreadIdx = idx;
    els.flipBookEl.classList.add('spread-fade-out');
    setTimeout(() => {
      applySpreadImages();
      els.flipBookEl.classList.remove('spread-fade-out');
    }, 160);
  }

  function buildViewer(pages) {
    if (isMobile) buildMobileViewer(pages);
    else buildDesktopViewer(pages);
  }

  function navigatePrev() {
    if (isMobile) goMobilePage(mobilePage - 1);
    else goDesktopSpread(spreadIdx - 1);
  }
  function navigateNext() {
    if (isMobile) goMobilePage(mobilePage + 1);
    else goDesktopSpread(spreadIdx + 1);
  }
  function navigateFirst() {
    if (isMobile) goMobilePage(0);
    else goDesktopSpread(0);
  }
  function navigateLast() {
    if (isMobile) goMobilePage(mobilePages.length - 1);
    else goDesktopSpread(totalSpreads - 1);
  }

  function loadPdf(pdfUrl) {
    showSpinner();
    return loadScript(PDFJS_SRC)
      .then(() => {
        const cacheKey = `${pdfUrl}@${SCALE.toFixed(1)}`;
        return (db ? Promise.resolve(db) : openDB().then(database => {
          db = database;
          return database;
        }))
          .catch(() => null)
          .then(database => {
            if (!database) return renderAndBuild(pdfUrl, null, cacheKey);
            return getCache(database, cacheKey).then(hit => {
              if (hit?.data?.length) {
                buildViewer(hit.data);
                return null;
              }
              return renderAndBuild(pdfUrl, database, cacheKey);
            });
          });
      })
      .catch(error => {
        console.error(error);
        showError(`PDF를 불러오지 못했습니다.<br>${error?.message || ''}`);
      });
  }

  function renderAndBuild(pdfUrl, database, cacheKey) {
    return window.pdfjsLib.getDocument(pdfUrl).promise.then(pdfDoc => {
      const pages = [];
      function next(i) {
        if (i > pdfDoc.numPages) return Promise.resolve();
        return renderPage(pdfDoc, i).then(page => {
          pages.push(page);
          return next(i + 1);
        });
      }
      return next(1).then(() => {
        if (database) setCache(database, cacheKey, pages);
        buildViewer(pages);
      });
    });
  }

  function applyDisplayZoom() {
    els.container.style.setProperty('--page-maxh', `${displayVh}vh`);
    document.getElementById('fb-zoom-in').disabled = displayVh >= 82;
    document.getElementById('fb-zoom-out').disabled = displayVh <= 30;
  }

  function setupTouch() {
    const viewport = document.getElementById('spread-viewport');
    const inner = document.getElementById('flip-book');
    let czoom = 1;
    let tx = 0;
    let ty = 0;
    let startDist = 0;
    let anchorElX = 0;
    let anchorElY = 0;
    let gStartZoom = 1;
    let gStartTx = 0;
    let gStartTy = 0;
    let panStart = { x: 0, y: 0 };
    let swipeStartX = 0;
    let isPinching = false;
    let lastTap = 0;
    let pinchEndedAt = 0;

    function dist(touches) {
      const dx = touches[0].clientX - touches[1].clientX;
      const dy = touches[0].clientY - touches[1].clientY;
      return Math.sqrt(dx * dx + dy * dy);
    }
    function mid(touches) {
      return {
        x: (touches[0].clientX + touches[1].clientX) / 2,
        y: (touches[0].clientY + touches[1].clientY) / 2,
      };
    }
    function clamp(value, min, max) {
      return Math.max(min, Math.min(max, value));
    }
    function applyTransform() {
      inner.style.transformOrigin = '0 0';
      inner.style.transform = `translate(${tx}px,${ty}px) scale(${czoom})`;
    }
    function resetTransform() {
      czoom = 1;
      tx = 0;
      ty = 0;
      inner.style.transform = '';
      inner.style.transformOrigin = '';
    }
    touchReset = resetTransform;

    viewport.addEventListener('touchstart', event => {
      if (event.touches.length === 2) {
        isPinching = true;
        event.preventDefault();
        startDist = dist(event.touches);
        const m = mid(event.touches);
        gStartZoom = czoom;
        gStartTx = tx;
        gStartTy = ty;
        const rect = inner.getBoundingClientRect();
        anchorElX = (m.x - rect.left) / gStartZoom;
        anchorElY = (m.y - rect.top) / gStartZoom;
      } else if (event.touches.length === 1) {
        swipeStartX = event.touches[0].clientX;
        if (czoom > 1.05) {
          panStart.x = event.touches[0].clientX - tx;
          panStart.y = event.touches[0].clientY - ty;
        }
      }
    }, { passive: false });

    viewport.addEventListener('touchmove', event => {
      if (event.touches.length === 2 && isPinching) {
        event.preventDefault();
        const newZoom = clamp(gStartZoom * (dist(event.touches) / startDist), 1, 5);
        tx = gStartTx - anchorElX * (newZoom - gStartZoom);
        ty = gStartTy - anchorElY * (newZoom - gStartZoom);
        tx = clamp(tx, -viewport.clientWidth * newZoom, viewport.clientWidth * newZoom);
        ty = clamp(ty, -viewport.clientHeight * newZoom, viewport.clientHeight * newZoom);
        czoom = newZoom;
        applyTransform();
      } else if (event.touches.length === 1 && czoom > 1.05 && !isPinching) {
        event.preventDefault();
        tx = clamp(event.touches[0].clientX - panStart.x, -viewport.clientWidth * czoom, viewport.clientWidth * czoom);
        ty = clamp(event.touches[0].clientY - panStart.y, -viewport.clientHeight * czoom, viewport.clientHeight * czoom);
        applyTransform();
      }
    }, { passive: false });

    viewport.addEventListener('touchend', event => {
      if (event.touches.length < 2) {
        const wasPinching = isPinching;
        isPinching = false;
        if (wasPinching) {
          pinchEndedAt = Date.now();
          if (event.touches.length === 1 && czoom > 1.05) {
            panStart.x = event.touches[0].clientX - tx;
            panStart.y = event.touches[0].clientY - ty;
          }
        }
        if (czoom < 1.05) resetTransform();
        if (isMobile && !wasPinching && czoom <= 1.05 && event.changedTouches.length === 1) {
          const deltaX = event.changedTouches[0].clientX - swipeStartX;
          if (Math.abs(deltaX) > 50) {
            if (deltaX < 0) navigateNext();
            else navigatePrev();
            return;
          }
        }
      }

      if (event.changedTouches.length === 1 && event.touches.length === 0 && Date.now() - pinchEndedAt > 500) {
        const now = Date.now();
        if (now - lastTap < 300) resetTransform();
        lastTap = now;
      }
    });
  }

  els.adminToggle.addEventListener('click', () => {
    if (token) {
      setAdminMode(true);
      return;
    }
    showLogin();
  });
  els.logoutBtn.addEventListener('click', logout);
  els.loginBtn.addEventListener('click', login);
  els.loginCancelBtn.addEventListener('click', () => { els.loginScreen.hidden = true; });
  els.passwordInput.addEventListener('keydown', event => {
    if (event.key === 'Enter') login();
  });
  els.uploadForm.addEventListener('submit', uploadFile);
  els.filePickBtn.addEventListener('click', () => els.fileInput.click());
  els.fileInput.addEventListener('change', () => {
    const file = els.fileInput.files?.[0];
    els.fileNameText.textContent = file ? file.name : '선택된 파일 없음';
  });
  els.qtList.addEventListener('click', event => {
    const deleteButton = event.target.closest('[data-delete]');
    if (deleteButton) {
      deleteItem(deleteButton.dataset.delete);
      return;
    }
    const selectButton = event.target.closest('[data-select]');
    if (!selectButton) return;
    const item = items.find(entry => entry.id === selectButton.dataset.select);
    selectItem(item, true);
  });
  document.getElementById('fb-prev').addEventListener('click', navigatePrev);
  document.getElementById('fb-next').addEventListener('click', navigateNext);
  document.getElementById('fb-first').addEventListener('click', navigateFirst);
  document.getElementById('fb-last').addEventListener('click', navigateLast);
  document.getElementById('fb-arrow-prev').addEventListener('click', navigatePrev);
  document.getElementById('fb-arrow-next').addEventListener('click', navigateNext);
  document.getElementById('fb-fullscreen').addEventListener('click', () => {
    if (document.fullscreenElement) document.exitFullscreen();
    else if (els.container.requestFullscreen) els.container.requestFullscreen();
  });
  document.getElementById('fb-zoom-in').addEventListener('click', () => {
    displayVh = Math.min(displayVh + 10, 82);
    applyDisplayZoom();
  });
  document.getElementById('fb-zoom-out').addEventListener('click', () => {
    displayVh = Math.max(displayVh - 10, 30);
    applyDisplayZoom();
  });
  document.addEventListener('keydown', event => {
    if (els.viewerContent.hidden) return;
    if (event.key === 'ArrowRight' || event.key === 'ArrowDown') navigateNext();
    else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') navigatePrev();
  });

  if (!isMobile) applyDisplayZoom();
  setupTouch();
  loadItems();
  if (token) setAdminMode(true);
</script>
