---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="매일묵상집 | WOLKO 자료실"
  description="WOLKO 매일묵상집 (Q.T Book) 다운로드 페이지입니다."
  activeNav="resources"
>
  <section class="qt-hero">
    <div class="qt-hero-inner">
      <a href="/resources" class="breadcrumb">
        <span class="wl-ko">자료실</span>
        <span class="wl-en">Resources</span>
      </a>
      <div class="hero-eyebrow">
        <span class="hero-eyebrow-dot"></span>
        <span class="wl-ko">월코 매일묵상집</span>
        <span class="wl-en">WOLKO Q.T Book</span>
      </div>
      <h1>
        <span class="wl-ko">말씀과 함께하는 <em>매일의 시간</em></span>
        <span class="wl-en">Daily Time <em>in the Word</em></span>
      </h1>
      <p class="hero-sub">
        <span class="wl-ko">업로드된 매일묵상집 PDF를 책장처럼 둘러보고, 선택한 파일을 페이지 안에서 바로 읽을 수 있습니다.</span>
        <span class="wl-en">Browse uploaded Q.T book PDFs and read the selected file directly on this page.</span>
      </p>
      <button class="admin-toggle" id="adminToggle" type="button">관리 로그인</button>
    </div>
  </section>

  <main>
    <section class="admin-shell" id="adminPanel" hidden>
      <div class="admin-panel">
        <div class="panel-head">
          <div>
            <h2>파일 업로드</h2>
            <p>PDF 파일을 선택하면 책장과 뷰어에 바로 반영됩니다.</p>
          </div>
          <button class="ghost-btn" id="logoutBtn" type="button">관리 종료</button>
        </div>
        <form class="upload-form" id="uploadForm">
          <label>
            <span>제목</span>
            <input id="titleInput" type="text" placeholder="예: 2026년 7월 매일묵상집" maxlength="160">
          </label>
          <label>
            <span>월</span>
            <input id="monthInput" type="month">
          </label>
          <label class="file-field">
            <span>PDF 파일</span>
            <div class="file-picker">
              <button class="file-picker-btn" id="filePickBtn" type="button">파일 선택</button>
              <span class="file-name" id="fileNameText">선택된 파일 없음</span>
            </div>
            <input id="fileInput" type="file" accept=".pdf,application/pdf" hidden>
          </label>
          <button class="primary-btn" id="uploadBtn" type="submit">업로드</button>
        </form>
        <p class="status-line" id="uploadStatus"></p>
      </div>
    </section>

    <section class="archive-section">
      <div class="archive-inner">
        <div class="archive-top">
          <div>
            <div class="archive-section-title">
              <span class="wl-ko">매일묵상집 책장</span>
              <span class="wl-en">Q.T Book Shelf</span>
            </div>
            <p class="archive-sub">
              <span class="wl-ko">책을 선택하면 아래 뷰어에서 바로 열립니다.</span>
              <span class="wl-en">Select a book to open it in the viewer below.</span>
            </p>
          </div>
          <span class="archive-count" id="archiveCount">0 PDF</span>
        </div>
        <p class="load-error" id="loadError" hidden></p>
        <div class="qt-grid" id="qtList" aria-live="polite">
          <div class="empty-state">
            <p>매일묵상집 목록을 불러오는 중입니다.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="flipbook-section">
      <div class="flipbook-wrap">
        <div class="no-pdf" id="viewerEmpty">
          <div class="no-pdf-icon">
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none"><rect x="10" y="6" width="28" height="36" rx="4" stroke="#004f68" stroke-width="2"/><path d="M18 18h12M18 24h12M18 30h8" stroke="#004f68" stroke-width="2" stroke-linecap="round"/></svg>
          </div>
          <h3><span class="wl-ko">매일묵상집 준비 중</span><span class="wl-en">Q.T Book Coming Soon</span></h3>
          <p><span class="wl-ko">업로드된 매일묵상집이 아직 없습니다.</span><span class="wl-en">No Q.T book has been uploaded yet.</span></p>
        </div>

        <div id="viewerContent" hidden>
          <div class="report-meta">
            <div>
              <div class="report-title" id="reportTitle">매일묵상집</div>
              <div class="report-date" id="reportDate"></div>
            </div>
            <a href="#" target="_blank" rel="noopener" class="download-btn" id="reportDownload">
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v7M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span class="wl-ko">PDF 다운로드</span><span class="wl-en">Download PDF</span>
            </a>
          </div>

          <div id="flipbook-container">
            <div class="fb-controls">
              <div class="fb-nav">
                <button class="fb-btn" id="fb-first" title="처음 페이지" disabled>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 2v10M5 7l5-4v8L5 7z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="fb-btn" id="fb-prev" title="이전 페이지" disabled>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M9 11L4 7l5-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <span class="fb-page-info" id="fb-page-info">1 / -</span>
                <button class="fb-btn" id="fb-next" title="다음 페이지" disabled>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M5 3l5 4-5 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <button class="fb-btn" id="fb-last" title="마지막 페이지" disabled>
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M11 2v10M9 7L4 3v8l5-4z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
              <div class="fb-right">
                <div class="fb-zoom-btns">
                  <button class="fb-zoom-btn" id="fb-zoom-out" title="축소">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 7h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  </button>
                  <button class="fb-zoom-btn" id="fb-zoom-in" title="확대">
                    <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  </button>
                </div>
                <button class="fb-fullscreen-btn" id="fb-fullscreen" title="전체화면">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 5V2h3M9 2h3v3M12 9v3H9M5 12H2V9" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
              </div>
            </div>
            <div id="spread-viewport">
              <button class="fb-arrow-btn" id="fb-arrow-prev" title="이전 페이지" disabled>
                <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><path d="M8 2L2 9l6 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="fb-arrow-btn" id="fb-arrow-next" title="다음 페이지" disabled>
                <svg width="10" height="18" viewBox="0 0 10 18" fill="none"><path d="M2 2l6 7-6 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div id="fb-loading" class="fb-loading-indicator">
                <div class="fb-spinner"></div>
                <span id="fb-loading-text">PDF를 불러오는 중입니다...</span>
              </div>
              <div id="flip-book"></div>
            </div>
            <div class="fb-dots-bar" id="fb-dots"></div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <div class="login-screen" id="loginScreen" hidden>
    <div class="login-card">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <h2>관리 로그인</h2>
      <p>매일묵상집 파일 업로드 권한이 필요합니다.</p>
      <input id="passwordInput" type="password" placeholder="공유 비밀번호" autocomplete="current-password">
      <p class="login-error" id="loginError"></p>
      <button class="primary-btn" id="loginBtn" type="button">확인</button>
      <button class="ghost-btn" id="loginCancelBtn" type="button">취소</button>
    </div>
  </div>
</BaseLayout>

<style is:global>
  :root {
    --qt-deep: #004f68;
    --qt-mid: #0a5b76;
    --qt-light: #73d1f5;
    --qt-bg: #f4f8fb;
    --qt-white: #ffffff;
    --qt-text: #152028;
    --qt-muted: #5b6b78;
    --qt-line: rgba(0,79,104,0.12);
    --qt-radius-xl: 28px;
  }

  .qt-hero {
    position: relative;
    overflow: hidden;
    padding: 88px 24px 64px;
    text-align: center;
    background: linear-gradient(135deg, #083d51 0%, var(--qt-deep) 60%, var(--qt-mid) 100%);
    color: #fff;
  }
  .qt-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    pointer-events: none;
  }
  .qt-hero-inner {
    position: relative;
    z-index: 2;
    max-width: 760px;
    margin: 0 auto;
  }
  .breadcrumb {
    position: absolute;
    top: -44px;
    left: 0;
    color: rgba(255,255,255,0.72);
    text-decoration: none;
    font-size: 13px;
    font-weight: 700;
  }
  .breadcrumb:hover { color: #fff; }
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 16px;
    border-radius: 999px;
    background: rgba(255,255,255,0.12);
    border: 1px solid rgba(255,255,255,0.22);
    color: rgba(255,255,255,0.9);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.09em;
    margin-bottom: 22px;
    text-transform: uppercase;
  }
  .hero-eyebrow-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--qt-light);
  }
  .qt-hero h1 {
    margin: 0 0 14px;
    color: #fff;
    font-size: clamp(32px, 5vw, 56px);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.13;
  }
  .qt-hero h1 em {
    color: #9ae3ff;
    font-style: normal;
  }
  .hero-sub {
    max-width: 590px;
    margin: 0 auto;
    color: rgba(255,255,255,0.8);
    font-size: 16px;
    line-height: 1.88;
  }
  .admin-toggle {
    position: absolute;
    top: -48px;
    right: 0;
    min-height: 38px;
    border-radius: 999px;
    padding: 0 16px;
    background: rgba(255,255,255,0.13);
    color: #fff;
    border: 1px solid rgba(255,255,255,0.28);
    font-size: 13px;
    font-weight: 800;
    cursor: pointer;
    white-space: nowrap;
  }
  .admin-toggle:hover { background: rgba(255,255,255,0.22); }

  .admin-shell {
    padding: 32px 24px 0;
    background: var(--qt-bg);
  }
  .admin-shell[hidden] { display: none; }
  .admin-panel {
    max-width: 1100px;
    margin: 0 auto;
    border: 1px solid #d9e9ef;
    border-radius: 18px;
    padding: 22px;
    background: rgba(255,255,255,0.78);
    box-shadow: 0 12px 28px rgba(0,79,104,0.06);
  }
  .panel-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 18px;
  }
  .panel-head h2 {
    margin: 0;
    color: var(--qt-deep);
    font-size: 1.15rem;
  }
  .panel-head p {
    margin: 6px 0 0;
    color: #6b8794;
    font-size: 0.92rem;
  }
  .upload-form {
    display: grid;
    grid-template-columns: 1.4fr 180px 1fr auto;
    gap: 12px;
    align-items: end;
  }
  .upload-form label {
    display: grid;
    gap: 7px;
    color: #45616f;
    font-size: 0.82rem;
    font-weight: 700;
  }
  .upload-form input {
    width: 100%;
    min-height: 42px;
    border: 1px solid #cfdfe6;
    border-radius: 9px;
    padding: 0 12px;
    color: #1d3340;
    background: #fff;
  }
  .file-picker {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 42px;
    border: 1px solid #cfdfe6;
    border-radius: 9px;
    padding: 6px 10px;
    background: #fff;
    min-width: 0;
  }
  .file-picker-btn {
    flex: 0 0 auto;
    min-height: 30px;
    border: 1px solid #bed6df;
    border-radius: 7px;
    background: #f4fafc;
    color: var(--qt-deep);
    padding: 0 12px;
    font-weight: 800;
    cursor: pointer;
  }
  .file-picker-btn:hover {
    background: #e6f3f7;
    border-color: #9fc7d3;
  }
  .file-name {
    min-width: 0;
    overflow: hidden;
    color: #45616f;
    font-size: 0.9rem;
    font-weight: 500;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .primary-btn,
  .ghost-btn,
  .delete-btn {
    min-height: 40px;
    border-radius: 9px;
    padding: 0 16px;
    font-weight: 800;
    border: 0;
    cursor: pointer;
  }
  .primary-btn {
    background: var(--qt-deep);
    color: #fff;
  }
  .primary-btn:hover { background: #007a9a; }
  .primary-btn:disabled {
    opacity: 0.56;
    cursor: not-allowed;
  }
  .ghost-btn {
    background: #f7fbfd;
    color: var(--qt-deep);
    border: 1px solid #d4e7ee;
  }
  .ghost-btn:hover { background: #edf7fa; }
  .status-line {
    min-height: 20px;
    margin: 12px 0 0;
    color: #6b8794;
    font-size: 0.9rem;
  }
  .status-line.is-error,
  .login-error {
    color: #c42a36;
  }

  .archive-section {
    padding: 56px 24px 72px;
    background: var(--qt-bg);
  }
  .archive-inner {
    max-width: 1100px;
    margin: 0 auto;
  }
  .archive-top {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 28px;
  }
  .archive-section-title {
    color: var(--qt-text);
    font-size: 18px;
    font-weight: 800;
  }
  .archive-sub {
    margin: 8px 0 0;
    color: var(--qt-muted);
    font-size: 14px;
  }
  .archive-count {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    border-radius: 999px;
    border: 1px solid var(--qt-line);
    padding: 0 13px;
    background: var(--qt-white);
    color: var(--qt-deep);
    font-size: 12px;
    font-weight: 900;
    white-space: nowrap;
  }
  .load-error {
    margin: 0 0 18px;
    padding: 12px 14px;
    border: 1px solid #f0cbd0;
    border-radius: 9px;
    background: #fff8f9;
    color: #c42a36;
  }
  .qt-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 32px 22px;
  }
  .empty-state {
    grid-column: 1 / -1;
    border: 2px dashed var(--qt-line);
    border-radius: var(--qt-radius-xl);
    background: rgba(255,255,255,0.72);
    padding: 48px 24px;
    text-align: center;
    color: var(--qt-muted);
  }
  .empty-state p { margin: 0; }
  .qt-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-align: center;
  }
  .qt-card-button {
    appearance: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    text-align: center;
  }
  .qt-card-button:hover .qt-book,
  .qt-card.current .qt-book {
    transform: translateY(-7px) rotate(-1deg);
    box-shadow: 10px 20px 40px rgba(0,79,104,0.22);
  }
  .qt-card:not(.current) .qt-book {
    filter: grayscale(1);
    opacity: 0.58;
  }
  .qt-card:not(.current) .qt-card-button:hover .qt-book {
    filter: grayscale(0);
    opacity: 1;
  }
  .qt-book {
    width: 108px;
    height: 148px;
    display: flex;
    border-radius: 0 6px 6px 0;
    box-shadow: 5px 8px 20px rgba(0,0,0,0.14);
    transition: transform 0.25s cubic-bezier(.22,.68,0,1.2), box-shadow 0.25s, filter 0.18s, opacity 0.18s;
  }
  .qt-book-spine {
    width: 20px;
    flex-shrink: 0;
    border-radius: 4px 0 0 4px;
    background: linear-gradient(180deg, var(--qt-deep) 0%, var(--qt-mid) 100%);
    box-shadow: inset -3px 0 6px rgba(0,0,0,0.22);
  }
  .qt-book-cover {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border: 1px solid rgba(0,79,104,0.18);
    border-left: 0;
    border-radius: 0 6px 6px 0;
    background: linear-gradient(135deg, #e8f4f8 0%, #cce5f0 100%);
  }
  .qt-book-month {
    color: var(--qt-deep);
    font-size: 18px;
    font-weight: 900;
    line-height: 1.22;
  }
  .qt-book-year {
    color: var(--qt-muted);
    font-size: 12px;
    font-weight: 800;
  }
  .qt-book-type {
    color: var(--qt-muted);
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.08em;
  }
  .qt-title {
    margin: 0;
    color: var(--qt-text);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.4;
    word-break: keep-all;
  }
  .qt-date {
    color: var(--qt-muted);
    font-size: 11px;
  }
  .qt-meta {
    color: var(--qt-muted);
    font-size: 11px;
    line-height: 1.45;
  }
  .qt-current-badge {
    display: none;
    padding: 2px 9px;
    border-radius: 999px;
    background: rgba(0,79,104,0.10);
    color: var(--qt-deep);
    font-size: 10px;
    font-weight: 900;
  }
  .qt-card.current .qt-current-badge {
    display: inline-block;
  }
  .qt-actions {
    display: flex;
    justify-content: center;
  }
  .delete-btn {
    min-height: 30px;
    padding: 0 11px;
    font-size: 0.78rem;
    background: #fff5f6;
    color: #c42a36;
    border: 1px solid #f0cbd0;
  }
  .delete-btn:hover { background: #fdecee; }

  .flipbook-section {
    padding: 48px 24px 80px;
    background: var(--qt-white);
  }
  .flipbook-wrap {
    max-width: 1100px;
    margin: 0 auto;
  }
  .no-pdf {
    text-align: center;
    padding: 80px 24px;
    border: 2px dashed var(--qt-line);
    border-radius: var(--qt-radius-xl);
    background: var(--qt-bg);
  }
  .no-pdf-icon {
    margin-bottom: 16px;
    display: flex;
    justify-content: center;
    opacity: 0.6;
  }
  .no-pdf h3 {
    margin: 0 0 10px;
    color: var(--qt-text);
    font-size: 22px;
    font-weight: 800;
  }
  .no-pdf p {
    max-width: 420px;
    margin: 0 auto;
    color: var(--qt-muted);
    font-size: 15px;
    line-height: 1.8;
  }
  #viewerContent[hidden] { display: none; }
  .report-meta {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 28px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--qt-line);
  }
  .report-meta > div {
    flex: 1;
    min-width: 220px;
  }
  .report-title {
    color: var(--qt-text);
    font-size: 22px;
    font-weight: 800;
  }
  .report-date {
    margin-top: 5px;
    color: var(--qt-muted);
    font-size: 12px;
    font-weight: 700;
  }
  .download-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 999px;
    background: rgba(0,79,104,0.08);
    color: var(--qt-deep);
    border: 1px solid var(--qt-line);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.18s;
  }
