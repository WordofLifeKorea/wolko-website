---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
const naverClientId = import.meta.env.PUBLIC_NAVER_CLIENT_ID ?? '';
---

<BaseLayout
  title="오시는 길 — Word of Life Korea"
  description="월코 평택 월코센터와 제주 월비 오시는 길 안내. Word of Life Korea location and directions."
  activeNav="location"
>
  <Fragment slot="head">
    <script is:inline src={`https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=${naverClientId}`}></script>
  </Fragment>

<style>
  /* 색은 감싸는 클래스에 둔다 — 사역 페이지와 같은 값 */
  .lo {
    --lo-deep:#004f68; --lo-navy:#0b2430; --lo-ink:#10252e;
    --lo-text:#4a5d66; --lo-muted:#587383; --lo-label:#5a7380;
    --lo-line:#d6dee2; --lo-soft:#f6f9fb; --lo-fill:#f3f7f9;
    font-family:var(--ff-sans); color:var(--lo-ink); background:#fff;
    word-break:keep-all;
  }
  .lo-shell { width:min(1200px, calc(100% - 48px)); margin-inline:auto; }

  /* CAMPUS TABS — 가는 밑줄, 고른 글자 */
  .lo-tabs {
    background:#fff; border-bottom:1px solid var(--lo-line);
    position:sticky; top:62px; z-index:10;
  }
  .lo-tabs-inner { display:flex; gap:40px; }
  .lo-tab {
    height:60px; padding:0; font-size:15px; font-weight:700;
    color:var(--lo-muted); border:none; background:none; cursor:pointer;
    border-bottom:2px solid transparent; margin-bottom:-1px;
    transition:color .2s, border-color .2s; font-family:inherit;
  }
  .lo-tab.active { color:var(--lo-navy); border-bottom-color:var(--lo-deep); }
  .lo-tab:hover:not(.active) { color:var(--lo-deep); }
  .lo-tab:focus-visible { outline:2px solid var(--lo-deep); outline-offset:-2px; }

  /* CAMPUS PANEL */
  .lo-panel { display:none; padding:96px 0 120px; }
  .lo-panel.active { display:block; }

  /* 정보 + 지도 — 왼쪽 글, 오른쪽 큰 지도 */
  .lo-card {
    display:grid;
    grid-template-columns:minmax(0,5fr) minmax(0,7fr);
    gap:72px; align-items:stretch;
  }

  /* 왼쪽 정보 */
  .lo-card-info { display:flex; flex-direction:column; min-width:0; }
  .lo-card-label {
    display:flex; align-items:center; gap:12px;
    color:var(--lo-deep); font-size:13px; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
  }
  .lo-card-label::before { content:''; width:28px; height:1px; background:currentColor; }
  .lo-card-title {
    margin-top:20px; margin-bottom:36px;
    font-family:var(--ff-serif); font-size:clamp(30px, 3.4vw, 46px); font-weight:700;
    line-height:1.22; letter-spacing:-.03em; color:var(--lo-navy);
  }
  .lo-info { margin:0; }
  .lo-info-row {
    display:grid; grid-template-columns:96px minmax(0,1fr); gap:16px; align-items:baseline;
    padding:16px 0; border-top:1px solid var(--lo-line);
  }
  .lo-info-row:last-child { border-bottom:1px solid var(--lo-line); }
  .lo-info-dt { font-size:12px; font-weight:700; color:var(--lo-label); letter-spacing:.06em; text-transform:uppercase; }
  .lo-info-dd { margin:0; font-size:16px; font-weight:600; color:var(--lo-ink); line-height:1.65; overflow-wrap:anywhere; }
  .lo-info-dd a { color:var(--lo-ink); text-decoration:none; }
  .lo-info-dd a:hover { color:var(--lo-deep); text-decoration:underline; text-underline-offset:4px; text-decoration-thickness:1px; }

  /* 네이버맵 버튼 */
  .lo-map-btn {
    margin-top:32px; align-self:flex-start;
    height:52px; padding:0 22px; display:inline-flex; align-items:center; justify-content:space-between; gap:14px;
    border-radius:2px; background:var(--lo-deep); color:#fff;
    font-size:15px; font-weight:700; text-decoration:none;
    transition:background-color .2s, gap .25s;
  }
  .lo-map-btn:hover { background:#00384a; color:#fff; gap:18px; }
  .lo-map-btn svg { width:14px; height:14px; flex:none; fill:none; stroke:currentColor; stroke-width:1.8; stroke-linecap:square; }

  /* 오른쪽 지도 */
  .lo-card-map {
    position:relative; min-height:520px;
    background:var(--lo-fill); border:1px solid var(--lo-line);
  }
  .lo-naver-map {
    position:absolute; inset:0; width:100%; height:100%; display:block; background:#e8eef1;
  }

  /* 스크롤하면 떠오르기 — 스크립트가 .lo-rv 를 붙일 때만 */
  .lo-rv { opacity:0; transform:translateY(28px); transition:opacity 1.1s cubic-bezier(.2,.7,.2,1) var(--rd, 0s), transform 1.1s cubic-bezier(.2,.7,.2,1) var(--rd, 0s); }
  .lo-rv.is-in { opacity:1; transform:none; }
  .lo-card-map.lo-rv { transform:none; }

  /* RESPONSIVE */
  @media(max-width:980px) {
    .lo-card { grid-template-columns:minmax(0,1fr); gap:40px; }
    .lo-card-map { min-height:400px; }
  }
  @media(max-width:800px) {
    .lo-card-map { min-height:320px; }
    .lo-tab { font-size:14px; }
    .lo-panel { padding:56px 0 72px; }
  }
  @media(max-width:740px) {
    .lo-shell { width:calc(100% - 40px); }
    .lo-tabs-inner { gap:28px; }
    .lo-tab { height:52px; }
    .lo-card-title { margin-bottom:28px; }
    .lo-info-row { grid-template-columns:76px minmax(0,1fr); gap:12px; }
    .lo-info-dd { font-size:15px; }
    .lo-map-btn { align-self:stretch; }
    .lo-card-map { width:calc(100% + 40px); margin-left:-20px; border-left:none; border-right:none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lo-map-btn, .lo-tab { transition:none; }
  }
</style>

<div id="lang-root" class="lo">

<!-- HERO -->
<PageHero variant="plain">
  <Fragment slot="eyebrow">Location</Fragment>
  <Fragment slot="title">
    <span class="wl-ko">오시는 길 안내</span>
    <span class="wl-en">Find Our Offices</span>
  </Fragment>
</PageHero>

<!-- TABS -->
<div class="lo-tabs">
  <div class="lo-shell lo-tabs-inner">
    <button class="lo-tab active" onclick="showPanel('pyeongtaek', this)" type="button">
      <span class="wl-ko">평택 월코센터</span><span class="wl-en">Pyeongtaek WOLKO Center</span>
    </button>
    <button class="lo-tab" onclick="showPanel('jeju', this)" type="button">
      <span class="wl-ko">제주 월비</span><span class="wl-en">Jeju WOLBI</span>
    </button>
  </div>
</div>

<!-- PYEONGTAEK PANEL -->
<div class="lo-panel active" id="panel-pyeongtaek">
  <div class="lo-shell">
    <div class="lo-card">

      <!-- 왼쪽: 정보 -->
      <div class="lo-card-info">
        <p class="lo-card-label"><span class="wl-ko">주소 및 연락처</span><span class="wl-en">Address & Contact</span></p>
        <h2 class="lo-card-title"><span class="wl-ko">평택 월코센터</span><span class="wl-en">Pyeongtaek WOLKO Center</span></h2>
        <dl class="lo-info">
          <div class="lo-info-row">
            <dt class="lo-info-dt"><span class="wl-ko">주소</span><span class="wl-en">Address</span></dt>
            <dd class="lo-info-dd">
              <span class="wl-ko">경기도 평택시 경기대로 1407, 2층</span>
              <span class="wl-en">1407 Gyeonggi-daero, 2F<br>Pyeongtaek, Gyeonggi-do</span>
            </dd>
          </div>
          <div class="lo-info-row">
            <dt class="lo-info-dt"><span class="wl-ko">전화</span><span class="wl-en">Phone</span></dt>
            <dd class="lo-info-dd"><a href="tel:031-611-9216">031-611-9216</a></dd>
          </div>
          <div class="lo-info-row">
            <dt class="lo-info-dt">Email</dt>
            <dd class="lo-info-dd"><a href="mailto:wolkorea1@gmail.com">wolkorea1@gmail.com</a></dd>
          </div>
          <div class="lo-info-row">
            <dt class="lo-info-dt"><span class="wl-ko">운영 시간</span><span class="wl-en">Hours</span></dt>
            <dd class="lo-info-dd">
              <span class="wl-ko">화–금 09:00–17:00<br>주말 및 공휴일 휴무</span>
              <span class="wl-en">Tue–Fri 9 AM–5 PM<br>Closed weekends & holidays</span>
            </dd>
          </div>
        </dl>
        <a class="lo-map-btn"
           href="https://map.naver.com/p/search/경기도+평택시+경기대로+1407"
           target="_blank" rel="noopener">
          <span><span class="wl-ko">네이버맵으로 보기</span><span class="wl-en">Open in Naver Map</span></span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
        </a>
      </div>

      <!-- 오른쪽: 지도 -->
      <div class="lo-card-map">
        <div id="naverMapPyeongtaek" class="lo-naver-map"
             data-address="경기도 평택시 경기대로 1407"
             data-label="평택 월코센터"></div>
      </div>

    </div>
  </div>
</div>

<!-- JEJU PANEL -->
<div class="lo-panel" id="panel-jeju">
  <div class="lo-shell">
    <div class="lo-card">

      <!-- 왼쪽: 정보 -->
      <div class="lo-card-info">
        <p class="lo-card-label"><span class="wl-ko">주소 및 연락처</span><span class="wl-en">Address & Contact</span></p>
        <h2 class="lo-card-title"><span class="wl-ko">제주 월비</span><span class="wl-en">Jeju WOLBI</span></h2>
        <dl class="lo-info">
          <div class="lo-info-row">
            <dt class="lo-info-dt"><span class="wl-ko">주소</span><span class="wl-en">Address</span></dt>
            <dd class="lo-info-dd">
              <span class="wl-ko">제주시 애월읍 광상로 622</span>
              <span class="wl-en">622 Gwangsang-ro, Aewol-eup<br>Jeju-si, Jeju</span>
            </dd>
          </div>
          <div class="lo-info-row">
            <dt class="lo-info-dt"><span class="wl-ko">전화</span><span class="wl-en">Phone</span></dt>
            <dd class="lo-info-dd"><a href="tel:064-799-3707">064-799-3707</a></dd>
          </div>
          <div class="lo-info-row">
            <dt class="lo-info-dt">Email</dt>
            <dd class="lo-info-dd"><a href="mailto:wolbijeju.contact@gmail.com">wolbijeju.contact@gmail.com</a></dd>
          </div>
          <div class="lo-info-row">
            <dt class="lo-info-dt"><span class="wl-ko">운영 시간</span><span class="wl-en">Hours</span></dt>
            <dd class="lo-info-dd">
              <span class="wl-ko">화–금 09:00–17:00<br>주말 및 공휴일 휴무</span>
              <span class="wl-en">Tue–Fri 9 AM–5 PM<br>Closed weekends & holidays</span>
            </dd>
          </div>
        </dl>
        <a class="lo-map-btn"
           href="https://map.naver.com/p/search/제주시+애월읍+광상로+622"
           target="_blank" rel="noopener">
          <span><span class="wl-ko">네이버맵으로 보기</span><span class="wl-en">Open in Naver Map</span></span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
        </a>
      </div>

      <!-- 오른쪽: 지도 -->
      <div class="lo-card-map">
        <div id="naverMapJeju" class="lo-naver-map"
             data-address="제주특별자치도 제주시 애월읍 광상로 622"
             data-label="제주 월비 WOLBI"></div>
      </div>

    </div>
  </div>
</div>

</div><!-- end lang-root -->

<script is:inline>
var loMaps = {};

function showPanel(id, btn) {
  document.querySelectorAll('.lo-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.lo-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('panel-' + id).classList.add('active');
  btn.classList.add('active');
  // 숨겨졌던 지도가 보이게 되면 크기 재계산
  var map = loMaps[id];
  if (map && window.naver) {
    setTimeout(function() {
      var c = map.getCenter();
      naver.maps.Event.trigger(map, 'resize');
      map.setCenter(c);
    }, 60);
  }
}

// 네이버 지도 초기화
async function initLocationMap(key, elId) {
  var el = document.getElementById(elId);
  if (!el || typeof naver === 'undefined') return;
  var address = el.dataset.address;
  var label = el.dataset.label;

  // 좌표 조회 (서버 프록시)
  var lat = null, lng = null;
  try {
    var res = await fetch('/api/geocode?query=' + encodeURIComponent(address));
    if (res.ok) {
      var data = await res.json();
      if (data.addresses && data.addresses.length) {
        lat = parseFloat(data.addresses[0].y);
        lng = parseFloat(data.addresses[0].x);
      }
    }
  } catch (e) {}

  if (lat == null || lng == null) {
    el.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:#5a7380;font-size:14px;">지도를 불러올 수 없습니다</div>';
    return;
  }

  var pos = new naver.maps.LatLng(lat, lng);
  var map = new naver.maps.Map(el, {
    center: pos,
    zoom: 16,
    zoomControl: true,
    zoomControlOptions: { position: naver.maps.Position.TOP_RIGHT },
  });
  new naver.maps.Marker({
    position: pos,
    map: map,
    title: label,
    icon: {
      content: '<div style="position:relative;width:32px;height:42px;transform:translate(-50%,-100%);filter:drop-shadow(0 3px 6px rgba(0,0,0,.35));"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 42" width="32" height="42"><path d="M16 0C7.163 0 0 7.163 0 16c0 10.5 16 26 16 26S32 26.5 32 16C32 7.163 24.837 0 16 0z" fill="#004f68"/><circle cx="16" cy="16" r="7" fill="#fff"/></svg></div>',
      anchor: new naver.maps.Point(0, 0),
    },
  });
  loMaps[key] = map;
}

(function() {
  function start() {
    if (typeof naver === 'undefined' || !naver.maps) { setTimeout(start, 200); return; }
    initLocationMap('pyeongtaek', 'naverMapPyeongtaek');
    initLocationMap('jeju', 'naverMapJeju');
  }
  start();
})();

// 오시는 길 움직임: 정보 글은 아래에서 차례로 떠오르고, 지도는 흐리게 있다가 선명해진다(지도는 움직이지 않는다).
// 숨겨진 탭은 보일 때 떠오른다. 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다.
(function () {
  if (!('IntersectionObserver' in window)) return;
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var items = [].slice.call(document.querySelectorAll('.lo-card-info > *, .lo-card-map'));
  items.forEach(function (el) {
    var sib = el.parentNode.children, i = [].indexOf.call(sib, el);
    el.style.setProperty('--rd', Math.min(i, 6) * 0.08 + 's');
    el.classList.add('lo-rv');
  });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  items.forEach(function (el) { io.observe(el); });
})();
</script>

</BaseLayout>
