---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="오시는 길 — Word of Life Korea"
  description="월코 평택 본부와 제주 월비 오시는 길 안내. Word of Life Korea location and directions."
  activeNav="location"
>

<style>
  :root {
    --d:#004f68; --m:#007ea1; --l:#73d1f5;
    --r:#c42a36; --k:#0d1b24; --s:#3d5a6a;
    --bg:#f4f8fb; --line:rgba(0,79,104,0.1);
  }

  /* HERO */
  .lo-hero {
    background: linear-gradient(135deg, #061820 0%, #004f68 55%, #00788f 100%);
    padding:140px 24px 90px; text-align:center;
    position:relative; overflow:hidden;
  }
  .lo-hero::before {
    content:""; position:absolute; inset:0;
    background-image: radial-gradient(circle at 75% 40%, rgba(115,209,245,0.07) 0%, transparent 55%),
                      radial-gradient(circle at 15% 70%, rgba(115,209,245,0.04) 0%, transparent 45%);
    pointer-events:none;
  }
  .lo-hero::after {
    content:""; position:absolute; inset:0;
    background-image: linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),
                      linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);
    background-size:60px 60px; pointer-events:none;
  }
  .lo-hero-in { position:relative; z-index:2; max-width:700px; margin:0 auto; }
  .lo-eyebrow {
    display:inline-flex; align-items:center; gap:8px; padding:6px 16px;
    border-radius:999px; background:rgba(115,209,245,0.15);
    border:1px solid rgba(115,209,245,0.3);
    font-size:11px; font-weight:800; letter-spacing:0.1em; color:var(--l);
    text-transform:uppercase; margin-bottom:20px;
  }
  .lo-hero h1 {
    font-size:clamp(34px,5vw,54px); font-weight:800; line-height:1.15;
    color:#fff; margin-bottom:14px; letter-spacing:-0.03em;
  }
  .lo-hero h1 em { font-style:normal; color:var(--l); }
  .lo-hero-sub {
    font-size:17px; line-height:1.85; color:rgba(255,255,255,0.78); max-width:560px; margin:0 auto;
  }

  /* CAMPUS TABS */
  .lo-tabs {
    display:flex; justify-content:center; gap:0;
    background:#fff; border-bottom:2px solid var(--line);
    position:sticky; top:68px; z-index:10;
  }
  .lo-tab {
    padding:18px 36px; font-size:14px; font-weight:800;
    color:var(--s); border:none; background:none; cursor:pointer;
    border-bottom:3px solid transparent; margin-bottom:-2px;
    transition:color .2s, border-color .2s; font-family:inherit;
  }
  .lo-tab.active { color:var(--d); border-bottom-color:var(--d); }
  .lo-tab:hover:not(.active) { color:var(--m); }

  /* CAMPUS PANEL */
  .lo-panel { display:none; padding:64px 24px 80px; background:var(--bg); }
  .lo-panel.active { display:block; }
  .lo-panel-inner { max-width:1040px; margin:0 auto; }

  /* LOCATION CARD (info + map unified) */
  .lo-card {
    background:#fff;
    border-radius:24px;
    border:1px solid var(--line);
    box-shadow:0 6px 32px rgba(0,79,104,0.09);
    overflow:hidden;
    display:grid;
    grid-template-columns:300px 1fr;
  }

  /* 왼쪽 정보 패널 */
  .lo-card-info {
    padding:36px 32px;
    display:flex;
    flex-direction:column;
    gap:0;
    border-right:1px solid var(--line);
  }
  .lo-card-label {
    font-size:10px; font-weight:800; letter-spacing:0.12em;
    text-transform:uppercase; color:var(--m); margin-bottom:20px;
  }
  .lo-info-row {
    padding:13px 0; border-bottom:1px solid var(--line);
    display:flex; flex-direction:column; gap:3px;
  }
  .lo-info-row:last-child { border-bottom:none; padding-bottom:0; }
  .lo-info-dt { font-size:10px; font-weight:700; color:var(--s); letter-spacing:0.05em; text-transform:uppercase; }
  .lo-info-dd { font-size:14px; font-weight:600; color:var(--k); line-height:1.65; }
  .lo-info-dd a { color:var(--d); text-decoration:none; }
  .lo-info-dd a:hover { text-decoration:underline; }

  /* 네이버맵 버튼 */
  .lo-map-btn {
    display:inline-flex; align-items:center; gap:7px; margin-top:24px;
    padding:10px 18px; border-radius:999px;
    background:var(--d); color:#fff;
    font-size:12px; font-weight:800; text-decoration:none;
    transition:background .2s; align-self:flex-start;
  }
  .lo-map-btn:hover { background:var(--m); }

  /* 오른쪽 지도 */
  .lo-card-map {
    position:relative; min-height:360px;
  }
  .lo-card-map iframe {
    position:absolute; inset:0; width:100%; height:100%; border:none; display:block;
  }

  /* RESPONSIVE */
  @media(max-width:800px) {
    .lo-card { grid-template-columns:1fr; grid-template-rows:auto 280px; }
    .lo-card-info { border-right:none; border-bottom:1px solid var(--line); }
    .lo-card-map { min-height:280px; }
    .lo-tab { padding:14px 20px; font-size:13px; }
    .lo-panel { padding:40px 16px 60px; }
  }
</style>

<div id="lang-root">

<!-- HERO -->
<section class="lo-hero">
  <div class="lo-hero-in">
    <div class="lo-eyebrow">Location</div>
    <h1>
      <span class="wl-ko">오시는 <em>길 안내</em></span>
      <span class="wl-en">Find <em>Our Offices</em></span>
    </h1>
  </div>
</section>

<!-- TABS -->
<div class="lo-tabs">
  <button class="lo-tab active" onclick="showPanel('pyeongtaek', this)" type="button">
    <span class="wl-ko">평택 본부</span><span class="wl-en">Pyeongtaek HQ</span>
  </button>
  <button class="lo-tab" onclick="showPanel('jeju', this)" type="button">
    <span class="wl-ko">제주 월비</span><span class="wl-en">Jeju WOLBI</span>
  </button>
</div>

<!-- PYEONGTAEK PANEL -->
<div class="lo-panel active" id="panel-pyeongtaek">
  <div class="lo-panel-inner">
    <div class="lo-card">

      <!-- 왼쪽: 정보 -->
      <div class="lo-card-info">
        <div class="lo-card-label"><span class="wl-ko">주소 및 연락처</span><span class="wl-en">Address & Contact</span></div>
        <div class="lo-info-row">
          <div class="lo-info-dt"><span class="wl-ko">주소</span><span class="wl-en">Address</span></div>
          <div class="lo-info-dd">
            <span class="wl-ko">경기도 평택시 경기대로 1407, 2층</span>
            <span class="wl-en">1407 Gyeonggi-daero, 2F<br>Pyeongtaek, Gyeonggi-do</span>
          </div>
        </div>
        <div class="lo-info-row">
          <div class="lo-info-dt"><span class="wl-ko">전화</span><span class="wl-en">Phone</span></div>
          <div class="lo-info-dd"><a href="tel:070-4190-6084">070-4190-6084</a></div>
        </div>
        <div class="lo-info-row">
          <div class="lo-info-dt">Email</div>
          <div class="lo-info-dd"><a href="mailto:wolkorea@gmail.com">wolkorea@gmail.com</a></div>
        </div>
        <div class="lo-info-row">
          <div class="lo-info-dt"><span class="wl-ko">운영 시간</span><span class="wl-en">Hours</span></div>
          <div class="lo-info-dd">
            <span class="wl-ko">화–금 09:00–17:00<br>주말 및 공휴일 휴무</span>
            <span class="wl-en">Tue–Fri 9 AM–5 PM<br>Closed weekends & holidays</span>
          </div>
        </div>
        <a class="lo-map-btn"
           href="https://map.naver.com/p/search/경기도+평택시+경기대로+1407"
           target="_blank" rel="noopener">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="wl-ko">네이버맵으로 보기</span><span class="wl-en">Open in Naver Map</span>
        </a>
      </div>

      <!-- 오른쪽: 지도 -->
      <div class="lo-card-map">
        <iframe
          src="https://maps.google.com/maps?q=경기도+평택시+경기대로+1407&hl=ko&z=17&output=embed"
          allowfullscreen loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>

    </div>
  </div>
</div>

<!-- JEJU PANEL -->
<div class="lo-panel" id="panel-jeju">
  <div class="lo-panel-inner">
    <div class="lo-card">

      <!-- 왼쪽: 정보 -->
      <div class="lo-card-info">
        <div class="lo-card-label"><span class="wl-ko">주소 및 연락처</span><span class="wl-en">Address & Contact</span></div>
        <div class="lo-info-row">
          <div class="lo-info-dt"><span class="wl-ko">주소</span><span class="wl-en">Address</span></div>
          <div class="lo-info-dd">
            <span class="wl-ko">제주시 애월읍 광상로 622</span>
            <span class="wl-en">622 Gwangsang-ro, Aewol-eup<br>Jeju-si, Jeju</span>
          </div>
        </div>
        <div class="lo-info-row">
          <div class="lo-info-dt"><span class="wl-ko">전화</span><span class="wl-en">Phone</span></div>
          <div class="lo-info-dd"><a href="tel:064-799-3707">064-799-3707</a></div>
        </div>
        <div class="lo-info-row">
          <div class="lo-info-dt">Email</div>
          <div class="lo-info-dd"><a href="mailto:wolkorea@gmail.com">wolkorea@gmail.com</a></div>
        </div>
        <div class="lo-info-row">
          <div class="lo-info-dt"><span class="wl-ko">운영 시간</span><span class="wl-en">Hours</span></div>
          <div class="lo-info-dd">
            <span class="wl-ko">화–금 09:00–17:00<br>주말 및 공휴일 휴무</span>
            <span class="wl-en">Tue–Fri 9 AM–5 PM<br>Closed weekends & holidays</span>
          </div>
        </div>
        <a class="lo-map-btn"
           href="https://map.naver.com/p/search/제주시+애월읍+광상로+622"
           target="_blank" rel="noopener">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          <span class="wl-ko">네이버맵으로 보기</span><span class="wl-en">Open in Naver Map</span>
        </a>
      </div>

      <!-- 오른쪽: 지도 -->
      <div class="lo-card-map">
        <iframe
          src="https://maps.google.com/maps?q=제주특별자치도+제주시+애월읍+광상로+622&hl=ko&z=16&output=embed"
          allowfullscreen loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
      </div>

    </div>
  </div>
</div>

</div><!-- end lang-root -->

<script is:inline>
function showPanel(id, btn) {
  document.querySelectorAll('.lo-panel').forEach(p => p.classList.remove('active'));
  document.querySelectorAll('.lo-tab').forEach(t => t.classList.remove('active'));
  document.getElementById('panel-' + id).classList.add('active');
  btn.classList.add('active');
}
</script>

</BaseLayout>
