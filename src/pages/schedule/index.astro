---
// 스태프 캘린더 — 비공개 구글 캘린더(서비스 계정에만 "일정 변경" 권한으로 공유)를
// 서버에서 읽고 쓰며, 차량 스케줄 페이지와 같은 스타일의 자체 월간 캘린더로 보여준다.
// 조회는 허브에 로그인한 누구나(상담사 포함), 등록/수정/삭제는 admin/master만
// 가능 — 서버(events.js)가 role을 재검증한다. 이 페이지 자체는 비밀번호를
// 따로 받지 않고 허브 세션 토큰(sessionStorage)을 그대로 쓴다.
// No BaseLayout; standalone page (다른 허브 도구와 동일한 패턴)
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>스태프 캘린더 — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolko-rail.css?v=3">
  <script src="/wolko-rail.js?v=3" defer></script>
  <meta name="theme-color" content="#004f68">
  <style is:global>
    :root {
      --blue:#004f68; --blue-lt:#0077a3; --text:#1a2d38; --mid:#5a7585; --light:#8fa8b5;
      --border:#e4eaee; --bg:#f4f6f8; --card:#fff; --red:#c42a36;
      --sans:'Montserrat',sans-serif; --body:'Noto Sans KR',sans-serif;
    }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); font-family:var(--body); color:var(--text); }
    .hidden { display:none !important; }

    .sc-header {
      display:flex; align-items:center; justify-content:space-between; gap:12px;
      padding:14px 22px; background:#fff; border-bottom:1px solid var(--border);
      position:sticky; top:0; z-index:5;
    }
    .sc-logo { display:flex; align-items:center; gap:10px; text-decoration:none; color:var(--blue); }
    .sc-logo img { width:30px; height:30px; object-fit:contain; }
    .sc-logo span { font:800 15px/1 var(--sans); letter-spacing:.02em; }
    .sc-btn {
      display:inline-flex; align-items:center; gap:6px; height:34px; padding:0 14px;
      border:1.5px solid var(--border); border-radius:999px; background:#fff; color:var(--blue);
      font:800 12px/1 var(--sans); text-decoration:none; cursor:pointer;
    }
    .sc-btn:hover { border-color:var(--blue); background:#f4fbfd; }

    .sc-wrap { max-width:1320px; margin:0 auto; padding:22px; }
    .sc-title-row { margin-bottom:14px; }
    .sc-title { margin:0; font:800 22px/1.25 var(--sans); color:var(--blue); }
    .sc-subtitle { margin:4px 0 0; color:var(--mid); font-size:13px; line-height:1.55; }

    /* ── 안내 화면(로그인 필요 / 설정 필요 / 에러) ── */
    .sc-notice-card {
      border:1.5px dashed var(--border); border-radius:16px; background:#fff;
      padding:48px 24px; text-align:center; color:var(--mid); font-size:13.5px; line-height:1.6;
    }
    .sc-notice-card .sc-btn { margin-top:14px; display:inline-flex; }

    /* ── 캘린더(구글 캘린더 월간 뷰 스타일 — 여러 날짜에 걸친 일정은 막대로, 시간 지정 일정은 한 줄로) ── */
    .cal-flanking-row { display:flex; align-items:flex-start; gap:16px; margin-bottom:16px; }
    .sc-calendar { flex:1; min-width:0; margin-bottom:0; border-radius:16px; border:1px solid var(--border); background:var(--card); overflow:hidden; }

    /* ── 이전/다음 달 미리보기(넓은 화면에서만, 캘린더 양옆) ── */
    .cal-mini {
      display:none; flex-direction:column; flex:0 0 220px; width:220px; padding:12px;
      border-radius:14px; border:1px solid var(--border); background:#fafcfd;
    }
    .cal-mini-header {
      margin:0 0 8px; padding:4px 6px; border:none; background:none; border-radius:6px;
      font:800 11.5px/1 var(--body); color:var(--mid); text-align:center; cursor:pointer;
    }
    .cal-mini-header:hover { background:var(--bg); color:var(--blue); }
    .cal-mini-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:2px; }
    .cal-mini-cell {
      aspect-ratio:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:1px;
      border:none; border-radius:6px; background:transparent; color:var(--mid); font:600 9.5px/1 var(--body); cursor:pointer;
    }
    .cal-mini-cell:hover:not(:disabled) { background:var(--bg); }
    .cal-mini-cell:disabled { cursor:default; }
    .cal-mini-cell.is-outside { visibility:hidden; }
    .cal-mini-cell.is-today { background:var(--blue); color:#fff; font-weight:800; }
    .cal-mini-dot { width:3px; height:3px; border-radius:50%; background:var(--blue); }
    .cal-mini-cell.is-today .cal-mini-dot { background:#fff; }
    @media (min-width:1500px) {
      .sc-wrap { max-width:1680px; }
      .cal-mini { display:flex; }
    }
    .cal-header { display:flex; align-items:center; gap:8px; padding:14px 14px 10px; }
    .cal-nav-btn {
      flex-shrink:0; width:28px; height:28px; display:inline-flex; align-items:center; justify-content:center;
      border-radius:50%; border:1px solid var(--border); background:#fff; color:var(--mid); font-size:16px; line-height:1; cursor:pointer;
    }
    .cal-nav-btn:hover { border-color:var(--blue); color:var(--blue); }
    .cal-month-label {
      flex:1; text-align:center; font:800 15px/1 var(--body); color:var(--text);
      background:none; border:none; padding:4px 8px; border-radius:8px; cursor:pointer;
    }
    .cal-month-label:hover { background:var(--bg); }
    .cal-month-picker { display:flex; align-items:center; justify-content:center; gap:8px; padding:0 14px 12px; }
    .cal-month-picker select, .cal-month-picker input[type="number"] {
      padding:6px 8px; border-radius:8px; border:1px solid var(--border); font:600 12.5px/1 var(--body);
      color:var(--text); background:#fff; outline:none;
    }
    .cal-month-picker input[type="number"] { width:72px; }
    .cal-today-btn {
      flex-shrink:0; padding:5px 10px; border-radius:999px; border:1px solid var(--border); background:#fff;
      color:var(--mid); font:700 11px/1 var(--body); cursor:pointer;
    }
    .cal-today-btn:hover { border-color:var(--blue); color:var(--blue); }
    .cal-weekdays { display:grid; grid-template-columns:repeat(7,1fr); border-top:1px solid var(--border); }
    .cal-weekdays span { text-align:center; font:700 10.5px/1 var(--body); color:var(--light); padding:8px 0; }
    .cal-week { display:grid; grid-template-columns:repeat(7,1fr); border-top:1px solid var(--border); }
    .cal-daynum-cell {
      grid-row:1 / -1; display:flex; justify-content:flex-end; align-items:flex-start; border:none; border-right:1px solid var(--border);
      background:transparent; padding:7px 8px 4px; cursor:pointer; font-family:var(--body); min-height:150px;
    }
    .cal-daynum-cell:nth-child(7n) { border-right:none; }
    .cal-daynum-cell:hover { background:var(--bg); }
    .cal-daynum-cell.is-outside .cal-daynum { color:var(--border); }
    .cal-daynum-cell.is-selected { background:#eef4f6; }
    .cal-daynum { font:700 12px/1 var(--body); color:var(--text); }
    .cal-daynum-cell.is-today .cal-daynum {
      display:inline-flex; align-items:center; justify-content:center; width:19px; height:19px; border-radius:50%;
      background:var(--blue); color:#fff;
    }

    .cal-bar {
      margin:2px 2px; padding:2.5px 6px; border-radius:4px; background:var(--blue); color:#fff;
      font:700 10.5px/1.5 var(--body); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; cursor:pointer;
    }
    .cal-timed {
      margin:2px 2px; padding:2.5px 6px; border-radius:4px; display:flex; align-items:center; gap:4px;
      font:600 10.5px/1.5 var(--body); color:var(--text); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; cursor:pointer;
    }
    .cal-timed:hover, .cal-bar:hover { filter:brightness(0.95); }
    .cal-timed-dot { width:6px; height:6px; border-radius:50%; flex-shrink:0; background:var(--blue); }
    .cal-timed-time { flex-shrink:0; color:var(--mid); font-weight:700; }
    .cal-more-cell {
      margin:1px 3px; padding:1.5px 6px; border:none; background:transparent; color:var(--mid);
      font:700 10px/1.6 var(--body); text-align:left; cursor:pointer;
    }
    .cal-more-cell:hover { color:var(--blue); text-decoration:underline; }

    /* ── 색상 팔레트(구글 캘린더 색상 11종 + 기본) ── */
    .sc-color-picker { display:flex; flex-wrap:wrap; gap:8px; }
    .sc-color-swatch {
      width:24px; height:24px; border-radius:50%; border:2px solid transparent; cursor:pointer; padding:0;
      display:inline-flex; align-items:center; justify-content:center; color:#fff;
    }
    .sc-color-swatch.is-selected { border-color:var(--text); box-shadow:0 0 0 2px #fff inset; }
    .sc-color-swatch.is-default { background:var(--bg); border:1.5px solid var(--border); }
    .sc-color-swatch.is-default.is-selected { border-color:var(--text); }

    .sc-selected-date-bar {
      display:flex; align-items:center; justify-content:space-between; padding:10px 14px; margin-bottom:12px;
      border-radius:10px; background:#eef4f6;
    }
    .sc-selected-date-bar span { font:800 12.5px/1 var(--body); color:var(--blue); }
    .sc-selected-date-bar button {
      flex-shrink:0; padding:5px 10px; border-radius:999px; border:none; background:#fff; color:var(--mid);
      font:700 11px/1 var(--body); cursor:pointer;
    }
    .sc-selected-date-bar button:hover { color:var(--blue); }

    .sc-empty { padding:60px 20px; text-align:center; color:var(--light); font-size:13px; line-height:1.7; }
    .sc-empty svg { display:block; margin:0 auto 10px; opacity:.5; }

    .sc-card {
      position:relative; display:flex; gap:10px; padding:14px 14px 14px 18px; margin-bottom:8px; border-radius:14px;
      border:1px solid var(--border); background:var(--card); box-shadow:0 1px 3px rgba(16,42,56,.04);
    }
    .sc-card::before { content:''; position:absolute; left:0; top:12px; bottom:12px; width:4px; border-radius:3px; background:var(--card-color, var(--blue)); }
    .sc-card-body { flex:1; min-width:0; }
    .sc-card-title { margin:0; font:700 13.5px/1.45 var(--body); color:var(--text); }
    .sc-card-time { display:inline-block; margin-right:7px; font:700 10.5px/1 var(--body); color:var(--mid); white-space:nowrap; }
    .sc-card-desc { margin:5px 0 0; font-size:11.5px; color:var(--mid); line-height:1.6; white-space:pre-wrap; }
    .sc-card-location { margin:5px 0 0; font-size:11.5px; color:var(--light); }
    .sc-card-actions { display:flex; flex-direction:column; gap:6px; flex-shrink:0; }
    .sc-card-btn {
      display:inline-flex; align-items:center; justify-content:center; width:26px; height:26px; border-radius:50%;
      border:1px solid var(--border); background:#fff; color:var(--mid); cursor:pointer; transition:all .12s;
    }
    .sc-card-btn:hover { border-color:var(--blue); color:var(--blue); background:#f2f8fb; }
    .sc-card-btn.danger:hover { border-color:var(--red); color:#fff; background:var(--red); }

    .sc-loading { text-align:center; padding:40px 0; color:var(--light); font-size:12.5px; }

    /* ── FAB(새 일정 등록) ── */
    .sc-fab {
      position:fixed; right:20px; bottom:24px; z-index:25; display:inline-flex; align-items:center; gap:8px;
      padding:14px 20px; border-radius:999px; border:none; background:var(--blue); color:#fff;
      font:800 13.5px/1 var(--body); cursor:pointer; box-shadow:0 10px 26px rgba(0,79,104,.35); transition:transform .12s;
    }
    .sc-fab:hover { transform:translateY(-1px); }
    .sc-fab:active { transform:scale(.97); }

    /* ── 등록/수정 모달 ── */
    .sc-modal-overlay {
      position:fixed; inset:0; z-index:40; display:flex; align-items:flex-end; justify-content:center;
      background:rgba(10,24,32,.5);
    }
    .sc-modal { width:100%; max-width:480px; max-height:92vh; overflow-y:auto; background:#fff; border-radius:20px 20px 0 0; padding:20px 20px calc(20px + env(safe-area-inset-bottom, 0px)); }
    @media (min-width:640px) {
      .sc-modal-overlay { align-items:center; padding:24px; }
      .sc-modal { border-radius:20px; max-height:88vh; }
    }
    .sc-modal-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
    .sc-modal-title { margin:0; font:800 16px/1.3 var(--body); color:var(--text); }
    .sc-modal-close {
      display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:50%;
      border:none; background:var(--bg); color:var(--mid); cursor:pointer;
    }
    .sc-field { margin-bottom:13px; }
    .sc-field label { display:block; margin-bottom:5px; font:700 12px/1 var(--body); color:var(--mid); }
    .sc-field input, .sc-field textarea {
      width:100%; padding:10px 12px; border-radius:10px; border:1.5px solid var(--border); background:var(--bg);
      color:var(--text); font:500 14px/1.4 var(--body); outline:none; transition:border-color .15s, background .15s;
    }
    .sc-field input:focus, .sc-field textarea:focus { border-color:var(--blue); background:#fff; }
    .sc-field textarea { resize:vertical; min-height:60px; }
    .sc-field-row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .sc-field-check { display:flex; align-items:center; gap:8px; }
    .sc-field-check input { width:auto; }
    .sc-field-check label { margin:0; }
    .sc-modal-error {
      margin:0 0 12px; padding:10px 12px; border-radius:10px; background:#fdecec; color:var(--red);
      font:700 12.5px/1.5 var(--body); display:none;
    }
    .sc-modal-error.is-visible { display:block; }
    .sc-modal-foot { display:flex; gap:8px; margin-top:18px; }
    .sc-modal-btn { flex:1; padding:12px; border-radius:12px; border:none; font:800 14px/1 var(--body); cursor:pointer; transition:opacity .15s, transform .1s; }
    .sc-modal-btn:active { transform:scale(.98); }
    .sc-modal-btn-primary { background:var(--blue); color:#fff; }
    .sc-modal-btn-primary:hover { background:var(--blue-lt); }
    .sc-modal-btn-secondary { background:var(--bg); color:var(--mid); flex:0 0 auto; padding:12px 18px; }
    .sc-modal-btn-secondary:hover { background:var(--border); }

    /* ── 모바일 ── */
    @media (max-width:680px) {
      .sc-header { padding:11px 14px; }
      .sc-logo span { font-size:13px; }
      .sc-wrap { padding:14px 10px; }
      .sc-title { font-size:19px; }
      .sc-subtitle { font-size:12px; }

      .cal-header { padding:11px 8px 8px; gap:4px; }
      .cal-nav-btn { width:26px; height:26px; font-size:15px; }
      .cal-month-label { font-size:13px; padding:4px 4px; }
      .cal-today-btn { padding:5px 8px; font-size:10px; }
      .cal-month-picker { padding:0 8px 10px; gap:6px; flex-wrap:wrap; }
      .cal-month-picker select, .cal-month-picker input[type="number"] { font-size:11.5px; padding:5px 6px; }
      .cal-month-picker input[type="number"] { width:62px; }

      .cal-weekdays span { font-size:9px; padding:5px 0; }
      .cal-daynum-cell { min-height:92px; padding:4px 5px 2px; }
      .cal-daynum { font-size:10.5px; }
      .cal-daynum-cell.is-today .cal-daynum { width:17px; height:17px; }

      .cal-bar, .cal-timed { margin:1px; padding:2px 4px; font-size:8.5px; border-radius:3px; gap:3px; }
      .cal-timed-dot { width:5px; height:5px; }
      .cal-more-cell { margin:1px; padding:2px 4px; font-size:8.5px; }

      .sc-fab { right:14px; bottom:16px; padding:12px 16px; font-size:12.5px; }
      .sc-fab svg { width:13px; height:13px; }

      .sc-field-row { grid-template-columns:1fr; gap:0; }
      .sc-modal { padding:16px 16px calc(16px + env(safe-area-inset-bottom, 0px)); }

      .sc-card { padding:12px 12px 12px 15px; }
      .sc-card-title { font-size:13px; }
    }
  </style>
</head>
<body>
  <header class="sc-header">
    <a class="sc-logo" href="/hub" title="WOLKO 허브로 돌아가기">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <span data-t="pageTitle">스태프 캘린더</span>
    </a>
    <button class="sc-btn" onclick="toggleScLang()"><span id="scLangLabel">EN</span></button>
  </header>

  <div class="sc-wrap">
    <div class="sc-title-row">
      <p class="sc-title" data-t="pageTitle">스태프 캘린더</p>
      <p class="sc-subtitle" data-t="subtitle">WOLKO 스태프 일정 공유 캘린더입니다.</p>
    </div>

    <!-- 허브 로그인 필요 안내 -->
    <div class="sc-notice-card hidden" id="loginNotice">
      <p data-t="loginRequiredDesc">이 페이지를 보려면 먼저 허브에 로그인해 주세요.</p>
      <a class="sc-btn" href="/hub" data-t="goToHubBtn">허브로 이동</a>
    </div>

    <!-- 로드 실패 안내 -->
    <div class="sc-notice-card hidden" id="errorNotice">
      <p id="errorNoticeText"></p>
    </div>

    <!-- 캘린더 본체 -->
    <div id="calendarBody" class="hidden">
      <div class="cal-flanking-row">
        <div class="cal-mini" id="miniPrev"></div>
        <div class="sc-calendar">
          <div class="cal-header">
            <button type="button" class="cal-nav-btn" onclick="shiftMonth(-1)" aria-label="prev">‹</button>
            <button type="button" class="cal-month-label" id="calMonthLabel" onclick="toggleMonthPicker()"></button>
            <button type="button" class="cal-nav-btn" onclick="shiftMonth(1)" aria-label="next">›</button>
            <button type="button" class="cal-today-btn" onclick="goToCurrentMonth()" data-t="today">오늘</button>
          </div>
          <div class="cal-month-picker hidden" id="monthPicker">
            <select id="pickerMonth" aria-label="month"></select>
            <input type="number" id="pickerYear" aria-label="year" min="2000" max="2100">
            <button type="button" class="sc-btn" onclick="jumpToPickedMonth()" data-t="jumpBtn">이동</button>
          </div>
          <div id="calGrid"></div>
        </div>
        <div class="cal-mini" id="miniNext"></div>
      </div>

      <div class="sc-selected-date-bar hidden" id="selectedDateBar">
        <span id="selectedDateLabel"></span>
        <button type="button" onclick="clearSelectedDate()" data-t="clearDate">닫기</button>
      </div>

      <div id="loadingIndicator" class="sc-loading hidden" data-t="loading">불러오는 중…</div>
      <div id="agendaContainer"></div>
    </div>
  </div>

  <button class="sc-fab hidden" id="fabBtn" onclick="openCreateModal()">
    <svg width="15" height="15" viewBox="0 0 15 15" fill="none"><path d="M7.5 1v13M1 7.5h13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    <span data-t="newEvent">새 일정</span>
  </button>

  <!-- ── 등록/수정 모달 ── -->
  <div class="sc-modal-overlay hidden" id="modalOverlay">
    <div class="sc-modal">
      <div class="sc-modal-head">
        <p class="sc-modal-title" id="modalTitle" data-t="newEventTitle">새 일정</p>
        <button class="sc-modal-close" onclick="closeModal()" aria-label="close">
          <svg width="14" height="14" viewBox="0 0 15 15" fill="none"><path d="M1.5 1.5l12 12M13.5 1.5l-12 12" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </button>
      </div>
      <p class="sc-modal-error" id="modalError"></p>

      <div class="sc-field">
        <label data-t="fieldSummary">제목</label>
        <input type="text" id="fSummary" maxlength="200">
      </div>
      <div class="sc-field sc-field-check">
        <input type="checkbox" id="fAllDay" onchange="onAllDayToggle()">
        <label for="fAllDay" data-t="fieldAllDay">종일</label>
      </div>
      <div class="sc-field-row">
        <div class="sc-field">
          <label data-t="fieldStartDate">시작일</label>
          <input type="date" id="fStartDate">
        </div>
        <div class="sc-field" id="fStartTimeWrap">
          <label data-t="fieldStartTime">시작 시간</label>
          <input type="time" id="fStartTime" value="09:00">
        </div>
      </div>
      <div class="sc-field-row">
        <div class="sc-field">
          <label data-t="fieldEndDate">종료일</label>
          <input type="date" id="fEndDate">
        </div>
        <div class="sc-field" id="fEndTimeWrap">
          <label data-t="fieldEndTime">종료 시간</label>
          <input type="time" id="fEndTime" value="10:00">
        </div>
      </div>
      <div class="sc-field">
        <label data-t="fieldLocation">위치 (선택)</label>
        <input type="text" id="fLocation" maxlength="200">
      </div>
      <div class="sc-field">
        <label data-t="fieldDescription">설명 (선택)</label>
        <textarea id="fDescription" maxlength="2000"></textarea>
      </div>
      <div class="sc-field">
        <label data-t="fieldColor">색상</label>
        <div class="sc-color-picker" id="colorPicker"></div>
      </div>

      <div class="sc-modal-foot">
        <button class="sc-modal-btn sc-modal-btn-secondary" onclick="closeModal()" data-t="cancelBtn">취소</button>
        <button class="sc-modal-btn sc-modal-btn-primary" id="saveBtn" onclick="submitEventForm()" data-t="saveBtn">저장</button>
      </div>
    </div>
  </div>

  <script is:inline>
    const SC_T = {
      ko: {
        pageTitle: '스태프 캘린더',
        subtitle: 'WOLKO 스태프 일정 공유 캘린더입니다.',
        loginRequiredDesc: '이 페이지를 보려면 먼저 허브에 로그인해 주세요.',
        goToHubBtn: '허브로 이동',
        today: '오늘',
        jumpBtn: '이동',
        clearDate: '닫기',
        loading: '불러오는 중…',
        allDay: '종일',
        selectDayHint: '날짜를 클릭하면 그날의 일정이 여기에 표시됩니다.',
        emptyDay: '이 날짜에는 일정이 없습니다.',
        loadError: '캘린더를 불러오지 못했습니다.',
        setupNotice: '아직 캘린더가 연결되지 않았습니다. 관리자에게 문의해 주세요.',
        newEvent: '새 일정',
        newEventTitle: '새 일정',
        editEventTitle: '일정 수정',
        fieldSummary: '제목',
        fieldAllDay: '종일',
        fieldStartDate: '시작일',
        fieldStartTime: '시작 시간',
        fieldEndDate: '종료일',
        fieldEndTime: '종료 시간',
        fieldLocation: '위치 (선택)',
        fieldDescription: '설명 (선택)',
        fieldColor: '색상',
        cancelBtn: '취소',
        saveBtn: '저장',
        saving: '저장 중…',
        summaryRequired: '제목을 입력해 주세요.',
        dateRequired: '날짜를 입력해 주세요.',
        saveFailed: '저장하지 못했습니다.',
        deleteConfirm: '이 일정을 삭제하시겠습니까?',
        deleteFailed: '삭제하지 못했습니다.',
      },
      en: {
        pageTitle: 'Staff Calendar',
        subtitle: 'WOLKO staff shared calendar.',
        loginRequiredDesc: 'Please log in to the hub first to view this page.',
        goToHubBtn: 'Go to Hub',
        today: 'Today',
        jumpBtn: 'Go',
        clearDate: 'Close',
        loading: 'Loading…',
        allDay: 'All day',
        selectDayHint: 'Click a date to see that day\'s schedule here.',
        emptyDay: 'No events on this date.',
        loadError: 'Could not load the calendar.',
        setupNotice: 'No calendar has been connected yet. Please contact an admin.',
        newEvent: 'New Event',
        newEventTitle: 'New Event',
        editEventTitle: 'Edit Event',
        fieldSummary: 'Title',
        fieldAllDay: 'All day',
        fieldStartDate: 'Start date',
        fieldStartTime: 'Start time',
        fieldEndDate: 'End date',
        fieldEndTime: 'End time',
        fieldLocation: 'Location (optional)',
        fieldDescription: 'Description (optional)',
        fieldColor: 'Color',
        cancelBtn: 'Cancel',
        saveBtn: 'Save',
        saving: 'Saving…',
        summaryRequired: 'Please enter a title.',
        dateRequired: 'Please enter a date.',
        saveFailed: 'Could not save.',
        deleteConfirm: 'Delete this event?',
        deleteFailed: 'Could not delete.',
      },
    };
    // 구글 캘린더 공식 이벤트 색상 11종(colorId 1~11) — 구글에서 지정한 색을 그대로 반영해 보여주고,
    // 여기서 새로 만들 때도 같은 팔레트로 고를 수 있게 한다.
    const EVENT_COLORS = {
      '1': '#7986cb', '2': '#33b679', '3': '#8e24aa', '4': '#e67c73', '5': '#f6bf26',
      '6': '#f4511e', '7': '#039be5', '8': '#616161', '9': '#3f51b5', '10': '#0b8043', '11': '#d50000',
    };
    function eventColor(ev) {
      return (ev.colorId && EVENT_COLORS[ev.colorId]) || 'var(--blue)';
    }
    let scLang = localStorage.getItem('wolko-lang') || 'ko';
    const $ = id => document.getElementById(id);
    function t(key) { return SC_T[scLang]?.[key] ?? SC_T.ko[key] ?? key; }
    function esc(s) { return String(s ?? '').replace(/[&<>"']/g, c => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c])); }

    function applyScLang() {
      document.documentElement.lang = scLang === 'en' ? 'en' : 'ko';
      document.title = (scLang === 'en' ? 'Staff Calendar' : '스태프 캘린더') + ' — WOLKO';
      document.querySelectorAll('[data-t]').forEach(el => { el.textContent = t(el.getAttribute('data-t')); });
      const label = $('scLangLabel');
      if (label) label.textContent = scLang === 'ko' ? 'EN' : '한';
      populateMonthPicker();
      if (!$('calendarBody').classList.contains('hidden')) { renderCalendar(); renderAgenda(); }
    }
    function toggleScLang() {
      scLang = scLang === 'ko' ? 'en' : 'ko';
      localStorage.setItem('wolko-lang', scLang);
      applyScLang();
    }

    /* ── 허브 세션 토큰 검증(hub.astro의 isHubTokenValid와 동일한 형식) ── */
    function isHubTokenValid(token) {
      return !!parseHubToken(token);
    }
    /** 서명 검증은 서버가 다시 하므로(모든 쓰기 요청에서), 여기선 형식/만료만 보고 role을 꺼내 쓴다. */
    function parseHubToken(token) {
      try {
        const decoded = atob(token);
        const lastColon = decoded.lastIndexOf(':');
        const data = decoded.slice(0, lastColon);
        const parts = data.split(':');
        if (parts[0] !== 'wolko-hub' || parts.length !== 4) return null;
        const expires = parseInt(parts[3], 10);
        if (!expires || Date.now() >= expires) return null;
        return { email: parts[1], role: parts[2], expires };
      } catch (e) {
        return null;
      }
    }

    /* ── 날짜 유틸 ── */
    function toDateStr(d) {
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }
    function todayStr() { return toDateStr(new Date()); }
    function eventDateRange(ev) {
      if (ev.allDay) {
        const endD = new Date(`${ev.end}T00:00:00`);
        endD.setDate(endD.getDate() - 1); // 구글 all-day 종료일은 배타적(exclusive)
        return { startDate: ev.start, endDate: toDateStr(endD) };
      }
      return { startDate: ev.start.slice(0, 10), endDate: ev.end.slice(0, 10) };
    }
    function formatTimeRange(ev) {
      if (ev.allDay) return t('allDay');
      const startD = new Date(ev.start), endD = new Date(ev.end);
      const fmt = d => d.toLocaleTimeString(scLang === 'en' ? 'en-US' : 'ko-KR', { hour: '2-digit', minute: '2-digit' });
      return `${fmt(startD)} – ${fmt(endD)}`;
    }
    function dateHeaderLabel(dateStr) {
      const d = new Date(`${dateStr}T00:00:00`);
      const isToday = dateStr === todayStr();
      const wkKo = ['일', '월', '화', '수', '목', '금', '토'];
      const wkEn = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      const wk = scLang === 'en' ? wkEn : wkKo;
      const main = scLang === 'en'
        ? d.toLocaleString('en-US', { month: 'short', day: 'numeric' })
        : `${d.getMonth() + 1}월 ${d.getDate()}일`;
      return { main, sub: wk[d.getDay()], isToday };
    }

    /* ── 상태 ── */
    let calendarMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
    let selectedDate = todayStr(); // 기본으로 오늘 날짜가 선택된 채로 시작 — 아래 상세 목록이 바로 채워지도록
    let events = []; // 현재 로드된(표시 중인 월 기준) 이벤트 목록
    let loadToken = 0;
    let canWrite = false; // admin/master만 등록/수정/삭제 가능(서버가 다시 검증)
    let editingId = null; // 모달이 수정 모드일 때 대상 이벤트 id, 등록 모드면 null
    let selectedColorId = null; // null이면 캘린더 기본색(파랑)

    async function loadEvents() {
      const myToken = ++loadToken;
      // 요청이 끝나기 전에도 그리드/아젠다는 즉시(현재 갖고 있는 events로) 그려서
      // 로딩 중이거나 실패했을 때 화면이 비어 보이지 않게 한다.
      renderCalendar();
      renderAgenda();
      // 이전/다음 달 미리보기 미니 캘린더에도 쓸 수 있게 앞뒤로 한 달씩 넉넉히 가져온다.
      const rangeStart = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() - 1, 1);
      const rangeEnd = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() + 2, 0);
      $('loadingIndicator').classList.remove('hidden');
      $('errorNotice').classList.add('hidden');
      try {
        const hubToken = sessionStorage.getItem('wolko-hub-token') || '';
        const res = await fetch(`/api/schedule/events?start=${toDateStr(rangeStart)}&end=${toDateStr(rangeEnd)}`, {
          headers: { Authorization: 'Bearer ' + hubToken },
        });
        const data = await res.json();
        if (myToken !== loadToken) return; // 더 최근 요청이 있으면 이 결과는 버림
        if (!res.ok) throw new Error(data.error || t('loadError'));
        events = data.events || [];
        renderCalendar();
        renderAgenda();
      } catch (e) {
        if (myToken !== loadToken) return;
        $('errorNoticeText').textContent = e.message || t('loadError');
        $('errorNotice').classList.remove('hidden');
      } finally {
        if (myToken === loadToken) $('loadingIndicator').classList.add('hidden');
      }
    }

    // 좁은 화면에서는 한 주에 3줄씩 욱여넣으면 너무 빽빽해져서 2줄로 줄인다 —
    // 넘치는 건 어차피 "+N"으로 묶이고 탭하면 아래 상세 패널에서 다 보이므로 정보 손실은 없다.
    function maxLanesForViewport() { return window.innerWidth <= 680 ? 2 : 3; }

    /** 한 주에 표시할 항목(막대/시간지정 한 줄)을 겹치지 않게 줄(lane)에 배치. 못 들어가면 overflow로 뺀다. */
    function layoutWeekItems(items, maxLanes) {
      const sorted = [...items].sort((a, b) => {
        if (a.type !== b.type) return a.type === 'bar' ? -1 : 1; // 여러 날짜짜리 막대를 먼저 배치
        if (a.startCol !== b.startCol) return a.startCol - b.startCol;
        return (b.endCol - b.startCol) - (a.endCol - a.startCol);
      });
      const laneOccupancy = [];
      const placed = [];
      const overflowItems = [];
      sorted.forEach(item => {
        let laneIdx = -1;
        for (let l = 0; l < maxLanes; l++) {
          const occ = laneOccupancy[l] || [];
          const collide = occ.some(([s, e]) => !(item.endCol < s || item.startCol > e));
          if (!collide) { laneIdx = l; break; }
        }
        if (laneIdx === -1) {
          overflowItems.push(item);
        } else {
          laneOccupancy[laneIdx] = laneOccupancy[laneIdx] || [];
          laneOccupancy[laneIdx].push([item.startCol, item.endCol]);
          placed.push({ ...item, lane: laneIdx });
        }
      });
      const overflowByCol = {};
      overflowItems.forEach(item => {
        for (let c = item.startCol; c <= item.endCol; c++) overflowByCol[c] = (overflowByCol[c] || 0) + 1;
      });
      return { placed, overflowByCol };
    }

    function formatEventStartTime(ev) {
      return new Date(ev.start).toLocaleTimeString(scLang === 'en' ? 'en-US' : 'ko-KR', { hour: '2-digit', minute: '2-digit' });
    }

    function renderCalendar() {
      const year = calendarMonth.getFullYear();
      const month = calendarMonth.getMonth();
      const firstOfMonth = new Date(year, month, 1);
      const startOffset = firstOfMonth.getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const totalCells = Math.ceil((startOffset + daysInMonth) / 7) * 7;
      const totalWeeks = totalCells / 7;
      const maxLanes = maxLanesForViewport();
      const todayStr_ = todayStr();
      const wkKo = ['일', '월', '화', '수', '목', '금', '토'];
      const wkEn = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
      const wk = scLang === 'en' ? wkEn : wkKo;

      $('calMonthLabel').textContent = scLang === 'en'
        ? calendarMonth.toLocaleString('en-US', { month: 'long', year: 'numeric' })
        : `${year}년 ${month + 1}월`;

      let weeksHtml = '';
      for (let w = 0; w < totalWeeks; w++) {
        const weekDates = [];
        for (let d = 0; d < 7; d++) weekDates.push(new Date(year, month, w * 7 - startOffset + 1 + d));
        const weekDateStrs = weekDates.map(toDateStr);
        const weekStartStr = weekDateStrs[0];
        const weekEndStr = weekDateStrs[6];

        const items = [];
        events.forEach(ev => {
          const r = eventDateRange(ev);
          if (r.endDate < weekStartStr || r.startDate > weekEndStr) return;
          const clippedStart = r.startDate < weekStartStr ? weekStartStr : r.startDate;
          const clippedEnd = r.endDate > weekEndStr ? weekEndStr : r.endDate;
          const startCol = weekDateStrs.indexOf(clippedStart);
          const endCol = weekDateStrs.indexOf(clippedEnd);
          if (startCol === -1 || endCol === -1) return;
          items.push({ startCol, endCol, type: ev.allDay ? 'bar' : 'timed', ev });
        });
        const { placed, overflowByCol } = layoutWeekItems(items, maxLanes);

        let dayCellsHtml = '';
        weekDates.forEach((d, col) => {
          const cellStr = weekDateStrs[col];
          const inMonth = d.getMonth() === month;
          const isToday = cellStr === todayStr_;
          const isSelected = cellStr === selectedDate;
          dayCellsHtml += `
            <button type="button" class="cal-daynum-cell${inMonth ? '' : ' is-outside'}${isToday ? ' is-today' : ''}${isSelected ? ' is-selected' : ''}"
              style="grid-column:${col + 1}" onclick="selectDate('${cellStr}')">
              <span class="cal-daynum">${d.getDate()}</span>
            </button>`;
        });

        let itemsHtml = '';
        placed.forEach(item => {
          const row = item.lane + 2;
          const gridArea = `grid-column:${item.startCol + 1}/${item.endCol + 2};grid-row:${row}`;
          const title = esc(item.ev.summary || (scLang === 'en' ? '(No title)' : '(제목 없음)'));
          const color = eventColor(item.ev);
          if (item.type === 'bar') {
            itemsHtml += `<div class="cal-bar" style="${gridArea};background:${color}" onclick="selectDate('${weekDateStrs[item.startCol]}')" title="${title}">${title}</div>`;
          } else {
            itemsHtml += `<div class="cal-timed" style="${gridArea}" onclick="selectDate('${weekDateStrs[item.startCol]}')" title="${title}">
              <span class="cal-timed-dot" style="background:${color}"></span>
              <span class="cal-timed-time">${esc(formatEventStartTime(item.ev))}</span><span>${title}</span>
            </div>`;
          }
        });

        let moreHtml = '';
        Object.keys(overflowByCol).forEach(colStr => {
          const col = Number(colStr);
          const row = maxLanes + 2;
          moreHtml += `<button type="button" class="cal-more-cell" style="grid-column:${col + 1};grid-row:${row}" onclick="selectDate('${weekDateStrs[col]}')">+${overflowByCol[col]}</button>`;
        });

        weeksHtml += `<div class="cal-week" style="grid-template-rows:auto repeat(${maxLanes}, auto) auto">${dayCellsHtml}${itemsHtml}${moreHtml}</div>`;
      }

      $('calGrid').innerHTML = `
        <div class="cal-weekdays">${wk.map(w => `<span>${esc(w)}</span>`).join('')}</div>
        ${weeksHtml}`;

      // 넓은 화면(≥1500px)에서만 CSS로 보이는 이전/다음 달 미리보기 — 좁으면 그냥 빈 채로 둔다.
      renderMiniMonth($('miniPrev'), new Date(year, month - 1, 1));
      renderMiniMonth($('miniNext'), new Date(year, month + 1, 1));
    }

    /** 이전/다음 달 미리보기 미니 캘린더 — 점 하나로 "그날 뭔가 있다"만 표시, 클릭하면 그 달로 이동. */
    function renderMiniMonth(container, monthDate) {
      const year = monthDate.getFullYear();
      const month = monthDate.getMonth();
      const firstOfMonth = new Date(year, month, 1);
      const startOffset = firstOfMonth.getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const totalCells = Math.ceil((startOffset + daysInMonth) / 7) * 7;
      const todayStr_ = todayStr();

      let cellsHtml = '';
      for (let i = 0; i < totalCells; i++) {
        const cellDate = new Date(year, month, i - startOffset + 1);
        const cellStr = toDateStr(cellDate);
        const inMonth = cellDate.getMonth() === month;
        const isToday = cellStr === todayStr_;
        const hasItems = inMonth && events.some(ev => { const r = eventDateRange(ev); return cellStr >= r.startDate && cellStr <= r.endDate; });
        cellsHtml += `
          <button type="button" class="cal-mini-cell${inMonth ? '' : ' is-outside'}${isToday ? ' is-today' : ''}"
            ${inMonth ? `onclick="jumpMiniMonth(${year},${month},'${cellStr}')"` : 'disabled'}>
            ${cellDate.getDate()}${hasItems ? '<span class="cal-mini-dot"></span>' : ''}
          </button>`;
      }
      const monthLabel = scLang === 'en'
        ? monthDate.toLocaleString('en-US', { month: 'short', year: 'numeric' })
        : `${year}년 ${month + 1}월`;
      container.innerHTML = `
        <button type="button" class="cal-mini-header" onclick="jumpMiniMonth(${year},${month})">${esc(monthLabel)}</button>
        <div class="cal-mini-grid">${cellsHtml}</div>`;
    }
    function jumpMiniMonth(year, month, dateStr) {
      calendarMonth = new Date(year, month, 1);
      selectedDate = dateStr || null;
      $('monthPicker').classList.add('hidden');
      loadEvents();
    }

    /* 날짜를 선택했을 때만 그날 일정을 보여준다 — 그리드 자체가 이미 한눈에 보기용이라
       선택 전 기본 상태에서까지 "예정된 일정" 전체 목록을 쌓아두면 중복이고 산만해진다. */
    function renderAgenda() {
      const container = $('agendaContainer');

      if (!selectedDate) {
        $('selectedDateBar').classList.add('hidden');
        container.innerHTML = `
          <div class="sc-empty">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 11l3 3L22 4M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"/></svg>
            <div>${esc(t('selectDayHint'))}</div>
          </div>`;
        return;
      }

      $('selectedDateBar').classList.remove('hidden');
      const { main, sub } = dateHeaderLabel(selectedDate);
      $('selectedDateLabel').textContent = `${main} (${sub})`;

      const list = events
        .filter(ev => { const r = eventDateRange(ev); return selectedDate >= r.startDate && selectedDate <= r.endDate; })
        .sort((a, b) => Date.parse(a.start) - Date.parse(b.start));

      if (!list.length) {
        container.innerHTML = `
          <div class="sc-empty">
            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v3"/><path d="M3 12h18"/></svg>
            <div>${esc(t('emptyDay'))}</div>
          </div>`;
        return;
      }

      container.innerHTML = list.map(ev => `
        <div class="sc-card" style="--card-color:${eventColor(ev)}">
          <div class="sc-card-body">
            <p class="sc-card-title"><span class="sc-card-time">${esc(formatTimeRange(ev))}</span>${esc(ev.summary || (scLang === 'en' ? '(No title)' : '(제목 없음)'))}</p>
            ${ev.location ? `<p class="sc-card-location">📍 ${esc(ev.location)}</p>` : ''}
            ${ev.description ? `<p class="sc-card-desc">${esc(ev.description)}</p>` : ''}
          </div>
          ${canWrite ? `
          <div class="sc-card-actions">
            <button class="sc-card-btn" onclick="openEditModal('${esc(ev.id)}')" aria-label="edit">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
            </button>
            <button class="sc-card-btn danger" onclick="deleteEvent('${esc(ev.id)}')" aria-label="delete">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0-1 14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2L4 6"/></svg>
            </button>
          </div>` : ''}
        </div>`).join('');
    }

    function shiftMonth(delta) {
      calendarMonth = new Date(calendarMonth.getFullYear(), calendarMonth.getMonth() + delta, 1);
      selectedDate = null;
      $('monthPicker').classList.add('hidden');
      loadEvents();
    }
    function goToCurrentMonth() {
      calendarMonth = new Date(new Date().getFullYear(), new Date().getMonth(), 1);
      selectedDate = todayStr();
      $('monthPicker').classList.add('hidden');
      loadEvents();
    }

    /* ── 연/월 직접 이동 ── */
    function populateMonthPicker() {
      const monthNamesKo = ['1월', '2월', '3월', '4월', '5월', '6월', '7월', '8월', '9월', '10월', '11월', '12월'];
      const monthNamesEn = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
      const names = scLang === 'en' ? monthNamesEn : monthNamesKo;
      const select = $('pickerMonth');
      if (!select) return;
      const prevValue = select.value;
      select.innerHTML = names.map((m, i) => `<option value="${i}">${esc(m)}</option>`).join('');
      if (prevValue) select.value = prevValue;
    }
    function toggleMonthPicker() {
      const picker = $('monthPicker');
      const willShow = picker.classList.contains('hidden');
      picker.classList.toggle('hidden');
      if (willShow) {
        $('pickerYear').value = calendarMonth.getFullYear();
        $('pickerMonth').value = calendarMonth.getMonth();
      }
    }
    function jumpToPickedMonth() {
      const year = parseInt($('pickerYear').value, 10);
      const month = parseInt($('pickerMonth').value, 10);
      if (!Number.isFinite(year) || !Number.isFinite(month)) return;
      calendarMonth = new Date(year, month, 1);
      selectedDate = null;
      $('monthPicker').classList.add('hidden');
      loadEvents();
    }
    function selectDate(dateStr_) {
      selectedDate = (selectedDate === dateStr_) ? null : dateStr_;
      renderCalendar();
      renderAgenda();
    }
    function clearSelectedDate() {
      selectedDate = null;
      renderCalendar();
      renderAgenda();
    }

    /* ── 등록/수정 모달 ── */
    function toTimeStr(d) {
      return `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
    }
    function onAllDayToggle() {
      const isAllDay = $('fAllDay').checked;
      $('fStartTimeWrap').classList.toggle('hidden', isAllDay);
      $('fEndTimeWrap').classList.toggle('hidden', isAllDay);
    }
    function selectColor(id) {
      selectedColorId = id;
      renderColorPicker();
    }
    function renderColorPicker() {
      const defaultSwatch = `<button type="button" class="sc-color-swatch is-default${!selectedColorId ? ' is-selected' : ''}" onclick="selectColor(null)" aria-label="default"></button>`;
      const swatches = Object.keys(EVENT_COLORS).map(id => `
        <button type="button" class="sc-color-swatch${selectedColorId === id ? ' is-selected' : ''}" style="background:${EVENT_COLORS[id]}" onclick="selectColor('${id}')" aria-label="color ${id}"></button>
      `).join('');
      $('colorPicker').innerHTML = defaultSwatch + swatches;
    }
    function openCreateModal() {
      editingId = null;
      selectedColorId = null;
      $('modalTitle').textContent = t('newEventTitle');
      $('modalError').classList.remove('is-visible');
      $('fSummary').value = '';
      $('fLocation').value = '';
      $('fDescription').value = '';
      $('fAllDay').checked = false;
      const baseDate = selectedDate || todayStr();
      $('fStartDate').value = baseDate;
      $('fEndDate').value = baseDate;
      $('fStartTime').value = '09:00';
      $('fEndTime').value = '10:00';
      onAllDayToggle();
      renderColorPicker();
      $('modalOverlay').classList.remove('hidden');
      $('fSummary').focus();
    }
    function openEditModal(id) {
      const ev = events.find(e => e.id === id);
      if (!ev) return;
      editingId = id;
      selectedColorId = ev.colorId || null;
      $('modalTitle').textContent = t('editEventTitle');
      $('modalError').classList.remove('is-visible');
      $('fSummary').value = ev.summary || '';
      $('fLocation').value = ev.location || '';
      $('fDescription').value = ev.description || '';
      $('fAllDay').checked = !!ev.allDay;
      const r = eventDateRange(ev);
      $('fStartDate').value = r.startDate;
      $('fEndDate').value = r.endDate;
      renderColorPicker();
      if (!ev.allDay) {
        $('fStartTime').value = toTimeStr(new Date(ev.start));
        $('fEndTime').value = toTimeStr(new Date(ev.end));
      }
      onAllDayToggle();
      $('modalOverlay').classList.remove('hidden');
      $('fSummary').focus();
    }
    function closeModal() {
      $('modalOverlay').classList.add('hidden');
    }

    function authHeaders() {
      return { 'Content-Type': 'application/json', Authorization: 'Bearer ' + (sessionStorage.getItem('wolko-hub-token') || '') };
    }

    async function submitEventForm() {
      const errEl = $('modalError');
      errEl.classList.remove('is-visible');
      const summary = $('fSummary').value.trim();
      const allDay = $('fAllDay').checked;
      const startDate = $('fStartDate').value;
      const endDate = $('fEndDate').value;
      if (!summary) { errEl.textContent = t('summaryRequired'); errEl.classList.add('is-visible'); return; }
      if (!startDate || !endDate) { errEl.textContent = t('dateRequired'); errEl.classList.add('is-visible'); return; }

      const payload = {
        summary,
        location: $('fLocation').value.trim(),
        description: $('fDescription').value.trim(),
        colorId: selectedColorId,
        allDay,
        startDate, endDate,
        startTime: $('fStartTime').value,
        endTime: $('fEndTime').value,
      };
      if (editingId) payload.id = editingId;

      const btn = $('saveBtn');
      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = t('saving');
      try {
        const res = await fetch('/api/schedule/events', {
          method: editingId ? 'PUT' : 'POST',
          headers: authHeaders(),
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('saveFailed'));

        if (editingId) {
          const idx = events.findIndex(e => e.id === editingId);
          if (idx !== -1) events[idx] = data.event; else events.push(data.event);
        } else {
          events.push(data.event);
        }
        closeModal();
        renderCalendar();
        renderAgenda();
      } catch (e) {
        errEl.textContent = e.message || t('saveFailed');
        errEl.classList.add('is-visible');
      } finally {
        btn.disabled = false;
        btn.textContent = original;
      }
    }

    async function deleteEvent(id) {
      if (!confirm(t('deleteConfirm'))) return;
      try {
        const res = await fetch(`/api/schedule/events?id=${encodeURIComponent(id)}`, {
          method: 'DELETE',
          headers: authHeaders(),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('deleteFailed'));
        events = events.filter(e => e.id !== id);
        renderCalendar();
        renderAgenda();
      } catch (e) {
        alert(e.message || t('deleteFailed'));
      }
    }

    // 화면 폭이 바뀌면(창 크기 조절, 화면 회전) 줄 수/레이아웃을 다시 계산해서 그린다.
    let resizeTimer = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        if (!$('calendarBody').classList.contains('hidden')) { renderCalendar(); renderAgenda(); }
      }, 150);
    });

    /* ── 초기화 ── */
    applyScLang();
    const hubToken = sessionStorage.getItem('wolko-hub-token') || '';
    const hubSession = hubToken ? parseHubToken(hubToken) : null;
    if (hubSession) {
      canWrite = hubSession.role === 'admin' || hubSession.role === 'master';
      $('fabBtn').classList.toggle('hidden', !canWrite);
      $('calendarBody').classList.remove('hidden');
      loadEvents();
    } else {
      $('loginNotice').classList.remove('hidden');
    }
  </script>
</body>
</html>
