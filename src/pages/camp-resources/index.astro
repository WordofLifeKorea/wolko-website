---
const pageTitle = 'WOLKO Camp Resources';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <meta name="theme-color" content="#004f68">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="WOLKO 자료실">
  <title>{pageTitle}</title>
  <link rel="manifest" href="/camp-resources-manifest.json">
  <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Noto+Sans+KR:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolko-auth.css?v=1">
  <style is:global>
    :root {
      --blue:#004f68;
      --blue-lt:#0077a3;
      --teal:#009b94;
      --bg:#f4f6f8;
      --card:#fff;
      --border:#e4eaee;
      --text:#1a2d38;
      --muted:#6c8290;
      --light:#8fa8b5;
      --red:#c42a36;
      --green:#239c5d;
      --orange:#d9870d;
      --shadow:0 2px 12px rgba(0,79,104,.05);
      --shadow-card:0 10px 28px rgba(0,79,104,.07);
      --shadow-soft:0 4px 14px rgba(0,79,104,.045);
      --radius-lg:20px;
      --radius-md:14px;
      --radius-sm:12px;
      --space-page:28px;
      --space-card:20px;
      --sans:'Montserrat',sans-serif;
      --body:'Noto Sans KR',sans-serif;
      --btn-h-lg:44px;
      --btn-h-md:36px;
      --btn-h-sm:30px;
      --btn-h-xs:26px;
    }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; background:var(--bg); color:var(--text); font-family:var(--body); line-height:1.5; }
    button,input,select,textarea { font:500 13px/1.35 var(--body); }
    button { cursor:pointer; display:inline-flex; align-items:center; justify-content:center; }
    .login-screen {
      position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:20px;
      background:linear-gradient(145deg,#003d52,#00627f);
    }
    .login-screen[hidden] { display:none; }
    .login-card {
      width:min(420px,100%); border-radius:24px; background:#fff; padding:42px 36px 34px; text-align:center;
      box-shadow:0 24px 70px rgba(0,0,0,.24);
    }
    .login-logo { display:flex; align-items:center; justify-content:center; gap:12px; margin-bottom:22px; }
    .login-logo img { height:38px; }
    .login-logo-name { color:var(--blue); font:800 19px/1 var(--sans); letter-spacing:.02em; }
    .login-title { margin:0 0 26px; color:var(--muted); font-size:13px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; }
    .login-input { width:100%; height:52px; border:1.5px solid #d7e2e7; border-radius:14px; padding:0 16px; outline:none; }
    .login-input:focus { border-color:var(--blue); }
    .login-error { min-height:20px; margin:10px 0 14px; color:var(--red); font-size:12px; font-weight:500; }
    .login-btn,.primary {
      min-height:var(--btn-h-lg); border:0; border-radius:var(--radius-sm); background:var(--blue); color:#fff; padding:0 20px;
      font-weight:700; letter-spacing:.01em; transition:background .18s ease,transform .12s ease,box-shadow .18s ease;
    }
    .login-btn { width:100%; height:48px; }
    .login-btn:hover,.primary:hover { background:var(--blue-lt); }
    .secondary,.ghost {
      min-height:var(--btn-h-lg); border:1px solid #d7e4e9; border-radius:var(--radius-sm); background:#fff; color:var(--blue);
      padding:0 16px; font-weight:600; letter-spacing:.01em; transition:border-color .18s ease,background .18s ease,color .18s ease;
    }
    .ghost { background:#f8fbfc; color:var(--muted); }
    .secondary:hover,.ghost:hover { border-color:#b8d6df; background:#f7fbfd; color:var(--blue); }
    .danger { color:var(--red); border-color:#f1c9cf; background:#fff8f9; }
    .topbar {
      position:sticky; top:0; z-index:50; min-height:64px; display:flex; align-items:center; justify-content:space-between; gap:18px;
      padding:10px 32px; background:var(--blue); color:#fff; box-shadow:0 2px 12px rgba(0,79,104,.25); flex-wrap:wrap;
    }
    .brand { display:flex; align-items:center; gap:10px; min-width:0; }
    .brand img { height:30px; flex:0 0 auto; }
    .brand h1 { margin:0; color:rgba(255,255,255,.92); font:700 14px/1 var(--sans); letter-spacing:.04em; }
    .brand p { margin:3px 0 0; color:rgba(255,255,255,.62); font:500 10px/1 var(--sans); letter-spacing:.08em; text-transform:uppercase; }
    .toolbar { display:flex; align-items:center; justify-content:flex-end; gap:8px; flex-wrap:wrap; min-width:0; }
    .toolbar button { min-height:var(--btn-h-md); border:1px solid rgba(255,255,255,.25); border-radius:100px; padding:0 16px; background:rgba(255,255,255,.15); color:#fff; font-size:12px; font-weight:600; }
    .toolbar .edit-toggle { min-width:104px; transition:background .18s,color .18s,border-color .18s,box-shadow .18s; }
    .toolbar .edit-toggle.is-active { background:#fff; color:var(--blue); border-color:#fff; box-shadow:0 4px 14px rgba(0,0,0,.18); }
    .lang-toggle {
      display:flex; align-items:center; position:relative; width:64px; height:26px;
      background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.3); border-radius:999px; padding:2px; cursor:pointer;
    }
    .lang-slider {
      position:absolute; left:2px; width:30px; height:22px; background:#fff; border-radius:999px;
      transition:left .25s cubic-bezier(.4,0,.2,1); box-shadow:0 1px 8px rgba(0,0,0,.18);
    }
    .lang-side { display:flex; align-items:center; justify-content:center; width:30px; z-index:2; transition:opacity .2s; }
    .lang-side img { width:18px; height:13px; object-fit:cover; border-radius:2px; }
    .lang-side span { display:none; }
    .lang-side.is-inactive { opacity:.6; }
    .page { max-width:min(1100px,calc(100vw - 32px)); margin:0 auto; padding:var(--space-page) 18px 90px; }
    .hero {
      margin-bottom:20px; padding:24px; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--card); box-shadow:var(--shadow-card);
    }
    .hero h2 { margin:0; color:var(--text); font:900 clamp(20px,3vw,26px)/1.18 var(--sans); letter-spacing:-.02em; }
    .hero p { margin:9px 0 0; max-width:780px; color:var(--muted); font-size:13.5px; line-height:1.7; font-weight:400; }
    .main-tabs { display:flex; gap:0; border:1px solid var(--border); border-radius:999px; padding:4px; background:#fff; width:fit-content; max-width:100%; overflow-x:auto; margin-bottom:18px; box-shadow:var(--shadow-soft); }
    .main-tab-btn { flex:0 0 auto; min-height:var(--btn-h-sm); border-radius:999px; padding:0 18px; border:0; background:transparent; color:var(--muted); font:700 12.5px/1 var(--sans); white-space:nowrap; transition:background .15s,color .15s; }
    .main-tab-btn.active { background:var(--blue); color:#fff; }
    .subject-group { margin-bottom:18px; }
    .tab-head { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; border:1px solid #dbe7ec; border-radius:var(--radius-lg) var(--radius-lg) 0 0; background:linear-gradient(135deg,#fff,#f4fbfd); padding:15px 17px; box-shadow:var(--shadow-soft); }
    .tab-head.theme-wolko { border-color:#bfdcf7; background:linear-gradient(135deg,#fff,#eaf3fd); }
    .tab-head.theme-wolko .tab-title { color:#0b5fa5; }
    .tab-head.theme-wolko .tab-count { background:#dcedfc; color:#0b5fa5; }
    .tab-head.theme-sf { border-color:#dccdf7; background:linear-gradient(135deg,#fff,#f5eefd); }
    .tab-head.theme-sf .tab-title { color:#6d28d9; }
    .tab-head.theme-sf .tab-count { background:#ede4fc; color:#6d28d9; }
    .tab-head.theme-lesson { border-color:#bfe8cf; background:linear-gradient(135deg,#fff,#eafdf1); }
    .tab-head.theme-lesson .tab-title { color:#15803d; }
    .tab-head.theme-lesson .tab-count { background:#dcfce7; color:#15803d; }
    .subject-group.theme-wolko,
    .subject-group.theme-sf,
    .subject-group.theme-lesson { border-radius:calc(var(--radius-lg) + 4px); padding:5px; margin-bottom:22px; }
    .subject-group.theme-wolko { background:linear-gradient(135deg,#dbeafe,#eaf3fd); box-shadow:0 0 0 1px #9ec8f2; }
    .subject-group.theme-sf { background:linear-gradient(135deg,#ede4fc,#f5eefd); box-shadow:0 0 0 1px #c3a8ee; }
    .subject-group.theme-lesson { background:linear-gradient(135deg,#dcfce7,#eafdf1); box-shadow:0 0 0 1px #86d9a5; }
    .tab-title { color:var(--blue); font:700 16px/1.2 var(--sans); letter-spacing:-.01em; }
    .tab-count { border-radius:999px; background:#e9f8fb; color:var(--blue); padding:6px 11px; font-size:11px; font-weight:500; }
    .subject-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; padding:14px; border:1px solid #dbe7ec; border-top:0; border-radius:0 0 var(--radius-md) var(--radius-md); background:#fbfdfe; }
    @media (max-width:520px) { .subject-grid { grid-template-columns:1fr; } }
    .person-columns { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; padding:14px; }
    @media (max-width:640px) { .person-columns { grid-template-columns:1fr; } }
    .person-columns > .person-block:last-child:nth-child(odd) { grid-column:1 / -1; }
    .person-block { border:1px solid #dbe7ec; border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-soft); }
    .person-block .tab-head { border-radius:var(--radius-md) var(--radius-md) 0 0; }
    .person-block .subject-grid { grid-template-columns:1fr; border-radius:0 0 var(--radius-md) var(--radius-md); }
    @media (min-width:641px) { .person-block:last-child:nth-child(odd) .subject-grid { grid-template-columns:repeat(2,1fr); } }
    .present-card { position:relative; display:flex; align-items:center; gap:13px; min-height:92px; border:1px solid #dbe7ec; border-radius:var(--radius-md); background:#fff; padding:13px 16px; cursor:pointer; box-shadow:var(--shadow-soft); transition:transform .12s,box-shadow .12s; overflow:hidden; }
    .present-card.is-editable { padding-right:48px; }
    .present-card:hover { transform:translateY(-2px); box-shadow:0 10px 22px rgba(0,79,104,.12); }
    .present-card-thumb { flex:0 0 76px; width:76px; height:58px; border:1px solid #d9e8ee; border-radius:13px; background:#f1f6f9; overflow:hidden; box-shadow:inset 0 0 0 1px rgba(255,255,255,.6); }
    .present-card-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
    .present-card-thumb.is-file { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px; background:linear-gradient(135deg,#f8fbfc,#eaf5f8); color:var(--blue); }
    .present-card-thumb.is-pdf { color:#c72c3b; background:linear-gradient(135deg,#fff8f9,#fdecee); }
    .present-card-thumb.is-pptx { color:#d97706; background:linear-gradient(135deg,#fffaf0,#fef3c7); }
    .present-card-thumb.is-link { color:#0f766e; background:linear-gradient(135deg,#f0fdfa,#dff8f4); }
    .present-card-thumb-label { font:800 13px/1 var(--sans); letter-spacing:.04em; }
    .present-card-thumb-sub { color:var(--muted); font-size:9.5px; font-weight:800; letter-spacing:.08em; text-transform:uppercase; }
    .present-card-body { min-width:0; flex:1; display:flex; flex-direction:column; gap:6px; }
    .present-card.dragging { opacity:.4; }
    .present-card-title { color:var(--text); font-weight:700; font-size:13.5px; line-height:1.4; word-break:keep-all; }
    .drag-handle {
      position:absolute; top:50%; right:10px; transform:translateY(-50%);
      display:inline-flex; align-items:center; justify-content:center; width:28px; height:38px;
      border:1px solid transparent; border-radius:999px; background:transparent; color:#9fb1ba;
      cursor:grab; padding:0; transition:background .16s,border-color .16s,color .16s,box-shadow .16s;
    }
    .drag-handle svg { width:16px; height:22px; display:block; }
    .drag-handle:hover { color:var(--blue); background:#f1f7fa; border-color:#d7e6ec; box-shadow:0 4px 10px rgba(0,79,104,.08); }
    .drag-handle:active { cursor:grabbing; }
    .present-card-meta { color:var(--muted); font-size:11px; font-weight:500; }
    .bgm-chip { align-self:flex-start; display:inline-flex; align-items:center; gap:4px; border-radius:999px; background:#f0fdfa; color:#0f766e; padding:4px 10px; font-size:11px; font-weight:600; text-decoration:none; }
    .bgm-chip:hover { background:#ccfbf1; }
    .present-card-actions { display:flex; gap:6px; margin-top:4px; }
    .present-card-actions button { flex:1; min-height:var(--btn-h-sm); border-radius:8px; padding:0 8px; font-size:11px; font-weight:600; border:1px solid #dbe7ec; background:#f8fafc; color:var(--text); }
    .present-card-actions button.danger { color:var(--red); border-color:#f1c9cf; background:#fff8f9; }
    .present-card-add { align-items:center; justify-content:center; color:var(--muted); border-style:dashed; font-weight:700; cursor:pointer; box-shadow:none; }
    .present-card-add:hover { color:var(--blue); border-color:var(--blue); background:#f4fbfd; }
    .empty { padding:24px; border:1px dashed #ccdce3; border-radius:var(--radius-md); color:var(--light); text-align:center; font-weight:400; background:#fff; grid-column:1/-1; }
    .camp-filter-wrap { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-bottom:18px; }
    .camp-filter-wrap[hidden] { display:none; }
    .camp-filter-wrap select { min-height:38px; border:1px solid var(--border); border-radius:var(--radius-sm); padding:0 12px; background:#fff; color:var(--text); font:600 13px/1 var(--body); box-shadow:var(--shadow-soft); cursor:pointer; }
    .camp-rename-btn { min-height:38px; padding:0 14px; white-space:nowrap; }
    .season-toggle { display:flex; gap:0; border:1px solid var(--border); border-radius:999px; padding:4px; background:#fff; box-shadow:var(--shadow-soft); }
    .season-toggle-btn { min-height:var(--btn-h-sm); border:0; border-radius:999px; padding:0 14px; background:transparent; color:var(--muted); font:700 12px/1 var(--sans); white-space:nowrap; cursor:pointer; }
    .season-toggle-btn.active { background:var(--blue); color:#fff; }
    .season-toggle-btn[disabled] { opacity:.35; cursor:not-allowed; }
    .camp-manage-btn { margin-left:auto; min-height:38px; padding:0 14px; }
    .camp-checkbox-list { display:grid; gap:10px; max-height:260px; overflow-y:auto; border:1px solid var(--border); border-radius:var(--radius-sm); padding:12px; background:#fbfdfe; }
    .camp-checkbox-group-label { color:var(--muted); font:700 11px/1 var(--sans); letter-spacing:.02em; margin:6px 0 2px; }
    .camp-checkbox-group-label:first-child { margin-top:0; }
    .camp-checkbox-row { display:flex; align-items:center; gap:8px; font-size:13px; color:var(--text); }
    .camp-checkbox-row input { width:16px; height:16px; }
    .camp-manage-list { display:grid; gap:8px; max-height:260px; overflow-y:auto; margin-bottom:16px; }
    .camp-manage-row { display:flex; align-items:center; justify-content:space-between; gap:10px; border:1px solid var(--border); border-radius:var(--radius-sm); padding:9px 12px; background:#fbfdfe; }
    .camp-manage-row-label { font-size:12.5px; color:var(--text); }
    .camp-manage-actions { display:flex; align-items:center; gap:6px; flex-wrap:wrap; justify-content:flex-end; }
    .camp-default-badge { border-radius:999px; background:#e9f8fb; color:var(--blue); padding:5px 9px; font-size:10.5px; font-weight:800; white-space:nowrap; }
    .camp-manage-row button { min-height:var(--btn-h-xs); min-width:52px; border:1px solid #d7e4e9; border-radius:8px; background:#fff; color:var(--blue); font-size:11px; font-weight:700; cursor:pointer; padding:0 10px; }
    .camp-manage-row button.danger { color:var(--red); border-color:#f1c9cf; background:#fff8f9; }
    .camp-manage-add-row { display:grid; margin-bottom:6px; }
    .camp-manage-add-row .field { margin-bottom:12px; }
    .field { display:grid; gap:6px; margin-bottom:14px; }
    .field label { color:var(--muted); font-size:11.5px; font-weight:700; letter-spacing:.02em; }
    .field input,.field select { min-height:var(--btn-h-lg); border:1px solid #d7e2e7; border-radius:10px; padding:0 12px; outline:none; background:#fff; color:var(--text); }
    .field input:focus,.field select:focus { border-color:var(--blue); }
    .field-divider { height:1px; background:var(--border); margin:16px 0; }
    .tch-dialog-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:999; display:flex; align-items:center; justify-content:center; padding:20px; }
    .tch-dialog-backdrop[hidden] { display:none; }
    .tch-dialog { background:#fff; border-radius:16px; padding:26px 26px 20px; max-width:400px; width:100%; box-shadow:0 8px 40px rgba(0,0,0,.18); max-height:90vh; overflow-y:auto; }
    .tch-dialog-title { font:700 16px/1.3 var(--sans); color:var(--blue); margin-bottom:16px; }
    .tch-dialog-error { min-height:18px; color:var(--red); font-size:12px; font-weight:500; margin-bottom:8px; }
    .tch-dialog-btns { display:flex; gap:8px; justify-content:flex-end; margin-top:6px; }
    .tch-dialog-btns button { border-radius:100px; padding:0 20px; font:600 13px/1 var(--sans); cursor:pointer; }
    .upload-placeholder-btn { width:100%; margin-bottom:14px; }
    .upload-placeholder-btn[disabled] { opacity:.55; cursor:not-allowed; }
    .load-error-banner { margin-bottom:16px; padding:12px 16px; border:1px solid #f1c9cf; border-radius:var(--radius-md); background:#fff8f9; color:var(--red); font-size:12.5px; }
    .load-error-banner[hidden] { display:none; }
    .install-guide {
      position:fixed; inset:0; z-index:1200; display:flex; align-items:center; justify-content:center; padding:20px;
      background:rgba(0,18,28,.58); backdrop-filter:blur(8px);
    }
    .install-guide[hidden] { display:none; }
    .install-guide-card {
      width:min(390px,100%); border-radius:22px; background:#fff; padding:26px 24px 22px;
      box-shadow:0 22px 60px rgba(0,0,0,.24);
    }
    .install-guide-title { margin:0 0 8px; color:var(--blue); font:800 18px/1.25 var(--sans); }
    .install-guide-desc { margin:0 0 16px; color:var(--muted); font-size:13px; line-height:1.65; }
    .install-guide-steps { margin:0 0 20px; padding-left:20px; color:var(--text); font-size:13px; line-height:1.8; }
    .install-guide-actions { display:flex; justify-content:flex-end; }
    .install-guide-actions .primary { min-width:96px; }
  </style>
</head>
<body>
  <div class="login-screen" id="loginScreen" hidden>
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
        </div>
      </div>
      <p class="login-title" data-ko="편집 모드 로그인" data-en="Edit Mode Login">편집 모드 로그인</p>
      <input class="login-input" id="passwordInput" type="password" data-ph-ko="공유 비밀번호" data-ph-en="Shared password" placeholder="공유 비밀번호" autocomplete="current-password">
      <p class="login-error" id="loginError"></p>
      <button class="login-btn" id="loginBtn" type="button" data-ko="확인" data-en="Confirm">확인</button>
      <button class="ghost" id="loginCancelBtn" type="button" style="width:100%;margin-top:10px;" data-ko="취소" data-en="Cancel">취소</button>
    </div>
  </div>

  <header class="topbar">
    <div class="brand">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <div>
        <h1 data-ko="캠프 자료실" data-en="Camp Resources">캠프 자료실</h1>
        <p data-ko="캠프 자료 모음" data-en="Camp Resource Hub">캠프 자료 모음</p>
      </div>
    </div>
    <div class="toolbar">
      <div class="lang-toggle" id="langToggle">
        <div class="lang-slider" id="langSlider"></div>
        <div class="lang-side is-active" id="langKo"><img src="https://flagcdn.com/w40/kr.png" alt="KR"><span>한국어</span></div>
        <div class="lang-side is-inactive" id="langEn"><img src="https://flagcdn.com/w40/us.png" alt="US"><span>English</span></div>
      </div>
      <button class="secondary" id="installBtn" type="button" hidden data-ko="앱 설치" data-en="Install App">앱 설치</button>
      <button class="edit-toggle" id="editModeBtn" type="button" aria-pressed="false">편집 모드</button>
    </div>
  </header>

  <main class="page">
    <section class="hero">
      <h2 data-ko="캠프 자료실" data-en="Camp Resources">캠프 자료실</h2>
      <p data-ko="탭을 선택하고 카드를 클릭하면 자료가 새 탭에서 열립니다." data-en="Choose a tab and click a card to open its resource in a new tab.">탭을 선택하고 카드를 클릭하면 자료가 새 탭에서 열립니다.</p>
    </section>

    <div class="main-tabs" id="mainTabs" role="tablist">
