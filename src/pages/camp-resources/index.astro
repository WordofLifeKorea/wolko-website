  <script>
    const TOKEN_KEY = 'wolko_camp_resources_token';
    const LANG_KEY = 'wolko_camp_resources_lang';
    const TAB_KEY = 'wolko_camp_resources_tab';
    const TEAM_WOLKO = 'WOLKO';
    const TEAM_SF = 'Student Fusion Team Projects';
    const TEAM_LESSON_PLAN = '레슨플랜';
    const TEAMS_ORDER = [TEAM_SF, TEAM_WOLKO, TEAM_LESSON_PLAN];
    const WOLKO_PINNED_PEOPLE = ['Zach', 'Niki', 'Molly', 'Debbie', 'Shannon'];
    const TABS = [
      { key: 'teacher', ko: '수업자료', en: 'Class Materials' },
      { key: 'program', ko: '프로그램팀', en: 'Program Team' },
      { key: 'counselor', ko: '상담자', en: 'Counselors' },
      { key: 'preacher', ko: '설교자', en: 'Preachers' },
      { key: 'general', ko: 'General Files', en: 'General Files' },
    ];
    const TAB_KEYS = TABS.map(t => t.key);
    const DEFAULT_TAB = 'teacher';

    const COPY = {
      ko: {
        noItems: '등록된 자료가 없습니다.',
        addItem: '추가',
        edit: '수정',
        delete: '삭제',
        deleteConfirm: '이 자료를 삭제하시겠습니까?',
        loginFailed: '로그인하지 못했습니다.',
        saveFailed: '저장하지 못했습니다.',
        deleteFailed: '삭제하지 못했습니다.',
        loadFailed: '목록을 불러오지 못했습니다.',
        validationError: '캠프를 하나 이상 선택하고, 제목과 URL을 입력해주세요.',
        validationErrorTeam: '팀을 선택해주세요.',
        validationErrorPerson: 'WOLKO 팀은 이름을 입력해주세요.',
        addTitle: '자료 추가',
        editTitle: '자료 수정',
        uploading: '업로드 중...',
        uploadFailed: '업로드하지 못했습니다.',
        uploadTooBig: '파일이 너무 큽니다. (최대 20MB)',
        uploadBadType: 'PDF, PPTX 또는 이미지 파일만 업로드할 수 있습니다.',
        uploadBadTypeBgm: 'MP3, WAV, M4A 파일만 업로드할 수 있습니다.',
        dragHint: '끌어서 순서 변경',
        reorderFailed: '순서를 저장하지 못했습니다.',
        summer: '여름',
        winter: '겨울',
        noCamps: '등록된 캠프가 없습니다. 먼저 캠프를 추가해주세요.',
        campLoadFailed: '캠프 목록을 불러오지 못했습니다.',
        campSaveFailed: '캠프를 저장하지 못했습니다.',
        campDeleteFailed: '캠프를 삭제하지 못했습니다.',
        campRenameFailed: '캠프 이름을 수정하지 못했습니다.',
        campFieldsRequired: '연도, 계절, 이름을 모두 입력해주세요.',
        campDeleteConfirm: '이 캠프를 삭제하시겠습니까? (연결된 자료는 삭제되지 않습니다)',
        campRenamePrompt: '새 캠프 이름을 입력해주세요.',
        campRenameEmpty: '캠프 이름을 입력해주세요.',
        setDefaultCamp: '기본 설정',
        defaultCamp: '기본',
        defaultCampSaveFailed: '기본 캠프를 저장하지 못했습니다.',
        editModeEnter: '편집 모드',
        editModeExit: '편집 중 · 나가기',
      },
      en: {
        noItems: 'No resources yet.',
        addItem: 'Add',
        edit: 'Edit',
        delete: 'Delete',
        deleteConfirm: 'Delete this resource?',
        loginFailed: 'Login failed.',
        saveFailed: 'Could not save.',
        deleteFailed: 'Could not delete.',
        loadFailed: 'Could not load the list.',
        validationError: 'Please select at least one camp and fill in title and URL.',
        validationErrorTeam: 'Please choose a team.',
        validationErrorPerson: 'Please enter a name for the WOLKO team.',
        addTitle: 'Add Resource',
        editTitle: 'Edit Resource',
        uploading: 'Uploading...',
        uploadFailed: 'Upload failed.',
        uploadTooBig: 'File is too large. (max 20MB)',
        uploadBadType: 'Only PDF, PPTX, or image files can be uploaded.',
        uploadBadTypeBgm: 'Only MP3, WAV, or M4A files can be uploaded.',
        dragHint: 'Drag to reorder',
        reorderFailed: 'Could not save the new order.',
        summer: 'Summer',
        winter: 'Winter',
        noCamps: 'No camps registered yet. Add a camp first.',
        campLoadFailed: 'Could not load the camp list.',
        campSaveFailed: 'Could not save the camp.',
        campDeleteFailed: 'Could not delete the camp.',
        campRenameFailed: 'Could not rename the camp.',
        campFieldsRequired: 'Please fill in year, season, and name.',
        campDeleteConfirm: 'Delete this camp? (Linked resources will not be deleted)',
        campRenamePrompt: 'Enter the new camp name.',
        campRenameEmpty: 'Please enter a camp name.',
        setDefaultCamp: 'Set Default',
        defaultCamp: 'Default',
        defaultCampSaveFailed: 'Could not save the default camp.',
        editModeEnter: 'Edit Mode',
        editModeExit: 'Editing · Exit',
      },
    };

    let currentLang = localStorage.getItem(LANG_KEY) === 'en' ? 'en' : 'ko';
    function tr(key) {
      return COPY[currentLang][key] ?? COPY.ko[key] ?? key;
    }
    function tabLabel(key) {
      const t = TABS.find(t => t.key === key);
      return t ? (currentLang === 'en' ? t.en : t.ko) : key;
    }

    const els = {
      loginScreen: document.getElementById('loginScreen'),
      passwordInput: document.getElementById('passwordInput'),
      loginBtn: document.getElementById('loginBtn'),
      loginCancelBtn: document.getElementById('loginCancelBtn'),
      loginError: document.getElementById('loginError'),
      langToggle: document.getElementById('langToggle'),
      langSlider: document.getElementById('langSlider'),
      langKo: document.getElementById('langKo'),
      langEn: document.getElementById('langEn'),
      installBtn: document.getElementById('installBtn'),
      installGuide: document.getElementById('installGuide'),
      installGuideTitle: document.getElementById('installGuideTitle'),
      installGuideDesc: document.getElementById('installGuideDesc'),
      installGuideSteps: document.getElementById('installGuideSteps'),
      installGuideClose: document.getElementById('installGuideClose'),
      editModeBtn: document.getElementById('editModeBtn'),
      mainTabs: document.getElementById('mainTabs'),
      subjectGroups: document.getElementById('subjectGroups'),
      campFilterWrap: document.getElementById('campFilterWrap'),
      yearSelect: document.getElementById('yearSelect'),
      seasonToggle: document.getElementById('seasonToggle'),
      campSelect: document.getElementById('campSelect'),
      campRenameBtn: document.getElementById('campRenameBtn'),
      campManageBtn: document.getElementById('campManageBtn'),
      campManageBackdrop: document.getElementById('campManageBackdrop'),
      campManageList: document.getElementById('campManageList'),
      newCampYear: document.getElementById('newCampYear'),
      newCampSeasonToggle: document.getElementById('newCampSeasonToggle'),
      newCampName: document.getElementById('newCampName'),
      addCampBtn: document.getElementById('addCampBtn'),
      campManageError: document.getElementById('campManageError'),
      campManageCloseBtn: document.getElementById('campManageCloseBtn'),
      loadErrorBanner: document.getElementById('loadErrorBanner'),
      itemDialogBackdrop: document.getElementById('itemDialogBackdrop'),
      itemDialogTitle: document.getElementById('itemDialogTitle'),
      teamFieldWrap: document.getElementById('teamFieldWrap'),
      itemTeam: document.getElementById('itemTeam'),
      personFieldWrap: document.getElementById('personFieldWrap'),
      itemPerson: document.getElementById('itemPerson'),
      personDatalist: document.getElementById('personDatalist'),
      campCheckboxList: document.getElementById('campCheckboxList'),
      itemTitle: document.getElementById('itemTitle'),
      itemUrl: document.getElementById('itemUrl'),
      itemDialogError: document.getElementById('itemDialogError'),
      itemDialogCancelBtn: document.getElementById('itemDialogCancelBtn'),
      itemDialogSaveBtn: document.getElementById('itemDialogSaveBtn'),
      uploadFileBtn: document.getElementById('uploadFileBtn'),
      uploadFileInput: document.getElementById('uploadFileInput'),
      bgmFieldWrap: document.getElementById('bgmFieldWrap'),
      itemBgmUrl: document.getElementById('itemBgmUrl'),
      uploadBgmBtn: document.getElementById('uploadBgmBtn'),
      uploadBgmInput: document.getElementById('uploadBgmInput'),
    };

    let items = [];
    let camps = [];
    let defaultCampId = '';
    let selectedYear = '';
    let selectedSeason = '';
    let selectedCampId = '';
    let currentTab = TABS.some(t => t.key === localStorage.getItem(TAB_KEY)) ? localStorage.getItem(TAB_KEY) : DEFAULT_TAB;
    let dialogTab = DEFAULT_TAB;
    let editMode = false;
    let token = localStorage.getItem(TOKEN_KEY) || '';
    let editingItemId = '';
    let deferredInstallPrompt = null;
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches
      || window.navigator.standalone === true;
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
    }

    function applyLanguage() {
      document.documentElement.lang = currentLang;
      document.querySelectorAll('[data-ko][data-en]').forEach(el => {
        el.textContent = el.dataset[currentLang];
      });
      document.querySelectorAll('[data-ph-ko][data-ph-en]').forEach(el => {
        el.placeholder = el.dataset[`ph${currentLang === 'ko' ? 'Ko' : 'En'}`] || '';
      });
      document.querySelectorAll('option[data-ko][data-en]').forEach(option => {
        option.textContent = option.dataset[currentLang];
      });
      updateLangToggleUI();
      updateInstallGuideText();
      updateEditModeUI();
    }

    function updateInstallGuideText() {
      if (!els.installGuideTitle || !els.installGuideDesc || !els.installGuideSteps) return;
      const copy = currentLang === 'en'
        ? {
            title: 'Install as an App',
            desc: isIOS ? 'Install this page from Safari.' : 'Install this page from your browser menu.',
            steps: isIOS
              ? ['Tap the share button at the bottom of Safari.', 'Choose "Add to Home Screen".', 'Tap "Add".']
              : ['Tap the browser menu in the upper right.', 'Choose "Install app" or "Add to Home screen".', 'Confirm the installation.'],
          }
        : {
            title: '앱으로 설치하기',
            desc: isIOS ? 'Safari 브라우저에서 홈 화면에 추가할 수 있어요.' : '브라우저 메뉴에서 앱처럼 설치할 수 있어요.',
            steps: isIOS
              ? ['Safari 하단의 공유 버튼을 누르세요.', '"홈 화면에 추가"를 선택하세요.', '"추가"를 누르면 설치가 완료됩니다.']
              : ['오른쪽 상단 브라우저 메뉴를 누르세요.', '"앱 설치" 또는 "홈 화면에 추가"를 선택하세요.', '설치를 확인하면 완료됩니다.'],
          };
      els.installGuideTitle.textContent = copy.title;
      els.installGuideDesc.textContent = copy.desc;
      els.installGuideSteps.innerHTML = copy.steps.map(step => `<li>${escapeHtml(step)}</li>`).join('');
    }

    function updateLangToggleUI() {
      const isEn = currentLang === 'en';
      els.langKo.className = isEn ? 'lang-side is-inactive' : 'lang-side is-active';
      els.langEn.className = isEn ? 'lang-side is-active' : 'lang-side is-inactive';
      const sliderW = els.langSlider.offsetWidth || 30;
      els.langSlider.style.left = isEn ? `${els.langToggle.offsetWidth - sliderW - 2}px` : '2px';
    }

    let loadErrorIsStandard = false;

    function setLanguage(lang) {
      currentLang = lang === 'en' ? 'en' : 'ko';
      localStorage.setItem(LANG_KEY, currentLang);
      applyLanguage();
      if (loadErrorIsStandard && !els.loadErrorBanner.hidden) {
        els.loadErrorBanner.textContent = tr('loadFailed');
      }
      if (editingItemId !== '' || !els.itemDialogBackdrop.hidden) {
        els.itemDialogTitle.textContent = editingItemId ? tr('editTitle') : tr('addTitle');
      }
      render();
    }

    function campById(id) {
      return camps.find(c => c.id === id) || null;
    }

    function campNamesFor(campIds) {
      return (campIds || []).map(id => campById(id)?.name).filter(Boolean).join(', ');
    }

    function resourceExt(url) {
      try {
        const path = new URL(url).pathname.toLowerCase();
        const match = path.match(/\.([a-z0-9]+)$/);
        return match ? match[1] : '';
      } catch {
        const clean = String(url || '').split(/[?#]/)[0].toLowerCase();
        const match = clean.match(/\.([a-z0-9]+)$/);
        return match ? match[1] : '';
      }
    }

    function resourceHost(url) {
      try {
        return new URL(url).hostname.replace(/^www\./, '');
      } catch {
        return '';
      }
    }

    function previewMeta(item) {
      const ext = resourceExt(item.url);
      if (item.thumbnailUrl) return { image: item.thumbnailUrl };
      if (/^(png|jpe?g|webp|gif|heic|heif)$/i.test(ext)) return { image: item.url };
      if (ext === 'pdf') return { label: 'PDF', sub: 'File', className: 'is-pdf' };
      if (ext === 'pptx') return { label: 'PPT', sub: 'Slides', className: 'is-pptx' };
      const host = resourceHost(item.url);
      if (/canva\.com$/i.test(host)) return { label: 'CV', sub: 'Canva', className: 'is-link' };
      return { label: 'URL', sub: host || 'Link', className: 'is-link' };
    }

    function cardPreviewHtml(item) {
      const preview = previewMeta(item);
      if (preview.image) {
        return `<div class="present-card-thumb"><img src="${escapeHtml(preview.image)}" alt="" loading="lazy"></div>`;
      }
      return `
        <div class="present-card-thumb is-file ${escapeHtml(preview.className || '')}">
          <span class="present-card-thumb-label">${escapeHtml(preview.label)}</span>
          <span class="present-card-thumb-sub">${escapeHtml(preview.sub)}</span>
        </div>`;
    }

    function itemTab(item) {
      if (item?.team || item?.person) return 'teacher';
      return TAB_KEYS.includes(item?.tab) ? item.tab : 'general';
    }

    function sortedYears() {
      return [...new Set(camps.map(c => c.year))].sort((a, b) => String(b).localeCompare(String(a), 'ko', { numeric: true }));
    }

    function seasonsForYear(year) {
      const set = new Set(camps.filter(c => c.year === year).map(c => c.season));
      return ['summer', 'winter'].filter(s => set.has(s));
    }

    function campsForYearSeason(year, season) {
      return camps.filter(c => c.year === year && c.season === season).sort((a, b) => a.name.localeCompare(b.name, 'ko'));
    }

    function applyDefaultCampSelection() {
      const camp = campById(defaultCampId);
      if (!camp) return false;
      selectedYear = camp.year;
      selectedSeason = camp.season;
      selectedCampId = camp.id;
      return true;
    }

    function presentCardHtml(item) {
      return `
        <div class="present-card${editMode ? ' is-editable' : ''}" data-open-url="${escapeHtml(item.url)}" data-item-id="${escapeHtml(item.id)}">
          ${cardPreviewHtml(item)}
          ${editMode ? `<button class="drag-handle" type="button" draggable="true" data-stop title="${escapeHtml(tr('dragHint'))}" aria-label="${escapeHtml(tr('dragHint'))}">
            <svg viewBox="0 0 16 24" aria-hidden="true">
              <circle cx="5" cy="5" r="1.8" fill="currentColor"></circle>
              <circle cx="11" cy="5" r="1.8" fill="currentColor"></circle>
              <circle cx="5" cy="12" r="1.8" fill="currentColor"></circle>
              <circle cx="11" cy="12" r="1.8" fill="currentColor"></circle>
              <circle cx="5" cy="19" r="1.8" fill="currentColor"></circle>
              <circle cx="11" cy="19" r="1.8" fill="currentColor"></circle>
            </svg>
          </button>` : ''}
          <div class="present-card-body">
            <div class="present-card-title">${escapeHtml(item.title)}</div>
            <div class="present-card-meta">${escapeHtml(campNamesFor(item.campIds))}</div>
            ${item.bgmUrl ? `<a class="bgm-chip" href="${escapeHtml(item.bgmUrl)}" target="_blank" rel="noopener" data-stop>🎵 BGM</a>` : ''}
            ${editMode ? `
              <div class="present-card-actions" data-stop>
                <button type="button" data-edit-item="${escapeHtml(item.id)}">${escapeHtml(tr('edit'))}</button>
                <button type="button" class="danger" data-delete-item="${escapeHtml(item.id)}">${escapeHtml(tr('delete'))}</button>
              </div>` : ''}
          </div>
        </div>`;
    }

    function addButtonHtml(defaults) {
      const attrs = Object.entries(defaults)
        .filter(([, v]) => v)
        .map(([k, v]) => `data-add-${k}="${escapeHtml(v)}"`)
        .join(' ');
      return `<button class="present-card present-card-add" ${attrs} type="button">+ ${escapeHtml(tr('addItem'))}</button>`;
    }

    function personGroupHtml(person, personItems) {
      return `
        <div class="person-block">
          <div class="tab-head">
            <div class="tab-title" style="font-size:13px;">${escapeHtml(person)}</div>
            <div class="tab-count">${personItems.length}</div>
          </div>
          <div class="subject-grid">
            ${personItems.length ? personItems.map(presentCardHtml).join('') : `<div class="empty">${escapeHtml(tr('noItems'))}</div>`}
            ${editMode ? addButtonHtml({ tab: 'teacher', team: TEAM_WOLKO, person }) : ''}
          </div>
        </div>`;
    }

    function groupByPerson(list) {
      const groups = {};
      list.forEach(item => {
        const p = item.person || '';
        (groups[p] || (groups[p] = [])).push(item);
      });
      return groups;
    }

    function wolkoTeamHtml(teamItems, { pinPeople }) {
      const byPerson = groupByPerson(teamItems);
      const extra = Object.keys(byPerson).filter(p => p && !WOLKO_PINNED_PEOPLE.includes(p)).sort((a, b) => a.localeCompare(b, 'ko'));
      const names = pinPeople ? [...WOLKO_PINNED_PEOPLE, ...extra] : Object.keys(byPerson).filter(Boolean).sort((a, b) => a.localeCompare(b, 'ko'));
      return `
        <div class="subject-group theme-wolko">
          <div class="tab-head theme-wolko">
            <div class="tab-title">${escapeHtml(TEAM_WOLKO)}</div>
            <div class="tab-count">${teamItems.length}</div>
          </div>
          <div class="person-columns">
            ${names.map(name => personGroupHtml(name, byPerson[name] || [])).join('')}
          </div>
        </div>`;
    }

    function flatListHtml(headerLabel, listItems, addDefaults, themeClass) {
      return `
        <div class="subject-group${themeClass ? ` ${themeClass}` : ''}">
          <div class="tab-head${themeClass ? ` ${themeClass}` : ''}">
            <div class="tab-title">${escapeHtml(headerLabel)}</div>
            <div class="tab-count">${listItems.length}</div>
          </div>
          <div class="subject-grid">
            ${listItems.length ? listItems.map(presentCardHtml).join('') : `<div class="empty">${escapeHtml(tr('noItems'))}</div>`}
            ${editMode ? addButtonHtml(addDefaults) : ''}
          </div>
        </div>`;
    }

    function groupByTeam(list) {
      const groups = {};
      list.forEach(item => {
        (groups[item.team] || (groups[item.team] = [])).push(item);
      });
      return groups;
    }

    function renderMainTabs() {
      els.mainTabs.querySelectorAll('.main-tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === currentTab);
      });
    }

    function renderCampFilter() {
      const years = sortedYears();
      els.campFilterWrap.hidden = years.length === 0;
      if (!years.length) return;
      if (!selectedCampId && applyDefaultCampSelection()) {
        // 기본 캠프가 있으면 첫 화면 선택에 우선 적용한다.
      }
      if (!years.includes(selectedYear)) selectedYear = years[0];
      els.yearSelect.innerHTML = years.map(y => `<option value="${escapeHtml(y)}">${escapeHtml(y)}</option>`).join('');
      els.yearSelect.value = selectedYear;

      const seasons = seasonsForYear(selectedYear);
      if (!seasons.includes(selectedSeason)) selectedSeason = seasons[0] || 'summer';
      els.seasonToggle.querySelectorAll('.season-toggle-btn').forEach(btn => {
        const s = btn.dataset.season;
        btn.classList.toggle('active', s === selectedSeason);
        btn.disabled = !seasons.includes(s);
      });

      const campsHere = campsForYearSeason(selectedYear, selectedSeason);
      if (!campsHere.some(c => c.id === selectedCampId)) selectedCampId = campsHere[0]?.id || '';
      els.campSelect.innerHTML = campsHere.map(c => `<option value="${escapeHtml(c.id)}">${escapeHtml(c.name)}</option>`).join('');
      els.campSelect.value = selectedCampId;
      updateEditModeUI();
    }

    function renderCategoryGroups() {
      if (currentTab === 'general') {
        const campItems = items.filter(i => (i.campIds || []).includes(selectedCampId) && itemTab(i) === 'general');
        els.subjectGroups.innerHTML = flatListHtml(tabLabel('general'), campItems, { tab: 'general' });
        return;
      }
      const campItems = items.filter(i => (i.campIds || []).includes(selectedCampId) && itemTab(i) === currentTab);
      if (currentTab === 'teacher') {
        const byTeam = groupByTeam(campItems);
        els.subjectGroups.innerHTML = TEAMS_ORDER.map(team => {
          if (team === TEAM_WOLKO) return wolkoTeamHtml(byTeam[team] || [], { pinPeople: true });
          const theme = team === TEAM_SF ? 'theme-sf' : 'theme-lesson';
          return flatListHtml(team, byTeam[team] || [], { tab: 'teacher', team }, theme);
        }).join('');
      } else {
        els.subjectGroups.innerHTML = flatListHtml(tabLabel(currentTab), campItems, { tab: currentTab });
      }
    }

    function renderPersonDatalist() {
      const existing = new Set(items.filter(i => i.team === TEAM_WOLKO && i.person).map(i => i.person));
      const names = [...new Set([...WOLKO_PINNED_PEOPLE, ...existing])];
      els.personDatalist.innerHTML = names.map(name => `<option value="${escapeHtml(name)}"></option>`).join('');
    }

    function render() {
      renderMainTabs();
      renderCampFilter();
      renderCategoryGroups();
      renderPersonDatalist();
    }

    document.querySelector('main.page').addEventListener('click', event => {
      if (event.target.closest('[data-stop]')) {
        const editBtn = event.target.closest('[data-edit-item]');
        if (editBtn) { openItemDialog(editBtn.dataset.editItem); return; }
        const delBtn = event.target.closest('[data-delete-item]');
        if (delBtn) { confirmDeleteItem(delBtn.dataset.deleteItem); return; }
        return;
      }
      const addBtn = event.target.closest('[data-add-tab]');
      if (addBtn) {
        openItemDialog('', {
          tab: addBtn.dataset.addTab,
          team: addBtn.dataset.addTeam || '',
          person: addBtn.dataset.addPerson || '',
        });
        return;
      }
      const card = event.target.closest('[data-open-url]');
      if (card) window.open(card.dataset.openUrl, '_blank', 'noopener');
    });

    let draggedCard = null;
    const mainPage = document.querySelector('main.page');

    mainPage.addEventListener('dragstart', event => {
      const handle = event.target.closest('.drag-handle');
      if (!handle) return;
      const card = handle.closest('.present-card');
      if (!card) return;
      draggedCard = card;
      event.dataTransfer.effectAllowed = 'move';
      event.dataTransfer.setData('text/plain', card.dataset.itemId);
      try { event.dataTransfer.setDragImage(card, 20, 20); } catch {}
      requestAnimationFrame(() => card.classList.add('dragging'));
    });

    mainPage.addEventListener('dragend', () => {
      if (draggedCard) draggedCard.classList.remove('dragging');
      draggedCard = null;
    });

    function dragAfterElement(container, y) {
      const cards = [...container.querySelectorAll('.present-card:not(.dragging)')];
      return cards.reduce((closest, child) => {
        const box = child.getBoundingClientRect();
        const offset = y - box.top - box.height / 2;
        if (offset < 0 && offset > closest.offset) return { offset, element: child };
        return closest;
      }, { offset: -Infinity, element: null }).element;
    }

    mainPage.addEventListener('dragover', event => {
      if (!draggedCard) return;
      const grid = event.target.closest('.subject-grid');
      if (!grid || !grid.contains(draggedCard)) return;
      event.preventDefault();
      const afterEl = dragAfterElement(grid, event.clientY);
      if (afterEl == null) grid.appendChild(draggedCard);
      else grid.insertBefore(draggedCard, afterEl);
    });

    async function saveReorder(ids) {
      try {
        const res = await fetch('/api/teach/data', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ ids }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          token = '';
          exitEditMode();
          els.loginError.textContent = tr('loginFailed');
          els.loginScreen.hidden = false;
          return;
        }
        if (!res.ok) throw new Error(data.error || tr('reorderFailed'));
        items = data.items;
        render();
      } catch (error) {
        alert(error.message);
        render();
      }
    }

    mainPage.addEventListener('drop', event => {
      if (!draggedCard) return;
      const grid = event.target.closest('.subject-grid');
      if (!grid || !grid.contains(draggedCard)) return;
      event.preventDefault();
      const ids = [...grid.querySelectorAll('.present-card[data-item-id]')].map(c => c.dataset.itemId);
      saveReorder(ids);
    });

    els.mainTabs.addEventListener('click', event => {
      const btn = event.target.closest('.main-tab-btn');
      if (!btn) return;
      currentTab = btn.dataset.tab;
      localStorage.setItem(TAB_KEY, currentTab);
      renderMainTabs();
      renderCategoryGroups();
      renderPersonDatalist();
    });

    els.yearSelect.addEventListener('change', () => {
      selectedYear = els.yearSelect.value;
      selectedSeason = '';
      selectedCampId = '';
      renderCampFilter();
      renderCategoryGroups();
      renderPersonDatalist();
    });

    els.seasonToggle.addEventListener('click', event => {
      const btn = event.target.closest('.season-toggle-btn');
      if (!btn || btn.disabled) return;
      selectedSeason = btn.dataset.season;
      selectedCampId = '';
      renderCampFilter();
      renderCategoryGroups();
      renderPersonDatalist();
    });

    els.campSelect.addEventListener('change', () => {
      selectedCampId = els.campSelect.value;
      updateEditModeUI();
      renderCategoryGroups();
      renderPersonDatalist();
    });

    async function renameSelectedCamp() {
      const camp = campById(selectedCampId);
      if (!camp) return;
      const nextName = prompt(tr('campRenamePrompt'), camp.name);
      if (nextName === null) return;
      const name = nextName.trim();
      if (!name) {
        alert(tr('campRenameEmpty'));
        return;
      }
      if (name === camp.name) return;
      els.campRenameBtn.disabled = true;
      try {
        const res = await fetch('/api/teach/camps', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ id: camp.id, name }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          token = '';
          exitEditMode();
          els.loginError.textContent = tr('loginFailed');
          els.loginScreen.hidden = false;
          return;
        }
        if (!res.ok) throw new Error(data.error || tr('campRenameFailed'));
        camps = data.camps;
        selectedCampId = camp.id;
        renderCampManageList();
        render();
      } catch (error) {
        alert(error.message);
      } finally {
        els.campRenameBtn.disabled = false;
      }
    }
    els.campRenameBtn.addEventListener('click', renameSelectedCamp);

    function enterEditMode() {
      editMode = true;
      updateEditModeUI();
      render();
    }

    function exitEditMode() {
      editMode = false;
      token = '';
      localStorage.removeItem(TOKEN_KEY);
      updateEditModeUI();
      render();
    }

    function updateEditModeUI() {
      if (!els.editModeBtn) return;
      els.editModeBtn.classList.toggle('is-active', editMode);
      els.editModeBtn.setAttribute('aria-pressed', editMode ? 'true' : 'false');
      els.editModeBtn.textContent = editMode ? tr('editModeExit') : tr('editModeEnter');
      if (els.campManageBtn) els.campManageBtn.hidden = !editMode;
      if (els.campRenameBtn) els.campRenameBtn.hidden = !editMode || !selectedCampId;
    }

    els.editModeBtn.addEventListener('click', () => {
      if (editMode) { exitEditMode(); return; }
      if (token) { enterEditMode(); return; }
      els.loginError.textContent = '';
      els.passwordInput.value = '';
      els.loginScreen.hidden = false;
    });
    els.loginCancelBtn.addEventListener('click', () => { els.loginScreen.hidden = true; });

    async function login() {
      els.loginBtn.disabled = true;
      els.loginError.textContent = '';
      try {
        const res = await fetch('/api/teach/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: els.passwordInput.value.trim() }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || tr('loginFailed'));
        token = data.token;
        localStorage.setItem(TOKEN_KEY, token);
        els.loginScreen.hidden = true;
        enterEditMode();
      } catch (error) {
        els.loginError.textContent = error.message;
      } finally {
        els.loginBtn.disabled = false;
      }
    }
    els.loginBtn.addEventListener('click', login);
    els.passwordInput.addEventListener('keydown', event => {
      if (event.key === 'Enter') login();
    });

    function updatePersonFieldVisibility() {
      els.personFieldWrap.hidden = dialogTab !== 'teacher' || els.itemTeam.value !== TEAM_WOLKO;
    }
    els.itemTeam.addEventListener('change', updatePersonFieldVisibility);

    function updateDialogFieldsForTab() {
      els.teamFieldWrap.hidden = dialogTab !== 'teacher';
      updatePersonFieldVisibility();
      els.bgmFieldWrap.hidden = !(dialogTab === 'program' || dialogTab === 'counselor');
    }

    function renderCampCheckboxes(checkedIds) {
      const checked = new Set(checkedIds || []);
      const years = sortedYears();
      els.campCheckboxList.innerHTML = years.map(year => {
        const seasons = seasonsForYear(year);
        return seasons.map(season => {
          const campsHere = campsForYearSeason(year, season);
          if (!campsHere.length) return '';
          const seasonLabel = season === 'summer' ? tr('summer') : tr('winter');
          return `
            <div class="camp-checkbox-group-label">${escapeHtml(year)} ${escapeHtml(seasonLabel)}</div>
            ${campsHere.map(c => `
              <label class="camp-checkbox-row">
                <input type="checkbox" value="${escapeHtml(c.id)}" ${checked.has(c.id) ? 'checked' : ''}>
                <span>${escapeHtml(c.name)}</span>
              </label>
            `).join('')}
          `;
        }).join('');
      }).join('') || `<div class="empty" style="grid-column:auto;">${escapeHtml(tr('noCamps'))}</div>`;
    }

    function openItemDialog(itemId, defaults) {
      defaults = defaults || {};
      editingItemId = itemId || '';
      const item = itemId ? items.find(i => i.id === itemId) : null;
      dialogTab = (item && item.tab) || defaults.tab || currentTab;
      els.itemDialogTitle.textContent = itemId ? tr('editTitle') : tr('addTitle');
      els.itemTeam.value = (item && item.team) || defaults.team || TEAM_WOLKO;
      updateDialogFieldsForTab();
      els.itemPerson.value = (item && item.person) || defaults.person || '';
      renderCampCheckboxes((item && item.campIds) || (selectedCampId ? [selectedCampId] : []));
      els.itemTitle.value = (item && item.title) || '';
      els.itemUrl.value = (item && item.url) || '';
      els.itemBgmUrl.value = (item && item.bgmUrl) || '';
      els.itemDialogError.textContent = '';
      els.itemDialogBackdrop.hidden = false;
    }
    els.itemDialogCancelBtn.addEventListener('click', () => { els.itemDialogBackdrop.hidden = true; });

    async function saveItemFromDialog() {
      const isTeacher = dialogTab === 'teacher';
      const hasBgm = dialogTab === 'program' || dialogTab === 'counselor';
      const campIds = [...els.campCheckboxList.querySelectorAll('input[type="checkbox"]:checked')].map(el => el.value);
      const payload = {
        id: editingItemId || undefined,
        tab: dialogTab,
        team: isTeacher ? els.itemTeam.value : '',
        person: (isTeacher && els.itemTeam.value === TEAM_WOLKO) ? els.itemPerson.value.trim() : '',
        campIds,
        title: els.itemTitle.value.trim(),
        url: els.itemUrl.value.trim(),
        bgmUrl: hasBgm ? els.itemBgmUrl.value.trim() : '',
      };
      if (!payload.campIds.length || !payload.title || !payload.url) {
        els.itemDialogError.textContent = tr('validationError');
        return;
      }
      if (isTeacher && !payload.team) {
        els.itemDialogError.textContent = tr('validationErrorTeam');
        return;
      }
      if (isTeacher && payload.team === TEAM_WOLKO && !payload.person) {
        els.itemDialogError.textContent = tr('validationErrorPerson');
        return;
      }
      els.itemDialogSaveBtn.disabled = true;
      try {
        const res = await fetch('/api/teach/data', {
          method: editingItemId ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ item: payload }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          token = '';
          exitEditMode();
          els.itemDialogBackdrop.hidden = true;
          els.loginError.textContent = tr('loginFailed');
          els.loginScreen.hidden = false;
          return;
        }
        if (!res.ok) throw new Error(data.error || tr('saveFailed'));
        items = data.items;
        els.itemDialogBackdrop.hidden = true;
        render();
      } catch (error) {
        els.itemDialogError.textContent = error.message;
      } finally {
        els.itemDialogSaveBtn.disabled = false;
      }
    }
    els.itemDialogSaveBtn.addEventListener('click', saveItemFromDialog);

    async function uploadFile(file, kind, extRegex, targetInput, btnEl) {
      const MAX_SIZE = 20 * 1024 * 1024;
      if (!extRegex.test(file.name)) {
        els.itemDialogError.textContent = tr(kind === 'bgm' ? 'uploadBadTypeBgm' : 'uploadBadType');
        return;
      }
      if (file.size > MAX_SIZE) {
        els.itemDialogError.textContent = tr('uploadTooBig');
        return;
      }
      els.itemDialogError.textContent = '';
      const originalLabel = btnEl.textContent;
      btnEl.disabled = true;
      btnEl.textContent = tr('uploading');
      try {
        const form = new FormData();
        form.append('file', file);
        form.append('kind', kind);
        const res = await fetch('/api/teach/upload', {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}` },
          body: form,
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || tr('uploadFailed'));
        targetInput.value = data.url;
        if (kind === 'presentation' && !els.itemTitle.value.trim()) {
          els.itemTitle.value = file.name.replace(/\.(pdf|pptx|png|jpe?g|webp|gif|heic|heif)$/i, '');
        }
      } catch (error) {
        els.itemDialogError.textContent = error.message;
      } finally {
        btnEl.disabled = false;
        btnEl.textContent = originalLabel;
      }
    }

    els.uploadFileBtn.addEventListener('click', () => els.uploadFileInput.click());
    els.uploadFileInput.addEventListener('change', async () => {
      const file = els.uploadFileInput.files?.[0];
      els.uploadFileInput.value = '';
      if (!file) return;
      await uploadFile(file, 'presentation', /\.(pdf|pptx|png|jpe?g|webp|gif|heic|heif)$/i, els.itemUrl, els.uploadFileBtn);
    });

    els.uploadBgmBtn.addEventListener('click', () => els.uploadBgmInput.click());
    els.uploadBgmInput.addEventListener('change', async () => {
      const file = els.uploadBgmInput.files?.[0];
      els.uploadBgmInput.value = '';
      if (!file) return;
      await uploadFile(file, 'bgm', /\.(mp3|wav|m4a)$/i, els.itemBgmUrl, els.uploadBgmBtn);
    });

    async function confirmDeleteItem(itemId) {
      if (!confirm(tr('deleteConfirm'))) return;
      try {
        const res = await fetch(`/api/teach/data?id=${encodeURIComponent(itemId)}`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${token}` },
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          token = '';
          exitEditMode();
          els.loginError.textContent = tr('loginFailed');
          els.loginScreen.hidden = false;
          return;
        }
        if (!res.ok) throw new Error(data.error || tr('deleteFailed'));
        items = data.items;
        render();
      } catch (error) {
        alert(error.message);
      }
    }

    els.langToggle.addEventListener('click', () => setLanguage(currentLang === 'ko' ? 'en' : 'ko'));
    els.installGuideClose.addEventListener('click', () => { els.installGuide.hidden = true; });
    els.installGuide.addEventListener('click', event => {
      if (event.target === els.installGuide) els.installGuide.hidden = true;
    });
    els.installBtn.addEventListener('click', async () => {
      if (deferredInstallPrompt) {
        deferredInstallPrompt.prompt();
        const choice = await deferredInstallPrompt.userChoice;
        if (choice.outcome === 'accepted') {
          deferredInstallPrompt = null;
          els.installBtn.hidden = true;
        }
        return;
      }
      updateInstallGuideText();
      els.installGuide.hidden = false;
    });

    window.addEventListener('beforeinstallprompt', event => {
      event.preventDefault();
      deferredInstallPrompt = event;
      if (!isStandalone) els.installBtn.hidden = false;
    });
    window.addEventListener('appinstalled', () => {
      deferredInstallPrompt = null;
      els.installBtn.hidden = true;
    });

    async function loadCamps() {
      const res = await fetch('/api/teach/camps');
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || tr('campLoadFailed'));
      camps = Array.isArray(data.camps) ? data.camps : [];
      defaultCampId = data.defaultCampId || '';
      applyDefaultCampSelection();
    }

    async function loadItems() {
      const res = await fetch('/api/teach/data');
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const err = new Error(data.error || tr('loadFailed'));
        err.isStandard = !data.error;
        throw err;
      }
      items = Array.isArray(data.items) ? data.items : [];
      render();
      els.loadErrorBanner.hidden = true;
    }

    function renderCampManageList() {
      const years = sortedYears();
      els.campManageList.innerHTML = years.flatMap(year =>
        ['summer', 'winter'].flatMap(season =>
          campsForYearSeason(year, season).map(c => `
            <div class="camp-manage-row">
              <span class="camp-manage-row-label">${escapeHtml(year)} ${escapeHtml(season === 'summer' ? tr('summer') : tr('winter'))} · ${escapeHtml(c.name)}</span>
              <div class="camp-manage-actions">
                ${c.id === defaultCampId
                  ? `<span class="camp-default-badge">${escapeHtml(tr('defaultCamp'))}</span>`
                  : `<button type="button" data-default-camp="${escapeHtml(c.id)}">${escapeHtml(tr('setDefaultCamp'))}</button>`}
                <button class="danger" type="button" data-delete-camp="${escapeHtml(c.id)}">${escapeHtml(tr('delete'))}</button>
              </div>
            </div>`)
        )
      ).join('') || `<div class="empty" style="grid-column:auto;">${escapeHtml(tr('noCamps'))}</div>`;
    }

    els.campManageBtn.addEventListener('click', () => {
      els.campManageError.textContent = '';
      renderCampManageList();
      els.campManageBackdrop.hidden = false;
    });
    els.campManageCloseBtn.addEventListener('click', () => { els.campManageBackdrop.hidden = true; });

    els.newCampSeasonToggle.addEventListener('click', event => {
      const btn = event.target.closest('.season-toggle-btn');
      if (!btn) return;
      els.newCampSeasonToggle.querySelectorAll('.season-toggle-btn').forEach(b => b.classList.toggle('active', b === btn));
    });

    els.addCampBtn.addEventListener('click', async () => {
      const year = els.newCampYear.value.trim();
      const season = els.newCampSeasonToggle.querySelector('.season-toggle-btn.active')?.dataset.season || 'summer';
      const name = els.newCampName.value.trim();
      if (!year || !name) {
        els.campManageError.textContent = tr('campFieldsRequired');
        return;
      }
      els.addCampBtn.disabled = true;
      try {
        const res = await fetch('/api/teach/camps', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ year, season, name }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || tr('campSaveFailed'));
        camps = data.camps;
        defaultCampId = data.defaultCampId || defaultCampId;
        els.newCampYear.value = '';
        els.newCampName.value = '';
        els.campManageError.textContent = '';
        renderCampManageList();
        render();
      } catch (error) {
        els.campManageError.textContent = error.message;
      } finally {
        els.addCampBtn.disabled = false;
      }
    });

    els.campManageList.addEventListener('click', async event => {
      const defaultBtn = event.target.closest('[data-default-camp]');
      if (defaultBtn) {
        try {
          const res = await fetch('/api/teach/camps', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
            body: JSON.stringify({ action: 'setDefault', id: defaultBtn.dataset.defaultCamp }),
          });
          const data = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(data.error || tr('defaultCampSaveFailed'));
          camps = data.camps;
          defaultCampId = data.defaultCampId || '';
          selectedCampId = defaultCampId || selectedCampId;
          renderCampManageList();
          render();
        } catch (error) {
          alert(error.message);
        }
        return;
      }
      const btn = event.target.closest('[data-delete-camp]');
      if (!btn) return;
      if (!confirm(tr('campDeleteConfirm'))) return;
      try {
        const res = await fetch(`/api/teach/camps?id=${encodeURIComponent(btn.dataset.deleteCamp)}`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${token}` },
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || tr('campDeleteFailed'));
        camps = data.camps;
        if (defaultCampId && !campById(defaultCampId)) defaultCampId = data.defaultCampId || '';
        renderCampManageList();
        render();
      } catch (error) {
        alert(error.message);
      }
    });

    async function bootstrapData() {
      try {
        await loadCamps();
        render();
      } catch (error) {
        loadErrorIsStandard = false;
        els.loadErrorBanner.textContent = error.message || tr('campLoadFailed');
        els.loadErrorBanner.hidden = false;
      }
      try {
        await loadItems();
      } catch (error) {
        loadErrorIsStandard = !!error.isStandard;
        els.loadErrorBanner.textContent = error.message || tr('loadFailed');
        els.loadErrorBanner.hidden = false;
      }
    }

    applyLanguage();
    render();
    bootstrapData();
    if (token) enterEditMode();
    if (!isStandalone) {
      els.installBtn.hidden = false;
    }
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/camp-resources-sw.js', { scope: '/camp-resources' })
          .catch(error => console.warn('Camp resources SW registration failed:', error));
      });
    }
  </script>
</body>
</html>
