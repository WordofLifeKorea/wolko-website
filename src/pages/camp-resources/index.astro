---
const pageTitle = 'WOLKO Camp Resources';
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,nofollow">
  <title>{pageTitle}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800;900&family=Noto+Sans+KR:wght@400;500;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolko-auth.css?v=1">
  <style is:global>
    :root {
      --blue:#004f68;
      --blue-lt:#0077a3;
      --teal:#009b94;
      --bg:#f4f6f8;
      --card:#fff;
      --border:#e4eaee;
      --text:#1a2d38;
      --muted:#6c8290;
      --light:#8fa8b5;
      --red:#c42a36;
      --green:#239c5d;
      --orange:#d9870d;
      --shadow:0 2px 12px rgba(0,79,104,.05);
      --shadow-card:0 10px 28px rgba(0,79,104,.07);
      --shadow-soft:0 4px 14px rgba(0,79,104,.045);
      --radius-lg:20px;
      --radius-md:14px;
      --radius-sm:12px;
      --space-page:28px;
      --space-card:20px;
      --sans:'Montserrat',sans-serif;
      --body:'Noto Sans KR',sans-serif;
    }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; background:var(--bg); color:var(--text); font-family:var(--body); line-height:1.5; }
    button,input,select,textarea { font:500 13px/1.35 var(--body); }
    button { cursor:pointer; }
    .login-screen {
      position:fixed; inset:0; z-index:1000; display:flex; align-items:center; justify-content:center; padding:20px;
      background:linear-gradient(145deg,#003d52,#00627f);
    }
    .login-screen[hidden] { display:none; }
    .login-card {
      width:min(420px,100%); border-radius:24px; background:#fff; padding:42px 36px 34px; text-align:center;
      box-shadow:0 24px 70px rgba(0,0,0,.24);
    }
    .login-logo { display:flex; align-items:center; justify-content:center; gap:12px; margin-bottom:22px; }
    .login-logo img { height:38px; }
    .login-logo-name { color:var(--blue); font:800 19px/1 var(--sans); letter-spacing:.02em; }
    .login-title { margin:0 0 26px; color:var(--muted); font-size:13px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; }
    .login-input { width:100%; height:52px; border:1.5px solid #d7e2e7; border-radius:14px; padding:0 16px; outline:none; }
    .login-input:focus { border-color:var(--blue); }
    .login-error { min-height:20px; margin:10px 0 14px; color:var(--red); font-size:12px; font-weight:500; }
    .login-btn,.primary {
      min-height:40px; border:0; border-radius:var(--radius-sm); background:var(--blue); color:#fff; padding:10px 18px;
      font-weight:700; letter-spacing:.01em; transition:background .18s ease,transform .12s ease,box-shadow .18s ease;
    }
    .login-btn { width:100%; height:48px; }
    .login-btn:hover,.primary:hover { background:var(--blue-lt); }
    .secondary,.ghost {
      min-height:40px; border:1px solid #d7e4e9; border-radius:var(--radius-sm); background:#fff; color:var(--blue);
      padding:9px 14px; font-weight:600; letter-spacing:.01em; transition:border-color .18s ease,background .18s ease,color .18s ease;
    }
    .ghost { background:#f8fbfc; color:var(--muted); }
    .secondary:hover,.ghost:hover { border-color:#b8d6df; background:#f7fbfd; color:var(--blue); }
    .danger { color:var(--red); border-color:#f1c9cf; background:#fff8f9; }
    .topbar {
      position:sticky; top:0; z-index:50; min-height:64px; display:flex; align-items:center; justify-content:space-between; gap:18px;
      padding:10px 32px; background:var(--blue); color:#fff; box-shadow:0 2px 12px rgba(0,79,104,.25); flex-wrap:wrap;
    }
    .brand { display:flex; align-items:center; gap:10px; min-width:0; }
    .brand img { height:30px; flex:0 0 auto; }
    .brand h1 { margin:0; color:rgba(255,255,255,.92); font:700 14px/1 var(--sans); letter-spacing:.04em; }
    .brand p { margin:3px 0 0; color:rgba(255,255,255,.62); font:500 10px/1 var(--sans); letter-spacing:.08em; text-transform:uppercase; }
    .toolbar { display:flex; align-items:center; justify-content:flex-end; gap:8px; flex-wrap:wrap; min-width:0; }
    .toolbar button { min-height:34px; border:1px solid rgba(255,255,255,.25); border-radius:100px; padding:6px 14px; background:rgba(255,255,255,.15); color:#fff; font-size:12px; font-weight:600; }
    .lang-toggle {
      display:flex; align-items:center; position:relative; width:64px; height:26px;
      background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.3); border-radius:999px; padding:2px; cursor:pointer;
    }
    .lang-slider {
      position:absolute; left:2px; width:30px; height:22px; background:#fff; border-radius:999px;
      transition:left .25s cubic-bezier(.4,0,.2,1); box-shadow:0 1px 8px rgba(0,0,0,.18);
    }
    .lang-side { display:flex; align-items:center; justify-content:center; width:30px; z-index:2; transition:opacity .2s; }
    .lang-side img { width:18px; height:13px; object-fit:cover; border-radius:2px; }
    .lang-side span { display:none; }
    .lang-side.is-inactive { opacity:.6; }
    .page { max-width:min(1100px,calc(100vw - 32px)); margin:0 auto; padding:var(--space-page) 18px 90px; }
    .hero {
      margin-bottom:20px; padding:24px; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--card); box-shadow:var(--shadow-card);
    }
    .hero h2 { margin:0; color:var(--text); font:900 clamp(20px,3vw,26px)/1.18 var(--sans); letter-spacing:-.02em; }
    .hero p { margin:9px 0 0; max-width:780px; color:var(--muted); font-size:13.5px; line-height:1.7; font-weight:400; }
    .main-tabs { display:flex; gap:0; border:1px solid var(--border); border-radius:999px; padding:4px; background:#fff; width:fit-content; max-width:100%; overflow-x:auto; margin-bottom:18px; box-shadow:var(--shadow-soft); }
    .main-tab-btn { flex:0 0 auto; border-radius:999px; padding:9px 18px; border:0; background:transparent; color:var(--muted); font:700 12.5px/1 var(--sans); white-space:nowrap; transition:background .15s,color .15s; }
    .main-tab-btn.active { background:var(--blue); color:#fff; }
    .subject-group { margin-bottom:18px; }
    .tab-head { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; border:1px solid #dbe7ec; border-radius:var(--radius-lg) var(--radius-lg) 0 0; background:linear-gradient(135deg,#fff,#f4fbfd); padding:15px 17px; box-shadow:var(--shadow-soft); }
    .tab-title { color:var(--blue); font:700 16px/1.2 var(--sans); letter-spacing:-.01em; }
    .tab-count { border-radius:999px; background:#e9f8fb; color:var(--blue); padding:6px 11px; font-size:11px; font-weight:500; }
    .subject-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12px; padding:14px; border:1px solid #dbe7ec; border-top:0; border-radius:0 0 var(--radius-md) var(--radius-md); background:#fbfdfe; }
    @media (max-width:520px) { .subject-grid { grid-template-columns:1fr; } }
    .person-columns { display:grid; grid-template-columns:repeat(2,1fr); gap:14px; padding:14px; }
    @media (max-width:640px) { .person-columns { grid-template-columns:1fr; } }
    .person-block { border:1px solid #dbe7ec; border-radius:var(--radius-md); overflow:hidden; box-shadow:var(--shadow-soft); }
    .person-block .tab-head { border-radius:var(--radius-md) var(--radius-md) 0 0; }
    .person-block .subject-grid { grid-template-columns:1fr; border-radius:0 0 var(--radius-md) var(--radius-md); }
    .present-card { position:relative; display:flex; flex-direction:column; gap:8px; border:1px solid #dbe7ec; border-radius:var(--radius-md); background:#fff; padding:15px 16px; cursor:pointer; box-shadow:var(--shadow-soft); transition:transform .12s,box-shadow .12s; overflow:hidden; }
    .present-card:hover { transform:translateY(-2px); box-shadow:0 10px 22px rgba(0,79,104,.12); }
    .present-card-thumb { margin:-15px -16px 0; aspect-ratio:16/9; background:#f1f5f9; }
    .present-card-thumb img { width:100%; height:100%; object-fit:cover; display:block; }
    .present-card-title { color:var(--text); font-weight:700; font-size:13.5px; line-height:1.4; word-break:keep-all; }
    .present-card-meta { color:var(--muted); font-size:11px; font-weight:500; }
    .bgm-chip { align-self:flex-start; display:inline-flex; align-items:center; gap:4px; border-radius:999px; background:#f0fdfa; color:#0f766e; padding:4px 10px; font-size:11px; font-weight:600; text-decoration:none; }
    .bgm-chip:hover { background:#ccfbf1; }
    .present-card-actions { display:flex; gap:6px; margin-top:4px; }
    .present-card-actions button { flex:1; min-height:30px; border-radius:8px; padding:0 8px; font-size:11px; font-weight:600; border:1px solid #dbe7ec; background:#f8fafc; color:var(--text); }
    .present-card-actions button.danger { color:var(--red); border-color:#f1c9cf; background:#fff8f9; }
    .present-card-add { align-items:center; justify-content:center; color:var(--muted); border-style:dashed; font-weight:700; cursor:pointer; box-shadow:none; }
    .present-card-add:hover { color:var(--blue); border-color:var(--blue); background:#f4fbfd; }
    .empty { padding:24px; border:1px dashed #ccdce3; border-radius:var(--radius-md); color:var(--light); text-align:center; font-weight:400; background:#fff; grid-column:1/-1; }
    .session-select-wrap { display:flex; align-items:center; gap:10px; margin-bottom:18px; }
    .session-select-wrap[hidden] { display:none; }
    .session-select-wrap label { color:var(--muted); font:700 12px/1 var(--sans); letter-spacing:.02em; }
    .session-select-wrap select { min-height:38px; border:1px solid var(--border); border-radius:var(--radius-sm); padding:0 12px; background:#fff; color:var(--text); font:600 13px/1 var(--body); box-shadow:var(--shadow-soft); cursor:pointer; }
    .field { display:grid; gap:6px; margin-bottom:14px; }
    .field label { color:var(--muted); font-size:11.5px; font-weight:700; letter-spacing:.02em; }
    .field input,.field select { min-height:42px; border:1px solid #d7e2e7; border-radius:10px; padding:0 12px; outline:none; background:#fff; color:var(--text); }
    .field input:focus,.field select:focus { border-color:var(--blue); }
    .field-divider { height:1px; background:var(--border); margin:16px 0; }
    .tch-dialog-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.45); z-index:999; display:flex; align-items:center; justify-content:center; padding:20px; }
    .tch-dialog-backdrop[hidden] { display:none; }
    .tch-dialog { background:#fff; border-radius:16px; padding:26px 26px 20px; max-width:400px; width:100%; box-shadow:0 8px 40px rgba(0,0,0,.18); max-height:90vh; overflow-y:auto; }
    .tch-dialog-title { font:700 16px/1.3 var(--sans); color:var(--blue); margin-bottom:16px; }
    .tch-dialog-error { min-height:18px; color:var(--red); font-size:12px; font-weight:500; margin-bottom:8px; }
    .tch-dialog-btns { display:flex; gap:8px; justify-content:flex-end; margin-top:6px; }
    .tch-dialog-btns button { border-radius:100px; padding:9px 20px; font:600 13px/1 var(--sans); cursor:pointer; border:1px solid transparent; }
    .upload-placeholder-btn { width:100%; margin-bottom:14px; }
    .upload-placeholder-btn[disabled] { opacity:.55; cursor:not-allowed; }
    .load-error-banner { margin-bottom:16px; padding:12px 16px; border:1px solid #f1c9cf; border-radius:var(--radius-md); background:#fff8f9; color:var(--red); font-size:12.5px; }
    .load-error-banner[hidden] { display:none; }
  </style>
</head>
<body>
  <div class="login-screen" id="loginScreen" hidden>
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
        </div>
      </div>
      <p class="login-title" data-ko="편집 모드 로그인" data-en="Edit Mode Login">편집 모드 로그인</p>
      <input class="login-input" id="passwordInput" type="password" data-ph-ko="공유 비밀번호" data-ph-en="Shared password" placeholder="공유 비밀번호" autocomplete="current-password">
      <p class="login-error" id="loginError"></p>
      <button class="login-btn" id="loginBtn" type="button" data-ko="확인" data-en="Confirm">확인</button>
      <button class="ghost" id="loginCancelBtn" type="button" style="width:100%;margin-top:10px;" data-ko="취소" data-en="Cancel">취소</button>
    </div>
  </div>

  <header class="topbar">
    <div class="brand">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <div>
        <h1 data-ko="캠프 자료실" data-en="Camp Resources">캠프 자료실</h1>
        <p data-ko="캠프 자료 모음" data-en="Camp Resource Hub">캠프 자료 모음</p>
      </div>
    </div>
    <div class="toolbar">
      <div class="lang-toggle" id="langToggle">
        <div class="lang-slider" id="langSlider"></div>
        <div class="lang-side is-active" id="langKo"><img src="https://flagcdn.com/w40/kr.png" alt="KR"><span>한국어</span></div>
        <div class="lang-side is-inactive" id="langEn"><img src="https://flagcdn.com/w40/us.png" alt="US"><span>English</span></div>
      </div>
      <button class="secondary" id="editModeBtn" type="button" data-ko="편집 모드" data-en="Edit Mode">편집 모드</button>
      <button class="ghost" id="exitEditBtn" type="button" hidden data-ko="편집 종료" data-en="Exit Edit">편집 종료</button>
    </div>
  </header>

  <main class="page">
    <section class="hero">
      <h2 data-ko="캠프 자료실" data-en="Camp Resources">캠프 자료실</h2>
      <p data-ko="탭을 선택하고 카드를 클릭하면 자료가 새 탭에서 열립니다." data-en="Choose a tab and click a card to open its resource in a new tab.">탭을 선택하고 카드를 클릭하면 자료가 새 탭에서 열립니다.</p>
    </section>

    <div class="main-tabs" id="mainTabs" role="tablist">
      <button class="main-tab-btn" data-tab="teacher" type="button" data-ko="수업자료" data-en="Class Materials">수업자료</button>
      <button class="main-tab-btn" data-tab="program" type="button" data-ko="프로그램팀" data-en="Program Team">프로그램팀</button>
      <button class="main-tab-btn" data-tab="counselor" type="button" data-ko="상담자" data-en="Counselors">상담자</button>
      <button class="main-tab-btn" data-tab="preacher" type="button" data-ko="설교자" data-en="Preachers">설교자</button>
    </div>

    <p class="load-error-banner" id="loadErrorBanner" hidden></p>

    <div class="session-select-wrap" id="sessionSelectWrap" hidden>
      <label for="sessionSelect" data-ko="세션" data-en="Session">세션</label>
      <select id="sessionSelect"></select>
    </div>

    <section id="subjectGroups"></section>
  </main>

  <div class="tch-dialog-backdrop" id="itemDialogBackdrop" hidden>
    <div class="tch-dialog">
      <div class="tch-dialog-title" id="itemDialogTitle" data-ko="자료 추가" data-en="Add Resource">자료 추가</div>
      <div class="field" id="teamFieldWrap">
        <label data-ko="팀" data-en="Team">팀</label>
        <select id="itemTeam">
          <option value="WOLKO">WOLKO</option>
          <option value="Student Fusion Team Projects">Student Fusion Team Projects</option>
        </select>
      </div>
      <div class="field" id="personFieldWrap">
        <label data-ko="이름" data-en="Name">이름</label>
        <input id="itemPerson" type="text" list="personDatalist" data-ph-ko="예: Zach" data-ph-en="e.g. Zach" placeholder="예: Zach">
        <datalist id="personDatalist"></datalist>
      </div>
      <div class="field">
        <label data-ko="세션 (예: 2026 여름캠프)" data-en="Session (e.g. Summer 2026)">세션 (예: 2026 여름캠프)</label>
        <input id="itemSession" type="text">
      </div>
      <div class="field">
        <label data-ko="제목" data-en="Title">제목</label>
        <input id="itemTitle" type="text">
      </div>
      <div class="field">
        <label data-ko="링크 / 파일" data-en="Link / File">링크 / 파일</label>
        <input id="itemUrl" type="url" placeholder="https://www.canva.com/design/...">
      </div>
      <button class="ghost upload-placeholder-btn" type="button" id="uploadFileBtn" data-ko="파일 업로드 (PDF·PPTX)" data-en="Upload File (PDF/PPTX)">파일 업로드 (PDF·PPTX)</button>
      <input id="uploadFileInput" type="file" accept=".pdf,.pptx" hidden>
      <div class="field" id="bgmFieldWrap">
        <div class="field-divider"></div>
        <label data-ko="BGM 링크 / 파일 (선택)" data-en="BGM Link / File (optional)">BGM 링크 / 파일 (선택)</label>
        <input id="itemBgmUrl" type="url" placeholder="https://...">
        <button class="ghost upload-placeholder-btn" type="button" id="uploadBgmBtn" data-ko="BGM 업로드 (MP3·WAV·M4A)" data-en="Upload BGM (MP3/WAV/M4A)">BGM 업로드 (MP3·WAV·M4A)</button>
        <input id="uploadBgmInput" type="file" accept=".mp3,.wav,.m4a" hidden>
      </div>
      <p class="tch-dialog-error" id="itemDialogError"></p>
      <div class="tch-dialog-btns">
        <button class="secondary" id="itemDialogCancelBtn" type="button" data-ko="취소" data-en="Cancel">취소</button>
        <button class="primary" id="itemDialogSaveBtn" type="button" data-ko="저장" data-en="Save">저장</button>
      </div>
    </div>
  </div>

  <script>
    const TOKEN_KEY = 'wolko_camp_resources_token';
    const LANG_KEY = 'wolko_camp_resources_lang';
    const TAB_KEY = 'wolko_camp_resources_tab';
    const TEAM_WOLKO = 'WOLKO';
    const TEAM_SF = 'Student Fusion Team Projects';
    const TEAMS_ORDER = [TEAM_SF, TEAM_WOLKO];
    const WOLKO_PINNED_PEOPLE = ['Zach', 'Niki', 'Molly', 'Debbie', 'Shannon'];
    const TABS = [
      { key: 'teacher', ko: '수업자료', en: 'Class Materials' },
      { key: 'program', ko: '프로그램팀', en: 'Program Team' },
      { key: 'counselor', ko: '상담자', en: 'Counselors' },
      { key: 'preacher', ko: '설교자', en: 'Preachers' },
    ];
    const DEFAULT_TAB = 'teacher';

    const COPY = {
      ko: {
        noItems: '등록된 자료가 없습니다.',
        addItem: '추가',
        edit: '수정',
        delete: '삭제',
        deleteConfirm: '이 자료를 삭제하시겠습니까?',
        loginFailed: '로그인하지 못했습니다.',
        saveFailed: '저장하지 못했습니다.',
        deleteFailed: '삭제하지 못했습니다.',
        loadFailed: '목록을 불러오지 못했습니다.',
        validationError: '세션, 제목, URL을 모두 입력해주세요.',
        validationErrorTeam: '팀을 선택해주세요.',
        validationErrorPerson: 'WOLKO 팀은 이름을 입력해주세요.',
        addTitle: '자료 추가',
        editTitle: '자료 수정',
        uploading: '업로드 중...',
        uploadFailed: '업로드하지 못했습니다.',
        uploadTooBig: '파일이 너무 큽니다. (최대 20MB)',
        uploadBadType: 'PDF 또는 PPTX 파일만 업로드할 수 있습니다.',
        uploadBadTypeBgm: 'MP3, WAV, M4A 파일만 업로드할 수 있습니다.',
      },
      en: {
        noItems: 'No resources yet.',
        addItem: 'Add',
        edit: 'Edit',
        delete: 'Delete',
        deleteConfirm: 'Delete this resource?',
        loginFailed: 'Login failed.',
        saveFailed: 'Could not save.',
        deleteFailed: 'Could not delete.',
        loadFailed: 'Could not load the list.',
        validationError: 'Please fill in session, title, and URL.',
        validationErrorTeam: 'Please choose a team.',
        validationErrorPerson: 'Please enter a name for the WOLKO team.',
        addTitle: 'Add Resource',
        editTitle: 'Edit Resource',
        uploading: 'Uploading...',
        uploadFailed: 'Upload failed.',
        uploadTooBig: 'File is too large. (max 20MB)',
        uploadBadType: 'Only PDF or PPTX files can be uploaded.',
        uploadBadTypeBgm: 'Only MP3, WAV, or M4A files can be uploaded.',
      },
    };

    let currentLang = localStorage.getItem(LANG_KEY) === 'en' ? 'en' : 'ko';
    function tr(key) {
      return COPY[currentLang][key] ?? COPY.ko[key] ?? key;
    }
    function tabLabel(key) {
      const t = TABS.find(t => t.key === key);
      return t ? (currentLang === 'en' ? t.en : t.ko) : key;
    }

    const els = {
      loginScreen: document.getElementById('loginScreen'),
      passwordInput: document.getElementById('passwordInput'),
      loginBtn: document.getElementById('loginBtn'),
      loginCancelBtn: document.getElementById('loginCancelBtn'),
      loginError: document.getElementById('loginError'),
      langToggle: document.getElementById('langToggle'),
      langSlider: document.getElementById('langSlider'),
      langKo: document.getElementById('langKo'),
      langEn: document.getElementById('langEn'),
      editModeBtn: document.getElementById('editModeBtn'),
      exitEditBtn: document.getElementById('exitEditBtn'),
      mainTabs: document.getElementById('mainTabs'),
      subjectGroups: document.getElementById('subjectGroups'),
      sessionSelectWrap: document.getElementById('sessionSelectWrap'),
      sessionSelect: document.getElementById('sessionSelect'),
      loadErrorBanner: document.getElementById('loadErrorBanner'),
      itemDialogBackdrop: document.getElementById('itemDialogBackdrop'),
      itemDialogTitle: document.getElementById('itemDialogTitle'),
      teamFieldWrap: document.getElementById('teamFieldWrap'),
      itemTeam: document.getElementById('itemTeam'),
      personFieldWrap: document.getElementById('personFieldWrap'),
      itemPerson: document.getElementById('itemPerson'),
      personDatalist: document.getElementById('personDatalist'),
      itemSession: document.getElementById('itemSession'),
      itemTitle: document.getElementById('itemTitle'),
      itemUrl: document.getElementById('itemUrl'),
      itemDialogError: document.getElementById('itemDialogError'),
      itemDialogCancelBtn: document.getElementById('itemDialogCancelBtn'),
      itemDialogSaveBtn: document.getElementById('itemDialogSaveBtn'),
      uploadFileBtn: document.getElementById('uploadFileBtn'),
      uploadFileInput: document.getElementById('uploadFileInput'),
      bgmFieldWrap: document.getElementById('bgmFieldWrap'),
      itemBgmUrl: document.getElementById('itemBgmUrl'),
      uploadBgmBtn: document.getElementById('uploadBgmBtn'),
      uploadBgmInput: document.getElementById('uploadBgmInput'),
    };

    let items = [];
    let selectedSession = '';
    let currentTab = TABS.some(t => t.key === localStorage.getItem(TAB_KEY)) ? localStorage.getItem(TAB_KEY) : DEFAULT_TAB;
    let dialogTab = DEFAULT_TAB;
    let editMode = false;
    let token = localStorage.getItem(TOKEN_KEY) || '';
    let editingItemId = '';

    function escapeHtml(value) {
      return String(value ?? '').replace(/[&<>"']/g, ch => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[ch]));
    }

    function applyLanguage() {
      document.documentElement.lang = currentLang;
      document.querySelectorAll('[data-ko][data-en]').forEach(el => {
        el.textContent = el.dataset[currentLang];
      });
      document.querySelectorAll('[data-ph-ko][data-ph-en]').forEach(el => {
        el.placeholder = el.dataset[`ph${currentLang === 'ko' ? 'Ko' : 'En'}`] || '';
      });
      document.querySelectorAll('option[data-ko][data-en]').forEach(option => {
        option.textContent = option.dataset[currentLang];
      });
      updateLangToggleUI();
    }

    function updateLangToggleUI() {
      const isEn = currentLang === 'en';
      els.langKo.className = isEn ? 'lang-side is-inactive' : 'lang-side is-active';
      els.langEn.className = isEn ? 'lang-side is-active' : 'lang-side is-inactive';
      const sliderW = els.langSlider.offsetWidth || 30;
      els.langSlider.style.left = isEn ? `${els.langToggle.offsetWidth - sliderW - 2}px` : '2px';
    }

    let loadErrorIsStandard = false;

    function setLanguage(lang) {
      currentLang = lang === 'en' ? 'en' : 'ko';
      localStorage.setItem(LANG_KEY, currentLang);
      applyLanguage();
      if (loadErrorIsStandard && !els.loadErrorBanner.hidden) {
        els.loadErrorBanner.textContent = tr('loadFailed');
      }
      if (editingItemId !== '' || !els.itemDialogBackdrop.hidden) {
        els.itemDialogTitle.textContent = editingItemId ? tr('editTitle') : tr('addTitle');
      }
      render();
    }

    function groupBySession(list) {
      const sessions = {};
      list.forEach(item => {
        (sessions[item.session] || (sessions[item.session] = [])).push(item);
      });
      return sessions;
    }

    function sortedSessionNames(sessions) {
      return Object.keys(sessions)
        .map(name => ({ name, time: Math.max(...sessions[name].map(i => new Date(i.createdAt).getTime() || 0)) }))
        .sort((a, b) => b.time - a.time)
        .map(s => s.name);
    }

    function latestSessionName(sessions) {
      return sortedSessionNames(sessions)[0] || '';
    }

    function presentCardHtml(item) {
      return `
        <div class="present-card" data-open-url="${escapeHtml(item.url)}" data-item-id="${escapeHtml(item.id)}">
          ${item.thumbnailUrl ? `<div class="present-card-thumb"><img src="${escapeHtml(item.thumbnailUrl)}" alt="" loading="lazy"></div>` : ''}
          <div class="present-card-title">${escapeHtml(item.title)}</div>
          <div class="present-card-meta">${escapeHtml(item.session)}</div>
          ${item.bgmUrl ? `<a class="bgm-chip" href="${escapeHtml(item.bgmUrl)}" target="_blank" rel="noopener" data-stop>🎵 BGM</a>` : ''}
          ${editMode ? `
            <div class="present-card-actions" data-stop>
              <button type="button" data-edit-item="${escapeHtml(item.id)}">${escapeHtml(tr('edit'))}</button>
              <button type="button" class="danger" data-delete-item="${escapeHtml(item.id)}">${escapeHtml(tr('delete'))}</button>
            </div>` : ''}
        </div>`;
    }

    function addButtonHtml(defaults) {
      const attrs = Object.entries(defaults)
        .filter(([, v]) => v)
        .map(([k, v]) => `data-add-${k}="${escapeHtml(v)}"`)
        .join(' ');
      return `<button class="present-card present-card-add" ${attrs} type="button">+ ${escapeHtml(tr('addItem'))}</button>`;
    }

    function personGroupHtml(person, personItems) {
      return `
        <div class="person-block">
          <div class="tab-head">
            <div class="tab-title" style="font-size:13px;">${escapeHtml(person)}</div>
            <div class="tab-count">${personItems.length}</div>
          </div>
          <div class="subject-grid">
            ${personItems.length ? personItems.map(presentCardHtml).join('') : `<div class="empty">${escapeHtml(tr('noItems'))}</div>`}
            ${editMode ? addButtonHtml({ tab: 'teacher', team: TEAM_WOLKO, person }) : ''}
          </div>
        </div>`;
    }

    function groupByPerson(list) {
      const groups = {};
      list.forEach(item => {
        const p = item.person || '';
        (groups[p] || (groups[p] = [])).push(item);
      });
      return groups;
    }

    function wolkoTeamHtml(teamItems, { pinPeople }) {
      const byPerson = groupByPerson(teamItems);
      const extra = Object.keys(byPerson).filter(p => p && !WOLKO_PINNED_PEOPLE.includes(p)).sort((a, b) => a.localeCompare(b, 'ko'));
      const names = pinPeople ? [...WOLKO_PINNED_PEOPLE, ...extra] : Object.keys(byPerson).filter(Boolean).sort((a, b) => a.localeCompare(b, 'ko'));
      return `
        <div class="subject-group">
          <div class="tab-head">
            <div class="tab-title">${escapeHtml(TEAM_WOLKO)}</div>
            <div class="tab-count">${teamItems.length}</div>
          </div>
          <div class="person-columns">
            ${names.map(name => personGroupHtml(name, byPerson[name] || [])).join('')}
          </div>
        </div>`;
    }

    function flatListHtml(headerLabel, listItems, addDefaults) {
      return `
        <div class="subject-group">
          <div class="tab-head">
            <div class="tab-title">${escapeHtml(headerLabel)}</div>
            <div class="tab-count">${listItems.length}</div>
          </div>
          <div class="subject-grid">
            ${listItems.length ? listItems.map(presentCardHtml).join('') : `<div class="empty">${escapeHtml(tr('noItems'))}</div>`}
            ${editMode ? addButtonHtml(addDefaults) : ''}
          </div>
        </div>`;
    }

    function groupByTeam(list) {
      const groups = {};
      list.forEach(item => {
        (groups[item.team] || (groups[item.team] = [])).push(item);
      });
      return groups;
    }

    function renderMainTabs() {
      els.mainTabs.querySelectorAll('.main-tab-btn').forEach(btn => {
        btn.classList.toggle('active', btn.dataset.tab === currentTab);
      });
    }

    function renderSessionSelect() {
      const sessions = groupBySession(items);
      const names = sortedSessionNames(sessions);
      if (!names.includes(selectedSession)) selectedSession = names[0] || '';
      els.sessionSelectWrap.hidden = names.length === 0;
      els.sessionSelect.innerHTML = names.map(name => `<option value="${escapeHtml(name)}">${escapeHtml(name)}</option>`).join('');
      els.sessionSelect.value = selectedSession;
    }

    function renderCategoryGroups() {
      const sessionItems = items.filter(i => i.session === selectedSession && i.tab === currentTab);
      if (currentTab === 'teacher') {
        const byTeam = groupByTeam(sessionItems);
        els.subjectGroups.innerHTML = TEAMS_ORDER.map(team => {
          return team === TEAM_WOLKO
            ? wolkoTeamHtml(byTeam[team] || [], { pinPeople: true })
            : flatListHtml(team, byTeam[team] || [], { tab: 'teacher', team });
        }).join('');
      } else {
        els.subjectGroups.innerHTML = flatListHtml(tabLabel(currentTab), sessionItems, { tab: currentTab });
      }
    }

    function renderPersonDatalist() {
      const existing = new Set(items.filter(i => i.team === TEAM_WOLKO && i.person).map(i => i.person));
      const names = [...new Set([...WOLKO_PINNED_PEOPLE, ...existing])];
      els.personDatalist.innerHTML = names.map(name => `<option value="${escapeHtml(name)}"></option>`).join('');
    }

    function render() {
      renderMainTabs();
      renderSessionSelect();
      renderCategoryGroups();
      renderPersonDatalist();
    }

    function currentLatestSessionLabel() {
      return selectedSession || '';
    }

    document.querySelector('main.page').addEventListener('click', event => {
      if (event.target.closest('[data-stop]')) {
        const editBtn = event.target.closest('[data-edit-item]');
        if (editBtn) { openItemDialog(editBtn.dataset.editItem); return; }
        const delBtn = event.target.closest('[data-delete-item]');
        if (delBtn) { confirmDeleteItem(delBtn.dataset.deleteItem); return; }
        return;
      }
      const addBtn = event.target.closest('[data-add-tab]');
      if (addBtn) {
        openItemDialog('', {
          tab: addBtn.dataset.addTab,
          team: addBtn.dataset.addTeam || '',
          person: addBtn.dataset.addPerson || '',
        });
        return;
      }
      const card = event.target.closest('[data-open-url]');
      if (card) window.open(card.dataset.openUrl, '_blank', 'noopener');
    });

    els.mainTabs.addEventListener('click', event => {
      const btn = event.target.closest('.main-tab-btn');
      if (!btn) return;
      currentTab = btn.dataset.tab;
      localStorage.setItem(TAB_KEY, currentTab);
      renderMainTabs();
      renderCategoryGroups();
      renderPersonDatalist();
    });

    els.sessionSelect.addEventListener('change', () => {
      selectedSession = els.sessionSelect.value;
      renderCategoryGroups();
      renderPersonDatalist();
    });

    function enterEditMode() {
      editMode = true;
      els.editModeBtn.hidden = true;
      els.exitEditBtn.hidden = false;
      render();
    }

    function exitEditMode() {
      editMode = false;
      token = '';
      localStorage.removeItem(TOKEN_KEY);
      els.editModeBtn.hidden = false;
      els.exitEditBtn.hidden = true;
      render();
    }

    els.editModeBtn.addEventListener('click', () => {
      if (token) { enterEditMode(); return; }
      els.loginError.textContent = '';
      els.passwordInput.value = '';
      els.loginScreen.hidden = false;
    });
    els.exitEditBtn.addEventListener('click', exitEditMode);
    els.loginCancelBtn.addEventListener('click', () => { els.loginScreen.hidden = true; });

    async function login() {
      els.loginBtn.disabled = true;
      els.loginError.textContent = '';
      try {
        const res = await fetch('/api/teach/auth', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: els.passwordInput.value.trim() }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || tr('loginFailed'));
        token = data.token;
        localStorage.setItem(TOKEN_KEY, token);
        els.loginScreen.hidden = true;
        enterEditMode();
      } catch (error) {
        els.loginError.textContent = error.message;
      } finally {
        els.loginBtn.disabled = false;
      }
    }
    els.loginBtn.addEventListener('click', login);
    els.passwordInput.addEventListener('keydown', event => {
      if (event.key === 'Enter') login();
    });

    function updatePersonFieldVisibility() {
      els.personFieldWrap.hidden = dialogTab !== 'teacher' || els.itemTeam.value !== TEAM_WOLKO;
    }
    els.itemTeam.addEventListener('change', updatePersonFieldVisibility);

    function updateDialogFieldsForTab() {
      els.teamFieldWrap.hidden = dialogTab !== 'teacher';
      updatePersonFieldVisibility();
      els.bgmFieldWrap.hidden = !(dialogTab === 'program' || dialogTab === 'counselor');
    }

    function openItemDialog(itemId, defaults) {
      defaults = defaults || {};
      editingItemId = itemId || '';
      const item = itemId ? items.find(i => i.id === itemId) : null;
      dialogTab = (item && item.tab) || defaults.tab || currentTab;
      els.itemDialogTitle.textContent = itemId ? tr('editTitle') : tr('addTitle');
      els.itemTeam.value = (item && item.team) || defaults.team || TEAM_WOLKO;
      updateDialogFieldsForTab();
      els.itemPerson.value = (item && item.person) || defaults.person || '';
      els.itemSession.value = (item && item.session) || currentLatestSessionLabel();
      els.itemTitle.value = (item && item.title) || '';
      els.itemUrl.value = (item && item.url) || '';
      els.itemBgmUrl.value = (item && item.bgmUrl) || '';
      els.itemDialogError.textContent = '';
      els.itemDialogBackdrop.hidden = false;
    }
    els.itemDialogCancelBtn.addEventListener('click', () => { els.itemDialogBackdrop.hidden = true; });

    async function saveItemFromDialog() {
      const isTeacher = dialogTab === 'teacher';
      const hasBgm = dialogTab === 'program' || dialogTab === 'counselor';
      const payload = {
        id: editingItemId || undefined,
        tab: dialogTab,
        team: isTeacher ? els.itemTeam.value : '',
        person: (isTeacher && els.itemTeam.value === TEAM_WOLKO) ? els.itemPerson.value.trim() : '',
        session: els.itemSession.value.trim(),
        title: els.itemTitle.value.trim(),
        url: els.itemUrl.value.trim(),
        bgmUrl: hasBgm ? els.itemBgmUrl.value.trim() : '',
      };
      if (!payload.session || !payload.title || !payload.url) {
        els.itemDialogError.textContent = tr('validationError');
        return;
      }
      if (isTeacher && !payload.team) {
        els.itemDialogError.textContent = tr('validationErrorTeam');
        return;
      }
      if (isTeacher && payload.team === TEAM_WOLKO && !payload.person) {
        els.itemDialogError.textContent = tr('validationErrorPerson');
        return;
      }
      els.itemDialogSaveBtn.disabled = true;
      try {
        const res = await fetch('/api/teach/data', {
          method: editingItemId ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
          body: JSON.stringify({ item: payload }),
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          token = '';
          exitEditMode();
          els.itemDialogBackdrop.hidden = true;
          els.loginError.textContent = tr('loginFailed');
          els.loginScreen.hidden = false;
          return;
        }
        if (!res.ok) throw new Error(data.error || tr('saveFailed'));
        items = data.items;
        els.itemDialogBackdrop.hidden = true;
        render();
      } catch (error) {
        els.itemDialogError.textContent = error.message;
      } finally {
        els.itemDialogSaveBtn.disabled = false;
      }
    }
    els.itemDialogSaveBtn.addEventListener('click', saveItemFromDialog);

    async function uploadFile(file, kind, extRegex, targetInput, btnEl) {
      const MAX_SIZE = 20 * 1024 * 1024;
      if (!extRegex.test(file.name)) {
        els.itemDialogError.textContent = tr(kind === 'bgm' ? 'uploadBadTypeBgm' : 'uploadBadType');
        return;
      }
      if (file.size > MAX_SIZE) {
        els.itemDialogError.textContent = tr('uploadTooBig');
        return;
      }
      els.itemDialogError.textContent = '';
      const originalLabel = btnEl.textContent;
      btnEl.disabled = true;
      btnEl.textContent = tr('uploading');
      try {
        const form = new FormData();
        form.append('file', file);
        form.append('kind', kind);
        const res = await fetch('/api/teach/upload', {
          method: 'POST',
          headers: { Authorization: `Bearer ${token}` },
          body: form,
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || tr('uploadFailed'));
        targetInput.value = data.url;
        if (kind === 'presentation' && !els.itemTitle.value.trim()) {
          els.itemTitle.value = file.name.replace(/\.(pdf|pptx)$/i, '');
        }
      } catch (error) {
        els.itemDialogError.textContent = error.message;
      } finally {
        btnEl.disabled = false;
        btnEl.textContent = originalLabel;
      }
    }

    els.uploadFileBtn.addEventListener('click', () => els.uploadFileInput.click());
    els.uploadFileInput.addEventListener('change', async () => {
      const file = els.uploadFileInput.files?.[0];
      els.uploadFileInput.value = '';
      if (!file) return;
      await uploadFile(file, 'presentation', /\.(pdf|pptx)$/i, els.itemUrl, els.uploadFileBtn);
    });

    els.uploadBgmBtn.addEventListener('click', () => els.uploadBgmInput.click());
    els.uploadBgmInput.addEventListener('change', async () => {
      const file = els.uploadBgmInput.files?.[0];
      els.uploadBgmInput.value = '';
      if (!file) return;
      await uploadFile(file, 'bgm', /\.(mp3|wav|m4a)$/i, els.itemBgmUrl, els.uploadBgmBtn);
    });

    async function confirmDeleteItem(itemId) {
      if (!confirm(tr('deleteConfirm'))) return;
      try {
        const res = await fetch(`/api/teach/data?id=${encodeURIComponent(itemId)}`, {
          method: 'DELETE',
          headers: { Authorization: `Bearer ${token}` },
        });
        const data = await res.json().catch(() => ({}));
        if (res.status === 401) {
          localStorage.removeItem(TOKEN_KEY);
          token = '';
          exitEditMode();
          els.loginError.textContent = tr('loginFailed');
          els.loginScreen.hidden = false;
          return;
        }
        if (!res.ok) throw new Error(data.error || tr('deleteFailed'));
        items = data.items;
        render();
      } catch (error) {
        alert(error.message);
      }
    }

    els.langToggle.addEventListener('click', () => setLanguage(currentLang === 'ko' ? 'en' : 'ko'));

    async function loadItems() {
      const res = await fetch('/api/teach/data');
      const data = await res.json().catch(() => ({}));
      if (!res.ok) {
        const err = new Error(data.error || tr('loadFailed'));
        err.isStandard = !data.error;
        throw err;
      }
      items = Array.isArray(data.items) ? data.items : [];
      render();
      els.loadErrorBanner.hidden = true;
    }

    applyLanguage();
    render();
    loadItems().catch(error => {
      loadErrorIsStandard = !!error.isStandard;
      els.loadErrorBanner.textContent = error.message || tr('loadFailed');
      els.loadErrorBanner.hidden = false;
    });
    if (token) enterEditMode();
  </script>
</body>
</html>
