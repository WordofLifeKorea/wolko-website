                    <option value="고1">고1 (10th Grade)</option>
                    <option value="고2">고2 (11th Grade)</option>
                    <option value="고3">고3 (12th Grade)</option>
                  </optgroup>
                </select>
              </div>
              <div class="reg-field">
                <label>소속 교회 / Church</label>
                <input id="rChurch" name="church" placeholder="교회 이름 / Church name">
              </div>
              <div class="reg-field">
                <label>학교 / School</label>
                <input id="rSchool" name="school" placeholder="학교 이름 / School name">
              </div>
              <div class="reg-field reg-field--full">
                <label>비상연락처 / Emergency Contact</label>
                <input id="rEmergency" name="emergency" placeholder="보호자 이름 및 연락처 / Parent/Guardian name & phone">
              </div>
              <div class="reg-field reg-field--full">
                <label>특이사항 / Special Notes</label>
                <textarea id="rNotes" name="notes" rows="3" placeholder="알레르기, 건강 상태, 기타 전달사항 / Allergies, health conditions, etc."></textarea>
              </div>
            </div>
          </div>

          <!-- ── 단체 신청 섹션 ── -->
          <div id="sectionGroup" hidden>
            <div class="reg-group-notice">
              <div class="reg-group-notice-icon">✉</div>
              <div>
                <strong class="wl-ko">단체 신청 안내</strong>
                <strong class="wl-en">Group Registration Info</strong>
                <p class="wl-ko">담당자 정보와 신청 인원만 입력해 주세요.<br>접수 완료 후 <em>담당자 이메일로 개인별 신청서</em>를 보내주시면 최종 확인 처리해 드립니다.</p>
                <p class="wl-en">Enter the contact person's info and group size.<br>After submission, please <em>send individual details to our email</em> for final confirmation.</p>
              </div>
            </div>
            <div class="reg-form-grid">
              <div class="reg-field">
                <label>담당자 이름 / Contact Name <span class="req">*</span></label>
                <input id="gName" name="gName" placeholder="홍길동 / Contact Person">
              </div>
              <div class="reg-field">
                <label>연락처 / Phone <span class="req">*</span></label>
                <input id="gPhone" name="gPhone" placeholder="010-0000-0000">
              </div>
              <div class="reg-field">
                <label>이메일 / Email <span class="req">*</span></label>
                <input id="gEmail" name="gEmail" type="email" placeholder="email@example.com">
              </div>
              <div class="reg-field">
                <label>신청 인원 / Group Size <span class="req">*</span></label>
                <select id="gCount" name="gCount">
                  <option value="">선택 / Select</option>
                  {Array.from({length: 49}, (_, i) => i + 2).map(n => (
                    <option value={n}>{n}명 / {n} people</option>
                  ))}
                </select>
              </div>
              <div class="reg-field reg-field--full">
                <label>소속 교회 / 단체 <span class="req">*</span></label>
                <input id="gOrg" name="gOrg" placeholder="교회 또는 단체 이름 / Church or Organization">
              </div>
              <div class="reg-field reg-field--full">
                <label>전달 사항 / Notes</label>
                <textarea id="gNotes" name="gNotes" rows="3" placeholder="캠프 관련 문의 또는 요청 사항 / Questions or special requests"></textarea>
              </div>
            </div>
            <div class="reg-email-target">
              <span class="wl-ko">📧 개인별 신청서 제출 이메일</span>
              <span class="wl-en">📧 Send individual forms to</span>
              <strong>wolkorea1@gmail.com</strong>
            </div>
          </div>

          <!-- 개인정보 동의 -->
          <label class="reg-consent">
            <input type="checkbox" id="rConsent">
            <span>
              <strong>개인정보 수집 및 이용에 동의합니다.</strong><br>
              수집 항목: 이름, 연락처, 이메일 · 목적: 캠프 신청 접수 및 안내 · 보유기간: 캠프 종료 후 1년<br>
              <em style="color:#8fa8b8;font-size:11px;">I agree to the collection and use of personal information for camp registration.</em>
            </span>
          </label>

          <button type="submit" class="reg-submit" id="regSubmitBtn">
            <div class="spinner"></div>
            <span class="reg-submit-label">
              <span class="wl-ko">신청 완료하기</span>
              <span class="wl-en">Submit Registration</span>
            </span>
          </button>
          <div class="reg-error-msg" id="regErrorMsg" hidden></div>
        </form>
      </div>

      <!-- 성공 화면 -->
      <div class="reg-success-wrap" id="regSuccessWrap" hidden>
        <div class="reg-success-icon">✓</div>
        <div class="reg-success-title" id="regSuccessTitle">
          <span class="wl-ko">신청이 완료되었습니다!</span>
          <span class="wl-en">Registration Complete!</span>
        </div>
        <p class="reg-success-sub" id="regSuccessMsg"></p>
        <p class="reg-success-count" id="regSuccessCount"></p>
        <div class="reg-success-contact">
          <span class="wl-ko">추가 문의</span><span class="wl-en">Questions</span>
          <strong>031-611-9216 &nbsp;·&nbsp; wolkorea1@gmail.com</strong>
        </div>
        <button class="reg-success-close" id="regSuccessClose">
          <span class="wl-ko">닫기</span><span class="wl-en">Close</span>
        </button>
      </div>
    </div>
  </div>

</div><!-- /.wcp-wrap -->

<script>
/* ── reveal 애니메이션 ── */
var obs = new IntersectionObserver(function(entries) {
  entries.forEach(function(e) {
    if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
  });
}, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
document.querySelectorAll('.wcp-wrap .reveal').forEach(function(el) { obs.observe(el); });

/* ── 언어 감지 헬퍼 ── */
function getIsEn() {
  var langEl = document.getElementById('lang-root');
  return !!(langEl && langEl.classList.contains('lang-en'));
}

/* ── 정원 현황 바 업데이트 ── */
function updateCapBar(el, count, capacity) {
  var fill = el.querySelector('.reg-cap-fill');
  var countEl = el.querySelector('.reg-cap-count');
  var pct = capacity > 0 ? Math.min((count / capacity) * 100, 100) : 0;
  if (countEl) countEl.textContent = count;
  if (fill) {
    fill.style.width = pct + '%';
    fill.className = 'reg-cap-fill' + (pct >= 100 ? ' full' : pct >= 75 ? ' warn' : '');
  }
}

async function loadCapacities() {
  var cards = document.querySelectorAll('[data-cap-id]');
  await Promise.all(Array.from(cards).map(async function(el) {
    var campId = el.dataset.capId;
    var btn = document.querySelector('.reg-open-btn[data-camp-id="' + campId + '"]');
    var cap = btn ? parseInt(btn.dataset.capacity) || 40 : 40;
    try {
      var res = await fetch('/api/capacity/' + campId);
      if (res.ok) {
        var data = await res.json();
        updateCapBar(el, data.count, cap);
        if (data.count >= cap && btn) {
          btn.disabled = true;
          btn.innerHTML = '<span class="wl-ko">정원 마감</span><span class="wl-en">Full</span>';
          btn.style.background = 'rgba(100,116,139,0.15)';
          btn.style.color = '#64748b';
          btn.style.cursor = 'default';
        }
      }
    } catch(e) { /* 오류 시 조용히 처리 */ }
  }));
}
loadCapacities();

/* ── 모달 DOM 참조 ── */
var modal = document.getElementById('regModal');
var modalTitle = document.getElementById('regModalTitle');
var modalCapLabel = document.getElementById('regModalCapLabel');
var modalCapFill = document.getElementById('regModalCapFill');
var campIdInput = document.getElementById('regCampId');
var campCapInput = document.getElementById('regCampCap');
var regTypeInput = document.getElementById('regType');
var formWrap = document.getElementById('regFormWrap');
var successWrap = document.getElementById('regSuccessWrap');
var errorMsg = document.getElementById('regErrorMsg');
var submitBtn = document.getElementById('regSubmitBtn');
var sectionIndividual = document.getElementById('sectionIndividual');
var sectionGroup = document.getElementById('sectionGroup');
var tabIndividual = document.getElementById('tabIndividual');
var tabGroup = document.getElementById('tabGroup');

/* ── 모달 정원 바 업데이트 ── */
function updateModalCap(count, capacity) {
  var pct = capacity > 0 ? Math.min((count / capacity) * 100, 100) : 0;
  modalCapLabel.textContent = count + ' / ' + capacity + (getIsEn() ? ' spots' : '명');
  modalCapFill.style.width = pct + '%';
  modalCapFill.className = 'reg-modal-cap-fill' + (pct >= 100 ? ' full' : pct >= 75 ? ' warn' : '');
}

/* ── 탭 전환 ── */
function switchTab(type) {
  regTypeInput.value = type;
  if (type === 'individual') {
    tabIndividual.classList.add('active');
    tabGroup.classList.remove('active');
    sectionIndividual.hidden = false;
    sectionGroup.hidden = true;
  } else {
    tabGroup.classList.add('active');
    tabIndividual.classList.remove('active');
    sectionGroup.hidden = false;
    sectionIndividual.hidden = true;
  }
  errorMsg.hidden = true;
}
tabIndividual.addEventListener('click', function() { switchTab('individual'); });
tabGroup.addEventListener('click', function() { switchTab('group'); });

/* ── 모달 열기 ── */
document.querySelectorAll('.reg-open-btn').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    var campId = this.dataset.campId;
    var nameKo = this.dataset.campNameKo;
    var nameEn = this.dataset.campNameEn;
    var capacity = parseInt(this.dataset.capacity) || 40;

    campIdInput.value = campId;
    campCapInput.value = capacity;
    modalTitle.textContent = getIsEn() ? nameEn : nameKo;

    /* 폼 초기화 */
    document.getElementById('regForm').reset();
    switchTab('individual');
    formWrap.hidden = false;
    successWrap.hidden = true;
    errorMsg.hidden = true;
    submitBtn.disabled = false;
    submitBtn.classList.remove('loading');
    updateModalCap('…', capacity);

    modal.hidden = false;
    document.body.style.overflow = 'hidden';

    /* 실시간 정원 로드 */
    try {
      var res = await fetch('/api/capacity/' + campId);
      if (res.ok) {
        var data = await res.json();
        updateModalCap(data.count, capacity);
        if (data.count >= capacity) {
          submitBtn.disabled = true;
          submitBtn.querySelector('.reg-submit-label').innerHTML =
            '<span>정원이 마감되었습니다 / Registration Full</span>';
        }
      }
    } catch(e) { updateModalCap(0, capacity); }
  });
});

/* ── 모달 닫기 ── */
function closeRegModal() {
  modal.hidden = true;
  document.body.style.overflow = '';
}
document.getElementById('regOverlay').addEventListener('click', closeRegModal);
document.getElementById('regCloseBtn').addEventListener('click', closeRegModal);
document.getElementById('regSuccessClose').addEventListener('click', closeRegModal);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeRegModal(); });

/* ── 폼 제출 ── */
document.getElementById('regForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  errorMsg.hidden = true;

  var consent = document.getElementById('rConsent').checked;
  if (!consent) {
    errorMsg.textContent = '개인정보 수집 및 이용에 동의해 주세요. / Please agree to the privacy policy.';
    errorMsg.hidden = false;
    return;
  }

  var currentType = regTypeInput.value;
  var payload;

  if (currentType === 'group') {
    /* ── 단체 신청 유효성 검사 ── */
    var gName  = document.getElementById('gName').value.trim();
    var gPhone = document.getElementById('gPhone').value.trim();
    var gEmail = document.getElementById('gEmail').value.trim();
    var gCount = document.getElementById('gCount').value;
    var gOrg   = document.getElementById('gOrg').value.trim();

    if (!gName || !gPhone || !gEmail || !gCount || !gOrg) {
      errorMsg.textContent = '담당자 이름, 연락처, 이메일, 인원, 소속은 필수 항목입니다. / Contact name, phone, email, group size, and organization are required.';
      errorMsg.hidden = false;
      return;
    }

    payload = {
      registrationType: 'group',
      campId: campIdInput.value,
      capacity: parseInt(campCapInput.value) || 40,
      name: gName,
      phone: gPhone,
      email: gEmail,
      groupCount: parseInt(gCount),
      church: gOrg,
      notes: document.getElementById('gNotes').value.trim(),
    };

  } else {
    /* ── 개인 신청 유효성 검사 ── */
    var name  = document.getElementById('rName').value.trim();
    var phone = document.getElementById('rPhone').value.trim();
    var email = document.getElementById('rEmail').value.trim();
    var grade = document.getElementById('rGrade').value;

    if (!name || !phone || !email || !grade) {
      errorMsg.textContent = '이름, 연락처, 이메일, 학년은 필수 항목입니다. / Name, phone, email, and grade are required.';
      errorMsg.hidden = false;
      return;
    }

    payload = {
      registrationType: 'individual',
      campId: campIdInput.value,
      capacity: parseInt(campCapInput.value) || 40,
      name: name,
      phone: phone,
      email: email,
      grade: grade,
      church: document.getElementById('rChurch').value.trim(),
      school: document.getElementById('rSchool').value.trim(),
      emergency: document.getElementById('rEmergency').value.trim(),
      notes: document.getElementById('rNotes').value.trim(),
    };
  }

  submitBtn.disabled = true;
  submitBtn.classList.add('loading');

  try {
    var res = await fetch('/api/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    var data = await res.json();

    if (res.ok && data.success) {
      formWrap.hidden = true;
      successWrap.hidden = false;

      /* 성공 메시지 — 유형별 */
      var successMsg = document.getElementById('regSuccessMsg');
      var successCount = document.getElementById('regSuccessCount');
      var isEn = getIsEn();

      if (currentType === 'group') {
        var gc = payload.groupCount;
        successMsg.innerHTML = isEn
          ? 'Your group registration for <strong>' + gc + ' participants</strong> has been received. Please send individual registration forms to <strong>wolkorea1@gmail.com</strong> for final confirmation.'
          : '<strong>' + gc + '명</strong>의 단체 신청이 접수되었습니다.<br><strong>wolkorea1@gmail.com</strong>으로 개인별 신청서를 보내주시면 최종 확인 처리해 드립니다.';
        successCount.textContent = isEn
          ? data.count + ' / ' + data.capacity + ' spots filled'
          : data.count + ' / ' + data.capacity + '명 신청 완료';
      } else {
        successMsg.innerHTML = isEn
          ? 'Your registration has been received. We\'ll be in touch with further details soon.'
          : '신청이 성공적으로 접수되었습니다. 캠프 일정 및 안내 사항은 입력하신 이메일로 발송됩니다.';
        successCount.textContent = isEn
          ? data.count + ' / ' + data.capacity + ' spots filled'
          : data.count + ' / ' + data.capacity + '명 신청 완료';
      }

      /* 카드 정원 바 업데이트 */
      var capBar = document.querySelector('[data-cap-id="' + payload.campId + '"]');
      if (capBar) updateCapBar(capBar, data.count, data.capacity);
      updateModalCap(data.count, data.capacity);

    } else {
      errorMsg.textContent = data.error || '오류가 발생했습니다. 다시 시도해주세요. / An error occurred. Please try again.';
      errorMsg.hidden = false;
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
    }
  } catch(err) {
    errorMsg.textContent = '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해주세요. / Network error. Please try again.';
    errorMsg.hidden = false;
    submitBtn.disabled = false;
    submitBtn.classList.remove('loading');
  }
});
</script>

</BaseLayout>
