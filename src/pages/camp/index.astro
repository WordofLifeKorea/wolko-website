---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { isCampVisibleOnPublicSite } from '../../utils/campVisibility';

const allSchedules = await getCollection('camp_schedules');
const schedules = allSchedules
  .filter(isCampVisibleOnPublicSite)
  .filter(s => !s.data.public_card_hidden)
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const jejuCamps  = schedules.filter(s => s.data.camp_type === 'jeju');
const inlandCamps = schedules.filter(s => s.data.camp_type !== 'jeju');

const typeLabel: Record<string, { ko: string; en: string }> = {
  english: { ko: '영어캠프', en: 'English Camp' },
  jeju:    { ko: '제주캠프', en: 'Jeju Camp' },
  union:   { ko: '연합캠프', en: 'Unity Camp' },
};
const statusLabel: Record<string, { ko: string; en: string; cls: string }> = {
  open:     { ko: '신청 중', en: 'Open', cls: 'status-open' },
  closed:   { ko: '마감',   en: 'Closed', cls: 'status-closed' },
  upcoming: { ko: '준비 중', en: 'Upcoming', cls: 'status-upcoming' },
  full:     { ko: '정원 마감', en: 'Full', cls: 'status-full' },
};
---

<BaseLayout
  title="캠프 사역 — Word of Life Korea"
  description="복음을 듣고 삶의 방향을 다시 세우는 월코 캠프 — 영어캠프, 제주캠프, 연합캠프"
  activeNav="ministry"
>

<PageHero mark="CAMP" id="camp-intro" image="/images/heroes/camphero.jpg" pos="50% 40%">
  <Fragment slot="eyebrow"><span class="wl-ko">캠프 사역</span><span class="wl-en">Camp Ministry</span></Fragment>
  <Fragment slot="title">
    <span class="wl-ko">복음을 듣고, <br>삶의 방향을 다시 세우는 월코 캠프</span>
    <span class="wl-en">Hear the Gospel.<br>Redirect Your Life.</span>
  </Fragment>
  <Fragment slot="bar">
    <p class="ph-sub">
      <span class="wl-ko">영어라는 도구를 통해 복음을 전하고, 제자훈련을 통해 <br>다음 세대의 삶이 변화되도록 돕는 사역입니다.</span>
      <span class="wl-en">We share the Gospel through English as a tool, and through discipleship training we help shape the lives of the next generation.</span>
    </p>
    <div class="ph-actions">
      <a href="/camp-register" class="ph-cta"><span class="wl-ko">캠프 신청하기</span><span class="wl-en">Register for Camp</span><svg aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M2 8h11M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/></svg></a>
      <a href="#camp-programs" class="ph-cta ph-cta--ghost"><span class="wl-ko">캠프 프로그램 보기</span><span class="wl-en">View Camp Programs</span></a>
    </div>
    <dl class="ph-stats ph-stats--text">
      <div class="ph-stat"><dt><span class="wl-ko">선교사님들의 복음 특화 말씀</span><span class="wl-en">Gospel-focused teaching by missionaries</span></dt><dd><span class="wl-ko">말씀 중심</span><span class="wl-en">Word-Centered</span></dd></div>
      <div class="ph-stat"><dt><span class="wl-ko">원어민과 함께하는 캠프</span><span class="wl-en">Camps with native English speakers</span></dt><dd><span class="wl-ko">영어 환경</span><span class="wl-en">English Immersion</span></dd></div>
      <div class="ph-stat"><dt><span class="wl-ko">영어 · 제주 · 연합캠프</span><span class="wl-en">English · Jeju · Unity Camp</span></dt><dd><span class="wl-ko">3가지 프로그램</span><span class="wl-en">3 Programs</span></dd></div>
      <div class="ph-stat"><dt><span class="wl-ko">훈련된 상담자와 함께</span><span class="wl-en">Alongside trained counselors</span></dt><dd><span class="wl-ko">가족 같은 공동체</span><span class="wl-en">Family Atmosphere</span></dd></div>
    </dl>
  </Fragment>
</PageHero>

<div class="wcp-wrap">

  <!-- 소개 + 프로그램 바로가기 -->
  <section class="cp-intro">
    <div class="cp-shell">
      <div class="cp-intro-grid">
        <div>
          <p class="cp-eyebrow"><span class="wl-ko">캠프 소개</span><span class="wl-en">Camp Introduction</span></p>
          <h2 class="cp-title">
            <span class="wl-ko">월코 캠프는<br>다음 세대를 위한<br>변화의 자리입니다</span>
            <span class="wl-en">WOLKO Camp Is a Place of Transformation for the Next Generation</span>
          </h2>
        </div>
        <div class="cp-intro-body">
          <p class="cp-lead">
            <span class="wl-ko">말씀을 통해 삶의 방향을 다시 세우고, 훈련된 리더와 공동체 안에서 자신을 돌아보며, 복음 안에서 새로운 비전과 기쁨을 경험하도록 돕는 것이 월코 캠프의 핵심입니다.</span>
            <span class="wl-en">The heart of WOLKO Camp is helping young people realign their lives through God's Word, reflect on themselves within a trained community, and discover fresh vision and joy in the Gospel.</span>
          </p>
          <p class="cp-text">
            <span class="wl-ko">단순한 행사로 끝나는 것이 아니라, 복음 전도와 제자훈련을 통해 삶의 변화를 목표로 합니다. 가족 같은 분위기 속에서 친구들과 선생님을 만나며, 행복하고 오래 남는 공동체 경험을 제공합니다.</span>
            <span class="wl-en">It doesn't end as a mere event. Through evangelism and discipleship training, we aim for real life change. In a warm, family-like atmosphere, campers meet friends and mentors and walk away with lasting community memories.</span>
          </p>
          <blockquote class="cp-quote">
            <p><span class="wl-ko">“한 번의 캠프가 평생을 바꾸는 경험이 됩니다.”</span><span class="wl-en">“One camp can become an experience that changes your life forever.”</span></p>
            <cite><span class="wl-ko">월코 캠프 참가자 간증</span><span class="wl-en">WOLKO Camp Participant</span></cite>
          </blockquote>
        </div>
      </div>

      <nav class="cp-jump" aria-label="캠프 프로그램 바로가기">
        <a href="#english-camp">
          <span class="cp-jump-kicker"><span class="wl-ko">프로그램 01</span><span class="wl-en">Program 01</span></span>
          <strong class="cp-jump-name"><span class="wl-ko">영어캠프</span><span class="wl-en">English Camp</span></strong>
          <span class="cp-jump-desc"><span class="wl-ko">영어 환경 속에서 복음과 공동체를 함께 경험하는 프로그램</span><span class="wl-en">A program where campers experience the Gospel and community within an English-speaking environment</span></span>
          <span class="cp-jump-more"><span class="wl-ko">자세히 보기</span><span class="wl-en">Learn More</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg></span>
        </a>
        <a href="#jeju-camp">
          <span class="cp-jump-kicker"><span class="wl-ko">프로그램 02</span><span class="wl-en">Program 02</span></span>
          <strong class="cp-jump-name"><span class="wl-ko">제주캠프</span><span class="wl-en">Jeju Camp</span></strong>
          <span class="cp-jump-desc"><span class="wl-ko">제주 월비 캠퍼스에서 진행되는 영어 환경 속 복음과 공동체 프로그램</span><span class="wl-en">Gospel and community programming at WOLBI Jeju Campus, conducted in an English-immersion setting</span></span>
          <span class="cp-jump-more"><span class="wl-ko">자세히 보기</span><span class="wl-en">Learn More</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg></span>
        </a>
        <a href="#union-camp">
          <span class="cp-jump-kicker"><span class="wl-ko">프로그램 03</span><span class="wl-en">Program 03</span></span>
          <strong class="cp-jump-name"><span class="wl-ko">연합캠프</span><span class="wl-en">Unity Camp</span></strong>
          <span class="cp-jump-desc"><span class="wl-ko">여러 교회가 연합하여 진행하는 복음과 액티비티 위주의 다이나믹한 프로그램</span><span class="wl-en">A dynamic, Gospel- and activity-centered program brought together by multiple partner churches</span></span>
          <span class="cp-jump-more"><span class="wl-ko">자세히 보기</span><span class="wl-en">Learn More</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg></span>
        </a>
      </nav>
    </div>
  </section>

  <!-- 특별한 경험 — 큰 사진 + 네 줄 -->
  <section class="cp-highlights">
    <div class="cp-shell cp-split">
      <figure class="cp-split-media">
        <img src="/images/heroes/campgroup.jpg" alt="월코 캠프 현장" loading="lazy">
      </figure>
      <div class="cp-split-body">
        <p class="cp-eyebrow"><span class="wl-ko">캠프의 경험</span><span class="wl-en">The Camp Experience</span></p>
        <h2 class="cp-title">
          <span class="wl-ko">월코 캠프만의<br>특별한 경험</span>
          <span class="wl-en">What Makes<br>WOLKO Camp Unique</span>
        </h2>
        <p class="cp-text">
          <span class="wl-ko">말씀과 공동체, 영어와 훈련이 하나로 연결되는 캠프</span>
          <span class="wl-en">Where the Word, community, English, and training come together</span>
        </p>
        <ul class="cp-points">
          <li>
            <span class="cp-point-key"><span class="wl-ko">말씀</span><span class="wl-en">Word</span></span>
            <div>
              <strong><span class="wl-ko">말씀 중심</span><span class="wl-en">Word-Centered</span></strong>
              <p><span class="wl-ko">선교사님들이 전하는 하나님의 복음 특화 말씀을 통해 캠퍼들이 인생의 방향과 비전을 발견하도록 돕습니다.</span><span class="wl-en">Through Gospel-focused teaching from our missionary staff, campers are guided to discover the direction and vision God has for their lives.</span></p>
            </div>
          </li>
          <li>
            <span class="cp-point-key"><span class="wl-ko">공동체</span><span class="wl-en">People</span></span>
            <div>
              <strong><span class="wl-ko">상담자 · 친구 공동체</span><span class="wl-en">Counselors &amp; Community</span></strong>
              <p><span class="wl-ko">훈련된 성숙한 상담자들과 함께 지내며 인생의 고민을 나누고, 복음 안에서 답을 찾는 시간을 가집니다.</span><span class="wl-en">Campers live alongside trained, mature counselors, sharing life questions and finding answers rooted in the Gospel.</span></p>
            </div>
          </li>
          <li>
            <span class="cp-point-key"><span class="wl-ko">영어</span><span class="wl-en">English</span></span>
            <div>
              <strong><span class="wl-ko">영어 환경</span><span class="wl-en">English Environment</span></strong>
              <p><span class="wl-ko">영어 원어민들과 함께 생활하며 다양한 문화 스펙트럼을 경험하고 더욱 확장된 시야와 자신감을 갖도록 돕습니다.</span><span class="wl-en">Living alongside native English speakers, campers encounter a broader cultural spectrum and grow in confidence and perspective.</span></p>
            </div>
          </li>
          <li>
            <span class="cp-point-key"><span class="wl-ko">기쁨</span><span class="wl-en">Joy</span></span>
            <div>
              <strong><span class="wl-ko">가족 같은 분위기</span><span class="wl-en">Family-Like Atmosphere</span></strong>
              <p><span class="wl-ko">친구, 선생님, 공동체 안에서 기쁨과 소속감을 누리며 행복하고 오래 남는 캠프 경험을 만들어갑니다.</span><span class="wl-en">Campers experience joy and belonging among friends, staff, and community — creating memories that last a lifetime.</span></p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 세 가지 프로그램 -->
  <section class="cp-programs" id="camp-programs">
    <div class="cp-shell">
      <div class="cp-head">
        <p class="cp-eyebrow"><span class="wl-ko">주요 프로그램</span><span class="wl-en">Main Programs</span></p>
        <h2 class="cp-title"><span class="wl-ko">세 가지 캠프 프로그램</span><span class="wl-en">Three Camp Programs</span></h2>
      </div>
      <div class="cp-prog-grid">
        <article class="prog-card" id="english-camp" tabindex="0" aria-describedby="english-camp-hint">
          <div class="prog-media">
            <img class="prog-img" src="/images/heroes/campgroup.jpg" alt="영어캠프" loading="lazy">
            <div class="prog-hint" id="english-camp-hint">
              <span class="prog-hint-label"><span class="wl-ko">참여 대상</span><span class="wl-en">Eligibility</span></span>
              <strong><span class="wl-ko">초6–중3</span><span class="wl-en">Grades 6–9</span></strong>
              <span class="prog-hint-age"><span class="wl-ko">만 11–15세</span><span class="wl-en">Ages 11–15</span></span>
            </div>
          </div>
          <div class="prog-body">
            <p class="prog-label"><span class="prog-num">01</span><span class="wl-ko">영어 캠프</span><span class="wl-en">English Camp</span></p>
            <h3 class="prog-title"><span class="wl-ko">영어캠프</span><span class="wl-en">English Camp</span></h3>
            <p class="prog-desc"><span class="wl-ko">캠프 대부분의 일정이 영어로 진행되며, 원어민 선생님들과 함께 생활하는 가운데 영어 실력뿐 아니라 영적 성장을 함께 경험할 수 있도록 구성된 프로그램입니다. 초등학교 6학년부터 중학교 3학년까지 신청이 가능합니다.</span><span class="wl-en">Most of the camp schedule runs in English, and living alongside native-speaking staff, campers grow not only in their English ability but also spiritually. Open to students from 6th grade through 9th grade.</span></p>
          </div>
        </article>
        <article class="prog-card" id="jeju-camp" tabindex="0" aria-describedby="jeju-camp-hint">
          <div class="prog-media">
            <img class="prog-img" src="https://wolko.synology.me/Web_Contents/Photos/Camp_Ministry/Jeju 1.jpg" alt="제주캠프" loading="lazy">
            <div class="prog-hint" id="jeju-camp-hint">
              <span class="prog-hint-label"><span class="wl-ko">참여 대상</span><span class="wl-en">Eligibility</span></span>
              <strong><span class="wl-ko">고1–고3</span><span class="wl-en">Grades 10–12</span></strong>
              <span class="prog-hint-age"><span class="wl-ko">만 15–18세</span><span class="wl-en">Ages 15–18</span></span>
            </div>
          </div>
          <div class="prog-body">
            <p class="prog-label"><span class="prog-num">02</span><span class="wl-ko">제주 캠프</span><span class="wl-en">Jeju Camp</span></p>
            <h3 class="prog-title"><span class="wl-ko">제주캠프</span><span class="wl-en">Jeju Camp</span></h3>
            <p class="prog-desc"><span class="wl-ko">제주 월비캠퍼스에서 진행되는 영어 캠프 및 모멘텀 캠프 등 다양한 프로그램이 운영됩니다. 고등학교 1학년부터 3학년까지 참여할 수 있는 캠프입니다.</span><span class="wl-en">A variety of programs — including English Camp and Momentum Camp — are held at the WOLBI Jeju Campus. Open to students in grades 10 through 12.</span></p>
          </div>
        </article>
        <article class="prog-card" id="union-camp" tabindex="0" aria-describedby="union-camp-hint">
          <div class="prog-media">
            <img class="prog-img" src="https://wolko.synology.me/Web_Contents/Photos/Camp_Ministry/Union_Camp.jpg" alt="연합캠프" loading="lazy">
            <div class="prog-hint" id="union-camp-hint">
              <span class="prog-hint-label"><span class="wl-ko">참여 방식</span><span class="wl-en">Participation</span></span>
              <strong><span class="wl-ko">교회 단위 참여</span><span class="wl-en">Church Groups</span></strong>
              <span class="prog-hint-age"><span class="wl-ko">교역자와 함께 신청</span><span class="wl-en">Apply with a Leader</span></span>
            </div>
          </div>
          <div class="prog-body">
            <p class="prog-label"><span class="prog-num">03</span><span class="wl-ko">연합캠프</span><span class="wl-en">Unity Camp</span></p>
            <h3 class="prog-title"><span class="wl-ko">연합캠프</span><span class="wl-en">Unity Camp</span></h3>
            <p class="prog-desc"><span class="wl-ko">월코는 교회가 복음 사역의 중심이 되기를 바랍니다. 교회와 연합하여 청소년을 섬기고, 다음 세대의 실질적인 변화를 이끄는 캠프를 진행합니다.</span><span class="wl-en">WOLKO believes the local church should be at the center of Gospel ministry. We partner with churches to serve youth and lead the next generation toward real transformation.</span></p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 캠프의 특징 -->
  <section class="cp-features">
    <div class="cp-shell cp-aside-grid">
      <div class="cp-aside-head">
        <p class="cp-eyebrow"><span class="wl-ko">캠프의 특징</span><span class="wl-en">Key Features</span></p>
        <h2 class="cp-title">
          <span class="wl-ko">월코 캠프가<br>특별한 이유</span>
          <span class="wl-en">Why WOLKO Camp<br>Is Different</span>
        </h2>
        <p class="cp-text">
          <span class="wl-ko">단순한 여름 수련회가 아닙니다. 복음 전도와 제자훈련을 통해 다음 세대의 삶이 실질적으로 변화되는 캠프 사역입니다.</span>
          <span class="wl-en">This isn't just a summer program. It's a camp ministry where the next generation experiences real, lasting transformation through evangelism and discipleship training.</span>
        </p>
      </div>
      <div class="feat-list">
        <div class="feat-item">
          <p class="feat-key"><span class="wl-ko">비전</span><span class="wl-en">Vision</span></p>
          <div class="feat-body">
            <h3 class="feat-name"><span class="wl-ko">복음과 제자훈련 중심</span><span class="wl-en">Gospel &amp; Discipleship First</span></h3>
            <p class="feat-desc"><span class="wl-ko">단순한 행사로 끝나는 것이 아니라, 복음 전도와 제자훈련을 통해 삶의 변화를 목표로 합니다.</span><span class="wl-en">More than an event — we aim for genuine life change through evangelism and discipleship training.</span></p>
          </div>
        </div>
        <div class="feat-item">
          <p class="feat-key"><span class="wl-ko">말씀</span><span class="wl-en">Word</span></p>
          <div class="feat-body">
            <h3 class="feat-name"><span class="wl-ko">복음 중심 말씀 선포</span><span class="wl-en">Teaching Ministry by Missionaries</span></h3>
            <p class="feat-desc"><span class="wl-ko">선교사님들이 전하는 하나님의 복음 특화 말씀을 통해 캠퍼들이 인생의 방향과 비전을 발견하도록 돕습니다.</span><span class="wl-en">Our missionary staff deliver Gospel-focused teaching that helps campers find the direction and vision God has for their lives.</span></p>
          </div>
        </div>
        <div class="feat-item">
          <p class="feat-key"><span class="wl-ko">돌봄</span><span class="wl-en">Care</span></p>
          <div class="feat-body">
            <h3 class="feat-name"><span class="wl-ko">훈련된 상담자와 함께</span><span class="wl-en">With Trained Counselors</span></h3>
            <p class="feat-desc"><span class="wl-ko">훈련된 성숙한 상담자들과 함께 지내며 인생의 고민을 나누고, 복음 안에서 답을 찾는 시간을 가집니다.</span><span class="wl-en">Campers live with trained, mature counselors — sharing life's struggles and discovering Gospel-centered answers together.</span></p>
          </div>
        </div>
