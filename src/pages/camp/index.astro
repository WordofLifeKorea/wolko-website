---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allSchedules = await getCollection('camp_schedules');
const schedules = allSchedules
  .filter(s => s.data.status !== 'closed')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const jejuCamps  = schedules.filter(s => s.data.camp_type === 'jeju');
const inlandCamps = schedules.filter(s => s.data.camp_type !== 'jeju');

const typeLabel: Record<string, { ko: string; en: string }> = {
  english: { ko: '영어캠프', en: 'English Camp' },
  jeju:    { ko: '제주캠프', en: 'Jeju Camp' },
  union:   { ko: '연합캠프', en: 'Union Camp' },
};
const statusLabel: Record<string, { ko: string; en: string; cls: string }> = {
  open:     { ko: '신청 중', en: 'Open', cls: 'status-open' },
  closed:   { ko: '마감',   en: 'Closed', cls: 'status-closed' },
  upcoming: { ko: '준비 중', en: 'Upcoming', cls: 'status-upcoming' },
  full:     { ko: '정원 마감', en: 'Full', cls: 'status-full' },
};
---

<BaseLayout
  title="캠프 사역 — Word of Life Korea"
  description="복음을 듣고 삶의 방향을 다시 세우는 월코 캠프 — 영어캠프, 제주캠프, 연합캠프"
  activeNav="ministry"
>

<!-- WOLKO 캠프사역 본문 | 플로팅 바 분리 버전 -->
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700;900&family=Noto+Sans+KR:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,700;1,400;1,700&display=swap');

/* ══ CAMP WRAP ══ */
.wcp-wrap {
  --c-deep:   #004f68;
  --c-mid:    #007ea1;
  --c-light:  #73d1f5;
  --c-red:    #c42a36;
  --c-red-dk: #a82330;
  --c-white:  #ffffff;
  --c-off:    #f5fafd;
  --c-pale:   #eef7fb;
  --c-text:   #111820;
  --c-sub:    #334a56;
  --c-muted:  #6b8896;
  --c-border: rgba(0,79,104,0.12);
  --f-serif:  'Playfair Display', 'Noto Serif KR', Georgia, serif;
  --f-sans:   'Noto Sans KR', sans-serif;
  --sp-xs:  8px; --sp-sm: 16px; --sp-md: 24px;
  --sp-lg: 40px; --sp-xl: 64px; --sp-2xl: 96px; --sp-3xl: 140px;
  --max-w: 1100px; --pad-h: 48px;
  font-family: var(--f-sans);
  font-weight: 300;
  color: var(--c-text);
  background: var(--c-white);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  width: 100%;
}
.wcp-wrap *, .wcp-wrap *::before, .wcp-wrap *::after { box-sizing: border-box; margin: 0; padding: 0; }
.wcp-wrap img { display: block; width: 100%; }
.wcp-wrap a { text-decoration: none; color: inherit; }
.wcp-wrap ul { list-style: none; }

/* 리빌 */
.wcp-wrap .reveal { opacity: 0; transform: translateY(24px); transition: opacity .7s ease, transform .7s ease; }
.wcp-wrap .reveal.visible { opacity: 1; transform: none; }
.wcp-wrap .reveal-delay-1 { transition-delay: .10s; }
.wcp-wrap .reveal-delay-2 { transition-delay: .20s; }
.wcp-wrap .reveal-delay-3 { transition-delay: .30s; }

/* 공통 타이포 */
.wcp-wrap .section-label {
  display: inline-flex; align-items: center; gap: var(--sp-sm);
  font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--c-mid); margin-bottom: var(--sp-sm);
}
.wcp-wrap .section-label::before { content: ''; width: 14px; height: 2px; background: var(--c-red); flex-shrink: 0; }
.wcp-wrap .section-title {
  font-family: var(--f-serif); font-size: clamp(30px, 4vw, 50px);
  font-weight: 700; color: var(--c-deep); line-height: 1.14;
  letter-spacing: -0.025em; word-break: keep-all;
}
.wcp-wrap .section-desc { font-size: 16px; line-height: 1.9; color: var(--c-sub); max-width: 620px; word-break: keep-all; }
.wcp-wrap .accent-line { width: 48px; height: 3px; background: linear-gradient(90deg, var(--c-red), var(--c-mid)); border-radius: 2px; margin: var(--sp-md) 0 var(--sp-lg); }

.wcp-wrap .quick-item, .wcp-wrap .prog-card, .wcp-wrap .feat-item {
  transition: transform .28s ease, box-shadow .28s ease, border-color .28s ease, background .28s ease;
  will-change: transform, box-shadow;
}

/* ── HERO ── */
.wcp-wrap .hero {
  position: relative; min-height: 100vh; background: var(--c-deep);
  display: flex; align-items: center; overflow: hidden;
  margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw;
}
.wcp-wrap .hero::before {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(ellipse 80% 60% at 70% 40%, rgba(0,126,161,0.40) 0%, transparent 70%),
              radial-gradient(ellipse 50% 80% at 10% 80%, rgba(115,209,245,0.08) 0%, transparent 60%);
  pointer-events: none;
}
.wcp-wrap .hero-bg-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.22; }
.wcp-wrap .hero-circle { position: absolute; right: -120px; top: -120px; width: 560px; height: 560px; border-radius: 50%; border: 1px solid rgba(115,209,245,0.14); pointer-events: none; }
.wcp-wrap .hero-circle::after { content: ''; position: absolute; inset: 60px; border-radius: 50%; border: 1px solid rgba(115,209,245,0.07); }
.wcp-wrap .hero-cross { position: absolute; right: 7%; bottom: 12%; opacity: 0.04; font-size: 240px; color: var(--c-white); line-height: 1; user-select: none; pointer-events: none; }
.wcp-wrap .hero-inner { position: relative; z-index: 2; width: 100%; max-width: var(--max-w); margin: 0 auto; padding: 120px var(--pad-h) 160px; }
.wcp-wrap .hero-badge {
  display: inline-flex; align-items: center; gap: var(--sp-sm);
  background: rgba(115,209,245,0.12); border: 1px solid rgba(115,209,245,0.26);
  color: var(--c-light); font-size: 11px; font-weight: 500; letter-spacing: 0.2em;
  text-transform: uppercase; padding: 8px 18px; border-radius: 100px; margin-bottom: var(--sp-lg);
}
.wcp-wrap .hero-badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: var(--c-light); }
.wcp-wrap .hero-title { font-family: var(--f-serif); font-size: clamp(40px, 6.5vw, 78px); font-weight: 700; color: var(--c-white); line-height: 1.1; letter-spacing: -0.02em; margin-bottom: var(--sp-sm); word-break: keep-all; }
.wcp-wrap .hero-title em { font-style: italic; color: var(--c-light); }
.wcp-wrap .hero-subtitle { font-size: clamp(14px, 1.8vw, 17px); color: rgba(255,255,255,0.62); font-weight: 300; letter-spacing: 0.02em; margin-bottom: var(--sp-xl); word-break: keep-all; max-width: 600px; }
.wcp-wrap .hero-cta-group { display: flex; gap: var(--sp-sm); flex-wrap: wrap; }
.wcp-wrap .btn-primary { display: inline-flex; align-items: center; gap: var(--sp-sm); background: var(--c-red); color: #fff; font-family: var(--f-sans); font-size: 14px; font-weight: 600; letter-spacing: 0.04em; padding: 15px 30px; border-radius: 4px; transition: background .25s, transform .2s; }
.wcp-wrap .btn-primary:hover { background: var(--c-red-dk); transform: translateY(-2px); }
.wcp-wrap .btn-secondary { display: inline-flex; align-items: center; gap: var(--sp-sm); background: transparent; color: #fff; font-family: var(--f-sans); font-size: 14px; font-weight: 500; letter-spacing: 0.04em; padding: 15px 30px; border-radius: 4px; border: 1.5px solid rgba(255,255,255,0.50); transition: border-color .25s, background .25s; }
.wcp-wrap .btn-secondary:hover { border-color: var(--c-light); background: rgba(115,209,245,0.08); }
.wcp-wrap .hero-stats { position: absolute; bottom: 0; left: 0; right: 0; background: rgba(0,20,32,0.72); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-top: 1px solid rgba(115,209,245,0.14); z-index: 3; }
.wcp-wrap .hero-stats-inner { max-width: var(--max-w); margin: 0 auto; padding: 0 var(--pad-h); display: flex; align-items: stretch; }
.wcp-wrap .hero-stat { flex: 1; padding: var(--sp-md) 0; display: flex; flex-direction: column; gap: 4px; border-right: 1px solid rgba(115,209,245,0.10); }
.wcp-wrap .hero-stat:first-child { padding-right: var(--sp-lg); }
.wcp-wrap .hero-stat:not(:first-child) { padding-left: var(--sp-lg); }
.wcp-wrap .hero-stat:last-child { border-right: none; }
.wcp-wrap .hero-stat-num { font-family: var(--f-serif); font-size: 20px; font-weight: 700; color: var(--c-light); line-height: 1; }
.wcp-wrap .hero-stat-label { font-size: 12px; color: rgba(255,255,255,0.50); font-weight: 300; }

/* ── QUICK PANEL ── */
.wcp-wrap .quick-section { background: var(--c-white); padding: var(--sp-2xl) var(--pad-h); border-bottom: 1px solid var(--c-border); margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wcp-wrap .quick-grid { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--c-border); border: 1px solid var(--c-border); border-radius: 12px; overflow: hidden; }
.wcp-wrap .quick-item { background: var(--c-white); padding: var(--sp-lg) var(--sp-md); display: flex; flex-direction: column; gap: 8px; cursor: pointer; }
.wcp-wrap .quick-item:hover { transform: translateY(-4px); background: #fff; box-shadow: 0 14px 34px rgba(0,79,104,0.08); }
.wcp-wrap .quick-kicker { font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--c-mid); }
.wcp-wrap .quick-name { font-family: var(--f-serif); font-size: 22px; font-weight: 700; color: var(--c-deep); line-height: 1.18; letter-spacing: -0.015em; }
.wcp-wrap .quick-desc { font-size: 14px; line-height: 1.85; color: var(--c-muted); word-break: keep-all; flex: 1; }
.wcp-wrap .quick-arrow { display: inline-flex; align-items: center; gap: 6px; margin-top: 4px; font-size: 12px; font-weight: 600; color: var(--c-mid); letter-spacing: 0.06em; transition: gap .2s, color .2s; }
.wcp-wrap .quick-arrow::after { content: '→'; }
.wcp-wrap .quick-item:hover .quick-arrow { gap: 10px; color: var(--c-deep); }

/* ── INTRO ── */
.wcp-wrap .intro { background: var(--c-white); padding: var(--sp-3xl) var(--pad-h); margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wcp-wrap .intro-grid { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3xl); align-items: center; }
.wcp-wrap .intro-img-wrap { position: relative; }
.wcp-wrap .intro-img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: 8px; display: block; position: relative; z-index: 1; }
.wcp-wrap .intro-img-frame { position: absolute; top: -18px; right: -18px; bottom: 18px; left: 18px; border: 2px solid rgba(0,126,161,0.14); border-radius: 8px; pointer-events: none; }
.wcp-wrap .intro-quote { position: absolute; bottom: -22px; right: -22px; background: var(--c-deep); color: var(--c-white); padding: var(--sp-md) var(--sp-lg); border-radius: 6px; max-width: 240px; z-index: 2; box-shadow: 0 16px 48px rgba(0,30,45,0.22); }
.wcp-wrap .intro-quote-icon { font-family: var(--f-serif); font-size: 44px; line-height: 1; color: var(--c-light); opacity: 0.5; margin-bottom: var(--sp-xs); }
.wcp-wrap .intro-quote-text { font-size: 13px; font-style: italic; line-height: 1.65; color: rgba(255,255,255,0.82); }
.wcp-wrap .intro-quote-source { font-size: 11px; color: var(--c-light); margin-top: var(--sp-sm); font-weight: 500; letter-spacing: 0.06em; }

/* ── HIGHLIGHTS ── */
.wcp-wrap .highlights { background: var(--c-deep); padding: var(--sp-3xl) var(--pad-h); position: relative; overflow: hidden; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wcp-wrap .highlights::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 100% at 90% 50%, rgba(0,126,161,0.32) 0%, transparent 60%); pointer-events: none; }
.wcp-wrap .highlights-inner { position: relative; z-index: 1; max-width: var(--max-w); margin: 0 auto; }
.wcp-wrap .highlights-top { display: flex; justify-content: space-between; align-items: flex-end; margin-bottom: var(--sp-2xl); gap: var(--sp-md); }
.wcp-wrap .highlights-title { font-family: var(--f-serif); font-size: clamp(28px, 3.5vw, 46px); color: var(--c-white); line-height: 1.16; font-weight: 700; letter-spacing: -0.02em; }
.wcp-wrap .highlights-sub { font-size: 14px; color: rgba(255,255,255,0.50); line-height: 1.75; max-width: 280px; text-align: right; word-break: keep-all; }
.wcp-wrap .highlights-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: rgba(115,209,245,0.10); border-radius: 8px; overflow: hidden; }
.wcp-wrap .hi-card { background: rgba(0,10,20,0.35); padding: var(--sp-xl) var(--sp-lg); display: flex; flex-direction: column; gap: var(--sp-sm); transition: background .3s; }
.wcp-wrap .hi-card:hover { background: rgba(0,126,161,0.22); }
.wcp-wrap .hi-num { font-family: var(--f-serif); font-size: 28px; font-weight: 700; color: var(--c-light); line-height: 1; }
.wcp-wrap .hi-label { font-size: 14px; font-weight: 500; color: var(--c-white); }
.wcp-wrap .hi-desc { font-size: 13px; color: rgba(255,255,255,0.46); line-height: 1.7; font-weight: 300; word-break: keep-all; }

/* ── PROGRAMS ── */
.wcp-wrap .programs { background: var(--c-off); padding: var(--sp-3xl) var(--pad-h); margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wcp-wrap .programs-header { text-align: center; max-width: var(--max-w); margin: 0 auto var(--sp-2xl); }
.wcp-wrap .programs-header .section-label { justify-content: center; }
.wcp-wrap .programs-grid { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-md); align-items: stretch; }
.wcp-wrap .prog-card { border-radius: 10px; overflow: hidden; background: var(--c-white); border: 1px solid var(--c-border); display: flex; flex-direction: column; }
.wcp-wrap .prog-card:hover { transform: translateY(-4px); box-shadow: 0 16px 42px rgba(0,79,104,0.12); border-color: rgba(0,79,104,0.18); }
.wcp-wrap .prog-img { aspect-ratio: 16/10; object-fit: cover; display: block; width: 100%; }
.wcp-wrap .prog-body { padding: var(--sp-lg) var(--sp-lg) var(--sp-xl); display: flex; flex-direction: column; flex: 1; }
.wcp-wrap .prog-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--c-mid); margin-bottom: var(--sp-sm); }
.wcp-wrap .prog-pill::before { content: ''; width: 12px; height: 2px; background: var(--c-red); }
.wcp-wrap .prog-title { font-family: var(--f-serif); font-size: 24px; font-weight: 700; color: var(--c-deep); margin-bottom: 14px; line-height: 1.18; letter-spacing: -0.015em; }
.wcp-wrap .prog-desc { font-size: 14px; line-height: 1.85; color: var(--c-sub); word-break: keep-all; flex: 1; margin-bottom: var(--sp-md); }
.wcp-wrap .prog-link { display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: var(--c-mid); letter-spacing: 0.04em; transition: gap .2s, color .2s; margin-top: auto; }
.wcp-wrap .prog-link::after { content: '→'; }
.wcp-wrap .prog-card:hover .prog-link { gap: 10px; color: var(--c-deep); }

/* ── FEATURES ── */
.wcp-wrap .features { background: var(--c-pale); padding: var(--sp-3xl) var(--pad-h); margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wcp-wrap .features-layout { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 320px 1fr; gap: var(--sp-3xl); align-items: start; }
.wcp-wrap .features-sticky { position: sticky; top: 100px; }
.wcp-wrap .feat-list { display: flex; flex-direction: column; gap: 12px; }
.wcp-wrap .feat-item { display: grid; grid-template-columns: 68px 1fr; align-items: stretch; background: var(--c-white); border-radius: 12px; overflow: hidden; border: 1px solid var(--c-border); transition: box-shadow .25s ease, background .25s ease, border-color .25s ease; will-change: box-shadow; }
.wcp-wrap .feat-item:hover { box-shadow: 0 10px 28px rgba(0,79,104,0.10); border-color: rgba(0,79,104,0.16); }
.wcp-wrap .feat-num { align-self: stretch; height: 100%; min-height: 100%; background: linear-gradient(180deg, var(--c-deep), #0a5b76); color: rgba(255,255,255,0.68); font-size: 11px; font-weight: 700; display: flex; align-items: center; justify-content: center; writing-mode: vertical-lr; letter-spacing: 0.12em; padding: var(--sp-sm) 0; border-radius: 12px 0 0 12px; }
.wcp-wrap .feat-body { padding: 22px 22px 20px; }
.wcp-wrap .feat-name { font-family: var(--f-serif); font-size: 22px; font-weight: 700; color: var(--c-deep); margin-bottom: 10px; line-height: 1.3; letter-spacing: -0.02em; }
.wcp-wrap .feat-desc { font-size: 14px; color: var(--c-sub); line-height: 1.85; word-break: keep-all; }
.wcp-wrap .feat-tag { display: none !important; }

/* ── FLOW ── */
.wcp-wrap .flow { background: var(--c-white); padding: var(--sp-3xl) var(--pad-h); margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wcp-wrap .flow-inner { max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-3xl); align-items: start; }
.wcp-wrap .flow-steps { display: flex; flex-direction: column; gap: 4px; }
.wcp-wrap .flow-step { display: grid; grid-template-columns: 52px 1fr; background: var(--c-white); border-radius: 6px; overflow: hidden; border: 1px solid var(--c-border); transition: box-shadow .25s, transform .25s; }
.wcp-wrap .flow-step:hover { transform: translateX(4px); box-shadow: 0 4px 24px rgba(0,79,104,0.10); }
.wcp-wrap .flow-step-num { background: var(--c-deep); color: rgba(255,255,255,0.36); font-size: 11px; font-weight: 600; display: flex; align-items: center; justify-content: center; writing-mode: vertical-lr; letter-spacing: 0.1em; padding: var(--sp-sm) 0; }
.wcp-wrap .flow-step-body { padding: var(--sp-md); }

.wcp-wrap .flow-step-title { font-family: var(--f-serif); font-size: 22px; font-weight: 700; color: var(--c-deep); margin-bottom: 8px; line-height: 1.3; letter-spacing: -0.02em; }
.wcp-wrap .flow-step-desc { font-size: 13px; color: var(--c-muted); line-height: 1.65; word-break: keep-all; }

/* ── CTA + CONTACT ── */
.wcp-wrap .cta-section { background: var(--c-deep); padding: var(--sp-3xl) var(--pad-h) 0; position: relative; overflow: hidden; margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw; }
.wcp-wrap .cta-section::before { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse 70% 100% at 10% 50%, rgba(0,126,161,0.30) 0%, transparent 60%); pointer-events: none; }
.wcp-wrap .cta-inner { position: relative; z-index: 1; max-width: var(--max-w); margin: 0 auto; display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--sp-3xl); align-items: center; padding-bottom: var(--sp-3xl); }
.wcp-wrap .cta-label { display: inline-flex; align-items: center; gap: var(--sp-sm); font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: var(--c-light); margin-bottom: var(--sp-sm); }
.wcp-wrap .cta-label::before { content: ''; width: 14px; height: 2px; background: var(--c-red); flex-shrink: 0; }
.wcp-wrap .cta-title { font-family: var(--f-serif); font-size: clamp(28px, 3.5vw, 46px); font-weight: 700; color: var(--c-white); line-height: 1.18; margin-bottom: var(--sp-sm); letter-spacing: -0.02em; word-break: keep-all; }
.wcp-wrap .cta-desc { font-size: 15px; line-height: 1.85; color: rgba(255,255,255,0.60); word-break: keep-all; }
.wcp-wrap .cta-cards { display: flex; flex-direction: column; gap: var(--sp-sm); }
.wcp-wrap .cta-card { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.12); border-radius: 8px; padding: var(--sp-md) var(--sp-lg); display: flex; align-items: center; gap: var(--sp-md); transition: background .25s, border-color .25s, transform .2s; cursor: pointer; }
.wcp-wrap .cta-card:hover { background: rgba(255,255,255,0.12); border-color: rgba(115,209,245,0.28); transform: translateX(4px); }
.wcp-wrap .cta-card-label { font-size: 14px; font-weight: 600; color: var(--c-white); margin-bottom: 3px; }
.wcp-wrap .cta-card-sub { font-size: 12px; color: rgba(255,255,255,0.48); }
.wcp-wrap .cta-card-arrow { margin-left: auto; color: rgba(255,255,255,0.34); font-size: 18px; transition: color .2s, transform .2s; }
.wcp-wrap .cta-card:hover .cta-card-arrow { color: var(--c-light); transform: translateX(4px); }
.wcp-wrap .contact-bar { background: rgba(0,10,20,0.55); padding: var(--sp-lg) var(--pad-h); border-top: 1px solid rgba(115,209,245,0.10); position: relative; z-index: 1; }
.wcp-wrap .contact-bar-inner { max-width: var(--max-w); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: var(--sp-md); flex-wrap: wrap; }
.wcp-wrap .contact-label { font-size: 10px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c-light); margin-bottom: 6px; }
.wcp-wrap .contact-info { font-size: 13px; color: rgba(255,255,255,0.55); font-weight: 300; }
.wcp-wrap .contact-info strong { color: var(--c-white); font-weight: 500; }
.wcp-wrap .contact-divider { width: 1px; height: 36px; background: rgba(115,209,245,0.12); }
.wcp-wrap .btn-contact { display: inline-flex; align-items: center; gap: var(--sp-sm); background: var(--c-red); color: var(--c-white); font-size: 13px; font-weight: 600; letter-spacing: 0.05em; padding: 13px 26px; border-radius: 4px; white-space: nowrap; transition: background .25s, transform .2s; }
.wcp-wrap .btn-contact:hover { background: var(--c-red-dk); transform: translateY(-2px); }

/* ══ RESPONSIVE ══ */
@media (max-width: 960px) {
  .wcp-wrap { --sp-3xl: 96px; --sp-2xl: 72px; --pad-h: 28px; }
  .wcp-wrap .hero-inner { padding-top: 100px; padding-bottom: 200px; }
  .wcp-wrap .hero-stats-inner { flex-wrap: wrap; }
  .wcp-wrap .hero-stat { flex: 1 1 50%; border-right: none; border-bottom: 1px solid rgba(115,209,245,0.10); padding: var(--sp-sm) var(--sp-md) !important; flex-direction: row; align-items: center; gap: var(--sp-sm); }
  .wcp-wrap .hero-stat:nth-child(3), .wcp-wrap .hero-stat:nth-child(4) { border-bottom: none; }
  .wcp-wrap .quick-grid { grid-template-columns: 1fr; }
  .wcp-wrap .intro-grid { grid-template-columns: 1fr; gap: var(--sp-2xl); }
  .wcp-wrap .intro-img-wrap { order: -1; max-width: 480px; }
  .wcp-wrap .intro-quote { right: -12px; bottom: -16px; }
  .wcp-wrap .highlights-grid { grid-template-columns: repeat(2, 1fr); }
  .wcp-wrap .highlights-top { flex-direction: column; align-items: flex-start; }
  .wcp-wrap .highlights-sub { text-align: left; max-width: 100%; }
  .wcp-wrap .programs-grid { grid-template-columns: 1fr 1fr; }
  .wcp-wrap .features-layout { grid-template-columns: 1fr; }
  .wcp-wrap .features-sticky { position: static; }
  .wcp-wrap .flow-inner { grid-template-columns: 1fr; gap: var(--sp-2xl); }
  .wcp-wrap .cta-inner { grid-template-columns: 1fr; gap: var(--sp-2xl); }
  .wcp-wrap .contact-bar-inner { flex-direction: column; align-items: flex-start; }
  .wcp-wrap .contact-divider { display: none; }
}

@media (max-width: 600px) {
  .wcp-wrap { --sp-3xl: 72px; --sp-2xl: 56px; --sp-xl: 48px; --pad-h: 20px; }
  .wcp-wrap .hero-inner { padding-top: 80px; padding-bottom: 300px; }
  .wcp-wrap .hero-title { font-size: clamp(34px, 9vw, 52px); }
  .wcp-wrap .hero-subtitle { font-size: 14px; margin-bottom: var(--sp-lg); }
  .wcp-wrap .hero-cta-group { flex-direction: column; }
  .wcp-wrap .btn-primary, .wcp-wrap .btn-secondary { justify-content: center; width: 100%; }
  .wcp-wrap .hero-stats-inner { flex-direction: column; }
  .wcp-wrap .hero-stat { flex: 1 1 100% !important; border-right: none !important; border-bottom: 1px solid rgba(115,209,245,0.10) !important; padding: var(--sp-sm) var(--sp-md) !important; flex-direction: row; align-items: center; gap: var(--sp-sm); }
  .wcp-wrap .hero-stat:last-child { border-bottom: none !important; }
  .wcp-wrap .highlights-grid { grid-template-columns: 1fr 1fr; }
  .wcp-wrap .hi-card { padding: var(--sp-md); }
  .wcp-wrap .programs-grid { grid-template-columns: 1fr; }
  .wcp-wrap .intro-quote { position: static; margin-top: var(--sp-md); max-width: 100%; }
  .wcp-wrap .intro-img-frame { display: none; }
  .wcp-wrap .cta-inner { padding-bottom: var(--sp-2xl); }
  .wcp-wrap .feat-item { grid-template-columns: 50px 1fr; }
  .wcp-wrap .feat-num { font-size: 9px; padding: 10px 0; }
  .wcp-wrap .feat-body { padding: 14px 14px 13px; }
  .wcp-wrap .feat-name { font-size: 16px; }
  .wcp-wrap .feat-desc { font-size: 13px; line-height: 1.65; }
}

@media (hover: none) {
  .wcp-wrap .quick-item:hover,
  .wcp-wrap .prog-card:hover,
  .wcp-wrap .feat-item:hover { transform: none; box-shadow: none; }
}

/* ── REGISTRATION SECTION ── */
.wcp-wrap .reg-section {
  background: var(--c-off);
  padding: var(--sp-3xl) var(--pad-h);
  margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw;
  border-top: 1px solid var(--c-border);
}
.wcp-wrap .reg-header {
  max-width: var(--max-w); margin: 0 auto var(--sp-2xl);
  display: flex; align-items: flex-end; justify-content: space-between; gap: var(--sp-lg);
}
.wcp-wrap .reg-header-text {}
.wcp-wrap .reg-grid {
  max-width: var(--max-w); margin: 0 auto;
  display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-md);
  align-items: stretch;
}
.wcp-wrap .reg-card {
  background: var(--c-white);
  border: 1px solid var(--c-border);
  border-radius: 14px;
  padding: var(--sp-lg) var(--sp-lg) var(--sp-xl);
  display: flex; flex-direction: column; gap: 0;
  position: relative; overflow: hidden;
  transition: transform .28s, box-shadow .28s, border-color .28s;
}
.wcp-wrap .reg-card:hover { transform: translateY(-4px); box-shadow: 0 16px 42px rgba(0,79,104,0.10); border-color: rgba(0,79,104,0.18); }
.wcp-wrap .reg-card-top {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px;
}
.wcp-wrap .reg-type-badge {
  font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--c-mid); background: rgba(0,126,161,0.08);
  padding: 5px 12px; border-radius: 100px;
}
.wcp-wrap .reg-status-badge {
  font-size: 11px; font-weight: 700; letter-spacing: 0.06em;
  padding: 5px 13px; border-radius: 100px;
}
.wcp-wrap .status-open     { background: rgba(22,163,74,0.1);  color: #15803d; }
.wcp-wrap .status-upcoming { background: rgba(0,126,161,0.1);  color: var(--c-mid); }
.wcp-wrap .status-full     { background: rgba(234,88,12,0.1);  color: #c2410c; }
.wcp-wrap .status-closed   { background: rgba(100,116,139,0.1); color: #64748b; }

.wcp-wrap .reg-title {
  font-family: var(--f-serif); font-size: 22px; font-weight: 700;
  color: var(--c-deep); line-height: 1.2; letter-spacing: -0.015em;
  margin-bottom: var(--sp-md);
}
.wcp-wrap .reg-meta {
  display: flex; flex-direction: column; gap: 10px;
  margin-bottom: var(--sp-md); flex: 1;
}
.wcp-wrap .reg-meta-row {
  display: grid; grid-template-columns: 72px 1fr; gap: 8px; align-items: baseline;
}
.wcp-wrap .reg-meta-label {
  font-size: 10px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase;
  color: var(--c-muted);
}
.wcp-wrap .reg-meta-value {
  font-size: 13px; color: var(--c-sub); line-height: 1.55; word-break: keep-all;
}
.wcp-wrap .reg-notes {
  font-size: 12.5px; line-height: 1.75; color: var(--c-muted);
  padding-top: var(--sp-sm); border-top: 1px solid var(--c-border);
  margin-bottom: var(--sp-md); word-break: keep-all;
}
.wcp-wrap .reg-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 13px;
  font-size: 13px; font-weight: 700; letter-spacing: 0.04em; border-radius: 8px;
  margin-top: auto; transition: background .22s, transform .18s, box-shadow .22s;
  text-decoration: none;
}
.wcp-wrap .reg-btn-primary {
  background: var(--c-red); color: #fff;
}
.wcp-wrap .reg-btn-primary:hover { background: var(--c-red-dk); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(196,42,54,0.3); }
.wcp-wrap .reg-btn-outline {
  background: transparent; color: var(--c-mid);
  border: 1.5px solid var(--c-border);
}
.wcp-wrap .reg-btn-outline:hover { border-color: var(--c-mid); background: rgba(0,126,161,0.05); }
.wcp-wrap .reg-btn-disabled {
  background: rgba(100,116,139,0.08); color: #94a3b8;
  cursor: default; pointer-events: none;
}
.wcp-wrap .reg-empty {
  max-width: var(--max-w); margin: 0 auto;
  background: var(--c-white); border: 1px dashed var(--c-border);
  border-radius: 14px; padding: 48px 32px; text-align: center;
}
.wcp-wrap .reg-empty-icon { font-size: 36px; margin-bottom: 16px; opacity: 0.5; }
.wcp-wrap .reg-empty-title { font-family: var(--f-serif); font-size: 20px; color: var(--c-deep); margin-bottom: 8px; }
.wcp-wrap .reg-empty-desc { font-size: 14px; color: var(--c-muted); line-height: 1.75; }

/* contact row */
.wcp-wrap .reg-contact-row {
  display: grid; grid-template-columns: 72px 1fr; gap: 8px; align-items: baseline;
  margin-bottom: 12px; padding-top: 10px;
  border-top: 1px solid var(--c-border);
}
.wcp-wrap .reg-contact-info {
  display: flex; flex-wrap: wrap; align-items: center; gap: 5px;
  font-size: 12.5px; color: var(--c-mid); font-weight: 500;
}
.wcp-wrap .reg-contact-sep { color: var(--c-border); }

/* capacity bar */
.wcp-wrap .reg-cap { margin-bottom: 14px; }
.wcp-wrap .reg-cap-info {
  display: flex; justify-content: space-between; align-items: baseline;
  font-size: 12px; color: var(--c-muted); margin-bottom: 7px;
}
.wcp-wrap .reg-cap-info strong { font-size: 14px; font-weight: 700; color: var(--c-deep); }
.wcp-wrap .reg-cap-track {
  height: 7px; background: rgba(0,79,104,0.08);
  border-radius: 999px; overflow: hidden;
}
.wcp-wrap .reg-cap-fill {
  height: 100%; border-radius: 999px; width: 0%;
  background: linear-gradient(90deg, var(--c-mid), var(--c-light));
  transition: width 0.8s cubic-bezier(0.22,1,0.36,1);
}
.wcp-wrap .reg-cap-fill.warn  { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
.wcp-wrap .reg-cap-fill.full  { background: linear-gradient(90deg, var(--c-red), #e55); }

/* ── CAMP GROUPS ── */
.wcp-wrap .reg-group {
  max-width: var(--max-w); margin: 0 auto;
}
.wcp-wrap .reg-group-header {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--sp-md); margin-bottom: var(--sp-lg);
  padding-bottom: 14px;
  border-bottom: 2px solid var(--c-border);
}
.wcp-wrap .reg-group-tag {
  display: flex; align-items: center; gap: 10px;
  font-size: 12px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase;
  color: var(--c-deep);
}
.wcp-wrap .reg-group-tag::before {
  content: ''; width: 3px; height: 18px;
  background: var(--c-red); border-radius: 2px; flex-shrink: 0;
}
.wcp-wrap .reg-group-cafe-link {
  font-size: 12px; font-weight: 600; color: var(--c-mid);
  letter-spacing: 0.04em; white-space: nowrap;
  transition: color 0.2s, gap 0.2s;
}
.wcp-wrap .reg-group-cafe-link:hover { color: var(--c-deep); }

.wcp-wrap .reg-group-divider {
  max-width: var(--max-w); margin: var(--sp-2xl) auto;
  border: none; border-top: 1.5px dashed rgba(0,79,104,0.15);
  position: relative;
}
.wcp-wrap .reg-group-divider::after {
  content: '✝';
  position: absolute; left: 50%; top: 50%;
  transform: translate(-50%, -50%);
  background: var(--c-off); color: rgba(0,79,104,0.20);
  font-size: 14px; padding: 0 12px; line-height: 1;
}

@media (max-width: 960px) {
  .wcp-wrap .reg-grid { grid-template-columns: 1fr 1fr; }
  .wcp-wrap .reg-header { flex-direction: column; align-items: flex-start; }
  .wcp-wrap .reg-group-header { flex-direction: column; align-items: flex-start; gap: 6px; }
}
@media (max-width: 600px) {
  .wcp-wrap .reg-grid { grid-template-columns: 1fr; }
}

/* ── REGISTRATION MODAL ── */
.reg-modal {
  position: fixed; inset: 0; z-index: 9000;
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
}
.reg-modal[hidden] { display: none; }
.reg-modal-overlay {
  position: absolute; inset: 0;
  background: rgba(5,18,28,0.72);
  backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
  cursor: pointer;
  animation: regFadeIn 0.25s ease;
}
@keyframes regFadeIn { from { opacity:0; } to { opacity:1; } }
@keyframes regSlideUp { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }

.reg-modal-card {
  position: relative; z-index: 1;
  background: #fff; border-radius: 20px;
  width: 100%; max-width: 640px;
  max-height: 90vh; overflow-y: auto;
  box-shadow: 0 32px 80px rgba(0,20,40,0.28);
  animation: regSlideUp 0.32s cubic-bezier(0.22,1,0.36,1);
}
.reg-modal-close {
  position: absolute; top: 18px; right: 20px; z-index: 2;
  width: 34px; height: 34px; border-radius: 50%;
  border: none; background: rgba(0,79,104,0.07);
  font-size: 20px; line-height: 1; cursor: pointer;
  color: var(--c-sub); display: flex; align-items: center; justify-content: center;
  transition: background 0.2s;
}
.reg-modal-close:hover { background: rgba(0,79,104,0.14); }

.reg-modal-head {
  padding: 36px 36px 28px;
  background: linear-gradient(135deg, var(--c-deep) 0%, #015a7a 100%);
  border-radius: 20px 20px 0 0;
  position: relative; overflow: hidden;
}
.reg-modal-head::after {
  content: ''; position: absolute; top: -60px; right: -60px;
  width: 200px; height: 200px; border-radius: 50%;
  background: rgba(115,209,245,0.08); pointer-events: none;
}
.reg-modal-badge {
  font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--c-light); margin-bottom: 10px; display: flex; align-items: center; gap: 8px;
}
.reg-modal-badge::before { content:''; width:14px; height:1.5px; background:var(--c-light); flex-shrink:0; }
.reg-modal-title {
  font-family: var(--f-serif); font-size: clamp(20px,3vw,28px); font-weight:700;
  color: #fff; line-height:1.2; margin-bottom: 20px; word-break: keep-all;
}
.reg-modal-cap-wrap { }
.reg-modal-cap-info {
  display: flex; justify-content: space-between; align-items: baseline;
  font-size: 12px; color: rgba(255,255,255,0.6); margin-bottom: 7px;
}
.reg-modal-cap-info strong { font-size: 15px; font-weight: 700; color: #fff; }
.reg-modal-cap-track {
  height: 8px; background: rgba(255,255,255,0.15); border-radius: 999px; overflow: hidden;
}
.reg-modal-cap-fill {
  height: 100%; border-radius: 999px; width: 0%;
  background: linear-gradient(90deg, var(--c-light), #a8e8ff);
  transition: width 0.8s cubic-bezier(0.22,1,0.36,1);
}
.reg-modal-cap-fill.warn  { background: linear-gradient(90deg, #fbbf24, #fde68a); }
.reg-modal-cap-fill.full  { background: linear-gradient(90deg, #f87171, #fca5a5); }

.reg-form-wrap { padding: 28px 36px 36px; }
.reg-form-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 20px;
}
.reg-field { display: flex; flex-direction: column; gap: 6px; }
.reg-field--full { grid-column: 1 / -1; }
.reg-field label {
  font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
  color: var(--c-mid);
}
.reg-field label .req { color: var(--c-red); margin-left: 2px; }
.reg-field input, .reg-field select, .reg-field textarea {
  border: 1.5px solid rgba(0,79,104,0.15); border-radius: 8px;
  padding: 11px 13px; font-size: 14px; font-family: var(--f-sans);
  color: var(--c-text); background: #fff;
  transition: border-color 0.2s, box-shadow 0.2s;
  outline: none; width: 100%; resize: vertical;
}
.reg-field input::placeholder, .reg-field textarea::placeholder { color: #b0c4cc; }
.reg-field input:focus, .reg-field select:focus, .reg-field textarea:focus {
  border-color: var(--c-mid);
  box-shadow: 0 0 0 3px rgba(0,126,161,0.1);
}
.reg-field input.error, .reg-field select.error { border-color: var(--c-red); }
.reg-consent {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 14px; background: rgba(0,79,104,0.04);
  border-radius: 8px; border: 1px solid rgba(0,79,104,0.09);
  margin-bottom: 20px;
}
.reg-consent input[type=checkbox] { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; cursor: pointer; accent-color: var(--c-deep); }
.reg-consent label { font-size: 12px; line-height: 1.65; color: var(--c-sub); cursor: pointer; }
.reg-consent label strong { color: var(--c-deep); }
.reg-submit {
  width: 100%; padding: 15px;
  background: var(--c-red); color: #fff;
  border: none; border-radius: 10px;
  font-size: 15px; font-weight: 700; font-family: var(--f-sans);
  cursor: pointer; transition: background 0.22s, transform 0.18s, box-shadow 0.22s;
  display: flex; align-items: center; justify-content: center; gap: 8px;
}
.reg-submit:hover:not(:disabled) { background: var(--c-red-dk); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(196,42,54,0.3); }
.reg-submit:disabled { opacity: 0.65; cursor: not-allowed; }
.reg-submit .spinner {
  display: none; width: 16px; height: 16px; border: 2px solid rgba(255,255,255,0.4);
  border-top-color: #fff; border-radius: 50%; animation: spin 0.7s linear infinite;
}
.reg-submit.loading .spinner { display: block; }
.reg-submit.loading .reg-submit-label { opacity: 0.7; }
@keyframes spin { to { transform: rotate(360deg); } }
.reg-error-msg {
  margin-top: 12px; padding: 12px 16px;
  background: rgba(196,42,54,0.07); border: 1px solid rgba(196,42,54,0.18);
  border-radius: 8px; font-size: 13px; color: var(--c-red); text-align: center;
}
.reg-success-wrap {
  padding: 48px 36px; text-align: center;
}
.reg-success-icon {
  width: 64px; height: 64px; border-radius: 50%;
  background: rgba(22,163,74,0.1); border: 2px solid rgba(22,163,74,0.25);
  color: #16a34a; font-size: 28px;
  display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;
}
.reg-success-title { font-family: var(--f-serif); font-size: 24px; font-weight: 700; color: var(--c-deep); margin-bottom: 10px; }
.reg-success-sub { font-size: 14px; line-height: 1.75; color: var(--c-muted); margin-bottom: 8px; word-break: keep-all; }
.reg-success-count { font-size: 13px; color: var(--c-mid); font-weight: 600; margin-bottom: 28px; }
.reg-success-close {
  display: inline-flex; padding: 12px 32px; background: var(--c-deep); color: #fff;
  border: none; border-radius: 8px; font-size: 14px; font-weight: 700; font-family: var(--f-sans);
  cursor: pointer; transition: background 0.2s;
}
.reg-success-close:hover { background: #015a7a; }

@media (max-width: 600px) {
  .reg-modal-head { padding: 28px 24px 22px; }
  .reg-form-wrap { padding: 20px 24px 28px; }
  .reg-form-grid { grid-template-columns: 1fr; }
}

/* ── REGISTRATION TYPE TABS ── */
.reg-type-tabs {
  display: flex;
  background: #f8fbfd;
  border-bottom: 1.5px solid rgba(0,79,104,0.10);
  padding: 0 36px;
}
.reg-type-tab {
  flex: 1; display: flex; align-items: center; justify-content: center; gap: 8px;
  padding: 14px 0; background: none; border: none; border-bottom: 2.5px solid transparent;
  font-size: 13px; font-weight: 600; color: var(--c-muted);
  font-family: var(--f-sans); cursor: pointer;
  letter-spacing: 0.03em;
  transition: color 0.2s, border-color 0.2s;
  margin-bottom: -1.5px;
}
.reg-type-tab:hover { color: var(--c-mid); }
.reg-type-tab.active { color: var(--c-deep); border-bottom-color: var(--c-red); }
.reg-type-tab svg { flex-shrink: 0; }

@media (max-width: 600px) {
  .reg-type-tabs { padding: 0 24px; }
  .reg-type-tab { font-size: 12px; gap: 6px; padding: 12px 0; }
}

/* ── GROUP NOTICE BOX ── */
.reg-group-notice {
  display: flex; gap: 14px; align-items: flex-start;
  background: rgba(0,79,104,0.05);
  border: 1px solid rgba(0,79,104,0.13);
  border-radius: 10px; padding: 16px 18px; margin-bottom: 20px;
}
.reg-group-notice-icon {
  font-size: 22px; flex-shrink: 0; line-height: 1; margin-top: 2px;
}
.reg-group-notice strong {
  display: block; font-size: 13px; font-weight: 700;
  color: var(--c-deep); margin-bottom: 6px;
}
.reg-group-notice p {
  font-size: 12.5px; color: var(--c-sub);
