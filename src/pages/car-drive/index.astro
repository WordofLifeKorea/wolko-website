---
// 운행 스케줄: 평택센터 멤버가 2주 단위로 오전 픽업 / 드롭오프를 신청한다. 오전 픽업 담당자에게는 아침 8시에 문자가 간다.
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <title>운행 스케줄 — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolko-lang-toggle.css?v=2">
  <link rel="stylesheet" href="/car-log.css?v=7">
  <link rel="stylesheet" href="/car-drive.css?v=6">
  <link rel="stylesheet" href="/wolko-rail.css?v=15">
  <link rel="stylesheet" href="/wolko-header.css?v=12">
  <link rel="stylesheet" href="/wolko-ui.css?v=2">
  <link rel="stylesheet" href="/wolko-layout.css?v=11">
  <script src="/wolko-rail.js?v=24" defer></script>
  <script src="/car-drive.js?v=5" defer></script>
  <meta name="theme-color" content="#004f68">
</head>
<body>
  <header class="car-header">
    <a class="car-header-logo" href="/portal" title="WOLKO 포탈로 돌아가기">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <span data-t="pageTitle">차량 스케줄</span>
    </a>
    <div class="car-header-right">
      <div class="wl-lang-toggle" role="group" aria-label="Language">
        <button type="button" class="wl-lang-btn" id="langKoBtn" aria-label="한국어" title="한국어"><img src="https://flagcdn.com/w20/kr.png" alt=""><span>KO</span></button>
        <button type="button" class="wl-lang-btn" id="langEnBtn" aria-label="English" title="English"><img src="https://flagcdn.com/w20/us.png" alt=""><span>EN</span></button>
      </div>
    </div>
  </header>

  <main class="log-wrap drive-wrap">
    <div class="log-intro">
      <p class="log-kicker">VEHICLE · DRIVING SCHEDULE</p>
      <h1 data-t="h1">운행 스케줄</h1>
      <p data-t="intro">오전 픽업과 드롭오프를 신청하세요. 픽업 당일 아침 8시에 문자로 알려드려요.</p>
    </div>

    <nav class="car-view-tabs car-view-tabs-4" aria-label="차량 메뉴" data-t-aria="menuLabel">
      <a class="car-view-tab is-active" href="/car-drive/" aria-current="page"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg><span data-t="tabDrive">운행 스케줄</span></a>
      <a class="car-view-tab" href="/car-log/"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h5"/></svg><span data-t="tabLog">사용 일지</span></a>
      <a class="car-view-tab" href="/car/"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><span data-t="tabReservations">예약현황</span></a>
      <a class="car-view-tab" href="/car/?view=maintenance"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg><span data-t="tabMaintenance">정비 관리</span></a>
    </nav>
    <p class="log-loading" id="loadStatus" data-t="loading">불러오는 중…</p>

    <section class="log-panel" id="loginPanel" hidden>
      <div class="log-panel-head"><span class="log-step">01</span><h2 data-t="loginTitle">포탈 로그인</h2></div>
      <p class="log-help" data-t="loginHelp">평택센터 멤버의 포탈 계정으로 로그인해 주세요.</p>
      <form id="loginForm" class="log-form">
        <label><span data-t="email">이메일</span><input id="loginEmail" type="email" autocomplete="username" required></label>
        <label><span data-t="password">비밀번호</span><input id="loginPassword" type="password" autocomplete="current-password" required></label>
        <button class="log-primary" type="submit" data-t="loginBtn">로그인하고 계속하기</button>
      </form>
      <p class="log-error" id="loginError" role="alert"></p>
    </section>

    <section class="log-panel" id="deniedPanel" hidden>
      <h2 data-t="deniedTitle">평택센터 멤버 전용이에요</h2>
      <p class="log-help" data-t="deniedHelp">이 스케줄은 평택센터 멤버만 사용할 수 있어요. 소속이 맞는데 이 안내가 보이면 관리자에게 문의해 주세요.</p>
    </section>

    <div id="driveApp" hidden>
      <div class="drive-bar">
        <button type="button" class="drive-nav" id="prevPeriod" aria-label="prev">‹</button>
        <div class="drive-period"><strong id="periodLabel"></strong></div>
        <button type="button" class="drive-nav" id="nextPeriod" aria-label="next">›</button>
        <button type="button" class="drive-today" id="thisPeriod" data-t="thisPeriod">오늘로</button>
      </div>
      <div id="weeks"></div>
      <p class="drive-note" data-t="note">빈 칸을 누르면 바로 신청돼요 · 내 칸을 다시 누르면 취소돼요</p>
      <p class="log-error" id="driveError" role="alert"></p>
    </div>
  </main>

  <div class="drive-modal" id="phoneModal" hidden role="dialog" aria-modal="true" aria-labelledby="phoneTitle">
    <div class="drive-modal-card">
      <h3 id="phoneTitle" data-t="phoneTitle">오전 픽업 알림 문자</h3>
      <p class="log-help" data-t="phoneHelp">픽업 당일 아침 8시에 이 번호로 문자를 보내드려요.</p>
      <p class="drive-modal-when" id="phoneWhen"></p>
      <label><span data-t="phoneLabel">휴대폰 번호</span><input id="phoneInput" type="tel" inputmode="tel" autocomplete="tel" placeholder="010-1234-5678"></label>
      <p class="log-error" id="phoneError" role="alert"></p>
      <div class="drive-modal-actions">
        <button type="button" class="log-secondary" id="phoneCancel" data-t="cancel">취소</button>
        <button type="button" class="log-primary" id="phoneOk" data-t="signUp">신청하기</button>
      </div>
    </div>
  </div>
</body>
</html>
