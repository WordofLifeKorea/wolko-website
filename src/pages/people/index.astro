---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="섬기는이 — WOLKO 월코" activeNav="about" whiteNav={true}>
  <style>
    .wp-wrap {
      --wp-blue-deep: #004f68; --wp-blue-mid: #007ea1; --wp-blue-light: #73d1f5;
      --wp-red: #c42a36; --wp-gray-bg: #f4f7fa; --wp-gray-line: #e0e8ef;
      --wp-text-main: #1a2634; --wp-text-sub: #4a6070; --wp-text-light: #8fa8b8;
      --wp-white: #ffffff;
      --wp-card-shadow: 0 4px 20px rgba(0,79,104,0.10);
      --wp-card-shadow-hover: 0 10px 36px rgba(0,79,104,0.18);
      --wp-radius: 14px;
      font-family: 'Noto Sans KR', 'Apple SD Gothic Neo', sans-serif;
      color: var(--wp-text-main);
      background: var(--wp-white);
    }

    /* Hero */
    .wp-hero { position: relative; background: linear-gradient(135deg, var(--wp-blue-deep) 0%, var(--wp-blue-mid) 100%); padding: 80px 24px 70px; text-align: center; overflow: hidden; }
    .wp-hero::before { content: ''; position: absolute; inset: 0; background: url("data:image/svg+xml,%3Csvg width='60' height='60' xmlns='http://www.w3.org/2000/svg'%3E%3Ccircle cx='30' cy='30' r='1.5' fill='rgba(255,255,255,0.07)'/%3E%3C/svg%3E") repeat; }
    .wp-hero-label { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: var(--wp-blue-light); margin-bottom: 16px; position: relative; }
    .wp-hero-title { font-size: clamp(32px, 5vw, 52px); font-weight: 800; color: var(--wp-white); line-height: 1.15; position: relative; margin-bottom: 12px; }
    .wp-hero-title em { font-style: normal; color: var(--wp-blue-light); }
    .wp-hero-sub { font-size: 15px; color: rgba(255,255,255,0.7); position: relative; letter-spacing: 0.3px; }

    /* Accordion */
    .wp-accordion-wrap { max-width: 1080px; margin: 0 auto; padding: 48px 24px 72px; display: flex; flex-direction: column; gap: 16px; }
    .wp-acc-item { border-radius: var(--wp-radius); overflow: hidden; box-shadow: var(--wp-card-shadow); background: var(--wp-white); }
    .wp-acc-trigger { width: 100%; display: flex; align-items: center; gap: 16px; padding: 24px 28px; background: var(--wp-white); border: none; cursor: pointer; text-align: left; transition: background 0.2s; }
    .wp-acc-trigger:hover { background: var(--wp-gray-bg); }
    .wp-loc-badge { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 10px; background: var(--wp-blue-deep); color: var(--wp-white); font-size: 17px; font-weight: 900; flex-shrink: 0; }
    .wp-acc-item.wp-acc-jeju .wp-loc-badge { background: var(--wp-blue-mid); }
    .wp-acc-label { flex: 1; min-width: 0; }
    .wp-loc-text-en { font-size: 10px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--wp-blue-mid); margin-bottom: 3px; }
    .wp-loc-text-ko { font-size: 20px; font-weight: 800; color: var(--wp-text-main); line-height: 1; }
    .wp-acc-meta { font-size: 12px; color: var(--wp-text-light); font-weight: 600; white-space: nowrap; margin-right: 12px; }
    .wp-acc-chevron { width: 28px; height: 28px; border-radius: 50%; background: var(--wp-gray-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.2s; }
    .wp-acc-chevron svg { display: block; transition: transform 0.35s ease; }
    .wp-acc-chevron svg path { stroke: var(--wp-blue-deep); }
    .wp-acc-item.wp-acc-open .wp-acc-chevron { background: var(--wp-blue-deep); }
    .wp-acc-item.wp-acc-open .wp-acc-chevron svg path { stroke: #fff; }
    .wp-acc-item.wp-acc-open .wp-acc-chevron svg { transform: rotate(180deg); }
    .wp-acc-item.wp-acc-jeju.wp-acc-open .wp-acc-chevron { background: var(--wp-blue-mid); }
    .wp-acc-body { max-height: 0; overflow: hidden; transition: max-height 0.45s cubic-bezier(0.4,0,0.2,1); }
    .wp-acc-item.wp-acc-open .wp-acc-body { max-height: 4000px; }
    .wp-acc-inner { padding: 36px 28px 40px; border-top: 1px solid var(--wp-gray-line); }

    /* Group */
    .wp-group { margin-bottom: 56px; }
    .wp-group:last-child { margin-bottom: 0; }
    .wp-group-title { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
    .wp-group-title-bar { width: 4px; height: 22px; border-radius: 3px; background: var(--wp-blue-deep); flex-shrink: 0; }
    .wp-group-title-ko { font-size: 17px; font-weight: 800; color: var(--wp-text-main); }
    .wp-group-title-en { font-size: 12px; font-weight: 600; color: var(--wp-text-light); letter-spacing: 1px; text-transform: uppercase; }
    .wp-group-count { margin-left: auto; font-size: 12px; color: var(--wp-text-light); font-weight: 600; background: var(--wp-gray-bg); padding: 3px 10px; border-radius: 20px; }

    /* Card Grid */
    .wp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .wp-card { background: var(--wp-white); border-radius: var(--wp-radius); overflow: hidden; box-shadow: var(--wp-card-shadow); text-decoration: none; display: block; transition: transform 0.25s, box-shadow 0.25s; opacity: 0; transform: translateY(20px); }
    .wp-card.wp-visible { opacity: 1; transform: translateY(0); transition: opacity 0.5s ease, transform 0.5s ease, box-shadow 0.25s; }
    .wp-card:hover { transform: translateY(-5px); box-shadow: var(--wp-card-shadow-hover); }
    .wp-card-photo-wrap { position: relative; width: 100%; padding-top: 100%; background: var(--wp-gray-bg); overflow: hidden; }
    .wp-card-photo-wrap img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
    .wp-card:hover .wp-card-photo-wrap img { transform: scale(1.05); }
    .wp-card-role-badge { position: absolute; bottom: 10px; left: 10px; background: rgba(0,79,104,0.85); color: var(--wp-white); font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; backdrop-filter: blur(4px); }
    .wp-card-role-badge.wp-badge-director { background: rgba(196,42,54,0.9); }
    .wp-card-info { padding: 18px 18px 20px; }
    .wp-card-name { font-size: 15px; font-weight: 800; color: var(--wp-text-main); margin-bottom: 5px; line-height: 1.35; }
    .wp-card-title { font-size: 12px; color: var(--wp-text-sub); line-height: 1.5; }
    .wp-card-arrow { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; color: var(--wp-blue-mid); margin-top: 10px; letter-spacing: 0.5px; }
    .wp-card-arrow::after { content: '→'; transition: transform 0.2s; }
    .wp-card:hover .wp-card-arrow::after { transform: translateX(3px); }

    @media (max-width: 860px) {
      .wp-grid { grid-template-columns: repeat(2, 1fr); gap: 18px; }
      .wp-accordion-wrap { padding: 32px 16px 56px; }
      .wp-acc-trigger { padding: 20px; }
      .wp-acc-inner { padding: 28px 16px 32px; }
    }
    @media (max-width: 540px) {
      .wp-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .wp-card-info { padding: 12px 12px 14px; }
      .wp-card-name { font-size: 13px; }
      .wp-acc-meta { display: none; }
    }
    @media (max-width: 380px) { .wp-grid { grid-template-columns: 1fr; } }
  </style>

