    .pp-bar { position: sticky; top: var(--pp-bar-top, 84px); z-index: 20; transition: transform .3s cubic-bezier(.2,.7,.2,1); background: rgba(244,241,234,.94); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--pp-line); }
    .pp-bar-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 14px 0; }
