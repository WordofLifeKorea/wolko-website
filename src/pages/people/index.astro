---
// 섬기는이 — Claude Design 'A · 갤러리형' 시안을 옮긴 페이지.
// 남색 첫 화면(큰 제목 · 숫자) → 거르기 막대(사역 거점 · 역할, 화면을 내려도 따라온다)
// → 두 거점의 대표 → 거점별 사진 카드 → 함께 섬기기 띠.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTeam = (await getCollection('team')).filter(p => p.data.active !== false);
const byOrder = (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99);
const isDirector = (p) => (p.data.role_badge || '').includes('Director');
const locOf = (p) => (p.data.campus === 'pyeongtaek' ? 'pt' : 'jj');

// 카드 위 직책 표시 — 한글 화면은 한글, 영어 화면은 영어
const ROLE_KO = { Staff: '간사', Intern: '인턴', Missionaries: '선교사', Missionary: '선교사', 'Field Director': '필드 디렉터', 'Jeju Director': '제주 디렉터' };
const roleKo = (v) => ROLE_KO[v] || v || '';
const initialOf = (p) => (p.data.name_ko || p.data.name_en || '?').trim().charAt(0);

const leads = allTeam.filter(isDirector).sort((a, b) => (locOf(a) === locOf(b) ? byOrder(a, b) : locOf(a) === 'pt' ? -1 : 1));
const groups = [
  { loc: 'pt', num: '01', placeKo: '경기 평택', placeEn: 'Pyeongtaek, Gyeonggi', ko: '평택 월코센터', en: 'Pyeongtaek WOLKO Center' },
  { loc: 'jj', num: '02', placeKo: '제주 애월', placeEn: 'Aewol, Jeju', ko: '제주 월비', en: 'Jeju WOLBI' },
].map(g => ({
  ...g,
  people: allTeam.filter(p => locOf(p) === g.loc && !isDirector(p))
    .sort((a, b) => (a.data.category === b.data.category ? byOrder(a, b) : a.data.category === 'missionary' ? -1 : 1)),
}));
const counts = {
  all: allTeam.length,
  pt: allTeam.filter(p => locOf(p) === 'pt').length,
  jj: allTeam.filter(p => locOf(p) === 'jj').length,
  missionary: allTeam.filter(p => p.data.category === 'missionary').length,
  stw: allTeam.filter(p => p.data.category === 'stw').length,
};
---

<BaseLayout title="섬기는이 — WOLKO 월코" activeNav="about">
  <div class="pp">

    <header class="pp-hero">
      <div class="pp-shell pp-hero-grid">
        <div class="pp-hero-text">
          <p class="pp-eyebrow"><span class="wl-ko">섬기는이 · OUR TEAM</span><span class="wl-en">OUR TEAM</span></p>
          <h1><span class="wl-ko">함께 섬기는<br>사람들</span><span class="wl-en">Meet Our<br>Ministry Team</span></h1>
          <p class="pp-lead-copy">
            <span class="wl-ko">하나님의 부르심을 따라 다음 세대를 위해 헌신하는 월코의 사역자들을 소개합니다.</span>
            <span class="wl-en">Called by God and committed to the next generation, meet the people of Word of Life Korea.</span>
          </p>
        </div>
        <dl class="pp-stats">
          <div><dt><span class="wl-ko">선교사</span><span class="wl-en">Missionaries</span></dt><dd>{counts.missionary}</dd></div>
          <div><dt><span class="wl-ko">단기 사역자</span><span class="wl-en">Short-term</span></dt><dd>{counts.stw}</dd></div>
          <div><dt><span class="wl-ko">사역 거점</span><span class="wl-en">Locations</span></dt><dd>2</dd></div>
        </dl>
      </div>
    </header>

    <nav class="pp-bar" aria-label="섬기는이 거르기">
      <div class="pp-shell pp-bar-inner">
        <div class="pp-seg" role="group" aria-label="사역 거점">
          <button type="button" class="is-on" data-loc="all" aria-pressed="true"><span class="wl-ko">전체</span><span class="wl-en">All</span> <em>{counts.all}</em></button>
          <button type="button" data-loc="pt" aria-pressed="false"><span class="wl-ko">평택 월코센터</span><span class="wl-en">Pyeongtaek</span> <em>{counts.pt}</em></button>
          <button type="button" data-loc="jj" aria-pressed="false"><span class="wl-ko">제주 월비</span><span class="wl-en">Jeju</span> <em>{counts.jj}</em></button>
        </div>
        <div class="pp-chips" role="group" aria-label="역할">
          <button type="button" class="is-on" data-role="all" aria-pressed="true"><span class="wl-ko">모두</span><span class="wl-en">Everyone</span></button>
          <button type="button" data-role="missionary" aria-pressed="false"><span class="wl-ko">선교사</span><span class="wl-en">Missionaries</span></button>
          <button type="button" data-role="stw" aria-pressed="false"><span class="wl-ko">단기 사역자</span><span class="wl-en">Short-term</span></button>
        </div>
      </div>
    </nav>

    <main class="pp-shell pp-main">
      <section class="pp-leads-sec" data-leads>
        <p class="pp-kicker"><span class="wl-ko">LEADERSHIP · 대표</span><span class="wl-en">LEADERSHIP</span></p>
        <div class="pp-leads">
          {leads.map((p) => (
            <a href={`/team/${p.slug}`} class="pp-card pp-lead" data-loc={locOf(p)} data-role={p.data.category}>
              <span class="pp-lead-photo">
                {p.data.photo_url ? <img src={p.data.photo_url} alt={p.data.name_ko} loading="lazy" style={p.data.photo_position ? `object-position: ${p.data.photo_position}` : undefined} /> : <span class="pp-initial">{initialOf(p)}</span>}
              </span>
              <span class="pp-lead-body">
                <span class="pp-lead-badge"><span class="wl-ko">{roleKo(p.data.role_badge)}</span><span class="wl-en">{p.data.role_badge}</span></span>
                <span class="pp-lead-name"><span class="wl-ko">{p.data.name_ko}</span><span class="wl-en">{p.data.name_en}</span></span>
                <span class="pp-lead-sub"><span class="wl-ko">{p.data.name_en}</span><span class="wl-en">{p.data.name_ko}</span></span>
                <span class="pp-lead-title"><span class="wl-ko">{p.data.title_ko}</span><span class="wl-en">{p.data.title_en}</span></span>
                <span class="pp-go"><span class="wl-ko">프로필 보기</span><span class="wl-en">View profile</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg></span>
              </span>
            </a>
          ))}
        </div>
      </section>

      {groups.map((g) => (
        <section class="pp-group" data-group={g.loc} id={g.loc === 'pt' ? 'wp-pyeongtaek' : 'wp-jeju'}>
          <div class="pp-group-head">
            <div>
              <p class="pp-group-place"><span class="pp-group-num">{g.num}</span><span class="wl-ko">{g.placeKo}</span><span class="wl-en">{g.placeEn}</span></p>
              <h2><span class="wl-ko">{g.ko}</span><span class="wl-en">{g.en}</span></h2>
            </div>
            <p class="pp-group-count"><span data-count>{g.people.length}</span><span class="wl-ko">명</span><span class="wl-en"> people</span></p>
          </div>
          <ul class="pp-grid">
            {g.people.map((p) => (
              <li data-loc={locOf(p)} data-role={p.data.category}>
                <a href={`/team/${p.slug}`} class="pp-card">
                  <span class="pp-photo">
                    {p.data.photo_url ? <img src={p.data.photo_url} alt={p.data.name_ko} loading="lazy" style={p.data.photo_position ? `object-position: ${p.data.photo_position}` : undefined} /> : <span class="pp-initial">{initialOf(p)}</span>}
                    <span class="pp-badge"><span class="wl-ko">{roleKo(p.data.role_badge)}</span><span class="wl-en">{p.data.role_badge}</span></span>
                  </span>
                  <span class="pp-info">
                    <span class="pp-name"><span class="wl-ko">{p.data.name_ko}</span><span class="wl-en">{p.data.name_en}</span></span>
                    <span class="pp-en"><span class="wl-ko">{p.data.name_en}</span><span class="wl-en">{p.data.name_ko}</span></span>
                    <span class="pp-title"><span class="wl-ko">{p.data.title_ko}</span><span class="wl-en">{p.data.title_en}</span></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <p class="pp-empty" hidden><span class="wl-ko">조건에 맞는 사람이 없어요.</span><span class="wl-en">No one matches this filter.</span></p>

      <section class="pp-join">
        <div>
          <p class="pp-join-kicker">JOIN US</p>
          <p class="pp-join-title"><span class="wl-ko">다음 세대를 함께 섬길<br>동역자를 기다립니다</span><span class="wl-en">Serve the next generation<br>with us</span></p>
        </div>
        <div class="pp-join-btns">
          <a href="/camp-register#staff-recruit" class="pp-btn pp-btn--light"><span class="wl-ko">캠프 스태프 지원</span><span class="wl-en">Apply as camp staff</span></a>
          <a href="/give" class="pp-btn pp-btn--ghost"><span class="wl-ko">선교사 후원하기</span><span class="wl-en">Support a missionary</span></a>
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    // 거르기: 사역 거점(전체 · 평택 · 제주) × 역할(모두 · 선교사 · 단기 사역자). 사람이 없는 칸은 통째로 숨긴다
    (function () {
      var root = document.querySelector('.pp'); if (!root) return;
      var state = { loc: 'all', role: 'all' };
      function match(el) { return (state.loc === 'all' || el.dataset.loc === state.loc) && (state.role === 'all' || el.dataset.role === state.role); }
      function apply() {
        root.querySelectorAll('button[data-loc]').forEach(function (b) { var on = b.dataset.loc === state.loc; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); });
        root.querySelectorAll('button[data-role]').forEach(function (b) { var on = b.dataset.role === state.role; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); });
        var anyLead = false;
        root.querySelectorAll('.pp-lead').forEach(function (c) { var ok = match(c); c.hidden = !ok; anyLead = anyLead || ok; });
        root.querySelector('[data-leads]').hidden = !anyLead;
        var total = 0;
        root.querySelectorAll('.pp-group').forEach(function (g) {
          var n = 0; g.querySelectorAll('li[data-loc]').forEach(function (li) { var ok = match(li); li.hidden = !ok; if (ok) n++; });
          g.hidden = !n; g.querySelector('[data-count]').textContent = n; total += n;
        });
        root.querySelector('.pp-empty').hidden = !!(total || anyLead);
      }
      root.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('button[data-loc], button[data-role]'); if (!b) return;
        if (b.dataset.loc) state.loc = b.dataset.loc; else state.role = b.dataset.role;
        apply();
      });
    })();
  </script>

  <style>
    .pp { --pp-navy: #0b2430; --pp-deep: #004f68; --pp-cream: #f4f1ea; --pp-line: #e2ddd2; --pp-text: #3e535d; --pp-muted: #6b7d86;
      background: var(--pp-cream); color: #10252e; font-family: var(--ff-sans); word-break: keep-all; overflow: clip; }
    .pp-shell { width: min(1240px, calc(100% - 96px)); margin-inline: auto; }

    /* 첫 화면 */
    .pp-hero { background: var(--pp-navy); color: #fff; padding-top: 168px; }
    .pp-hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 56px; align-items: end; padding-bottom: 72px; }
    .pp-hero-text { display: flex; flex-direction: column; gap: 22px; }
    .pp-eyebrow { display: flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 800; letter-spacing: .16em; color: #8fd0e4; }
    .pp-eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; }
    .pp-hero h1 { font-family: var(--ff-serif); font-size: clamp(42px, 5vw, 64px); font-weight: 900; line-height: 1.12; letter-spacing: -.035em; color: #fff; }
    .pp-lead-copy { max-width: 520px; font-size: 17px; line-height: 1.8; color: rgba(255,255,255,.78); }
    .pp-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid rgba(255,255,255,.18); }
    .pp-stats > div { padding: 18px 0 0 20px; border-left: 1px solid rgba(255,255,255,.14); }
    .pp-stats > div:first-child { padding-left: 0; border-left: 0; }
    .pp-stats dt { font-size: 12px; font-weight: 700; color: rgba(255,255,255,.6); }
    .pp-stats dd { margin: 8px 0 0; font-family: var(--ff-serif); font-size: 44px; font-weight: 900; line-height: 1; }

    /* 거르기 막대 — 위 메뉴 아래에 붙어 따라온다 */
    .pp-bar { position: sticky; top: 84px; z-index: 20; background: rgba(244,241,234,.94); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); border-bottom: 1px solid var(--pp-line); }
    .pp-bar-inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; padding: 14px 0; }
    .pp-seg { display: inline-flex; gap: 4px; padding: 4px; background: #fff; border: 1px solid var(--pp-line); border-radius: 12px; }
    .pp-seg button { min-height: 40px; padding: 0 16px; border: 0; border-radius: 9px; background: transparent; color: var(--pp-text); font: 800 14px/1 var(--ff-sans); cursor: pointer; transition: background-color .2s, color .2s; }
    .pp-seg button em { font-style: normal; font-weight: 700; opacity: .6; }
    .pp-seg button.is-on { background: var(--pp-navy); color: #fff; }
    .pp-chips { display: inline-flex; gap: 8px; flex-wrap: wrap; }
    .pp-chips button { min-height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--pp-line); background: #fff; color: var(--pp-text); font: 700 13.5px/1 var(--ff-sans); cursor: pointer; transition: background-color .2s, color .2s, border-color .2s; }
    .pp-chips button.is-on { background: var(--pp-deep); border-color: var(--pp-deep); color: #fff; }
    .pp-seg button:focus-visible, .pp-chips button:focus-visible, .pp-card:focus-visible { outline: 2px solid var(--pp-deep); outline-offset: 3px; }

    .pp-main { display: flex; flex-direction: column; gap: 80px; padding: 64px 0 96px; }
    .pp-kicker { font-size: 13px; font-weight: 800; letter-spacing: .14em; color: var(--pp-deep); margin-bottom: 22px; }
    [hidden] { display: none !important; }

    /* 카드 공통: 마우스를 올리면 살짝 떠오르고 사진이 커진다 */
    .pp-card { display: flex; text-decoration: none; color: inherit; border-radius: 16px; transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s; }
    .pp-card img { transition: transform .9s cubic-bezier(.2,.7,.2,1); }
    .pp-card:hover { transform: translateY(-6px); }
    .pp-card:hover img { transform: scale(1.05); }
    .pp-initial { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--ff-serif); font-size: 52px; font-weight: 700; color: #a3b6c0; }

    /* 대표 */
    .pp-leads { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
    .pp-lead { display: grid; grid-template-columns: 200px minmax(0, 1fr); background: #fff; border: 1px solid #e7e2d8; border-radius: 18px; overflow: hidden; }
    .pp-lead:hover { box-shadow: 0 22px 40px -22px rgba(11,36,48,.45); }
    .pp-lead-photo { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: #e7e2d8; }
    .pp-lead-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
    .pp-lead-body { display: flex; flex-direction: column; justify-content: center; gap: 10px; padding: 28px; }
    .pp-lead-badge { align-self: flex-start; padding: 4px 10px; border-radius: 999px; background: var(--pp-navy); color: #fff; font-size: 11.5px; font-weight: 800; letter-spacing: .06em; }
    .pp-lead-name { font-family: var(--ff-serif); font-size: 26px; font-weight: 900; letter-spacing: -.02em; color: var(--pp-navy); line-height: 1.25; }
    .pp-lead-sub { font-size: 13px; color: var(--pp-muted); font-weight: 600; }
    .pp-lead-title { font-size: 14.5px; color: var(--pp-text); line-height: 1.6; }
    .pp-go { margin-top: 6px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 800; color: var(--pp-deep); transition: gap .25s; }
    .pp-go svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .pp-lead:hover .pp-go { gap: 10px; }

    /* 거점별 */
    .pp-group { display: flex; flex-direction: column; gap: 28px; scroll-margin-top: 160px; }
    .pp-group-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding-bottom: 18px; border-bottom: 2px solid var(--pp-navy); }
    .pp-group-place { display: flex; align-items: baseline; gap: 12px; font-size: 12px; font-weight: 800; letter-spacing: .14em; color: #5a7380; }
    .pp-group-num { font-family: var(--ff-serif); font-size: 15px; letter-spacing: 0; color: var(--pp-deep); }
    .pp-group h2 { margin-top: 10px; font-family: var(--ff-serif); font-size: clamp(28px, 3vw, 36px); font-weight: 900; letter-spacing: -.03em; color: var(--pp-navy); }
    .pp-group-count { font-size: 14px; font-weight: 700; color: #5a7380; }
    .pp-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px 24px; }
    .pp-grid .pp-card { flex-direction: column; height: 100%; }
    .pp-photo { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; border-radius: 16px; background: #e7e2d8; isolation: isolate; }
    .pp-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
    .pp-badge { position: absolute; left: 10px; top: 10px; z-index: 1; padding: 4px 9px; border-radius: 999px; background: rgba(255,255,255,.92); font-size: 11px; font-weight: 800; color: var(--pp-navy); }
    .pp-info { display: flex; flex-direction: column; gap: 5px; padding: 14px 2px 0; }
    .pp-name { font-size: 17px; font-weight: 800; letter-spacing: -.01em; color: var(--pp-navy); line-height: 1.35; }
    .pp-en { font-size: 12.5px; color: var(--pp-muted); font-weight: 600; }
    .pp-title { font-size: 13.5px; color: var(--pp-text); line-height: 1.55; }
    .pp-empty { text-align: center; color: var(--pp-muted); font-weight: 700; }

    /* 함께 섬기기 */
    .pp-join { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; align-items: center; padding: 40px; background: var(--pp-navy); border-radius: 22px; color: #fff; }
    .pp-join-kicker { font-size: 12px; font-weight: 800; letter-spacing: .16em; color: #8fd0e4; }
    .pp-join-title { margin-top: 10px; font-family: var(--ff-serif); font-size: 28px; font-weight: 900; line-height: 1.35; letter-spacing: -.02em; }
    .pp-join-btns { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .pp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; border-radius: 10px; font-weight: 800; font-size: 15px; text-decoration: none; transition: background-color .2s, color .2s; }
    .pp-btn--light { background: #fff; color: var(--pp-navy); }
    .pp-btn--light:hover { background: #dff1f6; color: var(--pp-navy); }
    .pp-btn--ghost { border: 1px solid rgba(255,255,255,.4); color: #fff; }
    .pp-btn--ghost:hover { background: rgba(255,255,255,.1); color: #fff; }

    @media (max-width: 1100px) { .pp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @media (max-width: 900px) { .pp-bar { top: 72px; } }
    @media (max-width: 760px) {
      .pp-shell { width: calc(100% - 40px); }
      .pp-hero { padding-top: 120px; }
      .pp-hero-grid { grid-template-columns: 1fr; gap: 28px; padding-bottom: 36px; }
      .pp-stats dd { font-size: 34px; }
      .pp-bar-inner { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
      .pp-bar-inner::-webkit-scrollbar { display: none; }
      .pp-seg, .pp-chips { flex: none; flex-wrap: nowrap; }
      .pp-seg button, .pp-chips button { white-space: nowrap; }
      .pp-main { gap: 56px; padding: 40px 0 72px; }
      .pp-leads { grid-template-columns: 1fr; }
      .pp-lead { grid-template-columns: 120px minmax(0, 1fr); }
      .pp-lead-body { padding: 18px; gap: 6px; }
      .pp-lead-name { font-size: 20px; }
      .pp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 12px; }
      .pp-name { font-size: 15.5px; }
      .pp-title { font-size: 12.5px; }
      .pp-join { padding: 28px 22px; }
      .pp-join-btns { justify-content: flex-start; }
    }
    @media (hover: none) { .pp-card:hover { transform: none; } .pp-card:hover img { transform: none; } }
    @media (prefers-reduced-motion: reduce) { .pp-card, .pp-card img, .pp-go { transition: none; } }
  </style>
</BaseLayout>
