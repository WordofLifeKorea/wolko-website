  <script is:inline>
    // 섬기는이 히어로 움직임: 사진이 천천히 자리 잡고 글이 차례로 떠오르며, 숫자는 0부터 올라간다.
    // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.documentElement.classList.add('wl-motion');
      var counters = [].slice.call(document.querySelectorAll('.wp-hero [data-count-from]'));
      counters.forEach(function (el) { el.dataset.countTo = el.textContent.trim(); el.textContent = el.dataset.countFrom; });
      function count(el) {
        var from = +el.dataset.countFrom, to = +el.dataset.countTo, dur = 2000;
        setTimeout(function () {
          var t0 = Date.now();
          (function step() {
            var k = Math.min(1, (Date.now() - t0) / dur), e = 1 - Math.pow(1 - k, 4);
            el.textContent = Math.round(from + (to - from) * e);
            if (k < 1) setTimeout(step, 30);
          })();
        }, 1400);                                   // 아래 줄이 떠오른 뒤에
      }
      var cio = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { cio.unobserve(en.target); count(en.target); } });
      }, { threshold: 0.6 });
      counters.forEach(function (el) { cio.observe(el); });
    })();
  </script>

  <script>
    // 아코디언
    document.querySelectorAll('.wp-acc-trigger').forEach(btn => {
      btn.addEventListener('click', () => {
        const item = btn.closest('.wp-acc-item');
        const isOpen = item.classList.contains('wp-acc-open');
        item.classList.toggle('wp-acc-open', !isOpen);
        btn.setAttribute('aria-expanded', String(!isOpen));
      });
    });

    // 카드 스크롤 reveal
    const cards = document.querySelectorAll('.wp-card');
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            const el = entry.target;
            const delay = (parseInt(el.dataset.wpDelay) || 0) * 80;
            setTimeout(() => el.classList.add('wp-visible'), delay);
            io.unobserve(el);
          }
        });
      }, { threshold: 0.08 });
      cards.forEach((card, i) => { card.dataset.wpDelay = i % 3; io.observe(card); });
    } else {
      cards.forEach(c => c.classList.add('wp-visible'));
    }
  </script>
</BaseLayout>
