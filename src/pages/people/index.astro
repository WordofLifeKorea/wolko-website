    /* 카드 공통: 마우스를 올리면 살짝 떠오르고 사진이 커진다 */
    .pp-card { display: flex; text-decoration: none; color: inherit; border-radius: 16px; transition: transform .35s cubic-bezier(.2,.7,.2,1), box-shadow .35s; }
