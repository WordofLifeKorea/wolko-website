    .pp-lead-sub { font-size: 13px; color: var(--pp-muted); font-weight: 500; }
    .pp-lead-title { font-size: 14.5px; font-weight: 600; color: #2c4450; line-height: 1.6; }
    .pp-go { margin-top: 6px; display: inline-flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 800; color: var(--pp-deep); transition: gap .25s; }
    .pp-go svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .pp-lead:hover .pp-go { gap: 10px; }

    /* 거점별 */
    .pp-group { display: flex; flex-direction: column; gap: 28px; scroll-margin-top: 160px; }
    .pp-group-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding-bottom: 18px; border-bottom: 2px solid var(--pp-navy); }
    .pp-group-place { display: flex; align-items: baseline; gap: 12px; font-size: 12px; font-weight: 800; letter-spacing: .14em; color: #5a7380; }
    .pp-group-num { font-family: var(--ff-serif); font-size: 15px; letter-spacing: 0; color: var(--pp-deep); }
    .pp-group h2 { margin-top: 10px; font-family: var(--ff-serif); font-size: clamp(28px, 3vw, 36px); font-weight: 900; letter-spacing: -.03em; color: var(--pp-navy); }
    .pp-group-count { flex: none; white-space: nowrap; font-size: 14px; font-weight: 700; color: #5a7380; }
    .pp-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px 24px; }
    .pp-grid .pp-card { flex-direction: column; height: 100%; }
    .pp-photo { position: relative; display: block; aspect-ratio: 1 / 1; overflow: hidden; border-radius: 16px; background: #e7e2d8; isolation: isolate; }
    .pp-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top; display: block; }
    .pp-badge { position: absolute; left: 10px; top: 10px; z-index: 1; padding: 4px 9px; border-radius: 999px; background: rgba(255,255,255,.92); font-size: 11px; font-weight: 800; color: var(--pp-navy); }
    .pp-info { display: flex; flex-direction: column; gap: 5px; padding: 14px 2px 0; }
    .pp-name { font-size: 17px; font-weight: 800; letter-spacing: -.01em; color: var(--pp-navy); line-height: 1.35; }
    .pp-en { font-size: 12.5px; color: var(--pp-muted); font-weight: 500; }
    .pp-title { font-size: 13.5px; font-weight: 600; color: #2c4450; line-height: 1.55; }
    .pp-empty { text-align: center; color: var(--pp-muted); font-weight: 700; }

    /* 함께 섬기기 */
    .pp-join { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 20px; align-items: center; padding: 40px; background: var(--pp-navy); border-radius: 22px; color: #fff; }
    .pp-join-kicker { font-size: 12px; font-weight: 800; letter-spacing: .16em; color: #8fd0e4; }
    .pp-join-title { margin-top: 10px; font-family: var(--ff-serif); font-size: 28px; font-weight: 900; line-height: 1.35; letter-spacing: -.02em; }
    .pp-join-btns { display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
    .pp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 22px; border-radius: 10px; font-weight: 800; font-size: 15px; text-decoration: none; transition: background-color .2s, color .2s; }
    .pp-btn--light { background: #fff; color: var(--pp-navy); }
    .pp-btn--light:hover { background: #dff1f6; color: var(--pp-navy); }
    .pp-btn--ghost { border: 1px solid rgba(255,255,255,.4); color: #fff; }
    .pp-btn--ghost:hover { background: rgba(255,255,255,.1); color: #fff; }

    @media (max-width: 1100px) {
      .pp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      /* 두 장을 나란히 두면 글 칸이 너무 좁아져 한 줄에 한 장씩 */
