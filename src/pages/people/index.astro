      .pp-bar.is-tucked { transform: translateY(calc(-100% - var(--pp-bar-top, 72px))); }
    }
    @media (max-width: 760px) {
      .pp-shell { width: calc(100% - 40px); }
      .pp-hero { padding-top: 116px; }
      .pp-hero-grid { grid-template-columns: 1fr; gap: 12px; padding-bottom: 32px; }
      .pp-stats dd { font-size: 34px; }
      .pp-map { height: 320px; margin-right: 110px; }
