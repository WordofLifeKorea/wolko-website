---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allTeam = (await getCollection('team')).filter(p => p.data.active !== false);

// 캠퍼스 + 구분별 그룹화 & 정렬
const pyMissionary = allTeam
  .filter(p => p.data.campus === 'pyeongtaek' && p.data.category === 'missionary')
  .sort((a, b) => a.data.order - b.data.order);
const pyStw = allTeam
  .filter(p => p.data.campus === 'pyeongtaek' && p.data.category === 'stw')
  .sort((a, b) => a.data.order - b.data.order);
const jejuMissionary = allTeam
  .filter(p => p.data.campus === 'jeju' && p.data.category === 'missionary')
  .sort((a, b) => a.data.order - b.data.order);
const jejuStw = allTeam
  .filter(p => p.data.campus === 'jeju' && p.data.category === 'stw')
  .sort((a, b) => a.data.order - b.data.order);

// 카드 위 직책 배지 — 한글 화면에서는 한글, 영어 화면에서는 영어로만 보이게 한다(role_badge 는 영어 값).
const ROLE_BADGE_KO = { Staff: '스태프', Intern: '인턴', Missionaries: '선교사', Missionary: '선교사', 'Field Director': '필드 디렉터', 'Jeju Director': '제주 디렉터' };
const roleBadgeKo = (value) => ROLE_BADGE_KO[value] || value;
---

<BaseLayout title="섬기는이 — WOLKO 월코" activeNav="about">
  <style>
    .wp-wrap {
      --wp-blue-deep: #004f68; --wp-blue-mid: #007ea1; --wp-blue-light: #73d1f5;
      --wp-red: #c42a36; --wp-gray-bg: #f4f7fa; --wp-gray-line: #e0e8ef;
      --wp-text-main: #1a2634; --wp-text-sub: #4a6070; --wp-text-light: #8fa8b8;
      --wp-white: #ffffff;
      --wp-card-shadow: 0 4px 20px rgba(0,79,104,0.10);
      --wp-card-shadow-hover: 0 10px 36px rgba(0,79,104,0.18);
      --wp-radius: 14px;
      font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif;
      color: var(--wp-text-main);
      background: var(--wp-white);
    }

    /* Hero — 월코소개 히어로와 같은 형식: 사진 전체, 아래쪽에 큰 제목, 구분선 위로 설명 · 숫자 · 버튼 */
    .wp-hero {
      position: relative; overflow: hidden; color: #fff; word-break: keep-all; font-family: var(--ff-sans);
      min-height: clamp(620px, 86vh, 820px); padding-top: 150px; box-sizing: border-box;
      display: flex; flex-direction: column; background: #0b1e27;
    }
    /* 드론 사진 — 가운데 W 로고와 둘러선 사역자들이 보이게 */
    .wp-hero::before { content: ''; position: absolute; inset: 0; background: url('/images/people/hero-drone.jpg') 50% 42% / cover no-repeat; }
    .wp-hero::after {
      content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(0deg, rgba(5,20,28,0.9) 0%, rgba(5,20,28,0.6) 40%, rgba(5,20,28,0.08) 70%, rgba(5,20,28,0.3) 100%);
    }
    .wp-hero-inner { position: relative; z-index: 1; flex: 1; width: 100%; max-width: 1248px; margin: 0 auto; padding: 0 24px 64px; box-sizing: border-box; display: flex; flex-direction: column; justify-content: flex-end; }
    .wp-hero-label { display: flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 600; letter-spacing: 0.02em; color: rgba(255,255,255,0.86); }
    .wp-hero-label::before { content: ''; width: 28px; height: 1px; background: currentColor; }
    .wp-hero-title { margin: 20px 0 0; font-family: var(--ff-serif); font-size: clamp(40px, 5.2vw, 74px); line-height: 1.14; font-weight: 700; letter-spacing: -0.04em; color: #fff; }
    .wp-hero-title .wl-en { font-size: 0.78em; }
    .wp-hero-bar { margin-top: 40px; padding-top: 28px; border-top: 1px solid rgba(255,255,255,0.3); display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.4fr) auto; gap: 0 56px; align-items: center; }
    .wp-hero-sub { margin: 0; font-size: 17px; line-height: 1.75; color: rgba(255,255,255,0.84); }
    .wp-hero-stats { margin: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 24px; }
    .wp-hero-stat { display: flex; flex-direction: column-reverse; gap: 6px; }
    .wp-hero-stat dd { margin: 0; font-family: var(--ff-serif); font-size: 28px; font-weight: 700; letter-spacing: -0.02em; line-height: 1; color: #fff; white-space: nowrap; }
    .wp-hero-stat dt { font-size: 13px; font-weight: 500; color: rgba(255,255,255,0.74); }
    .wp-hero-cta {
      display: inline-flex; align-items: center; gap: 14px; height: 52px; padding: 0 24px; box-sizing: border-box;
      border-radius: 2px; background: #fff; color: var(--wp-blue-deep); font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap;
      transition: background-color .18s, gap .25s;
    }
    .wp-hero-cta:hover { background: #e8f1f4; gap: 18px; }
    .wp-hero-cta:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .wp-hero-cta svg { width: 15px; height: 15px; }
    @media (max-width: 1100px) {
      .wp-hero-bar { grid-template-columns: minmax(0, 1fr) auto; }
      .wp-hero-stats { grid-column: 1 / -1; grid-row: 2; margin-top: 28px; }
    }
    /* 휴대폰: 위쪽은 사진이 또렷하게, 아래로 남색에 이어진 뒤 글이 시작된다 */
    @media (max-width: 640px) {
      .wp-hero { min-height: 0; padding-top: 0; }
      .wp-hero::before { bottom: auto; height: 400px; background-position: 50% 45%; }
      .wp-hero::after { background: linear-gradient(180deg, rgba(5,20,28,0.35) 0px, rgba(5,20,28,0) 120px, rgba(5,20,28,0) 230px, #0b1e27 400px); }
      .wp-hero-inner { padding: 330px 20px 28px; }
      .wp-hero-title { margin-top: 18px; font-size: 34px; line-height: 1.25; }
      .wp-hero-bar { display: block; margin-top: 24px; padding-top: 22px; }
      .wp-hero-sub { font-size: 15.5px; }
      .wp-hero-sub br { display: none; }
      .wp-hero-stats { gap: 0 12px; margin-top: 28px; }
      .wp-hero-stat dd { font-size: 24px; }
      .wp-hero-stat dt { font-size: 12px; }
      .wp-hero-cta { width: 100%; justify-content: space-between; margin-top: 24px; padding: 0 20px; }
    }
    /* 움직임 — 자바스크립트가 html 에 .wl-motion 을 붙일 때만 (움직임 줄이기 설정이면 처음부터 다 보인다) */
    @keyframes wpHeroZoom { from { transform: scale(1.08); } to { transform: none; } }
    @keyframes wpRise { from { opacity: 0; transform: translateY(26px); } to { opacity: 1; transform: none; } }
    @keyframes wpLine { from { width: 0; } to { width: 28px; } }
    :global(.wl-motion) .wp-hero::before { animation: wpHeroZoom 3.8s cubic-bezier(.2,.6,.2,1) both; }
    :global(.wl-motion) .wp-hero-label { animation: wpRise 1.2s .25s cubic-bezier(.2,.7,.2,1) both; }
    :global(.wl-motion) .wp-hero-label::before { animation: wpLine 1s .55s ease-out both; }
    :global(.wl-motion) .wp-hero-title { animation: wpRise 1.3s .5s cubic-bezier(.2,.7,.2,1) both; }
    :global(.wl-motion) .wp-hero-bar { animation: wpRise 1.3s .95s cubic-bezier(.2,.7,.2,1) both; }

    /* Accordion */
    .wp-accordion-wrap { max-width: 1080px; margin: 0 auto; padding: 48px 24px 72px; display: flex; flex-direction: column; gap: 16px; }
    .wp-acc-item { scroll-margin-top: 110px; border-radius: var(--wp-radius); overflow: hidden; box-shadow: var(--wp-card-shadow); background: var(--wp-white); }
    .wp-acc-trigger { width: 100%; display: flex; align-items: center; gap: 16px; padding: 24px 28px; background: var(--wp-white); border: none; cursor: pointer; text-align: left; transition: background 0.2s; }
    .wp-acc-trigger:hover { background: var(--wp-gray-bg); }
    .wp-loc-badge { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; border-radius: 10px; background: var(--wp-blue-deep); color: var(--wp-white); font-size: 17px; font-weight: 900; flex-shrink: 0; }
    .wp-acc-item.wp-acc-jeju .wp-loc-badge { background: var(--wp-blue-mid); }
    .wp-acc-label { flex: 1; min-width: 0; }
    .wp-loc-text-en { font-size: 10px; font-weight: 700; letter-spacing: 2.5px; text-transform: uppercase; color: var(--wp-blue-mid); margin-bottom: 3px; }
    .wp-loc-text-ko { font-size: 20px; font-weight: 800; color: var(--wp-text-main); line-height: 1; }
    .wp-acc-meta { font-size: 12px; color: var(--wp-text-light); font-weight: 600; white-space: nowrap; margin-right: 12px; }
    .wp-acc-chevron { width: 28px; height: 28px; border-radius: 50%; background: var(--wp-gray-bg); display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: background 0.2s; }
    .wp-acc-chevron svg { display: block; transition: transform 0.35s ease; }
    .wp-acc-chevron svg path { stroke: var(--wp-blue-deep); }
    .wp-acc-item.wp-acc-open .wp-acc-chevron { background: var(--wp-blue-deep); }
    .wp-acc-item.wp-acc-open .wp-acc-chevron svg path { stroke: #fff; }
    .wp-acc-item.wp-acc-open .wp-acc-chevron svg { transform: rotate(180deg); }
    .wp-acc-item.wp-acc-jeju.wp-acc-open .wp-acc-chevron { background: var(--wp-blue-mid); }
    .wp-acc-body { max-height: 0; overflow: hidden; transition: max-height 0.45s cubic-bezier(0.4,0,0.2,1); }
    .wp-acc-item.wp-acc-open .wp-acc-body { max-height: 4000px; }
    .wp-acc-inner { padding: 36px 28px 40px; border-top: 1px solid var(--wp-gray-line); }

    /* Group */
    .wp-group { margin-bottom: 56px; }
    .wp-group:last-child { margin-bottom: 0; }
    .wp-group-title { display: flex; align-items: center; gap: 10px; margin-bottom: 28px; }
    .wp-group-title-bar { width: 4px; height: 22px; border-radius: 3px; background: var(--wp-blue-deep); flex-shrink: 0; }
    .wp-group-title-text { font-size: 17px; font-weight: 800; color: var(--wp-text-main); }
    .wp-group-count { margin-left: auto; font-size: 12px; color: var(--wp-text-light); font-weight: 600; background: var(--wp-gray-bg); padding: 3px 10px; border-radius: 20px; }

    /* Card Grid */
    .wp-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
    .wp-card { background: var(--wp-white); border-radius: var(--wp-radius); overflow: hidden; box-shadow: var(--wp-card-shadow); text-decoration: none; display: block; transition: transform 0.25s, box-shadow 0.25s; opacity: 0; transform: translateY(20px); }
    .wp-card.wp-visible { opacity: 1; transform: translateY(0); transition: opacity 0.5s ease, transform 0.5s ease, box-shadow 0.25s; }
    .wp-card:hover { transform: translateY(-5px); box-shadow: var(--wp-card-shadow-hover); }
    .wp-card-photo-wrap { position: relative; width: 100%; padding-top: 100%; background: var(--wp-gray-bg); overflow: hidden; }
    .wp-card-photo-wrap img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 0.4s ease; }
    .wp-card:hover .wp-card-photo-wrap img { transform: scale(1.05); }
    .wp-card-role-badge { position: absolute; bottom: 10px; left: 10px; background: rgba(0,79,104,0.85); color: var(--wp-white); font-size: 10px; font-weight: 700; letter-spacing: 1.5px; text-transform: uppercase; padding: 4px 10px; border-radius: 20px; backdrop-filter: blur(4px); }
    .wp-card-role-badge.wp-badge-director { background: rgba(196,42,54,0.9); }
    .wp-card-info { padding: 18px 18px 20px; }
    .wp-card-name { font-size: 15px; font-weight: 800; color: var(--wp-text-main); margin-bottom: 5px; line-height: 1.35; }
    .wp-card-title { font-size: 12px; color: var(--wp-text-sub); line-height: 1.5; }
    .wp-card-arrow { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; color: var(--wp-blue-mid); margin-top: 10px; letter-spacing: 0.5px; }
    .wp-card-arrow::after { content: '→'; transition: transform 0.2s; }
    .wp-card:hover .wp-card-arrow::after { transform: translateX(3px); }
    /* 사진 없는 카드 */
    .wp-card--no-photo .wp-card-info { padding: 24px 20px 22px; }
    .wp-card--no-photo .wp-card-name { font-size: 16px; margin-bottom: 7px; }

    @media (max-width: 860px) {
      .wp-grid { grid-template-columns: repeat(2, 1fr); gap: 18px; }
      .wp-accordion-wrap { padding: 32px 16px 56px; }
      .wp-acc-trigger { padding: 20px; }
      .wp-acc-inner { padding: 28px 16px 32px; }
    }
    @media (max-width: 540px) {
      .wp-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
      .wp-card-info { padding: 12px 12px 14px; }
      .wp-card-name { font-size: 13px; }
      .wp-acc-meta { display: none; }
    }
    @media (max-width: 380px) { .wp-grid { grid-template-columns: 1fr; } }
  </style>

  <div class="wp-wrap">

    <!-- Hero -->
    <section class="wp-hero">
      <div class="wp-hero-inner">
        <div class="wp-hero-label"><span class="wl-ko">섬기는이</span><span class="wl-en">Our Team</span></div>
        <h1 class="wp-hero-title">
          <span class="wl-ko">함께 사역하는 이들</span>
          <span class="wl-en">Meet Our Ministry Team</span>
        </h1>
        <div class="wp-hero-bar">
          <p class="wp-hero-sub">
            <span class="wl-ko">하나님의 부르심을 따라 다음 세대를 위해 <br>헌신하는 월코의 사역자들을 소개합니다.</span>
            <span class="wl-en">Called by God and committed to the next generation — <br>meet the people of Word of Life Korea.</span>
          </p>
          <dl class="wp-hero-stats">
            <div class="wp-hero-stat">
              <dt><span class="wl-ko">선교사</span><span class="wl-en">Missionaries</span></dt>
              <dd><span data-count-from="0">{pyMissionary.length + jejuMissionary.length}</span></dd>
            </div>
            <div class="wp-hero-stat">
              <dt><span class="wl-ko">단기 사역자</span><span class="wl-en">Short-term Workers</span></dt>
              <dd><span data-count-from="0">{pyStw.length + jejuStw.length}</span></dd>
            </div>
            <div class="wp-hero-stat">
              <dt><span class="wl-ko">사역 캠퍼스</span><span class="wl-en">Campuses</span></dt>
              <dd><span data-count-from="0">2</span></dd>
            </div>
          </dl>
          <a href="#wp-pyeongtaek" class="wp-hero-cta">
            <span class="wl-ko">사역자 보기</span><span class="wl-en">Meet the Team</span>
            <svg aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M8 2v11M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Accordion -->
    <div class="wp-accordion-wrap">

      <!-- 평택 -->
      <div class="wp-acc-item wp-acc-open" id="wp-pyeongtaek">
        <button class="wp-acc-trigger" aria-expanded="true">
          <div class="wp-loc-badge"><span class="wl-ko">평</span><span class="wl-en">P</span></div>
          <div class="wp-acc-label">
            <div class="wp-loc-text-en"><span class="wl-ko">평택 · 본 캠퍼스</span><span class="wl-en">Pyeongtaek · Main Campus</span></div>
            <div class="wp-loc-text-ko">
              <span class="wl-ko">평택 월코센터</span>
              <span class="wl-en">Pyeongtaek WOLKO Center</span>
            </div>
          </div>
          <span class="wp-acc-meta">
            <span class="wl-ko">선교사 {pyMissionary.length} · 단기 {pyStw.length}</span>
            <span class="wl-en">Missionaries {pyMissionary.length} · STW {pyStw.length}</span>
          </span>
          <div class="wp-acc-chevron">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2 5l5 5 5-5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </button>
        <div class="wp-acc-body">
          <div class="wp-acc-inner">

            <!-- 선교사 -->
            <div class="wp-group">
              <div class="wp-group-title">
                <div class="wp-group-title-bar"></div>
                <span class="wp-group-title-text wl-ko">선교사</span>
                <span class="wp-group-title-text wl-en">Missionaries</span>
                <span class="wp-group-count">{pyMissionary.length}</span>
              </div>
              <div class="wp-grid">
                {pyMissionary.map((person) => (
                  <a href={`/team/${person.slug}`} class={`wp-card${!person.data.photo_url ? ' wp-card--no-photo' : ''}`}>
                    {person.data.photo_url && (
                      <div class="wp-card-photo-wrap">
                        <img src={person.data.photo_url} alt={person.data.name_ko} loading="lazy" style={person.data.photo_position ? `object-position: ${person.data.photo_position}` : undefined} />
                        <span class={`wp-card-role-badge${person.data.role_badge.includes('Director') ? ' wp-badge-director' : ''}`}>
                          <span class="wl-ko">{roleBadgeKo(person.data.role_badge)}</span><span class="wl-en">{person.data.role_badge}</span>
                        </span>
                      </div>
                    )}
                    <div class="wp-card-info">
                      <div class="wp-card-name">
                        <span class="wl-ko">{person.data.name_ko}</span>
                        <span class="wl-en">{person.data.name_en}</span>
                      </div>
                      <div class="wp-card-title">
                        <span class="wl-ko">{person.data.title_ko}</span>
                        <span class="wl-en">{person.data.title_en}</span>
                      </div>
                      <div class="wp-card-arrow">
                        <span class="wl-ko">프로필 보기</span>
                        <span class="wl-en">View Profile</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>

            <!-- 단기 사역자 -->
            <div class="wp-group">
              <div class="wp-group-title">
                <div class="wp-group-title-bar"></div>
                <span class="wp-group-title-text wl-ko">단기 사역자</span>
                <span class="wp-group-title-text wl-en">Short-term Workers</span>
                <span class="wp-group-count">{pyStw.length}</span>
              </div>
              <div class="wp-grid">
                {pyStw.map((person) => (
                  <a href={`/team/${person.slug}`} class={`wp-card${!person.data.photo_url ? ' wp-card--no-photo' : ''}`}>
                    {person.data.photo_url && (
                      <div class="wp-card-photo-wrap">
                        <img src={person.data.photo_url} alt={person.data.name_ko} loading="lazy" style={person.data.photo_position ? `object-position: ${person.data.photo_position}` : undefined} />
                        <span class="wp-card-role-badge"><span class="wl-ko">{roleBadgeKo(person.data.role_badge)}</span><span class="wl-en">{person.data.role_badge}</span></span>
                      </div>
                    )}
                    <div class="wp-card-info">
                      <div class="wp-card-name">
                        <span class="wl-ko">{person.data.name_ko}</span>
                        <span class="wl-en">{person.data.name_en}</span>
                      </div>
                      <div class="wp-card-title">
                        <span class="wl-ko">{person.data.title_ko}</span>
                        <span class="wl-en">{person.data.title_en}</span>
                      </div>
                      <div class="wp-card-arrow">
                        <span class="wl-ko">프로필 보기</span>
                        <span class="wl-en">View Profile</span>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- 제주 -->
      <div class="wp-acc-item wp-acc-jeju wp-acc-open" id="wp-jeju">
        <button class="wp-acc-trigger" aria-expanded="true">
          <div class="wp-loc-badge"><span class="wl-ko">제</span><span class="wl-en">J</span></div>
          <div class="wp-acc-label">
            <div class="wp-loc-text-en"><span class="wl-ko">제주 · 월비 캠퍼스</span><span class="wl-en">Jeju · Wolbi Campus</span></div>
            <div class="wp-loc-text-ko">
              <span class="wl-ko">제주 월비</span>
              <span class="wl-en">Jeju WOLBI</span>
            </div>
          </div>
          <span class="wp-acc-meta">
            <span class="wl-ko">선교사 {jejuMissionary.length} · 단기 {jejuStw.length}</span>
            <span class="wl-en">Missionaries {jejuMissionary.length} · STW {jejuStw.length}</span>
          </span>
          <div class="wp-acc-chevron">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M2 5l5 5 5-5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
        </button>
        <div class="wp-acc-body">
          <div class="wp-acc-inner">

            <!-- 선교사 -->
            <div class="wp-group">
              <div class="wp-group-title">
                <div class="wp-group-title-bar"></div>
                <span class="wp-group-title-text wl-ko">선교사</span>
                <span class="wp-group-title-text wl-en">Missionaries</span>
                <span class="wp-group-count">{jejuMissionary.length}</span>
              </div>
              <div class="wp-grid">
                {jejuMissionary.map((person) => (
