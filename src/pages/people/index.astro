    @keyframes pp-mark { to { background-size: 100% 5px; } }
    .pp-lead-copy { max-width: 500px; font-size: 17px; line-height: 1.8; color: rgba(255,255,255,.78); }
    .pp-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); max-width: 520px; margin-top: 10px; border-top: 1px solid rgba(255,255,255,.18); }
    .pp-stats > div { padding: 18px 0 0 20px; border-left: 1px solid rgba(255,255,255,.14); }
