    @keyframes pp-ring { from { transform: scale(.6); opacity: 1; } to { transform: scale(3.2); opacity: 0; } }
    .pp-place { position: absolute; display: flex; align-items: center; gap: 10px; padding: 8px 14px 8px 8px; border-radius: 999px; background: rgba(255,255,255,.08); border: 1px solid rgba(255,255,255,.16); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); color: #fff; text-decoration: none; white-space: nowrap; transform: translate(22px, -50%); animation: pp-pop .7s cubic-bezier(.2,.9,.3,1.3) both; animation-delay: calc(1.5s + var(--i) * .25s); transition: background-color .25s, border-color .25s, transform .25s; }
    @keyframes pp-pop { from { opacity: 0; transform: translate(8px, -50%) scale(.9); } }
    .pp-place:hover { background: rgba(255,255,255,.16); border-color: rgba(233,194,122,.6); transform: translate(26px, -50%); color: #fff; }
    .pp-faces { display: flex; }
