      .pp-faces img { width: 24px; height: 24px; }
      .pp-place-name { font-size: 12.5px; }
      .pp-place-meta { font-size: 10.5px; }
      /* 휴대폰: 거점 · 역할을 두 줄로 나눠 화면 폭에 꼭 맞춘다(옆으로 밀어야 보이는 버튼이 없게) */
      .pp-bar-inner { flex-direction: column; align-items: stretch; gap: 8px; padding: 10px 0; }
      .pp-seg, .pp-chips { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .pp-chips { gap: 6px; }
      .pp-seg button, .pp-chips button { min-height: 36px; padding: 0 6px; white-space: nowrap; }
      .pp-seg button { font-size: 13.5px; }
      .pp-chips button { font-size: 13px; }
      .pp-seg-long { display: none; }
      .pp-main { gap: 56px; padding: 40px 0 72px; }
      .pp-leads { grid-template-columns: 1fr; }
      /* 휴대폰: 사진을 위에 화면 폭 가득(3:2), 글은 그 아래 — 가족 모두가 잘리지 않고 보인다 */
      .pp-lead { grid-template-columns: 1fr; }
      .pp-lead-body { padding: 18px; gap: 6px; }
      .pp-lead-name { font-size: 20px; }
      .pp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 12px; }
      .pp-name { font-size: 15.5px; }
      .pp-title { font-size: 12.5px; }
      .pp-join { padding: 28px 22px; }
      .pp-join-btns { justify-content: flex-start; }
    }
    @media (hover: none) { .pp-card:hover { transform: none; } .pp-card:hover img { transform: none; } }
    @media (max-width: 1100px) and (min-width: 761px) { .pp-map { height: 420px; margin-right: 100px; } }
    @media (prefers-reduced-motion: reduce) {
      .pp-card, .pp-card img, .pp-go, .pp-bar { transition: none; }
      .pp-hero *, .pp-hero *::before { animation: none !important; }
      .pp-hl { background-size: 100% 5px; }
      .pp-arc { stroke-dashoffset: 0; }
