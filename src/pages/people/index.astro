---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';

const allTeam = (await getCollection('team')).filter(p => p.data.active !== false);

// 사역 거점 + 구분별 그룹화 & 정렬
const pyMissionary = allTeam
  .filter(p => p.data.campus === 'pyeongtaek' && p.data.category === 'missionary')
  .sort((a, b) => a.data.order - b.data.order);
const pyStw = allTeam
  .filter(p => p.data.campus === 'pyeongtaek' && p.data.category === 'stw')
  .sort((a, b) => a.data.order - b.data.order);
const jejuMissionary = allTeam
  .filter(p => p.data.campus === 'jeju' && p.data.category === 'missionary')
  .sort((a, b) => a.data.order - b.data.order);
const jejuStw = allTeam
  .filter(p => p.data.campus === 'jeju' && p.data.category === 'stw')
  .sort((a, b) => a.data.order - b.data.order);

// 카드 위 직책 배지 — 한글 화면에서는 한글, 영어 화면에서는 영어로만 보이게 한다(role_badge 는 영어 값).
const ROLE_BADGE_KO = { Staff: '스태프', Intern: '인턴', Missionaries: '선교사', Missionary: '선교사', 'Field Director': '필드 디렉터', 'Jeju Director': '제주 디렉터' };
const roleBadgeKo = (value) => ROLE_BADGE_KO[value] || value;
// 대표(디렉터)는 색 배지 대신 직책 글자를 진한 색으로만 구분한다
const isDirector = (person) => (person.data.role_badge || '').includes('Director');
// 사진이 없을 때 액자 안에 넣을 첫 글자
const initialOf = (person) => (person.data.name_ko || person.data.name_en || '?').trim().charAt(0);

// 사역 거점 두 곳(평택 월코센터 · 제주 월비) — 같은 모양으로 그린다 (id 는 맨 위 배너 버튼이 #wp-pyeongtaek 로 이어지므로 그대로 둔다)
const campuses = [
  {
    id: 'wp-pyeongtaek', num: '01',
    labelKo: '경기 평택', labelEn: 'Pyeongtaek, Gyeonggi',
    ko: '평택 월코센터', en: 'Pyeongtaek WOLKO Center',
    groups: [
      { ko: '선교사', en: 'Missionaries', people: pyMissionary },
      { ko: '단기 사역자', en: 'Short-term Workers', people: pyStw },
    ],
  },
  {
    id: 'wp-jeju', num: '02',
    labelKo: '제주 애월', labelEn: 'Aewol, Jeju',
    ko: '제주 월비', en: 'Jeju WOLBI',
    groups: [
      { ko: '선교사', en: 'Missionaries', people: jejuMissionary },
      { ko: '단기 사역자', en: 'Short-term Workers', people: jejuStw },
    ],
  },
];
---

<BaseLayout title="섬기는이 — WOLKO 월코" activeNav="about">
  <div class="wp-wrap">

    <!-- Hero -->
    <PageHero image="/images/people/hero-drone.jpg" pos="50% 42%" mpos="50% 45%">
      <Fragment slot="eyebrow"><span class="wl-ko">섬기는이</span><span class="wl-en">Our Team</span></Fragment>
      <Fragment slot="title">
        <span class="wl-ko">함께 섬기는 사람들</span>
        <span class="wl-en">Meet Our Ministry Team</span>
      </Fragment>
      <Fragment slot="bar">
        <p class="ph-sub">
          <span class="wl-ko">하나님의 부르심을 따라 다음 세대를 위해 <br>헌신하는 월코의 사역자들을 소개합니다.</span>
          <span class="wl-en">Called by God and committed to the next generation, meet the people of Word of Life Korea.</span>
        </p>
        <dl class="ph-stats">
          <div class="ph-stat">
            <dt><span class="wl-ko">선교사</span><span class="wl-en">Missionaries</span></dt>
            <dd><span data-count-from="0">{pyMissionary.length + jejuMissionary.length}</span></dd>
          </div>
          <div class="ph-stat">
            <dt><span class="wl-ko">단기 사역자</span><span class="wl-en">Short-term Workers</span></dt>
            <dd><span data-count-from="0">{pyStw.length + jejuStw.length}</span></dd>
          </div>
          <div class="ph-stat">
            <dt><span class="wl-ko">사역 거점</span><span class="wl-en">Ministry Locations</span></dt>
            <dd><span data-count-from="0">2</span></dd>
          </div>
        </dl>
        <div class="ph-actions">
          <a href="#wp-pyeongtaek" class="ph-cta">
            <span class="wl-ko">사역자 보기</span><span class="wl-en">Meet the Team</span>
            <svg aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M8 2v11M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/></svg>
          </a>
        </div>
      </Fragment>
    </PageHero>

    <!-- 소개 + 사역 거점 바로가기 -->
    <section class="wp-intro">
      <div class="wp-shell wp-intro-inner">
        <div>
          <p class="wp-eyebrow"><span class="wl-ko">두 사역 거점</span><span class="wl-en">Two Ministry Locations</span></p>
          <h2><span class="wl-ko">평택과 제주에서<br>함께 섬깁니다</span><span class="wl-en">Serving Together<br>in Pyeongtaek and Jeju</span></h2>
        </div>
        <div>
          <p class="wp-intro-copy">
            <span class="wl-ko">사역자를 누르면 각자의 이야기와 삶의 말씀, 기도제목을 볼 수 있습니다.</span>
            <span class="wl-en">Select a team member to read their story, life verse, and prayer requests.</span>
          </p>
          <nav class="wp-jump" aria-label="사역 거점 바로가기">
            {campuses.map((c) => (
              <a href={`#${c.id}`}>
                <span class="wp-jump-num">{c.num}</span>
                <span class="wp-jump-name"><span class="wl-ko">{c.ko}</span><span class="wl-en">{c.en}</span></span>
                <span class="wp-jump-meta">
                  <span class="wl-ko">선교사 {c.groups[0].people.length} · 단기 {c.groups[1].people.length}</span>
                  <span class="wl-en">Missionaries {c.groups[0].people.length} · STW {c.groups[1].people.length}</span>
                </span>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </section>

    <!-- 사역 거점별 사역자 -->
    {campuses.map((c, ci) => (
      <section class:list={['wp-campus', { 'wp-campus--alt': ci % 2 === 1 }]} id={c.id} aria-labelledby={`${c.id}-title`}>
        <div class="wp-shell">
          <header class="wp-campus-head">
            <div>
              <p class="wp-campus-label"><span class="wp-campus-num">{c.num}</span><span class="wl-ko">{c.labelKo}</span><span class="wl-en">{c.labelEn}</span></p>
              <h2 id={`${c.id}-title`}><span class="wl-ko">{c.ko}</span><span class="wl-en">{c.en}</span></h2>
            </div>
            <dl class="wp-campus-stats">
              {c.groups.map((g) => (
                <div>
                  <dt><span class="wl-ko">{g.ko}</span><span class="wl-en">{g.en}</span></dt>
                  <dd>{g.people.length}</dd>
                </div>
              ))}
            </dl>
          </header>

          {c.groups.map((g) => (
            <div class="wp-group">
              <div class="wp-group-title">
                <h3 class="wp-group-title-text"><span class="wl-ko">{g.ko}</span><span class="wl-en">{g.en}</span></h3>
                <span class="wp-group-count">
                  <span class="wl-ko">{g.people.length}명</span><span class="wl-en">{g.people.length} {g.people.length === 1 ? 'person' : 'people'}</span>
                </span>
              </div>
              <ul class="wp-grid">
                {g.people.map((person) => (
                  <li>
                    <a href={`/team/${person.slug}`} class:list={['wp-card', { 'wp-card--no-photo': !person.data.photo_url }]}>
                      <span class="wp-card-photo">
                        {person.data.photo_url ? (
                          <img src={person.data.photo_url} alt={person.data.name_ko} loading="lazy" style={person.data.photo_position ? `object-position: ${person.data.photo_position}` : undefined} />
                        ) : (
                          <span class="wp-card-initial" aria-hidden="true">{initialOf(person)}</span>
                        )}
                      </span>
                      <span class="wp-card-info">
                        <span class:list={['wp-card-role', { 'wp-card-role--director': isDirector(person) }]}>
                          <span class="wl-ko">{roleBadgeKo(person.data.role_badge)}</span><span class="wl-en">{person.data.role_badge}</span>
                        </span>
                        <span class="wp-card-name">
                          <span class="wl-ko">{person.data.name_ko}</span>
                          <span class="wl-en">{person.data.name_en}</span>
                        </span>
                        <span class="wp-card-title">
                          <span class="wl-ko">{person.data.title_ko}</span>
                          <span class="wl-en">{person.data.title_en}</span>
                        </span>
                        <span class="wp-card-arrow">
                          <span class="wl-ko">프로필 보기</span>
                          <span class="wl-en">View Profile</span>
                          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
                        </span>
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>
    ))}
  </div>

  <script is:inline>
    // 섬기는이 페이지 움직임: 스크롤하면 제목과 사진 카드가 아래에서 차례로 떠오른다.
    // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var items = [].slice.call(document.querySelectorAll('.wp-intro-inner > *, .wp-campus-head > *, .wp-group-title, .wp-grid > li'));
      items.forEach(function (el) {
        var sib = el.parentNode.children, i = [].indexOf.call(sib, el);
        // 카드는 한 줄(최대 4개) 안에서만 차례를 둔다
        var step = el.tagName === 'LI' ? i % 4 : Math.min(i, 4);
        el.style.setProperty('--d', step * 0.08 + 's');
        el.classList.add('wp-rv');
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      items.forEach(function (el) { io.observe(el); });
    })();
  </script>

  <style>
    .wp-wrap {
      --wp-deep: #004f68;
      --wp-navy: #0b2430;
      --wp-ink: #10252e;
      --wp-text: #4a5d66;
      --wp-muted: #587383;
      --wp-label: #5a7380;
      --wp-line: #d6dee2;
      --wp-soft: #f6f9fb;
      --wp-fill: #f3f7f9;
      color: var(--wp-ink);
      background: #fff;
      font-family: var(--ff-sans);
      word-break: keep-all;
      overflow: hidden;
    }
    .wp-shell { width: min(1200px, calc(100% - 48px)); margin-inline: auto; }
    .wp-wrap svg { width: 14px; height: 14px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: square; }

    /* 작은 표시 — 앞에 가는 선 (맨 위 배너와 같은 모양) */
    .wp-eyebrow { display: flex; align-items: center; gap: 12px; color: var(--wp-deep); font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .wp-eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; }

    /* 소개 + 사역 거점 바로가기 */
    .wp-intro { padding: 120px 0 88px; }
    .wp-intro-inner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 80px; align-items: end; }
    .wp-intro h2 { margin-top: 20px; font-family: var(--ff-serif); font-size: clamp(32px, 3.4vw, 46px); font-weight: 700; line-height: 1.22; letter-spacing: -.03em; color: var(--wp-navy); }
    .wp-intro-copy { color: #3e535d; font-size: 18px; line-height: 1.85; }
    .wp-jump { margin-top: 36px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border-top: 2px solid var(--wp-navy); }
    .wp-jump a { padding: 16px 16px 4px 0; display: flex; flex-direction: column; gap: 6px; color: var(--wp-ink); text-decoration: none; }
    .wp-jump-num { font-family: var(--ff-serif); font-size: 13px; color: var(--wp-deep); }
    .wp-jump-name { font-size: 17px; font-weight: 700; transition: color .2s; }
    .wp-jump-meta { font-size: 13px; color: var(--wp-muted); }
    .wp-jump a:hover .wp-jump-name { color: var(--wp-deep); text-decoration: underline; text-underline-offset: 4px; }

    /* 사역 거점 한 꼭지 */
    .wp-campus { padding: 96px 0 112px; scroll-margin-top: 40px; }
    .wp-campus--alt { background: var(--wp-soft); }
    .wp-campus-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; margin-bottom: 56px; }
    .wp-campus-label { display: flex; align-items: baseline; gap: 14px; color: var(--wp-label); font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .wp-campus-num { font-family: var(--ff-serif); font-size: 15px; letter-spacing: 0; color: var(--wp-deep); }
    .wp-campus h2 { margin-top: 16px; font-family: var(--ff-serif); font-size: clamp(30px, 2.8vw, 40px); font-weight: 700; line-height: 1.2; letter-spacing: -.03em; color: var(--wp-navy); }
    .wp-campus-stats { display: flex; gap: 0; flex: none; }
    .wp-campus-stats > div { min-width: 132px; padding: 0 0 2px 24px; border-left: 1px solid var(--wp-line); }
    .wp-campus-stats > div:first-child { padding-left: 0; border-left: 0; padding-right: 24px; }
    .wp-campus-stats dt { font-size: 12px; font-weight: 700; color: var(--wp-label); }
    .wp-campus-stats dd { margin-top: 6px; font-family: var(--ff-serif); font-size: 34px; font-weight: 700; line-height: 1; letter-spacing: -.02em; color: var(--wp-navy); }

    /* 구분 (선교사 / 단기 사역자) — 굵은 글자 + 가는 선만 */
    .wp-group + .wp-group { margin-top: 72px; }
    .wp-group-title { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; padding-bottom: 16px; border-bottom: 1px solid var(--wp-line); }
    .wp-group-title-text { font-size: 19px; font-weight: 700; letter-spacing: -.01em; color: var(--wp-navy); }
    .wp-group-count { font-size: 13px; font-weight: 600; color: var(--wp-muted); }

    /* 사진 목록 */
    .wp-grid { list-style: none; margin-top: 32px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 48px 24px; }
    .wp-card { display: flex; flex-direction: column; height: 100%; color: var(--wp-ink); text-decoration: none; }
    .wp-card-photo { position: relative; display: block; aspect-ratio: 4 / 5; overflow: hidden; background: var(--wp-fill); }
    .wp-campus--alt .wp-card-photo { background: #e9f0f3; }
    .wp-card-photo img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; transition: transform .9s cubic-bezier(.2,.7,.2,1); }
    .wp-card:hover .wp-card-photo img { transform: scale(1.04); }
    /* 사진이 없으면 같은 크기 액자 안에 이름 첫 글자를 둔다 */
    .wp-card--no-photo .wp-card-photo { display: flex; align-items: center; justify-content: center; border: 1px solid var(--wp-line); }
    .wp-card-initial { font-family: var(--ff-serif); font-size: clamp(44px, 5vw, 64px); font-weight: 700; color: #9fb2bc; letter-spacing: -.02em; line-height: 1; }
    .wp-card-info { display: flex; flex-direction: column; flex: 1; padding-top: 18px; }
    .wp-card-role { font-size: 11.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--wp-label); }
    .wp-card-role--director { color: var(--wp-deep); }
    .wp-card-name { margin-top: 8px; font-size: 18px; font-weight: 700; line-height: 1.35; letter-spacing: -.01em; color: var(--wp-navy); }
    .wp-card:hover .wp-card-name { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 5px; }
    .wp-card-title { margin-top: 6px; font-size: 14px; line-height: 1.6; color: var(--wp-muted); }
    .wp-card-arrow { margin-top: auto; padding-top: 14px; display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: var(--wp-deep); }
    .wp-card-arrow svg { width: 12px; height: 12px; transition: transform .25s; }
    .wp-card:hover .wp-card-arrow svg { transform: translateX(4px); }
    .wp-card:focus-visible { outline: 2px solid var(--wp-deep); outline-offset: 4px; }

    /* 스크롤하면 떠오르기 — 스크립트가 .wp-rv 를 붙일 때만 */
    .wp-rv { opacity: 0; transform: translateY(28px); transition: opacity 1.1s cubic-bezier(.2,.7,.2,1) var(--d, 0s), transform 1.1s cubic-bezier(.2,.7,.2,1) var(--d, 0s); }
    .wp-rv.is-in { opacity: 1; transform: none; }

    @media (max-width: 1080px) {
      .wp-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @media (max-width: 980px) {
      .wp-intro-inner { grid-template-columns: 1fr; gap: 28px; align-items: start; }
      .wp-campus-head { flex-direction: column; align-items: flex-start; gap: 28px; }
    }
    @media (max-width: 740px) {
      .wp-shell { width: calc(100% - 40px); }
      .wp-intro { padding: 72px 0 56px; }
      .wp-intro-copy { font-size: 15.5px; }
      .wp-jump a { padding-bottom: 12px; }
      .wp-jump-name { font-size: 15px; }
      .wp-campus { padding: 64px 0 72px; }
      .wp-campus-head { margin-bottom: 40px; }
      .wp-campus-stats > div { min-width: 0; }
      .wp-campus-stats dd { font-size: 28px; }
      .wp-group + .wp-group { margin-top: 56px; }
      .wp-group-title-text { font-size: 17px; }
      .wp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px 12px; margin-top: 24px; }
      .wp-card-info { padding-top: 12px; }
      .wp-card-role { font-size: 10.5px; letter-spacing: .1em; }
      .wp-card-name { margin-top: 6px; font-size: 15.5px; }
      .wp-card-title { font-size: 13px; line-height: 1.55; }
      .wp-card-arrow { font-size: 12px; padding-top: 10px; }
    }
    /* 아주 좁은 폰(360px 미만)만 한 줄에 한 명 */
    @media (max-width: 359px) {
      .wp-grid { grid-template-columns: 1fr; gap: 40px; }
    }
    @media (hover: none) {
      .wp-card:hover .wp-card-photo img { transform: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .wp-card-photo img, .wp-card-arrow svg { transition: none; }
      .wp-card:hover .wp-card-photo img { transform: none; }
    }
  </style>
</BaseLayout>
