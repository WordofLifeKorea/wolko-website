---
// 섬기는이 — Claude Design 'A · 갤러리형' 시안을 옮긴 페이지.
// 남색 첫 화면(큰 제목 · 숫자 · 점 지도 위 두 거점) → 거르기 막대(사역 거점 · 역할, 화면을 내려도 따라온다)
// → 두 거점의 대표 → 거점별 사진 카드 → 함께 섬기기 띠.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { photoFrame, photoFocus } from '../../lib/photoFrame.js';

const allTeam = (await getCollection('team')).filter(p => p.data.active !== false);
const byOrder = (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99);
const isDirector = (p) => (p.data.role_badge || '').includes('Director');
const locOf = (p) => (p.data.campus === 'pyeongtaek' ? 'pt' : 'jj');

// 카드 위 직책 표시 — 한글 화면은 한글, 영어 화면은 영어
const ROLE_KO = { Staff: '간사', Intern: '인턴', Missionaries: '선교사', Missionary: '선교사', 'Field Director': '필드 디렉터', 'Jeju Director': '제주 디렉터' };
const roleKo = (v) => ROLE_KO[v] || v || '';
// 사진 카드 칸 비율 — 아래 CSS .pp-photo 의 aspect-ratio 와 같아야 한다
const CARD_ASPECT = 1;
const initialOf = (p) => (p.data.name_ko || p.data.name_en || '?').trim().charAt(0);

const leads = allTeam.filter(isDirector).sort((a, b) => (locOf(a) === locOf(b) ? byOrder(a, b) : locOf(a) === 'pt' ? -1 : 1));
const groups = [
  { loc: 'pt', num: '01', placeKo: '경기 평택', placeEn: 'Pyeongtaek, Gyeonggi', ko: '평택 월코센터', en: 'Pyeongtaek WOLKO Center' },
  { loc: 'jj', num: '02', placeKo: '제주 애월', placeEn: 'Aewol, Jeju', ko: '제주 월비', en: 'Jeju WOLBI' },
].map(g => ({
  ...g,
  people: allTeam.filter(p => locOf(p) === g.loc && !isDirector(p))
    .sort((a, b) => (a.data.category === b.data.category ? byOrder(a, b) : a.data.category === 'missionary' ? -1 : 1)),
  // 그 거점 인원 전체(위 '대표'에 따로 나온 디렉터 포함) — 거르기 막대 · 지도 숫자와 같다
  total: allTeam.filter(p => locOf(p) === g.loc).length,
}));
const counts = {
  all: allTeam.length,
  pt: allTeam.filter(p => locOf(p) === 'pt').length,
  jj: allTeam.filter(p => locOf(p) === 'jj').length,
  missionary: allTeam.filter(p => p.data.category === 'missionary').length,
  stw: allTeam.filter(p => p.data.category === 'stw').length,
};

// 첫 화면 지도 — 남한 윤곽을 대략의 경위도로 적고, 그 안에 드는 격자점만 찍는다(제주는 타원)
const KOREA = [[126.1,37.75],[126.6,37.75],[127.1,38.3],[128.35,38.62],[128.6,38.2],[128.9,37.8],[129.1,37.5],[129.4,37.0],[129.45,36.5],[129.4,36.05],[129.57,36.08],[129.45,35.6],[129.35,35.4],[129.1,35.1],[128.6,34.9],[128.0,34.82],[127.6,34.68],[127.3,34.5],[126.9,34.4],[126.5,34.3],[126.3,34.6],[126.4,35.0],[126.5,35.5],[126.7,35.9],[126.5,36.3],[126.15,36.7],[126.5,37.0],[126.8,36.95],[126.6,37.3],[126.6,37.5]];
const MAP_W = 340, MAP_H = 600, STEP = 10;
const proj = (lon, lat) => [(lon - 125.6) * 81, (38.9 - lat) * 100];
const inKorea = (lon, lat) => {
  if (((lon - 126.55) / 0.42) ** 2 + ((lat - 33.38) / 0.19) ** 2 <= 1) return true;
  let inside = false;
  for (let i = 0, j = KOREA.length - 1; i < KOREA.length; j = i++) {
    const [xi, yi] = KOREA[i], [xj, yj] = KOREA[j];
    if ((yi > lat) !== (yj > lat) && lon < ((xj - xi) * (lat - yi)) / (yj - yi) + xi) inside = !inside;
  }
  return inside;
};
const pins = {
  pt: proj(127.11, 36.99),
  jj: proj(126.37, 33.44),
};
const mapRows = [];
for (let y = STEP / 2, r = 0; y < MAP_H; y += STEP, r++) {
  const dots = [];
  for (let x = STEP / 2 + (r % 2 ? STEP / 2 : 0); x < MAP_W; x += STEP) {
    if (!inKorea(x / 81 + 125.6, 38.9 - y / 100)) continue;
    const near = Math.min(...Object.values(pins).map(([px, py]) => Math.hypot(px - x, py - y)));
    dots.push({ x, y, hot: near < 34, tw: (r * 7 + Math.round(x)) % 29 === 0 });
  }
  if (dots.length) mapRows.push({ d: (y / MAP_H * 0.9 + 0.2).toFixed(2), dots });
}
const [ptX, ptY] = pins.pt, [jjX, jjY] = pins.jj;
const arcPath = `M${ptX.toFixed(1)} ${ptY.toFixed(1)} Q${(ptX - 150).toFixed(1)} ${((ptY + jjY) / 2).toFixed(1)} ${jjX.toFixed(1)} ${jjY.toFixed(1)}`;
const pct = (v, total) => `${(v / total * 100).toFixed(2)}%`;
const facesOf = (loc) => allTeam.filter(p => locOf(p) === loc && p.data.photo_url).sort(byOrder).slice(0, 3);
const mapPlaces = [
  { loc: 'pt', x: ptX, y: ptY, ko: '평택 월코센터', en: 'Pyeongtaek', coord: '36.99°N', n: counts.pt, faces: facesOf('pt'), href: '#wp-pyeongtaek' },
  { loc: 'jj', x: jjX, y: jjY, ko: '제주 월비', en: 'Jeju', coord: '33.44°N', n: counts.jj, faces: facesOf('jj'), href: '#wp-jeju' },
];
---

<BaseLayout title="섬기는이 — WOLKO 월코" activeNav="about">
  <div class="pp">

    <header class="pp-hero">
      <span class="pp-glow pp-glow--a" aria-hidden="true"></span>
      <span class="pp-glow pp-glow--b" aria-hidden="true"></span>
      <div class="pp-shell pp-hero-grid">
        <div class="pp-hero-text">
          <p class="pp-eyebrow pp-rise" style="--i:0"><span class="wl-ko">섬기는이 · OUR TEAM</span><span class="wl-en">OUR TEAM</span></p>
          <h1 class="pp-rise" style="--i:1"><span class="wl-ko">함께 섬기는<br><em class="pp-hl">사람들</em></span><span class="wl-en">Meet Our<br><em class="pp-hl">Ministry Team</em></span></h1>
          <p class="pp-lead-copy pp-rise" style="--i:2">
            <span class="wl-ko">하나님의 부르심을 따라 다음 세대를 위해 헌신하는 월코의 사역자들을 소개합니다.</span>
            <span class="wl-en">Called by God and committed to the next generation, meet the people of Word of Life Korea.</span>
          </p>
          <dl class="pp-stats pp-rise" style="--i:3">
            <div><dt><span class="wl-ko">선교사</span><span class="wl-en">Missionaries</span></dt><dd data-count-to={counts.missionary}>{counts.missionary}</dd></div>
            <div><dt><span class="wl-ko">단기 사역자</span><span class="wl-en">Short-term</span></dt><dd data-count-to={counts.stw}>{counts.stw}</dd></div>
            <div><dt><span class="wl-ko">사역 거점</span><span class="wl-en">Locations</span></dt><dd data-count-to="2">2</dd></div>
          </dl>
        </div>

        <div class="pp-map" aria-label="사역 거점 지도: 평택 월코센터와 제주 월비">
          <svg viewBox={`0 0 ${MAP_W} ${MAP_H}`} aria-hidden="true">
            {mapRows.map((row) => (
              <g class="pp-map-row" style={`--d:${row.d}s`}>
                {row.dots.map((dt) => <circle cx={dt.x} cy={dt.y} r="2.3" class={dt.hot ? 'is-hot' : dt.tw ? 'is-tw' : undefined} />)}
              </g>
            ))}
            <path class="pp-arc-base" d={arcPath} />
            <path class="pp-arc" d={arcPath} pathLength="100" />
            <circle class="pp-arc-dot" r="3.6">
              <animateMotion dur="5.5s" begin="1.6s" repeatCount="indefinite" path={arcPath} keyPoints="0;1;0" keyTimes="0;.5;1" calcMode="spline" keySplines=".45 0 .55 1;.45 0 .55 1" />
            </circle>
            {mapPlaces.map((m) => (
              <g class={`pp-pin pp-pin--${m.loc}`} transform={`translate(${m.x.toFixed(1)} ${m.y.toFixed(1)})`}>
                <circle class="pp-pin-ring" r="9" />
                <circle class="pp-pin-ring pp-pin-ring--late" r="9" />
                <circle class="pp-pin-core" r="5.5" />
              </g>
            ))}
          </svg>
          {mapPlaces.map((m, i) => (
            <a href={m.href} class={`pp-place pp-place--${m.loc}`} style={`left:${pct(m.x, MAP_W)};top:${pct(m.y, MAP_H)};--i:${i}`}>
              <span class="pp-faces" aria-hidden="true">
                {m.faces.map((p) => <img src={p.data.photo_url} alt="" loading="lazy" style={photoFocus(p.data.photo_url, p.data.photo_position)} />)}
              </span>
              <span class="pp-place-text">
                <span class="pp-place-name"><span class="wl-ko">{m.ko}</span><span class="wl-en">{m.en}</span></span>
                <span class="pp-place-meta">{m.coord} · <span class="wl-ko">{m.n}명</span><span class="wl-en">{m.n} people</span></span>
              </span>
            </a>
          ))}
        </div>
      </div>
    </header>

    <nav class="pp-bar" aria-label="섬기는이 거르기">
      <div class="pp-shell pp-bar-inner">
        <div class="pp-seg" role="group" aria-label="사역 거점">
          <button type="button" class="is-on" data-loc="all" aria-pressed="true"><span class="wl-ko">전체</span><span class="wl-en">All</span> <em>{counts.all}</em></button>
          <button type="button" data-loc="pt" aria-pressed="false"><span class="wl-ko">평택<span class="pp-seg-long"> 월코센터</span></span><span class="wl-en">Pyeongtaek</span> <em>{counts.pt}</em></button>
          <button type="button" data-loc="jj" aria-pressed="false"><span class="wl-ko">제주<span class="pp-seg-long"> 월비</span></span><span class="wl-en">Jeju</span> <em>{counts.jj}</em></button>
        </div>
        <div class="pp-chips" role="group" aria-label="역할">
          <button type="button" class="is-on" data-role="all" aria-pressed="true"><span class="wl-ko">모두</span><span class="wl-en">Everyone</span></button>
          <button type="button" data-role="missionary" aria-pressed="false"><span class="wl-ko">선교사</span><span class="wl-en">Missionaries</span></button>
          <button type="button" data-role="stw" aria-pressed="false"><span class="wl-ko">단기 사역자</span><span class="wl-en">Short-term</span></button>
        </div>
      </div>
    </nav>

    <main class="pp-shell pp-main">
      <section class="pp-leads-sec" data-leads>
        <p class="pp-kicker"><span class="wl-ko">LEADERSHIP · 대표</span><span class="wl-en">LEADERSHIP</span></p>
        <div class="pp-leads">
          {leads.map((p) => (
            <a href={`/team/${p.slug}`} class="pp-card pp-lead" data-loc={locOf(p)} data-role={p.data.category}>
              <span class="pp-lead-photo">
                {p.data.photo_url ? <img src={p.data.photo_url} alt={p.data.name_ko} loading="lazy" style={photoFocus(p.data.photo_url, p.data.photo_position)} /> : <span class="pp-initial">{initialOf(p)}</span>}
              </span>
              <span class="pp-lead-body">
                <span class="pp-lead-badge"><span class="wl-ko">{roleKo(p.data.role_badge)}</span><span class="wl-en">{p.data.role_badge}</span></span>
                <span class="pp-lead-name"><span class="wl-ko">{p.data.name_ko}</span><span class="wl-en">{p.data.name_en}</span></span>
                <span class="pp-lead-sub"><span class="wl-ko">{p.data.name_en}</span><span class="wl-en">{p.data.name_ko}</span></span>
                <span class="pp-lead-title"><span class="wl-ko">{p.data.title_ko}</span><span class="wl-en">{p.data.title_en}</span></span>
                <span class="pp-go"><span class="wl-ko">프로필 보기</span><span class="wl-en">View profile</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg></span>
              </span>
            </a>
          ))}
        </div>
      </section>

      {groups.map((g) => (
        <section class="pp-group" data-group={g.loc} id={g.loc === 'pt' ? 'wp-pyeongtaek' : 'wp-jeju'}>
          <div class="pp-group-head">
            <div>
              <p class="pp-group-place"><span class="pp-group-num">{g.num}</span><span class="wl-ko">{g.placeKo}</span><span class="wl-en">{g.placeEn}</span></p>
              <h2><span class="wl-ko">{g.ko}</span><span class="wl-en">{g.en}</span></h2>
            </div>
            <p class="pp-group-count"><span data-count>{g.total}</span><span class="wl-ko">명</span><span class="wl-en"> people</span></p>
          </div>
          <ul class="pp-grid">
            {g.people.map((p) => (
              <li data-loc={locOf(p)} data-role={p.data.category}>
                <a href={`/team/${p.slug}`} class="pp-card">
                  <span class="pp-photo">
                    {p.data.photo_url ? <img src={p.data.photo_url} alt={p.data.name_ko} loading="lazy" style={photoFrame(p.data.photo_url, CARD_ASPECT, 'card', p.data.photo_position)} /> : <span class="pp-initial">{initialOf(p)}</span>}
                    <span class="pp-badge"><span class="wl-ko">{roleKo(p.data.role_badge)}</span><span class="wl-en">{p.data.role_badge}</span></span>
                  </span>
                  <span class="pp-info">
                    <span class="pp-name"><span class="wl-ko">{p.data.name_ko}</span><span class="wl-en">{p.data.name_en}</span></span>
                    <span class="pp-en"><span class="wl-ko">{p.data.name_en}</span><span class="wl-en">{p.data.name_ko}</span></span>
                    <span class="pp-title"><span class="wl-ko">{p.data.title_ko}</span><span class="wl-en">{p.data.title_en}</span></span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}

      <p class="pp-empty" hidden><span class="wl-ko">조건에 맞는 사람이 없어요.</span><span class="wl-en">No one matches this filter.</span></p>

      <section class="pp-join">
        <div>
          <p class="pp-join-kicker">JOIN US</p>
          <p class="pp-join-title"><span class="wl-ko">다음 세대를 함께 섬길<br>동역자를 기다립니다</span><span class="wl-en">Serve the next generation<br>with us</span></p>
        </div>
        <div class="pp-join-btns">
          <a href="/camp-register#staff-recruit" class="pp-btn pp-btn--light"><span class="wl-ko">캠프 스태프 지원</span><span class="wl-en">Apply as camp staff</span></a>
          <a href="/give" class="pp-btn pp-btn--ghost"><span class="wl-ko">선교사 후원하기</span><span class="wl-en">Support a missionary</span></a>
        </div>
      </section>
    </main>
  </div>

  <script is:inline>
    // 첫 화면 숫자: 0부터 올라간다(움직임 줄이기 설정이면 그대로 둔다)
    (function () {
      if (window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('.pp-stats [data-count-to]').forEach(function (el, i) {
        var to = +el.dataset.countTo, t0 = 0, delay = 600 + i * 120, dur = 1100;
        el.textContent = '0';
        function step(t) {
          if (!t0) t0 = t;
          var k = Math.min(1, Math.max(0, (t - t0 - delay) / dur));
          el.textContent = Math.round(to * (1 - Math.pow(1 - k, 3)));
          if (k < 1) requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      });
    })();

    // 거르기 막대 자리: 위 메뉴 바로 아래에 붙인다(메뉴 높이는 기기·글자 크기마다 달라 실제 높이를 잰다)
    (function () {
      var bar = document.querySelector('.pp-bar'); if (!bar) return;
      var nav = document.querySelector('.nav');
      var small = window.matchMedia('(max-width: 900px)');
      var lastY = window.scrollY, ticking = false;
      function update() {
        ticking = false;
        if (nav) bar.style.setProperty('--pp-bar-top', Math.max(0, Math.round(nav.getBoundingClientRect().bottom)) + 'px');
        var y = window.scrollY, hero = document.querySelector('.pp-hero');
        var past = hero ? y > hero.offsetTop + hero.offsetHeight : y > 400;
        if (!small.matches || !past || y < lastY - 4) bar.classList.remove('is-tucked');
        else if (y > lastY + 4) bar.classList.add('is-tucked');
        lastY = y;
      }
      window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
      window.addEventListener('resize', update);
      bar.addEventListener('focusin', function () { bar.classList.remove('is-tucked'); });
      update();
    })();

    // 거르기: 사역 거점(전체 · 평택 · 제주) × 역할(모두 · 선교사 · 단기 사역자). 사람이 없는 칸은 통째로 숨긴다
    (function () {
      var root = document.querySelector('.pp'); if (!root) return;
      var state = { loc: 'all', role: 'all' };
      function match(el) { return (state.loc === 'all' || el.dataset.loc === state.loc) && (state.role === 'all' || el.dataset.role === state.role); }
      function apply() {
        root.querySelectorAll('button[data-loc]').forEach(function (b) { var on = b.dataset.loc === state.loc; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); });
        root.querySelectorAll('button[data-role]').forEach(function (b) { var on = b.dataset.role === state.role; b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on)); });
        var anyLead = false;
        root.querySelectorAll('.pp-lead').forEach(function (c) { var ok = match(c); c.hidden = !ok; anyLead = anyLead || ok; });
        root.querySelector('[data-leads]').hidden = !anyLead;
        var total = 0;
        root.querySelectorAll('.pp-group').forEach(function (g) {
          var n = 0; g.querySelectorAll('li[data-loc]').forEach(function (li) { var ok = match(li); li.hidden = !ok; if (ok) n++; });
          total += n;
          // 인원수에는 위 '대표'에 따로 나온 그 거점 디렉터도 넣는다(거르기 막대 · 지도 숫자와 맞춘다)
          root.querySelectorAll('.pp-lead[data-loc="' + g.dataset.group + '"]').forEach(function (c) { if (!c.hidden) n++; });
          g.hidden = !g.querySelector('li[data-loc]:not([hidden])'); g.querySelector('[data-count]').textContent = n;
        });
        root.querySelector('.pp-empty').hidden = !!(total || anyLead);
      }
      root.addEventListener('click', function (e) {
        var b = e.target.closest && e.target.closest('button[data-loc], button[data-role]'); if (!b) return;
        if (b.dataset.loc) state.loc = b.dataset.loc; else state.role = b.dataset.role;
        apply();
      });
    })();
  </script>

  <style>
    .pp { --pp-navy: #0b2430; --pp-deep: #004f68; --pp-cream: #f4f1ea; --pp-line: #e2ddd2; --pp-text: #3e535d; --pp-muted: #6b7d86;
      background: var(--pp-cream); color: #10252e; font-family: var(--ff-sans); word-break: keep-all; overflow: clip; }
    .pp-shell { width: min(1240px, calc(100% - 96px)); margin-inline: auto; }

    /* 첫 화면 — 은은하게 움직이는 빛, 차례로 떠오르는 글, 점으로 찍은 지도 위의 두 거점 */
    .pp-hero { position: relative; overflow: hidden; isolation: isolate; background: radial-gradient(120% 90% at 85% 10%, #123a4a 0%, var(--pp-navy) 55%, #08202a 100%); color: #fff; padding-top: 150px; }
    .pp-glow { position: absolute; z-index: -1; border-radius: 50%; filter: blur(70px); pointer-events: none; will-change: transform; }
    .pp-glow--a { width: 520px; height: 520px; right: 4%; top: 6%; background: rgba(46,150,180,.32); animation: pp-drift-a 18s ease-in-out infinite alternate; }
    .pp-glow--b { width: 420px; height: 420px; left: -6%; bottom: -30%; background: rgba(233,185,95,.14); animation: pp-drift-b 22s ease-in-out infinite alternate; }
    @keyframes pp-drift-a { to { transform: translate(-90px, 60px) scale(1.15); } }
    @keyframes pp-drift-b { to { transform: translate(120px, -50px) scale(.9); } }
    .pp-hero-grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: center; padding-bottom: 64px; }
    .pp-hero-text { display: flex; flex-direction: column; gap: 24px; }
    .pp-rise { animation: pp-rise .9s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--i, 0) * .12s + .1s); }
    @keyframes pp-rise { from { opacity: 0; transform: translateY(22px); } }
    .pp-eyebrow { display: flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 800; letter-spacing: .16em; color: #8fd0e4; }
    .pp-eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; transform-origin: left; animation: pp-line .8s .2s cubic-bezier(.2,.7,.2,1) both; }
    @keyframes pp-line { from { transform: scaleX(0); } }
    .pp-hero h1 { font-family: var(--ff-serif); font-size: clamp(42px, 5vw, 66px); font-weight: 900; line-height: 1.14; letter-spacing: -.035em; color: #fff; }
