---
import { getCollection } from 'astro:content';
// 내 페이지 — 포탈 계정을 본인 소개 페이지에 연결해 두면, 여기서 소개 페이지 편집(기존 편집 시스템)과
// "최근 뉴스레터" 링크 변경을 할 수 있다. 틀(헤더·탭·카드·입력창·버튼)은 경비 리포트와 같은 expense.css 를 쓴다.
const team = (await getCollection('team'))
  .filter(p => !p.slug.startsWith('map-order') && p.data.active !== false)
  .map(p => ({ slug: p.slug, ko: p.data.name_ko, en: p.data.name_en, report: p.data.report_url || '', photo: p.data.photo_url || '' }))
  .sort((a, b) => a.ko.localeCompare(b.ko, 'ko'));
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="robots" content="noindex, nofollow">
  <script is:inline src="/wolko-lang-sync.js?v=2"></script>
  <script is:inline src="/wolko-scroll-lock.js?v=1"></script>
  <title>내 페이지 — WOLKO</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700;800&family=Noto+Sans+KR:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/expense.css?v=91">
  <link rel="stylesheet" href="/mypage.css?v=2">
  <link rel="stylesheet" href="/wolko-lang-toggle.css?v=2">
  <link rel="stylesheet" href="/wolko-rail.css?v=18">
  <link rel="stylesheet" href="/wolko-header.css?v=14">
  <link rel="stylesheet" href="/wolko-ui.css?v=4">
  <link rel="stylesheet" href="/wolko-layout.css?v=15">
  <script src="/wolko-rail.js?v=30" defer></script>
  <meta name="theme-color" content="#004f68">
  <script is:inline src="/wolko-session.js?v=1"></script>
</head>
<body>
  <header class="ex-header">
    <a class="ex-title" href="/portal" title="WOLKO Portal" aria-label="WOLKO Portal"><img src="/images/WOLKO Circle.png" alt="WOLKO"><span data-t="headerTitle">내 페이지</span></a>
    <div style="display:flex;align-items:center;gap:16px;">
      <span class="ex-user" id="exUser"></span>
      <div class="wl-lang-toggle" role="group" aria-label="Language">
        <button type="button" class="wl-lang-btn" id="langKoBtn" data-lang="ko" aria-label="한국어" title="한국어"><img src="https://flagcdn.com/w20/kr.png" alt=""><span>KO</span></button>
        <button type="button" class="wl-lang-btn" id="langEnBtn" data-lang="en" aria-label="English" title="English"><img src="https://flagcdn.com/w20/us.png" alt=""><span>EN</span></button>
      </div>
    </div>
  </header>

  <main class="ex-wrap">
    <div class="mp-who" id="mpWho"></div>
    <nav class="ex-tabs" id="mpTabs"></nav>
    <section id="mpView"></section>
  </main>
  <div class="ex-toast" id="exToast"></div>
  <input type="file" id="mpPdf" accept="application/pdf,.pdf" hidden>

  <script type="application/json" id="mpTeam" set:html={JSON.stringify(team)}></script>
  <script is:inline>
    const TEAM = JSON.parse(document.getElementById('mpTeam').textContent);
    const T = {
      ko: {
        pageTitle: '내 페이지 — WOLKO', headerTitle: '내 페이지',
        lead: '내 소개 페이지를 포탈 로그인으로 바로 편집하고, "최근 뉴스레터" 링크도 여기서 바꿀 수 있어요.',
        tabPage: '내 소개 페이지', tabEdit: '소개 페이지 편집', editOpen: '새 창에서 열기',
        tabLinks: '작성자 연결',
        writingAs: '관리 대상', myPage: '내 소개 페이지',
        notLinked: '아직 내 소개 페이지와 연결되지 않았어요. 마스터에게 포탈 이메일과 소개 페이지 연결을 요청해 주세요.',
        notLinkedAdmin: '내 계정은 아직 소개 페이지와 연결되지 않았어요. "작성자 연결"에서 연결하거나, 위에서 다른 사람 페이지를 골라 대신 관리할 수 있어요.',
        profileTitle: '소개 페이지', profileLead: '사진, 소개글, 말씀, 기도제목, 후원 링크 등을 고쳐요. 포탈 로그인으로 바로 들어가고, 저장하면 기존처럼 사이트에 반영돼요(1~2분).',
        btnView: '소개 페이지 보기', btnEdit: '소개 페이지 편집하기',
        nlTitle: '"최근 뉴스레터" 링크', nlLead: '소개 페이지의 "최근 뉴스레터" 버튼이 열 주소예요. 포탈에서 정하면 바로 반영되고, 비우면 기존에 정해 둔 링크가 쓰여요.',
        pgPh: 'https://… (뉴스레터 · 블로그 · 구독 페이지 주소)', pgSave: '저장', pgClear: '링크 지우기',
        pdfTitle: '새 뉴스레터 올리기 (PDF)', pdfLead: 'PDF 파일을 올리면 "최근 뉴스레터" 버튼이 그 파일로 바뀌어요. 사이트에 반영되기까지 1~2분 걸려요. (포탈에 정해 둔 링크가 있으면 새 파일이 우선하도록 지워져요.)', pdfPick: 'PDF 고르기', pdfBig: 'PDF는 24MB 이하만 올릴 수 있어요. (용량이 크면 PDF를 줄이거나, 위의 링크 방식으로 올려 주세요.)', pdfType: 'PDF 파일만 올릴 수 있어요.', pdfUp: '올리는 중…', tPdf: 'PDF를 올렸어요. 소개 페이지에는 1~2분 안에 반영돼요.', pdfDone: '방금 올림 (반영 대기 중)',
        pgNow: '현재 적용 중', pgBase: '기존 설정 링크', pgNone: '없음',
        tPgSaved: '링크를 저장했어요. 소개 페이지에는 1분 안에 반영돼요.', tPgCleared: '포탈 링크를 지웠어요. 기존 링크가 쓰여요.',
        thPage: '소개 페이지', linkEmail: '포탈 계정', linkPage: '소개 페이지', linkSave: '연결', pickPage: '페이지 고르기', pickAccount: '포탈 계정 고르기', tLinked: '연결했어요.', remove: '해제',
        cUnlink: e => e + ' 연결을 해제할까요?',
        linksLead: '포탈 계정이 어느 소개 페이지를 관리할지 연결해요. 연결된 계정은 그 소개 페이지를 편집하고 뉴스레터 링크를 바꿀 수 있어요.',
        errLogin: '로그인이 필요해요.', errReq: '요청에 실패했어요.',
      },
      en: {
        pageTitle: 'My Page — WOLKO', headerTitle: 'My Page',
        lead: 'Edit your profile page with your portal login, and change your "Newsletter" link here.',
        tabPage: 'My profile page', tabEdit: 'Edit profile page', editOpen: 'Open in new window',
        tabLinks: 'Account links',
        writingAs: 'Managing', myPage: 'My profile page',
        notLinked: 'Your account is not linked to your profile page yet. Please ask the master admin to link your portal email to your page.',
        notLinkedAdmin: 'Your account is not linked to a profile page yet. Link it under "Account links", or pick another page above to manage for them.',
        profileTitle: 'Profile page', profileLead: 'Update your photo, bio, verse, prayer requests, support link and more. You are signed in with your portal login, and saving works as before (live in 1–2 minutes).',
        btnView: 'View profile page', btnEdit: 'Edit profile page',
        nlTitle: '"Newsletter" link', nlLead: 'The address the "Newsletter" button on your profile page opens. A link set here applies right away; leave it empty to use the link already configured.',
        pgPh: 'https://… (newsletter, blog or sign-up page)', pgSave: 'Save', pgClear: 'Clear link',
        pdfTitle: 'Upload a new newsletter (PDF)', pdfLead: 'Upload a PDF and the "Newsletter" button switches to that file. It takes 1–2 minutes to appear on the site. (A link set in the portal is cleared so the new file takes over.)', pdfPick: 'Choose PDF', pdfBig: 'PDF must be 24MB or smaller. (If it is larger, shrink the PDF or use a link above.)', pdfType: 'Only PDF files can be uploaded.', pdfUp: 'Uploading…', tPdf: 'PDF uploaded. Your profile page updates within 1–2 minutes.', pdfDone: 'Just uploaded (waiting to go live)',
        pgNow: 'Currently used', pgBase: 'Existing configured link', pgNone: 'none',
        tPgSaved: 'Saved. Your profile page updates within a minute.', tPgCleared: 'Portal link cleared. The existing link is used.',
        thPage: 'Profile page', linkEmail: 'Portal account', linkPage: 'Profile page', linkSave: 'Link', pickPage: 'Choose a page', pickAccount: 'Choose a portal account', tLinked: 'Linked.', remove: 'Unlink',
        cUnlink: e => 'Unlink ' + e + '?',
        linksLead: 'Link a portal account to the profile page it manages. A linked account can edit that profile page and change its newsletter link.',
        errLogin: 'Please sign in.', errReq: 'Request failed.',
      },
    };
    let lang = (() => { try { return localStorage.getItem('wolko-lang') === 'en' ? 'en' : 'ko'; } catch { return 'ko'; } })();
    const t = (k, ...a) => { const v = T[lang][k] ?? T.ko[k] ?? k; return typeof v === 'function' ? v(...a) : v; };
    const $ = id => document.getElementById(id);
    const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const token = () => sessionStorage.getItem('wolko-hub-token') || '';
    const teamOf = slug => TEAM.find(x => x.slug === slug);
    const teamName = slug => { const p = teamOf(slug); return p ? (lang === 'en' ? p.en : p.ko) : slug; };

    const S = { me: null, link: null, canManage: false, links: [], accounts: [], acting: '', view: 'page' };

    function toast(msg, isError) {
      const el = $('exToast'); el.textContent = msg; el.classList.toggle('error', !!isError); el.classList.add('show');
      clearTimeout(toast.t); toast.t = setTimeout(() => el.classList.remove('show'), 3200);
    }
    async function api(path, opts = {}) {
      const res = await fetch(path, { ...opts, headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + token(), ...(opts.headers || {}) } });
      if (res.status === 401) { sessionStorage.removeItem('wolko-hub-token'); location.replace('/portal'); throw new Error(t('errLogin')); }
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || t('errReq'));
      return body;
    }
    const pageSlug = () => S.acting || S.link?.slug || '';
    const slugQ = () => S.acting ? `?slug=${encodeURIComponent(S.acting)}` : '';

    function applyStatic() {
      document.documentElement.lang = lang; document.title = t('pageTitle');
      document.querySelectorAll('[data-t]').forEach(el => { el.textContent = t(el.dataset.t); });
      $('langKoBtn').classList.toggle('is-active', lang === 'ko'); $('langEnBtn').classList.toggle('is-active', lang === 'en');
    }
    function renderWho() {
      const el = $('mpWho');
      if (!S.canManage || !S.links.length) { el.innerHTML = ''; return; }
      const pages = [...new Map(S.links.map(l => [l.slug, l])).values()];
      const own = S.link?.slug;
      el.innerHTML = `<span>${t('writingAs')}</span><select class="ex-select" id="mpActing">${pages.map(l => `<option value="${esc(l.slug)}" ${(S.acting || own) === l.slug ? 'selected' : ''}>${esc(teamName(l.slug))}${l.slug === own ? ' · ' + t('myPage') : ''}</option>`).join('')}</select>`;
    }
    function renderTabs() {
      const linked = !!pageSlug();
      const tabs = [];
      if (linked) tabs.push(['page', t('tabPage')], ['edit', t('tabEdit')]);
      if (S.canManage) tabs.push(['links', t('tabLinks')]);
      $('mpTabs').innerHTML = tabs.map(([k, l]) => `<button class="ex-tab ${S.view === k ? 'active' : ''}" data-tab="${k}">${l}</button>`).join('');
    }
    async function show(view) {
      if (view === 'page' && !pageSlug()) view = S.canManage ? 'links' : 'page';
      S.view = view; renderWho(); renderTabs();
      if (view === 'page') await showPage(); else if (view === 'edit') showEdit(); else showLinks();
    }

    /* ─────────── 내 소개 페이지 ─────────── */
    async function showPage() {
      const slug = pageSlug();
      if (!slug) { $('mpView').innerHTML = `<div class="ex-card mp-empty">${esc(S.canManage ? t('notLinkedAdmin') : t('notLinked'))}</div>`; return; }
      const d = await api('/api/newsletter/profile' + slugQ());
      const base = teamOf(slug)?.report || '';
      const p = teamOf(slug);
      const shown = d.url || base;
      $('mpView').innerHTML = `
        <div class="ex-card mp-profile">
          ${p?.photo ? `<img class="mp-photo" src="${esc(p.photo)}" alt="">` : ''}
          <div class="mp-profile-main"><h2>${esc(teamName(slug))}</h2><p class="mp-lead" style="margin:4px 0 14px">${esc(t('profileLead'))}</p>
          <div class="mp-actions"><a class="ex-btn" href="/team/${esc(slug)}/" target="_blank" rel="noopener">${t('btnView')} ↗</a><button class="ex-btn primary" data-tab="edit">${t('btnEdit')}</button></div></div>
        </div>
        <div class="ex-card"><h2>${esc(t('nlTitle'))}</h2><p class="mp-lead" style="margin:4px 0 14px">${esc(t('nlLead'))}</p>
          <div class="mp-field"><input class="ex-input" id="pgUrl" type="url" inputmode="url" value="${esc(d.url)}" placeholder="${esc(t('pgPh'))}"></div>
          <p class="mp-hint">${esc(t('pgNow'))}: ${shown ? `<a href="${esc(shown)}" target="_blank" rel="noopener">${esc(shown)}</a>` : esc(t('pgNone'))}${d.url && base ? ` &nbsp;·&nbsp; ${esc(t('pgBase'))}: <a href="${esc(base)}" target="_blank" rel="noopener">${esc(base)}</a>` : ''}</p>
          <div class="mp-actions"><button class="ex-btn primary" data-act="pgsave">${t('pgSave')}</button>${d.url ? `<button class="ex-btn" data-act="pgclear">${t('pgClear')}</button>` : ''}</div>
        </div>
        <div class="ex-card"><h2>${esc(t('pdfTitle'))}</h2><p class="mp-lead" style="margin:4px 0 14px">${esc(t('pdfLead'))}</p>
          <div class="mp-actions"><button class="ex-btn" data-act="pdfpick">${t('pdfPick')}</button></div>
          <p class="mp-hint" id="pdfStatus" style="margin:12px 0 0">${S.justUploaded === slug ? esc(t('pdfDone')) + ': ' : ''}${S.justUploaded === slug ? `<a href="${esc(S.justUrl)}" target="_blank" rel="noopener">${esc(S.justUrl)}</a>` : ''}</p>
        </div>`;
    }


    /* 새 뉴스레터(PDF) 올리기 — 기존 소개 페이지 편집 시스템의 업로드(/api/team/upload)를 포탈 로그인으로 그대로 사용 */
    async function teamToken(slug) {
      const d = await api('/api/team/portal-login', { method: 'POST', body: JSON.stringify({ slug }) });
      return d.token;
    }
    function pickPdf() { return new Promise(res => { const f = $('mpPdf'); f.value = ''; f.onchange = () => res(f.files[0] || null); f.click(); }); }
    async function uploadPdf() {
      const slug = pageSlug(); if (!slug) return;
      const f = await pickPdf(); if (!f) return;
      if (f.type !== 'application/pdf' && !/\.pdf$/i.test(f.name)) return toast(t('pdfType'), true);
      if (f.size > 24 * 1024 * 1024) return toast(t('pdfBig'), true);
      toast(t('pdfUp'));
      const tok = await teamToken(slug);
      const fd = new FormData(); fd.append('file', new File([f], f.name, { type: 'application/pdf' })); fd.append('field', 'report_url');
      const res = await fetch('/api/team/upload', { method: 'POST', headers: { Authorization: 'Bearer ' + tok }, body: fd });
      const body = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(body.error || t('errReq'));
      await api('/api/newsletter/profile' + slugQ(), { method: 'PUT', body: JSON.stringify({ url: '' }) }); // 새 파일이 우선하도록 포탈 링크는 지운다
      S.justUploaded = slug; S.justUrl = body.url;
      toast(t('tPdf')); return showPage();
    }


    /* ─────────── 소개 페이지 편집: 기존 편집 시스템을 포탈 안에 그대로 끼워 넣는다 (포탈 로그인으로 자동 입장) ─────────── */
    function showEdit() {
      const slug = pageSlug();
      $('mpView').innerHTML = `<iframe class="mp-frame" src="/team-visual/${esc(slug)}/" aria-label="${esc(t('tabEdit'))}"></iframe>`;
    }

    /* ─────────── 작성자 연결 (마스터) ─────────── */
    function showLinks() {
      $('mpView').innerHTML = `<div class="ex-card"><p class="mp-lead">${esc(t('linksLead'))}</p>
        ${S.links.length ? `<div style="overflow-x:auto"><table class="mp-table"><thead><tr><th>${t('linkEmail')}</th><th>${t('thPage')}</th><th></th></tr></thead><tbody>
          ${S.links.map(l => `<tr><td>${esc(l.email)}</td><td>${esc(teamName(l.slug))} <span style="color:var(--light)">(${esc(l.slug)})</span></td><td><button class="ex-btn sm danger" data-unlink="${esc(l.email)}">${t('remove')}</button></td></tr>`).join('')}</tbody></table></div>` : ''}
        <div class="mp-grid2" style="margin-top:14px"><div><label class="mp-label">${t('linkEmail')}</label><select class="ex-select" id="lkEmail"><option value="">${t('pickAccount')}</option>${S.accounts.map(a => `<option value="${esc(a.email)}">${esc(a.name ? a.name + ' · ' + a.email : a.email)}${S.links.some(l => l.email === a.email) ? ' ✓' : ''}</option>`).join('')}</select></div>
        <div><label class="mp-label">${t('linkPage')}</label><select class="ex-select" id="lkSlug"><option value="">${t('pickPage')}</option>${TEAM.map(p => `<option value="${esc(p.slug)}">${esc(lang === 'en' ? p.en : p.ko)}</option>`).join('')}</select></div></div>
        <div class="mp-actions" style="margin-top:12px"><button class="ex-btn primary" data-act="link">${t('linkSave')}</button></div></div>`;
    }
    async function loadLinks() {
      const d = await api('/api/newsletter/links');
      S.link = d.me; S.canManage = d.canManage; S.links = d.links || []; S.accounts = d.accounts || [];
      if (!S.acting && !S.link && S.links.length) S.acting = S.links[0].slug;
      if (S.acting && S.acting === S.link?.slug) S.acting = '';
    }

    document.addEventListener('click', async e => {
      const el = e.target.closest('[data-act],[data-tab],[data-unlink]'); if (!el) return;
      try {
        if (el.dataset.tab) return show(el.dataset.tab);
        if (el.dataset.unlink) { if (!confirm(t('cUnlink', el.dataset.unlink))) return; await api('/api/newsletter/links?email=' + encodeURIComponent(el.dataset.unlink), { method: 'DELETE' }); await loadLinks(); return show('links'); }
        const act = el.dataset.act;
        if (act === 'pgsave' || act === 'pgclear') {
          const url = act === 'pgclear' ? '' : $('pgUrl').value.trim();
          await api('/api/newsletter/profile' + slugQ(), { method: 'PUT', body: JSON.stringify({ url }) });
          toast(t(url ? 'tPgSaved' : 'tPgCleared')); return showPage();
        }
        if (act === 'pdfpick') return uploadPdf();
        if (act === 'link') {
          const email = $('lkEmail').value, slug = $('lkSlug').value;
          if (!email || !slug) return;
          await api('/api/newsletter/links', { method: 'PUT', body: JSON.stringify({ email, slug, displayName: teamName(slug) }) });
          toast(t('tLinked')); await loadLinks(); return show('links');
        }
      } catch (err) { toast(err.message, true); }
    });
    document.addEventListener('change', async e => {
      if (e.target.id === 'mpActing') { S.acting = e.target.value === S.link?.slug ? '' : e.target.value; return show(S.view === 'edit' ? 'edit' : 'page'); }
    });
    $('langKoBtn').addEventListener('click', () => setLang('ko'));
    $('langEnBtn').addEventListener('click', () => setLang('en'));
    function setLang(next) {
      if (next === lang) return; lang = next; try { localStorage.setItem('wolko-lang', lang); } catch {}
      applyStatic(); if (S.me) { renderUser(); const fr = document.querySelector('.mp-frame'); if (fr && fr.contentWindow) { fr.contentWindow.postMessage({ type: 'wolko-lang', lang }, location.origin); renderWho(); renderTabs(); } else show(S.view); }
    }
    const renderUser = () => { $('exUser').textContent = S.me?.name || ''; };

    (async function init() {
      applyStatic();
      if (!token()) return location.replace('/portal');
      try { S.me = await api('/api/hub/me'); renderUser(); await loadLinks(); await show('page'); }
      catch (e) { toast(e.message, true); }
    })();
  </script>
</body>
</html>
