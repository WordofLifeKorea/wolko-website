---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="베트남 선교 — Word of Life Korea"
  description="올여름 베트남 청소년 캠프에 함께하세요. 복음 중심 단기선교 · 2026년 6월 5–13일"
  activeNav="ministry"
>

<!-- WOLKO 베트남 선교 본문 | 한/영 이중언어 | 플로팅 바 분리 -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<style>
/* ══ 언어 표시/숨김 — 모든 요소 타입 커버 ══ */
.wl-en,
p.wl-en, h2.wl-en, h3.wl-en, h4.wl-en,
dt.wl-en, dd.wl-en, span.wl-en, div.wl-en,
li.wl-en { display: none !important; }

.wl-ko { display: block; }
span.wl-ko { display: inline; }

.lang-en .wl-ko { display: none !important; }
.lang-en .wl-en { display: block !important; }
.lang-en span.wl-en { display: inline !important; }
.lang-en p.wl-en { display: block !important; }
.lang-en h2.wl-en, .lang-en h3.wl-en, .lang-en h4.wl-en { display: block !important; }
.lang-en dt.wl-en, .lang-en dd.wl-en { display: block !important; }
.lang-en li.wl-en { display: list-item !important; }

/* ══ 전용 클래스 — strong/span CSS 충돌 완전 우회 ══ */
.vn-stat-num { display: block; margin-bottom: 6px; font-size: 28px; line-height: 1.1; font-weight: 900; color: #fff; }
.vn-stat-lbl { display: block; font-size: 14px; color: rgba(255,255,255,0.84); margin: 0; }
.vn-ts-lbl  { margin-bottom: 8px; font-size: 11px; color: #9de5fb; text-transform: uppercase; letter-spacing: 0.1em; font-weight: 800; }
.vn-ts-val  { margin-bottom: 4px; font-size: clamp(18px,2.2vw,24px); line-height: 1.2; font-weight: 900; color: #fff; }
.vn-ts-sub  { font-size: 13px; color: rgba(255,255,255,0.58); margin: 0; }
.vn-pt-ttl  { display: block; margin-bottom: 4px; font-size: 16px; color: #10212a; font-weight: 700; }
.vn-pt-dsc  { display: block; font-size: 15px; color: #5d6a73; line-height: 1.7; }
.vn-cd-ttl  { margin: 0 0 10px; font-size: 22px; line-height: 1.24; letter-spacing: -0.02em; font-weight: 800; }
.vn-cd-dsc  { margin: 0; font-size: 15px; color: #5d6a73; }
.vn-ps-ttl  { display: block; margin-bottom: 8px; font-size: 15px; font-weight: 800; color: #fff; }
.vn-ps-dsc  { display: block; font-size: 13px; line-height: 1.68; color: rgba(255,255,255,0.62); margin: 0; }
.vn-cl-ttl  { display: block; margin-bottom: 6px; font-size: 20px; line-height: 1.25; font-weight: 900; color: #fff; }
.vn-cl-sub  { display: block; font-size: 14px; color: rgba(255,255,255,0.64); margin: 0; }

/* ══ 기본 스타일 ══ */
.wolko-vnlp * { box-sizing: border-box; }
.wolko-vnlp {
  --primary: #004f68; --primary-deep: #083847; --primary-2: #0b6d88;
  --accent: #73d1f5; --bg: #f7fbfc; --text: #14222a; --muted: #5d6a73;
  --line: rgba(0,79,104,0.12); --white: #ffffff;
  --shadow: 0 18px 48px rgba(10,38,48,0.08);
  --shadow-strong: 0 28px 70px rgba(10,38,48,0.14);
  --radius-xl: 32px; --radius-lg: 24px; --max: 1200px;
  --side: 28px; --section: 110px;
  width: 100%; overflow: hidden;
  background: linear-gradient(180deg, #f8fcfd 0%, #ffffff 16%, #ffffff 100%);
  color: var(--text);
  font-family: "Pretendard", "Apple SD Gothic Neo", "Malgun Gothic", sans-serif;
  line-height: 1.72;
}
.wolko-vnlp a { text-decoration: none; color: inherit; }
.wolko-vnlp img { display: block; width: 100%; }
.wolko-vnlp-inner { width: 100%; max-width: var(--max); margin: 0 auto; padding-left: var(--side); padding-right: var(--side); }
.wolko-vnlp-section { padding: var(--section) 0; }

.wolko-vnlp-kicker { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: 999px; background: rgba(0,79,104,0.08); color: var(--primary); font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 18px; }
.wolko-vnlp-title { margin: 0 0 14px; font-size: clamp(32px,5vw,58px); line-height: 1.08; letter-spacing: -0.045em; font-weight: 900; color: #0f2028; }
.wolko-vnlp-subtitle { margin: 0; max-width: 760px; font-size: clamp(16px,2vw,19px); line-height: 1.9; color: var(--muted); }
.wolko-vnlp-btn-row { display: flex; flex-wrap: wrap; gap: 14px; }
.wolko-vnlp-btn { display: inline-flex; align-items: center; justify-content: center; min-height: 58px; padding: 0 24px; border-radius: 999px; font-size: 15px; font-weight: 800; letter-spacing: -0.01em; transition: transform .22s ease, box-shadow .22s ease, background .22s ease; border: 1px solid transparent; cursor: pointer; }
.wolko-vnlp-btn:hover { transform: translateY(-3px); }
.wolko-vnlp-btn.primary { background: #003a5c; color: #fff; box-shadow: 0 14px 36px rgba(0,58,92,0.40); border-color: rgba(255,255,255,0.08); }
.wolko-vnlp-btn.primary:hover { background: #004f7a; box-shadow: 0 18px 44px rgba(0,58,92,0.50); }
.wolko-vnlp-btn.ghost { background: rgba(255,255,255,0.10); color: #fff; border-color: rgba(255,255,255,0.18); backdrop-filter: blur(8px); }
.wolko-vnlp-btn.ghost:hover { background: rgba(255,255,255,0.16); border-color: rgba(255,255,255,0.28); }
.wolko-vnlp-btn.white { background: #fff; color: var(--primary); box-shadow: 0 12px 26px rgba(10,38,48,0.08); }

/* HERO */
.wolko-vnlp-hero { padding: 0; }
.wolko-vnlp-hero-shell { position: relative; width: 100%; min-height: 900px; display: flex; align-items: flex-end; overflow: hidden; background: linear-gradient(180deg, rgba(7,31,42,0.16) 0%, rgba(7,31,42,0.62) 100%), url('https://wolko.synology.me/Web_Contents/Photos/Vietnam_Camp_2025/Hero.JPG') center center / cover no-repeat; }
.wolko-vnlp-hero-shell::before { content: ""; position: absolute; inset: 0; background: radial-gradient(circle at 18% 18%, rgba(255,255,255,0.14), transparent 28%), linear-gradient(135deg, rgba(115,209,245,0.12), transparent 36%); pointer-events: none; }
.wolko-vnlp-hero-content { position: relative; z-index: 2; width: 100%; padding: 56px 0 64px; color: #fff; }
.wolko-vnlp-hero-badge { display: inline-flex; align-items: center; min-height: 38px; padding: 0 16px; border-radius: 999px; background: rgba(255,255,255,0.14); border: 1px solid rgba(255,255,255,0.18); backdrop-filter: blur(6px); font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 20px; }
.vn-hl { color: #73d1f5; }
.wolko-vnlp-hero-title { font-family: 'GmarketSans', 'Pretendard Variable', sans-serif; margin: 0 0 18px; max-width: 760px; font-size: clamp(36px,5.8vw,68px); line-height: 1.22; letter-spacing: -0.025em; font-weight: 800; }
.wolko-vnlp-hero-text { margin: 0 0 28px; max-width: 720px; font-size: clamp(16px,2vw,19px); line-height: 1.88; color: rgba(255,255,255,0.9); }
.wolko-vnlp-hero-stats { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 14px; max-width: 980px; margin-top: 36px; }
.wolko-vnlp-stat { padding: 22px 20px; border-radius: 22px; background: rgba(255,255,255,0.12); border: 1px solid rgba(255,255,255,0.18); backdrop-filter: blur(10px); }

/* INTRO */
.wolko-vnlp-intro-grid { display: grid; grid-template-columns: 1.04fr 0.96fr; gap: 34px; align-items: center; }
.wolko-vnlp-media { position: relative; min-height: 600px; overflow: hidden; border-radius: var(--radius-xl); background: #d7edf3; box-shadow: var(--shadow); }
.wolko-vnlp-media img { width: 100%; height: 100%; object-fit: cover; }
.wolko-vnlp-media-note { position: absolute; left: 22px; right: 22px; bottom: 22px; padding: 16px 18px; border-radius: 18px; background: rgba(255,255,255,0.92); color: var(--primary-deep); font-size: 14px; font-weight: 700; box-shadow: 0 12px 28px rgba(10,38,48,0.08); }
.wolko-vnlp-copy h2 { margin: 0 0 18px; font-size: clamp(28px,4vw,44px); line-height: 1.18; letter-spacing: -0.035em; font-weight: 900; color: #10222a; }
.wolko-vnlp-copy p { margin: 0 0 16px; font-size: 17px; color: var(--muted); }
.wolko-vnlp-copy strong { color: var(--primary); }
.wolko-vnlp-points { display: grid; gap: 14px; margin-top: 28px; }
.wolko-vnlp-point { display: flex; gap: 14px; padding: 18px 20px; border-radius: 20px; background: #fff; border: 1px solid var(--line); box-shadow: 0 10px 24px rgba(10,38,48,0.04); }
.wolko-vnlp-point-no { width: 44px; height: 44px; flex: 0 0 44px; border-radius: 14px; background: rgba(0,79,104,0.08); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 15px; font-weight: 900; }

/* VALUE */
.wolko-vnlp-value { background: linear-gradient(180deg, #f7fbfc 0%, #eef7f9 100%); border-top: 1px solid rgba(0,79,104,0.06); border-bottom: 1px solid rgba(0,79,104,0.06); }
.wolko-vnlp-card-grid { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 20px; margin-top: 34px; }
.wolko-vnlp-card { height: 100%; padding: 30px 24px; border-radius: 26px; background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow); }
.wolko-vnlp-card-no { width: 54px; height: 54px; border-radius: 16px; margin-bottom: 18px; background: linear-gradient(135deg, rgba(0,79,104,0.08), rgba(115,209,245,0.18)); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 18px; font-weight: 900; }

/* GALLERY */
.wolko-vnlp-gallery-grid { display: grid; grid-template-columns: 1.2fr .8fr .8fr; grid-template-rows: 280px 280px; gap: 18px; margin-top: 34px; }
.wolko-vnlp-gallery-item { position: relative; overflow: hidden; border-radius: 24px; box-shadow: var(--shadow); }
.wolko-vnlp-gallery-item.large { grid-row: 1 / span 2; }
.wolko-vnlp-gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .45s ease; }
.wolko-vnlp-gallery-item:hover img { transform: scale(1.04); }
.wolko-vnlp-gallery-caption { position: absolute; left: 18px; bottom: 18px; padding: 10px 14px; border-radius: 14px; background: rgba(255,255,255,0.92); color: #10212a; font-size: 13px; font-weight: 800; }

/* LETTER */
.wolko-vnlp-letter { position: relative; overflow: hidden; background: linear-gradient(160deg, #062635 0%, #004f68 54%, #083d52 100%); color: #fff; }
.wolko-vnlp-letter::before { content: ""; position: absolute; width: 760px; height: 760px; border-radius: 50%; top: -220px; right: -220px; background: radial-gradient(circle, rgba(115,209,245,0.12) 0%, transparent 68%); pointer-events: none; }
.wolko-vnlp-letter::after { content: ""; position: absolute; width: 520px; height: 520px; border-radius: 50%; bottom: -120px; left: -120px; background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%); pointer-events: none; }
.wolko-vnlp-letter .wolko-vnlp-inner { position: relative; z-index: 2; }
.wolko-vnlp-deadline { display: inline-flex; align-items: center; min-height: 36px; padding: 0 15px; border-radius: 999px; background: rgba(196,42,54,0.18); border: 1px solid rgba(196,42,54,0.30); color: #ffb8be; font-size: 13px; font-weight: 800; margin-bottom: 18px; }
.wolko-vnlp-letter-title { margin: 0 0 18px; font-size: clamp(34px,5.5vw,64px); line-height: 1.08; letter-spacing: -0.045em; font-weight: 900; color: #fff; }
.wolko-vnlp-letter-lead { max-width: 760px; margin: 0 0 42px; font-size: clamp(16px,2vw,19px); line-height: 1.9; color: rgba(255,255,255,0.82); }
.wolko-vnlp-top-stats { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 1px; overflow: hidden; border-radius: 24px; background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.10); margin-bottom: 28px; }
.wolko-vnlp-top-stat { padding: 26px 22px; background: rgba(255,255,255,0.04); backdrop-filter: blur(4px); }
.wolko-vnlp-letter-grid { display: grid; grid-template-columns: 1.12fr 0.88fr; gap: 24px; align-items: start; }
.wolko-vnlp-letter-card, .wolko-vnlp-info-card, .wolko-vnlp-process-card, .wolko-vnlp-contact-bar { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); box-shadow: 0 18px 40px rgba(0,0,0,0.08); backdrop-filter: blur(8px); }
.wolko-vnlp-letter-card { border-radius: 30px; padding: 38px 34px; }
.wolko-vnlp-letter-card h3 { margin: 0 0 14px; font-size: clamp(24px,3vw,32px); line-height: 1.28; letter-spacing: -0.03em; font-weight: 900; color: #fff; }
.wolko-vnlp-letter-card p { margin: 0 0 18px; color: rgba(255,255,255,0.82); font-size: 16px; line-height: 1.9; }
.wolko-vnlp-quote { margin: 0 0 24px; padding: 18px 18px 18px 20px; border-left: 3px solid #8fe0fa; border-radius: 18px; background: rgba(255,255,255,0.05); color: #dff7ff; font-size: 16px; line-height: 1.86; }
.wolko-vnlp-tag-row { display: flex; flex-wrap: wrap; gap: 10px; margin: 26px 0 28px; }
.wolko-vnlp-tag { padding: 8px 15px; border-radius: 999px; background: rgba(115,209,245,0.14); border: 1px solid rgba(115,209,245,0.22); color: #b8efff; font-size: 14px; font-weight: 700; }
.wolko-vnlp-info-stack { display: grid; gap: 12px; }
.wolko-vnlp-info-card { border-radius: 22px; padding: 18px; display: flex; gap: 14px; align-items: flex-start; }
.wolko-vnlp-info-no { width: 40px; height: 40px; flex: 0 0 40px; border-radius: 12px; background: rgba(115,209,245,0.12); border: 1px solid rgba(115,209,245,0.18); color: #9de5fb; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; letter-spacing: 0.04em; }
.wolko-vnlp-info-card dt { margin-bottom: 4px; font-size: 12px; font-weight: 800; letter-spacing: 0.06em; color: #9de5fb; text-transform: uppercase; }
.wolko-vnlp-info-card dd { margin: 0; font-size: 14px; color: rgba(255,255,255,0.86); line-height: 1.68; }
.wolko-vnlp-process-card { margin-top: 24px; border-radius: 28px; padding: 34px; }
.wolko-vnlp-process-label { margin-bottom: 12px; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; color: #9de5fb; text-transform: uppercase; }
.wolko-vnlp-process-card h3 { margin: 0 0 24px; font-size: 24px; font-weight: 900; letter-spacing: -0.02em; color: #fff; }
.wolko-vnlp-process-steps { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 14px; }
.wolko-vnlp-process-step { padding: 22px 20px; border-radius: 20px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); }
.wolko-vnlp-process-num { width: 34px; height: 34px; margin-bottom: 12px; border-radius: 50%; background: #8fe0fa; color: #062635; display: flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 900; }
.wolko-vnlp-contact-bar { margin-top: 24px; border-radius: 24px; padding: 28px 30px; display: flex; flex-wrap: wrap; gap: 20px 28px; align-items: center; justify-content: space-between; }
.wolko-vnlp-contact-items { display: flex; flex-wrap: wrap; gap: 8px 22px; }
.wolko-vnlp-contact-item { font-size: 14px; color: rgba(255,255,255,0.82); }
.wolko-vnlp-contact-item b { color: #9de5fb; font-weight: 800; }
.wolko-vnlp-contact-item a { color: rgba(255,255,255,0.82); }

/* FINAL CTA */
.wolko-vnlp-final-cta-shell { border-radius: 34px; padding: 58px 54px; background: linear-gradient(135deg, rgba(0,79,104,0.97) 0%, rgba(11,109,136,0.94) 100%); box-shadow: var(--shadow-strong); color: #fff; }
.wolko-vnlp-final-cta-top { display: grid; grid-template-columns: 1fr auto; gap: 26px; align-items: end; margin-bottom: 22px; }
.wolko-vnlp-final-cta-top h2 { margin: 0; font-size: clamp(30px,4vw,48px); line-height: 1.14; letter-spacing: -0.03em; font-weight: 900; color: #fff; }
.wolko-vnlp-final-cta-top p { margin: 0; max-width: 520px; color: rgba(255,255,255,0.86); font-size: 17px; line-height: 1.82; }
.wolko-vnlp-final-note { margin-top: 16px; font-size: 14px; color: rgba(255,255,255,0.74); }
.wolko-vnlp-final-note a { color: rgba(255,255,255,0.74); text-decoration: underline; }

/* RESPONSIVE */
@media (max-width: 1180px) {
  .wolko-vnlp-hero-stats, .wolko-vnlp-top-stats { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .wolko-vnlp-intro-grid, .wolko-vnlp-letter-grid, .wolko-vnlp-final-cta-top { grid-template-columns: 1fr; }
  .wolko-vnlp-card-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
  .wolko-vnlp-gallery-grid { grid-template-columns: 1fr 1fr; grid-template-rows: 260px 260px 260px; }
  .wolko-vnlp-gallery-item.large { grid-column: 1 / span 2; grid-row: auto; }
  .wolko-vnlp-process-steps { grid-template-columns: 1fr; }
}
@media (max-width: 767px) {
  .wolko-vnlp { --side: 18px; --section: 74px; }
  .wolko-vnlp-hero-shell { min-height: 680px; }
  .wolko-vnlp-hero-content { padding: 34px 0; }
  .wolko-vnlp-hero-title { font-size: clamp(28px, 8vw, 40px); }
  .wolko-vnlp-btn-row, .wolko-vnlp-contact-bar, .wolko-vnlp-contact-items { flex-direction: column; align-items: stretch; }
  .wolko-vnlp-btn { width: 100%; }
  .wolko-vnlp-hero-stats, .wolko-vnlp-top-stats, .wolko-vnlp-card-grid, .wolko-vnlp-gallery-grid { grid-template-columns: 1fr; }
  .wolko-vnlp-gallery-grid { grid-template-rows: 240px 220px 220px 220px 220px; }
  .wolko-vnlp-gallery-item.large { grid-column: auto; }
  .wolko-vnlp-media { min-height: 380px; }
  .wolko-vnlp-letter-card, .wolko-vnlp-process-card, .wolko-vnlp-contact-bar, .wolko-vnlp-final-cta-shell { padding: 24px 20px; border-radius: 22px; }
}
</style>

<div class="wolko-vnlp" id="wl-root">

  <!-- HERO -->
  <section class="wolko-vnlp-hero">
    <div class="wolko-vnlp-hero-shell">
      <div class="wolko-vnlp-inner">
        <div class="wolko-vnlp-hero-content">
          <div class="wolko-vnlp-hero-badge">Word of Life Korea · Vietnam Missions Trip</div>

          <h1 class="wolko-vnlp-hero-title">
            <span class="wl-ko">베트남 <span class="vn-hl">복음 사역</span>에<br>함께하세요</span>
            <span class="wl-en">Join Us for the<br>Vietnam <span class="vn-hl">Gospel Mission</span></span>
          </h1>

          <p class="wolko-vnlp-hero-text">
            <span class="wl-ko">이번 여름, 베트남 현지 청소년들과 함께하는 복음 중심 캠프를 통해 다음 세대에 예수 그리스도의 소망을 전하는 여정에 동참해 주세요.</span>
            <span class="wl-en">This summer, join a Gospel-centered camp alongside local Vietnamese youth — and be part of bringing the hope of Jesus Christ to the next generation.</span>
          </p>

          <div class="wolko-vnlp-btn-row">
            <a href="#vnlp-letter" class="wolko-vnlp-btn primary">
              <span class="wl-ko">참여 안내 보기</span>
              <span class="wl-en">See How to Join</span>
            </a>
            <a href="#vnlp-final" class="wolko-vnlp-btn ghost">
              <span class="wl-ko">신청 바로가기</span>
              <span class="wl-en">Apply Now</span>
            </a>
          </div>

          <div class="wolko-vnlp-hero-stats">
            <div class="wolko-vnlp-stat">
              <p class="vn-stat-num wl-ko">6월 5–13일</p>
              <p class="vn-stat-num wl-en">June 5–13</p>
              <p class="vn-stat-lbl wl-ko">2026 베트남 단기선교 일정</p>
              <p class="vn-stat-lbl wl-en">2026 Vietnam Mission Trip</p>
            </div>
            <div class="wolko-vnlp-stat">
              <p class="vn-stat-num wl-ko">100–120명</p>
              <p class="vn-stat-num wl-en">100–120</p>
              <p class="vn-stat-lbl wl-ko">현지 청소년들과 함께하는 캠프</p>
              <p class="vn-stat-lbl wl-en">Local youth in the camp</p>
            </div>
            <div class="wolko-vnlp-stat">
              <p class="vn-stat-num wl-ko">20–30명</p>
