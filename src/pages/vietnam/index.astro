---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="베트남 선교 — Word of Life Korea"
  description="베트남 복음 사역 — 올여름 베트남 청소년 캠프에 함께하세요. 2026년 6월 5-13일"
  activeNav="ministry"
>

<style>
  :root {
    --c-deep: #004f68; --c-mid: #0a5b76; --c-light: #73d1f5;
    --c-red: #c42a36;
    --c-bg: #f4f8fb; --c-white: #ffffff;
    --c-text: #152028; --c-muted: #5b6b78;
    --c-line: rgba(0,79,104,0.12);
    --r-xl: 28px; --r-lg: 20px; --r-md: 14px;
  }

  /* HERO */
  .hero {
    position:relative; overflow:hidden;
    padding:160px 24px 100px; text-align:center;
    background:
      linear-gradient(180deg, rgba(5,24,36,0.48) 0%, rgba(5,24,36,0.65) 100%),
      url("https://wolko.synology.me/Web_Contents/Photos/Vietnam/Vietnam_Banner.jpg") center / cover no-repeat;
    background-color:#083d51;
  }
  .hero::before {
    content:""; position:absolute; inset:0;
    background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);
    background-size:60px 60px; pointer-events:none;
  }
  .hero-inner { position:relative; z-index:2; max-width:860px; margin:0 auto; }
  .hero-eyebrow {
    display:inline-flex; align-items:center; gap:8px; padding:7px 16px; border-radius:999px;
    background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.22);
    font-size:11px; font-weight:800; letter-spacing:0.09em; color:rgba(255,255,255,0.9);
    margin-bottom:22px; text-transform:uppercase;
  }
  .hero-eyebrow-dot { width:6px; height:6px; border-radius:50%; background:var(--c-light); }
  .hero-inner h1 {
    font-size:clamp(36px,5.5vw,60px); font-weight:800; line-height:1.13;
    letter-spacing:-0.04em; color:#fff; margin-bottom:18px;
    text-shadow:0 6px 24px rgba(0,0,0,0.28);
  }
  .hero-inner h1 em { font-style:normal; color:#9ae3ff; display:block; }
  .hero-sub { font-size:17px; line-height:1.88; color:rgba(255,255,255,0.82); max-width:640px; margin:0 auto 32px; }
  .hero-btns { display:flex; justify-content:center; gap:12px; flex-wrap:wrap; margin-top:32px; }
  .btn-primary {
    display:inline-flex; align-items:center; gap:8px; padding:15px 28px; border-radius:999px;
    background:#fff; color:var(--c-deep); font-size:14px; font-weight:800;
    text-decoration:none; box-shadow:0 10px 28px rgba(0,0,0,0.18); transition:transform .18s, box-shadow .18s;
  }
  .btn-primary:hover { transform:translateY(-2px); box-shadow:0 16px 36px rgba(0,0,0,0.22); }
  .btn-outline {
    display:inline-flex; align-items:center; gap:8px; padding:15px 28px; border-radius:999px;
    background:transparent; border:2px solid rgba(255,255,255,0.5); color:#fff;
    font-size:14px; font-weight:800; text-decoration:none; transition:background .18s;
  }
  .btn-outline:hover { background:rgba(255,255,255,0.12); }

  /* Deadline banner */
  .deadline-bar {
    background:var(--c-red); padding:14px 24px; text-align:center;
    font-size:14px; font-weight:800; color:#fff; letter-spacing:0.03em;
  }
  .deadline-bar span { opacity:0.8; margin:0 8px; }

  .hero-stats {
    position:relative; z-index:2; display:flex; justify-content:center;
    margin:56px auto 0; max-width:800px;
    background:rgba(255,255,255,0.10); border:1px solid rgba(255,255,255,0.16);
    border-radius:18px; backdrop-filter:blur(8px); overflow:hidden;
  }
  .hero-stat { flex:1; padding:20px 14px; text-align:center; border-right:1px solid rgba(255,255,255,0.12); }
  .hero-stat:last-child { border-right:none; }
  .hero-stat-icon { font-size:22px; margin-bottom:6px; }
  .hero-stat-label { font-size:11px; font-weight:700; color:rgba(255,255,255,0.72); line-height:1.4; }

  /* SECTIONS */
  .section { padding:96px 24px; }
  .section--alt { background:var(--c-bg); }
  .page-wrap { max-width:1140px; margin:0 auto; }

  .sec-badge {
    display:inline-block; padding:7px 14px; border-radius:999px;
    background:rgba(0,79,104,0.08); color:var(--c-deep);
    font-size:11px; font-weight:800; letter-spacing:0.06em;
  }
  .sec-title {
    font-size:clamp(28px,4vw,44px); font-weight:800; line-height:1.2;
    letter-spacing:-0.035em; color:var(--c-text); margin:14px 0 16px;
  }
  .sec-desc { font-size:16px; line-height:1.9; color:var(--c-muted); max-width:700px; }

  /* Overview card */
  .overview-card {
    position:relative; background:linear-gradient(180deg, #fff 0%, #f6f9fb 100%);
    border:1px solid var(--c-line); border-radius:var(--r-xl); padding:44px 42px 38px;
    box-shadow:0 22px 56px rgba(16,32,40,0.08); overflow:hidden; margin-top:48px;
  }
  .overview-card::before { content:""; position:absolute; top:0; left:0; right:0; height:5px; background:linear-gradient(90deg, var(--c-deep) 0%, var(--c-mid) 55%, var(--c-light) 100%); }
  .overview-tagline { font-size:15px; font-weight:800; color:var(--c-deep); margin-bottom:20px; }
  .overview-body { font-size:16.5px; line-height:2.0; color:#3a4e58; margin-bottom:14px; }

  /* Who we're looking for */
  .candidates-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px; margin-top:48px; }
  .candidate-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-xl);
    padding:32px 28px; display:flex; flex-direction:column; gap:12px;
    box-shadow:0 4px 18px rgba(0,79,104,0.07); transition:transform .22s, box-shadow .22s;
  }
  .candidate-card:hover { transform:translateY(-4px); box-shadow:0 12px 34px rgba(0,79,104,0.14); }
  .candidate-icon { font-size:28px; }
  .candidate-title { font-size:18px; font-weight:800; color:var(--c-text); }
  .candidate-desc { font-size:14px; line-height:1.82; color:var(--c-muted); }

  /* Distinctives */
  .distinctives-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:18px; margin-top:48px; }
  .distinctive-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-lg);
    padding:28px 26px; box-shadow:0 3px 14px rgba(0,79,104,0.06);
    transition:transform .2s, box-shadow .2s;
  }
  .distinctive-card:hover { transform:translateY(-3px); box-shadow:0 10px 28px rgba(0,79,104,0.12); }
  .distinctive-icon { font-size:24px; margin-bottom:12px; }
  .distinctive-title { font-size:17px; font-weight:800; color:var(--c-text); margin-bottom:8px; }
  .distinctive-desc { font-size:13.5px; line-height:1.8; color:var(--c-muted); }

  /* Schedule */
  .schedule-card {
    background:var(--c-white); border:1px solid var(--c-line); border-radius:var(--r-xl);
    padding:36px 38px; box-shadow:0 6px 28px rgba(0,79,104,0.09);
    display:grid; grid-template-columns:1fr 1fr; gap:28px; margin-top:48px; flex-wrap:wrap;
  }
  .schedule-item { display:flex; flex-direction:column; gap:6px; }
  .schedule-label { font-size:11px; font-weight:800; letter-spacing:0.07em; color:var(--c-mid); text-transform:uppercase; }
  .schedule-value { font-size:17px; font-weight:800; color:var(--c-text); }
  .schedule-note { font-size:13px; color:var(--c-muted); line-height:1.6; }

  /* Tags */
  .tags-wrap { display:flex; flex-wrap:wrap; gap:10px; margin-top:32px; }
  .tag {
    padding:8px 16px; border-radius:999px; background:rgba(0,79,104,0.08);
    color:var(--c-deep); font-size:13px; font-weight:700;
    border:1px solid rgba(0,79,104,0.14);
  }

  /* Steps */
  .steps { display:flex; flex-direction:column; gap:0; margin-top:48px;
    border:1px solid var(--c-line); border-radius:var(--r-xl); overflow:hidden;
    box-shadow:0 6px 24px rgba(0,79,104,0.08); }
  .step { display:flex; gap:24px; padding:28px 32px; background:var(--c-white); align-items:flex-start; border-bottom:1px solid var(--c-line); }
  .step:last-child { border-bottom:none; }
  .step-num { width:40px; height:40px; min-width:40px; border-radius:50%; background:var(--c-deep); color:#fff; font-size:16px; font-weight:900; display:flex; align-items:center; justify-content:center; }
  .step-content { flex:1; }
  .step-title { font-size:17px; font-weight:800; color:var(--c-text); margin-bottom:6px; }
  .step-desc { font-size:14px; line-height:1.8; color:var(--c-muted); }

  /* CTA */
  .cta-section { background:linear-gradient(135deg, var(--c-deep) 0%, var(--c-mid) 100%); padding:88px 24px; text-align:center; }
  .cta-section h2 { font-size:clamp(26px,3.5vw,40px); font-weight:800; color:#fff; margin-bottom:14px; letter-spacing:-0.03em; }
  .cta-section p { font-size:16px; color:rgba(255,255,255,0.78); max-width:560px; margin:0 auto 40px; line-height:1.85; }
  .cta-contact { font-size:14px; color:rgba(255,255,255,0.65); margin-top:28px; line-height:1.9; }
  .cta-contact a { color:rgba(255,255,255,0.9); font-weight:800; text-decoration:none; }
  .btn-white {
    display:inline-flex; align-items:center; gap:8px; padding:16px 30px; border-radius:999px;
    background:#fff; color:var(--c-deep); font-size:15px; font-weight:800;
    text-decoration:none; box-shadow:0 8px 24px rgba(0,0,0,0.18); transition:transform .18s, box-shadow .18s;
  }
  .btn-white:hover { transform:translateY(-2px); box-shadow:0 14px 32px rgba(0,0,0,0.22); }

  .lang-en .wl-ko { display:none; }
  body:not(.lang-en) .wl-en { display:none; }

  @media (max-width:640px) {
    .schedule-card { grid-template-columns:1fr; }
    .step { gap:16px; padding:22px 24px; }
  }
</style>

<!-- DEADLINE BANNER -->
<div class="deadline-bar">
  <span class="wl-ko">⚠️ 신청 마감</span><span class="wl-en">⚠️ Application Deadline</span>
  <span>·</span>
  <span class="wl-ko">4월 24일까지 신청해 주세요</span><span class="wl-en">Applications due by April 24</span>
</div>

<!-- HERO -->
<section class="hero">
  <div class="hero-inner">
    <div class="hero-eyebrow">
      <span class="hero-eyebrow-dot"></span>
      <span class="wl-ko">2026 베트남 단기선교</span>
      <span class="wl-en">2026 Vietnam Short-Term Mission</span>
    </div>
    <h1>
      <span class="wl-ko">베트남 복음 사역에<em>함께하세요</em></span>
      <span class="wl-en">Join Us for the<em>Vietnam Gospel Mission</em></span>
    </h1>
    <p class="hero-sub">
      <span class="wl-ko">이번 여름, 베트남 현지 청소년들과 함께하는 복음 중심 캠프를 통해 다음 세대에 예수 그리스도의 소망을 전하는 여정에 동참해 주세요.</span>
      <span class="wl-en">This summer, join a Gospel-centered camp alongside local Vietnamese youth — and be part of bringing the hope of Jesus Christ to the next generation.</span>
    </p>
    <div class="hero-btns">
      <a href="https://forms.gle" target="_blank" rel="noopener" class="btn-primary">
        <span class="wl-ko">신청 바로가기 →</span>
        <span class="wl-en">Apply Now →</span>
      </a>
      <a href="#overview" class="btn-outline">
        <span class="wl-ko">참여 안내 보기</span>
        <span class="wl-en">See How to Join</span>
      </a>
    </div>
  </div>
  <div class="hero-stats">
    <div class="hero-stat">
      <div class="hero-stat-icon">📅</div>
      <div class="hero-stat-label"><span class="wl-ko">6월 5–13일<br>2026 선교 일정</span><span class="wl-en">June 5–13<br>2026 Mission Trip</span></div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-icon">👧</div>
      <div class="hero-stat-label"><span class="wl-ko">100–120명<br>현지 청소년</span><span class="wl-en">100–120<br>Local Youth</span></div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-icon">🙌</div>
      <div class="hero-stat-label"><span class="wl-ko">20–30명<br>카운슬러 모집</span><span class="wl-en">20–30<br>Counselors Needed</span></div>
    </div>
    <div class="hero-stat">
      <div class="hero-stat-icon">🌏</div>
      <div class="hero-stat-label"><span class="wl-ko">7박 8일<br>청소년 캠프</span><span class="wl-en">7 Nights / 8 Days<br>Youth Camp</span></div>
    </div>
  </div>
</section>

<!-- OVERVIEW -->
<section id="overview" class="section section--alt">
  <div class="page-wrap">
    <span class="sec-badge"><span class="wl-ko">사역 개요</span><span class="wl-en">Mission Overview</span></span>
    <h2 class="sec-title">
      <span class="wl-ko">단기선교 그 이상, 다음 세대를 세우는 복음의 동역</span>
      <span class="wl-en">More Than a Short-Term Trip — Gospel Partnership for the Next Generation</span>
    </h2>
    <div class="overview-card">
      <p class="overview-tagline">
        <span class="wl-ko">복음 중심 · 관계 중심 · 현장 중심 — 이번 선교는 프로그램보다 사람을 세우는 사역입니다.</span>
        <span class="wl-en">Gospel-centered · Relationship-centered · Field-centered — this mission is about building people, not programs.</span>
      </p>
      <p class="overview-body">
        <span class="wl-ko">이번 베트남 선교는 여름 기간 중 진행되는 8일 일정의 단기선교 사역입니다. 핵심 사역은 전도를 주제로 한 7박 8일의 청소년 캠프이며, 약 100~120명의 학생들과 실제로 만나 복음을 나누게 됩니다.</span>
        <span class="wl-en">This Vietnam mission is an 8-day short-term ministry trip. At its heart is a 7-night youth camp centered on evangelism, where you'll meet and share the Gospel with approximately 100–120 students.</span>
      </p>
      <p class="overview-body">
        <span class="wl-ko">소그룹 모임과 관계 중심의 돌봄, 간증과 말씀 나눔을 통해 학생들이 복음을 더 분명히 듣고, 자신의 믿음을 담대히 나눌 수 있도록 돕는 여정입니다.</span>
        <span class="wl-en">Through small group time, relational care, testimonies, and God's Word, you'll help students hear the Gospel more clearly — and find the courage to share their faith with others.</span>
      </p>
    </div>
  </div>
</section>

<!-- WHO WE'RE LOOKING FOR -->
<section class="section">
  <div class="page-wrap">
    <span class="sec-badge"><span class="wl-ko">이런 분을 찾습니다</span><span class="wl-en">Who We're Looking For</span></span>
    <h2 class="sec-title">
      <span class="wl-ko">복음에 마음이 있고, 청소년을 사랑하는 분</span>
      <span class="wl-en">A Heart for the Gospel and a Love for Youth</span>
    </h2>
    <div class="candidates-grid">
      <div class="candidate-card">
        <div class="candidate-icon">❤️</div>
        <div class="candidate-title"><span class="wl-ko">복음에 마음이 있는 사람</span><span class="wl-en">A Heart for the Gospel</span></div>
        <div class="candidate-desc"><span class="wl-ko">예수 그리스도의 소망을 다음 세대에게 전하고 싶은 마음이 가장 중요합니다.</span><span class="wl-en">A genuine desire to share the hope of Jesus Christ with the next generation is what matters most.</span></div>
      </div>
      <div class="candidate-card">
        <div class="candidate-icon">🤝</div>
        <div class="candidate-title"><span class="wl-ko">청소년과 함께 걸을 수 있는 사람</span><span class="wl-en">Someone Who Can Walk with Youth</span></div>
        <div class="candidate-desc"><span class="wl-ko">학생 한 명 한 명과 관계를 맺고, 진심으로 듣고, 함께 기도하는 사역입니다.</span><span class="wl-en">This ministry is about building real relationships with individual students — listening sincerely and praying together.</span></div>
      </div>
      <div class="candidate-card">
        <div class="candidate-icon">👥</div>
        <div class="candidate-title"><span class="wl-ko">팀으로 섬길 준비가 된 사람</span><span class="wl-en">Ready to Serve as a Team</span></div>
        <div class="candidate-desc"><span class="wl-ko">영어로 기본적인 소통이 가능하며, 함께 준비하고 순종하는 자세를 소중히 여깁니다.</span><span class="wl-en">Basic English communication ability is needed, along with a posture of preparation, unity, and willing obedience.</span></div>
      </div>
    </div>
    <div class="tags-wrap">
      <span class="tag"><span class="wl-ko">복음에 대한 사랑</span><span class="wl-en">Love for the Gospel</span></span>
      <span class="tag"><span class="wl-ko">청소년을 향한 마음</span><span class="wl-en">Heart for Youth</span></span>
      <span class="tag"><span class="wl-ko">전도의 열정</span><span class="wl-en">Passion for Evangelism</span></span>
      <span class="tag"><span class="wl-ko">영어 의사소통 가능</span><span class="wl-en">Basic English Ability</span></span>
      <span class="tag"><span class="wl-ko">팀 사역에 대한 준비</span><span class="wl-en">Ready for Team Ministry</span></span>
    </div>
  </div>
</section>

<!-- WHY THIS MISSION -->
<section class="section section--alt">
  <div class="page-wrap">
    <span class="sec-badge"><span class="wl-ko">이 선교가 특별한 이유</span><span class="wl-en">Why Join</span></span>
    <h2 class="sec-title">
      <span class="wl-ko">단순한 일정이 아닌, 실제적인 사역입니다</span>
      <span class="wl-en">Real Ministry, Not Just an Itinerary</span>
    </h2>
    <p class="sec-desc">
      <span class="wl-ko">복음을 전하고 관계를 세우며 현지 공동체를 격려하는 실제적인 사역입니다. 캠프 이후에는 짧은 쉼과 문화 체험, 지역사회를 돕는 봉사 활동도 함께하게 됩니다.</span>
      <span class="wl-en">This isn't just an itinerary to attend — it's real ministry: sharing the Gospel, building relationships, and encouraging the local community. After camp, there's also time for rest, cultural experience, and community service.</span>
    </p>
    <div class="distinctives-grid">
      <div class="distinctive-card">
        <div class="distinctive-icon">👧</div>
        <div class="distinctive-title"><span class="wl-ko">청소년 100~120명과 직접 만나는 사역</span><span class="wl-en">Face-to-Face Ministry with 100–120 Youth</span></div>
        <div class="distinctive-desc"><span class="wl-ko">복음이 필요한 현지 다음 세대를 실제로 만나고, 소그룹과 캠프 프로그램을 통해 깊이 연결되는 기회를 갖습니다.</span><span class="wl-en">You'll actually meet and connect with local youth who need the Gospel — going deep through small groups and camp programming.</span></div>
      </div>
      <div class="distinctive-card">
        <div class="distinctive-icon">📖</div>
        <div class="distinctive-title"><span class="wl-ko">말씀과 관계가 함께 흐르는 현장</span><span class="wl-en">Where the Word and Relationships Flow Together</span></div>
        <div class="distinctive-desc"><span class="wl-ko">단순한 진행 요원이 아니라, 학생들을 사랑으로 돌보고 믿음을 격려하는 카운슬러로 참여하게 됩니다.</span><span class="wl-en">You won't just be helping things run — you'll serve as a counselor who genuinely cares for students and encourages their faith.</span></div>
      </div>
      <div class="distinctive-card">
        <div class="distinctive-icon">🌍</div>
        <div class="distinctive-title"><span class="wl-ko">사역 이후까지 이어지는 배움과 섬김</span><span class="wl-en">Learning and Service That Extends Beyond Camp</span></div>
