---
import BaseLayout from '../../layouts/BaseLayout.astro';
const naverClientId = import.meta.env.PUBLIC_NAVER_CLIENT_ID ?? '';
---
<BaseLayout title="CRS for WOLKO" whiteNav={true} languageOnlyNav={true}>
  <Fragment slot="head">
    <link rel="manifest" href="/crs-manifest.json">
    <meta name="theme-color" content="#004f68">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="WOLKO CRS">
    <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
    <script is:inline src={`https://oapi.map.naver.com/openapi/v3/maps.js?ncpKeyId=${naverClientId}`}></script>
  </Fragment>
  <div id="crs-root"></div>
</BaseLayout>

<style is:global>
  /* ── 전체 레이아웃 ── */
  #crs-root { min-height: 100vh; background: #f4f6f9; font-family: 'Pretendard', 'Apple SD Gothic Neo', sans-serif; padding-top: 76px; }
  /* body overflow:hidden은 iOS Safari에서 fixed 네비 오작동 유발 → 제거
     스크롤 격리는 overscroll-behavior:contain으로 처리 */

  /* ── 로그인 화면 ── */
  .login-wrap { display:flex; align-items:center; justify-content:center; min-height:calc(100vh - 76px); padding:2rem; }
  .login-card { background:#fff; border-radius:16px; box-shadow:0 4px 24px rgba(0,0,0,.10); padding:2.5rem 2rem; width:100%; max-width:400px; }
  .login-logo { text-align:center; margin-bottom:1.5rem; }
  .login-logo h1 { font-size:1.5rem; font-weight:800; color:#004f68; margin:0.5rem 0 0.2rem; }
  .login-logo p { font-size:.85rem; color:#888; margin:0; }
  .login-card label { display:block; font-size:.85rem; font-weight:600; color:#444; margin-bottom:.3rem; }
  .login-card input { width:100%; box-sizing:border-box; padding:.7rem 1rem; border:1.5px solid #ddd; border-radius:8px; font-size:.95rem; margin-bottom:1rem; outline:none; transition:border .2s; }
  .login-card input:focus { border-color:#004f68; }
  .btn-primary { width:100%; padding:.8rem; background:#004f68; color:#fff; border:none; border-radius:8px; font-size:1rem; font-weight:700; cursor:pointer; transition:background .2s; }
  .btn-primary:hover { background:#003a50; }
  .login-err { color:#e53935; font-size:.85rem; margin-bottom:.8rem; text-align:center; display:none; }

  /* ── 앱 헤더 ── */
  .app-header { background:#004f68; color:#fff; padding:1rem 1.5rem; display:flex; align-items:center; justify-content:space-between; position:sticky; top:76px; z-index:999; box-shadow:0 2px 8px rgba(0,0,0,.15); }
  .app-header h1 { margin:0; font-size:1.1rem; font-weight:800; letter-spacing:.5px; }
  .app-header .user-info { display:flex; align-items:center; gap:.8rem; font-size:.85rem; }
  .btn-logout { background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.3); color:#fff; padding:.35rem .9rem; border-radius:20px; font-size:.8rem; cursor:pointer; transition:background .2s; }
  .btn-logout:hover { background:rgba(255,255,255,.25); }
  .btn-install { background:rgba(255,255,255,.18); border:1px solid rgba(255,255,255,.4); color:#fff; padding:.35rem .9rem; border-radius:20px; font-size:.8rem; cursor:pointer; transition:background .2s; display:inline-flex; align-items:center; gap:.3rem; font-weight:600; }
  .btn-install:hover { background:rgba(255,255,255,.28); }

  /* ── 상단 컨트롤 ── */
  .top-bar { display:flex; gap:.8rem; flex-wrap:wrap; position:sticky; top:0; z-index:10; background:#f4f6f9; padding:1.2rem 0 .9rem; margin-bottom:0; max-width:560px; width:100%; margin-left:auto; margin-right:auto; box-sizing:border-box; padding-left:1.2rem; padding-right:1.2rem; }
  .search-input { flex:1; min-width:140px; padding:.65rem .95rem; border:1.5px solid #dde5ea; border-radius:9px; font-size:.88rem; outline:none; background:#fff; transition:border .2s, box-shadow .2s; }
  .search-input:focus { border-color:#004f68; box-shadow:0 0 0 3px rgba(0,79,104,.09); }
  .btn-add { background:#004f68; color:#fff; border:none; border-radius:9px; padding:.65rem 1.1rem; font-size:.88rem; font-weight:700; cursor:pointer; white-space:nowrap; display:flex; align-items:center; gap:.4rem; transition:background .18s; }
  .btn-add:hover { background:#003a50; }

  /* ── 교회 카드 리스트 ── */
  .church-list { display:grid; gap:.9rem; }
  .church-card { background:#fff; border-radius:12px; box-shadow:0 1px 3px rgba(0,0,0,.07), 0 4px 14px rgba(0,0,0,.05); cursor:pointer; transition:box-shadow .2s, transform .18s; overflow:hidden; border:1px solid #e5edf1; }
  .church-card:hover { box-shadow:0 4px 20px rgba(0,79,104,.13), 0 1px 4px rgba(0,0,0,.06); transform:translateY(-2px); }
  .church-card-header { background:#f4f9fb; border-bottom:1px solid #e5edf1; padding:.95rem 1.3rem .85rem; display:flex; justify-content:space-between; align-items:flex-start; gap:1rem; }
  .church-card-body { padding:.85rem 1.3rem 1rem; }
  .church-name { font-size:1rem; font-weight:700; color:#0d2b38; margin:0 0 .2rem; line-height:1.3; }
  .pastor-name { font-size:.82rem; color:#6a8fa0; margin:0; }
  .step-badge { background:#004f68; color:#fff; font-size:.72rem; font-weight:700; padding:.28rem .75rem; border-radius:20px; white-space:nowrap; flex-shrink:1; letter-spacing:.2px; max-width:58%; overflow:hidden; text-overflow:ellipsis; }
  .step-badge.complete { background:#1a8c68; }
  @media(max-width:480px) { .badge-desc { display:none; } }
  .step-bar-wrap { margin-bottom:.75rem; }
  .step-bar-bg { background:#ddeaf0; border-radius:99px; height:8px; overflow:hidden; }
  .step-bar-fill { background:linear-gradient(90deg,#004f68,#1a9dbf); height:100%; border-radius:99px; transition:width .4s; }
  .step-bar-label { font-size:.73rem; color:#8aacba; margin-top:.35rem; font-weight:500; }
  .card-meta { display:flex; flex-direction:column; gap:.55rem; }
  .card-meta-divider { height:1px; background:#edf2f5; margin-top:.65rem; margin-bottom:.75rem; }
  .card-meta span { font-size:.78rem; color:#4a6070; display:flex; align-items:center; gap:.3rem; }
  .meta-label { font-style:normal; font-size:.66rem; font-weight:700; background:#e5f0f5; color:#004f68; padding:.1rem .4rem; border-radius:3px; letter-spacing:.4px; white-space:nowrap; text-transform:uppercase; }
  /* ── 카드 다음 단계 힌트 ── */
  .next-step-row { display:flex; align-items:baseline; gap:.5rem; margin-top:.5rem; }
  .next-step-label { font-size:.66rem; font-weight:700; color:#004f68; background:#e5f0f5; padding:.1rem .4rem; border-radius:3px; letter-spacing:.4px; white-space:nowrap; text-transform:uppercase; flex-shrink:0; }
  .next-step-text { font-size:.78rem; color:#4a6070; line-height:1.3; }

  /* ── 빈 상태 ── */
  .empty-state { text-align:center; padding:4rem 2rem; color:#aaa; }
  .empty-state svg { margin-bottom:1rem; opacity:.4; }
  .empty-state p { font-size:1rem; margin:.3rem 0; }

  /* ── 모달 공통 ── */
  @keyframes modalIn { from { opacity:0; transform:translateY(18px) scale(.98); } to { opacity:1; transform:none; } }
  /* ── 스플릿 레이아웃 ── */
  .app-body { width:100%; max-width:1440px; margin:0 auto; padding:0; display:flex; height:calc(100vh - 76px - 3.25rem); }
  /* 왼쪽: 교회 목록 */
  .list-panel { flex:1; min-width:0; overflow-y:auto; background:#f4f6f9; transition:flex .3s cubic-bezier(.4,0,.2,1); display:flex; flex-direction:column; overscroll-behavior:contain; }
  .list-panel-inner { padding:0 1.2rem 4rem; flex:1; max-width:560px; width:100%; margin:0 auto; box-sizing:border-box; }
  .app-body.split .list-panel { flex:0 0 380px; border-right:1px solid #dde5ea; }
  /* 오른쪽: 상세 */
  .detail-panel { flex:0 0 0%; min-width:0; max-width:0; overflow:hidden; opacity:0; display:flex; flex-direction:column; background:#fff; transition:max-width .3s cubic-bezier(.4,0,.2,1), opacity .25s ease; }
  .app-body.split .detail-panel { flex:1 1 0%; max-width:9999px; opacity:1; overflow:hidden; border-left:1px solid #dde5ea; }
  /* 상세 헤더 */
  .detail-panel-head { background:#004f68; padding:1.3rem 1.5rem 1.1rem; display:flex; align-items:center; gap:1rem; flex-shrink:0; }
  .detail-panel-avatar { width:40px; height:40px; border-radius:10px; background:rgba(255,255,255,.18); color:#fff; font-size:1.1rem; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; letter-spacing:-.02em; }
  .detail-panel-title { color:#fff; font-size:1.05rem; font-weight:800; margin:0; letter-spacing:-.02em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .detail-panel-sub { color:rgba(255,255,255,.62); font-size:.75rem; margin:.15rem 0 0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .detail-panel-close { background:rgba(255,255,255,.14); border:none; color:#fff; width:30px; height:30px; border-radius:50%; cursor:pointer; font-size:1rem; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:background .18s; margin-left:auto; }
  .detail-panel-close:hover { background:rgba(255,255,255,.28); }
  /* 진행률 바 */
  .detail-panel-prog { height:3px; background:rgba(255,255,255,.15); flex-shrink:0; }
  .detail-panel-prog-fill { height:100%; background:rgba(255,255,255,.7); transition:width .5s ease; }
  /* 본문 */
  .detail-panel-body { flex:1; overflow-y:auto; min-height:0; padding:1.4rem 1.6rem 1rem; scrollbar-width:thin; scrollbar-color:#c8dfe8 transparent; overscroll-behavior:contain; }
  .detail-panel-body::-webkit-scrollbar { width:4px; }
  .detail-panel-body::-webkit-scrollbar-thumb { background:#c8dfe8; border-radius:99px; }
  .detail-panel-body .detail-actions { background:#fff; padding:.9rem 0 .3rem; border-top:1px solid #edf2f5; margin-top:1.2rem; }
  /* 카드 선택 강조 */
  .church-card.selected { border-left:3px solid #004f68; border-color:#004f68; background:#f4f9fc; }
  .church-card.selected .church-card-header { background:#e8f2f7; }
  /* 스플릿 모드 카드 compact */
  .app-body.split .church-card-body { padding:.65rem 1.1rem .75rem; }
  .app-body.split .step-bar-label { display:none; }
  .app-body.split .next-step-row { display:none; }
  .app-body.split .card-meta-divider { margin:.4rem 0 .5rem; }
  .app-body.split .church-card { border-radius:10px; }
  /* 모바일 */
  @keyframes detailPageIn { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:none; } }
  @media(max-width:768px) {
    .app-body { height:auto; min-height:calc(100vh - 76px); }
    .app-body.split .list-panel { display:none; }
    .app-body.split .detail-panel {
      position:fixed; inset:0;
      z-index:1200; width:100%; max-width:none; height:100dvh;
      flex:unset; opacity:1; overflow:hidden;
      transition:none;
      animation:detailPageIn .2s ease-out;
    }
  }
  .modal-backdrop { display:none; position:fixed; inset:0; background:rgba(0,15,30,.55); backdrop-filter:blur(7px); -webkit-backdrop-filter:blur(7px); z-index:1100; align-items:center; justify-content:center; padding:1rem; }
  .modal-backdrop.open { display:flex; }
  .modal { background:#fff; border-radius:20px; width:100%; max-width:560px; max-height:90vh; overflow-y:auto; box-shadow:0 24px 64px rgba(0,30,60,.22), 0 4px 16px rgba(0,0,0,.08); scrollbar-width:thin; scrollbar-color:#c8dfe8 transparent; animation:modalIn .22s cubic-bezier(.4,0,.2,1); }
  .modal::-webkit-scrollbar { width:4px; }
  .modal::-webkit-scrollbar-track { background:transparent; }
  .modal::-webkit-scrollbar-thumb { background:#c8dfe8; border-radius:99px; }
  .modal::-webkit-scrollbar-thumb:hover { background:#8aacba; }
  .modal-header { padding:1.4rem 1.6rem 1.1rem; border-bottom:1px solid #edf2f5; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; background:#fff; z-index:1; border-radius:20px 20px 0 0; }
  .modal-header::before { content:''; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#004f68,#1a9dbf); border-radius:20px 20px 0 0; }
  .modal-header h2 { margin:0; font-size:1.08rem; font-weight:800; color:#0d2b38; letter-spacing:-.01em; }
  .btn-close { background:#f0f5f7; border:none; width:30px; height:30px; border-radius:50%; cursor:pointer; color:#6a8fa0; font-size:1.1rem; line-height:1; display:flex; align-items:center; justify-content:center; transition:background .18s, color .18s; flex-shrink:0; }
  .btn-close:hover { background:#e0eaee; color:#0d2b38; }
  .modal-body { padding:1.4rem 1.6rem 1.7rem; }
  .form-group { margin-bottom:1rem; }
  .form-group label { display:block; font-size:.78rem; font-weight:700; color:#4a6070; text-transform:uppercase; letter-spacing:.05em; margin-bottom:.4rem; }
  .form-group input, .form-group textarea, .form-group select { width:100%; box-sizing:border-box; padding:.72rem 1rem; border:1.5px solid #e2eaee; border-radius:10px; font-size:.9rem; outline:none; transition:border .2s, box-shadow .2s, background .2s; font-family:inherit; background:#f8fbfd; color:#0d2b38; }
  .form-group select { height:44px; }
  .form-group input:focus, .form-group textarea:focus, .form-group select:focus { border-color:#004f68; background:#fff; box-shadow:0 0 0 3px rgba(0,79,104,.1); }
  .form-group textarea { resize:vertical; min-height:80px; }
  .form-row { display:grid; grid-template-columns:1fr 1fr; gap:.8rem; }
  .modal-footer { display:flex; gap:.7rem; justify-content:flex-end; margin-top:1.4rem; padding-top:1.1rem; border-top:1px solid #edf2f5; }
  .btn-cancel { background:#f0f5f7; color:#4a6070; border:none; border-radius:10px; padding:.7rem 1.3rem; font-size:.88rem; cursor:pointer; font-weight:600; transition:background .18s; }
  .btn-cancel:hover { background:#e0eaee; }
  .btn-save { background:linear-gradient(135deg,#004f68,#007ea1); color:#fff; border:none; border-radius:10px; padding:.7rem 1.5rem; font-size:.88rem; font-weight:700; cursor:pointer; transition:opacity .18s, transform .15s; box-shadow:0 2px 8px rgba(0,79,104,.25); }
  .btn-save:hover { opacity:.9; transform:translateY(-1px); }

  /* ── 교회 상세 모달 ── */
  .detail-info { background:linear-gradient(135deg,#f0f7fa,#f8fbfc); border-radius:12px; padding:1.1rem 1.3rem; margin-bottom:1.2rem; border:1px solid #e2edf2; }
  .detail-info-row { display:flex; gap:.6rem; font-size:.88rem; color:#4a6070; margin-bottom:.65rem; flex-wrap:wrap; line-height:1.5; }
  .detail-info-row:last-child { margin-bottom:0; }
  .detail-info-row strong { color:#0d2b38; min-width:76px; flex-shrink:0; font-weight:700; }
  .last-visit-row { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; font-size:.88rem; color:#4a6070; margin-bottom:.65rem; }
  .last-visit-row strong { color:#0d2b38; min-width:76px; flex-shrink:0; }
  .last-visit-input { padding:.3rem .6rem; border:1.5px solid #e2eaee; border-radius:7px; font-size:.83rem; outline:none; transition:border .2s; font-family:inherit; background:#f8fbfd; }
  .last-visit-input:focus { border-color:#004f68; }
  .btn-save-small { background:#004f68; color:#fff; border:none; border-radius:7px; padding:.3rem .7rem; font-size:.75rem; font-weight:600; cursor:pointer; white-space:nowrap; transition:opacity .18s; }
  .btn-save-small:hover { opacity:.85; }
  /* ── 저장 확인 알림 ── */
  .save-alert-backdrop { position:fixed; inset:0; background:rgba(0,15,30,.45); z-index:1200; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(4px); }
  .save-alert { background:#fff; border-radius:16px; padding:1.7rem 2rem 1.4rem; text-align:center; box-shadow:0 16px 48px rgba(0,0,0,.18); min-width:220px; animation:modalIn .2s ease; }
  .save-alert p { margin:0 0 1.1rem; font-size:.95rem; color:#0d2b38; font-weight:700; }
  .save-alert .btn-primary { width:100%; padding:.68rem; font-size:.9rem; border-radius:10px; }
  .steps-header { display:flex; justify-content:space-between; align-items:center; margin:1.3rem 0 .75rem; border-bottom:2px solid #e8f4f8; padding-bottom:.55rem; }
  .steps-title { font-size:.9rem; font-weight:800; color:#0d2b38; margin:0; letter-spacing:-.01em; }
  .steps-toggle { background:#f0f7fa; border:none; color:#004f68; font-size:.74rem; font-weight:700; padding:.28rem .75rem; border-radius:20px; cursor:pointer; transition:background .18s; }
  .steps-toggle:hover { background:#ddeaf0; }
  .steps-list.collapsed { display:none; }
  .step-item { display:flex; align-items:flex-start; gap:.9rem; padding:.75rem .4rem; border-bottom:1px solid #f0f5f7; cursor:pointer; transition:background .15s; border-radius:10px; margin:0 -.4rem; }
  .step-item:last-child { border-bottom:none; }
  .step-item:hover { background:#f4f9fb; }
  .step-check { width:22px; height:22px; border-radius:7px; border:2px solid #d0dde4; background:#fff; display:flex; align-items:center; justify-content:center; flex-shrink:0; transition:all .2s; margin-top:1px; box-shadow:0 1px 3px rgba(0,0,0,.06); }
  .step-check.checked { background:linear-gradient(135deg,#004f68,#007ea1); border-color:#004f68; box-shadow:0 2px 6px rgba(0,79,104,.3); }
  .step-check svg { display:none; }
  .step-check.checked svg { display:block; }
  .step-text { flex:1; }
  .step-num { font-size:.72rem; font-weight:700; color:#b0c4ce; display:block; margin-bottom:.12rem; letter-spacing:.04em; }
  .step-desc { font-size:.88rem; color:#4a6070; line-height:1.4; }
  .step-item.done .step-num { color:#5aabcc; }
  .step-item.done .step-desc { color:#0d2b38; font-weight:600; }
  .detail-actions { display:flex; gap:.7rem; margin-top:1.4rem; padding-top:1.1rem; border-top:1px solid #edf2f5; }
  .btn-edit { flex:1; background:#f0f5f7; color:#334a56; border:none; border-radius:10px; padding:.75rem; font-size:.88rem; font-weight:700; cursor:pointer; transition:background .18s; }
  .btn-edit:hover { background:#e0eaee; }
  .btn-delete { background:#fff5f5; color:#d32f2f; border:1.5px solid #ffd0d0; border-radius:10px; padding:.75rem 1.1rem; font-size:.88rem; font-weight:700; cursor:pointer; transition:background .18s; }
  .btn-delete:hover { background:#ffebeb; }

  /* ── 회원가입 토글 ── */
  .signup-toggle { text-align:center; margin-top:1rem; font-size:.83rem; color:#888; }
  .signup-toggle a { color:#004f68; font-weight:600; cursor:pointer; }
  .signup-toggle a:hover { text-decoration:underline; }
  /* ── 승인 대기 화면 ── */
  .pending-wrap { display:flex; align-items:center; justify-content:center; min-height:calc(100vh - 76px); padding:2rem; }
  .pending-card { background:#fff; border-radius:16px; box-shadow:0 4px 24px rgba(0,0,0,.10); padding:2.5rem 2rem; width:100%; max-width:400px; text-align:center; }
  .pending-icon { width:56px; height:56px; background:#e8f4f8; border-radius:50%; display:flex; align-items:center; justify-content:center; margin:0 auto 1.2rem; }
  .pending-card h2 { font-size:1.2rem; font-weight:800; color:#004f68; margin:0 0 .7rem; }
  .pending-card p { font-size:.88rem; color:#666; margin:0 0 1.5rem; line-height:1.7; white-space:pre-line; }
  /* ── 관리자 패널 ── */
  .admin-btn { background:rgba(255,255,255,.15); border:1px solid rgba(255,255,255,.3); color:#fff; padding:.35rem .9rem; border-radius:20px; font-size:.8rem; cursor:pointer; transition:background .2s; }
  .admin-btn:hover { background:rgba(255,255,255,.25); }
  .user-row { display:flex; align-items:center; gap:.8rem; padding:.9rem 0; border-bottom:1px solid #f0f0f0; }
  .user-row:last-child { border-bottom:none; }
  .user-info-block { flex:1; min-width:0; }
  .user-name-text { font-size:.9rem; font-weight:600; color:#1a1a1a; }
  .user-email-text { font-size:.76rem; color:#888; margin-top:.1rem; }
  .user-date-text { font-size:.72rem; color:#bbb; margin-top:.1rem; }
  .btn-approve { background:#004f68; color:#fff; border:none; border-radius:6px; padding:.32rem .75rem; font-size:.78rem; font-weight:600; cursor:pointer; white-space:nowrap; }
  .btn-approve:hover { background:#003a50; }
  .btn-reject-user { background:#fff0f0; color:#e53935; border:1.5px solid #ffcdd2; border-radius:6px; padding:.3rem .6rem; font-size:.78rem; font-weight:600; cursor:pointer; white-space:nowrap; }
  .btn-reject-user:hover { background:#ffebee; }
  .no-pending { text-align:center; color:#aaa; padding:2rem 0; font-size:.9rem; }
  .admin-section-title { font-size:.82rem; font-weight:700; color:#888; text-transform:uppercase; letter-spacing:.5px; margin-bottom:.5rem; padding-bottom:.4rem; border-bottom:1px solid #eee; }
  /* ── 스켈레톤/로딩 ── */
  .loading-wrap { display:flex; align-items:center; justify-content:center; padding:4rem; }
  .spinner { width:36px; height:36px; border:4px solid #e8f4f8; border-top-color:#004f68; border-radius:50%; animation:spin .8s linear infinite; }
  @keyframes spin { to { transform:rotate(360deg); } }

  /* ── 반응형 ── */
  @media(max-width:600px) {
    .form-row { grid-template-columns:1fr; }
    .app-header h1 { font-size:.95rem; }
    .top-bar { padding:.9rem .8rem .7rem; max-width:100%; }
    .list-panel-inner { padding:0 .8rem 3rem; max-width:100%; }
    .modal-body { padding:1rem 1rem 1.2rem; }
  }

  /* ── CRS professional UI concept ── */
  #crs-root {
    --crs-ink:#173440;
    --crs-muted:#637983;
    --crs-faint:#8ba0a9;
    --crs-line:#dce6e9;
    --crs-soft:#f3f7f8;
    --crs-panel:#ffffff;
    --crs-brand:#00566c;
    --crs-brand-dark:#103c4c;
    --crs-brand-light:#deeff3;
    --crs-cyan:#2d9fba;
    --crs-green:#27795f;
    --crs-red:#b64045;
    padding-top:58px;
    background:#edf2f3;
    color:var(--crs-ink);
  }
  .app-header {
    min-height:64px;
    box-sizing:border-box;
    padding:.8rem max(1.15rem,calc((100vw - 1440px) / 2 + 1.3rem));
    top:0;
    background:var(--crs-brand-dark);
    border-bottom:1px solid rgba(255,255,255,.1);
    box-shadow:0 8px 24px rgba(17,52,64,.16);
  }
  .app-brand { display:flex; align-items:center; gap:.75rem; min-width:0; }
  .app-brand-mark {
    display:grid; place-items:center; width:35px; height:35px; flex:0 0 auto;
    border:1px solid rgba(255,255,255,.24); border-radius:10px;
    background:rgba(255,255,255,.1); color:#fff; font-size:.8rem; font-weight:900;
  }
  .app-header h1 { font-size:1rem; letter-spacing:0; line-height:1.1; }
  .app-kicker { display:block; margin-top:.2rem; color:rgba(255,255,255,.58); font-size:.66rem; font-weight:650; letter-spacing:.08em; text-transform:uppercase; }
  .app-header .user-info { gap:.55rem; color:rgba(255,255,255,.78); font-weight:600; }
  .app-header .user-info > span { max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .nav.language-only { visibility:hidden; }
  body.crs-auth-ready .nav.language-only { visibility:visible; }
  body.crs-app-active .nav.language-only { display:none; }
  body.crs-app-active #crs-root { padding-top:0; }
  .crs-lang-toggle {
    display:flex; align-items:center; gap:2px; height:32px; padding:3px;
    border:1px solid rgba(255,255,255,.2); border-radius:999px;
    background:rgba(255,255,255,.1); color:rgba(255,255,255,.68);
    cursor:pointer; font-size:.68rem; font-weight:800; line-height:1;
  }
  .crs-lang-toggle span {
    display:grid; place-items:center; min-width:25px; height:24px; padding:0 5px;
    border-radius:999px;
  }
  .crs-lang-toggle span.active { background:#fff; color:var(--crs-brand); }
  .admin-btn, .btn-logout {
    padding:.42rem .72rem; border-color:rgba(255,255,255,.2); border-radius:8px;
    background:rgba(255,255,255,.09); font-weight:750;
  }
  .admin-btn:hover, .btn-logout:hover { background:rgba(255,255,255,.17); }
  .app-body { max-width:1440px; height:calc(100vh - 4rem); background:#edf2f3; }
  .list-panel { background:#edf2f3; }
  .list-panel-inner { max-width:620px; padding:0 1.25rem 4rem; }
  .top-bar {
    max-width:620px; padding:1.2rem 1.25rem .9rem; gap:.65rem;
    background:rgba(237,242,243,.96); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);
  }
  .search-input {
    min-height:43px; padding:.68rem .9rem; border:1px solid #cedcdf; border-radius:8px;
    background:#fff; color:var(--crs-ink); box-shadow:0 1px 2px rgba(20,52,64,.04);
  }
  .search-input::placeholder { color:#91a3aa; }
  .search-input:focus { border-color:var(--crs-cyan); box-shadow:0 0 0 3px rgba(45,159,186,.12); }
  .btn-add {
    min-height:43px; padding:.68rem 1rem; border-radius:8px; background:var(--crs-brand);
    box-shadow:0 4px 10px rgba(0,86,108,.16);
  }
  .btn-add:hover { background:#00475a; }
  .church-list { gap:.72rem; }
  .church-card {
    position:relative; border:1px solid var(--crs-line); border-radius:10px; background:#fff;
    box-shadow:0 2px 8px rgba(19,52,64,.055); transition:border-color .18s, box-shadow .18s, transform .18s;
  }
  .church-card::before {
    content:''; position:absolute; inset:0 auto 0 0; width:3px;
    background:var(--card-accent, transparent); transition:background .18s;
  }
  .church-card:hover { border-color:#b8ced5; box-shadow:0 8px 20px rgba(19,52,64,.1); transform:translateY(-1px); }
  .church-card:hover::before { background:var(--card-accent, var(--crs-cyan)); }
  .rank-badge { display:inline-flex; align-items:center; justify-content:center; min-width:20px; height:20px; border-radius:50%; font-size:.68rem; font-weight:900; flex-shrink:0; margin-top:2px; padding:0 3px; }
  .church-card-header { padding:.9rem 1.05rem .74rem; background:#fff; border-bottom:1px solid #edf2f3; }
  .church-card-body { padding:.8rem 1.05rem .92rem; }
  .church-name { color:var(--crs-ink); font-size:.97rem; font-weight:820; }
  .pastor-name { color:#748990; font-size:.78rem; }
  .step-badge {
    max-width:54%; padding:.26rem .57rem; border:1px solid #c9e0e6; border-radius:6px;
    background:#e8f4f6; color:#006079; font-size:.68rem; font-weight:800;
  }
  .step-badge.complete { border-color:#c9e5da; background:#e7f5ef; color:var(--crs-green); }
  .step-bar-wrap { margin-bottom:.62rem; }
  .step-bar-bg { height:6px; background:#e4edef; }
  .step-bar-fill { background:var(--crs-cyan); }
  .step-bar-label { margin-top:.3rem; color:#799099; font-size:.7rem; font-weight:650; }
  .next-step-row { align-items:center; gap:.42rem; }
  .next-step-label, .meta-label {
    padding:.12rem .34rem; border-radius:4px; background:#edf5f6; color:#397182;
    font-size:.62rem; letter-spacing:.02em;
  }
  .next-step-text, .card-meta span { color:#5b7079; font-size:.75rem; }
  .church-card.selected {
    border-color:var(--crs-cyan); border-left:1px solid var(--crs-cyan); background:#fff;
    box-shadow:0 0 0 2px rgba(45,159,186,.12),0 8px 20px rgba(19,52,64,.08);
  }
  .church-card.selected::before { background:var(--crs-cyan); }
  .church-card.selected .church-card-header { background:#f4fafb; }
  .app-body.split .list-panel { flex:0 0 400px; }
  .app-body.split .church-card { border-radius:8px; }
  .detail-panel { background:#f7f9f9; }
  .app-body.split .detail-panel { border-left:1px solid #ccdadd; box-shadow:-12px 0 32px rgba(20,52,64,.06); }
  .detail-panel-head {
    padding:1.15rem 1.45rem .95rem;
    border-bottom:1px solid #dce7ea;
    background:#fff;
  }
  .detail-panel-avatar {
    width:42px; height:42px; border:1px solid #c7e0e6; border-radius:9px;
    background:#e5f3f5; color:var(--crs-brand); font-size:1.05rem;
  }
  .detail-panel-title { color:var(--crs-ink); font-size:1.08rem; letter-spacing:0; }
  .detail-panel-sub { margin-top:.2rem; color:#70858d; font-size:.75rem; }
  .detail-panel-close {
    width:31px; height:31px; border:1px solid #d8e4e7; border-radius:8px;
    background:#f2f6f7; color:#607780;
  }
  .detail-panel-close-mobile { display:none; }
  .detail-lang-toggle { display:none; }
  .detail-panel-close:hover { background:#e6eff1; color:var(--crs-brand); }
  .detail-panel-progress-meta {
    display:flex; justify-content:space-between; gap:1rem; padding:.58rem 1.45rem;
    border-bottom:1px solid #dce9ec;
    background:#e9f4f5; color:#4d707b; font-size:.72rem; font-weight:700;
  }
  .detail-panel-progress-meta strong { color:var(--crs-brand); font-size:.76rem; }
  .detail-panel-prog { height:4px; background:#d5e5e8; }
  .detail-panel-prog-fill { background:var(--crs-cyan); }
  .detail-panel-body { padding:1.3rem 1.5rem 1rem; background:#f7f9f9; }
  .detail-panel-body .detail-actions {
    margin:1.25rem -.1rem 0; padding:.9rem .1rem .15rem; background:#f7f9f9;
  }
  .detail-info {
    display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); grid-auto-rows:max-content; align-self:start; gap:0;
    margin-bottom:1rem; padding:0; border:1px solid var(--crs-line); border-radius:10px;
    background:#fff; overflow:hidden;
  }
  .detail-info-row {
    display:block; min-height:61px; box-sizing:border-box; margin:0; padding:.73rem .86rem;
    border-bottom:1px solid #edf2f3; color:#526972; font-size:.82rem; line-height:1.5;
  }
  .detail-info-row:nth-child(odd) { border-right:1px solid #edf2f3; }
  .detail-info-row strong {
    display:block; min-width:0; margin-bottom:.16rem; color:#83969e; font-size:.65rem;
    font-weight:800; letter-spacing:.05em; text-transform:uppercase;
  }
  .steps-header { margin:1.18rem 0 .52rem; padding-bottom:.5rem; border-bottom:1px solid #dce7ea; }
  .steps-title { color:var(--crs-ink); font-size:.84rem; }
  .steps-toggle {
    padding:.3rem .58rem; border:1px solid #d5e4e7; border-radius:6px;
    background:#edf5f6; color:#336d7d; font-size:.7rem;
  }
  .steps-toggle:hover { background:#e2f0f2; }
  .steps-list { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:.46rem; }
  .step-item {
    min-height:58px; box-sizing:border-box; gap:.68rem; margin:0; padding:.63rem .68rem;
    border:1px solid #e1e9eb; border-radius:8px; background:#fff;
  }
  .step-item:last-child { border-bottom:1px solid #e1e9eb; }
  .step-item:hover { border-color:#bdd4da; background:#f8fcfc; }
  .step-check { width:19px; height:19px; border-radius:5px; }
  .step-desc { color:#5c7078; font-size:.81rem; line-height:1.35; }
  .step-num { color:#9cafb5; font-size:.65rem; }
  .visit-card {
    margin-bottom:.55rem; padding:.78rem .86rem; border:1px solid #e0e9eb; border-left:3px solid var(--crs-cyan);
    border-radius:8px; background:#fff;
  }
  .visit-section {
    margin-top:1rem; padding:1rem; border:1px solid #dce7e9; border-radius:10px;
    background:#fff; box-shadow:0 3px 12px rgba(20,52,64,.045);
  }
  .visit-section-head { display:flex; align-items:center; justify-content:space-between; gap:.8rem; margin-bottom:.8rem; }
  .visit-section-title { display:flex; align-items:center; gap:.45rem; color:var(--crs-ink); font-size:.88rem; font-weight:850; }
  .visit-count {
    min-width:1.35rem; padding:.12rem .38rem; border-radius:999px; background:#e8f4f6;
    color:var(--crs-brand); font-size:.68rem; font-weight:850; text-align:center;
  }
  .btn-add-visit {
    display:inline-flex; align-items:center; justify-content:center; gap:.24rem; padding:.48rem .68rem;
    border:1px solid var(--crs-brand); border-radius:7px; background:var(--crs-brand); color:#fff;
    font-size:.75rem; font-weight:800; cursor:pointer; transition:background .18s, border-color .18s, box-shadow .18s;
  }
  .btn-add-visit:hover { border-color:#004658; background:#004658; box-shadow:0 4px 10px rgba(0,86,108,.16); }
  .visit-card-head { display:flex; justify-content:space-between; align-items:center; gap:.6rem; margin-bottom:.34rem; }
  .visit-card-date { color:var(--crs-brand); font-size:.81rem; font-weight:800; }
  .visit-card-person {
    padding:.14rem .45rem; border-radius:999px; background:#edf5f6; color:#4a707c;
    font-size:.7rem; font-weight:750;
  }
  .visit-card-purpose { margin-bottom:.25rem; color:#294c59; font-size:.78rem; font-weight:750; }
  .visit-card-notes { color:#5b7078; font-size:.78rem; line-height:1.55; white-space:pre-wrap; }
  .visit-card-legacy { margin-top:.28rem; color:#95a7ad; font-size:.66rem; }
  .visit-empty { padding:1rem 0; color:#91a3aa; font-size:.8rem; text-align:center; }
  .visit-form {
    display:none; margin-bottom:.85rem; padding:.9rem; border:1px solid #cfe2e6; border-radius:8px;
    background:#f7fbfb; box-shadow:0 4px 12px rgba(20,52,64,.05);
  }
  .visit-form-head { margin-bottom:.75rem; padding-bottom:.62rem; border-bottom:1px solid #deeaec; }
  .visit-form-title { margin:0 0 .18rem; color:var(--crs-ink); font-size:.82rem; font-weight:850; }
  .visit-form-help { margin:0; color:#71868e; font-size:.72rem; line-height:1.5; }
  .visit-form-grid { display:grid; grid-template-columns:1fr 1fr; gap:.65rem; margin-bottom:.65rem; }
  .visit-field { margin-bottom:.65rem; }
  .visit-label { display:block; margin-bottom:.28rem; color:#5a7078; font-size:.73rem; font-weight:750; }
  .visit-input {
    width:100%; box-sizing:border-box; padding:.56rem .68rem; border:1px solid #d5e1e4; border-radius:6px;
    background:#fbfcfc; color:var(--crs-ink); font:inherit; font-size:.8rem; outline:none;
  }
  .visit-input:focus { border-color:var(--crs-cyan); box-shadow:0 0 0 3px rgba(45,159,186,.11); }
  textarea.visit-input { resize:vertical; }
  .visit-form-actions { display:flex; justify-content:flex-end; gap:.5rem; }
  .btn-visit-cancel, .btn-visit-save { border:none; border-radius:6px; padding:.5rem .85rem; font-size:.78rem; font-weight:750; cursor:pointer; }
  .btn-visit-cancel { background:#edf2f3; color:#587079; }
  .btn-visit-save { background:var(--crs-brand); color:#fff; }
  .relationship-section { margin-top:1.25rem; }
  .btn-edit, .btn-delete, .btn-cancel, .btn-save { border-radius:7px; }
  .modal-backdrop { background:rgba(15,39,48,.54); backdrop-filter:blur(8px); -webkit-backdrop-filter:blur(8px); }
  .modal { border:1px solid rgba(255,255,255,.74); border-radius:14px; box-shadow:0 24px 70px rgba(10,38,50,.26); }
  .modal-header { padding:1.18rem 1.35rem .92rem; border-radius:14px 14px 0 0; background:#fbfcfc; }
  .modal-header::before { height:3px; border-radius:14px 14px 0 0; background:var(--crs-cyan); }
  .modal-header h2 { font-size:1.02rem; letter-spacing:0; }
  .btn-close { border-radius:7px; }
  .form-group label { color:#627780; letter-spacing:.03em; }
  .form-group input, .form-group textarea, .form-group select { border-color:#d7e2e5; border-radius:7px; background:#fbfcfc; }
  @media(max-width:980px) {
    .app-body.split .list-panel { flex:0 0 340px; }
    .steps-list { grid-template-columns:1fr; }
  }
  @media(max-width:768px) {
    #crs-root { padding-top:58px; }
    body.crs-detail-open { overflow:hidden; }
    body.crs-detail-open .app-header { visibility:hidden; }
    .app-header {
      display:grid;
      grid-template-columns:minmax(0,1fr);
      position:relative; top:auto;
      min-height:auto;
      padding:.68rem .78rem .62rem;
      gap:.58rem;
    }
    .app-brand { gap:.52rem; min-width:0; }
    .app-brand-mark { display:none; }
    .app-header h1 { overflow:hidden; font-size:.93rem; text-overflow:ellipsis; white-space:nowrap; }
    .app-kicker { display:none; }
    .app-header .user-info {
      width:100%; box-sizing:border-box; flex-shrink:0; justify-content:flex-end;
      gap:.34rem; padding-top:.52rem; border-top:1px solid rgba(255,255,255,.13);
    }
    .app-header .user-info > span { display:none; }
    .crs-lang-toggle { height:30px; padding:2px; }
    .crs-lang-toggle span { min-width:21px; height:24px; padding:0 3px; }
    .btn-install, .admin-btn, .btn-logout {
      min-height:30px; padding:.36rem .5rem; border-radius:7px;
      font-size:.7rem; line-height:1; white-space:nowrap;
    }
    .btn-install { gap:.22rem; }
    .btn-install svg { width:12px; height:12px; }
    .app-body { height:auto; }
    .app-body.split .detail-panel { top:0; border-left:none; box-shadow:none; }
    .detail-panel-head { gap:.62rem; padding:.72rem .82rem; }
    .detail-panel-avatar { display:none; }
    .detail-panel-close {
      order:-1; width:auto; height:32px; margin-left:0; padding:0 .58rem;
      border-color:#cfe0e4; border-radius:7px; background:#eef5f6;
      color:var(--crs-brand); font-size:.75rem; font-weight:800;
    }
    .detail-panel-close-desktop { display:none; }
    .detail-panel-close-mobile { display:inline-flex; align-items:center; gap:.2rem; }
    .detail-lang-toggle {
      display:flex; flex:0 0 auto; height:34px; padding:3px; gap:3px;
      border:1px solid #b9d6dc; background:#f0f7f8; color:#58727b;
      box-shadow:0 2px 7px rgba(17,76,91,.12);
    }
    .detail-lang-toggle span {
      min-width:25px; height:26px; padding:0 5px;
      border:1px solid transparent; color:#58727b;
    }
    .detail-lang-toggle span.active {
      border-color:var(--crs-brand); background:var(--crs-brand); color:#fff;
      box-shadow:0 1px 3px rgba(0,86,108,.22);
    }
    .detail-panel-body { padding:1rem .9rem .8rem; }
    .detail-panel-progress-meta { padding:.52rem 1rem; }
    .detail-info { grid-template-columns:1fr; }
    .detail-info-row:nth-child(odd) { border-right:none; }
    .visit-form-grid { grid-template-columns:1fr; }
    .visit-section { padding:.82rem; }
    .visit-section-head { align-items:flex-start; }
  }

  /* ── 지도 패널 ── */
  .view-tabs { display:none; background:#fff; border-bottom:2px solid #e5edf1; flex-shrink:0; }
  .view-tab { flex:1; padding:.72rem; border:none; background:transparent; font-size:.88rem; font-weight:700; color:#8aacba; cursor:pointer; border-bottom:3px solid transparent; margin-bottom:-2px; transition:color .15s, border-color .15s; font-family:inherit; }
  .view-tab.active { color:#004f68; border-bottom-color:#004f68; }
  .map-panel { flex:1; min-width:0; position:relative; overflow:hidden; background:#e8edf0; }
  #crs-map { position:absolute; inset:0; width:100%; height:100%; }
  .app-body.split .map-panel { display:none; }
  .map-empty { position:absolute; inset:0; display:flex; flex-direction:column; align-items:center; justify-content:center; color:#aab8c0; font-size:.85rem; gap:.5rem; pointer-events:none; }
  /* 지도 검색창 */
  .map-search-box { position:absolute; top:12px; left:12px; z-index:10; width:280px; }
  .map-search-input { width:100%; box-sizing:border-box; padding:.6rem 2.5rem .6rem .9rem; border:none; border-radius:10px; font-size:.85rem; font-family:inherit; background:#fff; box-shadow:0 2px 12px rgba(0,0,0,.18); outline:none; transition:box-shadow .2s; }
  .map-search-input:focus { box-shadow:0 2px 16px rgba(0,79,104,.25); }
  .map-search-btn { position:absolute; right:.5rem; top:50%; transform:translateY(-50%); background:none; border:none; cursor:pointer; color:#004f68; padding:.2rem; display:flex; align-items:center; }
  .map-search-results { display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; background:#fff; border-radius:10px; box-shadow:0 4px 20px rgba(0,0,0,.15); overflow:hidden; max-height:220px; overflow-y:auto; }
  .map-search-results.open { display:block; }
  .map-search-item { padding:.65rem .9rem; font-size:.83rem; cursor:pointer; border-bottom:1px solid #f0f4f6; color:#1a2e3b; line-height:1.4; transition:background .15s; }
  .map-search-item:last-child { border-bottom:none; }
  .map-search-item:hover { background:#f0f8fb; }
  .map-search-item small { color:#8aacba; display:block; font-size:.75rem; margin-top:.1rem; }
  .map-search-item.no-result { color:#aab8c0; cursor:default; }
  .map-search-item.no-result:hover { background:none; }
  /* 주소 자동완성 */
  .addr-wrap { position:relative; }
  .addr-input-row { display:flex; gap:.5rem; }
  .addr-input-row input { min-width:0; flex:1; }
  .btn-addr-search { flex-shrink:0; border:1px solid #004f68; border-radius:9px; padding:0 .85rem; background:#004f68; color:#fff; font-family:inherit; font-size:.78rem; font-weight:750; cursor:pointer; }
  .btn-addr-search:hover { background:#003f54; }
  .addr-suggestions { display:none; position:absolute; top:calc(100% + 2px); left:0; right:0; background:#fff; border-radius:8px; box-shadow:0 4px 16px rgba(0,0,0,.12); overflow:hidden; max-height:200px; overflow-y:auto; z-index:200; }
  .addr-suggestions.open { display:block; }
  .addr-suggestion-item { padding:.58rem .9rem; font-size:.83rem; cursor:pointer; border-bottom:1px solid #f0f4f6; color:#1a2e3b; line-height:1.4; }
  .addr-suggestion-item:last-child { border-bottom:none; }
  .addr-suggestion-item:hover { background:#f0f8fb; }
  .addr-suggestion-item small { display:block; margin-top:.12rem; color:#8aacba; font-size:.72rem; }
  .addr-suggestion-item.no-result { color:#aab8c0; cursor:default; }
