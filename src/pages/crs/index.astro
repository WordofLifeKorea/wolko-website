  // ── 자동 로그아웃 (20분 비활동) ──
  const IDLE_MS = 20 * 60 * 1000;
  const WARN_MS = 60 * 1000;
  let idleTimer = null;
  let warnTimer = null;
  let lastAct = Date.now();
  let idleTracking = false;
  const ACT_EVENTS = ['mousedown', 'mousemove', 'keydown', 'scroll', 'touchstart', 'click'];

  function resetIdle() {
    lastAct = Date.now();
    clearTimeout(idleTimer);
    clearTimeout(warnTimer);
    document.getElementById('crs-idle-warn')?.remove();
    warnTimer = setTimeout(showIdleWarn, IDLE_MS - WARN_MS);
    idleTimer = setTimeout(doAutoLogout, IDLE_MS);
  }

  function showIdleWarn() {
    if (document.getElementById('crs-idle-warn')) return;
    const el = document.createElement('div');
    el.id = 'crs-idle-warn';
    el.style.cssText = 'position:fixed;bottom:1.5rem;left:50%;transform:translateX(-50%);background:#1a2e3b;color:#fff;padding:.85rem 1.6rem;border-radius:12px;font-size:.87rem;z-index:9999;box-shadow:0 4px 24px rgba(0,0,0,.35);white-space:nowrap;cursor:pointer;user-select:none;';
    el.textContent = getLang() === 'ko'
      ? '⏱ 1분 후 자동 로그아웃됩니다. 클릭하면 연장됩니다.'
      : '⏱ Auto-logout in 1 minute. Click to stay logged in.';
    el.addEventListener('click', resetIdle);
    document.body.appendChild(el);
  }

  async function doAutoLogout() {
    document.getElementById('crs-idle-warn')?.remove();
    await signOut(auth);
  }

  function onVisibilityChange() {
    if (!document.hidden && currentUser && Date.now() - lastAct >= IDLE_MS) {
      doAutoLogout();
    }
  }

  function startIdleTracking() {
    if (idleTracking) return;
    idleTracking = true;
    ACT_EVENTS.forEach(e => document.addEventListener(e, resetIdle, { passive: true }));
    document.addEventListener('visibilitychange', onVisibilityChange);
    resetIdle();
  }

  function stopIdleTracking() {
    if (!idleTracking) return;
    idleTracking = false;
    ACT_EVENTS.forEach(e => document.removeEventListener(e, resetIdle));
    document.removeEventListener('visibilitychange', onVisibilityChange);
    clearTimeout(idleTimer);
    clearTimeout(warnTimer);
    document.getElementById('crs-idle-warn')?.remove();
  }

  function esc(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function setCrsAppActive(active) {
    document.body.classList.add('crs-auth-ready');
    document.body.classList.toggle('crs-app-active', active);
    if (!active) document.body.classList.remove('crs-detail-open');
  }

  function crsLangToggleMarkup(id = 'crsLangToggle', extraClass = '') {
    const isKo = getLang() === 'ko';
    return `
      <button class="crs-lang-toggle${extraClass ? ` ${extraClass}` : ''}" id="${id}" type="button" aria-label="${isKo ? 'Switch to English' : '한국어로 전환'}">
        <span class="${isKo ? 'active' : ''}">한</span>
        <span class="${isKo ? '' : 'active'}">EN</span>
      </button>`;
  }

  function bindCrsLangToggle() {
    document.querySelectorAll('.crs-lang-toggle').forEach(toggle => {
      toggle.addEventListener('click', () => window.toggleLang?.());
    });
  }

  // ── 로그인 화면 ──
  function renderLogin() {
    setCrsAppActive(false);
    root.innerHTML = `
      <div class="login-wrap">
        <div class="login-card">
          <div class="login-logo">
            <img src="/images/WOLKO Circle.png" alt="WOLKO" style="width:64px;height:64px;object-fit:contain;">
            <h1>CRS for WOLKO</h1>
            <p>${t('subtitle')}</p>
          </div>
          <div class="login-err" id="loginErr">${t('login_error')}</div>
          <label>${t('email')}</label>
          <input type="email" id="loginEmail" placeholder="missionary@wolko.or.kr" autocomplete="email">
          <label>${t('password')}</label>
          <input type="password" id="loginPw" placeholder="••••••••" autocomplete="current-password">
          <button class="btn-primary" id="loginBtn">${t('login')}</button>
          <div class="signup-toggle">${t('no_account')} <a id="goSignup">${t('signup')}</a></div>
        </div>
      </div>`;

    const emailEl = document.getElementById('loginEmail');
    const pwEl    = document.getElementById('loginPw');
    const btnEl   = document.getElementById('loginBtn');
    const errEl   = document.getElementById('loginErr');

    async function doLogin() {
      const email = emailEl.value.trim();
      const pw = pwEl.value;
      if (!email || !pw) return;
      btnEl.disabled = true;
      btnEl.textContent = t('logging_in');
      try {
        await signInWithEmailAndPassword(auth, email, pw);
      } catch(e) {
        errEl.style.display = 'block';
        btnEl.disabled = false;
        btnEl.textContent = t('login');
      }
    }
    btnEl.addEventListener('click', doLogin);
    pwEl.addEventListener('keydown', e => { if (e.key === 'Enter') doLogin(); });
    document.getElementById('goSignup').addEventListener('click', renderSignup);
  }

  // ── 회원가입 화면 ──
  function renderSignup() {
    setCrsAppActive(false);
    root.innerHTML = `
      <div class="login-wrap">
        <div class="login-card">
          <div class="login-logo">
            <img src="/images/WOLKO Circle.png" alt="WOLKO" style="width:64px;height:64px;object-fit:contain;">
            <h1>CRS for WOLKO</h1>
            <p>${t('subtitle')}</p>
          </div>
          <div class="login-err" id="signupErr"></div>
          <label>${t('name_label')}</label>
          <input type="text" id="signupName" placeholder="${t('name_ph')}" autocomplete="name">
          <label>${t('email')}</label>
          <input type="email" id="signupEmail" placeholder="missionary@wolko.or.kr" autocomplete="email">
          <label>${t('password')}</label>
          <input type="password" id="signupPw" placeholder="••••••••" autocomplete="new-password">
          <label>${t('password_confirm')}</label>
          <input type="password" id="signupPw2" placeholder="••••••••" autocomplete="new-password">
          <button class="btn-primary" id="signupBtn">${t('signup_btn')}</button>
          <div class="signup-toggle">${t('have_account')} <a id="goLogin">${t('login')}</a></div>
        </div>
      </div>`;

    const errEl  = document.getElementById('signupErr');
    const btnEl  = document.getElementById('signupBtn');

    async function doSignup() {
      const name  = document.getElementById('signupName').value.trim();
      const email = document.getElementById('signupEmail').value.trim();
      const pw    = document.getElementById('signupPw').value;
      const pw2   = document.getElementById('signupPw2').value;
      errEl.style.display = 'none';
      if (!name)       { errEl.style.display='block'; errEl.textContent=t('name_required_signup'); return; }
      if (!email)      { errEl.style.display='block'; errEl.textContent=t('email_required'); return; }
      if (pw.length<6) { errEl.style.display='block'; errEl.textContent=t('pw_short'); return; }
      if (pw !== pw2)  { errEl.style.display='block'; errEl.textContent=t('pw_mismatch'); return; }
      btnEl.disabled = true; btnEl.textContent = t('signing_up');
      try {
        const cred = await createUserWithEmailAndPassword(auth, email, pw);
        await set(ref(db, `users/${cred.user.uid}`), {
          name, email, status: 'pending', role: 'member', createdAt: Date.now()
        });
      } catch(e) {
        errEl.style.display = 'block'; errEl.textContent = t('signup_error');
        btnEl.disabled = false; btnEl.textContent = t('signup_btn');
      }
    }
    btnEl.addEventListener('click', doSignup);
    document.getElementById('signupPw2').addEventListener('keydown', e => { if(e.key==='Enter') doSignup(); });
    document.getElementById('goLogin').addEventListener('click', renderLogin);
  }

