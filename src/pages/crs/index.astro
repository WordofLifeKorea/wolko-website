  function renderSignup() {
    resetCrsMap();
    setCrsAppActive(false);
    root.innerHTML = `
      <div class="login-wrap">
        <div class="login-card">
          <div class="login-logo">
            <img src="/images/WOLKO Circle.png" alt="WOLKO" style="width:64px;height:64px;object-fit:contain;">
