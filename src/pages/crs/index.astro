          <div class="detail-panel-head">
            <div id="detailAvatar" class="detail-panel-avatar"></div>
            <div style="flex:1;min-width:0">
              <h2 id="detailTitle" class="detail-panel-title"></h2>
              <p id="detailSubtitle" class="detail-panel-sub"></p>
            </div>
            <button class="detail-panel-close" id="detailPanelClose" type="button" aria-label="${isKo ? '목록으로 돌아가기' : 'Back to list'}">
              <span class="detail-panel-close-desktop" aria-hidden="true">×</span>
              <span class="detail-panel-close-mobile" aria-hidden="true">← ${isKo ? '목록' : 'List'}</span>
            </button>
            ${crsLangToggleMarkup('detailLangToggle', 'detail-lang-toggle')}
          </div>
          <div class="detail-panel-progress-meta">
            <span id="detailProgressText"></span>
            <strong id="detailProgressPct"></strong>
          </div>
          <div class="detail-panel-prog"><div id="detailProgressFill" class="detail-panel-prog-fill"></div></div>
          <div class="detail-panel-body" id="detailBody"></div>
        </div>
      </div>

      <!-- 추가/수정 모달 -->
      <div class="modal-backdrop" id="editModal">
        <div class="modal">
          <div class="modal-header">
            <h2 id="editModalTitle">${t('add_title')}</h2>
            <button class="btn-close" id="editModalClose">×</button>
          </div>
          <div class="modal-body">
            <div class="form-group">
              <label>${t('church_name_label')}</label>
              <input type="text" id="fChurchName" placeholder="${t('church_name_ph')}">
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>${t('pastor_label')}</label>
                <input type="text" id="fPastorName" placeholder="${t('pastor_ph')}">
              </div>
              <div class="form-group">
                <label>${t('pastor_phone')}</label>
                <input type="tel" id="fPastorPhone" placeholder="${t('pastor_phone_ph')}">
              </div>
            </div>
            <div class="form-row">
              <div class="form-group">
                <label>${t('location')}</label>
                <select id="fRegion">
                  <option value="">${t('region_ph')}</option>
                  ${Object.keys(REGIONS).map(r => `<option value="${esc(r)}">${esc(r)}</option>`).join('')}
                </select>
              </div>
              <div class="form-group">
                <label>${t('district')}</label>
                <select id="fDistrict" disabled>
                  <option value="">${t('district_ph')}</option>
                </select>
              </div>
            </div>
            <div class="form-group">
              <label>${t('notes')}</label>
              <textarea id="fNotes" placeholder="${t('notes_ph')}"></textarea>
            </div>
            <div class="modal-footer">
              <button class="btn-cancel" id="editCancelBtn">${t('cancel')}</button>
              <button class="btn-save" id="editSaveBtn">${t('save')}</button>
            </div>
          </div>
        </div>
      </div>

      <!-- 관리자 모달 -->
      <div class="modal-backdrop" id="adminModal">
        <div class="modal">
          <div class="modal-header">
            <h2>${t('admin_title')}</h2>
            <button class="btn-close" id="adminModalClose">×</button>
          </div>
          <div class="modal-body" id="adminBody">
            <div class="loading-wrap"><div class="spinner"></div></div>
          </div>
        </div>
      </div>

    `;

    bindCrsLangToggle();
    document.getElementById('logoutBtn').addEventListener('click', () => signOut(auth));
    document.getElementById('addChurchBtn').addEventListener('click', () => openEditModal(null));
    if (currentUserData?.role === 'admin') {
      document.getElementById('adminBtn').addEventListener('click', openAdminModal);
    }
    document.getElementById('adminModalClose').addEventListener('click', () => {
      document.getElementById('adminModal').classList.remove('open');
    });
    document.getElementById('editModalClose').addEventListener('click', closeEditModal);
    document.getElementById('editCancelBtn').addEventListener('click', closeEditModal);
    document.getElementById('editSaveBtn').addEventListener('click', saveChurch);
    document.getElementById('detailPanelClose').addEventListener('click', closeDetailModal);
    document.getElementById('searchInput').addEventListener('input', renderChurchList);

    // 시/도 → 시/군/구 연동
    document.getElementById('fRegion').addEventListener('change', function() {
      const districtEl = document.getElementById('fDistrict');
      const region = this.value;
      if (region && REGIONS[region]) {
        districtEl.innerHTML = `<option value="">${t('district_ph_select')}</option>` +
          REGIONS[region].map(d => `<option value="${esc(d)}">${esc(d)}</option>`).join('');
        districtEl.disabled = false;
      } else {
        districtEl.innerHTML = `<option value="">${t('district_ph')}</option>`;
        districtEl.disabled = true;
      }
    });

    loadChurches();
  }

  // ── 교회 목록 로드 ──
  async function loadChurches() {
    try {
      const snap = await get(ref(db, 'churches'));
      if (snap.exists()) {
        const data = snap.val();
        churches = Object.entries(data)
          .map(([id, val]) => ({ id, ...val }))
          .sort((a, b) => (b.createdAt || 0) - (a.createdAt || 0));
      } else {
        churches = [];
      }
    } catch(e) {
      churches = [];
    }
    renderChurchList();
  }

  // ── 교회 목록 렌더 ──
  function renderChurchList() {
    const listEl = document.getElementById('churchList');
    if (!listEl) return;
    const q = (document.getElementById('searchInput')?.value || '').toLowerCase();
    const filtered = churches.filter(c =>
      (c.churchName || '').toLowerCase().includes(q) ||
      (c.pastorName || '').toLowerCase().includes(q) ||
      (c.location || '').toLowerCase().includes(q)
    );

    if (filtered.length === 0) {
      listEl.innerHTML = `
        <div class="empty-state">
          <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#aaa" stroke-width="1.5"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9,22 9,12 15,12 15,22"/></svg>
          <p style="font-weight:700;font-size:1.05rem;color:#666">${t('no_churches')}</p>
          <p style="font-size:.85rem">${t('no_churches_sub')}</p>
        </div>`;
      return;
    }

    listEl.innerHTML = filtered.map(c => {
      const steps = c.steps || {};
      const done = STEPS.filter((_,i) => steps[i+1]).length;
      const pct = Math.round(done / STEPS.length * 100);
      const isComplete = done === STEPS.length;
      const nextStepIdx = STEPS.findIndex((_, i) => !steps[i+1]);
      const nextStepRaw = !isComplete ? (getLang()==='ko' ? STEPS_KO[nextStepIdx] : STEPS[nextStepIdx]) : '';
      const nextStepDesc = !isComplete ? esc(nextStepRaw) : null;
      let badgeHtml;
      if (isComplete) {
        badgeHtml = esc(t('complete'));
      } else if (done === 0) {
        badgeHtml = esc(getLang() === 'ko' ? '시작 전' : 'Not Started');
      } else {
        const curDesc = getLang() === 'ko' ? STEPS_KO[done - 1] : STEPS[done - 1];
        badgeHtml = `Step ${done}<span class="badge-desc"> · ${esc(curDesc)}</span>`;
      }

      const visitsArr = c.visits ? Object.values(c.visits).sort((a,b) => (b.recordedAt||0) - (a.recordedAt||0)) : [];
      const latestVisit = visitsArr[0];
      const lastVisitDisplay = latestVisit
        ? [latestVisit.date, latestVisit.visitor].filter(Boolean).join(' · ')
        : [c.lastVisitDate, c.lastVisitVisitor].filter(Boolean).join(' · ');
      const metaItems = [
        c.location ? `<span><em class="meta-label">${getLang()==='ko'?'지역':'Loc'}</em>${esc(c.location)}</span>` : '',
        lastVisitDisplay ? `<span><em class="meta-label">${t('last_visit')}</em>${esc(lastVisitDisplay)}</span>` : '',
        visitsArr.length ? `<span><em class="meta-label">${getLang()==='ko'?'방문':'Visits'}</em>${visitsArr.length}회</span>` : '',
      ].filter(Boolean).join('');

      return `
        <div class="church-card" data-id="${esc(c.id)}">
          <div class="church-card-header">
            <div>
              <p class="church-name">${esc(c.churchName)}</p>
              <p class="pastor-name">${t('pastor_prefix')} ${esc(c.pastorName || t('not_entered'))}</p>
            </div>
            <span class="step-badge${isComplete?' complete':''}">${badgeHtml}</span>
          </div>
          <div class="church-card-body">
            <div class="step-bar-wrap">
              <div class="step-bar-bg"><div class="step-bar-fill" style="width:${pct}%"></div></div>
              <div class="step-bar-label">${pct}${t('progress')}</div>
            </div>
            ${nextStepDesc ? `<div class="next-step-row"><span class="next-step-label">${t('next_step_label')}</span><span class="next-step-text">${nextStepDesc}</span></div>` : ''}
            ${metaItems ? `<div class="card-meta-divider"></div><div class="card-meta">${metaItems}</div>` : ''}
          </div>
        </div>`;
    }).join('');

    document.querySelectorAll('.church-card').forEach(card => {
      card.addEventListener('click', () => {
        const ch = churches.find(c => c.id === card.dataset.id);
        if (ch) openDetailModal(ch);
      });
    });
  }

  // ── 교회 추가/수정 모달 ──
  function openEditModal(church) {
    editingChurch = church;
    document.getElementById('editModalTitle').textContent = church ? t('edit_title') : t('add_title');
    document.getElementById('fChurchName').value = church?.churchName || '';
    document.getElementById('fPastorName').value = church?.pastorName || '';
    document.getElementById('fPastorPhone').value = church?.pastorPhone || '';
    document.getElementById('fNotes').value = church?.notes || '';

    // location 복원: "경기도 평택시" → region=경기도, district=평택시
    const regionEl   = document.getElementById('fRegion');
    const districtEl = document.getElementById('fDistrict');
    const savedRegion   = church?.region || '';
    const savedDistrict = church?.district || '';
    regionEl.value = savedRegion;
    if (savedRegion && REGIONS[savedRegion]) {
      districtEl.innerHTML = `<option value="">${t('district_ph_select')}</option>` +
        REGIONS[savedRegion].map(d => `<option value="${esc(d)}">${esc(d)}</option>`).join('');
      districtEl.disabled = false;
      districtEl.value = savedDistrict;
    } else {
      districtEl.innerHTML = `<option value="">${t('district_ph')}</option>`;
      districtEl.disabled = true;
    }

    document.getElementById('editModal').classList.add('open');
    setTimeout(() => document.getElementById('fChurchName').focus(), 100);
  }

  function closeEditModal() {
    document.getElementById('editModal').classList.remove('open');
    editingChurch = null;
  }

  async function saveChurch() {
    const churchName = document.getElementById('fChurchName').value.trim();
    const pastorName = document.getElementById('fPastorName').value.trim();
    if (!churchName) { alert(t('name_required')); return; }

    const saveBtn = document.getElementById('editSaveBtn');
    saveBtn.disabled = true;
    saveBtn.textContent = t('saving');

    const now = Date.now();
    const region   = document.getElementById('fRegion').value;
    const district = document.getElementById('fDistrict').value;
    const data = {
      churchName, pastorName,
      pastorPhone: document.getElementById('fPastorPhone').value.trim(),
      region, district,
      location: [region, district].filter(Boolean).join(' '),
      notes: document.getElementById('fNotes').value.trim(),
      updatedAt: now, updatedBy: currentUser.uid,
    };

    try {
      if (editingChurch) {
        await update(ref(db, `churches/${editingChurch.id}`), data);
      } else {
        data.steps = {};
        data.createdAt = now;
        data.createdBy = currentUser.uid;
        await push(ref(db, 'churches'), data);
      }
      closeEditModal();
      await loadChurches();
    } catch(e) {
      alert(t('save_error') + e.message);
    }
    saveBtn.disabled = false;
    saveBtn.textContent = t('save');
  }

  // ── 교회 상세 모달 ──
  function openDetailModal(church) {
    viewingChurch = church;
    const done = STEPS.filter((_,i) => (church.steps||{})[i+1]).length;
    const pct  = Math.round(done / STEPS.length * 100);
    const isKo = getLang() === 'ko';
    document.getElementById('detailAvatar').textContent = church.churchName.charAt(0);
    document.getElementById('detailTitle').textContent = church.churchName;
    document.getElementById('detailSubtitle').textContent = [
      church.pastorName ? (isKo ? '담임: ' : 'Pastor: ') + church.pastorName : null,
      church.location || null,
    ].filter(Boolean).join(' · ');
    document.getElementById('detailProgressText').textContent = isKo
      ? `${done} / ${STEPS.length} 단계 완료`
      : `${done} / ${STEPS.length} steps completed`;
    document.getElementById('detailProgressPct').textContent = pct + '%';
    document.getElementById('detailProgressFill').style.width = pct + '%';
    renderDetailBody(church);
    document.getElementById('appBody').classList.add('split');
    document.body.classList.add('crs-detail-open');
    document.querySelectorAll('.church-card').forEach(c => c.classList.remove('selected'));
    document.querySelector(`.church-card[data-id="${esc(church.id)}"]`)?.classList.add('selected');
  }

  function closeDetailModal() {
    document.getElementById('appBody').classList.remove('split');
    document.body.classList.remove('crs-detail-open');
    document.querySelectorAll('.church-card').forEach(c => c.classList.remove('selected'));
    viewingChurch = null;
  }

  function renderDetailBody(church) {
    const steps = church.steps || {};
    const done = STEPS.filter((_,i) => steps[i+1]).length;
    const stepsArr = getLang() === 'ko' ? STEPS_KO : STEPS;

    const stepsHtml = stepsArr.map((desc, i) => {
      const num = i + 1;
      const checked = !!steps[num];
      return `
        <div class="step-item${checked ? ' done' : ''}" data-step="${num}">
          <div class="step-check${checked ? ' checked' : ''}">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none">
              <path d="M2 6.5l3.5 3.5 5.5-6" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <div class="step-text">
            <span class="step-num">Step ${num}</span>
            <span class="step-desc">${esc(desc)}</span>
          </div>
        </div>`;
    }).join('');

    const visitsArr = church.visits
      ? Object.entries(church.visits).map(([k,v]) => ({key:k,...v})).sort((a,b)=>(b.recordedAt||0)-(a.recordedAt||0))
      : [];
    // 레거시 데이터(visitDate/purpose/notes)가 있고 visits가 없으면 표시
    const legacyVisit = !visitsArr.length && (church.visitDate || church.purpose || church.notes) ? {
      date: church.visitDate || '', purpose: church.purpose || '', notes: church.notes || '',
      visitor: church.lastVisitVisitor || '', legacy: true
    } : null;
    const allVisits = legacyVisit ? [legacyVisit] : visitsArr;

    const purposeOpts = STEPS.map((s,i) => {
      const label = getLang()==='ko' ? `${i+1}단계: ${STEPS_KO[i]}` : `Step ${i+1}: ${s}`;
      return `<option value="Step ${i+1}: ${s}">${esc(label)}</option>`;
    }).join('');

    const visitHistoryHtml = allVisits.length ? allVisits.map((v,i) => `
      <div class="visit-card">
        <div class="visit-card-head">
          <span class="visit-card-date">${esc(v.date || (getLang()==='ko'?'날짜 미입력':'No date'))}</span>
          ${v.visitor ? `<span class="visit-card-person">${esc(v.visitor)}</span>` : ''}
        </div>
        ${v.purpose ? `<div class="visit-card-purpose">${esc(v.purpose)}</div>` : ''}
        ${v.notes ? `<div class="visit-card-notes">${esc(v.notes)}</div>` : ''}
        ${v.legacy ? `<div class="visit-card-legacy">${getLang()==='ko'?'이전 기록':'Legacy record'}</div>` : ''}
      </div>`).join('')
    : `<p class="visit-empty">${t('no_visits')}</p>`;

    document.getElementById('detailBody').innerHTML = `
      <div class="detail-info">
        <div class="detail-info-row"><strong>${t('detail_pastor')}</strong> ${esc(church.pastorName || t('not_entered'))}${church.pastorPhone ? ` &nbsp;${esc(church.pastorPhone)}` : ''}</div>
        ${church.location ? `<div class="detail-info-row"><strong>${t('detail_location')}</strong> ${esc(church.location)}</div>` : ''}
        ${church.notes ? `<div class="detail-info-row"><strong>${t('detail_notes')}</strong> ${esc(church.notes)}</div>` : ''}
        <div class="detail-info-row" style="margin-top:.3rem">
          <strong>${t('detail_progress')}</strong>
          <span style="color:#004f68;font-weight:700">${t('done_of', done, STEPS.length)}</span>
        </div>
      </div>
      <!-- 방문 기록 섹션 -->
      <section class="visit-section">
        <div class="visit-section-head">
          <span class="visit-section-title">${t('visit_history')} <span class="visit-count">${allVisits.length}</span></span>
          <button class="btn-add-visit" id="addVisitToggle">${t('add_visit')}</button>
        </div>
        <!-- 방문 추가 폼 (기본 숨김) -->
        <div id="addVisitForm" class="visit-form" style="display:none">
          <div class="visit-form-head">
            <p class="visit-form-title">${getLang()==='ko'?'새 방문 기록':'New visit record'}</p>
            <p class="visit-form-help">${getLang()==='ko'?'방문일과 담당자를 먼저 입력하고, 필요한 내용을 간단히 남겨주세요.':'Start with the date and visitor, then add a short note if needed.'}</p>
          </div>
          <div class="visit-form-grid">
            <div>
              <label class="visit-label">${getLang()==='ko'?'방문일':'Date'}</label>
              <input type="date" id="visitFormDate" class="visit-input">
            </div>
            <div>
              <label class="visit-label">${t('visit_visitor')}</label>
              <input type="text" id="visitFormVisitor" placeholder="${getLang()==='ko'?'방문자 이름':'Visitor name'}" class="visit-input">
            </div>
          </div>
          <div class="visit-field">
            <label class="visit-label">${getLang()==='ko'?'방문 목적':'Purpose'}</label>
            <select id="visitFormPurpose" class="visit-input">
              <option value="">${getLang()==='ko'?'-- 선택 (선택사항) --':'-- Select (optional) --'}</option>
              ${purposeOpts}
            </select>
          </div>
          <div class="visit-field">
            <label class="visit-label">${getLang()==='ko'?'메모':'Notes'}</label>
            <textarea id="visitFormNotes" placeholder="${getLang()==='ko'?'논의 내용, 후속 연락, 다음 방문 계획 등을 남겨주세요.':'Add discussion notes, follow-up items, or next visit plans.'}" rows="3" class="visit-input"></textarea>
          </div>
          <div class="visit-form-actions">
            <button id="visitFormCancel" class="btn-visit-cancel">${t('cancel')}</button>
            <button id="visitFormSave" class="btn-visit-save">${t('save_visit')}</button>
          </div>
        </div>
        <!-- 방문 이력 목록 -->
        <div id="visitHistoryList">${visitHistoryHtml}</div>
      </section>

      <section class="relationship-section">
        <div class="steps-header">
          <span class="steps-title">${t('steps_title')}</span>
          <button class="steps-toggle" id="stepsToggle">${t('steps_collapse')}</button>
        </div>
        <div class="steps-list" id="stepsList">${stepsHtml}</div>
      </section>

      <div class="detail-actions">
        <button class="btn-edit" id="detailEditBtn">${t('btn_edit')}</button>
        <button class="btn-delete" id="detailDeleteBtn">${t('btn_delete')}</button>
      </div>`;

    document.querySelectorAll('.step-item').forEach(item => {
      item.addEventListener('click', () => toggleStep(church, parseInt(item.dataset.step)));
    });
    document.getElementById('detailEditBtn').addEventListener('click', () => {
      closeDetailModal(); openEditModal(church);
    });
    document.getElementById('detailDeleteBtn').addEventListener('click', () => deleteChurch(church));
    document.getElementById('stepsToggle').addEventListener('click', function() {
      const list = document.getElementById('stepsList');
      const collapsed = list.classList.toggle('collapsed');
      this.textContent = collapsed ? t('steps_expand') : t('steps_collapse');
    });
    // 방문 추가 폼 토글
    document.getElementById('addVisitToggle').addEventListener('click', function() {
      const form = document.getElementById('addVisitForm');
      const isOpen = form.style.display !== 'none';
      form.style.display = isOpen ? 'none' : 'block';
      this.textContent = isOpen ? t('add_visit') : t('cancel');
      if (!isOpen) {
        const dateInput = document.getElementById('visitFormDate');
        const now = new Date();
        if (!dateInput.value) {
          dateInput.value = [
            now.getFullYear(),
            String(now.getMonth() + 1).padStart(2, '0'),
            String(now.getDate()).padStart(2, '0'),
          ].join('-');
        }
        dateInput.focus();
      }
    });
    document.getElementById('visitFormCancel').addEventListener('click', () => {
      document.getElementById('addVisitForm').style.display = 'none';
      document.getElementById('addVisitToggle').textContent = t('add_visit');
    });
    document.getElementById('visitFormSave').addEventListener('click', () => {
      const date    = document.getElementById('visitFormDate').value;
      const visitor = document.getElementById('visitFormVisitor').value.trim();
      const purpose = document.getElementById('visitFormPurpose').value;
      const notes   = document.getElementById('visitFormNotes').value.trim();
      if (!date && !visitor && !purpose && !notes) {
        alert(getLang()==='ko' ? '최소 한 가지 이상 입력해주세요.' : 'Please fill in at least one field.');
        return;
      }
      addVisit(church, { date, visitor, purpose, notes });
    });
  }

  // ── 단계 토글 ──
  async function toggleStep(church, stepNum) {
    const steps = { ...(church.steps || {}) };
    steps[stepNum] = !steps[stepNum];
    try {
      await update(ref(db, `churches/${church.id}`), { steps, updatedAt: Date.now() });
      church.steps = steps;
      const idx = churches.findIndex(c => c.id === church.id);
      if (idx !== -1) churches[idx].steps = steps;
      renderDetailBody(church);
      renderChurchList();
    } catch(e) {
      alert(t('step_error') + e.message);
    }
  }

  // ── 관리자: 회원 승인 ──
  async function openAdminModal() {
    document.getElementById('adminModal').classList.add('open');
    const bodyEl = document.getElementById('adminBody');
    bodyEl.innerHTML = '<div class="loading-wrap"><div class="spinner"></div></div>';
    try {
      const snap = await get(ref(db, 'users'));
      if (!snap.exists()) { bodyEl.innerHTML = `<p class="no-pending">${t('no_pending')}</p>`; return; }
      const all = Object.entries(snap.val()).map(([uid, v]) => ({ uid, ...v }));
      const pending = all.filter(u => u.status === 'pending');
      if (pending.length === 0) { bodyEl.innerHTML = `<p class="no-pending">${t('no_pending')}</p>`; return; }
      bodyEl.innerHTML = `
        <div class="admin-section-title">${getLang()==='ko'?'대기 중인 회원':'Pending Members'} (${pending.length})</div>
        ${pending.map(u => `
          <div class="user-row" data-uid="${esc(u.uid)}">
            <div class="user-info-block">
              <div class="user-name-text">${esc(u.name || '-')}</div>
              <div class="user-email-text">${esc(u.email || '-')}</div>
              <div class="user-date-text">${u.createdAt ? new Date(u.createdAt).toLocaleDateString() : ''}</div>
            </div>
            <button class="btn-approve" data-uid="${esc(u.uid)}">${t('approve')}</button>
            <button class="btn-reject-user" data-uid="${esc(u.uid)}">${t('reject')}</button>
          </div>`).join('')}`;
      bodyEl.querySelectorAll('.btn-approve').forEach(btn => {
        btn.addEventListener('click', () => approveUser(btn.dataset.uid));
      });
      bodyEl.querySelectorAll('.btn-reject-user').forEach(btn => {
        btn.addEventListener('click', () => rejectUser(btn.dataset.uid));
      });
    } catch(e) {
      bodyEl.innerHTML = `<p class="no-pending" style="color:#e53935">오류: ${esc(e.message)}</p>`;
    }
  }

  async function approveUser(uid) {
    try {
      await update(ref(db, `users/${uid}`), { status: 'approved', approvedAt: Date.now(), approvedBy: currentUser.uid });
      openAdminModal();
    } catch(e) { alert('오류: ' + e.message); }
  }

  async function rejectUser(uid) {
    try {
      await update(ref(db, `users/${uid}`), { status: 'rejected', rejectedAt: Date.now() });
      openAdminModal();
    } catch(e) { alert('오류: ' + e.message); }
  }

  // ── 방문 기록 추가 ──
  async function addVisit(church, visitData) {
    try {
      const visitRef = push(ref(db, `churches/${church.id}/visits`));
      const entry = { ...visitData, recordedAt: Date.now(), recordedBy: currentUser.uid };
      await set(visitRef, entry);
      if (!church.visits) church.visits = {};
      church.visits[visitRef.key] = entry;
      const idx = churches.findIndex(c => c.id === church.id);
      if (idx !== -1) churches[idx].visits = church.visits;
      renderDetailBody(church);
      renderChurchList();
      showSaveAlert();
    } catch(e) {
      alert(t('step_error') + e.message);
    }
  }

  // ── 저장 확인 알림 ──
  function showSaveAlert() {
    const el = document.createElement('div');
    el.className = 'save-alert-backdrop';
    el.innerHTML = `
      <div class="save-alert">
        <p>${t('saved_msg')}</p>
        <button class="btn-primary save-alert-ok">${t('ok')}</button>
      </div>`;
    document.body.appendChild(el);
    el.querySelector('.save-alert-ok').addEventListener('click', () => el.remove());
  }

  // ── 마지막 방문 날짜 저장 ──
  async function saveLastVisit(church, date, visitor) {
    try {
      await update(ref(db, `churches/${church.id}`), { lastVisitDate: date, lastVisitVisitor: visitor, updatedAt: Date.now() });
      church.lastVisitDate = date;
      church.lastVisitVisitor = visitor;
      const idx = churches.findIndex(c => c.id === church.id);
      if (idx !== -1) { churches[idx].lastVisitDate = date; churches[idx].lastVisitVisitor = visitor; }
      renderChurchList();
      showSaveAlert();
    } catch(e) {
      alert(t('step_error') + e.message);
    }
  }

  // ── 교회 삭제 ──
  async function deleteChurch(church) {
    const pw = prompt(
      getLang() === 'ko'
        ? `"${church.churchName}" 을(를) 삭제하려면 관리자 비밀번호를 입력하세요.`
        : `Enter admin password to delete "${church.churchName}".`
    );
    if (pw === null) return; // 취소
    if (pw !== '0316') {
      alert(getLang() === 'ko' ? '비밀번호가 올바르지 않습니다.' : 'Incorrect password.');
      return;
    }
    try {
      await remove(ref(db, `churches/${church.id}`));
      churches = churches.filter(c => c.id !== church.id);
      closeDetailModal();
      renderChurchList();
    } catch(e) {
      alert(t('delete_error') + e.message);
    }
  }

  // ── 모달 외부 클릭 닫기 ──
  ['editModal', 'adminModal'].forEach(id => {
    document.addEventListener('click', e => {
      const modal = document.getElementById(id);
      if (modal && e.target === modal) modal.classList.remove('open');
    });
  });

  // ── 인증 상태 감지 ──
  onAuthStateChanged(auth, async user => {
    currentUser = user;
    if (user) {
      try {
        const snap = await get(ref(db, `users/${user.uid}`));
        if (snap.exists()) {
          currentUserData = snap.val();
          if (currentUserData.status === 'approved') { renderApp(); startIdleTracking(); }
          else { renderPending(); }
        } else {
          // 기존 사용자(이 기능 도입 전) → 자동 승인
          const autoData = { name: user.email.split('@')[0], email: user.email, status: 'approved', role: 'member', createdAt: Date.now() };
          await set(ref(db, `users/${user.uid}`), autoData);
          currentUserData = autoData;
          renderApp();
          startIdleTracking();
        }
      } catch(e) {
        currentUserData = { status: 'pending', role: 'member' };
        renderPending();
      }
    } else {
      stopIdleTracking();
      currentUserData = null;
      renderLogin();
    }
  });

  // ── 언어 변경 감지 → 화면 재렌더 ──
  let observedLang = getLang();
  new MutationObserver(() => {
    const nextLang = getLang();
    if (nextLang === observedLang) return;
    observedLang = nextLang;

    if (currentUser) {
      if (currentUserData?.status === 'approved') {
        const detailOpen = document.getElementById('appBody')?.classList.contains('split');
        const editOpen   = document.getElementById('editModal')?.classList.contains('open');
        const searchVal  = document.getElementById('searchInput')?.value || '';
        renderApp();
        document.getElementById('searchInput').value = searchVal;
        renderChurchList();
        if (editOpen) openEditModal(editingChurch);
        if (detailOpen && viewingChurch) openDetailModal(viewingChurch);
      } else {
        renderPending();
      }
    } else {
      renderLogin();
    }
  }).observe(document.body, { attributes: true, attributeFilter: ['class'] });
</script>
