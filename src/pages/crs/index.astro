    '경상북도 예천군':[36.6576,128.4524],'경상북도 울릉군':[37.4845,130.9057],'경상북도 울진군':[36.9931,129.4006],
    '경상북도 의성군':[36.3527,128.6971],'경상북도 청도군':[35.6474,128.7342],'경상북도 청송군':[36.4356,129.0574],
    '경상북도 칠곡군':[35.9945,128.4016],'경상북도 포항시':[36.0190,129.3435],
    // 경남
    '경상남도 거제시':[34.8802,128.6214],'경상남도 거창군':[35.6868,127.9100],'경상남도 고성군':[34.9736,128.3230],
    '경상남도 김해시':[35.2285,128.8893],'경상남도 남해군':[34.8376,127.8926],'경상남도 밀양시':[35.4911,128.7463],
    '경상남도 사천시':[35.0036,128.0646],'경상남도 산청군':[35.4154,127.8740],'경상남도 양산시':[35.3350,129.0369],
    '경상남도 의령군':[35.3222,128.2614],'경상남도 진주시':[35.1800,128.1076],'경상남도 창녕군':[35.5448,128.4927],
    '경상남도 창원시':[35.2278,128.6817],'경상남도 통영시':[34.8544,128.4332],'경상남도 하동군':[35.0676,127.7516],
    '경상남도 함안군':[35.2734,128.4065],'경상남도 함양군':[35.5202,127.7252],'경상남도 합천군':[35.5668,128.1659],
    // 제주
    '제주특별자치도 서귀포시':[33.2541,126.5600],'제주특별자치도 제주시':[33.4996,126.5312],
  };

  function getChurchCoords(region, district) {
    if (region && district) {
      const k = `${region} ${district}`;
      if (DISTRICT_COORDS[k]) return DISTRICT_COORDS[k];
    }
    if (region && DISTRICT_COORDS[region]) return DISTRICT_COORDS[region];
    return null;
  }

  function getSavedChurchCoords(church) {
    return getExplicitChurchCoords(church) || getChurchCoords(church.region, church.district);
  }

  function getExplicitChurchCoords(church) {
    if (church.lat == null || church.lng == null || church.lat === '' || church.lng === '') return null;
    const lat = Number(church.lat);
    const lng = Number(church.lng);
    if (Number.isFinite(lat) && Number.isFinite(lng)) return [lat, lng];
    return null;
  }

  function getChurchMarkerIcon(markerColor, rank) {
    return {
      content: `<div style="width:32px;height:42px;cursor:pointer;filter:drop-shadow(0 2px 4px rgba(0,0,0,.28));">
        <svg width="32" height="42" viewBox="0 0 32 42" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <path d="M16 1C7.7 1 1 7.5 1 15.6 1 26.7 16 41 16 41s15-14.3 15-25.4C31 7.5 24.3 1 16 1Z" fill="${markerColor}" stroke="#fff" stroke-width="2"/>
          <circle cx="16" cy="15.5" r="8" fill="rgba(255,255,255,.94)"/>
          <text x="16" y="19" fill="${markerColor}" font-family="Arial, sans-serif" font-size="10" font-weight="800" text-anchor="middle">${rank ?? ''}</text>
        </svg>
      </div>`,
      anchor: new naver.maps.Point(16, 42),
    };
  }

  function initCrsMap() {
    const mapEl = document.getElementById('crs-map');
    if (!mapEl || crsMap || typeof naver === 'undefined') return;
    crsMap = new naver.maps.Map(mapEl, {
      center: new naver.maps.LatLng(36.5, 127.8),
      zoom: 7,
      zoomControl: true,
      zoomControlOptions: {
        position: naver.maps.Position.TOP_RIGHT,
        style: naver.maps.ZoomControlStyle.SMALL,
      },
    });
    updateCrsMarkers();
    initMapSearch();
  }

  function resetCrsMap() {
    crsMarkers.forEach(marker => marker.setMap(null));
    crsMarkers = [];
    if (crsMap) {
      crsMap.destroy();
      crsMap = null;
    }
  }

  function updateCrsMarkers() {
    if (!crsMap) return;
    if (!Object.keys(churchColorMap).length && churches.length) buildColorMap();
    crsMarkers.forEach(m => m.setMap(null));
    crsMarkers = [];
    const markerPositions = [];

    const pinnable = churches.filter(c => getSavedChurchCoords(c));
    const emptyEl = document.getElementById('mapEmpty');
    if (emptyEl) emptyEl.style.display = pinnable.length ? 'none' : 'flex';

    pinnable.forEach(c => {
      const coords = getSavedChurchCoords(c);
      if (!coords) return;
      const cm = churchColorMap[c.id];
      const markerColor = cm?.marker || '#004f68';
      const marker = new naver.maps.Marker({
        position: new naver.maps.LatLng(coords[0], coords[1]),
        map: crsMap,
        title: c.churchName,
        icon: getChurchMarkerIcon(markerColor, cm?.rank),
      });
      markerPositions.push(marker.getPosition());
      naver.maps.Event.addListener(marker, 'click', () => {
        openDetailModal(c);
      });
      crsMarkers.push(marker);
    });

    fitCrsMarkerBounds(markerPositions);
  }

  function fitCrsMarkerBounds(markerPositions) {
    if (!crsMap || !markerPositions.length) return;
    if (markerPositions.length === 1) {
      crsMap.setCenter(markerPositions[0]);
      crsMap.setZoom(13);
      return;
    }

    const margin = window.innerWidth <= 768
      ? { top: 56, right: 36, bottom: 30, left: 36, maxZoom: 13 }
      : { top: 54, right: 54, bottom: 54, left: 54, maxZoom: 13 };
    crsMap.fitBounds(markerPositions, margin);
  }

  function switchCrsTab(tab) {
    const listPanel = document.getElementById('listPanel');
    const mapPanel  = document.getElementById('mapPanel');
    const tabs      = document.querySelectorAll('.view-tab');
    if (tab === 'map') {
      listPanel.classList.add('tab-hidden');
      mapPanel.classList.add('tab-active');
      tabs[0]?.classList.remove('active');
      tabs[1]?.classList.add('active');
      if (!crsMap) initCrsMap();
      else setTimeout(() => naver.maps.Event.trigger(crsMap, 'resize'), 50);
    } else {
      listPanel.classList.remove('tab-hidden');
      mapPanel.classList.remove('tab-active');
      tabs[0]?.classList.add('active');
      tabs[1]?.classList.remove('active');
    }
  }

  // ── 지도 주소 검색 ──
  function initMapSearch() {
    const input   = document.getElementById('mapSearchInput');
    const btn     = document.getElementById('mapSearchBtn');
    const results = document.getElementById('mapSearchResults');
    if (!input) return;

    async function doSearch() {
      const q = input.value.trim();
      if (!q) return;
      results.innerHTML = `<div class="map-search-item no-result">검색 중...</div>`;
      results.classList.add('open');

      // 등록된 교회 중 매칭
      const matchedChurches = churches.filter(c =>
        (c.churchName || '').includes(q) || (c.location || '').includes(q) || (c.pastorName || '').includes(q)
      );

      // 프록시를 통한 지오코딩
      let geoAddresses = [];
      try {
        const res = await fetch(`/api/geocode?query=${encodeURIComponent(q)}`);
        if (res.ok) {
          const data = await res.json();
          geoAddresses = data.addresses || [];
        }
      } catch (e) { /* 지오코딩 실패 시 교회 결과만 표시 */ }

      const items = [];
      matchedChurches.slice(0, 3).forEach(c => {
        items.push({ label: c.churchName, sub: c.location || '', isChurch: true, church: c });
      });
      geoAddresses.slice(0, 4).forEach(addr => {
        items.push({
          label: addr.roadAddress || addr.jibunAddress,
          sub: addr.jibunAddress !== addr.roadAddress ? addr.jibunAddress : '',
          lat: parseFloat(addr.y), lng: parseFloat(addr.x),
        });
      });

      if (!items.length) {
        results.innerHTML = `<div class="map-search-item no-result">검색 결과가 없습니다</div>`;
        return;
      }

      results.innerHTML = items.map((item, i) => `
        <div class="map-search-item" data-idx="${i}">
          ${item.isChurch ? '<svg width="10" height="10" viewBox="0 0 10 10" style="margin-right:4px;color:#004f68"><path d="M5 1L1 4v5h3V7h2v2h3V4z" fill="currentColor"/></svg>' : ''}
          ${esc(item.label)}
          ${item.sub ? `<small>${esc(item.sub)}</small>` : ''}
        </div>`).join('');

      results.querySelectorAll('.map-search-item').forEach((el, i) => {
        el.addEventListener('click', () => {
          const item = items[i];
          results.classList.remove('open');
          input.value = '';
          if (item.isChurch) {
            const coords = getSavedChurchCoords(item.church);
            if (coords && crsMap) { crsMap.setCenter(new naver.maps.LatLng(coords[0], coords[1])); crsMap.setZoom(12); }
            if (window.innerWidth <= 768) switchCrsTab('list');
            openDetailModal(item.church);
          } else if (item.lat && crsMap) {
            crsMap.setCenter(new naver.maps.LatLng(item.lat, item.lng));
            crsMap.setZoom(14);
          }
        });
      });
    }

    btn.addEventListener('click', doSearch);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') doSearch(); });
    document.addEventListener('click', e => {
      if (!e.target.closest('#mapSearchBox')) results.classList.remove('open');
    });
  }

  // ── 서비스워커 등록 ──
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/crs-sw.js', { scope: '/crs' })
        .catch(e => console.warn('CRS SW registration failed:', e));
    });
  }
</script>
