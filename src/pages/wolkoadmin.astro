      { name: '송승현', title: '월코 부대표 선교사', role: 'missionary', teams: ['프로그램', '상담자'] },
      { name: '김환규', spouseName: '김씬띠아', title: '교육자료 개발 코디네이터', role: 'missionary', teams: ['티칭', '테크'] },
