        loginFirst:'로그인 후 자동으로 불러옵니다.', totalCapacity:'전체 정원 현황', statLoading:'불러오는 중…',
        statTotal:'총 신청', statRemain:'잔여 정원', statWaitlist:'예비 신청', statStaff:'스태프 지원',
        statCapBasis:'정원 기준', statWaitlistCount:'예비 대기 인원', statApplyStatus:'지원 현황',
        teamPanelTitle:'팀 운영 현황',
        leaderCountFn: n=>`팀 리더 ${n}명`, memberCountFn: n=>`멤버 ${n}명`, staffCountFn: n=>`지원 스태프 ${n}명`,
        editBtn:'편집', doneBtn:'편집 완료', allFilter:'전체',
        campDirector:'캠프 디렉터', coordinator:'코디네이터', unassigned:'— 미배정 —',
        customMemberAdd:'미지정 인원 추가',
        cmNamePh:'이름 *', cmSpousePh:'배우자 이름', cmTitlePh:'직책',
        cmRoleLeader:'팀 리더', cmRoleIntern:'인턴', cmRoleStaff:'스태프', cmAddBtn:'추가',
        husband:'남편', wife:'아내',
        teamLeaderRole:'팀 리더', internRole:'인턴', staffRole:'월코 스태프',
        teamAssign:'팀 배정', exclude:'제외', restore:'복귀',
        noLeader:'배정된 리더가 없습니다.', noMember:'등록된 멤버가 없습니다.',
        noApplicant:'이 팀을 선택한 지원자가 없습니다.',
        teamLeaderSection:'팀 리더', memberSection:'멤버', applicantSection:'지원 스태프',
        teamSaved:'팀 정보가 저장되었습니다.', teamSaveErr:'팀 저장 오류: ',
        deleted:'신청이 삭제되었습니다.', deleteErr:'삭제 오류: ',
        csvDone:'CSV 다운로드 완료!', csvStaffDone:'스태프 CSV 다운로드 완료!',
        fieldSaved:'저장되었습니다.', fieldErr:'저장 오류: ',
        unassignedTeam:'미등록 팀', allAssigned:'미등록 인원이 없습니다.',
        createTeam:'팀 만들기', newTeamPh:'새 팀 이름 입력', createBtn:'만들기',
        deleteTeam:'팀 삭제', customTeamsLabel:'사용자 정의 팀',
        noPending:'스태프 지원 내역이 없습니다.', noRegs:'신청 내역이 없습니다.',
        campEmpty:'등록된 스태프가 없습니다.',
        noChurch:'교회 미입력', notEntered:'미입력', unset:'—',
        male:'남', female:'여',
        cmsLink:'콘텐츠 편집 (CMS) — wolko.org/admin', sheetsLink:'신청 백업 시트 (Google Sheets)',
        selected:'선택됨', season:'시즌', applicationShort:'신청', remainingShort:'잔여',
        capacityFn: n=>`정원 ${n}명`, tableCountFn: n=>`(${n}건)`, personCountFn: n=>`${n}명`,
