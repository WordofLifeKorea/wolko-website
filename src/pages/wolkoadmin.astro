        const serviceAreaVal = r.serviceArea || r.notes || '';
        const campStyle = getCampRowStyle(r);
        const rowStyle = `--camp-row-bg:${campStyle.bg};--camp-row-border:${campStyle.border};`;

        // 성별 — 항상 읽기 전용
        const genderBadge = r.gender === 'male'
          ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(59,130,246,0.12);color:#2563eb;font-size:11px;font-weight:700;">남</span>`
          : r.gender === 'female'
          ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(236,72,153,0.12);color:#db2777;font-size:11px;font-weight:700;">여</span>`
          : `<span style="color:var(--light)">—</span>`;

        // 전화번호 — 수정 모드일 때 input
        const phoneCell = staffEditMode
          ? `<input class="edit-input" type="tel" value="${esc(r.phone)}" data-regid="${r.regId}" data-campid="${r.campId}" data-field="phone" onblur="updateField(this)" onkeydown="if(event.key==='Enter')this.blur()">`
          : esc(r.phone);

        // 섬기고 싶은 팀 — 수정 모드일 때 체크형 칩
        const currentTeams = serviceAreaVal.split(',').map(s => s.trim()).filter(Boolean);
        const customTeams = currentTeams.filter(t => !STAFF_TEAMS.includes(t));
        const serviceAreaCell = staffEditMode
          ? `<div class="team-picker" data-regid="${r.regId}" data-campid="${r.campId}" data-field="serviceArea">
               ${STAFF_TEAMS.map(t => `<label class="team-choice ${getStaffTeamClass(t)}">
                 <input class="team-fixed-input" type="checkbox" value="${esc(t)}"${currentTeams.includes(t) ? ' checked' : ''} onchange="updateTeamField(this.closest('.team-picker'))">
                 <span>${esc(t)}</span>
               </label>`).join('')}
               <label class="team-choice team-other">
                 <input class="team-other-toggle" type="checkbox"${customTeams.length ? ' checked' : ''} onchange="toggleCustomTeamInput(this)">
                 <span>기타</span>
               </label>
               <input class="team-custom-input" type="text" value="${esc(customTeams.join(', '))}" placeholder="직접 입력"${customTeams.length ? '' : ' hidden'} onblur="updateTeamField(this.closest('.team-picker'))" onkeydown="if(event.key==='Enter')this.blur()">
             </div>`
          : (currentTeams.length
              ? currentTeams.map(t => `<span class="team-badge ${getStaffTeamClass(t)}">${esc(t)}</span>`).join('')
              : `<span style="color:var(--light)">—</span>`);
        const detailKey = `staff:${r.regId}`;
