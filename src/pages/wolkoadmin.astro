    function t(key) { return ADMIN_T[adminLang]?.[key] ?? ADMIN_T.ko?.[key] ?? key; }
    function tt(key, ...args) {
      const v = t(key);
      return typeof v === 'function' ? v(...args) : v;
    }
    function applyLangToDOM() {
      document.documentElement.lang = adminLang === 'en' ? 'en' : 'ko';
      document.title = t('pageTitle');
      document.querySelectorAll('[data-t]').forEach(el => {
        const v = t(el.dataset.t);
        if (typeof v === 'string') el.textContent = v;
      });
      const pwInput = document.getElementById('pwInput');
      if (pwInput) pwInput.placeholder = t('loginPw');
      const eyeBtn = document.getElementById('eyeBtn');
      if (eyeBtn) eyeBtn.setAttribute('aria-label', t('showPassword'));
      const langBtn = document.getElementById('langToggleLabel');
      if (langBtn) langBtn.textContent = adminLang === 'ko' ? 'EN' : '한';
      applyInstallGuideText();
    }
    function applyInstallGuideText() {
      const titleEl = document.getElementById('admGuideTitle');
      const descEl = document.getElementById('admGuideDesc');
      const stepsEl = document.getElementById('admGuideSteps');
      const okEl = document.getElementById('admGuideOk');
      if (!descEl || !stepsEl) return;
      const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);
      if (titleEl) titleEl.textContent = t('installGuideTitle');
      descEl.textContent = isIOS ? t('installGuideIos') : t('installGuideChrome');
      stepsEl.innerHTML = isIOS
        ? `<li>${t('installStepShare')}</li><li>${t('installStepHome')}</li><li>${t('installStepAdd')}</li>`
        : `<li>${t('installStepChrome1')}</li><li>${t('installStepHome')}</li><li>${t('installStepAdd')}</li>`;
      if (okEl) okEl.textContent = t('confirmBtn');
    }
    function toggleAdminLang() {
      adminLang = adminLang === 'ko' ? 'en' : 'ko';
      localStorage.setItem('wolkoAdminLang', adminLang);
      applyLangToDOM();
      buildCampCards();
      updateCardStats();
      renderTable();
      renderDash();
    }
    applyLangToDOM();

