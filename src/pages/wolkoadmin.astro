        const detailButton = `<button class="row-toggle-btn${isDetailExpanded ? ' is-open' : ''}" type="button" aria-expanded="${isDetailExpanded}" aria-label="${isDetailExpanded ? '상세 닫기' : '상세 보기'}" onclick="toggleRegistrationDetail('staff','${esc(r.regId)}')">
          <span class="row-toggle-mark" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="row-toggle-text">${isDetailExpanded ? '닫기' : '상세'}</span>
        </button>`;
        const staffDetailRow = isDetailExpanded
          ? `<tr class="registration-detail-row staff-detail-row" style="${rowStyle}">
              <td colspan="3">
                <div class="registration-detail-panel">
                  <div class="registration-detail-head">
                    <strong>지원 상세</strong>
                    <span>${esc(r.name)} · ${esc(campLabel)}</span>
                  </div>
                  <div class="registration-detail-section">
                    <div class="registration-detail-section-title">기본 정보</div>
                    <div class="registration-detail-grid">
                      <span class="registration-detail-item"><span class="registration-detail-label">이름</span><span class="registration-detail-value">${esc(r.name)}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">성별</span><span class="registration-detail-value">${genderBadge}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">캠프</span><span class="registration-detail-value">${esc(campLabel)}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">섬김 분야</span><span class="registration-detail-value">${serviceAreaCell}</span></span>
                    </div>
                  </div>
                  <div class="registration-detail-section">
                    <div class="registration-detail-section-title">연락 정보</div>
                    <div class="registration-detail-grid">
                      <span class="registration-detail-item"><span class="registration-detail-label">연락처</span><span class="registration-detail-value">${phoneCell}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">이메일</span><span class="registration-detail-value">${esc(r.email || '—')}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">교회</span><span class="registration-detail-value">${esc(r.church || '—')}</span></span>
                      <span class="registration-detail-item registration-detail-wide"><span class="registration-detail-label">신청일</span><span class="registration-detail-value">${dateStr}</span></span>
                    </div>
                  </div>
                  <div class="registration-detail-actions"><button class="btn-del" onclick="deleteReg('${r.regId}','${r.campId}')">삭제</button></div>
                </div>
              </td>
            </tr>`
          : '';

        rowIndex += 1;
        const staffSummaryRow = isDetailExpanded
          ? `<tr class="camp-tint registration-summary-row registration-summary-open is-expanded" style="${rowStyle}" onclick="toggleRegistrationDetail('staff','${esc(r.regId)}',event)">
              <td colspan="3">
                <span class="registration-expanded-strip">
                  ${detailButton}
                  <span class="registration-expanded-title">${esc(r.name)}</span>
                  <span class="registration-expanded-meta">${esc(campLabel)}</span>
                </span>
              </td>
            </tr>`
          : `<tr class="camp-tint registration-summary-row" style="${rowStyle}" onclick="toggleRegistrationDetail('staff','${esc(r.regId)}',event)">
              <td><span class="registration-status-cell">${detailButton}<span class="registration-person-name">${esc(r.name)}</span></span></td>
              <td>${genderBadge}</td>
              <td>${serviceAreaCell}</td>
            </tr>`;
        return `${staffSummaryRow}${staffDetailRow}`;
      };

      const season = SEASONS.find(s => s.id === activeSeason);
      const orderedCampIds = activeCamp === 'all'
        ? (season?.groups.flatMap(group => group.camps.map(camp => camp.id)) || [])
        : [activeCamp];
      const extraCampIds = [...new Set(regs.map(r => r.campId))].filter(campId => !orderedCampIds.includes(campId));

      tbody.innerHTML = [...orderedCampIds, ...extraCampIds].map(campId => {
        const campRegs = regs.filter(r => r.campId === campId);
        const campStyle = getCampRowStyle({ campId });
        return `<tr class="staff-camp-divider" style="--camp-row-bg:${campStyle.bg};--camp-row-border:${campStyle.border};">
          <td colspan="3"><strong>${esc(CAMP_LABELS[campId] || campId)}</strong><span>${campRegs.length}명</span></td>
        </tr>${campRegs.length
          ? campRegs.map(renderStaffRow).join('')
          : `<tr class="staff-camp-empty"><td colspan="3">등록된 스태프가 없습니다.</td></tr>`}`;
      }).join('');
    }

    function esc(str) {
      return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function toggleRegistrationDetail(kind, regId, event) {
      if (event?.target?.closest('button,input,select,textarea,label,a')) return;
      const key = `${kind}:${regId}`;
      if (expandedRegistrationRows.has(key)) expandedRegistrationRows.delete(key);
      else expandedRegistrationRows.add(key);
      if (kind === 'staff') renderStaffTable();
      else renderCampTable();
    }

    function toggleGroupParticipants(regId) {
      if (expandedGroupParticipants.has(regId)) expandedGroupParticipants.delete(regId);
      else expandedGroupParticipants.add(regId);
      renderCampTable();
    }

    // ── Edit Mode Toggle ──
    function toggleEditMode() {
      staffEditMode = !staffEditMode;
      const btn = document.getElementById('btnStaffEditMode');
      btn.classList.toggle('active', staffEditMode);
      btn.querySelector('span').textContent = staffEditMode ? '수정 중' : '수정 모드';
      renderStaffTable();
    }

    function toggleCamperEditMode() {
      camperEditMode = !camperEditMode;
      const btn = document.getElementById('btnCamperEditMode');
      btn.classList.toggle('active', camperEditMode);
      btn.querySelector('span').textContent = camperEditMode ? '수정 중' : '수정 모드';
      renderCampTable();
    }

    // ── 전화번호 포맷 (숫자만 추출 후 010-XXXX-XXXX 형식) ──
    function formatPhone(raw) {
      const d = raw.replace(/\D/g, '');
      if (d.length === 11) return `${d.slice(0,3)}-${d.slice(3,7)}-${d.slice(7)}`;
      if (d.length === 10) return d.startsWith('02')
        ? `${d.slice(0,2)}-${d.slice(2,6)}-${d.slice(6)}`
        : `${d.slice(0,3)}-${d.slice(3,6)}-${d.slice(6)}`;
      return raw; // 자릿수 불일치 시 원문 유지
    }

    // ── 팀 선택 업데이트 ──
    async function updateTeamField(pickerEl) {
      const regId  = pickerEl.dataset.regid;
      const campId = pickerEl.dataset.campid;
      const field  = pickerEl.dataset.field;
      const inputs = Array.from(pickerEl.querySelectorAll('input[type="checkbox"]'));
      const fixedTeams = inputs.filter(input => input.matches('.team-fixed-input:checked')).map(input => input.value);
      const customToggle = pickerEl.querySelector('.team-other-toggle');
      const customInput = pickerEl.querySelector('.team-custom-input');
      const customTeams = customToggle?.checked
        ? customInput.value.split(',').map(team => team.trim()).filter(Boolean)
        : [];
      const value  = [...new Set([...fixedTeams, ...customTeams])].join(', ');
      const reg    = allRegs.find(r => r.regId === regId);
      if (!reg) return;
      inputs.forEach(input => { input.disabled = true; });
      customInput.disabled = true;
      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PUT',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, field, value }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '저장 실패');
        reg[field] = value;
        showToast('팀 정보가 저장되었습니다.', 'success');
      } catch(e) {
        showToast('저장 오류: ' + e.message, 'error');
      }
      renderStaffTable();
    }

    function toggleCustomTeamInput(toggleEl) {
      const pickerEl = toggleEl.closest('.team-picker');
      const customInput = pickerEl.querySelector('.team-custom-input');
      customInput.hidden = !toggleEl.checked;
      if (toggleEl.checked) {
        customInput.focus();
      } else {
        customInput.value = '';
        updateTeamField(pickerEl);
      }
    }

    // ── Field Update (전화번호, 섬기고 싶은 분야 등) ──
    async function updateField(inputEl) {
      const regId  = inputEl.dataset.regid;
      const campId = inputEl.dataset.campid;
      const field  = inputEl.dataset.field;
      const participantIndex = inputEl.dataset.participantindex;
      let value = inputEl.type === 'checkbox' ? inputEl.checked : inputEl.value.trim();

      // 전화번호 자동 포맷 후 input 값도 즉시 반영
      if (field === 'phone' && value) {
        value = formatPhone(value);
        inputEl.value = value;
      }

      const reg = allRegs.find(r => r.regId === regId);
      if (!reg) return;
      const record = participantIndex === undefined ? reg : (reg.participants?.[Number(participantIndex)] || {});
      if (!record) return;

      // 값 변경 없으면 스킵
      const original = inputEl.type === 'checkbox' ? !!record[field] : String(record[field] || '').trim();
      if (value === original) return;

      inputEl.classList.add('saving');
      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PUT',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, field, value, ...(participantIndex === undefined ? {} : { participantIndex: Number(participantIndex) }) }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '업데이트 실패');
        if (participantIndex === undefined) {
          record[field] = value;
        } else {
          Object.assign(reg, data.reg);
        }
        inputEl.classList.remove('saving');
        inputEl.classList.add('saved');
        setTimeout(() => inputEl.classList.remove('saved'), 1500);
        if (participantIndex !== undefined || inputEl.type === 'checkbox') {
          updateCardStats();
          renderCampTable();
          renderDash();
        }
        showToast('저장되었습니다.', 'success');
      } catch (e) {
        if (inputEl.type === 'checkbox') inputEl.checked = original;
        else inputEl.value = original; // 실패 시 원복
        inputEl.classList.remove('saving');
        showToast('저장 오류: ' + e.message, 'error');
      }
    }

    // ── Delete ──
    async function deleteReg(regId, campId) {
      if (!confirm(`정말 삭제하시겠습니까?\n이 작업은 되돌릴 수 없습니다.`)) return;
      try {
        const res = await fetch(`/api/admin/registrations?regId=${regId}&campId=${campId}`, {
          method: 'DELETE', headers: authHeaders()
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '삭제 실패');
        allRegs = allRegs.filter(r => r.regId !== regId);
        renderTable();
        renderDash();
        showToast('신청이 삭제되었습니다.', 'success');
      } catch (e) {
        showToast('삭제 오류: ' + e.message, 'error');
      }
    }

    // ── 예약금 수납 ──
    async function depositReg(regId, campId) {
      if (!confirm(`예약금 수납을 확인하시겠습니까?\n예약금 입금이 확인된 경우에만 진행해주세요.`)) return;
      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PATCH',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, action: 'deposit', campTitleKo: CAMP_LABELS[campId] || campId, campDateKo: CAMP_DATES[campId] || '' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '처리 실패');
        const reg = allRegs.find(r => r.regId === regId);
        if (reg) { reg.status = 'deposit'; reg.depositConfirmedAt = data.reg?.depositConfirmedAt || new Date().toISOString(); }
        renderTable();
        renderDash();
        updateCardStats();
        showToast('예약금 수납이 확인되었습니다. 알림톡을 발송했습니다.', 'success');
      } catch (e) {
        showToast('오류: ' + e.message, 'error');
      }
    }

    // ── 최종 확정 ──
    async function confirmReg(regId, campId) {
      if (!confirm(`최종 확정하시겠습니까?\n잔금 입금이 모두 확인된 경우에만 진행해주세요.`)) return;
      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PATCH',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, action: 'confirm', campTitleKo: CAMP_LABELS[campId] || campId, campDateKo: CAMP_DATES[campId] || '' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '확정 실패');
        const reg = allRegs.find(r => r.regId === regId);
        if (reg) { reg.status = 'confirmed'; reg.confirmed = true; reg.confirmedAt = data.reg?.confirmedAt || new Date().toISOString(); }
        renderTable();
        renderDash();
        updateCardStats();
        showToast('최종 확정되었습니다. 알림톡을 발송했습니다.', 'success');
      } catch (e) {
        showToast('확정 오류: ' + e.message, 'error');
      }
    }

    // ── CSV ──
    function downloadCsv(type = 'camp') {
      const campName = CAMP_LABELS[activeCamp] || '전체';
      const today = new Date().toISOString().slice(0, 10);
      const bom = '﻿';

      if (type === 'staff') {
        const regs = sortedRegs(filteredRegs().filter(r => r.registrationType === 'staff'));
        if (regs.length === 0) { showToast('다운로드할 스태프 데이터가 없습니다.', 'error'); return; }
        const headers = ['번호','캠프','이름','연락처','이메일','성별','교회','섬기고 싶은 분야','신청일시','RegID'];
        const rows = regs.map((r, i) => {
          const date = new Date(r.registeredAt).toLocaleString('ko-KR');
          const genderLabel = r.gender === 'male' ? '남' : r.gender === 'female' ? '여' : '';
          return [
            i + 1, CAMP_LABELS[r.campId] || r.campId,
            r.name, r.phone, r.email, genderLabel, r.church || '',
            r.serviceArea || r.notes || '', date, r.regId,
          ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(',');
        });
        const csv = bom + [headers.join(','), ...rows].join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `WOLKO_스태프지원_${campName}_${today}.csv`;
        a.click(); URL.revokeObjectURL(url);
        showToast('스태프 CSV 다운로드 완료!', 'success');
      } else {
        const regs = sortedRegs(filteredRegs().filter(r => r.registrationType !== 'staff'));
        if (regs.length === 0) { showToast('다운로드할 신청 데이터가 없습니다.', 'error'); return; }
        const headers = ['번호','상태','캠프','유형','이름','학생 명단','담당 카운슬러','구원','헌신','상담자 메모','연락처','이메일','학년/인원','성별','교회','학교','비상연락처','메모','신청일시','RegID'];
        const rows = regs.map((r, i) => {
          const date = new Date(r.registeredAt).toLocaleString('ko-KR');
          const gradeOrCount = r.registrationType === 'group' ? `단체 ${r.groupCount}명` : (r.grade || '');
          const _s = r.status || (r.confirmed !== false ? 'confirmed' : 'pending');
          const statusVal = _s === 'confirmed' ? '최종확정' : _s === 'deposit' ? '예약금확인' : '대기중';
          let genderVal;
          if (r.registrationType === 'group') {
            const m = r.maleCount || 0, f = r.femaleCount || 0;
            genderVal = (m > 0 || f > 0) ? `남 ${m} 여 ${f}` : '';
          } else {
            genderVal = r.gender === 'male' ? '남' : r.gender === 'female' ? '여' : '';
          }
          const counselor = allRegs.find(staff => staff.regId === r.counselorRegId && staff.campId === r.campId);
          const participantList = Array.isArray(r.participants)
            ? r.participants.map((participant, index) => {
                const participantCounselor = allRegs.find(staff => staff.regId === participant.counselorRegId && staff.campId === r.campId);
                return `${index + 1}. ${participant.name || '미입력'} (${participant.gender === 'male' ? '남' : participant.gender === 'female' ? '여' : '성별 미입력'}${participantCounselor ? ` / ${participantCounselor.name}` : ''}${participant.saved ? ' / 구원' : ''}${participant.dedicated ? ' / 헌신' : ''}${participant.counselorMemo ? ` / 상담자 메모: ${participant.counselorMemo}` : ''})`;
              }).join('\n')
            : '';
          return [
            i + 1, statusVal, CAMP_LABELS[r.campId] || r.campId,
            r.registrationType === 'group' ? '단체' : '개인',
            r.name, participantList, counselor?.name || '', r.saved ? 'O' : '', r.dedicated ? 'O' : '', r.counselorMemo || '',
            r.phone, r.email, gradeOrCount, genderVal,
            r.church || '', r.school || '', r.emergency || '',
            r.notes || '', date, r.regId,
          ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(',');
        });
        const csv = bom + [headers.join(','), ...rows].join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `WOLKO_신청목록_${campName}_${today}.csv`;
        a.click(); URL.revokeObjectURL(url);
        showToast('CSV 다운로드 완료!', 'success');
      }
    }

    // ── Toast ──
    let toastTimer;
    function showToast(msg, type = '') {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'toast show' + (type ? ' ' + type : '');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { t.className = 'toast'; }, 3000);
    }

    // ── Auto-login if token exists ──
    if (authToken) {
      document.getElementById('loginScreen').classList.add('hidden');
      setTimeout(() => { document.getElementById('loginScreen').style.display = 'none'; }, 0);
      loadRegs();
    }

    // ── PWA 설치 ──
    let deferredAdminPrompt = null;
    const isAdminStandalone = window.matchMedia('(display-mode: standalone)').matches
      || window.navigator.standalone === true;
    const isAdminIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);

    // iOS일 경우 안내 모달 내용 교체
    if (isAdminIOS) {
      document.getElementById('admGuideEmoji').textContent = '🍎';
      document.getElementById('admGuideDesc').textContent = 'Safari 브라우저에서 설치할 수 있어요.';
      document.getElementById('admGuideSteps').innerHTML =
        '<li>하단 가운데 <strong>공유 버튼 (□↑)</strong> 탭</li>' +
        '<li><strong>"홈 화면에 추가"</strong> 선택</li>' +
        '<li><strong>"추가"</strong> 탭</li>';
    }

    if (!isAdminStandalone) {
      document.getElementById('adminInstallBtn').style.display = '';

      window.addEventListener('beforeinstallprompt', e => {
        e.preventDefault();
        deferredAdminPrompt = e;
      });
    }

    window.addEventListener('appinstalled', () => {
      deferredAdminPrompt = null;
      document.getElementById('adminInstallBtn').style.display = 'none';
    });

    function triggerAdminInstall() {
      if (deferredAdminPrompt) {
        deferredAdminPrompt.prompt();
        deferredAdminPrompt.userChoice.then(({ outcome }) => {
          if (outcome === 'accepted') {
            deferredAdminPrompt = null;
            document.getElementById('adminInstallBtn').style.display = 'none';
          }
        });
      } else {
        document.getElementById('adminInstallGuide').style.display = 'flex';
      }
    }

    function closeAdminGuide() {
      document.getElementById('adminInstallGuide').style.display = 'none';
    }

    // ── 서비스워커 등록 ──
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/admin-sw.js', { scope: '/wolkoadmin' })
          .catch(e => console.warn('Admin SW registration failed:', e));
      });
    }
  </script>

  <!-- 앱 설치 안내 모달 -->
  <div id="adminInstallGuide" style="display:none;position:fixed;inset:0;background:rgba(0,15,30,.55);backdrop-filter:blur(7px);z-index:9999;align-items:center;justify-content:center;padding:1rem;" onclick="if(event.target===this)closeAdminGuide()">
    <div style="background:#fff;border-radius:20px;max-width:320px;width:100%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.25);">
      <div style="display:flex;justify-content:flex-end;padding:.8rem 1rem .2rem;">
        <button onclick="closeAdminGuide()" style="background:none;border:none;font-size:1.4rem;color:#aaa;cursor:pointer;line-height:1;">×</button>
      </div>
      <div style="padding:.4rem 1.5rem 1.8rem;text-align:center;">
        <div id="admGuideEmoji" style="font-size:2.2rem;margin-bottom:.8rem;">📲</div>
        <h3 style="margin:0 0 .5rem;font-size:1.05rem;color:#004f68;">앱으로 설치하기</h3>
        <p id="admGuideDesc" style="font-size:.83rem;color:#5a6f79;margin:0 0 1.2rem;line-height:1.6;">Chrome 브라우저 메뉴에서 설치할 수 있어요.</p>
        <ol id="admGuideSteps" style="text-align:left;font-size:.86rem;line-height:2.1;color:#2d4a56;padding-left:1.2rem;margin:0 0 1.4rem;">
          <li>오른쪽 상단 <strong>⋮ 메뉴</strong> 탭</li>
          <li><strong>"홈 화면에 추가"</strong> 선택</li>
          <li><strong>"추가"</strong> 탭</li>
        </ol>
        <button onclick="closeAdminGuide()" style="width:100%;padding:.75rem;background:#004f68;color:#fff;border:none;border-radius:10px;font-size:.93rem;font-weight:700;cursor:pointer;">확인</button>
      </div>
    </div>
  </div>
</body>
</html>
