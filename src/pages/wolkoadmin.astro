---
// Admin page — password protected via /api/admin/login
// No BaseLayout; standalone page
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>관리자 — WOLKO 캠프 신청 현황</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Noto+Sans+KR:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolkoadmin.css?v=26">
  <link rel="manifest" href="/admin-manifest.json">
  <meta name="theme-color" content="#004f68">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="WOLKO 관리자">
  <link rel="apple-touch-icon" href="/images/WOLKO Circle.png">
</head>
<body>

  <!-- ── LOGIN SCREEN ── -->
  <div class="login-screen" id="loginScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title">관리자 로그인</p>
      <div class="login-input-wrap">
        <input class="login-input" type="password" id="pwInput" placeholder="비밀번호를 입력하세요" autocomplete="current-password" inputmode="latin" pattern="[\x21-\x7E]*">
        <button class="login-eye" id="eyeBtn" onclick="togglePw()" type="button" aria-label="비밀번호 표시">
          <svg id="eyeIcon" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M1 9C2.5 5.5 5.5 3 9 3s6.5 2.5 8 6c-1.5 3.5-4.5 6-8 6S2.5 12.5 1 9z" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
        <div class="password-input-tooltip" id="pwInputTip" role="status" aria-live="polite">영문 및 숫자, 특수 기호만 입력이 가능합니다.</div>
      </div>
      <p class="login-error" id="loginError"></p>
      <button class="login-btn" id="loginBtn" onclick="doLogin()">로그인</button>
    </div>
  </div>

  <!-- ── HEADER ── -->
  <header class="adm-header">
    <a class="adm-header-logo" href="/">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <span>WOLKO 관리자</span>
    </a>
    <div class="adm-header-right">
      <a href="/admin" target="_blank" class="adm-header-badge" style="text-decoration:none;cursor:pointer;" title="콘텐츠 편집 CMS">✏️ 콘텐츠 CMS</a>
      <span class="adm-header-badge">CAMP ADMIN</span>
      <button class="btn-install-adm" id="adminInstallBtn" onclick="triggerAdminInstall()" style="display:none">
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M7 1v8M4 6l3 3 3-3M2 11.5h10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        앱 설치
      </button>
      <button class="btn-logout" onclick="doLogout()">로그아웃</button>
    </div>
  </header>

  <div class="adm-wrap">
    <!-- CAMP CARDS -->
    <div class="camp-cards" id="campCards"></div>

    <!-- STATS TABLE -->
    <div class="stats-wrap">
      <table class="stats-tbl">
        <thead>
          <tr>
            <th>총 신청</th>
            <th>잔여 정원</th>
            <th class="c-amber">예비 신청</th>
            <th class="c-teal">스태프 지원</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <strong class="sv" id="dTotal">—</strong>
              <small id="dTotalSub">불러오는 중…</small>
            </td>
            <td>
              <strong class="sv c-green" id="dRemain">—</strong>
              <small id="dRemainSub">정원 기준</small>
            </td>
            <td>
              <strong class="sv c-amber" id="dWaitlist">—</strong>
              <small id="dWaitlistSub">예비 대기 인원</small>
            </td>
            <td>
              <strong class="sv c-teal" id="dStaff">—</strong>
              <small id="dStaffSub">지원 현황</small>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- PROGRESS -->
    <div class="progress-wrap">
      <div class="progress-header">
        <span class="progress-title" id="progressLabel">전체 정원 현황</span>
        <span class="progress-pct" id="progressPct">0%</span>
      </div>
      <div class="progress-bar-bg" style="display:flex;overflow:hidden;border-radius:999px;">
        <div class="progress-bar-fill" id="progressFillM" style="width:0%;background:#3b82f6;border-radius:0;transition:width 0.6s ease;flex-shrink:0;height:100%"></div>
        <div class="progress-bar-fill" id="progressFillF" style="width:0%;background:#ec4899;border-radius:0;transition:width 0.6s ease;flex-shrink:0;height:100%"></div>
      </div>
      <div style="display:flex;justify-content:space-between;margin-top:6px;font-size:11px;font-weight:600;">
        <span id="progressGenderM" style="color:#3b82f6"></span>
        <span id="progressGenderF" style="color:#ec4899"></span>
      </div>
    </div>

    <!-- 캠프 신청 TABLE -->
    <div class="table-section">
      <div class="table-toolbar">
        <div>
          <span class="table-title">캠프 신청 목록</span>
          <span class="table-count" id="campTableCount"></span>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
          <button class="btn-edit-mode" id="btnCamperEditMode" onclick="toggleCamperEditMode()">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
              <path d="M9.5 2.5l2 2-7 7H2.5v-2l7-7z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>수정 모드</span>
          </button>
          <button class="btn-csv" onclick="downloadCsv('camp')">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M7 1v8M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            CSV 다운로드
          </button>
        </div>
      </div>
      <div class="table-scroll">
        <table class="camp-reg-table">
          <thead>
            <tr>
              <th><button class="sort-btn" type="button" data-sort="status">상태</button></th>
              <th><button class="sort-btn" type="button" data-sort="type">유형</button></th>
              <th><button class="sort-btn" type="button" data-sort="name">이름</button></th>
              <th>담당 카운슬러</th>
              <th><button class="sort-btn" type="button" data-sort="grade">학년 / 인원</button></th>
              <th><button class="sort-btn" type="button" data-sort="gender">성별</button></th>
            </tr>
          </thead>
          <tbody id="campRegBody">
            <tr><td colspan="6">
              <div class="state-box">
                <div class="spinner"></div>
                <p>로그인 후 자동으로 불러옵니다.</p>
              </div>
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 스태프 지원 TABLE -->
    <div class="table-section" style="margin-top:20px;">
      <div class="table-toolbar">
        <div>
          <span class="table-title" style="color:#0d9488;">스태프 · 봉사자 지원 목록</span>
          <span class="table-count" id="staffTableCount"></span>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
          <button class="btn-edit-mode" id="btnStaffEditMode" onclick="toggleEditMode()">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none">
              <path d="M9.5 2.5l2 2-7 7H2.5v-2l7-7z" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>수정 모드</span>
          </button>
          <button class="btn-csv" onclick="downloadCsv('staff')" style="background:rgba(13,148,136,0.08);color:#0d9488;border-color:rgba(13,148,136,0.2);">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M7 1v8M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            CSV 다운로드
          </button>
        </div>
      </div>
      <div class="table-scroll">
        <table class="staff-reg-table">
          <thead>
            <tr>
              <th><button class="sort-btn" type="button" data-sort="name">이름</button></th>
              <th><button class="sort-btn" type="button" data-sort="gender">성별</button></th>
              <th><button class="sort-btn" type="button" data-sort="serviceArea">섬기고 싶은 분야</button></th>
            </tr>
          </thead>
          <tbody id="staffRegBody">
            <tr><td colspan="3">
              <div class="state-box">
                <div class="spinner"></div>
                <p>로그인 후 자동으로 불러옵니다.</p>
              </div>
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ── CMS / SHEETS LINKS ── -->
    <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:10px;">
      <a href="/admin" target="_blank" style="display:inline-flex;align-items:center;gap:10px;padding:14px 24px;background:#fff;border:1.5px solid rgba(0,79,104,0.14);border-radius:12px;color:#004f68;font-size:14px;font-weight:600;text-decoration:none;transition:box-shadow 0.15s,border-color 0.15s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(0,79,104,0.10)';this.style.borderColor='rgba(0,79,104,0.3)'" onmouseout="this.style.boxShadow='';this.style.borderColor='rgba(0,79,104,0.14)'">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        콘텐츠 편집 (CMS) — wolko.org/admin
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.4"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
      <a href="https://docs.google.com/spreadsheets/d/1UxxabXZJYUgbyqC-MnGDYDGgNwdY5l0jP2FUzB2xsJQ/edit?gid=0#gid=0" target="_blank" style="display:inline-flex;align-items:center;gap:10px;padding:14px 24px;background:#fff;border:1.5px solid rgba(22,163,74,0.2);border-radius:12px;color:#16a34a;font-size:14px;font-weight:600;text-decoration:none;transition:box-shadow 0.15s,border-color 0.15s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(22,163,74,0.10)';this.style.borderColor='rgba(22,163,74,0.4)'" onmouseout="this.style.boxShadow='';this.style.borderColor='rgba(22,163,74,0.2)'">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg>
        신청 백업 시트 (Google Sheets)
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.4"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </div>

  </div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <script is:inline>
    // ── 시즌 데이터 ──────────────────────────────────────────────────────────────
    // 새 시즌 추가 시 SEASONS 배열에 항목 추가 (최신 시즌이 마지막에 위치)
    const SEASONS = [
      {
        id: '2026-summer',
        label: '2026 여름',
        groups: [
          {
            group: 'wolko',
            label: 'WOLKO 캠프',
            camps: [
              { id: '2026-inland-english-junior', title: '2026 여름 주니어 영어 캠프', dateKo: '7월 27일 – 8월 1일', capacity: 40 },
            ],
          },
          {
            group: 'union',
            label: '연합캠프',
            camps: [
              { id: '2026-inland-union',          title: '2026 교회 연합캠프',          dateKo: '8월 6일 – 8일',    capacity: 40 },
            ],
          },
        ],
      },
      // 다음 시즌 추가 예시:
      // {
      //   id: '2027-winter',
      //   label: '2027 겨울',
      //   groups: [
      //     {
      //       group: 'wolko',
      //       label: 'WOLKO 캠프',
      //       camps: [
      //         { id: '2027-winter-camp-1', title: '2027 겨울 캠프', dateKo: '1월 10일 – 15일', capacity: 40 },
      //       ],
      //     },
      //   ],
      // },
    ];

    // 하위 호환: CAMP_GROUPS는 전체 시즌 통합 목록
    const CAMP_GROUPS = SEASONS.flatMap(s =>
      s.groups.map(g => ({ ...g, seasonId: s.id }))
    );
    const CAMPS_ALL = [{ id: 'all', title: '전체 캠프', capacity: 9999 }]
      .concat(CAMP_GROUPS.flatMap(g => g.camps));
    const CAMP_LABELS = Object.fromEntries(CAMPS_ALL.map(c => [c.id, c.title]));
    const CAMP_CAP    = Object.fromEntries(CAMPS_ALL.map(c => [c.id, c.capacity]));
    const CAMP_DATES  = Object.fromEntries(CAMPS_ALL.map(c => [c.id, c.dateKo || '']));
    const CAMP_ROW_STYLES = {
      '2026-inland-english-junior': { bg: '#e6f5ff', border: '#3797c7' },
      '2026-inland-union': { bg: '#fff1c9', border: '#d49a18' },
      '2026-jeju-english': { bg: '#e2f8ea', border: '#35a96a' },
      '2026-jeju-momentum-1': { bg: '#f0e8ff', border: '#8364d8' },
      '2026-jeju-momentum-2': { bg: '#ffe6ef', border: '#d86491' },
      '2026-test-camp': { bg: '#edf4f7', border: '#7899a9' },
    };
    const CAMP_ROW_FALLBACK = { bg: '#eef4f7', border: '#7f9bab' };

    function getCampRowStyle(reg) {
      if (CAMP_ROW_STYLES[reg.campId]) return CAMP_ROW_STYLES[reg.campId];

      const label = String(CAMP_LABELS[reg.campId] || reg.campName || reg.campTitle || reg.campId || '').toLowerCase();
      if (label.includes('junior') || label.includes('주니어')) return CAMP_ROW_STYLES['2026-inland-english-junior'];
      if (label.includes('union') || label.includes('unity') || label.includes('연합')) return CAMP_ROW_STYLES['2026-inland-union'];
      if (label.includes('momentum') || label.includes('모멘텀 1') || label.includes('1차')) return CAMP_ROW_STYLES['2026-jeju-momentum-1'];
      if (label.includes('모멘텀 2') || label.includes('2차')) return CAMP_ROW_STYLES['2026-jeju-momentum-2'];
      if (label.includes('jeju') || label.includes('제주')) return CAMP_ROW_STYLES['2026-jeju-english'];
      return CAMP_ROW_FALLBACK;
    }

    const STAFF_TEAMS = ['프로그램', '수업', '상담자', '테크', '찬양팀'];
    const STAFF_TEAM_CLASSES = {
      '프로그램': 'team-program',
      '수업': 'team-class',
      '상담자': 'team-counselor',
      '테크': 'team-tech',
      '찬양팀': 'team-worship',
    };

    function getStaffTeamClass(team) {
      return STAFF_TEAM_CLASSES[team] || 'team-other';
    }

    let allRegs = [];
    let activeCamp = 'all';
    let activeSeason = SEASONS[SEASONS.length - 1].id; // 최신 시즌 기본 선택
    let sortState = { key: 'registeredAt', direction: 'desc' };
    let authToken = sessionStorage.getItem('wolko-admin-token') || '';
    let staffEditMode = false;
    let camperEditMode = false;
    const expandedGroupParticipants = new Set();
    const expandedRegistrationRows = new Set();

    // ── Login ──
    const PASSWORD_ALLOWED_RE = /^[\x21-\x7E]*$/;
    let passwordTooltipTimer = null;
    function cleanPasswordValue(value) {
      return String(value || '').replace(/[^\x21-\x7E]/g, '');
    }
    function showPasswordInputTip(input) {
      const tip = document.getElementById('pwInputTip');
      if (!tip) return;
      tip.classList.add('is-visible');
      input.classList.add('error');
      clearTimeout(passwordTooltipTimer);
      passwordTooltipTimer = setTimeout(() => {
        tip.classList.remove('is-visible');
        if (!document.getElementById('loginError')?.textContent) input.classList.remove('error');
      }, 2400);
    }
    function enforceAsciiPasswordInput(input) {
      input.addEventListener('beforeinput', e => {
        if (e.data && !PASSWORD_ALLOWED_RE.test(e.data)) {
          e.preventDefault();
          showPasswordInputTip(input);
        }
      });
      input.addEventListener('paste', e => {
        const text = e.clipboardData?.getData('text') || '';
        const clean = cleanPasswordValue(text);
        if (text !== clean) {
          e.preventDefault();
          const start = input.selectionStart ?? input.value.length;
          const end = input.selectionEnd ?? start;
          input.setRangeText(clean, start, end, 'end');
          input.dispatchEvent(new Event('input', { bubbles: true }));
          showPasswordInputTip(input);
        }
      });
      input.addEventListener('input', () => {
        const clean = cleanPasswordValue(input.value);
        if (input.value !== clean) {
          input.value = clean;
          showPasswordInputTip(input);
        }
      });
      input.addEventListener('compositionend', () => {
        const clean = cleanPasswordValue(input.value);
        if (input.value !== clean) {
          input.value = clean;
          showPasswordInputTip(input);
        }
      });
    }

    function togglePw() {
      const input = document.getElementById('pwInput');
      const icon = document.getElementById('eyeIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = `<path d="M2 2l14 14M7.5 7.6A2.5 2.5 0 0011.4 11.5M5.2 5.3C3.3 6.5 1.9 7.9 1 9c1.5 3.5 4.5 6 8 6 1.4 0 2.8-.4 4-1M9 3C12.5 3 15.5 5.5 17 9c-.5 1.1-1.2 2.1-2 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`;
      } else {
        input.type = 'password';
        icon.innerHTML = `<path d="M1 9C2.5 5.5 5.5 3 9 3s6.5 2.5 8 6c-1.5 3.5-4.5 6-8 6S2.5 12.5 1 9z" stroke="currentColor" stroke-width="1.5"/><circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>`;
      }
    }

    const adminPasswordInput = document.getElementById('pwInput');
    enforceAsciiPasswordInput(adminPasswordInput);
    adminPasswordInput.addEventListener('keydown', e => {
      if (e.key === 'Enter') doLogin();
    });

    async function doLogin() {
      const pw = document.getElementById('pwInput').value;
      const btn = document.getElementById('loginBtn');
      const errEl = document.getElementById('loginError');
      const inputEl = document.getElementById('pwInput');
      if (!pw) { errEl.textContent = '비밀번호를 입력해주세요.'; return; }

      btn.disabled = true;
      btn.textContent = '확인 중…';
      errEl.textContent = '';
      inputEl.classList.remove('error');

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pw }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '로그인 실패');

        authToken = data.token;
        sessionStorage.setItem('wolko-admin-token', authToken);

        const screen = document.getElementById('loginScreen');
        screen.classList.add('hidden');
        setTimeout(() => screen.style.display = 'none', 400);
        loadRegs();
      } catch (e) {
        errEl.textContent = e.message;
        inputEl.classList.add('error');
      } finally {
        btn.disabled = false;
        btn.textContent = '로그인';
      }
    }

    function doLogout() {
      sessionStorage.removeItem('wolko-admin-token');
      authToken = '';
      location.reload();
    }

    function authHeaders() {
      return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${authToken}` };
    }

    // ── Camp cards ──
    function makeCard(id, kicker, title, capacity) {
      const card = document.createElement('div');
      card.className = 'camp-card' + (id === 'all' ? ' active' : '');
      card.dataset.id = id;
      card.innerHTML = `
        <div class="camp-card-top">
          <span class="camp-card-kicker">${kicker}</span>
          <span class="camp-card-badge">선택됨</span>
        </div>
        <div class="camp-card-title">${title}</div>
        <div class="camp-card-stats">
          <div class="camp-card-stat">
            <div class="camp-card-stat-val" id="card-${id}-reg">—</div>
            <div class="camp-card-stat-lbl">신청</div>
          </div>
          <div class="camp-card-sep"></div>
          <div class="camp-card-stat">
            <div class="camp-card-stat-val green" id="card-${id}-cap">—</div>
            <div class="camp-card-stat-lbl">잔여</div>
          </div>
        </div>
      `;
      card.onclick = () => selectCamp(id);
      return card;
    }

    function selectSeason(id) {
      activeSeason = id;
      activeCamp = 'all';
      buildCampCards();
      renderTable();
      renderDash();
    }

    function navigateSeason(dir) {
      const idx = SEASONS.findIndex(s => s.id === activeSeason);
      const next = idx + dir;
      if (next >= 0 && next < SEASONS.length) selectSeason(SEASONS[next].id);
    }

    function makeSeasonCard() {
      const card = document.createElement('div');
      card.className = 'camp-card camp-season-card active';
      card.dataset.id = 'all';
      const season = SEASONS.find(s => s.id === activeSeason);
      const label = season ? season.label : '전체';
      const idx = SEASONS.findIndex(s => s.id === activeSeason);
      const hasPrev = idx > 0;
      const hasNext = idx < SEASONS.length - 1;
      const navHtml = SEASONS.length > 1 ? `
        <div class="season-card-nav">
          <select class="season-select" onclick="event.stopPropagation()" onchange="event.stopPropagation();selectSeason(this.value)">
            ${SEASONS.map(s => `<option value="${s.id}"${s.id === activeSeason ? ' selected' : ''}>${s.label}</option>`).join('')}
          </select>
        </div>` : `<div class="camp-card-title">${label}</div>`;
      card.innerHTML = `
        <div class="camp-card-top">
          <span class="camp-card-kicker">시즌</span>
          <span class="camp-card-badge">선택됨</span>
        </div>
        ${navHtml}
        <div class="camp-card-stats">
          <div class="camp-card-stat">
            <div class="camp-card-stat-val" id="card-all-reg">—</div>
            <div class="camp-card-stat-lbl">신청</div>
          </div>
          <div class="camp-card-sep"></div>
          <div class="camp-card-stat">
            <div class="camp-card-stat-val green" id="card-all-cap">—</div>
            <div class="camp-card-stat-lbl">잔여</div>
          </div>
        </div>`;
      card.onclick = () => selectCamp('all');
      return card;
    }

    function buildCampCards() {
      const wrap = document.getElementById('campCards');
      wrap.innerHTML = '';
      wrap.appendChild(makeSeasonCard());
      const currentSeasonGroups = SEASONS.find(s => s.id === activeSeason)?.groups || [];
      currentSeasonGroups.forEach(group => group.camps.forEach(c => {
        wrap.appendChild(makeCard(c.id, `${group.label} · 정원 ${c.capacity}명`, c.title, c.capacity));
      }));
    }

    function updateCardStats() {
      // 시즌 카드 (all): 현재 시즌 전체 통계
      const ids = seasonCampIds(activeSeason);
      const seasonCamps = CAMP_GROUPS.flatMap(g => g.camps).filter(c => ids.has(c.id));
      const seasonCap = seasonCamps.reduce((s, c) => s + c.capacity, 0);
      const seasonRegs = allRegs.filter(r => ids.has(r.campId) && r.registrationType !== 'staff');
      const seasonTotal = seasonRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const seasonRemain = Math.max(0, seasonCap - seasonTotal);
      const allRegEl = document.getElementById('card-all-reg');
      const allCapEl = document.getElementById('card-all-cap');
      if (allRegEl) allRegEl.textContent = seasonTotal;
      if (allCapEl) allCapEl.textContent = seasonRemain;

      // 개별 캠프 카드
      CAMP_GROUPS.flatMap(g => g.camps).forEach(c => {
        const regs = allRegs.filter(r => r.campId === c.id && r.registrationType !== 'staff');
        const total = regs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
        const remain = Math.max(0, c.capacity - total);
        const regEl = document.getElementById(`card-${c.id}-reg`);
        const capEl = document.getElementById(`card-${c.id}-cap`);
        if (regEl) regEl.textContent = total;
        if (capEl) capEl.textContent = remain;
      });
    }

    function selectCamp(id) {
      activeCamp = id;
      document.querySelectorAll('.camp-card').forEach(c =>
        c.classList.toggle('active', c.dataset.id === id)
      );
      renderTable();
      renderDash();
    }

    buildCampCards();

    // ── Fetch ──
    async function loadRegs() {
      try {
        const res = await fetch('/api/admin/registrations', { headers: authHeaders() });
        if (res.status === 401) {
          sessionStorage.removeItem('wolko-admin-token');
          location.reload();
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        allRegs = data.registrations || [];
        updateCardStats();
        renderTable();
        renderDash();
      } catch (e) {
        showToast('데이터를 불러오지 못했습니다: ' + e.message, 'error');
        const errHtml = `<div class="state-box"><svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" stroke="#c42a36" stroke-width="2"/><path d="M20 12v10M20 26v2" stroke="#c42a36" stroke-width="2" stroke-linecap="round"/></svg><p>데이터를 불러오지 못했습니다.<br>잠시 후 다시 시도해주세요.</p></div>`;
        document.getElementById('campRegBody').innerHTML  = `<tr><td colspan="6">${errHtml}</td></tr>`;
        document.getElementById('staffRegBody').innerHTML = `<tr><td colspan="3">${errHtml}</td></tr>`;
      }
    }

    function seasonCampIds(seasonId) {
      const season = SEASONS.find(s => s.id === seasonId);
      if (!season) return new Set();
      return new Set(season.groups.flatMap(g => g.camps.map(c => c.id)));
    }

    function filteredRegs() {
      let regs = allRegs;
      // 시즌 필터
      if (activeSeason !== 'all') {
        const ids = seasonCampIds(activeSeason);
        regs = regs.filter(r => ids.has(r.campId));
      }
      // 캠프 필터
      if (activeCamp !== 'all') regs = regs.filter(r => r.campId === activeCamp);
      return regs;
    }

    function sortValue(reg, key) {
      if (key === 'camp') return CAMP_LABELS[reg.campId] || reg.campId || '';
      if (key === 'type') return reg.registrationType === 'group' ? '단체' : '개인';
      if (key === 'status') { const s = reg.status || (reg.confirmed !== false ? 'confirmed' : 'pending'); return s === 'confirmed' ? '최종확정' : s === 'deposit' ? '예약금확인' : '대기중'; }
      if (key === 'grade') return reg.registrationType === 'group' ? (reg.groupCount || 0) : (reg.grade || '');
      if (key === 'gender') {
        if (reg.registrationType === 'group') return `${reg.maleCount || 0}-${reg.femaleCount || 0}`;
        return reg.gender || '';
      }
      if (key === 'registeredAt') return new Date(reg.registeredAt || 0).getTime();
      return String(reg[key] || '').trim();
    }

    function sortedRegs(regs) {
      const { key, direction } = sortState;
      const dir = direction === 'asc' ? 1 : -1;
      return [...regs].sort((a, b) => {
        const av = sortValue(a, key);
        const bv = sortValue(b, key);
        if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * dir;
        return String(av).localeCompare(String(bv), ['ko', 'en'], { numeric: true, sensitivity: 'base' }) * dir;
      });
    }

    function updateSortButtons() {
      document.querySelectorAll('.sort-btn').forEach(btn => {
        const active = btn.dataset.sort === sortState.key;
        btn.classList.toggle('active', active);
        btn.dataset.direction = active ? sortState.direction : '';
        btn.setAttribute('aria-sort', active ? (sortState.direction === 'asc' ? 'ascending' : 'descending') : 'none');
      });
    }

    document.querySelectorAll('.sort-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort;
        sortState = {
          key,
          direction: sortState.key === key && sortState.direction === 'asc' ? 'desc' : 'asc',
        };
        renderTable();
      });
    });

    // ── Dashboard ──
    function renderDash() {
      const regs = filteredRegs();
      // activeCamp === 'all' 이면 현재 시즌 전체 캠프 정원 합산
      const cap = activeCamp === 'all'
        ? CAMP_GROUPS.flatMap(g => g.camps)
            .filter(c => seasonCampIds(activeSeason).has(c.id))
            .reduce((s, c) => s + c.capacity, 0) || 80
        : (CAMP_CAP[activeCamp] || 40);

      // 스태프 신청은 정원 집계에서 제외
      const campRegs = regs.filter(r => r.registrationType !== 'staff');

      // 확정/미확정 분리 — deposit 또는 confirmed = KV 카운트 반영된 것
      const confirmedRegs = campRegs.filter(r => r.status === 'deposit' || r.status === 'confirmed' || (r.status === undefined && r.confirmed !== false));
      const pendingRegs   = campRegs.filter(r => !(r.status === 'deposit' || r.status === 'confirmed' || (r.status === undefined && r.confirmed !== false)));

      const total     = campRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const confirmed = confirmedRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const pending   = pendingRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const remain    = Math.max(0, cap - confirmed);
      const pct       = cap > 0 ? Math.round((confirmed / cap) * 100) : 0;

      // 성별 (확정 기준)
      const maleTotal = confirmedRegs.reduce((s, r) =>
        r.registrationType === 'group' ? s + (r.maleCount || 0) : s + (r.gender === 'male' ? 1 : 0), 0);
      const femaleTotal = confirmedRegs.reduce((s, r) =>
        r.registrationType === 'group' ? s + (r.femaleCount || 0) : s + (r.gender === 'female' ? 1 : 0), 0);

      const waitlistRegs = campRegs.filter(r => r.isWaitlist === true);
      const waitlistCount = waitlistRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);

      const staffRegs = regs.filter(r => r.registrationType === 'staff');
      const staffCount = staffRegs.length;

      document.getElementById('dTotal').textContent = total;
      document.getElementById('dTotalSub').textContent = `명 · 확정 ${confirmed} · 미확정 ${pending}`;
      document.getElementById('dWaitlist').textContent = waitlistCount;
      document.getElementById('dWaitlistSub').textContent = waitlistCount > 0 ? `명 예비 대기` : '없음';
      document.getElementById('dStaff').textContent = staffCount;
      document.getElementById('dStaffSub').textContent = staffCount > 0 ? `명 지원` : '없음';
      document.getElementById('dRemain').textContent = remain;
      document.getElementById('dRemainSub').textContent = `정원 ${cap}명 기준`;

      const campName = CAMP_LABELS[activeCamp] || '전체';
      document.getElementById('progressLabel').textContent = campName + ' 정원 현황 (확정 기준)';
      document.getElementById('progressPct').textContent = pct + '%';

      const fillM = document.getElementById('progressFillM');
      const fillF = document.getElementById('progressFillF');
      if (maleTotal > 0 || femaleTotal > 0) {
        fillM.style.width = Math.min((maleTotal / cap) * 100, 100) + '%';
        fillF.style.width = Math.min((femaleTotal / cap) * 100, 100) + '%';
      } else if (confirmed > 0) {
        fillM.style.width = Math.min((confirmed / cap) * 100, 100) + '%';
        fillF.style.width = '0%';
      } else {
        fillM.style.width = '0%';
        fillF.style.width = '0%';
      }

      document.getElementById('progressGenderM').textContent = maleTotal > 0 ? `남 ${maleTotal}명` : '';
      document.getElementById('progressGenderF').textContent = femaleTotal > 0 ? `여 ${femaleTotal}명` : '';
    }

    // ── Tables ──
    function renderTable() {
      updateSortButtons();
      renderCampTable();
      renderStaffTable();
    }

    function renderCampTable() {
      const regs = sortedRegs(filteredRegs().filter(r => r.registrationType !== 'staff'));
      const tbody = document.getElementById('campRegBody');
      document.getElementById('campTableCount').textContent = `(${regs.length}건)`;

      if (regs.length === 0) {
        tbody.innerHTML = `
          <tr><td colspan="6">
            <div class="state-box">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                <rect x="8" y="6" width="24" height="30" rx="3" stroke="#8fa8b5" stroke-width="2"/>
                <path d="M14 14h12M14 20h8M14 26h6" stroke="#8fa8b5" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <p>캠프 신청 내역이 없습니다.</p>
            </div>
          </td></tr>`;
        return;
      }

      tbody.innerHTML = regs.map((r, i) => {
        const date = new Date(r.registeredAt);
        const dateStr = `${date.getFullYear()}.${String(date.getMonth()+1).padStart(2,'0')}.${String(date.getDate()).padStart(2,'0')} ${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`;
        const campLabel = CAMP_LABELS[r.campId] || r.campId;
        const typeBadge = r.registrationType === 'staff'
          ? `<span class="badge" style="background:rgba(13,148,136,0.12);color:#0d9488;">스태프</span>`
          : r.registrationType === 'group'
          ? `<span class="badge badge-group">단체</span>`
          : `<span class="badge badge-individual">개인</span>`;
        const gradeOrCount = r.registrationType === 'group' ? `${r.groupCount}명` : (r.grade || '—');

        let genderCell;
        if (r.registrationType === 'group') {
          const m = r.maleCount || 0, f = r.femaleCount || 0;
          genderCell = (m > 0 || f > 0)
            ? `<span style="font-size:12px;white-space:nowrap"><span style="color:#3b82f6;font-weight:600">남 ${m}</span> · <span style="color:#ec4899;font-weight:600">여 ${f}</span></span>`
            : `<span style="color:var(--light)">—</span>`;
        } else {
          genderCell = r.gender === 'male'
            ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(59,130,246,0.12);color:#2563eb;font-size:11px;font-weight:700;">남</span>`
            : r.gender === 'female'
            ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(236,72,153,0.12);color:#db2777;font-size:11px;font-weight:700;">여</span>`
            : `<span style="color:var(--light)">—</span>`;
        }

        // 상태 셀: 3단계 (대기중 → 예약금수납 → 최종확정)
        const regStatus = r.status || (r.confirmed !== false ? 'confirmed' : 'pending');
        const waitlistBadge = r.isWaitlist
          ? `<span style="display:inline-block;padding:2px 7px;border-radius:100px;background:rgba(217,119,6,0.15);color:#b45309;font-size:10px;font-weight:700;margin-left:3px;">예비${r.waitlistNumber ? ' ' + r.waitlistNumber : ''}</span>`
          : '';
        let statusCell;
        if (regStatus === 'confirmed') {
          statusCell = `<span style="display:inline-flex;align-items:center;gap:2px;"><span style="display:inline-block;padding:2px 8px;border-radius:100px;background:rgba(22,163,74,0.12);color:#16a34a;font-size:11px;font-weight:700;">최종확정</span>${waitlistBadge}</span>`;
        } else if (regStatus === 'deposit') {
          statusCell = `<span style="display:inline-flex;align-items:center;gap:4px;flex-wrap:nowrap;white-space:nowrap;">
            <span style="display:inline-flex;align-items:center;gap:2px;"><span style="display:inline-block;padding:2px 8px;border-radius:100px;background:rgba(59,130,246,0.12);color:#2563eb;font-size:11px;font-weight:700;">예약금확인</span>${waitlistBadge}</span>
            <button class="btn-confirm" onclick="confirmReg('${r.regId}','${r.campId}')">최종확정</button>
          </span>`;
        } else {
          statusCell = `<span style="display:inline-flex;align-items:center;gap:4px;flex-wrap:nowrap;white-space:nowrap;">
            <span style="display:inline-flex;align-items:center;gap:2px;"><span style="display:inline-block;padding:2px 8px;border-radius:100px;background:rgba(217,119,6,0.12);color:#d97706;font-size:11px;font-weight:700;">대기중</span>${waitlistBadge}</span>
            <button class="btn-confirm btn-deposit" onclick="depositReg('${r.regId}','${r.campId}')">예약금수납</button>
          </span>`;
        }
        const campStyle = getCampRowStyle(r);
        const spiritualClass = r.dedicated ? ' is-dedicated' : r.saved ? ' is-saved' : '';
        const rowClass = `camp-tint${regStatus === 'confirmed' ? '' : ' is-pending'}${spiritualClass}`;
        const rowStyle = `--camp-row-bg:${campStyle.bg};--camp-row-border:${campStyle.border};`;
        const counselorStaff = allRegs
          .filter(staff => staff.registrationType === 'staff'
            && staff.campId === r.campId
            && String(staff.serviceArea || staff.notes || '').split(',').map(team => team.trim()).includes('상담자'))
          .sort((a, b) => String(a.name || '').localeCompare(String(b.name || ''), 'ko'));
        const staffOptions = counselorStaff
          .map(staff => `<option value="${esc(staff.regId)}"${staff.regId === r.counselorRegId ? ' selected' : ''}>${esc(staff.name)}</option>`)
          .join('');
        const counselorCell = r.registrationType === 'group'
          ? '<span class="camper-na">—</span>'
          : `<select class="camper-select" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-field="counselorRegId" onchange="updateField(this)">
              <option value="">미배정</option>
              ${staffOptions}
            </select>`;
        const salvationCell = r.registrationType === 'group'
          ? '<span class="camper-na">—</span>'
          : `<label class="spiritual-check spiritual-check-saved"><input type="checkbox" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-field="saved" onchange="updateField(this)"${r.saved ? ' checked' : ''}><span>구원</span></label>`;
        const dedicationCell = r.registrationType === 'group'
          ? '<span class="camper-na">—</span>'
          : `<label class="spiritual-check spiritual-check-dedicated"><input type="checkbox" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-field="dedicated" onchange="updateField(this)"${r.dedicated ? ' checked' : ''}><span>헌신</span></label>`;
        const spiritualStatusCell = r.registrationType === 'group'
          ? '<span class="camper-na">—</span>'
          : `<span class="spiritual-inline">${salvationCell}${dedicationCell}</span>`;
        const counselorMemoCell = r.registrationType === 'group'
          ? '<span class="camper-na">—</span>'
          : camperEditMode
          ? `<textarea class="counselor-memo-input" placeholder="특이사항 | 기도제목" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-field="counselorMemo" onblur="updateField(this)">${esc(r.counselorMemo || '')}</textarea>`
          : `<span class="${r.counselorMemo ? 'counselor-memo-readonly' : 'group-participant-empty'}" title="${esc(r.counselorMemo || '')}">${esc(r.counselorMemo || '—')}</span>`;
        const detailKey = `camp:${r.regId}`;
        const isDetailExpanded = expandedRegistrationRows.has(detailKey);
        const detailButton = `<button class="row-toggle-btn${isDetailExpanded ? ' is-open' : ''}" type="button" aria-expanded="${isDetailExpanded}" aria-label="${isDetailExpanded ? '상세 닫기' : '상세 보기'}" onclick="toggleRegistrationDetail('camp','${esc(r.regId)}')">
          <span class="row-toggle-mark" aria-hidden="true">
            <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
          <span class="row-toggle-text">${isDetailExpanded ? '닫기' : '상세'}</span>
        </button>`;
        const campDetailRow = isDetailExpanded
          ? `<tr class="registration-detail-row camp-detail-row" style="${rowStyle}">
              <td colspan="6">
                <div class="registration-detail-panel">
                  <div class="registration-detail-head">
                    <strong>신청 상세</strong>
                    <span>${esc(r.name)} · ${esc(campLabel)}</span>
                  </div>
                  <div class="registration-detail-section">
                    <div class="registration-detail-section-title">기본 정보</div>
                    <div class="registration-detail-grid">
                      <span class="registration-detail-item"><span class="registration-detail-label">상태</span><span class="registration-detail-value">${statusCell}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">유형</span><span class="registration-detail-value">${typeBadge}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">이름</span><span class="registration-detail-value">${esc(r.name)}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">캠프</span><span class="registration-detail-value">${esc(campLabel)}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">담당 카운슬러</span><span class="registration-detail-value">${counselorCell}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">학년 / 인원</span><span class="registration-detail-value">${esc(gradeOrCount)}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">성별</span><span class="registration-detail-value">${genderCell}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">영적 상태</span><span class="registration-detail-value">${spiritualStatusCell}</span></span>
                    </div>
                  </div>
                  <div class="registration-detail-section">
                    <div class="registration-detail-section-title">연락 및 메모</div>
                    <div class="registration-detail-grid">
                      <span class="registration-detail-item"><span class="registration-detail-label">연락처</span><span class="registration-detail-value">${esc(r.phone || '—')}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">이메일</span><span class="registration-detail-value">${esc(r.email || '—')}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">교회</span><span class="registration-detail-value">${esc(r.church || '—')}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">학교</span><span class="registration-detail-value">${esc(r.school || '—')}</span></span>
                      <span class="registration-detail-item"><span class="registration-detail-label">비상연락처</span><span class="registration-detail-value">${esc(r.emergency || '—')}</span></span>
                      <span class="registration-detail-item registration-detail-wide"><span class="registration-detail-label">신청일</span><span class="registration-detail-value">${dateStr}</span></span>
                      <span class="registration-detail-item registration-detail-wide"><span class="registration-detail-label">상담자 메모</span><span class="registration-detail-value">${counselorMemoCell}</span></span>
                      <span class="registration-detail-item registration-detail-wide"><span class="registration-detail-label">신청 메모</span><span class="registration-detail-value">${esc(r.notes || '—')}</span></span>
