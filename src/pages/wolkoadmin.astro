    const CUSTOM_TEAM_CLASSES = ['team-c1','team-c2','team-c3','team-c4','team-c5'];

    // ── 사용자 정의 팀 ──
    function getCustomTeams() {
      return teamOverviewConfig.customTeams || [];
    }
    function saveCustomTeamsStore(list) {
      teamOverviewConfig.customTeams = Array.isArray(list) ? list : [];
      queueTeamOverviewSave();
    }
    function getAllTeams() { return [...STAFF_TEAMS, ...getCustomTeams()]; }
    function addCustomTeamAction() {
      const inp = document.getElementById('newTeamNameInput');
      if (!inp) return;
      const name = inp.value.trim();
      if (!name) { inp.focus(); return; }
      const list = getCustomTeams();
      if (getAllTeams().includes(name)) { inp.select(); return; }
      list.push(name);
      saveCustomTeamsStore(list);
      inp.value = '';
      renderCampTeamPanel();
      renderStaffTable(); // 스태프 테이블 팀 에디터 연동
    }
    function removeCustomTeamAction(name) {
      saveCustomTeamsStore(getCustomTeams().filter(t_ => t_ !== name));
      renderCampTeamPanel();
      renderStaffTable();
    }

    function normalizeStaffTeam(team) {
      return team === '수업' ? '티칭' : team;
    }

    function getStaffTeamClass(team) {
      if (STAFF_TEAM_CLASSES[team]) return STAFF_TEAM_CLASSES[team];
      const ci = getCustomTeams().indexOf(team);
      if (ci !== -1) return CUSTOM_TEAM_CLASSES[ci % CUSTOM_TEAM_CLASSES.length];
      return 'team-other';
    }

    function staffTeams(reg) {
      return String(reg.serviceArea || '').split(',').map(team => normalizeStaffTeam(team.trim())).filter(Boolean);
    }

    const TEAM_PANEL_CAMPS = new Set(['2026-inland-english-junior', '2026-inland-union']);
    const WOLKO_CAMP_ROSTER = [
