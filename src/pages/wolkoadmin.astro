          : `<tr class="${rowClass} registration-summary-row" style="${rowStyle}" onclick="toggleRegistrationDetail('camp','${esc(r.regId)}',event)">
              <td><span class="registration-status-cell">${detailButton}<span class="registration-status-content">${statusCell}</span></span></td>
