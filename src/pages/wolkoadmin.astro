    // 표시용 이름 (기혼자는 "남편 · 아내")
    function memberDisplayName(m) {
      return m.spouseName ? `${m.name} · ${m.spouseName}` : m.name;
    }

    let allRegs = [];
    let activeCamp = 'all';
    let activeSeason = SEASONS[SEASONS.length - 1].id; // 최신 시즌 기본 선택
    let sortState = { key: 'registeredAt', direction: 'desc' };
    let activeTeamFilter = 'all';
    let authToken = sessionStorage.getItem('wolko-admin-token') || '';
    let staffEditMode = false;
    let camperEditMode = false;
    let teamPanelEditMode = false;
    let activeStatPanel = null; // 'leaders' | 'members' | 'staff' | null
    const expandedGroupParticipants = new Set();
    const UNASSIGNED = '__unassigned__';
    let teamOverviewConfig = emptyTeamOverviewConfig();
    let teamOverviewConfigCamp = null;
    let teamOverviewLoadPromise = null;
    let teamOverviewLoadingCamp = null;
    let teamOverviewSaveTimer = null;

    function emptyTeamOverviewConfig() {
      return {
        customTeams: [],
        personRoles: {},
        personTeams: {},
        campExclude: [],
        campRoles: {},
        customMembers: [],
      };
    }

    function normalizeTeamOverviewConfig(config) {
      const source = config && typeof config === 'object' && !Array.isArray(config) ? config : {};
      return {
        customTeams: normalizeTeamList(source.customTeams),
        personRoles: normalizePersonRoleMap(source.personRoles),
        personTeams: normalizePersonTeamMap(source.personTeams),
        campExclude: Array.isArray(source.campExclude) ? source.campExclude : [],
        campRoles: source.campRoles && typeof source.campRoles === 'object' && !Array.isArray(source.campRoles) ? source.campRoles : {},
        customMembers: normalizeCustomMembers(source.customMembers),
      };
    }

    function normalizeTeamName(team) {
      return normalizeStaffTeam(String(team || '').trim());
    }

    function normalizeTeamList(list) {
      if (!Array.isArray(list)) return [];
      return [...new Set(list.map(normalizeTeamName).filter(Boolean))];
    }

    function normalizePersonTeamMap(map) {
      if (!map || typeof map !== 'object' || Array.isArray(map)) return {};
      return Object.fromEntries(Object.entries(map).map(([name, teams]) => [name, normalizeTeamList(teams)]));
    }

    function normalizePersonRoleMap(map) {
      if (!map || typeof map !== 'object' || Array.isArray(map)) return {};
      const next = {};
      Object.entries(map).forEach(([key, role]) => {
        const sep = key.indexOf('\x00');
        if (sep === -1) {
          next[key] = role;
          return;
        }
        const name = key.slice(0, sep);
        const team = normalizeTeamName(key.slice(sep + 1));
        if (name && team) next[`${name}\x00${team}`] = role;
      });
      return next;
    }

    function normalizeCustomMembers(list) {
      if (!Array.isArray(list)) return [];
      return list.map(member => {
        if (!member || typeof member !== 'object') return member;
        return { ...member, teams: normalizeTeamList(member.teams) };
      }).filter(Boolean);
    }

    function mergeTeamOverviewConfig(serverConfig, localConfig) {
      const server = normalizeTeamOverviewConfig(serverConfig);
      const local = normalizeTeamOverviewConfig(localConfig);
      const personTeams = { ...server.personTeams };
      Object.entries(local.personTeams).forEach(([name, localTeams]) => {
        if (!Array.isArray(personTeams[name]) || personTeams[name].length === 0) {
          personTeams[name] = localTeams;
        }
      });
      return normalizeTeamOverviewConfig({
        customTeams: [...server.customTeams, ...local.customTeams],
        personRoles: { ...local.personRoles, ...server.personRoles },
        personTeams,
        campExclude: [...server.campExclude, ...local.campExclude],
        campRoles: { ...local.campRoles, ...server.campRoles },
        customMembers: server.customMembers.length ? server.customMembers : local.customMembers,
      });
    }

    function sameTeamOverviewConfig(a, b) {
      return JSON.stringify(normalizeTeamOverviewConfig(a)) === JSON.stringify(normalizeTeamOverviewConfig(b));
    }

    function hasTeamOverviewData(config) {
      const c = normalizeTeamOverviewConfig(config);
      return c.customTeams.length > 0
        || Object.keys(c.personRoles).length > 0
        || Object.keys(c.personTeams).length > 0
        || c.campExclude.length > 0
        || Object.keys(c.campRoles).length > 0
        || c.customMembers.length > 0;
    }

    function readJsonStore(key, fallback) {
      try {
        const value = localStorage.getItem(key);
        return value ? JSON.parse(value) : fallback;
      } catch {
        return fallback;
      }
    }

    function getLocalTeamOverviewConfig(campId) {
      return normalizeTeamOverviewConfig({
        customTeams: readJsonStore('wolkoCustomTeams', []),
        personRoles: readJsonStore(`wolkoTeamRoles_${campId}`, {}),
        personTeams: readJsonStore(`wolkoTeamAssign_${campId}`, {}),
        campExclude: readJsonStore(`wolkoCampExclude_${campId}`, []),
        campRoles: readJsonStore(`wolkoCampRoles_${campId}`, {}),
        customMembers: readJsonStore(`wolkoCustomMembers_${campId}`, []),
      });
    }

    async function loadTeamOverviewConfig(campId) {
      if (!TEAM_PANEL_CAMPS.has(campId)) {
        teamOverviewConfig = emptyTeamOverviewConfig();
        teamOverviewConfigCamp = null;
        return;
      }
      if (teamOverviewConfigCamp === campId) return;
      if (teamOverviewLoadPromise && teamOverviewLoadingCamp === campId) return teamOverviewLoadPromise;

      teamOverviewLoadingCamp = campId;
      teamOverviewLoadPromise = (async () => {
        const localConfig = getLocalTeamOverviewConfig(campId);
        try {
          const res = await fetch(`/api/admin/team-overview?campId=${encodeURIComponent(campId)}`, {
            headers: authHeaders(),
          });
          if (res.status === 401) {
            sessionStorage.removeItem('wolko-admin-token');
            location.reload();
            return;
          }
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const data = await res.json();
          const serverConfig = normalizeTeamOverviewConfig(data.config);
          const mergedConfig = hasTeamOverviewData(localConfig)
            ? mergeTeamOverviewConfig(serverConfig, localConfig)
            : serverConfig;
          teamOverviewConfig = hasTeamOverviewData(mergedConfig) ? mergedConfig : localConfig;
          teamOverviewConfigCamp = campId;
          if (hasTeamOverviewData(teamOverviewConfig) && !sameTeamOverviewConfig(teamOverviewConfig, serverConfig)) {
            await saveTeamOverviewConfig(true);
          }
        } catch (e) {
          teamOverviewConfig = localConfig;
          teamOverviewConfigCamp = campId;
          if (hasTeamOverviewData(localConfig)) {
            showToast(t('teamOverviewSyncErr') + e.message, 'error');
          }
        } finally {
          teamOverviewLoadPromise = null;
          teamOverviewLoadingCamp = null;
        }
      })();
      return teamOverviewLoadPromise;
    }

    function queueTeamOverviewSave() {
      if (!TEAM_PANEL_CAMPS.has(activeCamp)) return;
      clearTimeout(teamOverviewSaveTimer);
      teamOverviewSaveTimer = setTimeout(() => {
        saveTeamOverviewConfig().catch(e => {
          showToast(t('teamOverviewSaveErr') + e.message, 'error');
        });
      }, 250);
    }

    async function saveTeamOverviewConfig(silent = false) {
      const campId = teamOverviewConfigCamp || activeCamp;
      if (!TEAM_PANEL_CAMPS.has(campId)) return;
      const config = normalizeTeamOverviewConfig(teamOverviewConfig);
      const res = await fetch('/api/admin/team-overview', {
        method: 'PUT',
        headers: authHeaders(),
        body: JSON.stringify({ campId, config }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(data.error || `HTTP ${res.status}`);
      teamOverviewConfig = normalizeTeamOverviewConfig(data.config || config);
      teamOverviewConfigCamp = campId;
    }

    // ── Login ──
    function togglePw() {
      const input = document.getElementById('pwInput');
      const icon = document.getElementById('eyeIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = `<path d="M2 2l14 14M7.5 7.6A2.5 2.5 0 0011.4 11.5M5.2 5.3C3.3 6.5 1.9 7.9 1 9c1.5 3.5 4.5 6 8 6 1.4 0 2.8-.4 4-1M9 3C12.5 3 15.5 5.5 17 9c-.5 1.1-1.2 2.1-2 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`;
      } else {
        input.type = 'password';
        icon.innerHTML = `<path d="M1 9C2.5 5.5 5.5 3 9 3s6.5 2.5 8 6c-1.5 3.5-4.5 6-8 6S2.5 12.5 1 9z" stroke="currentColor" stroke-width="1.5"/><circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>`;
      }
    }

    document.getElementById('pwInput').addEventListener('keydown', e => {
      if (e.key === 'Enter') doLogin();
    });

    async function doLogin() {
      const pw = document.getElementById('pwInput').value;
      const btn = document.getElementById('loginBtn');
      const errEl = document.getElementById('loginError');
      const inputEl = document.getElementById('pwInput');
      if (!pw) { errEl.textContent = t('loginRequired'); return; }

      btn.disabled = true;
      btn.textContent = t('loginVerifying');
      errEl.textContent = '';
      inputEl.classList.remove('error');

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pw }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('loginWrong'));

        authToken = data.token;
        sessionStorage.setItem('wolko-admin-token', authToken);

        const screen = document.getElementById('loginScreen');
        screen.classList.add('hidden');
        setTimeout(() => screen.style.display = 'none', 400);
        applyLangToDOM();
        loadRegs();
      } catch (e) {
        errEl.textContent = e.message;
        inputEl.classList.add('error');
      } finally {
        btn.disabled = false;
        btn.textContent = t('loginBtn');
      }
    }

    function doLogout() {
      sessionStorage.removeItem('wolko-admin-token');
      authToken = '';
      location.reload();
    }

    function authHeaders() {
      return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${authToken}` };
    }

    // ── Camp cards ──
    function makeCard(id, kicker, title, capacity) {
      const campStyle = CAMP_ROW_STYLES[id] || CAMP_ROW_FALLBACK;
      const card = document.createElement('div');
      card.className = 'camp-card' + (id === 'all' ? ' active' : '');
      card.dataset.id = id;
      card.style.setProperty('--card-camp-bg', campStyle.bg);
      card.style.setProperty('--card-camp-border', campStyle.border);
      card.innerHTML = `
        <div class="camp-card-top">
          <span class="camp-card-kicker">${kicker}</span>
          <span class="camp-card-badge">${t('selected')}</span>
        </div>
        <div class="camp-card-title">${title}</div>
        <div class="camp-card-stats">
          <div class="camp-card-stat">
            <div class="camp-card-stat-val" id="card-${id}-reg">—</div>
            <div class="camp-card-stat-lbl">${t('applicationShort')}</div>
          </div>
          <div class="camp-card-sep"></div>
          <div class="camp-card-stat">
            <div class="camp-card-stat-val green" id="card-${id}-cap">—</div>
            <div class="camp-card-stat-lbl">${t('remainingShort')}</div>
          </div>
        </div>
      `;
      card.onclick = () => selectCamp(id);
      return card;
    }

    function selectSeason(id) {
      activeSeason = id;
      activeCamp = 'all';
      loadTeamOverviewConfig(activeCamp);
      buildCampCards();
      renderTable();
      renderDash();
    }

    function navigateSeason(dir) {
      const idx = SEASONS.findIndex(s => s.id === activeSeason);
      const next = idx + dir;
      if (next >= 0 && next < SEASONS.length) selectSeason(SEASONS[next].id);
    }

    function makeSeasonCard() {
      const card = document.createElement('div');
      card.className = 'camp-card camp-season-card active';
      card.dataset.id = 'all';
      const season = SEASONS.find(s => s.id === activeSeason);
      const label = seasonDisplayName(season);
      const idx = SEASONS.findIndex(s => s.id === activeSeason);
      const hasPrev = idx > 0;
      const hasNext = idx < SEASONS.length - 1;
      const navHtml = SEASONS.length > 1 ? `
        <div class="season-card-nav">
          <select class="season-select" onclick="event.stopPropagation()" onchange="event.stopPropagation();selectSeason(this.value)">
            ${SEASONS.map(s => `<option value="${s.id}"${s.id === activeSeason ? ' selected' : ''}>${seasonDisplayName(s)}</option>`).join('')}
          </select>
        </div>` : `<div class="camp-card-title">${label}</div>`;
      card.innerHTML = `
        <div class="camp-card-top">
          <span class="camp-card-kicker">${t('season')}</span>
          <span class="camp-card-badge">${t('selected')}</span>
        </div>
        ${navHtml}
        <div class="camp-card-stats">
          <div class="camp-card-stat">
            <div class="camp-card-stat-val" id="card-all-reg">—</div>
            <div class="camp-card-stat-lbl">${t('applicationShort')}</div>
          </div>
          <div class="camp-card-sep"></div>
          <div class="camp-card-stat">
            <div class="camp-card-stat-val green" id="card-all-cap">—</div>
            <div class="camp-card-stat-lbl">${t('remainingShort')}</div>
          </div>
        </div>`;
      card.onclick = () => selectCamp('all');
      return card;
    }

    function buildCampCards() {
      const wrap = document.getElementById('campCards');
      wrap.innerHTML = '';
      wrap.appendChild(makeSeasonCard());
      const currentSeasonGroups = SEASONS.find(s => s.id === activeSeason)?.groups || [];
      currentSeasonGroups.forEach(group => group.camps.forEach(c => {
        wrap.appendChild(makeCard(c.id, `${campGroupDisplayName(group)} · ${tt('capacityFn', c.capacity)}`, campDisplayName(c.id), c.capacity));
      }));
    }

    function updateCardStats() {
      // 시즌 카드 (all): 현재 시즌 전체 통계
      const ids = seasonCampIds(activeSeason);
      const seasonCamps = CAMP_GROUPS.flatMap(g => g.camps).filter(c => ids.has(c.id));
      const seasonCap = seasonCamps.reduce((s, c) => s + c.capacity, 0);
      const seasonRegs = allRegs.filter(r => ids.has(r.campId) && r.registrationType !== 'staff');
      const seasonTotal = seasonRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const seasonRemain = Math.max(0, seasonCap - seasonTotal);
      const allRegEl = document.getElementById('card-all-reg');
      const allCapEl = document.getElementById('card-all-cap');
      if (allRegEl) allRegEl.textContent = seasonTotal;
      if (allCapEl) allCapEl.textContent = seasonRemain;

      // 개별 캠프 카드
      CAMP_GROUPS.flatMap(g => g.camps).forEach(c => {
        const regs = allRegs.filter(r => r.campId === c.id && r.registrationType !== 'staff');
        const total = regs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
        const remain = Math.max(0, c.capacity - total);
        const regEl = document.getElementById(`card-${c.id}-reg`);
        const capEl = document.getElementById(`card-${c.id}-cap`);
        if (regEl) regEl.textContent = total;
        if (capEl) capEl.textContent = remain;
      });
    }

    async function selectCamp(id) {
      activeCamp = id;
      document.querySelectorAll('.camp-card').forEach(c =>
        c.classList.toggle('active', c.dataset.id === id)
      );
      await loadTeamOverviewConfig(activeCamp);
      renderTable();
      renderDash();
    }

    buildCampCards();

    // ── Fetch ──
    async function loadRegs() {
      try {
        const res = await fetch('/api/admin/registrations', { headers: authHeaders() });
        if (res.status === 401) {
          sessionStorage.removeItem('wolko-admin-token');
          location.reload();
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        allRegs = data.registrations || [];
        await loadTeamOverviewConfig(activeCamp);
        updateCardStats();
        renderTable();
        renderDash();
      } catch (e) {
        showToast(t('dataLoadFail') + e.message, 'error');
        const errHtml = `<div class="state-box"><svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" stroke="#c42a36" stroke-width="2"/><path d="M20 12v10M20 26v2" stroke="#c42a36" stroke-width="2" stroke-linecap="round"/></svg><p>${t('dataLoadRetry')}</p></div>`;
        document.getElementById('campRegBody').innerHTML  = `<tr><td colspan="19">${errHtml}</td></tr>`;
        document.getElementById('staffRegBody').innerHTML = `<tr><td colspan="12">${errHtml}</td></tr>`;
      }
    }

    function seasonCampIds(seasonId) {
      const season = SEASONS.find(s => s.id === seasonId);
      if (!season) return new Set();
      return new Set(season.groups.flatMap(g => g.camps.map(c => c.id)));
    }

    function filteredRegs() {
      let regs = allRegs;
      // 시즌 필터
      if (activeSeason !== 'all') {
        const ids = seasonCampIds(activeSeason);
        regs = regs.filter(r => ids.has(r.campId));
      }
      // 캠프 필터
      if (activeCamp !== 'all') regs = regs.filter(r => r.campId === activeCamp);
      return regs;
    }

    function sortValue(reg, key) {
      if (key === 'camp') return campDisplayName(reg.campId);
      if (key === 'type') return reg.registrationType === 'group' ? '단체' : '개인';
      if (key === 'staffTeam') {
        const teams = staffTeams(reg);
        const primary = teams[0] || '';
        const teamOrder = STAFF_TEAMS.includes(primary) ? STAFF_TEAMS.indexOf(primary) : STAFF_TEAMS.length;
        return `${String(teamOrder).padStart(2, '0')}-${primary}-${reg.name || ''}`;
      }
      if (key === 'status') {
        const s = reg.status || (reg.confirmed === true ? 'confirmed' : 'pending');
        return s === 'confirmed' ? '3-confirmed' : s === 'deposit' ? '2-deposit' : '1-pending';
      }
      if (key === 'grade') return reg.registrationType === 'group' ? (reg.groupCount || 0) : (reg.grade || '');
      if (key === 'gender') {
        if (reg.registrationType === 'group') return `${reg.maleCount || 0}-${reg.femaleCount || 0}`;
        return reg.gender || '';
      }
      if (key === 'registeredAt') return new Date(reg.registeredAt || 0).getTime();
      return String(reg[key] || '').trim();
    }

    function sortedRegs(regs) {
      const { key, direction } = sortState;
      const dir = direction === 'asc' ? 1 : -1;
      return [...regs].sort((a, b) => {
        const av = sortValue(a, key);
        const bv = sortValue(b, key);
        if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * dir;
        return String(av).localeCompare(String(bv), ['ko', 'en'], { numeric: true, sensitivity: 'base' }) * dir;
      });
    }

    function updateSortButtons() {
      document.querySelectorAll('.sort-btn').forEach(btn => {
        const active = btn.dataset.sort === sortState.key;
        btn.classList.toggle('active', active);
        btn.dataset.direction = active ? sortState.direction : '';
        btn.setAttribute('aria-sort', active ? (sortState.direction === 'asc' ? 'ascending' : 'descending') : 'none');
      });
    }

    document.querySelectorAll('.sort-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort;
        sortState = {
          key,
          direction: sortState.key === key && sortState.direction === 'asc' ? 'desc' : 'asc',
        };
        renderTable();
      });
    });

    // ── Dashboard ──
    function renderDash() {
      const regs = filteredRegs();
      // activeCamp === 'all' 이면 현재 시즌 전체 캠프 정원 합산
      const cap = activeCamp === 'all'
        ? CAMP_GROUPS.flatMap(g => g.camps)
            .filter(c => seasonCampIds(activeSeason).has(c.id))
            .reduce((s, c) => s + c.capacity, 0) || 80
        : (CAMP_CAP[activeCamp] || 40);

      // 스태프 신청은 정원 집계에서 제외
      const campRegs = regs.filter(r => r.registrationType !== 'staff');

      // 잔금까지 확인된 최종확정 신청만 캠프 참여 인원으로 집계
      const confirmedRegs = campRegs.filter(r => r.status === 'confirmed' || (r.status === undefined && r.confirmed === true));
      const pendingRegs   = campRegs.filter(r => !(r.status === 'confirmed' || (r.status === undefined && r.confirmed === true)));

      const total     = campRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const confirmed = confirmedRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const pending   = pendingRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const remain    = Math.max(0, cap - confirmed);
      const pct       = cap > 0 ? Math.round((confirmed / cap) * 100) : 0;

      // 성별 (확정 기준)
      const maleTotal = confirmedRegs.reduce((s, r) =>
        r.registrationType === 'group' ? s + (r.maleCount || 0) : s + (r.gender === 'male' ? 1 : 0), 0);
      const femaleTotal = confirmedRegs.reduce((s, r) =>
        r.registrationType === 'group' ? s + (r.femaleCount || 0) : s + (r.gender === 'female' ? 1 : 0), 0);

      const waitlistRegs = campRegs.filter(r => r.isWaitlist === true);
      const waitlistCount = waitlistRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);

      const staffRegs = regs.filter(r => r.registrationType === 'staff');
      const staffCount = staffRegs.length;

      document.getElementById('dTotal').textContent = total;
      document.getElementById('dTotalSub').textContent = tt('dashboardTotalFn', confirmed, pending);
      document.getElementById('dWaitlist').textContent = waitlistCount;
      document.getElementById('dWaitlistSub').textContent = waitlistCount > 0 ? tt('waitlistCountFn', waitlistCount) : t('noData');
      document.getElementById('dStaff').textContent = staffCount;
      document.getElementById('dStaffSub').textContent = staffCount > 0 ? tt('staffCountFn2', staffCount) : t('noData');
      document.getElementById('dRemain').textContent = remain;
      document.getElementById('dRemainSub').textContent = tt('capacityBasisFn', cap);

      const campName = activeCamp === 'all' ? t('campAll') : campDisplayName(activeCamp);
      document.getElementById('progressLabel').textContent = tt('capacityProgressFn', campName);
      document.getElementById('progressPct').textContent = pct + '%';

      const fillM = document.getElementById('progressFillM');
      const fillF = document.getElementById('progressFillF');
      if (maleTotal > 0 || femaleTotal > 0) {
        fillM.style.width = Math.min((maleTotal / cap) * 100, 100) + '%';
        fillF.style.width = Math.min((femaleTotal / cap) * 100, 100) + '%';
      } else if (confirmed > 0) {
        fillM.style.width = Math.min((confirmed / cap) * 100, 100) + '%';
        fillF.style.width = '0%';
      } else {
        fillM.style.width = '0%';
        fillF.style.width = '0%';
      }

      document.getElementById('progressGenderM').textContent = maleTotal > 0 ? tt('maleCountFn', maleTotal) : '';
      document.getElementById('progressGenderF').textContent = femaleTotal > 0 ? tt('femaleCountFn', femaleTotal) : '';
    }

    // ── Tables ──
    function renderTable() {
      updateSortButtons();
      renderCampTable();
      renderCampTeamPanel();
      renderStaffTable();
    }

    function renderCampTable() {
      const regs = sortedRegs(filteredRegs().filter(r => r.registrationType !== 'staff'));
      const tbody = document.getElementById('campRegBody');
      document.getElementById('campTableCount').textContent = tt('tableCountFn', regs.length);

      if (regs.length === 0) {
        tbody.innerHTML = `
          <tr><td colspan="19">
            <div class="state-box">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                <rect x="8" y="6" width="24" height="30" rx="3" stroke="#8fa8b5" stroke-width="2"/>
                <path d="M14 14h12M14 20h8M14 26h6" stroke="#8fa8b5" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <p>${t('noCampRegs')}</p>
            </div>
          </td></tr>`;
        return;
      }

      tbody.innerHTML = regs.map((r, i) => {
        const date = new Date(r.registeredAt);
        const dateStr = `${date.getFullYear()}.${String(date.getMonth()+1).padStart(2,'0')}.${String(date.getDate()).padStart(2,'0')} ${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`;
        const campLabel = campDisplayName(r.campId);
        const typeBadge = r.registrationType === 'staff'
          ? `<span class="badge" style="background:rgba(13,148,136,0.12);color:#0d9488;">${t('staffBadge')}</span>`
          : r.registrationType === 'group'
          ? `<span class="badge badge-group">${t('groupBadge')}</span>`
          : `<span class="badge badge-individual">${t('individualBadge')}</span>`;
        const gradeOrCount = r.registrationType === 'group' ? tt('personCountFn', r.groupCount) : (r.grade || '—');

        let genderCell;
        if (r.registrationType === 'group') {
          const m = r.maleCount || 0, f = r.femaleCount || 0;
          genderCell = (m > 0 || f > 0)
            ? `<span style="font-size:12px;white-space:nowrap"><span style="color:#3b82f6;font-weight:600">${t('male')} ${m}</span> · <span style="color:#ec4899;font-weight:600">${t('female')} ${f}</span></span>`
            : `<span style="color:var(--light)">—</span>`;
        } else {
          genderCell = r.gender === 'male'
            ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(59,130,246,0.12);color:#2563eb;font-size:11px;font-weight:700;">${t('male')}</span>`
            : r.gender === 'female'
            ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(236,72,153,0.12);color:#db2777;font-size:11px;font-weight:700;">${t('female')}</span>`
            : `<span style="color:var(--light)">—</span>`;
        }

        // 상태 셀: 3단계 (대기중 → 예약금수납 → 최종확정)
        const regStatus = r.status || (r.confirmed === true ? 'confirmed' : 'pending');
        const waitlistBadge = r.isWaitlist
          ? `<span style="display:inline-block;padding:2px 7px;border-radius:100px;background:rgba(217,119,6,0.15);color:#b45309;font-size:10px;font-weight:700;margin-left:3px;">${tt('waitlistFn', r.waitlistNumber)}</span>`
          : '';
        let statusCell;
        if (regStatus === 'confirmed') {
          const revertBtn = camperEditMode
            ? `<button class="btn-revert" onclick="revertReg('${r.regId}','${r.campId}')" title="예약금확인 상태로 되돌리기"><svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg><span>예약금</span></button>`
            : '';
          statusCell = `<span style="display:inline-flex;align-items:center;gap:4px;flex-wrap:nowrap;white-space:nowrap;">
            <span style="display:inline-flex;align-items:center;gap:2px;"><span style="display:inline-block;padding:2px 8px;border-radius:100px;background:rgba(22,163,74,0.12);color:#16a34a;font-size:11px;font-weight:700;">${t('confirmed')}</span>${waitlistBadge}</span>
            ${revertBtn}
          </span>`;
        } else if (regStatus === 'deposit') {
          statusCell = `<span style="display:inline-flex;align-items:center;gap:4px;flex-wrap:nowrap;white-space:nowrap;">
            <span style="display:inline-flex;align-items:center;gap:2px;"><span style="display:inline-block;padding:2px 8px;border-radius:100px;background:rgba(59,130,246,0.12);color:#2563eb;font-size:11px;font-weight:700;">${t('depositConfirmed')}</span>${waitlistBadge}</span>
            <button class="btn-confirm" onclick="confirmReg('${r.regId}','${r.campId}')">${t('finalConfirmBtn')}</button>
          </span>`;
        } else {
          statusCell = `<span style="display:inline-flex;align-items:center;gap:4px;flex-wrap:nowrap;white-space:nowrap;">
            <span style="display:inline-flex;align-items:center;gap:2px;"><span style="display:inline-block;padding:2px 8px;border-radius:100px;background:rgba(217,119,6,0.12);color:#d97706;font-size:11px;font-weight:700;">${t('pending')}</span>${waitlistBadge}</span>
            <button class="btn-confirm btn-deposit" onclick="depositReg('${r.regId}','${r.campId}')">${t('depositBtn')}</button>
          </span>`;
        }
        const campStyle = getCampRowStyle(r);
        const spiritualClass = r.dedicated ? ' is-dedicated' : r.saved ? ' is-saved' : '';
        const rowClass = `camp-tint${regStatus === 'confirmed' ? '' : ' is-pending'}${spiritualClass}`;
        const rowStyle = `--camp-row-bg:${campStyle.bg};--camp-row-border:${campStyle.border};`;
        const counselorStaff = allRegs
          .filter(staff => staff.registrationType === 'staff'
            && staff.campId === r.campId
            && String(staff.serviceArea || staff.notes || '').split(',').map(team => team.trim()).includes('상담자'))
          .sort((a, b) => String(a.name || '').localeCompare(String(b.name || ''), 'ko'));
        const staffOptions = counselorStaff
          .map(staff => `<option value="${esc(staff.regId)}"${staff.regId === r.counselorRegId ? ' selected' : ''}>${esc(staff.name)}</option>`)
          .join('');
        const counselorCell = r.registrationType === 'group'
          ? '<span class="camper-na">—</span>'
          : `<select class="camper-select" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-field="counselorRegId" onchange="updateField(this)">
              <option value="">${t('unassignedShort')}</option>
              ${staffOptions}
            </select>`;
        const salvationCell = r.registrationType === 'group'
          ? '<span class="camper-na">—</span>'
          : `<label class="spiritual-check spiritual-check-saved"><input type="checkbox" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-field="saved" onchange="updateField(this)"${r.saved ? ' checked' : ''}><span>${t('savedLabel')}</span></label>`;
        const dedicationCell = r.registrationType === 'group'
          ? '<span class="camper-na">—</span>'
          : `<label class="spiritual-check spiritual-check-dedicated"><input type="checkbox" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-field="dedicated" onchange="updateField(this)"${r.dedicated ? ' checked' : ''}><span>${t('dedicatedLabel')}</span></label>`;
        const counselorMemoCell = r.registrationType === 'group'
          ? '<span class="camper-na">—</span>'
          : camperEditMode
          ? `<input class="edit-input edit-input-wide" type="text" value="${esc(r.counselorMemo || '')}" placeholder="${t('counselorMemoPh')}" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-field="counselorMemo" onblur="updateField(this)" onkeydown="if(event.key==='Enter')this.blur()">`
          : `<span class="${r.counselorMemo ? 'counselor-memo-readonly' : 'group-participant-empty'}" title="${esc(r.counselorMemo || '')}">${esc(r.counselorMemo || '—')}</span>`;
        const groupParticipants = r.registrationType === 'group'
          ? Array.from(
              { length: Math.max(Number(r.groupCount) || 0, Array.isArray(r.participants) ? r.participants.length : 0) },
              (_, participantIndex) => r.participants?.[participantIndex] || {}
            )
          : [];
        const participantRows = groupParticipants.length
          ? (() => {
            const isExpanded = expandedGroupParticipants.has(r.regId);
            const completedParticipants = groupParticipants.filter(participant =>
              participant.name && ['male', 'female'].includes(participant.gender)
            ).length;
            const toggleRow = `<tr class="group-participant-toggle-row">
              <td></td>
              <td colspan="18">
                <button class="group-participant-toggle${isExpanded ? ' expanded' : ''}" type="button" data-regid="${esc(r.regId)}" aria-expanded="${isExpanded}" onclick="toggleGroupParticipants(this.dataset.regid)">
                  <svg class="group-participant-toggle-icon" width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true"><path d="M2.5 4.5l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  <span>${tt('studentListFn', completedParticipants, groupParticipants.length, camperEditMode)}</span>
                </button>
              </td>
            </tr>`;
            if (!isExpanded) return toggleRow;
            return toggleRow + groupParticipants.map((participant, participantIndex) => {
              const participantClass = participant.dedicated ? ' is-dedicated' : participant.saved ? ' is-saved' : '';
              const participantName = camperEditMode
                ? `<input class="group-participant-input" type="text" value="${esc(participant.name || '')}" placeholder="${t('studentNamePh')}" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-participantindex="${participantIndex}" data-field="name" onblur="updateField(this)" onkeydown="if(event.key==='Enter')this.blur()">`
                : `<span class="${participant.name ? 'group-participant-readonly' : 'group-participant-empty'}">${esc(participant.name || t('notEntered'))}</span>`;
              const participantCounselor = camperEditMode
                ? `<select class="camper-select" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-participantindex="${participantIndex}" data-field="counselorRegId" onchange="updateField(this)">
                  <option value="">${t('unassignedShort')}</option>
                  ${counselorStaff
                    .map(staff => `<option value="${esc(staff.regId)}"${staff.regId === participant.counselorRegId ? ' selected' : ''}>${esc(staff.name)}</option>`)
                    .join('')}
                </select>`
                : `<span class="${participant.counselorRegId ? 'group-participant-readonly' : 'group-participant-empty'}">${esc(counselorStaff.find(staff => staff.regId === participant.counselorRegId)?.name || t('unassignedShort'))}</span>`;
              const participantSalvation = camperEditMode
                ? `<label class="spiritual-check spiritual-check-saved"><input type="checkbox" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-participantindex="${participantIndex}" data-field="saved" onchange="updateField(this)"${participant.saved ? ' checked' : ''}><span>${t('savedLabel')}</span></label>`
                : (participant.saved ? `<span class="group-participant-state saved">${t('savedLabel')}</span>` : '<span class="camper-na">—</span>');
              const participantDedication = camperEditMode
                ? `<label class="spiritual-check spiritual-check-dedicated"><input type="checkbox" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-participantindex="${participantIndex}" data-field="dedicated" onchange="updateField(this)"${participant.dedicated ? ' checked' : ''}><span>${t('dedicatedLabel')}</span></label>`
                : (participant.dedicated ? `<span class="group-participant-state dedicated">${t('dedicatedLabel')}</span>` : '<span class="camper-na">—</span>');
              const participantMemo = camperEditMode
                ? `<textarea class="counselor-memo-input" placeholder="${t('counselorMemoPh')}" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-participantindex="${participantIndex}" data-field="counselorMemo" onblur="updateField(this)">${esc(participant.counselorMemo || '')}</textarea>`
                : `<span class="${participant.counselorMemo ? 'counselor-memo-readonly' : 'group-participant-empty'}" title="${esc(participant.counselorMemo || '')}">${esc(participant.counselorMemo || '—')}</span>`;
              const participantGender = camperEditMode
                ? `<select class="group-participant-select" data-regid="${esc(r.regId)}" data-campid="${esc(r.campId)}" data-participantindex="${participantIndex}" data-field="gender" onchange="updateField(this)">
                  <option value="">${t('genderSelect')}</option>
                  <option value="male"${participant.gender === 'male' ? ' selected' : ''}>${t('male')}</option>
                  <option value="female"${participant.gender === 'female' ? ' selected' : ''}>${t('female')}</option>
                </select>`
                : participant.gender === 'male'
                ? `<span class="group-participant-gender male">${t('male')}</span>`
                : participant.gender === 'female'
                ? `<span class="group-participant-gender female">${t('female')}</span>`
                : `<span class="group-participant-empty">${t('notEntered')}</span>`;
              return `<tr class="group-participant-row${participantClass}">
                <td></td>
                <td colspan="3"><span class="group-participant-label">${tt('studentLabelFn', participantIndex + 1)}</span></td>
                <td class="group-participant-name">${participantName}</td>
                <td>${participantCounselor}</td>
                <td>${participantSalvation}</td>
                <td>${participantDedication}</td>
                <td>${participantMemo}</td>
                <td colspan="3"></td>
                <td>${participantGender}</td>
                <td colspan="6"></td>
              </tr>`;
            }).join('');
          })()
          : r.registrationType === 'group'
          ? `<tr class="group-participant-row legacy"><td></td><td colspan="18">${t('checkParticipants')}</td></tr>`
          : '';

        return `<tr class="${rowClass}" style="${rowStyle}">
          <td style="color:var(--light);font-family:var(--f-sans)">${i + 1}</td>
          <td>${statusCell}</td>
          <td class="camp-name-cell" style="font-size:12px">${esc(campLabel)}</td>
          <td>${typeBadge}</td>
          <td style="font-weight:600">${esc(r.name)}</td>
          <td>${counselorCell}</td>
          <td>${salvationCell}</td>
          <td>${dedicationCell}</td>
          <td>${counselorMemoCell}</td>
          <td>${esc(r.phone)}</td>
          <td style="font-size:12px;color:var(--mid)">${esc(r.email)}</td>
          <td style="font-family:var(--f-sans);font-size:12px">${esc(gradeOrCount)}</td>
          <td>${genderCell}</td>
          <td>${esc(r.church || '—')}</td>
          <td>${esc(r.school || '—')}</td>
          <td style="font-size:12px">${esc(r.emergency || '—')}</td>
          <td style="font-size:12px;color:var(--mid);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(r.notes || '')}">${esc(r.notes || '—')}</td>
          <td style="font-size:12px;color:var(--mid);white-space:nowrap">${dateStr}</td>
          <td class="delete-col"><button class="btn-del" onclick="deleteReg('${r.regId}','${r.campId}')">${t('thDelete')}</button></td>
        </tr>${participantRows}`;
      }).join('');
    }

    function renderStaffTable() {
      const regs = sortedRegs(filteredRegs().filter(r => r.registrationType === 'staff'));
      const tbody = document.getElementById('staffRegBody');
      document.getElementById('staffTableCount').textContent = tt('tableCountFn', regs.length);

      if (regs.length === 0) {
        tbody.innerHTML = `
          <tr><td colspan="12">
            <div class="state-box">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                <rect x="8" y="6" width="24" height="30" rx="3" stroke="#8fa8b5" stroke-width="2"/>
                <path d="M14 14h12M14 20h8M14 26h6" stroke="#8fa8b5" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <p>${t('noPending')}</p>
            </div>
          </td></tr>`;
        return;
      }

      let rowIndex = 0;
      const renderStaffRow = r => {
        const date = new Date(r.registeredAt);
        const dateStr = `${date.getFullYear()}.${String(date.getMonth()+1).padStart(2,'0')}.${String(date.getDate()).padStart(2,'0')} ${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`;
        const applicantMemo = r.notes || '';
        const testimonyCell = renderMemoCell(r.testimony || '');
        const campStyle = getCampRowStyle(r);
        const rowStyle = `--camp-row-bg:${campStyle.bg};--camp-row-border:${campStyle.border};`;

        // 성별 — 항상 읽기 전용
        const genderBadge = r.gender === 'male'
          ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(59,130,246,0.12);color:#2563eb;font-size:11px;font-weight:700;">${t('male')}</span>`
          : r.gender === 'female'
          ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(236,72,153,0.12);color:#db2777;font-size:11px;font-weight:700;">${t('female')}</span>`
          : `<span style="color:var(--light)">—</span>`;

        // 전화번호 — 수정 모드일 때 input
        const phoneCell = staffEditMode
          ? `<input class="edit-input" type="tel" value="${esc(r.phone)}" data-regid="${r.regId}" data-campid="${r.campId}" data-field="phone" onblur="updateField(this)" onkeydown="if(event.key==='Enter')this.blur()">`
          : esc(r.phone);

        // 섬김 분야는 이름 앞 뱃지로 요약하고, 본문 칸에는 신청자가 작성한 메모를 보여준다.
        const currentTeams = staffTeams(r);
        const teamCell = staffEditMode
          ? renderTeamEditor(r, currentTeams)
          : renderTeamStack(currentTeams);
        const memoCell = renderMemoCell(applicantMemo);

        return `<tr class="camp-tint" style="${rowStyle}">
          <td>${teamCell}</td>
          <td><span class="staff-name-cell">${esc(r.name || t('unset'))}</span></td>
          <td>${genderBadge}</td>
          <td style="font-size:12px;color:var(--mid);white-space:nowrap">${esc(r.birthDate || '—')}</td>
          <td style="font-size:12px;color:var(--mid)">${esc(r.church || '—')}</td>
          <td style="font-size:12px;color:var(--mid);white-space:nowrap">${esc(previousCampLabel(r.previousCamp))}</td>
          <td style="white-space:nowrap">${phoneCell}</td>
          <td>${memoCell}</td>
          <td>${testimonyCell}</td>
          <td style="font-size:12px;color:var(--mid)">${esc(r.email)}</td>
          <td style="font-size:12px;color:var(--mid);white-space:nowrap">${dateStr}</td>
          <td><button class="btn-del" onclick="deleteReg('${r.regId}','${r.campId}')">${t('thDelete')}</button></td>
        </tr>`;
      };

      const season = SEASONS.find(s => s.id === activeSeason);
      const orderedCampIds = activeCamp === 'all'
        ? (season?.groups.flatMap(group => group.camps.map(camp => camp.id)) || [])
        : [activeCamp];
      const extraCampIds = [...new Set(regs.map(r => r.campId))].filter(campId => !orderedCampIds.includes(campId));

      tbody.innerHTML = [...orderedCampIds, ...extraCampIds].map(campId => {
        const campRegs = regs.filter(r => r.campId === campId);
        const campStyle = getCampRowStyle({ campId });
        return `<tr class="staff-camp-divider" style="--camp-row-bg:${campStyle.bg};--camp-row-border:${campStyle.border};">
          <td colspan="12"><strong>${esc(campDisplayName(campId))}</strong><span>${tt('personCountFn', campRegs.length)}</span></td>
        </tr>${campRegs.length
          ? campRegs.map(renderStaffRow).join('')
          : `<tr class="staff-camp-empty"><td colspan="12">${t('campEmpty')}</td></tr>`}`;
      }).join('');
      updateStaffOverflowPopovers();
    }

    function esc(str) {
      return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── 개인별 역할 저장 (displayName 기반) ──
    function getPersonRole(dn, team) {
      return teamOverviewConfig.personRoles?.[`${dn}\x00${team}`] || null;
    }
    function setPersonRole(dn, team, role) {
      teamOverviewConfig.personRoles = teamOverviewConfig.personRoles || {};
      teamOverviewConfig.personRoles[`${dn}\x00${team}`] = role;
      queueTeamOverviewSave();
    }
    function personDefaultRole(p) { return p.role === 'missionary' ? 'leader' : 'member'; }
    function personEffectiveRole(p, team) { return getPersonRole(p.displayName, team) || personDefaultRole(p); }
    function togglePersonRole(dn, team, defR) {
      const cur = getPersonRole(dn, team) || defR;
      setPersonRole(dn, team, cur === 'leader' ? 'member' : 'leader');
      renderCampTeamPanel();
    }

    // ── 개인별 팀 배정 저장 (displayName 기반) ──
    function getPersonTeams(dn, defaultTeams) {
      const stored = teamOverviewConfig.personTeams?.[dn];
      return stored !== undefined ? stored : defaultTeams;
    }
    function setPersonTeams(dn, teams) {
      teamOverviewConfig.personTeams = teamOverviewConfig.personTeams || {};
      teamOverviewConfig.personTeams[dn] = Array.isArray(teams) ? teams : [];
      queueTeamOverviewSave();
    }
    function togglePersonTeam(dn, team, checked, defaultTeams) {
      const cur  = getPersonTeams(dn, defaultTeams);
      const next = checked ? (cur.includes(team) ? cur : [...cur, team]) : cur.filter(t_ => t_ !== team);
      setPersonTeams(dn, next);
      renderCampTeamPanel();
    }

    // ── 개인별 캠프 제외 저장 ──
    function isPersonExcluded(dn) {
      return (teamOverviewConfig.campExclude || []).includes(dn);
    }
    function togglePersonExclusion(dn) {
      const list = [...(teamOverviewConfig.campExclude || [])];
      const idx = list.indexOf(dn);
      if (idx === -1) list.push(dn); else list.splice(idx, 1);
      teamOverviewConfig.campExclude = list;
      queueTeamOverviewSave();
      renderCampTeamPanel();
    }

    // 로스터를 남편/아내 개별 person 배열로 펼치기
    function getRosterPersons(campId) {
      const result = [];
      for (const member of fullRosterForCamp(campId)) {
        const defaultTeams = member.isCustom ? normalizeTeamList(member.teams) : [];
        result.push({
          displayName: member.name,
          genderTag: '',
          title: member.title, role: member.role,
          defaultTeams,
          teams: getPersonTeams(member.name, defaultTeams),
          isCustom: !!member.isCustom, memberId: member.id,
        });
        if (member.spouseName) {
          result.push({
            displayName: member.spouseName,
            genderTag: '',
            title: member.title, role: member.role,
            defaultTeams,
            teams: getPersonTeams(member.spouseName, defaultTeams),
            isCustom: false,
          });
        }
      }
      return result;
    }

    function toggleTeamPanelEditMode() {
      teamPanelEditMode = !teamPanelEditMode;
      renderCampTeamPanel();
    }
    function toggleStatPanel(type) {
      activeStatPanel = activeStatPanel === type ? null : type;
      renderCampTeamPanel();
    }

    // ── 캠프 디렉터 / 코디네이터 ──
    function getCampRoles() {
      return teamOverviewConfig.campRoles || {};
    }
    function saveCampRole(roleKey, value) {
      teamOverviewConfig.campRoles = teamOverviewConfig.campRoles || {};
      teamOverviewConfig.campRoles[roleKey] = value;
      queueTeamOverviewSave();
      renderCampTeamPanel();
    }

    // 캠프별 멤버 필터 (제주 선교사는 제주 캠프에서만)
    function rosterForCamp(campId) {
      const isJejuCamp = campId.includes('jeju');
      return WOLKO_CAMP_ROSTER.filter(m => !(m.jeju && !isJejuCamp));
    }

    // ── 미지정 (커스텀) 멤버 ──
    function getCustomMembers() {
      return teamOverviewConfig.customMembers || [];
    }
    function saveCustomMembers(list) {
      teamOverviewConfig.customMembers = Array.isArray(list) ? list : [];
      queueTeamOverviewSave();
    }
    // 선택된 데이터 임시 저장 (DOM 의존 없이 추가 가능하도록 fallback)
    let _cmPendingData = null;

    // 등록 명단에서 선택 시 폼 자동 입력
    // val 형식: 'r:regId' (스태프 신청자) | 'm:이름' (월코 로스터)
    function fillFromReg(val) {
      _cmPendingData = null;
      const nameEl  = document.getElementById('cmName');
      const titleEl = document.getElementById('cmTitle');
      const roleEl  = document.getElementById('cmRole');

      const applyData = (data) => {
        _cmPendingData = data;
        if (nameEl)  nameEl.value  = data.name;
        if (titleEl) titleEl.value = data.title;
        if (roleEl)  roleEl.value  = data.role;
        document.querySelectorAll('.cm-team-check').forEach(cb => {
          cb.checked = (data.teams || []).includes(cb.value);
        });
        if (nameEl) nameEl.focus();
      };

      if (!val) {
        if (nameEl)  nameEl.value  = '';
        if (titleEl) titleEl.value = '';
        document.querySelectorAll('.cm-team-check').forEach(cb => cb.checked = false);
        return;
      }
      if (val.startsWith('r:')) {
        const reg = allRegs.find(r => r.regId === val.slice(2));
        if (!reg) return;
        applyData({ name: reg.name || '', title: reg.church || '', role: 'stw', teams: staffTeams(reg) });
      } else if (val.startsWith('m:')) {
        const mName  = val.slice(2);
        const member = WOLKO_CAMP_ROSTER.find(m => m.name === mName || m.spouseName === mName);
        if (!member) return;
        applyData({ name: mName, title: member.title || '', role: member.role || 'stw', teams: member.teams || [] });
      }
    }

    function addCustomMemberAction() {
      // DOM 값 우선, 없으면 _cmPendingData fallback
      const name = document.getElementById('cmName')?.value.trim() || _cmPendingData?.name || '';
      if (!name) { document.getElementById('cmName')?.focus(); return; }
      const spouseName = document.getElementById('cmSpouse')?.value.trim() || '';
      const title  = document.getElementById('cmTitle')?.value.trim() || _cmPendingData?.title || '';
      const role   = document.getElementById('cmRole')?.value || _cmPendingData?.role || 'stw';
      const teamsFromDom = Array.from(document.querySelectorAll('.cm-team-check:checked')).map(el => el.value);
      const teams  = teamsFromDom.length ? teamsFromDom : (_cmPendingData?.teams || []);

      const list = getCustomMembers();
      list.push({ id: 'cm_' + Date.now(), name, spouseName, title, role, teams, isCustom: true });
      saveCustomMembers(list);

      _cmPendingData = null;
      const sel = document.getElementById('cmRegSelect');
      if (sel) sel.value = '';
      fillFromReg('');
      const spouse = document.getElementById('cmSpouse');
      if (spouse) spouse.value = '';
      renderCampTeamPanel();
    }
    function removeCustomMember(id) {
      saveCustomMembers(getCustomMembers().filter(m => m.id !== id));
      renderCampTeamPanel();
    }
    // 표준 + 커스텀 전체 로스터
    function fullRosterForCamp(campId) {
      return [...rosterForCamp(campId), ...getCustomMembers()];
    }

    const CAMP_ROLE_SLOTS = [
      { key: 'director', label: '캠프 디렉터', cls: 'is-director' },
      { key: 'coord1',   label: '코디네이터 1', cls: '' },
      { key: 'coord2',   label: '코디네이터 2', cls: '' },
    ];

    function renderCampRolesBar(roster) {
      const roles = getCampRoles();
      const slotLabels = [t('campDirector'), t('coordinator'), t('coordinator')];
      return `<div class="camp-roles-bar">
        ${CAMP_ROLE_SLOTS.map((slot, idx) => {
          const val   = roles[slot.key] || '';
          const found = val ? roster.find(m => m.name === val) : null;
          return `<div class="camp-role-slot${slot.cls ? ' ' + slot.cls : ''}">
            <div class="camp-role-slot-label">${slotLabels[idx]}${idx > 0 ? ` ${idx}` : ''}</div>
            <select class="camp-role-select" onchange="saveCampRole('${slot.key}',this.value)">
              <option value="">${t('unassigned')}</option>
              ${roster.map(m => `<option value="${esc(m.name)}"${val === m.name ? ' selected' : ''}>${esc(memberDisplayName(m))}</option>`).join('')}
            </select>
            ${found ? `<div class="camp-role-assigned-title">${esc(found.title)}</div>` : ''}
          </div>`;
        }).join('')}
      </div>`;
    }

    function renderCampTeamPanel() {
      const panel = document.getElementById('campTeamPanel');
      if (!TEAM_PANEL_CAMPS.has(activeCamp)) {
        panel.hidden = true; panel.innerHTML = ''; return;
      }
      if (teamOverviewConfigCamp !== activeCamp) {
        panel.hidden = false;
        panel.innerHTML = `<div class="state-box"><div class="spinner"></div><p>${t('teamSettingsLoading')}</p></div>`;
        loadTeamOverviewConfig(activeCamp).then(() => renderCampTeamPanel());
        return;
      }
      const selTeam  = activeTeamFilter === 'all' || getAllTeams().includes(activeTeamFilter) ? activeTeamFilter : 'all';
      activeTeamFilter = selTeam;
      const campStaff = allRegs.filter(r => r.registrationType === 'staff' && r.campId === activeCamp);
      const campLabel = campDisplayName(activeCamp);
      const roster    = fullRosterForCamp(activeCamp);
      const persons   = getRosterPersons(activeCamp);
      const visP      = persons;

      // 지원 스태프 신청자 → person 객체로 변환 (팀 배정·리더 등록 가능)
      const applicantPersons = campStaff.map(reg => ({
        displayName: reg.name || '',
        genderTag: '',
        title: reg.church || '',
        phone: reg.phone || '',
        role: 'stw',
        defaultTeams: staffTeams(reg),
        teams: getPersonTeams(reg.name || '', staffTeams(reg)),
        isCustom: false,
      }));
      const visApplicants = applicantPersons;

      const leaderP = visP.filter(p => p.teams.some(tm => getAllTeams().includes(tm) && personEffectiveRole(p, tm) === 'leader'));
      const memberP = visP.filter(p => p.teams.some(tm => getAllTeams().includes(tm) && personEffectiveRole(p, tm) === 'member'));

      // stat panel HTML
      function statPanel() {
        if (!activeStatPanel) return '';
        let items, panelTitle;
        if (activeStatPanel === 'staff') {
          return `<div class="camp-stat-panel">
            <div class="stat-panel-title">${t('applicantSection')} (${visApplicants.length})</div>
            <div class="stat-panel-list">${visApplicants.length ? visApplicants.map(p => renderPersonRow(p, null, true)).join('') : `<div class="camp-team-empty">${t('noApplicant')}</div>`}</div>
          </div>`;
        }
        items = activeStatPanel === 'leaders' ? leaderP : memberP;
        panelTitle = activeStatPanel === 'leaders' ? t('teamLeaderSection') : t('memberSection');
        return `<div class="camp-stat-panel">
          <div class="stat-panel-title">${panelTitle} (${items.length})</div>
          <div class="stat-panel-list">${items.length ? items.map(p => renderPersonRow(p, null, true)).join('') : `<div class="camp-team-empty">${t('noMember')}</div>`}</div>
        </div>`;
      }

      const gridTeams = selTeam === 'all' ? [...getAllTeams(), UNASSIGNED] : [selTeam];

      panel.hidden = false;
      panel.innerHTML = `
        <div class="camp-team-head">
          <div>
            <div class="camp-team-kicker">${esc(campLabel)}</div>
            <h3>${t('teamPanelTitle')}</h3>
          </div>
          <button class="btn-team-panel-edit${teamPanelEditMode ? ' active' : ''}" onclick="toggleTeamPanelEditMode()">
            ${teamPanelEditMode
              ? `<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M2 6l3 3 5-5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg> ${t('doneBtn')}`
              : `<svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M7 2l3 3-5.5 5.5H1.5V8L7 2z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg> ${t('editBtn')}`}
          </button>
        </div>
        ${renderCampRolesBar(roster)}
        <div class="camp-stat-badges">
          <button class="stat-badge${activeStatPanel === 'leaders' ? ' active' : ''}" onclick="toggleStatPanel('leaders')">
            <span class="stat-num">${leaderP.length}</span>
            <span class="stat-label">${t('teamLeaderSection')}</span>
          </button>
          <button class="stat-badge${activeStatPanel === 'members' ? ' active' : ''}" onclick="toggleStatPanel('members')">
            <span class="stat-num">${memberP.length}</span>
            <span class="stat-label">${t('memberSection')}</span>
          </button>
          <button class="stat-badge${activeStatPanel === 'staff' ? ' active' : ''}" onclick="toggleStatPanel('staff')">
            <span class="stat-num">${visApplicants.length}</span>
            <span class="stat-label">${t('applicantSection')}</span>
          </button>
        </div>
        ${statPanel()}
        ${teamPanelEditMode ? `<div class="custom-member-add-bar team-create-bar">
          <span class="custom-member-bar-label">${t('createTeam')}</span>
          <div class="team-create-form">
            <input type="text" id="newTeamNameInput" class="cm-input cm-input-wide" placeholder="${t('newTeamPh')}"
              onkeydown="if(event.key==='Enter')addCustomTeamAction()">
            <button class="btn-cm-add" onclick="addCustomTeamAction()">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              ${t('createBtn')}
            </button>
          </div>
          ${getCustomTeams().length ? `<div class="custom-teams-list">
            ${getCustomTeams().map((tm, i) => `<span class="custom-team-pill ${CUSTOM_TEAM_CLASSES[i % CUSTOM_TEAM_CLASSES.length]}">
              ${esc(tm)}
              <button class="custom-team-del" onclick="removeCustomTeamAction('${esc(tm)}')" title="${t('deleteTeam')}">×</button>
            </span>`).join('')}
          </div>` : ''}
        </div>
        <div class="custom-member-add-bar">
          <span class="custom-member-bar-label">${t('customMemberAdd')}</span>
          <div class="cm-reg-row">
            <svg class="cm-reg-icon" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M2 11c0-2.2 1.8-4 4-4s4 1.8 4 4M7 7a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
            <select id="cmRegSelect" class="cm-select cm-reg-select" onchange="fillFromReg(this.value)">
              <option value="">${t('chooseFromList')}</option>
              <optgroup label="${t('wolkoStaff')}">
                ${WOLKO_CAMP_ROSTER.flatMap(m => {
                  const opts = [`<option value="m:${esc(m.name)}">${esc(m.name)}${m.title ? ' · ' + esc(m.title) : ''}</option>`];
                  if (m.spouseName) opts.push(`<option value="m:${esc(m.spouseName)}">${esc(m.spouseName)} · ${esc(m.title || '')}</option>`);
                  return opts;
                }).join('')}
              </optgroup>
              ${(() => {
                const staffRegs = [...allRegs]
                  .filter(r => r.registrationType === 'staff')
                  .sort((a, b) => {
                    if (a.campId === activeCamp && b.campId !== activeCamp) return -1;
                    if (a.campId !== activeCamp && b.campId === activeCamp) return 1;
                    return (a.name || '').localeCompare(b.name || '', 'ko');
                  });
                if (!staffRegs.length) return '';
                return `<optgroup label="${t('staffApplicants')}">
                  ${staffRegs.map(r => `<option value="r:${esc(r.regId)}">${esc(r.name || t('nameMissing'))} · ${esc(campDisplayName(r.campId))}</option>`).join('')}
                </optgroup>`;
              })()}
            </select>
            <span class="cm-reg-or">${t('orDirectInput')}</span>
          </div>
          <div class="custom-member-form">
            <input type="text" id="cmName" class="cm-input" placeholder="${t('cmNamePh')}">
            <input type="text" id="cmSpouse" class="cm-input" placeholder="${t('cmSpousePh')}">
            <input type="text" id="cmTitle" class="cm-input cm-input-wide" placeholder="${t('cmTitlePh')}">
            <select id="cmRole" class="cm-select">
              <option value="missionary">${t('cmRoleLeader')}</option>
              <option value="intern">${t('cmRoleIntern')}</option>
              <option value="stw" selected>${t('cmRoleStaff')}</option>
            </select>
            <div class="cm-team-chips">
              ${getAllTeams().map(tm => `<label class="cm-team-chip ${getStaffTeamClass(tm)}"><input type="checkbox" class="cm-team-check" value="${esc(tm)}">${esc(teamLabel(tm))}</label>`).join('')}
            </div>
            <button class="btn-cm-add" onclick="addCustomMemberAction()">
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
              ${t('cmAddBtn')}
            </button>
          </div>
        </div>` : ''}
        <div class="camp-team-filter">
          <button type="button" class="${selTeam === 'all' ? 'active' : ''}" onclick="selectTeamPanelFilter('all')">${t('allFilter')}</button>
          ${getAllTeams().map(tm => `<button type="button" class="${selTeam === tm ? 'active' : ''}" onclick="selectTeamPanelFilter('${esc(tm)}')">${esc(teamLabel(tm))}</button>`).join('')}
        </div>
        <div class="camp-team-grid">
          ${gridTeams.map(tm => renderCampTeamCard(tm, visApplicants, visP)).join('')}
        </div>`;
    }

    function renderCampTeamCard(team, visApplicants, visP) {
      // 미지정 카드: 아무 팀에도 없는 멤버 (커스텀팀 포함)
      if (team === UNASSIGNED) {
        const uList = [
          ...visP.filter(p => p.teams.filter(tm => getAllTeams().includes(tm)).length === 0),
          ...visApplicants.filter(p => p.teams.filter(tm => getAllTeams().includes(tm)).length === 0),
        ];
        if (!uList.length && !teamPanelEditMode) return '';
        return `<section class="camp-team-card camp-team-unassigned">
          <div class="camp-team-card-title">
            <span class="person-team-badge team-other"><span class="person-team-label">${t('unassignedTeam')}</span></span>
            <span>${uList.length}</span>
          </div>
          <div class="camp-team-member-group">
            ${uList.length ? uList.map(p => renderPersonRow(p, null)).join('') : `<div class="camp-team-empty">${t('allAssigned')}</div>`}
          </div>
        </section>`;
      }
      const pList    = visP.filter(p => p.teams.includes(team));
      const applicants = visApplicants.filter(p => p.teams.includes(team));
      const allInTeam  = [...pList, ...applicants];
      const leaders    = allInTeam.filter(p => personEffectiveRole(p, team) === 'leader');
      const nonLeaders = allInTeam.filter(p => personEffectiveRole(p, team) !== 'leader');
      return `<section class="camp-team-card">
        <div class="camp-team-card-title">
          ${renderTeamBadge(team)}
          <span>${allInTeam.length}</span>
        </div>
        <div class="camp-team-member-group">
          <div class="camp-team-group-label">${t('teamLeaderSection')}</div>
          ${leaders.length ? leaders.map(p => renderPersonRow(p, team)).join('') : `<div class="camp-team-empty">${t('noLeader')}</div>`}
        </div>
        <div class="camp-team-member-group">
          ${nonLeaders.length ? nonLeaders.map(p => renderPersonRow(p, team)).join('') : `<div class="camp-team-empty">${t('noMember')}</div>`}
        </div>
      </section>`;
    }

    function renderPersonRow(person, team, inPanel = false) {
      const isLeader  = team ? personEffectiveRole(person, team) === 'leader' : false;
      const defR      = personDefaultRole(person);
      const roleText   = isLeader ? t('teamLeaderRole') : (person.role === 'intern' ? t('internRole') : t('staffRole'));
      // 원래 팀이 있었는데 모든 팀에서 제외된 경우 → 뷰 모드에서만 회색 처리 (편집 모드에선 해제)
      const isFullyExcluded = !team && !teamPanelEditMode
        && person.defaultTeams && person.defaultTeams.length > 0
        && person.teams.filter(tm => getAllTeams().includes(tm)).length === 0;

      const teamCbs = getAllTeams().map(tm => `
        <label class="member-team-option ${getStaffTeamClass(tm)}${person.teams.includes(tm) ? ' is-checked' : ''}">
          <input type="checkbox"${person.teams.includes(tm) ? ' checked' : ''}
            onchange="togglePersonTeam('${esc(person.displayName)}','${esc(tm)}',this.checked,${esc(JSON.stringify(person.defaultTeams))})">
          <span>${esc(teamLabel(tm))}</span>
        </label>`).join('');

      const showControls = teamPanelEditMode;
      const controls = showControls ? `<div class="camp-team-member-controls">
          <details class="member-team-picker">
            <summary class="member-team-btn">${t('teamAssign')}</summary>
            <div class="member-team-options">${teamCbs}</div>
          </details>
          ${team ? `<button class="team-role-toggle${isLeader ? ' is-leader' : ''}"
            onclick="togglePersonRole('${esc(person.displayName)}','${esc(team)}','${defR}')">${roleText}</button>` : ''}
          ${team ? `<button class="btn-person-exclude"
            onclick="togglePersonTeam('${esc(person.displayName)}','${esc(team)}',false,${esc(JSON.stringify(person.defaultTeams))})">${t('exclude')}</button>` : ''}
          ${person.isCustom && teamPanelEditMode ? `<button class="btn-custom-member-delete" onclick="removeCustomMember('${esc(person.memberId)}')">×</button>` : ''}
        </div>` : '';

      return `<div class="camp-team-member${isLeader ? ' is-leader' : ''}${isFullyExcluded ? ' is-fully-excluded' : ''}${person.isCustom ? ' is-custom-member' : ''}">
        <div class="camp-team-member-info">
          <div class="couple-person-row${isFullyExcluded ? ' is-excluded' : ''}">
            ${person.genderTag ? `<span class="couple-gender-tag">${person.genderTag}</span>` : ''}
            <strong>${esc(person.displayName)}</strong>
          </div>
          ${person.phone ? `<span class="camp-team-member-phone">${esc(person.phone)}</span>` : ''}
        </div>
        ${controls}
      </div>`;
    }

    function renderApplicantTeamMember(reg) {
      return `<div class="camp-team-member">
        <div class="camp-team-member-info">
          <div class="couple-person-row"><strong>${esc(reg.name || t('unset'))}</strong></div>
          <span class="camp-team-member-title">${esc(reg.church || t('noChurch'))}${reg.phone ? ' · ' + esc(reg.phone) : ''}</span>
        </div>
      </div>`;
    }

    function selectTeamPanelFilter(team) {
      activeTeamFilter = team;
      renderCampTeamPanel();
    }

    function renderTeamBadge(team) {
      if (!team) return '';
      return `<span class="person-team-badge ${getStaffTeamClass(team)}"><span class="person-team-label">${esc(teamLabel(team))}</span></span>`;
    }

    function renderMemoCell(memo) {
      if (!memo) return `<span style="color:var(--light)">—</span>`;
      return `<span class="staff-memo-wrap" tabindex="-1" aria-label="${esc(memo)}">
        <span class="staff-memo-cell">${esc(memo)}</span>
        <span class="staff-memo-popover">${esc(memo)}</span>
      </span>`;
    }

    function previousCampLabel(value) {
      if (value === 'yes') return adminLang === 'en' ? 'Yes' : '예';
      if (value === 'no') return adminLang === 'en' ? 'No' : '아니오';
      return '—';
    }

    function updateStaffOverflowPopovers() {
      // Double rAF ensures the table has fully laid out before measuring
      requestAnimationFrame(() => requestAnimationFrame(() => {
        document.querySelectorAll('.staff-memo-wrap').forEach(wrap => {
          const cell = wrap.querySelector('.staff-memo-cell');
          const hasOverflow = cell && cell.scrollWidth > cell.clientWidth + 1;
          wrap.classList.toggle('has-overflow', !!hasOverflow);
          wrap.tabIndex = hasOverflow ? 0 : -1;
        });
      }));
    }

    function renderTeamStack(teams = []) {
      const primaryTeam = teams[0] || '';
      const hiddenTeams = teams.slice(1);
      const extraCount = hiddenTeams.length;
      if (!primaryTeam) {
        return `<span class="person-team-stack"><span class="person-team-badge team-other"><span class="person-team-label">${t('unassignedTeam')}</span></span></span>`;
      }
      return `<span class="person-team-stack">
          <span class="person-team-badge ${getStaffTeamClass(primaryTeam)}${extraCount ? ' has-extra' : ''}"${extraCount ? ` tabindex="0" aria-label="${esc([primaryTeam, ...hiddenTeams].join(', '))}"` : ''}>
            <span class="person-team-label">${esc(primaryTeam)}${extraCount ? ` <span class="person-team-count">+${extraCount}</span>` : ''}</span>
            ${extraCount ? `
            <span class="person-team-popover">${hiddenTeams.map(renderTeamBadge).join('')}</span>
            ` : ''}
          </span>
        </span>`;
    }

    function renderTeamEditor(reg, teams = []) {
      const standardTeams = teams.filter(t => STAFF_TEAMS.includes(t));
      const customTeams   = teams.filter(t => !STAFF_TEAMS.includes(t));
      const selected      = new Set(standardTeams);
      const hasCustom     = customTeams.length > 0;
      const customValue   = customTeams.join(', ');
      return `<details class="staff-team-editor">
        <summary>
          <span class="staff-team-editor-summary">${renderTeamStack(teams)}</span>
          <svg class="staff-team-caret" width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M3 5l4 4 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </summary>
        <div class="staff-team-menu" data-regid="${esc(reg.regId)}" data-campid="${esc(reg.campId)}">
          ${getAllTeams().map(team => `<label class="staff-team-option ${getStaffTeamClass(team)}">
            <input type="checkbox" value="${esc(team)}"${selected.has(team) ? ' checked' : ''} onchange="collectAndSaveTeams(this.closest('.staff-team-menu'))">
            <span>${esc(teamLabel(team))}</span>
          </label>`).join('')}
          <label class="staff-team-option team-other staff-team-custom-toggle">
            <input type="checkbox" class="custom-team-check"${hasCustom ? ' checked' : ''} onchange="toggleCustomTeamInput(this)">
            <span>${t('customTeamOther')}</span>
          </label>
          <div class="staff-custom-team-wrap"${hasCustom ? '' : ' style="display:none"'}>
            <input type="text" class="staff-custom-team-input" placeholder="${t('customTeamInputPh')}" value="${esc(customValue)}"
              onblur="collectAndSaveTeams(this.closest('.staff-team-menu'))"
              onkeydown="if(event.key==='Enter')this.blur()">
          </div>
        </div>
      </details>`;
    }

    function toggleCustomTeamInput(checkbox) {
      const menu = checkbox.closest('.staff-team-menu');
      const wrap = menu.querySelector('.staff-custom-team-wrap');
      wrap.style.display = checkbox.checked ? '' : 'none';
      if (checkbox.checked) {
        wrap.querySelector('input').focus();
      } else {
        wrap.querySelector('input').value = '';
        collectAndSaveTeams(menu);
      }
    }

    async function collectAndSaveTeams(menu) {
      const editor = menu.closest('.staff-team-editor');
      const regId  = menu.dataset.regid;
      const campId = menu.dataset.campid;
      const reg    = allRegs.find(r => r.regId === regId);
      if (!reg) return;

      // Standard team checkboxes (exclude custom-team-check)
      const standardTeams = Array.from(menu.querySelectorAll('input[type="checkbox"]:not(.custom-team-check)'))
        .filter(i => i.checked).map(i => i.value);

      // Custom team text
      const customCheck = menu.querySelector('.custom-team-check');
      const customInput = menu.querySelector('.staff-custom-team-input');
      const customTeams = (customCheck?.checked && customInput?.value.trim())
        ? customInput.value.trim().split(',').map(t => t.trim()).filter(Boolean)
        : [];

      const value        = [...standardTeams, ...customTeams].join(', ');
      const previousValue = reg.serviceArea || '';

      const allInputs = Array.from(menu.querySelectorAll('input'));
      allInputs.forEach(i => { i.disabled = true; });
      editor.classList.add('saving');

      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PUT',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, field: 'serviceArea', value }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('teamSaveFail'));
        reg.serviceArea = value;
        editor.querySelector('.staff-team-editor-summary').innerHTML = renderTeamStack(staffTeams(reg));
        renderCampTeamPanel();
        if (sortState.key === 'staffTeam') renderStaffTable();
        showToast(t('teamSaved'), 'success');
      } catch (e) {
        reg.serviceArea = previousValue;
        showToast(t('teamSaveErr') + e.message, 'error');
        renderStaffTable();
      } finally {
        allInputs.forEach(i => { i.disabled = false; });
        editor.classList.remove('saving');
      }
    }

    function toggleGroupParticipants(regId) {
      if (expandedGroupParticipants.has(regId)) expandedGroupParticipants.delete(regId);
      else expandedGroupParticipants.add(regId);
      renderCampTable();
    }

    // ── Edit Mode Toggle ──
    function toggleEditMode() {
      staffEditMode = !staffEditMode;
      const btn = document.getElementById('btnStaffEditMode');
      btn.classList.toggle('active', staffEditMode);
      btn.querySelector('[data-t]').dataset.t = staffEditMode ? 'editing' : 'editMode';
      applyLangToDOM();
      renderStaffTable();
    }

    function toggleCamperEditMode() {
      camperEditMode = !camperEditMode;
      const btn = document.getElementById('btnCamperEditMode');
      btn.classList.toggle('active', camperEditMode);
      btn.querySelector('[data-t]').dataset.t = camperEditMode ? 'editing' : 'editMode';
      applyLangToDOM();
      renderCampTable();
    }

    // ── 전화번호 포맷 (숫자만 추출 후 010-XXXX-XXXX 형식) ──
    function formatPhone(raw) {
      const d = raw.replace(/\D/g, '');
      if (d.length === 11) return `${d.slice(0,3)}-${d.slice(3,7)}-${d.slice(7)}`;
      if (d.length === 10) return d.startsWith('02')
        ? `${d.slice(0,2)}-${d.slice(2,6)}-${d.slice(6)}`
        : `${d.slice(0,3)}-${d.slice(3,6)}-${d.slice(6)}`;
      return raw; // 자릿수 불일치 시 원문 유지
    }

    // ── Field Update (전화번호, 섬기고 싶은 분야 등) ──
    async function updateField(inputEl) {
      const regId  = inputEl.dataset.regid;
      const campId = inputEl.dataset.campid;
      const field  = inputEl.dataset.field;
      const participantIndex = inputEl.dataset.participantindex;
      let value = inputEl.type === 'checkbox' ? inputEl.checked : inputEl.value.trim();

      // 전화번호 자동 포맷 후 input 값도 즉시 반영
      if (field === 'phone' && value) {
        value = formatPhone(value);
        inputEl.value = value;
      }

      const reg = allRegs.find(r => r.regId === regId);
      if (!reg) return;
      const record = participantIndex === undefined ? reg : (reg.participants?.[Number(participantIndex)] || {});
      if (!record) return;

      // 값 변경 없으면 스킵
      const original = inputEl.type === 'checkbox' ? !!record[field] : String(record[field] || '').trim();
      if (value === original) return;

      inputEl.classList.add('saving');
      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PUT',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, field, value, ...(participantIndex === undefined ? {} : { participantIndex: Number(participantIndex) }) }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('updateFail'));
        if (participantIndex === undefined) {
          record[field] = value;
        } else {
          Object.assign(reg, data.reg);
        }
        inputEl.classList.remove('saving');
        inputEl.classList.add('saved');
        setTimeout(() => inputEl.classList.remove('saved'), 1500);
        if (participantIndex !== undefined || inputEl.type === 'checkbox') {
          updateCardStats();
          renderCampTable();
          renderDash();
        }
        showToast(t('fieldSaved'), 'success');
      } catch (e) {
        if (inputEl.type === 'checkbox') inputEl.checked = original;
        else inputEl.value = original;
        inputEl.classList.remove('saving');
        showToast(t('fieldErr') + e.message, 'error');
      }
    }

    // ── Delete ──
    async function deleteReg(regId, campId) {
      if (!confirm(t('deleteConfirm'))) return;
      try {
        const res = await fetch(`/api/admin/registrations?regId=${regId}&campId=${campId}`, {
          method: 'DELETE', headers: authHeaders()
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('deleteFail'));
        allRegs = allRegs.filter(r => r.regId !== regId);
        renderTable();
        renderDash();
        showToast(t('deleted'), 'success');
      } catch (e) {
        showToast(t('deleteErr') + e.message, 'error');
      }
    }

    // ── 예약금 수납 ──
    async function depositReg(regId, campId) {
      if (!confirm(t('depositConfirmMsg'))) return;
      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PATCH',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, action: 'deposit', campTitleKo: CAMP_LABELS[campId] || campId, campDateKo: CAMP_DATES[campId] || '' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('processFail'));
        const reg = allRegs.find(r => r.regId === regId);
        if (reg) { reg.status = 'deposit'; reg.depositConfirmedAt = data.reg?.depositConfirmedAt || new Date().toISOString(); }
        renderTable();
        renderDash();
        updateCardStats();
        showToast(t('depositSuccess'), 'success');
      } catch (e) {
        showToast(t('errorPrefix') + e.message, 'error');
      }
    }

    // ── 확정 → 예약금 되돌리기 ──
    async function revertReg(regId, campId) {
      if (!confirm(`최종확정을 취소하고 예약금확인 상태로 되돌리시겠습니까?\n잔금 입금 전인 경우에만 사용해주세요.`)) return;
      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PATCH',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, action: 'revert' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '처리 실패');
        const reg = allRegs.find(r => r.regId === regId);
        if (reg) { reg.status = 'deposit'; reg.confirmed = false; delete reg.confirmedAt; }
        renderTable();
        renderDash();
        updateCardStats();
        showToast('예약금확인 상태로 되돌렸습니다.', 'success');
      } catch (e) {
        showToast('오류: ' + e.message, 'error');
      }
    }

    // ── 최종 확정 ──
    async function confirmReg(regId, campId) {
      if (!confirm(t('finalConfirmMsg'))) return;
      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PATCH',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, action: 'confirm', campTitleKo: CAMP_LABELS[campId] || campId, campDateKo: CAMP_DATES[campId] || '' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || t('confirmFail'));
        const reg = allRegs.find(r => r.regId === regId);
        if (reg) { reg.status = 'confirmed'; reg.confirmed = true; reg.confirmedAt = data.reg?.confirmedAt || new Date().toISOString(); }
        renderTable();
        renderDash();
        updateCardStats();
        showToast(t('finalSuccess'), 'success');
      } catch (e) {
        showToast(t('confirmErr') + e.message, 'error');
      }
    }

    // ── CSV ──
    function downloadCsv(type = 'camp') {
      const campName = activeCamp === 'all' ? t('campAll') : campDisplayName(activeCamp);
      const today = new Date().toISOString().slice(0, 10);
      const bom = '﻿';

      if (type === 'staff') {
        const regs = sortedRegs(filteredRegs().filter(r => r.registrationType === 'staff'));
        if (regs.length === 0) { showToast(t('csvNoStaff'), 'error'); return; }
        const headers = adminLang === 'en'
          ? ['No','Camp','Name','Phone','Email','Gender','Birth Date','Church','Previous Camp','Teams','Applicant Note','Introduction/Testimony','Registered','RegID']
          : ['번호','캠프','이름','연락처','이메일','성별','생년월일','교회','이전 캠프 참여','섬기고 싶은 분야','신청자 메모','자기소개 및 간증','신청일시','RegID'];
        const rows = regs.map((r, i) => {
          const date = new Date(r.registeredAt).toLocaleString('ko-KR');
          const genderLabel = r.gender === 'male' ? t('male') : r.gender === 'female' ? t('female') : '';
          return [
            i + 1, campDisplayName(r.campId),
            r.name, r.phone, r.email, genderLabel, r.birthDate || '', r.church || '',
            previousCampLabel(r.previousCamp), staffTeams(r).join(', '), r.notes || '', r.testimony || '', date, r.regId,
          ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(',');
        });
        const csv = bom + [headers.join(','), ...rows].join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `WOLKO_${t('csvStaffFile')}_${campName}_${today}.csv`;
        a.click(); URL.revokeObjectURL(url);
        showToast(t('csvStaffDone'), 'success');
      } else {
        const regs = sortedRegs(filteredRegs().filter(r => r.registrationType !== 'staff'));
        if (regs.length === 0) { showToast(t('csvNoCamp'), 'error'); return; }
        const headers = adminLang === 'en'
          ? ['No','Status','Camp','Type','Name','Students','Counselor','Saved','Dedicated','Counselor Note','Phone','Email','Grade/Count','Gender','Church','School','Emergency','Notes','Registered','RegID']
          : ['번호','상태','캠프','유형','이름','학생 명단','담당 카운슬러','구원','헌신','상담자 메모','연락처','이메일','학년/인원','성별','교회','학교','비상연락처','메모','신청일시','RegID'];
        const rows = regs.map((r, i) => {
          const date = new Date(r.registeredAt).toLocaleString('ko-KR');
          const gradeOrCount = r.registrationType === 'group' ? `${t('groupBadge')} ${tt('personCountFn', r.groupCount)}` : (r.grade || '');
          const _s = r.status || (r.confirmed === true ? 'confirmed' : 'pending');
          const statusVal = _s === 'confirmed' ? t('confirmed') : _s === 'deposit' ? t('depositConfirmed') : t('pending');
          let genderVal;
          if (r.registrationType === 'group') {
            const m = r.maleCount || 0, f = r.femaleCount || 0;
            genderVal = (m > 0 || f > 0) ? `${t('male')} ${m} ${t('female')} ${f}` : '';
          } else {
            genderVal = r.gender === 'male' ? t('male') : r.gender === 'female' ? t('female') : '';
          }
          const counselor = allRegs.find(staff => staff.regId === r.counselorRegId && staff.campId === r.campId);
          const participantList = Array.isArray(r.participants)
            ? r.participants.map((participant, index) => {
                const participantCounselor = allRegs.find(staff => staff.regId === participant.counselorRegId && staff.campId === r.campId);
                return `${index + 1}. ${participant.name || t('notEntered')} (${participant.gender === 'male' ? t('male') : participant.gender === 'female' ? t('female') : t('genderMissing')}${participantCounselor ? ` / ${participantCounselor.name}` : ''}${participant.saved ? ' / ' + t('savedLabel') : ''}${participant.dedicated ? ' / ' + t('dedicatedLabel') : ''}${participant.counselorMemo ? ` / ${t('thCounselorMemo')}: ${participant.counselorMemo}` : ''})`;
              }).join('\n')
            : '';
          return [
            i + 1, statusVal, campDisplayName(r.campId),
            r.registrationType === 'group' ? t('groupBadge') : t('individualBadge'),
            r.name, participantList, counselor?.name || '', r.saved ? 'O' : '', r.dedicated ? 'O' : '', r.counselorMemo || '',
            r.phone, r.email, gradeOrCount, genderVal,
            r.church || '', r.school || '', r.emergency || '',
            r.notes || '', date, r.regId,
          ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(',');
        });
        const csv = bom + [headers.join(','), ...rows].join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `WOLKO_${t('csvCampFile')}_${campName}_${today}.csv`;
        a.click(); URL.revokeObjectURL(url);
        showToast(t('csvDone'), 'success');
      }
    }

    // ── Toast ──
    let toastTimer;
    function showToast(msg, type = '') {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'toast show' + (type ? ' ' + type : '');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { t.className = 'toast'; }, 3000);
    }

    // ── Auto-login if token exists ──
    if (authToken) {
      document.getElementById('loginScreen').classList.add('hidden');
      setTimeout(() => { document.getElementById('loginScreen').style.display = 'none'; }, 0);
      loadRegs();
    }

    // ── PWA 설치 ──
    let deferredAdminPrompt = null;
    const isAdminStandalone = window.matchMedia('(display-mode: standalone)').matches
      || window.navigator.standalone === true;
    const isAdminIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);

    // iOS일 경우 안내 모달 내용 교체
    if (isAdminIOS) {
      document.getElementById('admGuideEmoji').textContent = '🍎';
    }
    applyInstallGuideText();

    if (!isAdminStandalone) {
      document.getElementById('adminInstallBtn').style.display = '';

      window.addEventListener('beforeinstallprompt', e => {
        e.preventDefault();
        deferredAdminPrompt = e;
      });
    }

    window.addEventListener('appinstalled', () => {
      deferredAdminPrompt = null;
      document.getElementById('adminInstallBtn').style.display = 'none';
    });

    function triggerAdminInstall() {
      if (deferredAdminPrompt) {
        deferredAdminPrompt.prompt();
        deferredAdminPrompt.userChoice.then(({ outcome }) => {
          if (outcome === 'accepted') {
            deferredAdminPrompt = null;
            document.getElementById('adminInstallBtn').style.display = 'none';
          }
        });
      } else {
        document.getElementById('adminInstallGuide').style.display = 'flex';
      }
    }

    function closeAdminGuide() {
      document.getElementById('adminInstallGuide').style.display = 'none';
    }

    // ── 서비스워커 등록 ──
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/admin-sw.js', { scope: '/wolkoadmin' })
          .catch(e => console.warn('Admin SW registration failed:', e));
      });
    }
  </script>

  <!-- 앱 설치 안내 모달 -->
  <div id="adminInstallGuide" style="display:none;position:fixed;inset:0;background:rgba(0,15,30,.55);backdrop-filter:blur(7px);z-index:9999;align-items:center;justify-content:center;padding:1rem;" onclick="if(event.target===this)closeAdminGuide()">
    <div style="background:#fff;border-radius:20px;max-width:320px;width:100%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.25);">
      <div style="display:flex;justify-content:flex-end;padding:.8rem 1rem .2rem;">
        <button onclick="closeAdminGuide()" style="background:none;border:none;font-size:1.4rem;color:#aaa;cursor:pointer;line-height:1;">×</button>
      </div>
      <div style="padding:.4rem 1.5rem 1.8rem;text-align:center;">
        <div id="admGuideEmoji" style="font-size:2.2rem;margin-bottom:.8rem;">📲</div>
        <h3 id="admGuideTitle" style="margin:0 0 .5rem;font-size:1.05rem;color:#004f68;">앱으로 설치하기</h3>
        <p id="admGuideDesc" style="font-size:.83rem;color:#5a6f79;margin:0 0 1.2rem;line-height:1.6;">Chrome 브라우저 메뉴에서 설치할 수 있어요.</p>
        <ol id="admGuideSteps" style="text-align:left;font-size:.86rem;line-height:2.1;color:#2d4a56;padding-left:1.2rem;margin:0 0 1.4rem;">
          <li>오른쪽 상단 <strong>⋮ 메뉴</strong> 탭</li>
          <li><strong>"홈 화면에 추가"</strong> 선택</li>
          <li><strong>"추가"</strong> 탭</li>
        </ol>
        <button id="admGuideOk" onclick="closeAdminGuide()" style="width:100%;padding:.75rem;background:#004f68;color:#fff;border:none;border-radius:10px;font-size:.93rem;font-weight:700;cursor:pointer;">확인</button>
      </div>
    </div>
  </div>
</body>
</html>
