---
// Admin page — password protected via /api/admin/login
// No BaseLayout; standalone page
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>관리자 — WOLKO 캠프 신청 현황</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Noto+Sans+KR:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolkoadmin.css?v=2">
</head>
<body>

  <!-- ── LOGIN SCREEN ── -->
  <div class="login-screen" id="loginScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title">관리자 로그인</p>
      <div class="login-input-wrap">
        <input class="login-input" type="password" id="pwInput" placeholder="비밀번호를 입력하세요" autocomplete="current-password">
        <button class="login-eye" id="eyeBtn" onclick="togglePw()" type="button" aria-label="비밀번호 표시">
          <svg id="eyeIcon" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M1 9C2.5 5.5 5.5 3 9 3s6.5 2.5 8 6c-1.5 3.5-4.5 6-8 6S2.5 12.5 1 9z" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
      <p class="login-error" id="loginError"></p>
      <button class="login-btn" id="loginBtn" onclick="doLogin()">로그인</button>
    </div>
  </div>

  <!-- ── HEADER ── -->
  <header class="adm-header">
    <a class="adm-header-logo" href="/">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <span>WOLKO 관리자</span>
    </a>
    <div class="adm-header-right">
      <a href="/admin" target="_blank" class="adm-header-badge" style="text-decoration:none;cursor:pointer;" title="콘텐츠 편집 CMS">✏️ 콘텐츠 CMS</a>
      <span class="adm-header-badge">CAMP ADMIN</span>
      <button class="btn-logout" onclick="doLogout()">로그아웃</button>
    </div>
  </header>

  <div class="adm-wrap">
    <!-- CAMP CARDS -->
    <div class="camp-cards" id="campCards"></div>

    <!-- STATS TABLE -->
    <div class="stats-wrap">
      <table class="stats-tbl">
        <thead>
          <tr>
            <th>총 신청</th>
            <th class="c-green">확정</th>
            <th class="c-orange">미확정</th>
            <th>잔여 정원</th>
            <th class="c-amber">예비 신청</th>
            <th class="c-teal">스태프 지원</th>
            <th>마감률</th>
            <th class="c-blue">남학생 (확정)</th>
            <th class="c-pink">여학생 (확정)</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>
              <strong class="sv" id="dTotal">—</strong>
              <small id="dTotalSub">불러오는 중…</small>
            </td>
            <td>
              <strong class="sv c-green" id="dConfirmed">—</strong>
              <small id="dConfirmedSub">명 확정 완료</small>
            </td>
            <td>
              <strong class="sv c-orange" id="dPending">—</strong>
              <small id="dPendingSub">입금 대기 중</small>
            </td>
            <td>
              <strong class="sv c-green" id="dRemain">—</strong>
              <small id="dRemainSub">정원 기준</small>
            </td>
            <td>
              <strong class="sv c-amber" id="dWaitlist">—</strong>
              <small id="dWaitlistSub">예비 대기 인원</small>
            </td>
            <td>
              <strong class="sv c-teal" id="dStaff">—</strong>
              <small id="dStaffSub">지원 현황</small>
            </td>
            <td>
              <strong class="sv" id="dPct">—</strong>
              <small id="dPctSub">확정 / 정원</small>
            </td>
            <td>
              <strong class="sv c-blue" id="dMale">—</strong>
              <small>확정 기준</small>
            </td>
            <td>
              <strong class="sv c-pink" id="dFemale">—</strong>
              <small>확정 기준</small>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- PROGRESS -->
    <div class="progress-wrap">
      <div class="progress-header">
        <span class="progress-title" id="progressLabel">전체 정원 현황</span>
        <span class="progress-pct" id="progressPct">0%</span>
      </div>
      <div class="progress-bar-bg" style="display:flex;overflow:hidden;border-radius:999px;">
        <div class="progress-bar-fill" id="progressFillM" style="width:0%;background:#3b82f6;border-radius:0;transition:width 0.6s ease;flex-shrink:0;height:100%"></div>
        <div class="progress-bar-fill" id="progressFillF" style="width:0%;background:#ec4899;border-radius:0;transition:width 0.6s ease;flex-shrink:0;height:100%"></div>
      </div>
      <div style="display:flex;justify-content:space-between;margin-top:6px;font-size:11px;font-weight:600;">
        <span id="progressGenderM" style="color:#3b82f6"></span>
        <span id="progressGenderF" style="color:#ec4899"></span>
      </div>
    </div>

    <!-- 캠프 신청 TABLE -->
    <div class="table-section">
      <div class="table-toolbar">
        <div>
          <span class="table-title">캠프 신청 목록</span>
          <span class="table-count" id="campTableCount"></span>
        </div>
        <button class="btn-csv" onclick="downloadCsv('camp')">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M7 1v8M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          CSV 다운로드
        </button>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th><button class="sort-btn" type="button" data-sort="status">상태</button></th>
              <th><button class="sort-btn" type="button" data-sort="camp">캠프</button></th>
              <th><button class="sort-btn" type="button" data-sort="type">유형</button></th>
              <th><button class="sort-btn" type="button" data-sort="name">이름</button></th>
              <th><button class="sort-btn" type="button" data-sort="phone">연락처</button></th>
              <th><button class="sort-btn" type="button" data-sort="email">이메일</button></th>
              <th><button class="sort-btn" type="button" data-sort="grade">학년 / 인원</button></th>
              <th><button class="sort-btn" type="button" data-sort="gender">성별</button></th>
              <th><button class="sort-btn" type="button" data-sort="church">교회</button></th>
              <th><button class="sort-btn" type="button" data-sort="school">학교</button></th>
              <th><button class="sort-btn" type="button" data-sort="emergency">비상연락처</button></th>
              <th><button class="sort-btn" type="button" data-sort="notes">메모</button></th>
              <th><button class="sort-btn" type="button" data-sort="registeredAt">신청일시</button></th>
              <th>삭제</th>
            </tr>
          </thead>
          <tbody id="campRegBody">
            <tr><td colspan="15">
              <div class="state-box">
                <div class="spinner"></div>
                <p>로그인 후 자동으로 불러옵니다.</p>
              </div>
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- 스태프 지원 TABLE -->
    <div class="table-section" style="margin-top:20px;">
      <div class="table-toolbar">
        <div>
          <span class="table-title" style="color:#0d9488;">스태프 · 봉사자 지원 목록</span>
          <span class="table-count" id="staffTableCount"></span>
        </div>
        <button class="btn-csv" onclick="downloadCsv('staff')" style="background:rgba(13,148,136,0.08);color:#0d9488;border-color:rgba(13,148,136,0.2);">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M7 1v8M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          CSV 다운로드
        </button>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>#</th>
              <th><button class="sort-btn" type="button" data-sort="camp">캠프</button></th>
              <th><button class="sort-btn" type="button" data-sort="name">이름</button></th>
              <th><button class="sort-btn" type="button" data-sort="phone">연락처</button></th>
              <th><button class="sort-btn" type="button" data-sort="email">이메일</button></th>
              <th><button class="sort-btn" type="button" data-sort="church">교회</button></th>
              <th><button class="sort-btn" type="button" data-sort="serviceArea">섬기고 싶은 분야</button></th>
              <th><button class="sort-btn" type="button" data-sort="registeredAt">신청일시</button></th>
              <th>삭제</th>
            </tr>
          </thead>
          <tbody id="staffRegBody">
            <tr><td colspan="9">
              <div class="state-box">
                <div class="spinner"></div>
                <p>로그인 후 자동으로 불러옵니다.</p>
              </div>
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ── CMS LINK ── -->
    <div style="margin-top:8px;">
      <a href="/admin" target="_blank" style="display:inline-flex;align-items:center;gap:10px;padding:14px 24px;background:#fff;border:1.5px solid rgba(0,79,104,0.14);border-radius:12px;color:#004f68;font-size:14px;font-weight:600;text-decoration:none;transition:box-shadow 0.15s,border-color 0.15s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(0,79,104,0.10)';this.style.borderColor='rgba(0,79,104,0.3)'" onmouseout="this.style.boxShadow='';this.style.borderColor='rgba(0,79,104,0.14)'">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
        콘텐츠 편집 (CMS) — wolko.org/admin
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.4"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </div>

  </div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <script is:inline>
    const CAMP_GROUPS = [
      {
        group: 'wolko',
        label: 'WOLKO 캠프',
        camps: [
          { id: '2026-inland-english-junior', title: '2026 여름 주니어 영어 캠프', dateKo: '7월 27일 – 8월 1일', capacity: 40 },
          { id: '2026-inland-union',          title: '2026 교회 연합캠프',   dateKo: '8월 6일 – 8일',    capacity: 40 },
        ],
      },
      // 제주 캠프는 카페에서 별도 신청 — 추후 필요 시 아래 주석 해제
      // {
      //   group: 'jeju',
      //   label: 'JEJU 캠프',
      //   camps: [
      //     { id: '2026-jeju-english',    title: '제주 영어캠프', capacity: 60 },
      //     { id: '2026-jeju-momentum-1', title: '모멘텀 1차',    capacity: 60 },
      //     { id: '2026-jeju-momentum-2', title: '모멘텀 2차',    capacity: 60 },
      //   ],
      // },
    ];
    const CAMPS_ALL = [{ id: 'all', title: '전체 캠프', capacity: 80 }]
      .concat(CAMP_GROUPS.flatMap(g => g.camps));
    const CAMP_LABELS = Object.fromEntries(CAMPS_ALL.map(c => [c.id, c.title]));
    const CAMP_CAP    = Object.fromEntries(CAMPS_ALL.map(c => [c.id, c.capacity]));
    const CAMP_DATES  = Object.fromEntries(CAMPS_ALL.map(c => [c.id, c.dateKo || '']));
    const CAMP_ROW_STYLES = {
      '2026-inland-english-junior': { bg: '#e6f5ff', border: '#3797c7' },
      '2026-inland-union': { bg: '#fff1c9', border: '#d49a18' },
      '2026-jeju-english': { bg: '#e2f8ea', border: '#35a96a' },
      '2026-jeju-momentum-1': { bg: '#f0e8ff', border: '#8364d8' },
      '2026-jeju-momentum-2': { bg: '#ffe6ef', border: '#d86491' },
      '2026-test-camp': { bg: '#edf4f7', border: '#7899a9' },
    };
    const CAMP_ROW_FALLBACK = { bg: '#eef4f7', border: '#7f9bab' };

    function getCampRowStyle(reg) {
      if (CAMP_ROW_STYLES[reg.campId]) return CAMP_ROW_STYLES[reg.campId];

      const label = String(CAMP_LABELS[reg.campId] || reg.campName || reg.campTitle || reg.campId || '').toLowerCase();
      if (label.includes('junior') || label.includes('주니어')) return CAMP_ROW_STYLES['2026-inland-english-junior'];
      if (label.includes('union') || label.includes('unity') || label.includes('연합')) return CAMP_ROW_STYLES['2026-inland-union'];
      if (label.includes('momentum') || label.includes('모멘텀 1') || label.includes('1차')) return CAMP_ROW_STYLES['2026-jeju-momentum-1'];
      if (label.includes('모멘텀 2') || label.includes('2차')) return CAMP_ROW_STYLES['2026-jeju-momentum-2'];
      if (label.includes('jeju') || label.includes('제주')) return CAMP_ROW_STYLES['2026-jeju-english'];
      return CAMP_ROW_FALLBACK;
    }

    let allRegs = [];
    let activeCamp = 'all';
    let sortState = { key: 'registeredAt', direction: 'desc' };
    let authToken = sessionStorage.getItem('wolko-admin-token') || '';

    // ── Login ──
    function togglePw() {
      const input = document.getElementById('pwInput');
      const icon = document.getElementById('eyeIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = `<path d="M2 2l14 14M7.5 7.6A2.5 2.5 0 0011.4 11.5M5.2 5.3C3.3 6.5 1.9 7.9 1 9c1.5 3.5 4.5 6 8 6 1.4 0 2.8-.4 4-1M9 3C12.5 3 15.5 5.5 17 9c-.5 1.1-1.2 2.1-2 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`;
      } else {
        input.type = 'password';
        icon.innerHTML = `<path d="M1 9C2.5 5.5 5.5 3 9 3s6.5 2.5 8 6c-1.5 3.5-4.5 6-8 6S2.5 12.5 1 9z" stroke="currentColor" stroke-width="1.5"/><circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>`;
      }
    }

    document.getElementById('pwInput').addEventListener('keydown', e => {
      if (e.key === 'Enter') doLogin();
    });

    async function doLogin() {
      const pw = document.getElementById('pwInput').value;
      const btn = document.getElementById('loginBtn');
      const errEl = document.getElementById('loginError');
      const inputEl = document.getElementById('pwInput');
      if (!pw) { errEl.textContent = '비밀번호를 입력해주세요.'; return; }

      btn.disabled = true;
      btn.textContent = '확인 중…';
      errEl.textContent = '';
      inputEl.classList.remove('error');

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pw }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '로그인 실패');

        authToken = data.token;
        sessionStorage.setItem('wolko-admin-token', authToken);

        const screen = document.getElementById('loginScreen');
        screen.classList.add('hidden');
        setTimeout(() => screen.style.display = 'none', 400);
        loadRegs();
      } catch (e) {
        errEl.textContent = e.message;
        inputEl.classList.add('error');
      } finally {
        btn.disabled = false;
        btn.textContent = '로그인';
      }
    }

    function doLogout() {
      sessionStorage.removeItem('wolko-admin-token');
      authToken = '';
      location.reload();
    }

    function authHeaders() {
      return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${authToken}` };
    }

    // ── Camp cards ──
    function makeCard(id, kicker, title, capacity) {
      const card = document.createElement('div');
      card.className = 'camp-card' + (id === 'all' ? ' active' : '');
      card.dataset.id = id;
      card.innerHTML = `
        <div class="camp-card-top">
          <span class="camp-card-kicker">${kicker}</span>
          <span class="camp-card-badge">선택됨</span>
        </div>
        <div class="camp-card-title">${title}</div>
        <div class="camp-card-stats">
          <div class="camp-card-stat">
            <div class="camp-card-stat-val" id="card-${id}-reg">—</div>
            <div class="camp-card-stat-lbl">신청</div>
          </div>
          <div class="camp-card-sep"></div>
          <div class="camp-card-stat">
            <div class="camp-card-stat-val green" id="card-${id}-cap">—</div>
            <div class="camp-card-stat-lbl">잔여</div>
          </div>
        </div>
      `;
      card.onclick = () => selectCamp(id);
      return card;
    }

    function buildCampCards() {
      const wrap = document.getElementById('campCards');
      wrap.innerHTML = '';
      wrap.appendChild(makeCard('all', '전체', '전체 캠프', 100));
      CAMP_GROUPS.flatMap(g => g.camps).forEach(c => {
        wrap.appendChild(makeCard(c.id, `WOLKO · 정원 ${c.capacity}명`, c.title, c.capacity));
      });
    }

    function updateCardStats() {
      CAMPS_ALL.forEach(c => {
        const regs = (c.id === 'all' ? allRegs : allRegs.filter(r => r.campId === c.id))
          .filter(r => r.registrationType !== 'staff');
        const total = regs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
        const remain = Math.max(0, c.capacity - total);
        const regEl = document.getElementById(`card-${c.id}-reg`);
        const capEl = document.getElementById(`card-${c.id}-cap`);
        if (regEl) regEl.textContent = total;
        if (capEl) capEl.textContent = remain;
      });
    }

    function selectCamp(id) {
      activeCamp = id;
      document.querySelectorAll('.camp-card').forEach(c =>
        c.classList.toggle('active', c.dataset.id === id)
      );
      renderTable();
      renderDash();
    }

    buildCampCards();

    // ── Fetch ──
    async function loadRegs() {
      try {
        const res = await fetch('/api/admin/registrations', { headers: authHeaders() });
        if (res.status === 401) {
          sessionStorage.removeItem('wolko-admin-token');
          location.reload();
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        allRegs = data.registrations || [];
        updateCardStats();
        renderTable();
        renderDash();
      } catch (e) {
        showToast('데이터를 불러오지 못했습니다: ' + e.message, 'error');
        const errHtml = `<div class="state-box"><svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" stroke="#c42a36" stroke-width="2"/><path d="M20 12v10M20 26v2" stroke="#c42a36" stroke-width="2" stroke-linecap="round"/></svg><p>데이터를 불러오지 못했습니다.<br>잠시 후 다시 시도해주세요.</p></div>`;
        document.getElementById('campRegBody').innerHTML  = `<tr><td colspan="15">${errHtml}</td></tr>`;
        document.getElementById('staffRegBody').innerHTML = `<tr><td colspan="9">${errHtml}</td></tr>`;
      }
    }

    function filteredRegs() {
      if (activeCamp === 'all') return allRegs;
      return allRegs.filter(r => r.campId === activeCamp);
    }

    function sortValue(reg, key) {
      if (key === 'camp') return CAMP_LABELS[reg.campId] || reg.campId || '';
      if (key === 'type') return reg.registrationType === 'group' ? '단체' : '개인';
      if (key === 'status') return reg.confirmed === false ? '미확정' : '확정';
      if (key === 'grade') return reg.registrationType === 'group' ? (reg.groupCount || 0) : (reg.grade || '');
      if (key === 'gender') {
        if (reg.registrationType === 'group') return `${reg.maleCount || 0}-${reg.femaleCount || 0}`;
        return reg.gender || '';
      }
      if (key === 'registeredAt') return new Date(reg.registeredAt || 0).getTime();
      return String(reg[key] || '').trim();
    }

    function sortedRegs(regs) {
      const { key, direction } = sortState;
      const dir = direction === 'asc' ? 1 : -1;
      return [...regs].sort((a, b) => {
        const av = sortValue(a, key);
        const bv = sortValue(b, key);
        if (typeof av === 'number' && typeof bv === 'number') return (av - bv) * dir;
        return String(av).localeCompare(String(bv), ['ko', 'en'], { numeric: true, sensitivity: 'base' }) * dir;
      });
    }

    function updateSortButtons() {
      document.querySelectorAll('.sort-btn').forEach(btn => {
        const active = btn.dataset.sort === sortState.key;
        btn.classList.toggle('active', active);
        btn.dataset.direction = active ? sortState.direction : '';
        btn.setAttribute('aria-sort', active ? (sortState.direction === 'asc' ? 'ascending' : 'descending') : 'none');
      });
    }

    document.querySelectorAll('.sort-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sort;
        sortState = {
          key,
          direction: sortState.key === key && sortState.direction === 'asc' ? 'desc' : 'asc',
        };
        renderTable();
      });
    });

    // ── Dashboard ──
    function renderDash() {
      const regs = filteredRegs();
      const cap = CAMP_CAP[activeCamp] || 280;

      // 스태프 신청은 정원 집계에서 제외
      const campRegs = regs.filter(r => r.registrationType !== 'staff');

      // 확정/미확정 분리 (confirmed === undefined = 구 데이터 = 확정된 것으로 취급)
      const confirmedRegs = campRegs.filter(r => r.confirmed !== false);
      const pendingRegs   = campRegs.filter(r => r.confirmed === false);

      const total     = campRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const confirmed = confirmedRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const pending   = pendingRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const remain    = Math.max(0, cap - confirmed);
      const pct       = cap > 0 ? Math.round((confirmed / cap) * 100) : 0;

      // 성별 (확정 기준)
      const maleTotal = confirmedRegs.reduce((s, r) =>
        r.registrationType === 'group' ? s + (r.maleCount || 0) : s + (r.gender === 'male' ? 1 : 0), 0);
      const femaleTotal = confirmedRegs.reduce((s, r) =>
        r.registrationType === 'group' ? s + (r.femaleCount || 0) : s + (r.gender === 'female' ? 1 : 0), 0);

      const waitlistRegs = campRegs.filter(r => r.isWaitlist === true);
      const waitlistCount = waitlistRegs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);

      const staffRegs = regs.filter(r => r.registrationType === 'staff');
      const staffCount = staffRegs.length;

      document.getElementById('dTotal').textContent = total;
      document.getElementById('dTotalSub').textContent = `명 (확정 ${confirmed} / 미확정 ${pending})`;
      document.getElementById('dConfirmed').textContent = confirmed;
      document.getElementById('dConfirmedSub').textContent = confirmed > 0 ? `명 확정 완료` : '없음';
      document.getElementById('dPending').textContent = pending;
      document.getElementById('dPendingSub').textContent = pending > 0 ? `명 입금 대기` : '없음';
      document.getElementById('dWaitlist').textContent = waitlistCount;
      document.getElementById('dWaitlistSub').textContent = waitlistCount > 0 ? `명 예비 대기` : '없음';
      document.getElementById('dStaff').textContent = staffCount;
      document.getElementById('dStaffSub').textContent = staffCount > 0 ? `명 지원` : '없음';
      document.getElementById('dMale').textContent = maleTotal;
      document.getElementById('dFemale').textContent = femaleTotal;
      document.getElementById('dRemain').textContent = remain;
      document.getElementById('dRemainSub').textContent = `정원 ${cap}명 기준`;
      document.getElementById('dPct').textContent = pct + '%';
      document.getElementById('dPct').className = 'sv' + (pct >= 100 ? ' c-red' : pct >= 80 ? ' c-orange' : '');
      document.getElementById('dPctSub').textContent = `${confirmed} / ${cap}`;

      const campName = CAMP_LABELS[activeCamp] || '전체';
      document.getElementById('progressLabel').textContent = campName + ' 정원 현황 (확정 기준)';
      document.getElementById('progressPct').textContent = pct + '%';

      const fillM = document.getElementById('progressFillM');
      const fillF = document.getElementById('progressFillF');
      if (maleTotal > 0 || femaleTotal > 0) {
        fillM.style.width = Math.min((maleTotal / cap) * 100, 100) + '%';
        fillF.style.width = Math.min((femaleTotal / cap) * 100, 100) + '%';
      } else if (confirmed > 0) {
        fillM.style.width = Math.min((confirmed / cap) * 100, 100) + '%';
        fillF.style.width = '0%';
      } else {
        fillM.style.width = '0%';
        fillF.style.width = '0%';
      }

      document.getElementById('progressGenderM').textContent = maleTotal > 0 ? `남 ${maleTotal}명` : '';
      document.getElementById('progressGenderF').textContent = femaleTotal > 0 ? `여 ${femaleTotal}명` : '';
    }

    // ── Tables ──
    function renderTable() {
      updateSortButtons();
      renderCampTable();
      renderStaffTable();
    }

    function renderCampTable() {
      const regs = sortedRegs(filteredRegs().filter(r => r.registrationType !== 'staff'));
      const tbody = document.getElementById('campRegBody');
      document.getElementById('campTableCount').textContent = `(${regs.length}건)`;

      if (regs.length === 0) {
        tbody.innerHTML = `
          <tr><td colspan="15">
            <div class="state-box">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                <rect x="8" y="6" width="24" height="30" rx="3" stroke="#8fa8b5" stroke-width="2"/>
                <path d="M14 14h12M14 20h8M14 26h6" stroke="#8fa8b5" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <p>캠프 신청 내역이 없습니다.</p>
            </div>
          </td></tr>`;
        return;
      }

      tbody.innerHTML = regs.map((r, i) => {
        const date = new Date(r.registeredAt);
        const dateStr = `${date.getFullYear()}.${String(date.getMonth()+1).padStart(2,'0')}.${String(date.getDate()).padStart(2,'0')} ${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`;
        const campLabel = CAMP_LABELS[r.campId] || r.campId;
        const typeBadge = r.registrationType === 'staff'
          ? `<span class="badge" style="background:rgba(13,148,136,0.12);color:#0d9488;">스태프</span>`
          : r.registrationType === 'group'
          ? `<span class="badge badge-group">단체</span>`
          : `<span class="badge badge-individual">개인</span>`;
        const gradeOrCount = r.registrationType === 'group' ? `${r.groupCount}명` : (r.grade || '—');

        let genderCell;
        if (r.registrationType === 'group') {
          const m = r.maleCount || 0, f = r.femaleCount || 0;
          genderCell = (m > 0 || f > 0)
            ? `<span style="font-size:12px;white-space:nowrap"><span style="color:#3b82f6;font-weight:600">남 ${m}</span> · <span style="color:#ec4899;font-weight:600">여 ${f}</span></span>`
            : `<span style="color:var(--light)">—</span>`;
        } else {
          genderCell = r.gender === 'male'
            ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(59,130,246,0.12);color:#2563eb;font-size:11px;font-weight:700;">남</span>`
            : r.gender === 'female'
            ? `<span style="display:inline-block;padding:2px 10px;border-radius:100px;background:rgba(236,72,153,0.12);color:#db2777;font-size:11px;font-weight:700;">여</span>`
            : `<span style="color:var(--light)">—</span>`;
        }

        // 상태 셀: 확정=초록, 미확정=주황, 예비=amber 배지 추가
        const isConfirmed = r.confirmed !== false;
        const waitlistBadge = r.isWaitlist
          ? `<span style="display:inline-block;padding:2px 7px;border-radius:100px;background:rgba(217,119,6,0.15);color:#b45309;font-size:10px;font-weight:700;margin-left:3px;">예비${r.waitlistNumber ? ' ' + r.waitlistNumber : ''}</span>`
          : '';
        const statusCell = isConfirmed
          ? `<span style="display:inline-flex;align-items:center;gap:2px;"><span style="display:inline-block;padding:2px 8px;border-radius:100px;background:rgba(22,163,74,0.12);color:#16a34a;font-size:11px;font-weight:700;">확정</span>${waitlistBadge}</span>`
          : `<span style="display:inline-flex;align-items:center;gap:4px;flex-wrap:nowrap;white-space:nowrap;">
               <span style="display:inline-flex;align-items:center;gap:2px;"><span style="display:inline-block;padding:2px 8px;border-radius:100px;background:rgba(217,119,6,0.12);color:#d97706;font-size:11px;font-weight:700;">미확정</span>${waitlistBadge}</span>
               <button class="btn-confirm" onclick="confirmReg('${r.regId}','${r.campId}')">확정</button>
             </span>`;
        const campStyle = getCampRowStyle(r);
        const rowClass = `camp-tint${isConfirmed ? '' : ' is-pending'}`;
        const rowStyle = `--camp-row-bg:${campStyle.bg};--camp-row-border:${campStyle.border};`;

        return `<tr class="${rowClass}" style="${rowStyle}">
          <td style="color:var(--light);font-family:var(--f-sans)">${i + 1}</td>
          <td>${statusCell}</td>
          <td class="camp-name-cell" style="font-size:12px">${esc(campLabel)}</td>
          <td>${typeBadge}</td>
          <td style="font-weight:600">${esc(r.name)}</td>
          <td>${esc(r.phone)}</td>
          <td style="font-size:12px;color:var(--mid)">${esc(r.email)}</td>
          <td style="font-family:var(--f-sans);font-size:12px">${esc(gradeOrCount)}</td>
          <td>${genderCell}</td>
          <td>${esc(r.church || '—')}</td>
          <td>${esc(r.school || '—')}</td>
          <td style="font-size:12px">${esc(r.emergency || '—')}</td>
          <td style="font-size:12px;color:var(--mid);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(r.notes || '')}">${esc(r.notes || '—')}</td>
          <td style="font-size:12px;color:var(--mid);white-space:nowrap">${dateStr}</td>
          <td><button class="btn-del" onclick="deleteReg('${r.regId}','${r.campId}')">삭제</button></td>
        </tr>`;
      }).join('');
    }

    function renderStaffTable() {
      const regs = sortedRegs(filteredRegs().filter(r => r.registrationType === 'staff'));
      const tbody = document.getElementById('staffRegBody');
      document.getElementById('staffTableCount').textContent = `(${regs.length}건)`;

      if (regs.length === 0) {
        tbody.innerHTML = `
          <tr><td colspan="9">
            <div class="state-box">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                <rect x="8" y="6" width="24" height="30" rx="3" stroke="#8fa8b5" stroke-width="2"/>
                <path d="M14 14h12M14 20h8M14 26h6" stroke="#8fa8b5" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <p>스태프 지원 내역이 없습니다.</p>
            </div>
          </td></tr>`;
        return;
      }

      tbody.innerHTML = regs.map((r, i) => {
        const date = new Date(r.registeredAt);
        const dateStr = `${date.getFullYear()}.${String(date.getMonth()+1).padStart(2,'0')}.${String(date.getDate()).padStart(2,'0')} ${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`;
        const campLabel = CAMP_LABELS[r.campId] || r.campId;
        const serviceArea = r.serviceArea || r.notes || '—';
        const campStyle = getCampRowStyle(r);
        const rowStyle = `--camp-row-bg:${campStyle.bg};--camp-row-border:${campStyle.border};`;
        return `<tr class="camp-tint" style="${rowStyle}">
          <td style="color:var(--light);font-family:var(--f-sans)">${i + 1}</td>
          <td class="camp-name-cell" style="font-size:12px">${esc(campLabel)}</td>
          <td style="font-weight:600">${esc(r.name)}</td>
          <td>${esc(r.phone)}</td>
          <td style="font-size:12px;color:var(--mid)">${esc(r.email)}</td>
          <td>${esc(r.church || '—')}</td>
          <td style="font-size:12px;color:var(--mid);max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(serviceArea)}">${esc(serviceArea)}</td>
          <td style="font-size:12px;color:var(--mid);white-space:nowrap">${dateStr}</td>
          <td><button class="btn-del" onclick="deleteReg('${r.regId}','${r.campId}')">삭제</button></td>
        </tr>`;
      }).join('');
    }

    function esc(str) {
      return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Delete ──
    async function deleteReg(regId, campId) {
      if (!confirm(`정말 삭제하시겠습니까?\n이 작업은 되돌릴 수 없습니다.`)) return;
      try {
        const res = await fetch(`/api/admin/registrations?regId=${regId}&campId=${campId}`, {
          method: 'DELETE', headers: authHeaders()
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '삭제 실패');
        allRegs = allRegs.filter(r => r.regId !== regId);
        renderTable();
        renderDash();
        showToast('신청이 삭제되었습니다.', 'success');
      } catch (e) {
        showToast('삭제 오류: ' + e.message, 'error');
      }
    }

    // ── Confirm ──
    async function confirmReg(regId, campId) {
      if (!confirm(`신청을 확정하시겠습니까?\n입금이 확인된 경우에만 확정해주세요.`)) return;
      try {
        const res = await fetch('/api/admin/registrations', {
          method: 'PATCH',
          headers: authHeaders(),
          body: JSON.stringify({ regId, campId, campTitleKo: CAMP_LABELS[campId] || campId, campDateKo: CAMP_DATES[campId] || '' }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '확정 실패');
        // 로컬 데이터 업데이트
        const reg = allRegs.find(r => r.regId === regId);
        if (reg) { reg.confirmed = true; reg.confirmedAt = data.reg?.confirmedAt || new Date().toISOString(); }
        renderTable();
        renderDash();
        updateCardStats();
        showToast('신청이 확정되었습니다.', 'success');
      } catch (e) {
        showToast('확정 오류: ' + e.message, 'error');
      }
    }

    // ── CSV ──
    function downloadCsv(type = 'camp') {
      const campName = CAMP_LABELS[activeCamp] || '전체';
      const today = new Date().toISOString().slice(0, 10);
      const bom = '﻿';

      if (type === 'staff') {
        const regs = sortedRegs(filteredRegs().filter(r => r.registrationType === 'staff'));
        if (regs.length === 0) { showToast('다운로드할 스태프 데이터가 없습니다.', 'error'); return; }
        const headers = ['번호','캠프','이름','연락처','이메일','교회','섬기고 싶은 분야','신청일시','RegID'];
        const rows = regs.map((r, i) => {
          const date = new Date(r.registeredAt).toLocaleString('ko-KR');
          return [
            i + 1, CAMP_LABELS[r.campId] || r.campId,
            r.name, r.phone, r.email, r.church || '',
            r.serviceArea || r.notes || '', date, r.regId,
          ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(',');
        });
        const csv = bom + [headers.join(','), ...rows].join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `WOLKO_스태프지원_${campName}_${today}.csv`;
        a.click(); URL.revokeObjectURL(url);
        showToast('스태프 CSV 다운로드 완료!', 'success');
      } else {
        const regs = sortedRegs(filteredRegs().filter(r => r.registrationType !== 'staff'));
        if (regs.length === 0) { showToast('다운로드할 신청 데이터가 없습니다.', 'error'); return; }
        const headers = ['번호','상태','캠프','유형','이름','연락처','이메일','학년/인원','성별','교회','학교','비상연락처','메모','신청일시','RegID'];
        const rows = regs.map((r, i) => {
          const date = new Date(r.registeredAt).toLocaleString('ko-KR');
          const gradeOrCount = r.registrationType === 'group' ? `단체 ${r.groupCount}명` : (r.grade || '');
          const statusVal = r.confirmed !== false ? '확정' : '미확정';
          let genderVal;
          if (r.registrationType === 'group') {
            const m = r.maleCount || 0, f = r.femaleCount || 0;
            genderVal = (m > 0 || f > 0) ? `남 ${m} 여 ${f}` : '';
          } else {
            genderVal = r.gender === 'male' ? '남' : r.gender === 'female' ? '여' : '';
          }
          return [
            i + 1, statusVal, CAMP_LABELS[r.campId] || r.campId,
            r.registrationType === 'group' ? '단체' : '개인',
            r.name, r.phone, r.email, gradeOrCount, genderVal,
            r.church || '', r.school || '', r.emergency || '',
            r.notes || '', date, r.regId,
          ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(',');
        });
        const csv = bom + [headers.join(','), ...rows].join('\n');
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url; a.download = `WOLKO_신청목록_${campName}_${today}.csv`;
        a.click(); URL.revokeObjectURL(url);
        showToast('CSV 다운로드 완료!', 'success');
      }
    }

    // ── Toast ──
    let toastTimer;
    function showToast(msg, type = '') {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'toast show' + (type ? ' ' + type : '');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { t.className = 'toast'; }, 3000);
    }

    // ── Auto-login if token exists ──
    if (authToken) {
      document.getElementById('loginScreen').classList.add('hidden');
      setTimeout(() => { document.getElementById('loginScreen').style.display = 'none'; }, 0);
      loadRegs();
    }
  </script>
</body>
</html>
