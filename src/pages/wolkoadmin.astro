        thCounselor:'담당 카운슬러', thSalvation:'구원', thDedication:'헌신',
        thCounselorMemo:'상담자 메모', thPhone:'연락처', thEmail:'이메일',
        thGrade:'학년 / 인원', thGender:'성별', thChurch:'교회', thSchool:'학교',
        thEmergency:'비상연락처', thNotes:'메모', thDate:'신청일시', thDelete:'삭제',
        staffRegTitle:'스태프 · 봉사자 지원 목록', thTeam:'팀', thApplicantMemo:'신청자 메모',
        thBirthDate:'생년월일', thPreviousCamp:'캠프 경험', thTestimony:'자기소개·간증',
