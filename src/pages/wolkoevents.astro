---
// 이벤트 관리(RSVP) — 캠프 관리자(wolkoadmin)와 분리된 별도 페이지.
// 별도 관리자 비밀번호 없이 포탈(/portal) 세션 토큰(role admin/master)으로 접속한다.
// No BaseLayout; standalone page
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>이벤트 관리 — WOLKO RSVP 신청 현황</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Noto+Sans+KR:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/wolkoadmin.css?v=83">
  <link rel="stylesheet" href="/wolko-auth.css?v=1">
  <link rel="stylesheet" href="/wolko-rail.css?v=9">
  <link rel="stylesheet" href="/wolko-ui.css?v=1">
  <script src="/wolko-rail.js?v=9" defer></script>
  <meta name="theme-color" content="#a5482d">
  <script is:inline src="/wolko-session.js?v=1"></script>
</head>
<body>

  <!-- ── 포탈 로그인 안내 화면 ── 이 페이지는 별도 비밀번호 없이 포탈 세션(관리자/마스터)만으로 접속한다 -->
  <div class="login-screen" id="loginScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title" data-t="hubLoginTitle">포탈 로그인이 필요합니다</p>
      <p class="login-description" data-t="hubLoginDesc">이벤트 관리는 WOLKO 포탈 계정으로 접속합니다. 포탈에 로그인한 뒤 이벤트 관리 카드를 눌러 다시 접속해 주세요.</p>
      <a class="login-btn" href="/portal" style="display:block;text-align:center;text-decoration:none;" data-t="goToHubBtn">포탈로 이동</a>
    </div>
  </div>

  <!-- ── HEADER ── -->
  <header class="adm-header">
    <a class="adm-header-logo" href="/portal" title="WOLKO 포탈로 돌아가기">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <span data-t="adminTitle">이벤트 관리</span>
    </a>
    <div class="adm-header-right">
      <button type="button" class="adm-lang-switch" id="langToggleBtn" onclick="toggleAdminLang()" role="switch" aria-checked="false" aria-label="영어로 변경" title="영어로 변경" data-lang="ko">
        <span class="adm-lang-thumb" aria-hidden="true"></span>
        <span class="adm-lang-option adm-lang-ko"><img src="https://flagcdn.com/w20/kr.png" alt=""><span>KO</span></span>
        <span class="adm-lang-option adm-lang-en"><img src="https://flagcdn.com/w20/us.png" alt=""><span>EN</span></span>
      </button>
      <button class="adm-header-control btn-logout" onclick="doLogout()"><span data-t="logout">로그아웃</span></button>
    </div>
  </header>

  <div class="adm-wrap">
    <div class="table-section" id="rsvp">
      <div class="table-toolbar">
        <div>
          <span class="table-title" style="color:#a5482d;" data-t="rsvpTitle">감사의 밤 — 참석 신청(RSVP) 목록</span>
          <span class="table-count" id="rsvpTableCount"></span>
        </div>
        <div style="display:flex;gap:8px;align-items:center;">
          <button class="btn-csv" onclick="downloadRsvpCsv()" style="background:rgba(165,72,45,0.08);color:#a5482d;border-color:rgba(165,72,45,0.2);">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M7 1v8M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span data-t="csvDownload">CSV 다운로드</span>
          </button>
        </div>
      </div>
      <div class="table-scroll">
        <table class="staff-reg-table">
          <thead>
            <tr>
              <th><span data-t="thName">이름</span></th>
              <th><span data-t="thPhone">연락처</span></th>
              <th><span data-t="thEmail">이메일</span></th>
              <th><span data-t="thParty">참석 인원</span></th>
              <th><span data-t="thNotes">메모</span></th>
              <th><span data-t="thDate">신청일시</span></th>
            </tr>
          </thead>
          <tbody id="rsvpRegBody">
            <tr><td colspan="6">
              <div class="state-box">
                <div class="spinner"></div>
                <p data-t="loginFirst">로그인 후 자동으로 불러옵니다.</p>
              </div>
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <div style="margin-top:8px;display:flex;flex-wrap:wrap;gap:10px;">
      <a href="https://docs.google.com/spreadsheets/d/1UxxabXZJYUgbyqC-MnGDYDGgNwdY5l0jP2FUzB2xsJQ/edit?gid=0#gid=0" target="_blank" style="display:inline-flex;align-items:center;gap:10px;padding:14px 24px;background:#fff;border:1.5px solid rgba(22,163,74,0.2);border-radius:12px;color:#16a34a;font-size:14px;font-weight:600;text-decoration:none;transition:box-shadow 0.15s,border-color 0.15s;" onmouseover="this.style.boxShadow='0 4px 16px rgba(22,163,74,0.10)';this.style.borderColor='rgba(22,163,74,0.4)'" onmouseout="this.style.boxShadow='';this.style.borderColor='rgba(22,163,74,0.2)'">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg>
        신청 백업 시트 (Google Sheets)
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="opacity:0.4"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
      </a>
    </div>
  </div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <script is:inline>
    // ── Language System ──
    let adminLang = localStorage.getItem('wolkoAdminLang') || 'ko';
    const ADMIN_T = {
      ko: {
        pageTitle: '이벤트 관리 — WOLKO RSVP 신청 현황',
        adminTitle: '이벤트 관리', logout: '로그아웃', switchToEnglish: '영어로 변경', switchToKorean: '한국어로 변경',
        hubLoginTitle: '포탈 로그인이 필요합니다',
        hubLoginDesc: '이벤트 관리는 WOLKO 포탈 계정으로 접속합니다. 포탈에 로그인한 뒤 이벤트 관리 카드를 눌러 다시 접속해 주세요.',
        goToHubBtn: '포탈로 이동',
        rsvpTitle: '감사의 밤 — 참석 신청(RSVP) 목록', thName: '이름', thPhone: '연락처', thEmail: '이메일',
        thParty: '참석 인원', thNotes: '메모', thDate: '신청일시',
        csvDownload: 'CSV 다운로드', csvRsvpFile: 'RSVP_명단', csvNoRsvp: '다운로드할 RSVP 신청이 없습니다.', csvRsvpDone: 'RSVP 명단을 CSV로 저장했습니다.',
        loginFirst: '로그인 후 자동으로 불러옵니다.', dataLoadRetry: '데이터를 불러오지 못했습니다.<br>잠시 후 다시 시도해주세요.',
        noRsvpYet: '아직 참석 신청이 없습니다.',
      },
      en: {
        pageTitle: 'Event Management — WOLKO RSVP',
        adminTitle: 'Event Management', logout: 'Log Out', switchToEnglish: 'Switch to English', switchToKorean: 'Switch to Korean',
        hubLoginTitle: 'Portal login required',
        hubLoginDesc: 'Event Management now signs in with your WOLKO Portal account. Log in at the Portal, then open the Event Management card again.',
        goToHubBtn: 'Go to Portal',
        rsvpTitle: 'Night of Thanksgiving — RSVP List', thName: 'Name', thPhone: 'Phone', thEmail: 'Email',
        thParty: 'Party Size', thNotes: 'Notes', thDate: 'Submitted',
        csvDownload: 'Export CSV', csvRsvpFile: 'RSVP_List', csvNoRsvp: 'No RSVP entries to download.', csvRsvpDone: 'RSVP list saved as CSV.',
        loginFirst: 'Data will load after login.', dataLoadRetry: 'Could not load data.<br>Please try again shortly.',
        noRsvpYet: 'No RSVPs yet.',
      },
    };
    function t(key) { return ADMIN_T[adminLang]?.[key] ?? ADMIN_T.ko?.[key] ?? key; }
    function applyLangToDOM() {
      document.documentElement.lang = adminLang === 'en' ? 'en' : 'ko';
      document.title = t('pageTitle');
      document.querySelectorAll('[data-t]').forEach(el => {
        const v = t(el.dataset.t);
        if (typeof v === 'string') el.textContent = v;
      });
      const langToggle = document.getElementById('langToggleBtn');
      if (langToggle) {
        const isEnglish = adminLang === 'en';
        const nextLanguage = isEnglish ? t('switchToKorean') : t('switchToEnglish');
        langToggle.dataset.lang = adminLang;
        langToggle.setAttribute('aria-checked', String(isEnglish));
        langToggle.setAttribute('aria-label', nextLanguage);
        langToggle.title = nextLanguage;
      }
    }
    function toggleAdminLang() { setAdminLang(adminLang === 'ko' ? 'en' : 'ko'); }
    function setAdminLang(lang) {
      if (adminLang === lang) return;
      adminLang = lang;
      localStorage.setItem('wolkoAdminLang', adminLang);
      applyLangToDOM();
      loadRsvpData();
    }
    applyLangToDOM();

    function esc(str) {
      return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    let toastTimer;
    function showToast(msg, type = '') {
      const el = document.getElementById('toast');
      el.textContent = msg;
      el.className = 'toast show' + (type ? ' ' + type : '');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { el.className = 'toast'; }, 3000);
    }

    // ── Login ── 별도 비밀번호 없이 포탈 세션 토큰(role admin/master)만으로 접속
    function parseHubToken(token) {
      try {
        const decoded = atob(token);
        const lastColon = decoded.lastIndexOf(':');
        const data = decoded.slice(0, lastColon);
        const parts = data.split(':');
        if (parts[0] !== 'wolko-hub' || parts.length !== 4) return null;
        const expires = parseInt(parts[3], 10);
        if (!expires || Date.now() >= expires) return null;
        return { email: parts[1], role: parts[2], expires };
      } catch (e) {
        return null;
      }
    }
    function goToHub() {
      try { sessionStorage.removeItem('wolko-hub-token'); } catch (e) {}
      location.href = '/portal';
    }
    function doLogout() { goToHub(); }
    function authHeaders() {
      return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${sessionStorage.getItem('wolko-hub-token') || ''}` };
    }

    // ── 이벤트 참석 신청(RSVP) ──
    let rsvpEntries = [];
    async function loadRsvpData() {
      const body = document.getElementById('rsvpRegBody');
      const countEl = document.getElementById('rsvpTableCount');
      try {
        const res = await fetch('/api/rsvp?eventId=thanksgiving-night', { headers: authHeaders() });
        if (res.status === 401) { goToHub(); return; }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        rsvpEntries = data.rsvps || [];
        countEl.textContent = adminLang === 'en'
          ? `${data.totalRsvps ?? rsvpEntries.length} entries · ${data.totalGuests ?? 0} guests`
          : `${data.totalRsvps ?? rsvpEntries.length}건 · 총 ${data.totalGuests ?? 0}명`;
        if (rsvpEntries.length === 0) {
          body.innerHTML = `<tr><td colspan="6"><div class="state-box"><p>${t('noRsvpYet')}</p></div></td></tr>`;
          return;
        }
        const sorted = [...rsvpEntries].sort((a, b) => String(b.createdAt).localeCompare(String(a.createdAt)));
        body.innerHTML = sorted.map(r => `
          <tr>
            <td>${esc(r.name)}</td>
            <td>${esc(r.phone)}</td>
            <td>${esc(r.email)}</td>
            <td>${Number(r.partySize) || 0}${adminLang === 'en' ? '' : '명'}</td>
            <td>${esc(r.notes || '—')}</td>
            <td>${new Date(r.createdAt).toLocaleString('ko-KR')}</td>
          </tr>
        `).join('');
      } catch (e) {
        body.innerHTML = `<tr><td colspan="6"><div class="state-box"><svg width="40" height="40" viewBox="0 0 40 40" fill="none"><circle cx="20" cy="20" r="18" stroke="#c42a36" stroke-width="2"/><path d="M20 12v10M20 26v2" stroke="#c42a36" stroke-width="2" stroke-linecap="round"/></svg><p>${t('dataLoadRetry')}</p></div></td></tr>`;
      }
    }

    function downloadRsvpCsv() {
      if (rsvpEntries.length === 0) { showToast(t('csvNoRsvp'), 'error'); return; }
      const today = new Date().toISOString().slice(0, 10);
      const bom = '﻿';
      const headers = adminLang === 'en'
        ? ['No', 'Name', 'Phone', 'Email', 'Party Size', 'Notes', 'Submitted', 'RsvpID']
        : ['번호', '이름', '연락처', '이메일', '참석 인원', '메모', '신청일시', 'RsvpID'];
      const sorted = [...rsvpEntries].sort((a, b) => String(a.createdAt).localeCompare(String(b.createdAt)));
      const rows = sorted.map((r, i) => [
        i + 1, r.name, r.phone, r.email, Number(r.partySize) || 0, r.notes || '',
        new Date(r.createdAt).toLocaleString('ko-KR'), r.rsvpId,
      ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(','));
      const csv = bom + [headers.join(','), ...rows].join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `WOLKO_${t('csvRsvpFile')}_${today}.csv`;
      a.click(); URL.revokeObjectURL(url);
      showToast(t('csvRsvpDone'), 'success');
    }

    // ── 포탈 세션이 유효한 admin/master면 자동 입장 ──
    const hubToken = sessionStorage.getItem('wolko-hub-token') || '';
    const hubSession = hubToken ? parseHubToken(hubToken) : null;
    if (hubSession && (hubSession.role === 'admin' || hubSession.role === 'master')) {
      document.getElementById('loginScreen').classList.add('hidden');
      setTimeout(() => { document.getElementById('loginScreen').style.display = 'none'; }, 0);
      loadRsvpData();
    }
  </script>

</body>
</html>
