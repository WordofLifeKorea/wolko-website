                        <span class="wl-en">{p.data.name_en.split(' & ')[0]}</span>
                      </div>
                      <div class="tn-role">{p.data.role_badge}</div>
                    </div>
                  </a>
                </>
              );
            });
          })()}
        </div>
      </div>
    )}
  </div>
</aside>

<script>
  (function() {
    var sidebar = document.getElementById('tnSidebar');
    var toggle = document.getElementById('tnToggle');
    var wrap = document.querySelector('.mp-wrap');
    if (!sidebar || !toggle) return;

    var SIDEBAR_W = window.innerWidth <= 1100 ? '176px' : '200px';
    var isMobile = window.innerWidth <= 768;

    function applyState(isCollapsed) {
      sidebar.classList.toggle('is-collapsed', isCollapsed);
      if (wrap && !isMobile) {
        wrap.style.paddingRight = isCollapsed ? '12px' : SIDEBAR_W;
      }
    }

    var collapsed = localStorage.getItem('tn_collapsed') === '1';
    applyState(collapsed);

    toggle.addEventListener('click', function() {
      collapsed = !collapsed;
      applyState(collapsed);
      localStorage.setItem('tn_collapsed', collapsed ? '1' : '0');
    });

    // 인턴 섹션 토글
    var stwToggle = document.getElementById('tnStwToggle');
    var stwList = document.getElementById('tnStwList');
    if (stwToggle && stwList) {
      var stwOpen = localStorage.getItem('tn_stw_open') === '1';
      // 현재 인턴 페이지 보고 있으면 자동 열기
      if (stwList.querySelector('.tn-item.is-active')) stwOpen = true;
      if (stwOpen) { stwList.style.display = ''; stwToggle.classList.add('is-open'); }
      stwToggle.addEventListener('click', function() {
        stwOpen = !stwOpen;
        stwList.style.display = stwOpen ? '' : 'none';
        stwToggle.classList.toggle('is-open', stwOpen);
        localStorage.setItem('tn_stw_open', stwOpen ? '1' : '0');
      });
    }

    // 현재 항목 스크롤 위치로 이동
    var active = sidebar.querySelector('.tn-item.is-active');
    if (active) active.scrollIntoView({ block: 'center', behavior: 'instant' });
  })();
</script>

<!-- ── Mobile: FAB + Bottom Sheet ──────────────────── -->
<button class="tn-fab" id="tnFab" aria-label="팀원 목록">
  <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
    <circle cx="8" cy="7" r="3" stroke="white" stroke-width="1.8"/>
    <circle cx="15" cy="7" r="2.5" stroke="white" stroke-width="1.6" opacity=".7"/>
    <path d="M2 18c0-3.314 2.686-6 6-6s6 2.686 6 6" stroke="white" stroke-width="1.8" stroke-linecap="round"/>
    <path d="M15 13c2.21 0 4 1.79 4 4" stroke="white" stroke-width="1.6" stroke-linecap="round" opacity=".7"/>
  </svg>
</button>
<div class="tn-sheet-backdrop" id="tnBackdrop"></div>
<div class="tn-sheet" id="tnSheet">
  <div class="tn-sheet-handle"></div>
  <div class="tn-sheet-header">
    <span class="wl-ko">섬기는이</span>
    <span class="wl-en">Our Team</span>
  </div>
  <div class="tn-sheet-scroll">
    {(() => {
      let lastC = '';
      return sidebarTeam.map(p => {
        const cl = p.data.campus === 'pyeongtaek' ? '평택 월코' : '제주 월비';
        const cle = p.data.campus === 'pyeongtaek' ? 'WOLKO Pyeongtaek' : 'WOLBI Jeju';
        const show = p.data.campus !== lastC;
        if (show) lastC = p.data.campus;
        const active = p.slug === person.slug;
        const init = (p.data.name_ko || p.data.name_en || '?')[0];
        return (
          <>
            {show && <div class="tn-campus-label"><span class="wl-ko">{cl}</span><span class="wl-en">{cle}</span></div>}
            <a href={`/team/${p.slug}`} class={`tn-item${active ? ' is-active' : ''}`}>
              {p.data.photo_url ? <img class="tn-avatar" src={p.data.photo_url} alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/> : null}
              <span class="tn-avatar-placeholder" style={p.data.photo_url ? 'display:none' : ''}>{init}</span>
              <div>
                <div class="tn-name"><span class="wl-ko">{p.data.name_ko.split(' & ')[0]}</span><span class="wl-en">{p.data.name_en.split(' & ')[0]}</span></div>
                <div class="tn-role">{p.data.role_badge}</div>
              </div>
            </a>
          </>
        );
      });
    })()}
    {sidebarSTW.length > 0 && (
      <div class="tn-stw-wrap">
        <button class="tn-stw-toggle" id="tnStwToggle2">
          <span class="tn-campus-label" style="padding:0;margin:0;display:flex;align-items:center;gap:6px;width:100%;">
            <span class="wl-ko">인턴</span><span class="wl-en">Interns</span>
            <svg class="tn-stw-icon" width="11" height="11" viewBox="0 0 11 11" fill="none" style="margin-left:auto;flex-shrink:0;">
              <path d="M2 4l3.5 3.5L9 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>
        <div class="tn-stw-list" id="tnStwList2" style="display:none;">
          {(() => {
            let lc = '';
            return sidebarSTW.map(p => {
              const sc = p.data.campus !== lc;
              if (sc) lc = p.data.campus;
              const cl = p.data.campus === 'pyeongtaek' ? '평택 월코' : '제주 월비';
              const cle = p.data.campus === 'pyeongtaek' ? 'WOLKO Pyeongtaek' : 'WOLBI Jeju';
              const active = p.slug === person.slug;
              const init = (p.data.name_ko || p.data.name_en || '?')[0];
              return (
                <>
                  {sc && <div class="tn-campus-label" style="color:#c5d8e0;"><span class="wl-ko">{cl}</span><span class="wl-en">{cle}</span></div>}
                  <a href={`/team/${p.slug}`} class={`tn-item${active ? ' is-active' : ''}`}>
                    {p.data.photo_url ? <img class="tn-avatar" src={p.data.photo_url} alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"/> : null}
                    <span class="tn-avatar-placeholder" style={p.data.photo_url ? 'display:none' : ''}>{init}</span>
                    <div>
                      <div class="tn-name"><span class="wl-ko">{p.data.name_ko.split(' & ')[0]}</span><span class="wl-en">{p.data.name_en.split(' & ')[0]}</span></div>
                      <div class="tn-role">{p.data.role_badge}</div>
                    </div>
                  </a>
                </>
              );
            });
          })()}
        </div>
      </div>
    )}
  </div>
</div>

<script>
  (function() {
    var fab = document.getElementById('tnFab');
    var backdrop = document.getElementById('tnBackdrop');
    var sheet = document.getElementById('tnSheet');
    if (!fab || !sheet) return;

    function openSheet() {
      sheet.classList.add('is-open');
      backdrop.classList.add('is-open');
      fab.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      // 현재 항목 스크롤
      var active = sheet.querySelector('.tn-item.is-active');
      if (active) setTimeout(function() { active.scrollIntoView({ block: 'center', behavior: 'smooth' }); }, 350);
    }
    function closeSheet() {
      sheet.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      fab.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    fab.addEventListener('click', function() {
      sheet.classList.contains('is-open') ? closeSheet() : openSheet();
    });
    backdrop.addEventListener('click', closeSheet);

    // 인턴 토글 (바텀시트용)
    var st2 = document.getElementById('tnStwToggle2');
    var sl2 = document.getElementById('tnStwList2');
    if (st2 && sl2) {
      var open2 = localStorage.getItem('tn_stw_open') === '1';
      if (sl2.querySelector('.tn-item.is-active')) open2 = true;
      if (open2) { sl2.style.display = ''; st2.classList.add('is-open'); }
      st2.addEventListener('click', function() {
        open2 = !open2;
        sl2.style.display = open2 ? '' : 'none';
        st2.classList.toggle('is-open', open2);
        localStorage.setItem('tn_stw_open', open2 ? '1' : '0');
      });
    }
  })();
</script>

</BaseLayout>
