      <div style="width:100%; min-height:100%; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:16px 0 32px;">

        <!-- 헤더 -->
        <div id="reportHeader" style="width:92vw; max-width:960px; display:flex; align-items:center; justify-content:space-between; padding:0 0 12px; color:#fff;">
          <span style="font-size:13px; font-weight:600; letter-spacing:1px; opacity:0.7;">
            <span class="wl-ko">사역보고</span><span class="wl-en">Ministry Report</span>
          </span>
          <div style="display:flex; align-items:center; gap:12px;">
            <!-- 다운로드 -->
            <a href={d.report_url} download target="_blank" rel="noopener"
               style="color:#fff; opacity:0.7; display:flex; align-items:center; gap:6px; font-size:13px; text-decoration:none; transition:opacity 0.2s; padding:6px 10px; border:1px solid rgba(255,255,255,0.25); border-radius:6px;"
               onmouseover="this.style.opacity='1'" onmouseout="this.style.opacity='0.7'">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              <span class="wl-ko">다운로드</span><span class="wl-en">Download</span>
            </a>
            <!-- 닫기 -->
            <button id="closeReportBtn" style="background:rgba(255,255,255,0.12); border:1px solid rgba(255,255,255,0.25); border-radius:6px; color:#fff; opacity:0.85; cursor:pointer; padding:6px 10px; line-height:1; display:flex; align-items:center; justify-content:center;"
                    onmouseover="this.style.opacity='1';this.style.background='rgba(255,255,255,0.22)'" onmouseout="this.style.opacity='0.85';this.style.background='rgba(255,255,255,0.12)'">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
          </div>
        </div>

        <!-- 캔버스: 외부 컨테이너(폭 제한+가운데) + 내부 래퍼(버튼 기준점) -->
        <div id="reportCanvasOuter" style="width:92vw; max-width:960px; display:flex; justify-content:center; padding:0 32px;">
          <div id="reportCanvasInner" style="position:relative;">
            <canvas id="reportCanvas" style="display:block; border-radius:12px; box-shadow:0 24px 80px rgba(0,0,0,0.5); background:#fff;"></canvas>

            <!-- 이전 -->
            <button id="reportPrev"
              style="position:absolute; left:-26px; top:50%; transform:translateY(-50%);
                     background:rgba(255,255,255,0.18); border:1.5px solid rgba(255,255,255,0.35); border-radius:50%;
                     width:48px; height:48px; display:flex; align-items:center; justify-content:center;
                     cursor:pointer; color:#fff; transition:background 0.2s, border-color 0.2s; backdrop-filter:blur(4px);"
              onmouseover="this.style.background='rgba(255,255,255,0.32)';this.style.borderColor='rgba(255,255,255,0.6)'" onmouseout="this.style.background='rgba(255,255,255,0.18)';this.style.borderColor='rgba(255,255,255,0.35)'">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <!-- 다음 -->
            <button id="reportNext"
              style="position:absolute; right:-26px; top:50%; transform:translateY(-50%);
                     background:rgba(255,255,255,0.18); border:1.5px solid rgba(255,255,255,0.35); border-radius:50%;
                     width:48px; height:48px; display:flex; align-items:center; justify-content:center;
                     cursor:pointer; color:#fff; transition:background 0.2s, border-color 0.2s; backdrop-filter:blur(4px);"
              onmouseover="this.style.background='rgba(255,255,255,0.32)';this.style.borderColor='rgba(255,255,255,0.6)'" onmouseout="this.style.background='rgba(255,255,255,0.18)';this.style.borderColor='rgba(255,255,255,0.35)'">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <!-- 페이지 카운터 -->
        <div id="reportCounter" style="color:#fff; opacity:0.6; font-size:12px; margin-top:12px; letter-spacing:1px;"></div>

      </div>
    </div>

    <script define:vars={{ reportUrl: d.report_url }}>
    (function() {
      var modal   = document.getElementById('reportModal');
      var openBtn = document.getElementById('openReportBtn');
      var closeBtn= document.getElementById('closeReportBtn');
      var canvas  = document.getElementById('reportCanvas');
      var ctx     = canvas ? canvas.getContext('2d') : null;
      var prevBtn = document.getElementById('reportPrev');
      var nextBtn = document.getElementById('reportNext');
      var counter = document.getElementById('reportCounter');
      // External links (Mailchimp etc.) are rendered as <a> tags — no modal needed
      if (!modal || !openBtn || !reportUrl.endsWith('.pdf')) return;

      var pdfDoc = null, curPage = 1, totalPages = 0, rendering = false;
      var canvasOuter = document.getElementById('reportCanvasOuter');
      var canvasInner = document.getElementById('reportCanvasInner');

      function renderPage(num) {
        if (!pdfDoc || rendering) return;
        rendering = true;
        pdfDoc.getPage(num).then(function(page) {
          var vp = page.getViewport({ scale: 1 });
          var dpr = window.devicePixelRatio || 1;
          // 가용 폭: 외부 컨테이너 - 좌우 패딩(28*2)
          var availW = canvasOuter.clientWidth - 64;
          // 가용 높이: 뷰포트의 82% (헤더+카운터 공간 제외)
          var availH = window.innerHeight * 0.82;
          var scale = Math.min(availW / vp.width, availH / vp.height);
          var viewport = page.getViewport({ scale: scale * dpr });
          canvas.width  = viewport.width;
          canvas.height = viewport.height;
          var cssW = Math.round(viewport.width / dpr);
          var cssH = Math.round(viewport.height / dpr);
          canvas.style.width  = cssW + 'px';
          canvas.style.height = cssH + 'px';
          // 내부 래퍼를 캔버스 크기에 맞춰야 이전/다음 버튼 위치가 캔버스 기준으로 정렬됨
          canvasInner.style.width = cssW + 'px';
          page.render({ canvasContext: ctx, viewport: viewport }).promise.then(function() {
            rendering = false;
            counter.textContent = num + ' / ' + totalPages;
            prevBtn.style.opacity = num <= 1 ? '0.3' : '1';
            nextBtn.style.opacity = num >= totalPages ? '0.3' : '1';
          });
        });
      }

      function loadPDF() {
        if (pdfDoc) { curPage = 1; renderPage(1); return; }
        // PDF.js CDN
        var script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js';
        script.onload = function() {
          window.pdfjsLib.GlobalWorkerOptions.workerSrc =
            'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
          window.pdfjsLib.getDocument(reportUrl).promise.then(function(doc) {
            pdfDoc = doc;
            totalPages = doc.numPages;
            curPage = 1;
            renderPage(1);
          });
        };
        document.head.appendChild(script);
      }

      // 열기
      openBtn.addEventListener('click', function() {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        loadPDF();
      });
      // 닫기
      function closeModal() {
        modal.style.display = 'none';
        document.body.style.overflow = '';
      }
      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', function(e) { if (e.target === modal) closeModal(); });

      // 페이지 이동
      prevBtn.addEventListener('click', function() { if (curPage > 1) renderPage(--curPage); });
      nextBtn.addEventListener('click', function() { if (curPage < totalPages) renderPage(++curPage); });

      // 키보드
      document.addEventListener('keydown', function(e) {
        if (modal.style.display === 'none') return;
        if (e.key === 'Escape') closeModal();
        if (e.key === 'ArrowRight' && curPage < totalPages) renderPage(++curPage);
        if (e.key === 'ArrowLeft'  && curPage > 1)          renderPage(--curPage);
      });

      // 창 크기 변경 시 재렌더링
      var resizeTimer;
      window.addEventListener('resize', function() {
        clearTimeout(resizeTimer);
        resizeTimer = setTimeout(function() {
          if (modal.style.display !== 'none' && pdfDoc) renderPage(curPage);
        }, 150);
      });

      // 터치 스와이프
      var touchX = 0;
      canvas.addEventListener('touchstart', function(e) { touchX = e.touches[0].clientX; }, { passive: true });
      canvas.addEventListener('touchend',   function(e) {
        var dx = e.changedTouches[0].clientX - touchX;
        if (dx < -40 && curPage < totalPages) renderPage(++curPage);
        if (dx >  40 && curPage > 1)          renderPage(--curPage);
      }, { passive: true });
    })();
    </script>
  </>
)}

</BaseLayout>
