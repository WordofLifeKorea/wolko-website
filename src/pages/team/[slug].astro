---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const team = await getCollection('team');
  const filtered = team.filter(p => !p.slug.startsWith('map-order'));
  return filtered.map(p => ({ params: { slug: p.slug }, props: { person: p, allTeam: filtered } }));
}
const { person, allTeam } = Astro.props;

// 사이드바용: 선교사 (평택 → 제주), order 순
const sidebarTeam = allTeam
  .filter(p => p.data.category === 'missionary')
  .sort((a, b) => {
    if (a.data.campus !== b.data.campus) return a.data.campus === 'pyeongtaek' ? -1 : 1;
    return (a.data.order ?? 99) - (b.data.order ?? 99);
  });

// 사이드바용: 인턴 (STW), 평택 → 제주, order 순
const sidebarSTW = allTeam
  .filter(p => p.data.category === 'stw')
  .sort((a, b) => {
    if (a.data.campus !== b.data.campus) return a.data.campus === 'pyeongtaek' ? -1 : 1;
    return (a.data.order ?? 99) - (b.data.order ?? 99);
  });
const d = person.data;
const campusKo = d.campus === 'pyeongtaek' ? '평택 월코센터' : '제주 월비캠퍼스';
const campusEn = d.campus === 'pyeongtaek' ? 'Pyeongtaek WOLKO Center' : 'Jeju WOLBI Campus';
const hasBio = (d.bio_ko && d.bio_ko.trim()) || (d.bio_en && d.bio_en.trim());
const hasBio2 = (d.bio_ko_2 && d.bio_ko_2.trim()) || (d.bio_en_2 && d.bio_en_2.trim());
const isDir = d.role_badge && d.role_badge.toLowerCase().includes('director');
// 부부 선교사 이름 분리
const [name1Ko, name2Ko] = d.name_ko.includes(' & ') ? d.name_ko.split(' & ') : [d.name_ko, null];
const [name1En, name2En] = d.name_en.includes(' & ') ? d.name_en.split(' & ') : [d.name_en, null];

// ── 성경 참조 한→영 자동 변환 ──────────────────────────────────
const BOOK_MAP: Record<string, string> = {
  // 구약
  '창세기':'Genesis','출애굽기':'Exodus','레위기':'Leviticus','민수기':'Numbers',
  '신명기':'Deuteronomy','여호수아':'Joshua','사사기':'Judges','룻기':'Ruth',
  '사무엘상':'1 Samuel','사무엘하':'2 Samuel','열왕기상':'1 Kings','열왕기하':'2 Kings',
  '역대상':'1 Chronicles','역대하':'2 Chronicles','에스라':'Ezra','느헤미야':'Nehemiah',
  '에스더':'Esther','욥기':'Job','시편':'Psalm','잠언':'Proverbs',
  '전도서':'Ecclesiastes','아가':'Song of Solomon','이사야':'Isaiah','예레미야':'Jeremiah',
  '예레미야애가':'Lamentations','에스겔':'Ezekiel','다니엘':'Daniel','호세아':'Hosea',
  '요엘':'Joel','아모스':'Amos','오바댜':'Obadiah','요나':'Jonah','미가':'Micah',
  '나훔':'Nahum','하박국':'Habakkuk','스바냐':'Zephaniah','학개':'Haggai',
  '스가랴':'Zechariah','말라기':'Malachi',
  // 신약
  '마태복음':'Matthew','마가복음':'Mark','누가복음':'Luke','요한복음':'John',
  '사도행전':'Acts','로마서':'Romans','고린도전서':'1 Corinthians','고린도후서':'2 Corinthians',
  '갈라디아서':'Galatians','에베소서':'Ephesians','빌립보서':'Philippians','골로새서':'Colossians',
  '데살로니가전서':'1 Thessalonians','데살로니가후서':'2 Thessalonians',
  '디모데전서':'1 Timothy','디모데후서':'2 Timothy','디도서':'Titus','빌레몬서':'Philemon',
  '히브리서':'Hebrews','야고보서':'James','베드로전서':'1 Peter','베드로후서':'2 Peter',
  '요한일서':'1 John','요한이서':'2 John','요한삼서':'3 John','유다서':'Jude',
  '요한계시록':'Revelation',
};
function koRefToEn(ref: string): string {
  const s = ref.trim();
  for (const [ko, en] of Object.entries(BOOK_MAP)) {
    if (s.startsWith(ko)) return en + s.slice(ko.length);
  }
  return ref;
}
const verseRefEn = d.verse_ref ? koRefToEn(d.verse_ref) : null;
---
<BaseLayout title={`${d.name_ko} — WOLKO 월코`} description={`${d.name_en} | ${d.title_en} | Word of Life Korea`} activeNav="about">
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;600;700;900&family=Noto+Sans+KR:wght@400;500;700;800&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&display=swap');

.mp-wrap * { box-sizing: border-box; }

.mp-wrap {
  --c-deep:  #004f68;
  --c-mid:   #007ea1;
  --c-light: #73d1f5;
  --c-red:   #c42a36;
  --c-ink:   #0d1b24;
  --c-sub:   #3d5a6a;
  --c-muted: #7a9aaa;
  --c-bg:    #f5f8fa;
  --c-line:  #dce8ee;
  --c-white: #ffffff;
  font-family: 'Noto Sans KR', 'Apple SD Gothic Neo', sans-serif;
  color: var(--c-ink);
  background: var(--c-white);
}

/* 한/영 토글 — 글로벌 셀렉터로 처리 (아래 is:global 블록 참고) */

/* BACK BAR */
.mp-back { background: var(--c-white); border-bottom: 1px solid var(--c-line); padding: 0 5%; }
.mp-back a {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 13px 0; font-size: 13px; font-weight: 600;
  color: var(--c-sub); text-decoration: none; transition: color 0.2s;
}
.mp-back a:hover { color: var(--c-deep); }

/* HERO — 2-column */
.mp-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  overflow: hidden;
}
.mp-hero-photo {
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, var(--c-deep), var(--c-mid));
  min-height: 80vh;
}
.mp-hero-photo img {
  width: 100%; height: 100%;
  object-fit: cover; object-position: center top;
  display: block;
  animation: mp-zoom-in 1.4s cubic-bezier(0.22,1,0.36,1) forwards;
}
@keyframes mp-zoom-in {
  from { transform: scale(1.08); }
  to   { transform: scale(1.00); }
}
.mp-hero-photo::after {
  content: '';
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(4,20,32,0.65) 100%);
}
.mp-hero-name-layer {
  position: absolute; bottom: 36px; left: 36px; z-index: 2;
  animation: mp-fade-up 1s 0.5s both;
}
.mp-hero-name-main {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(22px, 2.8vw, 38px);
  font-weight: 600; color: rgba(255,255,255,0.88);
  line-height: 1.15; letter-spacing: 0.3px;
}
.mp-hero-name-sub {
  font-size: 10px; font-weight: 700;
  color: var(--c-light); letter-spacing: 2.5px;
  text-transform: uppercase; margin-top: 6px;
}
.mp-hero-content {
  background: var(--c-deep);
  display: flex; flex-direction: column; justify-content: center;
  padding: 64px 52px;
  min-height: 80vh;
  position: relative; overflow: hidden;
}
.mp-hero-content::before {
  content: '';
  position: absolute; width: 420px; height: 420px; border-radius: 50%;
  background: radial-gradient(circle, rgba(115,209,245,0.055) 0%, transparent 70%);
  top: -80px; right: -80px; pointer-events: none;
}

.mp-hero-label {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 9.5px; font-weight: 700; letter-spacing: 3px;
  text-transform: uppercase; color: var(--c-light);
  margin: 0 0 36px; animation: mp-fade-up 1s 0.2s both;
  opacity: 0.85;
}
.mp-hero-label::before {
  content: ''; display: block; width: 28px; height: 1px;
  background: var(--c-light); flex-shrink: 0;
}

/* 메인 타이틀 */
.mp-hero-title {
  font-family: 'Noto Sans KR', sans-serif;
  font-size: clamp(46px, 4.8vw, 70px); font-weight: 800;
  color: var(--c-white); line-height: 1.18;
  margin: 0; animation: mp-fade-up 1s 0.3s both;
  word-break: keep-all; letter-spacing: -0.5px;
}
/* 두 번째 줄 */
.mp-hero-title-em {
  display: block;
  color: var(--c-light);
  line-height: 1.25;
  margin-top: 8px;
}
.mp-hero-title-em.ko {
  font-family: 'Noto Sans KR', sans-serif;
  font-weight: 800; font-style: italic;
  font-size: clamp(46px, 4.8vw, 70px);
}
.mp-hero-title-em.en {
  font-family: 'Noto Sans KR', sans-serif;
  font-weight: 800; font-style: italic;
  font-size: clamp(46px, 4.8vw, 70px);
}

.mp-hero-role {
  display: none; /* 제거 — 눈잡물 */
}

.mp-hero-desc {
  font-size: 14px; line-height: 1.85;
  color: rgba(255,255,255,0.72);
  margin: 32px 0 40px; animation: mp-fade-up 1s 0.45s both;
  max-width: 400px;
  border-left: 2px solid rgba(115,209,245,0.45);
  padding-left: 20px;
}

.mp-cta-row {
  display: flex; gap: 16px; flex-wrap: wrap;
  animation: mp-fade-up 1s 0.65s both;
}
.mp-btn {
  display: inline-flex; align-items: center; gap: 8px;
  padding: 13px 22px; border-radius: 50px;
  font-size: 13px; font-weight: 700;
  text-decoration: none; transition: all 0.25s;
}
.mp-btn svg { width: 14px; height: 14px; flex-shrink: 0; }
.mp-btn-primary { background: var(--c-red); color: #fff !important; }
.mp-btn-primary:hover { background: #a82230; color: #fff !important; transform: translateY(-2px); box-shadow: 0 8px 24px rgba(196,42,54,0.4); }
.mp-btn-secondary { background: rgba(255,255,255,0.15); color: #fff !important; border: 1.5px solid rgba(255,255,255,0.5); }
.mp-btn-secondary:hover { background: rgba(255,255,255,0.28); color: #fff !important; transform: translateY(-2px); }

/* VERSE */
.mp-verse {
  background: var(--c-ink); padding: 72px 40px;
  text-align: center; position: relative; overflow: hidden;
}
.mp-verse::before {
  content: '\201C';
  position: absolute; font-family: 'Cormorant Garamond', serif;
  font-size: 320px; color: rgba(115,209,245,0.04);
  top: -60px; left: 20px; line-height: 1; pointer-events: none;
}
.mp-wrap .mp-verse-text {
  font-family: 'Noto Serif KR', serif;
  font-size: clamp(15px, 2vw, 21px); font-weight: 600;
  color: var(--c-white); line-height: 1.88;
  max-width: 780px; margin: 0 auto 20px; position: relative;
}
.mp-verse-ref {
  font-size: 12px; font-weight: 700;
  letter-spacing: 2px; color: var(--c-light); text-transform: uppercase;
}

/* STORY */
.mp-story {
  padding: 88px 40px; max-width: 1080px; margin: 0 auto;
}
.mp-story-block {
  display: grid; grid-template-columns: 1fr 1fr;
  gap: 72px; align-items: start;
}
.mp-story-photo {
  position: relative; border-radius: 20px; overflow: hidden;
  aspect-ratio: 3 / 4;
  box-shadow: 0 20px 60px rgba(0,79,104,0.16);
  background: linear-gradient(135deg, var(--c-line), var(--c-bg));
}
.mp-story-photo img {
  width: 100%; height: 100%; object-fit: cover; display: block;
}
.mp-story-photo::before {
  content: '';
  position: absolute; width: 80px; height: 80px;
  background: var(--c-light); opacity: 0.3; border-radius: 50%;
  top: -20px; right: -20px; z-index: 1;
}
.mp-story-photo-tag {
  position: absolute; bottom: 20px; left: 20px;
  background: var(--c-deep); color: var(--c-white);
  font-size: 11px; font-weight: 700; letter-spacing: 1.5px;
  text-transform: uppercase; padding: 6px 14px; border-radius: 30px; z-index: 2;
}
.mp-story-photo-placeholder {
  position: absolute; inset: 0;
  display: flex; align-items: center; justify-content: center;
}
.mp-story-photo-placeholder svg { width: 80px; height: 80px; opacity: 0.2; }

.mp-story-text { padding-top: 12px; }
.mp-story-label {
  font-size: 10px; font-weight: 700; letter-spacing: 3.5px;
  text-transform: uppercase; color: var(--c-mid); margin-bottom: 14px;
}
.mp-story-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(26px, 3.5vw, 40px); font-weight: 600;
  color: var(--c-deep); line-height: 1.2; margin-bottom: 24px;
}
.mp-story-body {
  font-size: 14.5px; line-height: 1.9; color: var(--c-sub);
}
.mp-wrap .mp-story-body + .mp-story-body { margin-top: 16px; }

.mp-story-empty {
  background: var(--c-bg); border: 1px dashed var(--c-line);
  border-radius: 14px; padding: 28px 24px;
  font-size: 14px; color: var(--c-muted); font-style: italic; line-height: 1.8;
}

.mp-story-divider {
  border: none; border-top: 1px solid var(--c-line);
  margin: 56px 0;
}

/* 두 번째 스토리 블록: 텍스트 왼쪽, 사진 오른쪽 */
.mp-story-block--reverse {
  direction: ltr;
}
.mp-story-block--reverse .mp-story-text { order: 1; }
.mp-story-block--reverse .mp-story-photo { order: 2; }

/* 모바일: reverse 블록에서 사진을 텍스트 위로 */
@media (max-width: 900px) {
  .mp-story-block--reverse .mp-story-text { order: 2; }
  .mp-story-block--reverse .mp-story-photo { order: 1; }
}

/* SPOUSE SECTION */
.mp-spouse {
  max-width: 1080px; margin: 0 auto; padding: 0 40px 72px;
}
.mp-spouse-card {
  display: flex; align-items: center; gap: 40px;
  background: linear-gradient(135deg, var(--c-deep) 0%, #015a7a 100%);
  border-radius: 24px; padding: 44px 52px;
  position: relative; overflow: hidden;
}
.mp-spouse-card::before {
  content: ''; position: absolute;
  top: -60px; right: -60px; width: 240px; height: 240px;
  border-radius: 50%; background: rgba(115,209,245,0.06); pointer-events: none;
}
.mp-spouse-card::after {
  content: ''; position: absolute;
  bottom: -40px; left: -40px; width: 180px; height: 180px;
  border-radius: 50%; background: rgba(255,255,255,0.03); pointer-events: none;
}
.mp-spouse-photo-wrap {
  flex-shrink: 0; width: 120px; height: 120px; border-radius: 50%;
  overflow: hidden; position: relative; z-index: 1;
  background: rgba(255,255,255,0.08);
  border: 3px solid rgba(115,209,245,0.3);
  box-shadow: 0 8px 32px rgba(0,0,0,0.25);
}
.mp-spouse-photo-wrap img {
  width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block;
}
.mp-spouse-avatar {
  width: 100%; height: 100%;
  display: flex; align-items: center; justify-content: center;
}
.mp-spouse-avatar svg { width: 52px; height: 52px; opacity: 0.35; }
.mp-spouse-text { position: relative; z-index: 1; }
.mp-spouse-eyebrow {
  font-size: 10px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase;
  color: var(--c-light); margin-bottom: 10px; display: flex; align-items: center; gap: 8px;
}
.mp-spouse-eyebrow::before {
  content: ''; display: block; width: 20px; height: 1.5px;
  background: var(--c-light); flex-shrink: 0;
}
.mp-spouse-name {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(24px, 3vw, 36px); font-weight: 700;
  color: #fff; line-height: 1.15; margin-bottom: 14px; letter-spacing: 0.3px;
}
.mp-spouse-desc {
  font-size: 14px; line-height: 1.85; color: rgba(255,255,255,0.62);
  max-width: 480px;
}
.mp-spouse-bio {
  font-size: 14.5px; line-height: 1.9;
  color: rgba(255,255,255,0.6); max-width: 520px;
}

/* SPOUSE TOGGLE BAR */
.mp-story-toggle-bar {
  display: flex; align-items: center; justify-content: space-between;
  max-width: 1080px; margin: 0 auto 48px; padding: 0 40px;
}
.mp-story-toggle-bar-title {
  font-size: 10px; font-weight: 700; letter-spacing: 3px;
  text-transform: uppercase; color: var(--c-muted);
}
.mp-spouse-toggle {
  display: inline-flex; align-items: center; gap: 10px;
  background: none; border: none; cursor: pointer;
  padding: 8px 16px 8px 8px;
  border-radius: 999px; border: 1.5px solid var(--c-line);
  background: var(--c-white);
  transition: border-color 0.2s, box-shadow 0.2s;
  font-family: inherit;
}
.mp-spouse-toggle:hover { border-color: var(--c-mid); }
.mp-spouse-toggle.active { border-color: var(--c-deep); box-shadow: 0 2px 10px rgba(0,79,104,0.10); }
.mp-spouse-toggle-track {
  width: 36px; height: 20px; border-radius: 999px;
  background: var(--c-line); position: relative;
  transition: background 0.2s; flex-shrink: 0;
}
.mp-spouse-toggle.active .mp-spouse-toggle-track { background: var(--c-deep); }
.mp-spouse-toggle-thumb {
  position: absolute; top: 3px; left: 3px;
  width: 14px; height: 14px; border-radius: 50%;
  background: #fff;
  box-shadow: 0 1px 4px rgba(0,0,0,0.18);
  transition: transform 0.2s;
}
.mp-spouse-toggle.active .mp-spouse-toggle-thumb { transform: translateX(16px); }
.mp-spouse-toggle-text {
  font-size: 12px; font-weight: 700; color: var(--c-sub); white-space: nowrap;
}
.mp-spouse-toggle.active .mp-spouse-toggle-text { color: var(--c-deep); }

/* SPOUSE CONTENT WRAPPER */
.mp-spouse-content {
  transition: opacity 0.3s, transform 0.3s;
}
.mp-spouse-content.mp-spouse-hidden {
  display: none;
}

/* PRAYER */
.mp-prayer {
  max-width: 1080px; margin: 0 auto; padding: 0 40px 80px;
}
.mp-prayer-inner {
  background: linear-gradient(135deg, rgba(0,79,104,0.04), rgba(0,126,161,0.07));
  border: 1px solid rgba(0,79,104,0.10); border-radius: 14px;
  padding: 28px 32px;
}
.mp-prayer-label {
  font-size: 10px; font-weight: 700; letter-spacing: 2.5px;
  text-transform: uppercase; color: var(--c-mid); margin-bottom: 10px;
}
.mp-prayer-text { font-size: 14px; line-height: 1.8; color: var(--c-sub); }

/* ANIMATION */
@keyframes mp-fade-up {
  from { opacity: 0; transform: translateY(22px); }
  to   { opacity: 1; transform: translateY(0); }
}
.mp-reveal { opacity: 0; transform: translateY(30px); transition: opacity 0.7s, transform 0.7s; }
.mp-reveal.mp-in { opacity: 1; transform: translateY(0); }

/* RESPONSIVE */
@media (max-width: 900px) {
  .mp-hero { grid-template-columns: 1fr; }
  .mp-hero-photo { height: 56vw; min-height: 260px; }
  .mp-hero-content { min-height: auto; padding: 44px 32px; }
  .mp-story-block { grid-template-columns: 1fr; gap: 36px; }
  .mp-story { padding: 56px 24px; }
  .mp-spouse { padding: 0 24px 56px; }
  .mp-spouse-card { flex-direction: column; padding: 36px 28px; gap: 24px; text-align: center; }
  .mp-spouse-eyebrow { justify-content: center; }
  .mp-spouse-desc, .mp-spouse-bio { max-width: 100%; }
  .mp-prayer { padding: 0 24px 56px; }
}
@media (max-width: 560px) {
  .mp-hero-content { padding: 36px 22px; }
  .mp-hero-name-layer { bottom: 20px; left: 20px; }
  .mp-verse { padding: 56px 24px; }
}

/* ── TEAM NAVIGATOR SIDEBAR ─────────────────────────── */
.tn-sidebar {
  position: fixed;
  right: 0; top: 0; bottom: 0;
  width: 200px;
  background: rgba(255,255,255,0.97);
  backdrop-filter: blur(12px);
  border-left: 1px solid #dce8ee;
  z-index: 200;
  display: flex;
  flex-direction: column;
  box-shadow: -4px 0 24px rgba(0,40,60,0.08);
  transform: translateX(0);
  transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
}
.tn-sidebar.is-collapsed { transform: translateX(188px); }

.tn-toggle {
  position: absolute;
  left: -36px; top: 50%;
  transform: translateY(-50%);
  width: 36px; height: 72px;
  background: rgba(255,255,255,0.97);
  border: 1px solid #dce8ee;
  border-right: none;
  border-radius: 8px 0 0 8px;
  cursor: pointer;
  display: flex; align-items: center; justify-content: center;
  box-shadow: -3px 0 12px rgba(0,40,60,0.08);
  color: #3d5a6a;
  transition: color 0.2s, background 0.2s;
}
.tn-toggle:hover { background: #f0f8fc; color: #004f68; }
.tn-toggle svg { transition: transform 0.3s; }
.tn-sidebar.is-collapsed .tn-toggle svg { transform: rotate(180deg); }

.tn-header {
  padding: 16px 14px 10px;
  border-bottom: 1px solid #dce8ee;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #5b8fa8;
  flex-shrink: 0;
}
.tn-scroll {
