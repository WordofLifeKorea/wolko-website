<script is:inline>
(function() {
  // Spouse toggle
  var toggleBtn = document.getElementById('spouseToggle');
  var spouseContent = document.getElementById('spouseContent');
  if (toggleBtn && spouseContent) {
    toggleBtn.addEventListener('click', function() {
      var isActive = toggleBtn.classList.toggle('active');
      spouseContent.classList.toggle('mp-spouse-hidden', !isActive);
    });
  }

  // ── 더 보기 / 접기 ──────────────────────────────────────────
  function initBioToggle() {
    document.querySelectorAll('[data-bio-wrap]').forEach(function(wrap) {
      var btn = wrap.nextElementSibling;
      if (!btn || !btn.hasAttribute('data-bio-toggle')) return;

      // 같은 스토리 블록 안의 사진 높이를 기준으로 삼음
      var block = wrap.closest('.mp-story-block');
      var photo = block && block.querySelector('.mp-story-photo');
      var limit = photo ? photo.offsetHeight : 480;
      limit = Math.max(limit, 380); // 최소 380px

      // 실제 콘텐츠 높이가 기준보다 짧으면 버튼 숨김
      if (wrap.scrollHeight <= limit + 20) return;

      // 클램프 적용
      wrap.style.maxHeight = limit + 'px';
      wrap.classList.add('is-clamped');
      btn.classList.add('visible');

      var open = false;
      btn.addEventListener('click', function() {
        open = !open;
        if (open) {
          wrap.style.maxHeight = wrap.scrollHeight + 'px';
          wrap.classList.remove('is-clamped');
          btn.querySelector('.wl-ko').textContent = '접기 ↑';
          btn.querySelector('.wl-en').textContent = 'Show less ↑';
        } else {
          wrap.style.maxHeight = limit + 'px';
          wrap.classList.add('is-clamped');
          btn.querySelector('.wl-ko').textContent = '더 보기 ↓';
          btn.querySelector('.wl-en').textContent = 'Read more ↓';
          // 접힐 때 스토리 섹션 상단으로 부드럽게 스크롤
          block && block.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });
    });
  }
  window.addEventListener('load', initBioToggle);

  // Scroll reveal
  var els = document.querySelectorAll('.mp-reveal');
  if (!('IntersectionObserver' in window)) {
    els.forEach(function(el) { el.classList.add('mp-in'); });
    return;
  }
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        entry.target.classList.add('mp-in');
        io.unobserve(entry.target);
      }
    });
  }, { threshold: 0.1 });
  els.forEach(function(el) { io.observe(el); });
})();
</script>

