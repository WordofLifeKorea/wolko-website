<script>
  (function() {
    var fab = document.getElementById('tnFab');
    var backdrop = document.getElementById('tnBackdrop');
    var sheet = document.getElementById('tnSheet');
    if (!fab || !sheet) return;

    function openSheet() {
      sheet.classList.add('is-open');
      backdrop.classList.add('is-open');
      fab.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      // 현재 항목 스크롤
      var active = sheet.querySelector('.tn-item.is-active');
      if (active) setTimeout(function() { active.scrollIntoView({ block: 'center', behavior: 'smooth' }); }, 350);
    }
    function closeSheet() {
      sheet.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      fab.classList.remove('is-open');
      document.body.style.overflow = '';
    }

    fab.addEventListener('click', function() {
      sheet.classList.contains('is-open') ? closeSheet() : openSheet();
    });
    backdrop.addEventListener('click', closeSheet);
    backdrop.addEventListener('touchend', function(e) { e.preventDefault(); closeSheet(); });
    var closeBtn = document.getElementById('tnSheetClose');
    if (closeBtn) closeBtn.addEventListener('click', closeSheet);

    // 인턴 토글 (바텀시트용) — A=평택, B=제주
    function initSheetStw(toggleId, listId, storageKey) {
      var t = document.getElementById(toggleId);
      var l = document.getElementById(listId);
      if (!t || !l) return;
      var stored = localStorage.getItem(storageKey);
      var open = stored === null ? true : stored !== '0';
      if (l.querySelector('.tn-item.is-active')) open = true;
      if (open) { l.style.display = ''; t.classList.add('is-open'); }
      t.addEventListener('click', function() {
        open = !open;
        l.style.display = open ? '' : 'none';
        t.classList.toggle('is-open', open);
        localStorage.setItem(storageKey, open ? '1' : '0');
      });
    }
    initSheetStw('tnStwToggleA2', 'tnStwListA2', 'tn_stw_open_pt');
    initSheetStw('tnStwToggleB2', 'tnStwListB2', 'tn_stw_open_jj');
  })();
</script>

