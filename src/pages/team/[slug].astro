  (function() {
    var sidebar = document.getElementById('tnSidebar');
    var toggle = document.getElementById('tnToggle');
    var wrap = document.querySelector('.mp-wrap');
    if (!sidebar || !toggle) return;

    var SIDEBAR_W = window.innerWidth <= 1100 ? '188px' : '210px';
    var isMobile = window.innerWidth <= 768;

    function applyState(isCollapsed) {
      sidebar.classList.toggle('is-collapsed', isCollapsed);
      if (wrap && !isMobile) {
        wrap.style.paddingRight = isCollapsed ? '12px' : SIDEBAR_W;
      }
    }

    var collapsed = localStorage.getItem('tn_collapsed') === '1';
    applyState(collapsed);

    toggle.addEventListener('click', function() {
      collapsed = !collapsed;
      applyState(collapsed);
      localStorage.setItem('tn_collapsed', collapsed ? '1' : '0');
    });

    // 인턴 섹션 토글 헬퍼 (A=평택, B=제주)
    function initStwToggle(toggleId, listId, storageKey) {
      var t = document.getElementById(toggleId);
      var l = document.getElementById(listId);
      if (!t || !l) return;
      var stored = localStorage.getItem(storageKey);
      var open = stored === null ? true : stored !== '0'; // 기본: 펼침
      if (l.querySelector('.tn-item.is-active')) open = true;
      if (open) { l.style.display = ''; t.classList.add('is-open'); }
      t.addEventListener('click', function() {
        open = !open;
        l.style.display = open ? '' : 'none';
        t.classList.toggle('is-open', open);
        localStorage.setItem(storageKey, open ? '1' : '0');
      });
    }
    initStwToggle('tnStwToggleA', 'tnStwListA', 'tn_stw_open_pt');
    initStwToggle('tnStwToggleB', 'tnStwListB', 'tn_stw_open_jj');

    // 현재 항목 스크롤 위치로 이동
    var active = sidebar.querySelector('.tn-item.is-active');
