---
import BaseLayout from '../../layouts/BaseLayout.astro';
// 개인 뉴스레터 읽기 — /letters/?s=소개페이지&p=글id (글 id 가 없으면 그 사람의 소식 목록)
---
<BaseLayout title="소식 — WOLKO" activeNav="about" whiteNav={true} langRoot="lang-root">
  <div class="lt-wrap" id="ltRoot">
    <p class="lt-load">…</p>
  </div>
</BaseLayout>

<style is:global>
.lt-wrap { max-width: 720px; margin: 0 auto; padding: 120px 20px 90px; color: #24323a; }
.lt-back { display: inline-block; margin-bottom: 18px; font-size: 14px; font-weight: 700; color: #005c76; text-decoration: none; }
.lt-kicker { font-size: 11px; font-weight: 800; letter-spacing: .22em; color: #007ea1; text-transform: uppercase; margin: 0 0 8px; }
.lt-title { margin: 0 0 8px; font-size: 32px; line-height: 1.3; color: #102936; }
.lt-date { margin: 0 0 28px; font-size: 13px; color: #7a9aaa; }
.lt-body img { max-width: 100%; height: auto; }
.lt-list { list-style: none; margin: 22px 0 0; padding: 0; display: grid; gap: 10px; }
.lt-list a { display: block; padding: 16px 18px; border: 1px solid #dce8ee; background: #fff; border-radius: 14px; text-decoration: none; color: inherit; }
.lt-list a:hover { border-color: #73d1f5; }
.lt-list b { display: block; font-size: 16px; color: #0d1b24; }
.lt-list small { display: block; margin-top: 3px; font-size: 12px; color: #7a9aaa; }
.lt-list p { margin: 6px 0 0; font-size: 13.5px; line-height: 1.6; color: #3d5a6a; }
.lt-msg { color: #7a9aaa; padding: 40px 0; text-align: center; }
</style>

<script is:inline>
(function () {
  var q = new URLSearchParams(location.search), slug = q.get('s') || '', id = q.get('p') || '';
  var root = document.getElementById('ltRoot');
  var en = document.documentElement.lang === 'en';
  var esc = function (s) { return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]; }); };
  var fmt = function (iso) { return iso ? new Date(iso).toLocaleDateString(en ? 'en-US' : 'ko-KR', { year: 'numeric', month: 'long', day: 'numeric' }) : ''; };
  var back = '<a class="lt-back" href="/team/' + encodeURIComponent(slug) + '/">← ' + (en ? 'Profile' : '소개 페이지') + '</a>';
  var notFound = function () { root.innerHTML = '<p class="lt-msg">' + (en ? 'We could not find this page.' : '글을 찾을 수 없어요.') + '</p>'; };
  if (!/^[a-z0-9-]+$/.test(slug)) return notFound();
  if (id) {
    fetch('/api/newsletter/posts?slug=' + encodeURIComponent(slug) + '&id=' + encodeURIComponent(id)).then(function (r) { if (!r.ok) throw 0; return r.json(); }).then(function (d) {
      document.title = d.post.title + ' — WOLKO';
      root.innerHTML = back + '<p class="lt-kicker">' + esc(d.author.displayName) + '</p><h1 class="lt-title">' + esc(d.post.title) + '</h1><p class="lt-date">' + esc(fmt(d.post.publishedAt)) + '</p><div class="lt-body">' + d.post.html + '</div>'
        + '<p style="margin-top:36px"><a class="lt-back" href="/letters/?s=' + encodeURIComponent(slug) + '">' + (en ? 'More updates' : '다른 소식 보기') + ' →</a></p>';
    }).catch(notFound);
  } else {
    fetch('/api/newsletter/posts?slug=' + encodeURIComponent(slug)).then(function (r) { return r.json(); }).then(function (d) {
      if (!d.enabled) return notFound();
      root.innerHTML = back + '<p class="lt-kicker">' + (en ? 'Updates' : '소식') + '</p><h1 class="lt-title">' + esc(d.displayName) + '</h1>'
        + (d.posts.length ? '<ul class="lt-list">' + d.posts.map(function (p) { return '<li><a href="/letters/?s=' + encodeURIComponent(slug) + '&p=' + encodeURIComponent(p.id) + '"><b>' + esc(p.title) + '</b><small>' + esc(fmt(p.publishedAt)) + '</small>' + (p.excerpt ? '<p>' + esc(p.excerpt) + '</p>' : '') + '</a></li>'; }).join('') + '</ul>' : '<p class="lt-msg">' + (en ? 'No updates yet.' : '아직 올라온 소식이 없어요.') + '</p>');
    }).catch(notFound);
  }
})();
</script>
