---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 예정된 이벤트. 새 이벤트가 생기면 이 목록에 추가한다.
// invite: 카카오톡 등으로 공유하는 전용 초대장 페이지 경로. 이 목록 페이지에서는
// 카드만 간단히 보여주고, "참석 신청하기"를 누르면 이 경로로 이동한다.
const events = [
  {
    id: 'thanksgiving-night',
    title_ko: '감사의 밤',
    title_en: 'Night of Thanksgiving',
    date_ko: '2026년 11월 26일(목) 오후 7시',
    date_en: 'Thursday, November 26, 2026 · 7:00 PM',
    place_ko: '경기도 평택시 경기대로 1407, 2층 월코센터',
    place_en: 'WOLKO Center, 2F, 1407 Gyeonggi-daero, Pyeongtaek',
    note_ko: '월코 사역에 참여하고 동참해 주신 분들께 감사를 전하는 자리입니다.',
    note_en: 'An evening to thank everyone who has taken part in and partnered with the ministry of WOLKO.',
    open: true,
    invite: '/rsvp/thanksgiving/',
  },
];
---

<BaseLayout
  title="이벤트 참석 신청 — Word of Life Korea"
  description="월코 이벤트 참석 여부(RSVP)를 알려주세요. 감사의 밤 등 예정된 행사에 참석 신청하실 수 있습니다."
  activeNav="connect"
  ogImage="/images/rsvp-share.png"
>

<style>
  :root {
    --d:#5a3525; --m:#8c5132; --l:#d3a35c;
    --r:#a5482d; --k:#39271f; --s:#6e584b;
    --bg:#f5eee3; --line:rgba(90,53,37,0.13);
    --f-sans:'Pretendard Variable',Pretendard,'Apple SD Gothic Neo',sans-serif;
  }

  .rv-hero {
    background: linear-gradient(135deg, #4a2d20 0%, #8c5132 60%, #b77842 100%);
    padding: 140px 24px 96px; text-align: center; color: #fff;
  }
  .rv-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(255,236,204,0.9); margin-bottom: 18px;
  }
  .rv-hero-eyebrow::before { content:''; width:28px; height:1px; background:rgba(255,236,204,0.6); }
  .rv-hero h1 { margin: 0 0 16px; font-size: clamp(30px, 5vw, 46px); font-weight: 800; line-height: 1.25; }
  .rv-hero p { margin: 0 auto; max-width: 560px; font-size: 15px; line-height: 1.85; color: rgba(255,255,255,0.85); word-break: keep-all; }

  .rv-wrap { max-width: 620px; margin: 0 auto; padding: 72px 24px 96px; }
  .rv-section-title { display:flex; align-items:center; gap:12px; margin: 0 0 24px; font-size: 13px; font-weight: 800; letter-spacing: 0.12em; color: var(--r); text-transform: uppercase; }
  .rv-section-title::after { content:''; flex:1; height:1px; background:var(--line); }

  .rv-card {
    border: 1px solid var(--line); border-radius: 18px; background: #fff;
    padding: 32px; box-shadow: 0 4px 24px rgba(77,43,27,0.07);
  }
  .rv-card + .rv-card { margin-top: 20px; }
  .rv-card-badge {
    display: inline-block; padding: 4px 12px; border-radius: 999px;
    background: rgba(140,81,50,0.1); color: var(--m);
    font-size: 11px; font-weight: 800; letter-spacing: 0.06em;
  }
  .rv-card h2 { margin: 14px 0 6px; font-size: 26px; font-weight: 800; color: var(--k); word-break: keep-all; }
  .rv-card-lead { margin: 0 0 22px; font-size: 14px; line-height: 1.8; color: var(--s); word-break: keep-all; }
  .rv-facts { display: grid; gap: 12px; margin-bottom: 22px; }
  .rv-fact { display: grid; grid-template-columns: 74px 1fr; gap: 12px; align-items: start; font-size: 14px; }
  .rv-fact dt { color: #9a7b5e; font-weight: 700; font-size: 12.5px; padding-top: 1px; }
  .rv-fact dd { margin: 0; color: var(--k); font-weight: 600; line-height: 1.6; word-break: keep-all; }

  .rv-card-actions { margin-top: 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .rv-rsvp-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 48px; padding: 0 30px; border: none; border-radius: 12px;
    background: var(--r); color: #fff; font-family: var(--f-sans);
    font-size: 15px; font-weight: 700; cursor: pointer; text-decoration: none;
    transition: background .2s, transform .18s, box-shadow .2s;
    box-shadow: 0 4px 14px rgba(165,72,45,0.25);
  }
  .rv-rsvp-btn:hover { background: #8a3a23; transform: translateY(-2px); box-shadow: 0 10px 26px rgba(165,72,45,0.32); }

  .rv-share-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 7px;
    min-height: 48px; padding: 0 18px; border-radius: 12px;
    border: 1.5px solid rgba(90,53,37,0.18); background: #fff; color: var(--d);
    font-family: var(--f-sans); font-size: 13.5px; font-weight: 700; cursor: pointer;
    transition: border-color .2s, background .2s;
  }
  .rv-share-btn:hover { border-color: var(--m); background: #fff8ed; }
  .rv-share-btn svg { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }

  .rv-empty { padding: 56px 24px; text-align: center; color: var(--s); }
  .rv-empty h3 { margin: 0 0 8px; font-size: 19px; font-weight: 800; color: var(--k); }
  .rv-empty p { margin: 0; font-size: 14px; line-height: 1.8; }

  @media (max-width: 640px) {
    .rv-hero { padding: 116px 20px 72px; }
    .rv-wrap { padding: 52px 18px 72px; }
    .rv-card { padding: 24px 20px; }
    .rv-fact { grid-template-columns: 62px 1fr; font-size: 13.5px; }
    .rv-card-actions { display: grid; grid-template-columns: 1fr; }
    .rv-card-actions > .rv-rsvp-btn,
    .rv-card-actions > .rv-share-btn { width: 100%; height: 48px; padding: 0 16px; font-size: 14px; }
  }
</style>

<section class="rv-hero">
  <div class="rv-hero-eyebrow">WOLKO EVENT · RSVP</div>
  <h1>
    <span class="wl-ko">이벤트 참석 신청</span>
    <span class="wl-en">Event RSVP</span>
  </h1>
  <p>
    <span class="wl-ko">월코의 예정된 행사에 함께해 주세요. 참석 여부를 미리 알려주시면 자리를 준비하는 데 큰 도움이 됩니다.</span>
    <span class="wl-en">Join us at our upcoming events. Letting us know in advance helps us prepare a place for you.</span>
  </p>
</section>

<div class="rv-wrap">
  <h2 class="rv-section-title">
    <span class="wl-ko">예정된 행사</span><span class="wl-en">Upcoming Events</span>
  </h2>

  {events.length > 0 ? events.map((event) => (
    <div class="rv-card">
      <span class="rv-card-badge">
        <span class="wl-ko">참석 신청 받는 중</span><span class="wl-en">RSVP Open</span>
      </span>
      <h2>
        <span class="wl-ko">{event.title_ko}</span>
        <span class="wl-en">{event.title_en}</span>
      </h2>
      <p class="rv-card-lead">
        <span class="wl-ko">{event.note_ko}</span>
        <span class="wl-en">{event.note_en}</span>
      </p>

      <dl class="rv-facts">
        <div class="rv-fact">
          <dt><span class="wl-ko">일정</span><span class="wl-en">Date</span></dt>
          <dd><span class="wl-ko">{event.date_ko}</span><span class="wl-en">{event.date_en}</span></dd>
        </div>
        <div class="rv-fact">
          <dt><span class="wl-ko">장소</span><span class="wl-en">Venue</span></dt>
          <dd><span class="wl-ko">{event.place_ko}</span><span class="wl-en">{event.place_en}</span></dd>
        </div>
      </dl>

      <div class="rv-card-actions">
        <a class="rv-rsvp-btn" href={event.invite}>
          <span class="wl-ko">참석 신청하기 →</span>
          <span class="wl-en">RSVP →</span>
        </a>
        <button type="button" class="rv-share-btn rsvp-share-btn" data-invite={event.invite} data-event-title-ko={event.title_ko} data-event-title-en={event.title_en}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"/></svg>
          <span class="wl-ko">초대장 공유하기</span><span class="wl-en">Share invitation</span>
        </button>
      </div>
    </div>
  )) : (
    <div class="rv-card rv-empty">
      <h3>
        <span class="wl-ko">예정된 행사가 없습니다</span>
        <span class="wl-en">No upcoming events</span>
      </h3>
      <p>
        <span class="wl-ko">새로운 행사가 정해지면 이곳에 안내해 드릴게요.</span>
        <span class="wl-en">We'll announce new events here as they are scheduled.</span>
      </p>
    </div>
  )}
</div>

<script is:inline>
(function () {
  function isEn() {
    var root = document.getElementById('lang-root') || document.body;
    return root.classList.contains('lang-en');
  }

  // 모바일에서는 시스템 공유창을 열어 카카오톡 등으로 초대장 링크를 바로 보낼 수 있게 한다.
  // 공유 API가 없는 브라우저에서는 같은 링크를 클립보드에 복사한다.
  document.querySelectorAll('.rsvp-share-btn').forEach(function (btn) {
    var labelHtml = btn.innerHTML;
    btn.addEventListener('click', async function () {
      var link = location.origin + (btn.dataset.invite || location.pathname);
      var eventTitle = isEn() ? (btn.dataset.eventTitleEn || 'WOLKO Event') : (btn.dataset.eventTitleKo || '월코 이벤트');
      if (navigator.share) {
        try {
          await navigator.share({
            title: eventTitle,
            text: isEn() ? 'You are invited. Please view the invitation and let us know if you can join us.' : eventTitle + '에 초대합니다. 초대장을 확인하고 참석 여부를 알려주세요.',
            url: link,
          });
          return;
        } catch (err) {
          if (err && err.name === 'AbortError') return;
        }
      }
      try {
        await navigator.clipboard.writeText(link);
      } catch (err) {
        window.prompt(isEn() ? 'Copy this link:' : '이 링크를 복사해 주세요:', link);
        return;
      }
      btn.innerHTML = '<span class="wl-ko">복사했어요</span><span class="wl-en">Link copied</span>';
      clearTimeout(btn._resetTimer);
      btn._resetTimer = setTimeout(function () { btn.innerHTML = labelHtml; }, 2000);
    });
  });
})();
</script>

</BaseLayout>
