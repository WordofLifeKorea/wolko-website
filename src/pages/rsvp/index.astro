---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

// 예정된 이벤트. 새 이벤트가 생기면 이 목록에 추가한다.
// invite: 카카오톡 등으로 공유하는 전용 초대장 페이지 경로. 이 목록 페이지에서는
// 카드만 간단히 보여주고, "참석 신청하기"를 누르면 이 경로로 이동한다.
const events = [
  {
    id: 'thanksgiving-night',
    title_ko: '감사의 밤',
    title_en: 'Night of Thanksgiving',
    date_ko: '2026년 11월 26일(목) 오후 6시',
    date_en: 'Thursday, November 26, 2026 · 6:00 PM',
    theme_ko: '함께한 한 해를 돌아보며 감사를 나누는 저녁',
    theme_en: 'An evening to reflect and give thanks together',
    note_ko: '월코 사역에 참여하고 동참해 주신 분들께 감사를 전하는 자리입니다.',
    note_en: 'An evening to thank everyone who has taken part in and partnered with the ministry of WOLKO.',
    open: true,
    invite: '/rsvp/thanksgiving/',
  },
];
---

<BaseLayout
  title="이벤트 참석 신청 — Word of Life Korea"
  description="월코 이벤트 참석 여부(RSVP)를 알려주세요. 감사의 밤 등 예정된 행사에 참석 신청하실 수 있습니다."
  activeNav="connect"
  ogImage="/images/rsvp-share.png"
>

<style>
  /* 캠프 신청 페이지와 같은 디자인 언어 — 각진 모서리, 가는 선, 남색·회청색·흰색 */
  .rv {
    --c-deep:#004f68; --c-deep-dk:#003d52; --c-navy:#0b2430; --c-ink:#10252e;
    --c-sub:#4a5d66; --c-muted:#587383; --c-label:#5a7380;
    --c-line:#d6dee2; --c-rule:#e3e9ec; --c-soft:#f6f9fb; --c-fill:#f3f7f9; --c-white:#fff;
    --f-serif: var(--ff-serif, 'GmarketSans', 'Pretendard Variable', Pretendard, sans-serif);
    --f-sans: var(--ff-sans, 'Pretendard Variable', Pretendard, -apple-system, sans-serif);
    font-family: var(--f-sans); color: var(--c-ink); word-break: keep-all;
    background: var(--c-soft); padding: 112px 0 120px;
  }
  .rv-inner { width: min(1200px, calc(100% - 48px)); margin-inline: auto; }

  /* 제목 묶음: 작은 표시(앞에 가는 선) + 제목 + 본문 */
  .rv-head { margin-bottom: 64px; }
  .rv-label { display: flex; align-items: center; gap: 12px; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--c-deep); }
  .rv-label::before { content: ''; width: 28px; height: 1px; background: currentColor; flex: none; }
  .rv-title { margin: 20px 0 0; font-family: var(--f-serif); font-size: clamp(30px, 3.4vw, 46px); font-weight: 700; color: var(--c-navy); line-height: 1.22; letter-spacing: -.03em; }
  .rv-desc { margin: 16px 0 0; max-width: 640px; font-size: 16px; line-height: 1.85; color: var(--c-sub); }

  .rv-group-header { margin-bottom: 28px; padding-bottom: 16px; border-bottom: 2px solid var(--c-navy); font-family: var(--f-serif); font-size: 22px; font-weight: 700; line-height: 1.3; letter-spacing: -.03em; color: var(--c-navy); }
  .rv-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; }

  .rv-card { background: var(--c-white); border: 1px solid var(--c-line); padding: 28px; display: flex; flex-direction: column; min-width: 0; }
  .rv-card-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 16px; }
  .rv-type { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--c-label); }
  .rv-status { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: var(--c-deep); white-space: nowrap; }
  .rv-status::before { content: ''; width: 6px; height: 6px; background: currentColor; flex: none; }
  .rv-card h3 { margin: 0 0 10px; font-family: var(--f-serif); font-size: 24px; font-weight: 700; color: var(--c-navy); line-height: 1.3; letter-spacing: -.03em; }
  .rv-card-lead { margin: 0 0 20px; font-size: 14px; line-height: 1.75; color: var(--c-muted); }

  /* 일정 · 모임 — 가는 선으로 나눈 줄 */
  .rv-facts { margin: 0 0 24px; }
  .rv-fact { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 12px; align-items: baseline; padding: 11px 0; border-top: 1px solid var(--c-rule); }
  .rv-fact:last-child { border-bottom: 1px solid var(--c-rule); }
  .rv-fact dt { font-size: 13px; font-weight: 600; color: var(--c-label); }
  .rv-fact dd { margin: 0; font-size: 14.5px; font-weight: 500; color: var(--c-ink); line-height: 1.65; font-variant-numeric: tabular-nums; }

  .rv-card-actions { margin-top: auto; display: grid; gap: 10px; }
  .rv-arrow { width: 15px; height: 15px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: square; transition: transform .25s; }
  .rv-rsvp-btn, .rv-share-btn {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    width: 100%; height: 52px; padding: 0 20px; box-sizing: border-box;
    border: 1px solid var(--c-deep); border-radius: 2px;
    font-family: var(--f-sans); font-size: 15px; font-weight: 700; cursor: pointer; text-decoration: none;
    transition: background-color .2s, border-color .2s;
  }
  .rv-rsvp-btn { background: var(--c-deep); color: #fff; }
  .rv-rsvp-btn:hover { background: var(--c-deep-dk); border-color: var(--c-deep-dk); }
  .rv-share-btn { background: var(--c-white); color: var(--c-deep); }
  .rv-share-btn:hover { background: var(--c-fill); }
  .rv-rsvp-btn:hover .rv-arrow { transform: translateX(3px); }
  .rv-rsvp-btn:focus-visible, .rv-share-btn:focus-visible { outline: 2px solid var(--c-deep); outline-offset: 3px; }
  .rv-share-btn svg.rv-link { width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; flex: none; }

  .rv-empty { background: var(--c-white); border: 1px solid var(--c-line); padding: 56px 24px; text-align: center; color: var(--c-sub); }
  .rv-empty h3 { margin: 0 0 8px; font-family: var(--f-serif); font-size: 20px; font-weight: 700; color: var(--c-navy); }
  .rv-empty p { margin: 0; font-size: 14px; line-height: 1.8; }

  @media (max-width: 1000px) { .rv-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) {
    .rv { padding: 64px 0 80px; }
    .rv-inner { width: calc(100% - 40px); }
    .rv-head { margin-bottom: 40px; }
    .rv-grid { grid-template-columns: 1fr; }
    .rv-card { padding: 24px 20px; }
    .rv-group-header { font-size: 20px; margin-bottom: 20px; }
  }
</style>

<PageHero variant="band" image="/images/heroes/samuel.jpg" pos="50% 35%">
  <Fragment slot="eyebrow">WOLKO EVENT · RSVP</Fragment>
  <Fragment slot="title">
    <span class="wl-ko">이벤트 참석 신청</span>
    <span class="wl-en">Event RSVP</span>
  </Fragment>
  <Fragment slot="desc">
    <span class="wl-ko">월코의 예정된 행사에 함께해 주세요. 참석 여부를 미리 알려주시면 자리를 준비하는 데 큰 도움이 됩니다.</span>
    <span class="wl-en">Join us at our upcoming events. Letting us know in advance helps us prepare a place for you.</span>
  </Fragment>
</PageHero>

<section class="rv">
  <div class="rv-inner">
    <div class="rv-head">
      <div class="rv-label">Upcoming Events</div>
      <h2 class="rv-title"><span class="wl-ko">예정된 행사</span><span class="wl-en">Upcoming Events</span></h2>
      <p class="rv-desc">
        <span class="wl-ko">참석 신청은 각 행사의 초대장에서 하실 수 있어요. 초대장 링크를 함께하고 싶은 분께 공유해 주세요.</span>
        <span class="wl-en">RSVP from each event's invitation, and feel free to share the invitation link with anyone you'd like to bring.</span>
      </p>
    </div>

    {events.length > 0 ? (
      <div>
        <div class="rv-group-header"><span class="wl-ko">월코 행사</span><span class="wl-en">WOLKO Events</span></div>
        <div class="rv-grid">
          {events.map((event) => (
            <div class="rv-card">
              <div class="rv-card-top">
                <span class="rv-type">Event</span>
                <span class="rv-status"><span class="wl-ko">참석 신청 받는 중</span><span class="wl-en">RSVP open</span></span>
              </div>
              <h3>
                <span class="wl-ko">{event.title_ko}</span>
                <span class="wl-en">{event.title_en}</span>
              </h3>
              <p class="rv-card-lead">
                <span class="wl-ko">{event.note_ko}</span>
                <span class="wl-en">{event.note_en}</span>
              </p>

              <dl class="rv-facts">
                <div class="rv-fact">
                  <dt><span class="wl-ko">일정</span><span class="wl-en">Date</span></dt>
                  <dd><span class="wl-ko">{event.date_ko}</span><span class="wl-en">{event.date_en}</span></dd>
                </div>
                <div class="rv-fact">
                  <dt><span class="wl-ko">모임</span><span class="wl-en">Gathering</span></dt>
                  <dd><span class="wl-ko">{event.theme_ko}</span><span class="wl-en">{event.theme_en}</span></dd>
                </div>
              </dl>

              <div class="rv-card-actions">
                <a class="rv-rsvp-btn" href={event.invite}>
                  <span><span class="wl-ko">참석 신청하기</span><span class="wl-en">RSVP</span></span>
                  <svg class="rv-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
                </a>
                <button type="button" class="rv-share-btn rsvp-share-btn" data-invite={event.invite} data-event-title-ko={event.title_ko} data-event-title-en={event.title_en}>
                  <span><span class="wl-ko">초대장 공유하기</span><span class="wl-en">Share invitation</span></span>
                  <svg class="rv-link" viewBox="0 0 24 24" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.5 1.5"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.5-1.5"/></svg>
                </button>
              </div>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="rv-empty">
        <h3>
          <span class="wl-ko">예정된 행사가 없습니다</span>
          <span class="wl-en">No upcoming events</span>
        </h3>
        <p>
          <span class="wl-ko">새로운 행사가 정해지면 이곳에 안내해 드릴게요.</span>
          <span class="wl-en">We'll announce new events here as they are scheduled.</span>
        </p>
      </div>
    )}
  </div>
</section>

<script is:inline>
(function () {
  function isEn() {
    var root = document.getElementById('lang-root') || document.body;
    return root.classList.contains('lang-en');
  }

  // 모바일에서는 시스템 공유창을 열어 카카오톡 등으로 초대장 링크를 바로 보낼 수 있게 한다.
  // 공유 API가 없는 브라우저에서는 같은 링크를 클립보드에 복사한다.
  document.querySelectorAll('.rsvp-share-btn').forEach(function (btn) {
    var labelHtml = btn.innerHTML;
    btn.addEventListener('click', async function () {
      var link = location.origin + (btn.dataset.invite || location.pathname);
      var eventTitle = isEn() ? (btn.dataset.eventTitleEn || 'WOLKO Event') : (btn.dataset.eventTitleKo || '월코 이벤트');
      if (navigator.share) {
        try {
          await navigator.share({
            title: eventTitle,
            text: isEn() ? 'You are invited. Please view the invitation and let us know if you can join us.' : eventTitle + '에 초대합니다. 초대장을 확인하고 참석 여부를 알려주세요.',
            url: link,
          });
          return;
        } catch (err) {
          if (err && err.name === 'AbortError') return;
        }
      }
      try {
        await navigator.clipboard.writeText(link);
      } catch (err) {
        window.prompt(isEn() ? 'Copy this link:' : '이 링크를 복사해 주세요:', link);
        return;
      }
      btn.innerHTML = '<span><span class="wl-ko">복사했어요</span><span class="wl-en">Link copied</span></span>';
      clearTimeout(btn._resetTimer);
      btn._resetTimer = setTimeout(function () { btn.innerHTML = labelHtml; }, 2000);
    });
  });
})();
</script>

</BaseLayout>
