---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 예정된 이벤트. 새 이벤트가 생기면 이 목록에 추가한다.
const events = [
  {
    id: 'thanksgiving-night',
    title_ko: '감사의 밤',
    title_en: 'Night of Thanksgiving',
    date_ko: '일정 추후 공지',
    date_en: 'Date to be announced',
    place_ko: '장소 추후 공지',
    place_en: 'Venue to be announced',
    note_ko: '한 해 동안 함께해 주신 분들과 감사를 나누는 자리입니다.',
    note_en: 'An evening to give thanks together with those who walked with us this year.',
    open: true,
  },
];
---

<BaseLayout
  title="이벤트 참석 신청 — Word of Life Korea"
  description="월코 이벤트 참석 여부(RSVP)를 알려주세요. 감사의 밤 등 예정된 행사에 참석 신청하실 수 있습니다."
  activeNav="connect"
>

<style>
  :root {
    --d:#004f68; --m:#007ea1; --l:#73d1f5;
    --r:#c42a36; --k:#0d1b24; --s:#3d5a6a;
    --bg:#f4f8fb; --line:rgba(0,79,104,0.1);
    --f-sans:'Pretendard Variable',Pretendard,'Apple SD Gothic Neo',sans-serif;
  }

  .rv-hero {
    background: linear-gradient(135deg, #0a1e2b 0%, #004f68 60%, #006a8a 100%);
    padding: 140px 24px 96px; text-align: center; color: #fff;
  }
  .rv-hero-eyebrow {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 12px; font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(115,209,245,0.9); margin-bottom: 18px;
  }
  .rv-hero-eyebrow::before { content:''; width:28px; height:1px; background:rgba(115,209,245,0.6); }
  .rv-hero h1 { margin: 0 0 16px; font-size: clamp(30px, 5vw, 46px); font-weight: 800; line-height: 1.25; }
  .rv-hero p { margin: 0 auto; max-width: 560px; font-size: 15px; line-height: 1.85; color: rgba(255,255,255,0.82); word-break: keep-all; }

  .rv-wrap { max-width: 880px; margin: 0 auto; padding: 72px 24px 96px; }
  .rv-section-title { display:flex; align-items:center; gap:12px; margin: 0 0 24px; font-size: 13px; font-weight: 800; letter-spacing: 0.12em; color: var(--r); text-transform: uppercase; }
  .rv-section-title::after { content:''; flex:1; height:1px; background:var(--line); }

  .rv-card {
    border: 1px solid var(--line); border-radius: 18px; background: #fff;
    padding: 32px; box-shadow: 0 4px 24px rgba(0,79,104,0.06);
  }
  .rv-card + .rv-card { margin-top: 20px; }
  .rv-card-badge {
    display: inline-block; padding: 4px 12px; border-radius: 999px;
    background: rgba(0,126,161,0.1); color: var(--m);
    font-size: 11px; font-weight: 800; letter-spacing: 0.06em;
  }
  .rv-card h2 { margin: 14px 0 6px; font-size: 26px; font-weight: 800; color: var(--k); word-break: keep-all; }
  .rv-card-lead { margin: 0 0 22px; font-size: 14px; line-height: 1.8; color: var(--s); word-break: keep-all; }
  .rv-facts { display: grid; gap: 12px; margin-bottom: 22px; }
  .rv-fact { display: grid; grid-template-columns: 74px 1fr; gap: 12px; align-items: start; font-size: 14px; }
  .rv-fact dt { color: #7d939c; font-weight: 700; font-size: 12.5px; padding-top: 1px; }
  .rv-fact dd { margin: 0; color: var(--k); font-weight: 600; line-height: 1.6; word-break: keep-all; }

  .rv-parking {
    display: flex; gap: 12px; align-items: flex-start;
    padding: 14px 16px; border-radius: 12px;
    background: #fff7ed; border: 1px solid rgba(234,88,12,0.22);
    font-size: 13px; line-height: 1.7; color: #7c2d12; word-break: keep-all;
  }
  .rv-parking svg { flex-shrink: 0; width: 18px; height: 18px; margin-top: 1px; stroke: currentColor; fill: none; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }

  .rv-card-actions { margin-top: 24px; }
  .rv-rsvp-btn {
    display: inline-flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 48px; padding: 0 30px; border: none; border-radius: 12px;
    background: var(--r); color: #fff; font-family: var(--f-sans);
    font-size: 15px; font-weight: 700; cursor: pointer;
    transition: background .2s, transform .18s, box-shadow .2s;
    box-shadow: 0 4px 14px rgba(196,42,54,0.22);
  }
  .rv-rsvp-btn:hover { background: #a82330; transform: translateY(-2px); box-shadow: 0 10px 26px rgba(196,42,54,0.3); }
  .rv-rsvp-btn:disabled { background: rgba(100,116,139,0.2); color: #64748b; cursor: default; transform: none; box-shadow: none; }

  .rv-empty { padding: 56px 24px; text-align: center; color: var(--s); }
  .rv-empty h3 { margin: 0 0 8px; font-size: 19px; font-weight: 800; color: var(--k); }
  .rv-empty p { margin: 0; font-size: 14px; line-height: 1.8; }

  /* ── 모달 ── */
  .rv-modal { position: fixed; inset: 0; z-index: 900; display: grid; place-items: center; padding: 20px; background: rgba(6,31,40,0.62); backdrop-filter: blur(6px); overflow-y: auto; }
  .rv-modal[hidden] { display: none; }
  .rv-modal-card { width: min(520px, 100%); max-height: calc(100dvh - 40px); overflow-y: auto; border-radius: 18px; background: #fff; box-shadow: 0 26px 80px rgba(0,0,0,0.3); }
  .rv-modal-head { position: relative; padding: 26px 28px 20px; background: linear-gradient(135deg, #004f68 0%, #007ea1 100%); color: #fff; }
  .rv-modal-head .rv-modal-eyebrow { font-size: 11px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(115,209,245,0.9); }
  .rv-modal-head h3 { margin: 6px 0 0; font-size: 21px; font-weight: 800; }
  .rv-modal-close {
    position: absolute; top: 14px; right: 14px;
    width: 36px !important; height: 36px !important; min-width: 36px !important; min-height: 36px !important;
    padding: 0; border-radius: 50%; border: 1px solid rgba(255,255,255,0.5);
    background: rgba(255,255,255,0.12); color: #fff; font-size: 18px; line-height: 1;
    display: inline-flex; align-items: center; justify-content: center; cursor: pointer;
  }
  .rv-modal-body { padding: 24px 28px 28px; }
  .rv-field { margin-bottom: 16px; }
  .rv-field label { display: block; margin-bottom: 6px; font-size: 12.5px; font-weight: 700; color: var(--s); }
  .rv-field .req { color: var(--r); margin-left: 2px; }
  .rv-field input, .rv-field select, .rv-field textarea {
    width: 100%; box-sizing: border-box; border: 1.5px solid rgba(0,79,104,0.14);
    border-radius: 9px; padding: 10px 13px; background: #f7fbfd;
    font-family: var(--f-sans); font-size: 14px; color: var(--k); outline: none;
    transition: border-color .2s, box-shadow .2s, background .2s;
  }
  .rv-field input, .rv-field select { height: 42px !important; min-height: 42px !important; }
  .rv-field textarea { min-height: 78px; resize: vertical; }
  .rv-field input:focus, .rv-field select:focus, .rv-field textarea:focus { border-color: var(--m); background: #fff; box-shadow: 0 0 0 3px rgba(0,126,161,0.1); }
  .rv-field input.error, .rv-field select.error { border-color: var(--r); }
  .rv-field-hint { margin: 6px 0 0; font-size: 11.5px; color: #7d939c; line-height: 1.6; }
  .rv-consent { display: flex; gap: 9px; align-items: flex-start; margin-top: 4px; font-size: 12px; line-height: 1.7; color: var(--s); }
  .rv-consent input { width: 17px !important; height: 17px !important; min-height: 0 !important; margin: 2px 0 0; accent-color: var(--m); flex-shrink: 0; }
  .rv-error { display: none; margin-top: 14px; padding: 10px 13px; border-radius: 9px; background: #fdeced; color: #a4242f; font-size: 12.5px; font-weight: 600; line-height: 1.6; }
  .rv-error.show { display: block; }
  .rv-submit {
    width: 100%; min-height: 48px; margin-top: 20px; border: none; border-radius: 12px;
    background: var(--r); color: #fff; font-family: var(--f-sans); font-size: 15px; font-weight: 700;
    cursor: pointer; transition: background .2s;
  }
  .rv-submit:hover:not(:disabled) { background: #a82330; }
  .rv-submit:disabled { opacity: 0.6; cursor: wait; }
  .rv-success { padding: 40px 28px 34px; text-align: center; }
  .rv-success-icon { width: 60px; height: 60px; margin: 0 auto 18px; border-radius: 50%; background: rgba(0,126,161,0.1); color: var(--m); display: grid; place-items: center; }
  .rv-success-icon svg { width: 28px; height: 28px; stroke: currentColor; fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .rv-success h3 { margin: 0 0 10px; font-size: 21px; font-weight: 800; color: var(--k); }
  .rv-success p { margin: 0 0 24px; font-size: 14px; line-height: 1.8; color: var(--s); word-break: keep-all; }

  @media (max-width: 640px) {
    .rv-hero { padding: 116px 20px 72px; }
    .rv-wrap { padding: 52px 18px 72px; }
    .rv-card { padding: 24px 20px; }
    .rv-fact { grid-template-columns: 62px 1fr; font-size: 13.5px; }
    .rv-modal-body { padding: 20px 20px 24px; }
    .rv-modal-head { padding: 22px 20px 18px; }
  }
</style>

<section class="rv-hero">
  <div class="rv-hero-eyebrow">WOLKO EVENT · RSVP</div>
  <h1>
    <span class="wl-ko">이벤트 참석 신청</span>
    <span class="wl-en">Event RSVP</span>
  </h1>
  <p>
    <span class="wl-ko">월코의 예정된 행사에 함께해 주세요. 참석 여부를 미리 알려주시면 자리를 준비하는 데 큰 도움이 됩니다.</span>
    <span class="wl-en">Join us at our upcoming events. Letting us know in advance helps us prepare a place for you.</span>
  </p>
</section>

<div class="rv-wrap">
  <h2 class="rv-section-title">
    <span class="wl-ko">예정된 행사</span><span class="wl-en">Upcoming Events</span>
  </h2>

  {events.length > 0 ? events.map((event) => (
    <div class="rv-card">
      <span class="rv-card-badge">
        <span class="wl-ko">참석 신청 받는 중</span><span class="wl-en">RSVP Open</span>
      </span>
      <h2>
        <span class="wl-ko">{event.title_ko}</span>
        <span class="wl-en">{event.title_en}</span>
      </h2>
      <p class="rv-card-lead">
        <span class="wl-ko">{event.note_ko}</span>
        <span class="wl-en">{event.note_en}</span>
      </p>

      <dl class="rv-facts">
        <div class="rv-fact">
          <dt><span class="wl-ko">일정</span><span class="wl-en">Date</span></dt>
          <dd><span class="wl-ko">{event.date_ko}</span><span class="wl-en">{event.date_en}</span></dd>
        </div>
        <div class="rv-fact">
          <dt><span class="wl-ko">장소</span><span class="wl-en">Venue</span></dt>
          <dd><span class="wl-ko">{event.place_ko}</span><span class="wl-en">{event.place_en}</span></dd>
        </div>
      </dl>

      <div class="rv-parking">
        <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/></svg>
        <span>
          <span class="wl-ko">주차장이 협소하여 길 건너편 공영 주차장을 이용하셔야 할 수 있습니다. 가능하시면 대중교통이나 함께 타고 오시기를 부탁드립니다.</span>
          <span class="wl-en">On-site parking is limited, so you may need to use the public parking lot across the street. If possible, please use public transport or carpool.</span>
        </span>
      </div>

      <div class="rv-card-actions">
        <button
          type="button"
          class="rv-rsvp-btn rsvp-open-btn"
          data-event-id={event.id}
          data-event-title-ko={event.title_ko}
          data-event-title-en={event.title_en}
        >
          <span class="wl-ko">참석 신청하기 →</span>
          <span class="wl-en">RSVP →</span>
        </button>
      </div>
    </div>
  )) : (
    <div class="rv-card rv-empty">
      <h3>
        <span class="wl-ko">예정된 행사가 없습니다</span>
        <span class="wl-en">No upcoming events</span>
      </h3>
      <p>
        <span class="wl-ko">새로운 행사가 정해지면 이곳에 안내해 드릴게요.</span>
        <span class="wl-en">We'll announce new events here as they are scheduled.</span>
      </p>
    </div>
  )}
</div>

<!-- RSVP 모달 -->
<div class="rv-modal" id="rsvpModal" hidden>
  <div class="rv-modal-card" role="dialog" aria-modal="true" aria-labelledby="rsvpModalTitle">
    <div class="rv-modal-head">
      <button type="button" class="rv-modal-close" id="rsvpCloseBtn" aria-label="닫기">×</button>
      <div class="rv-modal-eyebrow">RSVP</div>
      <h3 id="rsvpModalTitle"></h3>
    </div>

    <div class="rv-modal-body" id="rsvpFormWrap">
      <form id="rsvpForm" novalidate>
        <input type="hidden" id="rsvpEventId">

        <div class="rv-field">
          <label for="rsvpName"><span class="wl-ko">성함</span><span class="wl-en">Name</span> <span class="req">*</span></label>
          <input id="rsvpName" name="name" maxlength="60" autocomplete="name" placeholder="예: 홍길동">
        </div>

        <div class="rv-field">
          <label for="rsvpPhone"><span class="wl-ko">전화번호</span><span class="wl-en">Phone</span> <span class="req">*</span></label>
          <input id="rsvpPhone" name="phone" type="tel" maxlength="30" autocomplete="tel" placeholder="010-0000-0000">
        </div>

        <div class="rv-field">
          <label for="rsvpEmail"><span class="wl-ko">이메일 주소</span><span class="wl-en">Email</span> <span class="req">*</span></label>
          <input id="rsvpEmail" name="email" type="email" maxlength="120" autocomplete="email" placeholder="example@email.com">
        </div>

        <div class="rv-field">
          <label for="rsvpPartySize"><span class="wl-ko">참석 인원</span><span class="wl-en">Number attending</span> <span class="req">*</span></label>
          <select id="rsvpPartySize" name="partySize">
            <option value="1">1</option>
            <option value="2">2</option>
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
            <option value="7">7</option>
            <option value="8">8</option>
            <option value="9">9</option>
            <option value="more">10명 이상 / 10+</option>
          </select>
          <p class="rv-field-hint">
            <span class="wl-ko">본인을 포함한 인원을 선택해 주세요. 동반하시는 분이 있다면 함께 세어 주세요.</span>
            <span class="wl-en">Include yourself in the count, along with anyone coming with you.</span>
          </p>
        </div>

        <div class="rv-field" id="rsvpPartySizeCustomField" hidden>
          <label for="rsvpPartySizeCustom"><span class="wl-ko">참석 인원을 적어 주세요</span><span class="wl-en">Enter the number attending</span> <span class="req">*</span></label>
          <input id="rsvpPartySizeCustom" type="number" inputmode="numeric" min="10" max="200" step="1" placeholder="10">
          <p class="rv-field-hint">
            <span class="wl-ko">단체로 오시는 경우 대략적인 인원도 괜찮습니다. 확정되면 다시 알려주세요.</span>
            <span class="wl-en">For groups, an approximate number is fine — just let us know once it's confirmed.</span>
          </p>
        </div>

        <div class="rv-field">
          <label for="rsvpNotes"><span class="wl-ko">남기실 말씀이 있으면 적어 주세요</span><span class="wl-en">Anything you'd like us to know</span></label>
          <textarea id="rsvpNotes" name="notes" rows="3" maxlength="1000"></textarea>
        </div>

        <label class="rv-consent" for="rsvpConsent">
          <input type="checkbox" id="rsvpConsent">
          <span>
            <span class="wl-ko">참석 안내를 위한 개인정보(성함, 연락처, 이메일) 수집·이용에 동의합니다. 행사 종료 후 별도 요청 시까지 보관합니다.</span>
            <span class="wl-en">I agree to the collection and use of my name, phone number, and email for event communication. Kept until deletion is requested after the event.</span>
          </span>
        </label>

        <div class="rv-error" id="rsvpError"></div>

        <button type="submit" class="rv-submit" id="rsvpSubmitBtn">
          <span class="wl-ko">참석 신청하기</span><span class="wl-en">Send RSVP</span>
        </button>
      </form>
    </div>

    <div class="rv-success" id="rsvpSuccessWrap" hidden>
      <div class="rv-success-icon">
        <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
      </div>
      <h3>
        <span class="wl-ko">참석 신청이 접수되었습니다!</span>
        <span class="wl-en">Your RSVP has been received!</span>
      </h3>
      <p id="rsvpSuccessMsg"></p>
      <button type="button" class="rv-rsvp-btn" id="rsvpSuccessClose" style="background:var(--m);box-shadow:none;">
        <span class="wl-ko">확인</span><span class="wl-en">Close</span>
      </button>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  var modal = document.getElementById('rsvpModal');
  if (!modal) return;
  var form = document.getElementById('rsvpForm');
  var formWrap = document.getElementById('rsvpFormWrap');
  var successWrap = document.getElementById('rsvpSuccessWrap');
  var errorBox = document.getElementById('rsvpError');
  var submitBtn = document.getElementById('rsvpSubmitBtn');
  var titleEl = document.getElementById('rsvpModalTitle');
  var eventIdInput = document.getElementById('rsvpEventId');

  function byId(id) { return document.getElementById(id); }
  function isEn() {
    var root = document.getElementById('lang-root') || document.body;
    return root.classList.contains('lang-en');
  }
  function showError(ko, en) {
    errorBox.textContent = isEn() ? en : ko;
    errorBox.dataset.ko = ko;
    errorBox.dataset.en = en;
    errorBox.classList.add('show');
  }
  function clearErrors() {
    errorBox.classList.remove('show');
    form.querySelectorAll('.error').forEach(function (el) { el.classList.remove('error'); });
  }
  function markInvalid(id) {
    var el = byId(id);
    if (!el) return;
    el.classList.add('error');
    el.scrollIntoView({ block: 'center', behavior: 'smooth' });
    el.focus({ preventScroll: true });
  }
  function openModal(btn) {
    eventIdInput.value = btn.dataset.eventId || '';
    titleEl.textContent = isEn() ? (btn.dataset.eventTitleEn || '') : (btn.dataset.eventTitleKo || '');
    form.reset();
    syncPartySizeCustom();
    clearErrors();
    formWrap.hidden = false;
    successWrap.hidden = true;
    submitBtn.disabled = false;
    modal.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal.hidden = true;
    document.body.style.overflow = '';
  }

  document.querySelectorAll('.rsvp-open-btn').forEach(function (btn) {
    btn.addEventListener('click', function () { openModal(btn); });
  });
  byId('rsvpCloseBtn').addEventListener('click', closeModal);
  byId('rsvpSuccessClose').addEventListener('click', closeModal);
  modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });
  form.addEventListener('input', function (e) {
    if (e.target.classList) e.target.classList.remove('error');
  });

  // 10명 이상을 고르면 직접 입력 칸을 연다.
  function syncPartySizeCustom() {
    var isMore = byId('rsvpPartySize').value === 'more';
    byId('rsvpPartySizeCustomField').hidden = !isMore;
    if (!isMore) byId('rsvpPartySizeCustom').value = '';
  }
  byId('rsvpPartySize').addEventListener('change', syncPartySizeCustom);

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    clearErrors();

    var payload = {
      eventId: eventIdInput.value,
      name: byId('rsvpName').value.trim(),
      phone: byId('rsvpPhone').value.trim(),
      email: byId('rsvpEmail').value.trim(),
      partySize: byId('rsvpPartySize').value === 'more'
        ? Number(byId('rsvpPartySizeCustom').value)
        : Number(byId('rsvpPartySize').value),
      notes: byId('rsvpNotes').value.trim(),
    };

    var checks = [
      [!payload.name, 'rsvpName', '성함을 입력해 주세요.', 'Please enter your name.'],
      [!payload.phone, 'rsvpPhone', '전화번호를 입력해 주세요.', 'Please enter your phone number.'],
      [!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email), 'rsvpEmail', '이메일 주소를 정확히 입력해 주세요.', 'Please enter a valid email address.'],
      [byId('rsvpPartySize').value === 'more' && (!Number.isInteger(payload.partySize) || payload.partySize < 10 || payload.partySize > 200), 'rsvpPartySizeCustom', '참석 인원을 10명 이상 200명 이하로 적어 주세요.', 'Please enter a number between 10 and 200.'],
      [!payload.partySize, 'rsvpPartySize', '참석 인원을 선택해 주세요.', 'Please select how many will attend.'],
      [!byId('rsvpConsent').checked, 'rsvpConsent', '개인정보 수집 및 이용에 동의해 주세요.', 'Please agree to the privacy notice.'],
    ];
    for (var i = 0; i < checks.length; i++) {
      if (checks[i][0]) {
        showError(checks[i][2], checks[i][3]);
        markInvalid(checks[i][1]);
        return;
      }
    }

    submitBtn.disabled = true;
    try {
      var res = await fetch('/api/rsvp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      var data = await res.json();
      if (res.ok && data.success) {
        formWrap.hidden = true;
        successWrap.hidden = false;
        byId('rsvpSuccessMsg').innerHTML = isEn()
          ? '<strong>' + payload.name + '</strong>, we have you down for ' + payload.partySize + ' guest(s). See you soon!'
          : '<strong>' + payload.name + '</strong>님 포함 총 ' + payload.partySize + '명으로 접수되었습니다. 행사에서 뵙겠습니다!';
      } else {
        showError(data.error || '오류가 발생했습니다. 다시 시도해 주세요.', data.error || 'Something went wrong. Please try again.');
        submitBtn.disabled = false;
      }
    } catch (err) {
      showError('네트워크 오류가 발생했습니다. 다시 시도해 주세요.', 'A network error occurred. Please try again.');
      submitBtn.disabled = false;
    }
  });
})();
</script>

</BaseLayout>
