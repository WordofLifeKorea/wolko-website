---
// 카카오톡으로 보내는 모바일 초대장. /rsvp/ 목록에서 "참석 신청하기"를 누르면 이 페이지로 이동한다.
import '../../styles/global.css';

const event = {
  id: 'thanksgiving-night',
  title: '감사의 밤',
  date: '2026년 11월 26일(목) 오후 7시',
  place: '장소 추후 공지',
};

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL('/images/rsvp-share.png', Astro.site).toString();
const ogTitle = '감사의 밤에 초대합니다 — WOLKO';
const ogDescription = '11월 26일(목) 오후 7시 · 월코 사역에 함께해 주신 분들께 감사를 전하는 자리에 초대합니다.';

// 아래에서 위로 둥실둥실 떠오르는 풍선(이모지): [왼쪽 위치 %, 크기 px, 떠오르는 시간 s, 시작 지연 s, 글자]
const balloons = [
  [5, 30, 9,  0,  '🎈'], [16, 24, 10.5, 1.4, '🎈'], [27, 32, 8.5, .5, '🎈'],
  [38, 22, 11, 2.2, '🎈'], [49, 30, 9.5, .9, '🎈'], [60, 24, 10, 1.8, '🎈'],
  [71, 32, 9,  .3, '🎈'], [82, 22, 10.5, 1.6, '🎈'], [92, 28, 9.5, .7, '🎈'],
];
---

<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>{ogTitle}</title>
  <meta name="description" content={ogDescription}>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="canonical" href={pageUrl}>
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="WOLKO 월코">
  <meta property="og:title" content={ogTitle}>
  <meta property="og:description" content={ogDescription}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="theme-color" content="#5c211b">

  <style>
    :root {
      --wine:#5c211b; --rust:#9a3b22; --amber:#d9772f; --gold:#e8a547;
      --cream:#fff8ec; --paper:#fdf4e6; --ink:#3b1f17; --muted:#8a6552;
      --line:rgba(122,62,34,0.16);
      --serif:'AppleMyungjo','Nanum Myeongjo','Noto Serif KR',serif;
      --sans:'Pretendard Variable',Pretendard,'Apple SD Gothic Neo',sans-serif;
    }
    html, body { margin:0; padding:0; background:#3a1612; }
    body { font-family:var(--sans); color:var(--ink); -webkit-font-smoothing:antialiased; }
    .inv { max-width:480px; margin:0 auto; background:var(--paper); min-height:100vh; box-shadow:0 0 60px rgba(0,0,0,0.35); overflow:hidden; }

    /* 표지 */
    .inv-cover {
      position:relative; min-height:88vh; padding:72px 28px 56px;
      display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center;
      background:radial-gradient(120% 80% at 50% 0%, #8a3620 0%, var(--wine) 55%, #3a1612 100%);
      color:var(--cream); overflow:hidden;
    }
    .inv-balloon { position:absolute; bottom:-12%; opacity:0; font-size:inherit; line-height:1; animation:inv-balloon-rise ease-in-out infinite; pointer-events:none; filter:drop-shadow(0 3px 5px rgba(0,0,0,.22)); }
    @keyframes inv-balloon-rise {
      0%   { transform:translate3d(0,0,0) rotate(-4deg); opacity:0; }
      14%  { opacity:.95; }
      35%  { transform:translate3d(14px,-32vh,0) rotate(4deg); }
      55%  { transform:translate3d(-12px,-56vh,0) rotate(-3deg); }
      75%  { transform:translate3d(10px,-80vh,0) rotate(3deg); opacity:.95; }
      92%  { opacity:.5; }
      100% { transform:translate3d(-6px,-104vh,0) rotate(0deg); opacity:0; }
    }

    /* 스크롤로 들어오는 섹션 공통 연출 */
    [data-reveal] { opacity:0; transform:translateY(26px); transition:opacity .7s cubic-bezier(.2,.7,.3,1), transform .7s cubic-bezier(.2,.7,.3,1); }
    [data-reveal].is-visible { opacity:1; transform:translateY(0); }
    [data-reveal="stagger"] > * { opacity:0; transform:translateY(16px); transition:opacity .6s ease, transform .6s ease; }
    [data-reveal="stagger"].is-visible > * { opacity:1; transform:translateY(0); }
    [data-reveal="stagger"].is-visible > *:nth-child(1) { transition-delay:.02s; }
    [data-reveal="stagger"].is-visible > *:nth-child(2) { transition-delay:.1s; }
    [data-reveal="stagger"].is-visible > *:nth-child(3) { transition-delay:.18s; }
    [data-reveal="stagger"].is-visible > *:nth-child(4) { transition-delay:.26s; }
    [data-reveal="stagger"].is-visible > *:nth-child(5) { transition-delay:.34s; }
    [data-reveal="stagger"].is-visible > *:nth-child(6) { transition-delay:.42s; }

    /* 표지 문구: 순서대로 떠오르는 첫 진입 연출 */
    .inv-cover-anim { opacity:0; transform:translateY(14px); animation:inv-rise .8s cubic-bezier(.2,.7,.3,1) forwards; }
    @keyframes inv-rise { to { opacity:1; transform:translateY(0); } }

    @media (prefers-reduced-motion: reduce) {
      .inv-balloon { display:none; }
      [data-reveal], [data-reveal="stagger"] > *, .inv-cover-anim { opacity:1 !important; transform:none !important; transition:none !important; animation:none !important; }
    }
    .inv-eyebrow { position:relative; font-size:12px; font-weight:700; letter-spacing:0.32em; color:var(--gold); }
    .inv-title { position:relative; margin:22px 0 14px; font-family:var(--serif); font-size:52px; font-weight:600; letter-spacing:0.04em; line-height:1.2; }
    .inv-title-en { position:relative; font-size:14px; font-weight:700; letter-spacing:0.18em; color:rgba(255,248,236,0.75); }
    .inv-cover-rule { position:relative; width:56px; height:1px; margin:28px auto; background:rgba(232,165,71,0.7); }
    .inv-cover-when { position:relative; font-size:15px; line-height:1.9; color:rgba(255,248,236,0.9); }

    /* 본문 공통 */
    .inv-section { padding:56px 30px; text-align:center; }
    .inv-section + .inv-section { border-top:1px solid var(--line); }
    .inv-label { font-size:11px; font-weight:800; letter-spacing:0.28em; color:var(--amber); margin-bottom:18px; }
    .inv-h { margin:0 0 20px; font-family:var(--serif); font-size:24px; font-weight:700; color:var(--wine); }
    .inv-p { margin:0; font-size:15px; line-height:2; color:var(--ink); word-break:keep-all; }
    .inv-sign { margin-top:22px; font-size:13.5px; color:var(--muted); }

    .inv-verse { margin:0 auto; max-width:340px; padding:26px 22px; border-radius:16px; background:var(--cream); border:1px solid var(--line); }
    .inv-verse p { margin:0; font-family:var(--serif); font-size:17px; font-weight:600; line-height:1.9; color:var(--wine); word-break:keep-all; }
    .inv-verse cite { display:block; margin-top:12px; font-style:normal; font-size:12.5px; color:var(--muted); }

    .inv-info { max-width:320px; margin:0 auto; text-align:center; }
    .inv-info-row { padding:18px 0; border-bottom:1px solid var(--line); }
    .inv-info-row:last-child { border-bottom:0; }
    .inv-info-row dt { font-size:11px; font-weight:800; letter-spacing:0.24em; color:var(--amber); }
    .inv-info-row dd { margin:8px 0 0; font-size:17px; font-weight:600; color:var(--ink); line-height:1.5; word-break:keep-all; }

    .inv-parking { max-width:340px; margin:16px auto 0; padding:14px 16px; border-radius:12px; background:#fff1dc; border:1px solid rgba(217,119,47,0.3); font-size:13.5px; line-height:1.75; color:#7a3a17; text-align:left; word-break:keep-all; }
    .inv-parking b { display:block; margin-bottom:3px; }

    /* 참석 신청 */
    .inv-form { max-width:340px; margin:0 auto; text-align:left; }
    .inv-field { margin-bottom:14px; }
    .inv-field label { display:block; margin-bottom:6px; font-size:13px; font-weight:700; color:var(--muted); }
    .inv-field .req { color:var(--rust); margin-left:2px; }
    .inv-field input, .inv-field select, .inv-field textarea {
      width:100%; box-sizing:border-box; border:1.5px solid rgba(122,62,34,0.2); border-radius:11px;
      padding:11px 13px; background:#fff; font-family:var(--sans); font-size:16px; color:var(--ink); outline:none;
      -webkit-appearance:none; appearance:none;
    }
    .inv-field input, .inv-field select { height:46px !important; min-height:46px !important; }
    .inv-field select { background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%); background-position:calc(100% - 18px) 50%,calc(100% - 13px) 50%; background-size:5px 5px; background-repeat:no-repeat; }
    .inv-field textarea { min-height:80px; resize:vertical; }
    .inv-field input:focus, .inv-field select:focus, .inv-field textarea:focus { border-color:var(--amber); box-shadow:0 0 0 3px rgba(217,119,47,0.15); }
    .inv-field .error { border-color:var(--rust); }
    .inv-hint { margin:6px 0 0; font-size:12px; line-height:1.6; color:var(--muted); }
    .inv-consent { display:flex; gap:9px; align-items:flex-start; margin-top:6px; font-size:12.5px; line-height:1.7; color:var(--muted); }
    .inv-consent input { width:18px !important; height:18px !important; min-height:0 !important; margin:2px 0 0; accent-color:var(--rust); flex-shrink:0; }
    .inv-error { display:none; margin-top:14px; padding:11px 13px; border-radius:10px; background:#fde8e3; color:#9a2a18; font-size:13px; font-weight:600; line-height:1.6; }
    .inv-error.show { display:block; }
    .inv-btn {
      display:flex; align-items:center; justify-content:center; gap:8px; width:100%; min-height:52px; margin-top:18px;
      border:none; border-radius:14px; background:linear-gradient(135deg,var(--rust),var(--amber)); color:#fff;
      font-family:var(--sans); font-size:16px; font-weight:800; letter-spacing:0.02em; cursor:pointer;
      box-shadow:0 8px 22px rgba(154,59,34,0.28);
    }
    .inv-btn:disabled { opacity:0.6; cursor:wait; }
    .inv-btn:active:not(:disabled) { transform:scale(.97); }
    .inv-share button:active { transform:scale(.96); background:#fdf6ec; }
        .inv-done { display:none; max-width:340px; margin:0 auto; padding:30px 22px; border-radius:18px; background:#fff; border:1px solid var(--line); opacity:0; transform:translateY(10px) scale(.97); }
    .inv-done.show { display:block; animation:inv-pop .55s cubic-bezier(.2,.8,.3,1.2) forwards; }
    @keyframes inv-pop { to { opacity:1; transform:translateY(0) scale(1); } }
        .inv-done-mark { width:56px; height:56px; margin:0 auto 16px; border-radius:50%; background:rgba(217,119,47,0.14); color:var(--rust); display:grid; place-items:center; animation:inv-ring 1.4s ease-in-out .1s 1; }
    .inv-done-mark svg { width:26px; height:26px; stroke:currentColor; fill:none; stroke-width:2.2; stroke-linecap:round; stroke-linejoin:round; }
    .inv-done-mark svg path { stroke-dasharray:24; stroke-dashoffset:24; animation:inv-draw .5s ease .35s forwards; }
    @keyframes inv-draw { to { stroke-dashoffset:0; } }
    @keyframes inv-ring { 0%,100% { box-shadow:0 0 0 0 rgba(217,119,47,.28); } 60% { box-shadow:0 0 0 10px rgba(217,119,47,0); } }
    .inv-done h3 { margin:0 0 10px; font-family:var(--serif); font-size:22px; font-weight:700; color:var(--wine); }
    .inv-done p { margin:0; font-size:14.5px; line-height:1.85; color:var(--ink); word-break:keep-all; }

    /* 공유 · 푸터 */
    .inv-share { display:flex; gap:10px; max-width:340px; margin:0 auto; }
    .inv-share button { flex:1; min-height:48px; border-radius:12px; border:1.5px solid rgba(122,62,34,0.22); background:#fff; color:var(--wine); font-family:var(--sans); font-size:14px; font-weight:700; cursor:pointer; }
    .inv-footer { padding:34px 24px 44px; text-align:center; background:var(--wine); color:rgba(255,248,236,0.7); font-size:12px; line-height:1.8; }
    .inv-footer b { display:block; margin-bottom:4px; color:var(--cream); font-size:13px; letter-spacing:0.06em; }
    .inv-footer a { color:var(--gold); text-decoration:none; }

    /* 배경음악 토글 */
    .inv-music { position:fixed; right:max(18px, calc((100% - 480px) / 2 + 18px)); bottom:18px; z-index:20;
      width:46px; height:46px; border-radius:50%; border:1px solid rgba(255,248,236,.5);
      background:rgba(58,22,18,.72); backdrop-filter:blur(6px); color:var(--cream);
      display:grid; place-items:center; cursor:pointer; box-shadow:0 6px 20px rgba(0,0,0,.25);
      transition:background .2s, transform .18s; }
    .inv-music:hover { background:rgba(58,22,18,.88); }
    .inv-music:active { transform:scale(.94); }
    .inv-music svg { width:19px; height:19px; stroke:currentColor; fill:none; stroke-width:1.9; stroke-linecap:round; stroke-linejoin:round; }
    .inv-music[hidden] { display:none; }
    .inv-music.is-playing svg { animation:inv-note-bob 1.6s ease-in-out infinite; }
    @keyframes inv-note-bob { 0%,100% { transform:translateY(0) rotate(0deg); } 50% { transform:translateY(-2px) rotate(-6deg); } }
    @media (prefers-reduced-motion: reduce) { .inv-music.is-playing svg { animation:none; } }
  </style>
</head>
<body>
<main class="inv">

  <!-- 표지 -->
  <header class="inv-cover">
    {balloons.map(([left, size, dur, delay, glyph]) => (
      <span class="inv-balloon" aria-hidden="true"
        style={`left:${left}%;font-size:${size}px;animation-duration:${dur}s;animation-delay:-${delay}s;`}>{glyph}</span>
    ))}
    <div class="inv-eyebrow inv-cover-anim" style="animation-delay:.15s">INVITATION</div>
    <h1 class="inv-title inv-cover-anim" style="animation-delay:.32s">{event.title}</h1>
    <div class="inv-title-en inv-cover-anim" style="animation-delay:.5s">NIGHT OF THANKSGIVING</div>
    <div class="inv-cover-rule inv-cover-anim" style="animation-delay:.68s"></div>
    <div class="inv-cover-when inv-cover-anim" style="animation-delay:.84s">{event.date}<br>{event.place}</div>
  </header>

  <!-- 초대 인사 -->
  <section class="inv-section" data-reveal>
    <div class="inv-label">WITH GRATITUDE</div>
    <h2 class="inv-h">초대합니다</h2>
    <p class="inv-p">
      한 해 동안 캠프와 훈련, 기도와 섬김으로<br>
      월코 사역에 참여하고 동참해 주신<br>
      모든 분들께 감사드립니다.<br><br>
      하나님께서 이 땅의 다음 세대 가운데<br>
      행하신 일들을 함께 나누며<br>
      저녁 한 끼 나누고 싶습니다.<br>
      바쁘시더라도 시간 내어 와 주세요.
    </p>
    <p class="inv-sign">Word of Life Korea 드림</p>
  </section>

  <!-- 말씀 -->
  <section class="inv-section" data-reveal>
    <blockquote class="inv-verse">
      <p>여호와께 감사하라<br>그는 선하시며<br>그 인자하심이 영원함이로다</p>
      <cite>시편 107편 1절</cite>
    </blockquote>
  </section>

  <!-- 일시 · 장소 -->
  <section class="inv-section" data-reveal>
    <div class="inv-label">WHEN &amp; WHERE</div>
    <h2 class="inv-h">일시와 장소</h2>
    <dl class="inv-info" data-reveal="stagger">
      <div class="inv-info-row">
        <dt>일시</dt>
        <dd>{event.date}</dd>
      </div>
      <div class="inv-info-row">
        <dt>장소</dt>
        <dd>{event.place}</dd>
      </div>
    </dl>
    <div class="inv-parking">
      <b>주차 안내</b>
      주차장이 협소하여 길 건너편 공영 주차장을 이용하셔야 할 수 있습니다. 가능하시면 대중교통을 이용하시거나 함께 타고 와 주세요.
    </div>
  </section>

  <!-- 참석 신청 -->
  <section class="inv-section" id="rsvp" data-reveal>
    <div class="inv-label">RSVP</div>
    <h2 class="inv-h">참석 여부를 알려주세요</h2>
    <p class="inv-p" style="margin-bottom:26px;">자리 준비를 위해 미리 알려주시면<br>큰 도움이 됩니다.</p>

    <form class="inv-form" id="invForm" novalidate>
      <div class="inv-field">
        <label for="invName">성함 <span class="req">*</span></label>
        <input id="invName" maxlength="60" autocomplete="name" placeholder="홍길동">
      </div>
      <div class="inv-field">
        <label for="invPhone">전화번호 <span class="req">*</span></label>
        <input id="invPhone" type="tel" maxlength="30" autocomplete="tel" placeholder="010-0000-0000">
      </div>
      <div class="inv-field">
        <label for="invEmail">이메일 <span class="req">*</span></label>
        <input id="invEmail" type="email" maxlength="120" autocomplete="email" placeholder="example@email.com">
      </div>
      <div class="inv-field">
        <label for="invParty">참석 인원 (본인 포함) <span class="req">*</span></label>
        <select id="invParty">
          <option value="1">1명</option><option value="2">2명</option><option value="3">3명</option>
          <option value="4">4명</option><option value="5">5명</option><option value="6">6명</option>
          <option value="7">7명</option><option value="8">8명</option><option value="9">9명</option>
          <option value="more">10명 이상</option>
        </select>
      </div>
      <div class="inv-field" id="invPartyCustomField" hidden>
        <label for="invPartyCustom">참석 인원을 적어 주세요 <span class="req">*</span></label>
        <input id="invPartyCustom" type="number" inputmode="numeric" min="10" max="200" placeholder="10">
        <p class="inv-hint">단체로 오시는 경우 대략적인 인원도 괜찮습니다.</p>
      </div>
      <div class="inv-field">
        <label for="invNotes">남기실 말씀 (선택)</label>
        <textarea id="invNotes" maxlength="1000" placeholder="축하와 감사의 한마디도 좋아요"></textarea>
      </div>
      <label class="inv-consent" for="invConsent">
        <input type="checkbox" id="invConsent">
        <span>참석 안내를 위한 개인정보(성함, 연락처, 이메일) 수집·이용에 동의합니다.</span>
      </label>
      <div class="inv-error" id="invError"></div>
      <button type="submit" class="inv-btn" id="invSubmit">참석 신청하기</button>
    </form>

    <div class="inv-done" id="invDone">
      <div class="inv-done-mark"><svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></svg></div>
      <h3>감사합니다</h3>
      <p id="invDoneMsg"></p>
    </div>
  </section>

  <!-- 공유 -->
  <section class="inv-section" data-reveal>
    <div class="inv-label">SHARE</div>
    <h2 class="inv-h">초대장 전하기</h2>
    <div class="inv-share">
      <button type="button" id="invShare">공유하기</button>
      <button type="button" id="invCopy">링크 복사</button>
    </div>
  </section>

  <footer class="inv-footer">
    <b>WORD OF LIFE KOREA</b>
    문의 031-611-9216 · <a href="mailto:wolkorea1@gmail.com">wolkorea1@gmail.com</a><br>
    <a href="https://wolko.org">wolko.org</a>
  </footer>
</main>

<!-- 배경음악: public/audio/rsvp-bgm.mp3 를 넣으면 자동으로 재생 버튼이 나타난다. 파일이 없으면 조용히 숨는다. -->
<audio id="invBgm" loop playsinline preload="none">
  <source src="/audio/rsvp-bgm.mp3" type="audio/mpeg">
</audio>
<button type="button" class="inv-music" id="invMusicToggle" hidden aria-label="배경음악 재생/일시정지" aria-pressed="false">
  <svg viewBox="0 0 24 24" id="invMusicIconOn" hidden><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
  <svg viewBox="0 0 24 24" id="invMusicIconOff"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/><line x1="3" y1="3" x2="21" y2="21"/></svg>
</button>

<script is:inline define:vars={{ eventId: event.id, pageUrl }}>
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var form = $('invForm');
  var err = $('invError');
  var submit = $('invSubmit');

  function showError(msg, fieldId) {
    err.textContent = msg;
    err.classList.add('show');
    if (fieldId && $(fieldId)) {
      $(fieldId).classList.add('error');
      $(fieldId).scrollIntoView({ block: 'center', behavior: 'smooth' });
      $(fieldId).focus({ preventScroll: true });
    }
  }
  function clearErrors() {
    err.classList.remove('show');
    form.querySelectorAll('.error').forEach(function (el) { el.classList.remove('error'); });
  }

  $('invParty').addEventListener('change', function () {
    var more = this.value === 'more';
    $('invPartyCustomField').hidden = !more;
    if (!more) $('invPartyCustom').value = '';
  });
  form.addEventListener('input', function (e) { if (e.target.classList) e.target.classList.remove('error'); });

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    clearErrors();
    var more = $('invParty').value === 'more';
    var payload = {
      eventId: eventId,
      name: $('invName').value.trim(),
      phone: $('invPhone').value.trim(),
      email: $('invEmail').value.trim(),
      partySize: more ? Number($('invPartyCustom').value) : Number($('invParty').value),
      notes: $('invNotes').value.trim(),
    };
    if (!payload.name) return showError('성함을 입력해 주세요.', 'invName');
    if (!payload.phone) return showError('전화번호를 입력해 주세요.', 'invPhone');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email)) return showError('이메일 주소를 정확히 입력해 주세요.', 'invEmail');
    if (more && (!Number.isInteger(payload.partySize) || payload.partySize < 10 || payload.partySize > 200)) {
      return showError('참석 인원을 10명 이상 200명 이하로 적어 주세요.', 'invPartyCustom');
    }
    if (!$('invConsent').checked) return showError('개인정보 수집 및 이용에 동의해 주세요.', 'invConsent');

    submit.disabled = true;
    try {
      var res = await fetch('/api/rsvp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      var data = await res.json();
      if (res.ok && data.success) {
        form.style.display = 'none';
        $('invDone').classList.add('show');
        $('invDoneMsg').innerHTML = '';
        var strong = document.createElement('strong');
        strong.textContent = payload.name;
        $('invDoneMsg').appendChild(strong);
        $('invDoneMsg').appendChild(document.createTextNode('님 포함 총 ' + payload.partySize + '명으로 접수되었습니다. 감사의 밤에서 뵙겠습니다!'));
      } else {
        showError(data.error || '오류가 발생했습니다. 다시 시도해 주세요.');
        submit.disabled = false;
      }
    } catch (x) {
      showError('네트워크 오류가 발생했습니다. 다시 시도해 주세요.');
      submit.disabled = false;
    }
  });

  async function copyLink(btn) {
    try {
      await navigator.clipboard.writeText(pageUrl);
      var label = btn.textContent;
      btn.textContent = '복사했어요';
      setTimeout(function () { btn.textContent = label; }, 2000);
    } catch (x) {
      window.prompt('이 링크를 복사해 주세요:', pageUrl);
    }
  }
  $('invCopy').addEventListener('click', function () { copyLink(this); });
  $('invShare').addEventListener('click', async function () {
    if (navigator.share) {
      try { await navigator.share({ title: '감사의 밤에 초대합니다', text: '월코 감사의 밤 초대장', url: pageUrl }); } catch (x) { /* 공유 창을 닫은 경우 */ }
    } else {
      copyLink(this);
    }
  });

  // 스크롤에 맞춰 섹션이 살아나는 연출. 한 번 나타난 뒤에는 다시 감추지 않는다.
  if ('IntersectionObserver' in window) {
    var revealObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('[data-reveal]').forEach(function (el) { revealObserver.observe(el); });
  } else {
    document.querySelectorAll('[data-reveal]').forEach(function (el) { el.classList.add('is-visible'); });
  }

  // 배경음악: 파일이 실제로 있을 때만 버튼을 보여주고, 첫 화면 탭에서 재생을 시도한다.
  // (모바일 브라우저는 사용자 동작 없이는 자동재생을 막기 때문)
  var bgm = $('invBgm');
  var musicBtn = $('invMusicToggle');
  var iconOn = $('invMusicIconOn');
  var iconOff = $('invMusicIconOff');
  var musicStarted = false;

  function setMusicState(playing) {
    musicBtn.classList.toggle('is-playing', playing);
    musicBtn.setAttribute('aria-pressed', playing ? 'true' : 'false');
    iconOn.hidden = !playing;
    iconOff.hidden = playing;
  }

  bgm.addEventListener('canplay', function () { musicBtn.hidden = false; }, { once: true });
  bgm.addEventListener('error', function () { musicBtn.hidden = true; });

  function tryStartMusic() {
    if (musicStarted || musicBtn.hidden) return;
    musicStarted = true;
    bgm.play().then(function () { setMusicState(true); }).catch(function () { setMusicState(false); });
  }
  ['pointerdown', 'touchstart'].forEach(function (evt) {
    document.addEventListener(evt, tryStartMusic, { once: true, passive: true });
  });

  musicBtn.addEventListener('click', function () {
    musicStarted = true;
    if (bgm.paused) {
      bgm.play().then(function () { setMusicState(true); }).catch(function () { setMusicState(false); });
    } else {
      bgm.pause();
      setMusicState(false);
    }
  });
})();
</script>
</body>
</html>
