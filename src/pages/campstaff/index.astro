              <label class="check-pill"><input id="modalDedicated" type="checkbox"><span class="check-box"><svg viewBox="0 0 12 12" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="2,6.5 5,9 10,3"/></svg></span>헌신</label>
