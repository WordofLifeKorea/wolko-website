  <div id="installGuide" style="display:none;position:fixed;inset:0;background:rgba(0,15,30,.55);backdrop-filter:blur(6px);z-index:9999;align-items:center;justify-content:center;padding:1rem;" onclick="if(event.target===this)closeInstallGuide()">
    <div style="background:#fff;border-radius:20px;max-width:340px;width:100%;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,.25);">
      <div style="display:flex;justify-content:flex-end;padding:.8rem 1rem .2rem;">
        <button onclick="closeInstallGuide()" style="background:none;border:none;font-size:1.4rem;color:#aaa;cursor:pointer;line-height:1;" aria-label="닫기">×</button>
      </div>
      <div style="padding:0 1.6rem 1.6rem;text-align:center;">
        <div id="guideEmoji" style="font-size:2.2rem;margin-bottom:.8rem;">📲</div>
        <h3 style="margin:0 0 .6rem;font-size:1.05rem;font-weight:800;color:#1a2d38;">앱처럼 사용하세요</h3>
        <p id="guideText" style="margin:0 0 1.2rem;font-size:.88rem;line-height:1.6;color:#5a7585;">홈 화면에 추가하면 빠르게 실행할 수 있어요.</p>
        <button onclick="closeInstallGuide()" style="width:100%;padding:.75rem;background:#004f68;color:#fff;border:none;border-radius:10px;font-size:.93rem;font-weight:700;cursor:pointer;">확인</button>
