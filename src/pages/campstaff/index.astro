  <script>
    const CAMPS = [
      { id:'2026-inland-english-junior', title:'2026 여름 주니어 영어 캠프' },
      { id:'2026-inland-union', title:'2026 교회 연합캠프' },
      { id:'2026-jeju-english', title:'2026 제주 영어 캠프' },
      { id:'2026-jeju-momentum-1', title:'2026 제주 모멘텀 1차' },
      { id:'2026-jeju-momentum-2', title:'2026 제주 모멘텀 2차' },
      { id:'2026-test-camp', title:'테스트 캠프' },
    ];
    const BASE_TEAMS = ['프로그램','티칭','상담자','테크','찬양팀'];
    // role: 'missionary' (선교사 — 기본 리더), 'intern', 'stw'
    // jeju: true → 제주 월비 멤버 (제주 캠프에서만 표시)
    const WOLKO_CAMP_ROSTER = [
      { name:'앤더슨 제이슨', spouseName:'앤더슨 찬주', role:'missionary', teams:['프로그램','상담자'] },
      { name:'민경찬', spouseName:'김유진', role:'missionary', teams:['프로그램'] },
      { name:'송승현', role:'missionary', teams:['프로그램','상담자'] },
      { name:'김환규', spouseName:'김씬띠아', role:'missionary', teams:['티칭','테크'] },
      { name:'백남규', spouseName:'조안나', role:'missionary', teams:['상담자','티칭'], jeju:true },
      { name:'몰스 제이콥', spouseName:'몰스 크리스탈', role:'missionary', teams:['프로그램'] },
      { name:'채병국', role:'missionary', teams:['프로그램','상담자'] },
      { name:'니키 플로리카', role:'intern', teams:['티칭'] },
      { name:'잭 프래지어', role:'intern', teams:['티칭','상담자'] },
      { name:'몰리 그램', role:'intern', teams:['상담자','프로그램'] },
      { name:'버니 카브레라', role:'intern', teams:['찬양팀','상담자'], jeju:true },
      { name:'박예능', role:'stw', teams:['프로그램','찬양팀'] },
      { name:'정지온', role:'stw', teams:['상담자'], jeju:true },
      { name:'브링클리 모슬리', role:'stw', teams:['테크'], jeju:true },
      { name:'웹스터 그레이스', role:'stw', teams:['테크'], jeju:true },
      { name:'손진영', role:'stw', teams:['프로그램'] },
    ];
    const memberDisplayName = m => m.name;
    function rosterForCamp(campId) {
      const isJeju = String(campId || '').includes('jeju');
      // 부부 선교사는 남편/아내를 각각 별도 항목으로 분리
      const expanded = [];
      for (const m of WOLKO_CAMP_ROSTER) {
        if (isJeju || !m.jeju) {
          expanded.push({ name:m.name, role:m.role, teams:m.teams, jeju:m.jeju });
          if (m.spouseName) {
            expanded.push({ name:m.spouseName, role:m.role, teams:m.teams, jeju:m.jeju });
          }
        }
      }
      return expanded;
    }
    const TOKEN_KEY = 'wolko-camp-progress-token';
    const ROLE_KEY = 'wolko-camp-progress-role';
    let authMode = 'login';
    let token = sessionStorage.getItem(TOKEN_KEY) || '';
    let role = sessionStorage.getItem(ROLE_KEY) || '';
    let state = { counselors:[], campers:[], counselorRegIds:[], teamOverview:null, canEditAll:false };
    let selectedCamper = null;

    const $ = id => document.getElementById(id);
    const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    const authHeaders = () => ({ 'Content-Type':'application/json', Authorization:`Bearer ${token}` });

    function currentCampId() { return $('campSelect').value || CAMPS[0].id; }
    function currentCampTitle() { return CAMPS.find(camp => camp.id === currentCampId())?.title || currentCampId(); }
    const PASSWORD_ALLOWED_RE = /^[\x21-\x7E]*$/;

    function cleanPasswordValue(value) {
      return String(value || '').replace(/[^\x21-\x7E]/g, '');
    }

    function warnPasswordLanguage() {
      if ($('loginError')) $('loginError').textContent = '비밀번호는 영어 입력 상태에서 입력해주세요.';
    }

    function enforceAsciiPasswordInput(input) {
      if (!input) return;
      input.setAttribute('inputmode', 'latin');
      input.setAttribute('pattern', '[\\x21-\\x7E]*');
      input.addEventListener('beforeinput', event => {
        if (event.data && !PASSWORD_ALLOWED_RE.test(event.data)) {
          event.preventDefault();
          warnPasswordLanguage();
        }
      });
      input.addEventListener('paste', event => {
        const text = event.clipboardData?.getData('text') || '';
        const clean = cleanPasswordValue(text);
        if (text !== clean) {
          event.preventDefault();
          const start = input.selectionStart ?? input.value.length;
          const end = input.selectionEnd ?? start;
          input.setRangeText(clean, start, end, 'end');
          input.dispatchEvent(new Event('input', { bubbles: true }));
          warnPasswordLanguage();
        }
      });
      input.addEventListener('input', () => {
        const clean = cleanPasswordValue(input.value);
        if (input.value !== clean) {
          input.value = clean;
          warnPasswordLanguage();
        }
      });
    }

    function setup() {
      $('campSelect').innerHTML = CAMPS.map(camp => `<option value="${camp.id}">${camp.title}</option>`).join('');
      $('campSelect').addEventListener('change', loadData);
      $('refreshBtn').addEventListener('click', loadData);
      $('logoutBtn').addEventListener('click', logout);
      $('modalClose').addEventListener('click', closeModal);
      $('modalCancel').addEventListener('click', closeModal);
      $('modalSave').addEventListener('click', saveCamper);
      $('authBtn').addEventListener('click', submitAuth);
      enforceAsciiPasswordInput($('authPassword'));
      enforceAsciiPasswordInput($('accountPassword'));
      $('loadAccountsBtn').addEventListener('click', loadAccounts);
      $('accountSaveBtn').addEventListener('click', upsertAccount);
      document.querySelectorAll('.tab').forEach(btn => btn.addEventListener('click', () => setAuthMode(btn.dataset.mode)));
      $('signupBtn').addEventListener('click', () => {
        setAuthMode(authMode === 'signup' ? 'login' : 'signup');
      });
      $('authCampSelect').addEventListener('change', loadCounselorRoster);
      $('authName').addEventListener('change', () => {
        const opt = $('authName').selectedOptions[0];
        $('authEmail').value = opt?.value || '';
      });
      // Enter 키로 로그인/가입 제출
      ['authEmail', 'authPassword', 'authName'].forEach(id => {
        $(id).addEventListener('keydown', e => {
          if (e.key === 'Enter' && !$('authBtn').disabled) {
            e.preventDefault();
            submitAuth();
          }
        });
      });
      document.addEventListener('keydown', event => { if (event.key === 'Escape') closeModal(); });
      if (token) unlock();
    }

    function setAuthMode(mode) {
      authMode = mode;
      // 탭은 login / adminLogin 두 개만 — signup 모드 시 'login' 탭 활성 상태 유지
      const tabMode = mode === 'signup' ? 'login' : mode;
      document.querySelectorAll('.tab').forEach(btn => btn.classList.toggle('active', btn.dataset.mode === tabMode));
      $('signupBtn').classList.toggle('is-signup-active', mode === 'signup');
      $('signupBtn').textContent = mode === 'signup' ? '로그인으로 돌아가기' : '카운슬러 Sign-up';
      $('signupBtn').style.display = mode === 'adminLogin' ? 'none' : '';
      $('authEmail').hidden = mode === 'adminLogin' || mode === 'signup';
      // signup 모드: 캠프/이름 셀렉트 노출 + 명단 로드
      const showSignupFields = mode === 'signup';
      $('authCampSelect').hidden = !showSignupFields;
      $('authName').hidden = !showSignupFields;
      $('rosterHint').hidden = !showSignupFields;
      if (showSignupFields) {
        populateAuthCampSelect();
        loadCounselorRoster();
      }
      $('authPassword').autocomplete = mode === 'signup' ? 'new-password' : 'current-password';
      $('authBtn').textContent = mode === 'signup' ? '가입하기' : mode === 'adminLogin' ? '관리자 로그인' : '로그인';
      $('loginError').textContent = '';
    }

    function populateAuthCampSelect() {
      const sel = $('authCampSelect');
      if (sel.options.length === CAMPS.length) return;
      sel.innerHTML = CAMPS.map(c => `<option value="${c.id}">${c.title}</option>`).join('');
    }

    async function loadCounselorRoster() {
      const campId = $('authCampSelect').value || CAMPS[0].id;
      const sel = $('authName');
      const hint = $('rosterHint');
      sel.innerHTML = '<option value="">불러오는 중…</option>';
      sel.disabled = true;
      hint.classList.remove('is-error');
      hint.textContent = '본인 이름을 선택하면 등록된 이메일로 자동 채워집니다.';
      try {
        const res = await fetch(`/api/camp-progress/counselor-roster?campId=${encodeURIComponent(campId)}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '명단 불러오기 실패');
        const list = data.counselors || [];
        if (!list.length) {
          sel.innerHTML = '<option value="">상담자 신청자가 없습니다</option>';
          hint.classList.add('is-error');
          hint.textContent = '이 캠프에 상담자 팀으로 신청한 분이 아직 없습니다.';
          sel.disabled = true;
          $('authEmail').value = '';
          return;
        }
        sel.innerHTML = '<option value="">— 본인 이름을 선택해주세요 —</option>'
          + list.map((c, i) => `<option value="${esc(c.email)}" data-name="${esc(c.name)}">${esc(c.name)}</option>`).join('');
        sel.disabled = false;
      } catch (e) {
        sel.innerHTML = '<option value="">불러오기 실패</option>';
        hint.classList.add('is-error');
        hint.textContent = e.message;
      }
    }

    async function submitAuth() {
      $('loginError').textContent = '';
      $('authBtn').disabled = true;
      try {
        // signup: 이름 select의 selected option에서 이메일+이름 추출
        let email = $('authEmail').value.trim();
        let name = '';
        if (authMode === 'signup') {
          const opt = $('authName').selectedOptions[0];
          email = opt?.value || '';
          name = opt?.dataset?.name || '';
          if (!email) throw new Error('본인 이름을 선택해주세요.');
        }
        const res = await fetch('/api/camp-progress/auth', {
          method:'POST',
          headers:{ 'Content-Type':'application/json' },
          body:JSON.stringify({
            mode:authMode,
            email,
            name,
            password:$('authPassword').value,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '로그인 실패');
        token = data.token;
        role = data.role;
        sessionStorage.setItem(TOKEN_KEY, token);
        sessionStorage.setItem(ROLE_KEY, role);
        unlock();
      } catch (error) {
        $('loginError').textContent = error.message;
      } finally {
        $('authBtn').disabled = false;
      }
    }

    function unlock() {
      $('loginScreen').style.display = 'none';
      document.body.classList.toggle('is-admin', role === 'admin');
      $('sessionText').textContent = role === 'admin' ? '관리자 모드' : '카운슬러 모드';
      loadData();
      if (role === 'admin') loadAccounts();
    }

    function logout() {
      sessionStorage.removeItem(TOKEN_KEY);
      sessionStorage.removeItem(ROLE_KEY);
      token = '';
      role = '';
      document.body.classList.remove('is-admin');
      $('loginScreen').style.display = 'grid';
    }

    async function loadData() {
      if (!token) return;
      $('campTitle').textContent = currentCampTitle();
      try {
        const res = await fetch(`/api/camp-progress/data?campId=${encodeURIComponent(currentCampId())}`, { headers:authHeaders() });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '데이터 로드 실패');
        state = data;
        renderBoard();
        renderTeams();
      } catch (error) {
        alert(error.message);
        if (/로그인|authorization|401/i.test(error.message)) logout();
      }
    }

    function canEditCamper(camper) {
      return state.canEditAll || state.counselorRegIds.includes(camper.counselorRegId);
    }

    function visibleCampers() {
      return (state.campers || []).filter(camper => {
        if (camper.registrationType !== 'group-participant') return true;
        const name = String(camper.name || '').trim();
        if (!name) return false;
        const number = Number(camper.participantIndex) + 1;
        return name !== `학생 ${number}` && name !== `Student ${number}`;
      });
    }

    function counselorGroupKey(counselor) {
      const name = String(counselor.name || '').trim();
      if (name === '오예빈' || name === '최하은') return 'pair:oyebin-choihaeun';
      return `counselor:${counselor.regId}`;
    }

    function buildCounselorGroups(campers) {
      const groups = [];
      const groupsByKey = new Map();
      for (const counselor of state.counselors) {
        const key = counselorGroupKey(counselor);
        if (!groupsByKey.has(key)) {
          const group = { key, counselors:[], campers:[] };
          groupsByKey.set(key, group);
          groups.push(group);
        }
        groupsByKey.get(key).counselors.push(counselor);
      }
      for (const group of groups) {
        const ids = new Set(group.counselors.map(counselor => counselor.regId));
        group.campers = campers.filter(camper => ids.has(camper.counselorRegId));
      }
      return groups;
    }

    function renderBoard() {
      const campers = visibleCampers();
      const saved = campers.filter(camper => camper.saved).length;
      const dedicated = campers.filter(camper => camper.dedicated).length;
      $('statCampers').textContent = campers.length;
      $('statSaved').textContent = saved;
      $('statDedicated').textContent = dedicated;
      const counselorGroups = buildCounselorGroups(campers);
      const unassignedCampers = campers.filter(camper => !camper.counselorRegId);

      $('counselorBoard').innerHTML = counselorGroups.map(group => {
        const teamColor = group.counselors.find(counselor => counselor.teamColor)?.teamColor || '';
        const groupName = group.counselors.map(counselor => counselor.name).filter(Boolean).join(' · ');
        const groupEmail = group.counselors.map(counselor => counselor.email).filter(Boolean).join(' / ');
        const colorSwatch = group.counselors.map(counselor => {
          const canEditColor = state.canEditAll || state.counselorRegIds.includes(counselor.regId);
          return renderColorSwatch(counselor.regId, counselor.teamColor || '', canEditColor);
        }).join('');
        return `<article class="counselor-card${teamColor ? ' has-team-' + teamColor : ''}">
          <div class="counselor-head">
            <div class="counselor-head-info">
              <strong>${esc(groupName)}</strong>
              <span>${esc(groupEmail || '')}</span>
            </div>
            ${colorSwatch}
            <span class="counselor-count">${group.campers.length}명</span>
          </div>
          <div class="camper-list">
            ${group.campers.length ? group.campers.map(c => renderCamperButton(c, teamColor)).join('') : '<div class="empty">등록된 캠퍼가<br>없습니다</div>'}
          </div>
        </article>`;
      }).join('');

      // 미배정 캠퍼 별도 섹션
      const unassignedSection = $('unassignedSection');
      if (unassignedCampers.length === 0) {
        unassignedSection.hidden = true;
      } else {
        unassignedSection.hidden = false;
        $('unassignedSummary').textContent = `${unassignedCampers.length}명 · 담당 카운슬러 지정 필요`;
        $('unassignedList').innerHTML = unassignedCampers.map(c => renderCamperButton(c, '')).join('');
      }

      document.querySelectorAll('.camper-btn').forEach(btn => {
        btn.addEventListener('click', event => {
          if (event.target.closest('[data-stop]')) return;
          openCamper(btn.dataset.camperId);
        });
        btn.addEventListener('keydown', event => {
          if (event.target.closest('[data-stop]')) return;
          if (event.key !== 'Enter' && event.key !== ' ') return;
          event.preventDefault();
          openCamper(btn.dataset.camperId);
        });
      });
      document.querySelectorAll('.teacher-assign-select').forEach(select => {
        ['click', 'pointerdown', 'mousedown'].forEach(type => {
          select.addEventListener(type, event => event.stopPropagation());
        });
        select.addEventListener('keydown', event => event.stopPropagation());
        select.addEventListener('change', () => setCamperTeacherAssignment(select.dataset.camperId, select.value, select));
      });
      document.querySelectorAll('.cl-color-btn').forEach(btn => btn.addEventListener('click', e => {
        e.stopPropagation();
        toggleColorPicker(btn);
      }));
      document.querySelectorAll('.cl-color-opt').forEach(opt => opt.addEventListener('click', e => {
        e.stopPropagation();
        setCounselorColor(opt.dataset.regid, opt.dataset.color);
      }));
      document.addEventListener('click', closeAllColorPickers, { once: true });
    }

    function renderCamperButton(camper, counselorColor = '') {
      const locked = canEditCamper(camper) ? '' : (canAssignCamper() ? ' · 배정만 가능' : ' · 읽기 전용');
      const effectiveColor = camper.teamColor || counselorColor;
      const genderBadge = camper.gender === 'male'
        ? '<span class="gender-badge gender-male">남</span>'
        : camper.gender === 'female'
        ? '<span class="gender-badge gender-female">여</span>'
        : '';
      const teacherBadge = renderTeacherAssignBadge(camper);
      return `<div class="camper-btn" role="button" tabindex="0" data-camper-id="${esc(camper.camperId)}">
        <span class="team-dot ${effectiveColor ? 'team-' + effectiveColor : ''}"></span>
        <span class="camper-main">
          <span class="camper-name-line"><strong>${esc(camper.name)}</strong>${genderBadge}${teacherBadge}</span>
          <span>${esc([camper.grade, camper.church].filter(Boolean).join(' · ') || '정보 없음')}${locked}</span>
        </span>
        <span class="chips">
          ${camper.saved ? '<span class="chip chip-saved">구원</span>' : ''}
          ${camper.dedicated ? '<span class="chip chip-dedicated">헌신</span>' : ''}
        </span>
      </div>`;
    }

    function renderTeacherAssignBadge(camper) {
      const assigned = String(camper.teacherName || '').trim();
      const assignedClass = assigned ? ' is-assigned' : '';
      if (!canAssignCamper()) {
        return assigned
          ? `<span class="teacher-assign-badge is-assigned" title="티칭 담당: ${esc(assigned)}">${esc(assigned)}</span>`
          : '';
      }
      const teacherNames = teachingTeamMembers();
      const optionNames = assigned && !teacherNames.includes(assigned) ? [assigned, ...teacherNames] : teacherNames;
      const options = ['<option value="">티칭 선택</option>']
        .concat(optionNames.map(name => (
          `<option value="${esc(name)}"${name === assigned ? ' selected' : ''}>${esc(name)}</option>`
        )))
        .join('');
      return `<select class="teacher-assign-select${assignedClass}" data-stop data-camper-id="${esc(camper.camperId)}" aria-label="${esc(camper.name)} 티칭 담당 선택" title="티칭 담당 선택">${options}</select>`;
    }

    function renderColorSwatch(regId, color, editable) {
      const colors = [
        { value:'', label:'미지정' },
        { value:'red', label:'레드' },
        { value:'blue', label:'블루' },
        { value:'yellow', label:'옐로우' },
        { value:'green', label:'그린' },
      ];
      return `<span class="cl-color-wrap">
        <button type="button" class="cl-color-btn ${color ? 'team-' + color : 'is-empty'}" data-regid="${esc(regId)}" ${editable ? '' : 'disabled'} title="팀 색상 ${color || '미지정'}"></button>
        ${editable ? `<span class="cl-color-menu">
          ${colors.map(c => `<button type="button" class="cl-color-opt ${c.value ? 'team-' + c.value : 'is-empty'}${c.value === color ? ' is-selected' : ''}" data-regid="${esc(regId)}" data-color="${c.value}" title="${c.label}"></button>`).join('')}
        </span>` : ''}
      </span>`;
    }

    function toggleColorPicker(btn) {
      const wrap = btn.closest('.cl-color-wrap');
      const isOpen = wrap.classList.contains('is-open');
      closeAllColorPickers();
      if (!isOpen) {
        wrap.classList.add('is-open');
        setTimeout(() => document.addEventListener('click', closeAllColorPickers, { once: true }), 0);
      }
    }
    function closeAllColorPickers() {
      document.querySelectorAll('.cl-color-wrap.is-open').forEach(el => el.classList.remove('is-open'));
    }

    async function setCounselorColor(regId, color) {
      closeAllColorPickers();
      const counselor = state.counselors.find(c => c.regId === regId);
      if (!counselor) return;
      const prevColor = counselor.teamColor;
      counselor.teamColor = color;
      renderBoard();
      try {
        const res = await fetch('/api/camp-progress/update', {
          method:'PUT',
          headers:authHeaders(),
          body:JSON.stringify({
            campId:counselor.campId,
            regId,
            field:'teamColor',
            value:color,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '저장 실패');
      } catch (error) {
        counselor.teamColor = prevColor;
        renderBoard();
        alert('팀 색상 저장 실패: ' + error.message);
      }
    }

    function canAssignCamper() {
      // 담당 카운슬러 배정은 로그인한 카운슬러/관리자 누구나 가능
      return !!role;
    }

    function openCamper(camperId) {
      selectedCamper = state.campers.find(camper => camper.camperId === camperId);
      if (!selectedCamper) return;
      const editable = canEditCamper(selectedCamper);
      const assignable = canAssignCamper();
      $('modalName').textContent = selectedCamper.name;
      $('modalMeta').textContent = [selectedCamper.grade, selectedCamper.church, selectedCamper.phone].filter(Boolean).join(' · ');
      // 카운슬러 셀렉트 옵션 채우기
      const counselorOptions = ['<option value="">미배정</option>']
        .concat(state.counselors.map(c => `<option value="${esc(c.regId)}">${esc(c.name)}</option>`))
        .join('');
      $('modalCounselor').innerHTML = counselorOptions;
      $('modalCounselor').value = selectedCamper.counselorRegId || '';
      $('modalCounselor').disabled = !assignable;
      $('modalSaved').checked = !!selectedCamper.saved;
      $('modalDedicated').checked = !!selectedCamper.dedicated;
      $('modalTestimony').value = selectedCamper.testimony || '';
      $('modalMemo').value = selectedCamper.counselorMemo || '';
      ['modalSaved','modalDedicated','modalTestimony','modalMemo'].forEach(id => $(id).disabled = !editable);
      $('modalSave').disabled = !(editable || assignable);
      $('modalSave').textContent = (editable || assignable) ? '저장' : '읽기 전용';
      $('modalCounselorHint').hidden = editable || !assignable;
      $('camperModal').classList.add('open');
      document.body.classList.add('is-modal-open');
    }

    function closeModal() {
      $('camperModal').classList.remove('open');
      document.body.classList.remove('is-modal-open');
      selectedCamper = null;
    }

    async function updateCamperField(camper, field, value) {
      const res = await fetch('/api/camp-progress/update', {
        method:'PUT',
        headers:authHeaders(),
        body:JSON.stringify({
          campId:camper.campId,
          regId:camper.regId,
          participantIndex:camper.participantIndex,
          field,
          value,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || '저장 실패');
      return data;
    }

    async function setCamperTeacherAssignment(camperId, teacherName, selectEl) {
      const camper = state.campers.find(item => item.camperId === camperId);
      if (!camper) return;
      const previous = camper.teacherName || '';
      if (previous === teacherName) return;
      if (selectEl) selectEl.disabled = true;
      try {
        await updateCamperField(camper, 'teacherName', teacherName);
        camper.teacherName = teacherName;
        await loadData();
      } catch (error) {
        if (selectEl) {
          selectEl.value = previous;
          selectEl.disabled = false;
        }
        alert(error.message);
      }
    }

    async function saveField(field, value) {
      if (!selectedCamper) return;
      await updateCamperField(selectedCamper, field, value);
    }

    async function saveCamper() {
      if (!selectedCamper) return;
      const editable = canEditCamper(selectedCamper);
      const assignable = canAssignCamper();
      if (!editable && !assignable) return;
      $('modalSave').disabled = true;
      $('modalSave').textContent = '저장 중...';
      try {
        // 담당 배정은 누구나, 구원/헌신/간증/상담 내역은 담당 카운슬러(또는 관리자)만 저장
        if (assignable) await saveField('counselorRegId', $('modalCounselor').value);
        if (editable) {
          await saveField('saved', $('modalSaved').checked);
          await saveField('dedicated', $('modalDedicated').checked);
          await saveField('testimony', $('modalTestimony').value);
          await saveField('counselorMemo', $('modalMemo').value);
        }
        closeModal();
        await loadData();
      } catch (error) {
        alert(error.message);
      } finally {
        $('modalSave').disabled = false;
        $('modalSave').textContent = '저장';
      }
    }

    function personRoleKey(name, team) { return `${name}\x00${team}`; }
    function getPersonRole(name, team) {
      return state.teamOverview?.personRoles?.[personRoleKey(name, team)] || null;
    }
    function personDefaultRole(m) { return m.role === 'missionary' ? 'leader' : 'member'; }
    function personEffectiveRole(m, team) {
      return getPersonRole(memberDisplayName(m), team) || personDefaultRole(m);
    }

    async function togglePersonRole(name, team) {
      if (role !== 'admin') return;
      const config = ensureTeamOverview();
      config.personRoles = config.personRoles || {};
      const key = personRoleKey(name, team);
      const cur = config.personRoles[key];
      if (cur === 'leader') {
        delete config.personRoles[key];
        // 기본이 'member'면 그냥 삭제로 끝
        const member = allTeamMembers().find(m => memberDisplayName(m) === name);
        if (member && personDefaultRole(member) === 'leader') {
          config.personRoles[key] = 'member';
        }
      } else {
        config.personRoles[key] = 'leader';
      }
      renderTeams();
      try {
        await fetch('/api/camp-progress/team-overview', {
          method:'PUT',
          headers:authHeaders(),
          body:JSON.stringify({ campId:currentCampId(), config }),
        });
      } catch (error) {
        alert('리더 변경 저장 실패: ' + error.message);
      }
    }

    function ensureTeamOverview() {
      if (!state.teamOverview) state.teamOverview = { customTeams:[], personRoles:{}, personTeams:{}, campExclude:[], campRoles:{}, customMembers:[] };
      return state.teamOverview;
    }

    function allTeamMembers() {
      const config = state.teamOverview || {};
      const roster = rosterForCamp(currentCampId());
      const rosterNames = new Set(roster.map(m => m.name));
      const customMembers = Array.isArray(config.customMembers) ? config.customMembers.map(m => ({ name:m.name || '', teams:m.teams || [], role:m.role || 'stw' })) : [];
      // 캠프 신청 스태프 전체 (로스터에 이미 있는 이름은 제외)
      const campStaff = Array.isArray(state.campStaff) ? state.campStaff : [];
      const staffMembers = campStaff
        .filter(s => s.name && !rosterNames.has(s.name))
        .map(s => ({ name:s.name, teams:s.teams.length ? s.teams : ['상담자'], role:'staff' }));
      return [...roster, ...customMembers, ...staffMembers].filter(m => memberDisplayName(m));
    }

    function getEffectiveTeams(member) {
      const config = state.teamOverview || {};
      const dn = memberDisplayName(member);
      const override = config.personTeams?.[dn];
      return Array.isArray(override) ? override : (member.teams || []);
    }

    function teachingTeamMembers() {
      const seen = new Set();
      return allTeamMembers()
        .filter(member => getEffectiveTeams(member).includes('티칭'))
        .map(member => memberDisplayName(member))
        .filter(name => {
          if (!name || seen.has(name)) return false;
          seen.add(name);
          return true;
        });
    }

    async function saveTeamOverview(config) {
      try {
        const res = await fetch('/api/camp-progress/team-overview', {
          method:'PUT',
          headers:authHeaders(),
          body:JSON.stringify({ campId:currentCampId(), config }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '저장 실패');
      } catch (error) {
        alert('팀 설정 저장 실패: ' + error.message);
      }
    }

    async function addPersonToTeam(name, team) {
      if (role !== 'admin') return;
      const config = ensureTeamOverview();
      const member = allTeamMembers().find(m => memberDisplayName(m) === name);
      if (!member) return;
      const current = getEffectiveTeams(member);
      if (current.includes(team)) return;
      config.personTeams = config.personTeams || {};
      config.personTeams[name] = [...current, team];
      renderTeams();
      await saveTeamOverview(config);
    }

    async function removePersonFromTeam(name, team) {
      if (role !== 'admin') return;
      const config = ensureTeamOverview();
      const member = allTeamMembers().find(m => memberDisplayName(m) === name);
      if (!member) return;
      const current = getEffectiveTeams(member);
      const next = current.filter(t => t !== team);
      config.personTeams = config.personTeams || {};
      config.personTeams[name] = next;
      // 리더로 지정되어 있었으면 그 키도 정리
      if (config.personRoles) {
        delete config.personRoles[personRoleKey(name, team)];
      }
      renderTeams();
      await saveTeamOverview(config);
    }

    function toggleAddMenu(btn) {
      const wrap = btn.closest('.team-add-wrap');
      const isOpen = wrap.classList.contains('is-open');
      document.querySelectorAll('.team-add-wrap.is-open').forEach(el => el.classList.remove('is-open'));
      if (!isOpen) {
        wrap.classList.add('is-open');
        setTimeout(() => document.addEventListener('click', closeAllAddMenus, { once: true }), 0);
      }
    }
    function closeAllAddMenus() {
      document.querySelectorAll('.team-add-wrap.is-open').forEach(el => el.classList.remove('is-open'));
    }

    function renderTeams() {
      const config = state.teamOverview || {};
      const customTeams = Array.isArray(config.customTeams) ? config.customTeams : [];
      const teams = [...BASE_TEAMS, ...customTeams];
      const isJejuCamp = String(currentCampId()).includes('jeju');
      const isAdmin = role === 'admin';
      const allMembers = allTeamMembers();
      const roleLabel = m => m.role === 'missionary' ? '선교사' : m.role === 'intern' ? '인턴' : m.role === 'staff' ? '스태프' : 'STW';
      $('teamSummary').textContent = `${teams.length}개 팀${isJejuCamp ? ' · 제주' : ' · 평택'}`;
      $('teamGrid').innerHTML = teams.map(team => {
        const members = allMembers.filter(member => {
          const dn = memberDisplayName(member);
          return getEffectiveTeams(member).includes(team) && !(config.campExclude || []).includes(dn);
        });
        const leaders = members.filter(m => personEffectiveRole(m, team) === 'leader');
        const nonLeaders = members.filter(m => personEffectiveRole(m, team) !== 'leader');
        const renderItem = (m) => {
          const dn = memberDisplayName(m);
          const isLeader = personEffectiveRole(m, team) === 'leader';
          const jejuBadge = m.jeju ? '<span class="m-badge m-badge-jeju">제주</span>' : (isJejuCamp && !m.jeju ? '<span class="m-badge m-badge-pyeongtaek">평택</span>' : '');
          const adminControls = isAdmin
            ? `<button type="button" class="m-toggle ${isLeader ? 'is-leader' : ''}" data-name="${esc(dn)}" data-team="${esc(team)}" title="${isLeader ? '리더 해제' : '리더로 지정'}">${isLeader ? '리더' : '+리더'}</button>
               <button type="button" class="m-remove" data-name="${esc(dn)}" data-team="${esc(team)}" title="이 팀에서 제거">✕</button>`
            : '';
          return `<li class="${isLeader ? 'is-leader' : ''}">
            <span class="m-name">${esc(dn)}</span>
            ${jejuBadge}
            ${adminControls}
          </li>`;
        };
        // 이 팀에 아직 속하지 않은 멤버 (관리자용 추가 메뉴)
        const candidates = isAdmin
          ? allMembers.filter(m => !getEffectiveTeams(m).includes(team) && !(config.campExclude || []).includes(memberDisplayName(m)))
          : [];
        const addMenu = isAdmin && candidates.length
          ? `<div class="team-add-wrap">
              <button type="button" class="team-add-btn" data-team="${esc(team)}">+ 멤버 추가</button>
              <div class="team-add-menu">
                ${candidates.map(m => `<button type="button" class="team-add-opt" data-name="${esc(memberDisplayName(m))}" data-team="${esc(team)}">
                  <span class="m-name">${esc(memberDisplayName(m))}</span>
                  <span class="m-role">${roleLabel(m)}${m.jeju ? ' · 제주' : ''}</span>
                </button>`).join('')}
              </div>
            </div>`
          : '';
        return `<div class="team-box">
          <strong>${esc(team)}</strong>
          ${leaders.length ? `<div class="team-sublabel">리더</div><ul class="team-list">${leaders.map(renderItem).join('')}</ul>` : ''}
          ${nonLeaders.length ? `<div class="team-sublabel">멤버</div><ul class="team-list">${nonLeaders.map(renderItem).join('')}</ul>` : ''}
          ${!leaders.length && !nonLeaders.length ? '<ul class="team-list"><li class="is-empty">미배정</li></ul>' : ''}
          ${addMenu}
        </div>`;
      }).join('');
      document.querySelectorAll('.m-toggle').forEach(btn => btn.addEventListener('click', () => {
        togglePersonRole(btn.dataset.name, btn.dataset.team);
      }));
      document.querySelectorAll('.m-remove').forEach(btn => btn.addEventListener('click', () => {
        if (confirm(`${btn.dataset.name}님을 ${btn.dataset.team} 팀에서 제거할까요?`)) {
          removePersonFromTeam(btn.dataset.name, btn.dataset.team);
        }
      }));
      document.querySelectorAll('.team-add-btn').forEach(btn => btn.addEventListener('click', e => {
        e.stopPropagation();
        toggleAddMenu(btn);
      }));
      document.querySelectorAll('.team-add-opt').forEach(opt => opt.addEventListener('click', e => {
        e.stopPropagation();
        closeAllAddMenus();
        addPersonToTeam(opt.dataset.name, opt.dataset.team);
      }));
    }

    async function loadAccounts() {
      if (role !== 'admin') return;
      try {
        const res = await fetch('/api/camp-progress/accounts', { headers:authHeaders() });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '계정 로드 실패');
        const accounts = data.accounts || [];
        const accountByEmail = new Map(accounts.map(account => [account.email, account]));
        const staff = data.counselorStaff || [];
        const emails = [...new Set([...staff.map(item => item.email), ...accounts.map(item => item.email)])].filter(Boolean);
        $('accountGrid').innerHTML = emails.map(email => {
          const account = accountByEmail.get(email);
          const staffInfo = staff.find(item => item.email === email);
          const badge = account
            ? (account.disabled
              ? '<span class="account-badge is-disabled">비활성</span>'
              : '<span class="account-badge is-active">활성</span>')
            : '<span class="account-badge is-none">계정 없음</span>';
          return `<div class="account-card">
            <strong>${esc(staffInfo?.name || account?.name || email)}</strong>
            <div class="account-meta">
              <span>${esc(email)}</span>
              ${badge}
            </div>
            <div class="account-actions">
              <button type="button" data-email="${esc(email)}" data-action="select">불러오기</button>
              ${account ? `<button type="button" data-email="${esc(email)}" data-action="${account.disabled ? 'enable' : 'disable'}">${account.disabled ? '활성화' : '비활성화'}</button>
              <button type="button" data-email="${esc(email)}" data-action="delete">삭제</button>` : ''}
            </div>
          </div>`;
        }).join('');
        document.querySelectorAll('.account-actions button').forEach(btn => btn.addEventListener('click', () => accountAction(btn.dataset.action, btn.dataset.email)));
      } catch (error) {
        alert(error.message);
      }
    }

    async function upsertAccount() {
      const email = $('accountEmail').value.trim();
      const name = $('accountName').value.trim();
      const password = $('accountPassword').value;
      await accountAction('upsert', email, { name, password });
      $('accountPassword').value = '';
      await loadAccounts();
    }

    async function accountAction(action, email, extra = {}) {
      if (!email) return alert('이메일을 입력해주세요.');
      if (action === 'select') {
        $('accountEmail').value = email;
        const name = document.querySelector(`[data-email="${CSS.escape(email)}"]`)?.closest('.account-card')?.querySelector('strong')?.textContent || '';
        $('accountName').value = name;
        $('accountPassword').focus();
        return;
      }
      if ((action === 'delete' || action === 'disable') && !confirm(`${email} 계정을 ${action === 'delete' ? '삭제' : '비활성화'}할까요?`)) return;
      const res = await fetch('/api/camp-progress/accounts', {
        method:'POST',
        headers:authHeaders(),
        body:JSON.stringify({ action, email, ...extra }),
      });
      const data = await res.json();
      if (!res.ok) return alert(data.error || '계정 저장 실패');
      await loadAccounts();
    }

    setup();

    // ── PWA 설치 ──
    let deferredInstallPrompt = null;
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches
      || window.navigator.standalone === true;
    const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent);

    if (isIOS) {
      $('guideEmoji').textContent = '🍎';
      $('guideText').innerHTML = 'Safari 하단의 <strong>공유 버튼</strong>을 눌러<br>"<strong>홈 화면에 추가</strong>"를 선택하세요.';
    }

    if (!isStandalone) {
      $('installBtn').style.display = '';
      if (!isIOS) {
        window.addEventListener('beforeinstallprompt', e => {
          e.preventDefault();
          deferredInstallPrompt = e;
        });
      }
    }

    window.addEventListener('appinstalled', () => {
      deferredInstallPrompt = null;
      $('installBtn').style.display = 'none';
    });

    function triggerInstall() {
      if (deferredInstallPrompt) {
        deferredInstallPrompt.prompt();
        deferredInstallPrompt.userChoice.then(({ outcome }) => {
          if (outcome === 'accepted') {
            deferredInstallPrompt = null;
            $('installBtn').style.display = 'none';
          }
        });
      } else {
        $('installGuide').style.display = 'flex';
      }
    }
    function closeInstallGuide() {
      $('installGuide').style.display = 'none';
    }
    window.triggerInstall = triggerInstall;
    window.closeInstallGuide = closeInstallGuide;
    $('installBtn').addEventListener('click', triggerInstall);

    // ── 서비스워커 등록 ──
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/campstaff-sw.js', { scope: '/campstaff' })
          .catch(e => console.warn('Campstaff SW registration failed:', e));
      });
    }
  </script>
</body>
</html>
