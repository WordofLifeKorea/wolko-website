---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
// 선교사 고르기 목록의 작은 사진 — 얼굴 맞춤(프로필 옆 목록과 같은 'avatar')과 작은 사본(srcset)
import { photoFrame } from '../../lib/photoFrame.js';
import { photoSrcset, photoSizes } from '../../utils/photoSrcset.js';
import { campusOf } from '../../lib/teamRoles.js';
import { headcountOf } from '../../lib/teamHeadcount.js';

// 사역 후원 — 한 카드. 예전에는 '월코 전체사역' · '제주월비' 두 카드였지만 두 카드가 같은 후원 주소였다.
// 제주월비 전용 주소를 받을 때까지 한 카드로 합친다(2단계 결정 5 ②). 전용 주소를 받으면 카드를 다시 나눈다.
// 예전 설명: 전체사역 '캠프·제자훈련·전도 등 월코의 모든 국내 사역을 지원합니다.' / 제주월비 '제주도 캠프 시설 건축과 사역 확장을 위한 후원입니다.'
const fund = {
  ko: '월코 사역 후원', en: 'Ministry Fund',
  dKo: '캠프·제자훈련·전도 등 국내 사역 전체와 제주 월비 캠프 시설·사역 확장을 함께 지원합니다.',
  dEn: 'Supports camps, discipleship, and evangelism across Korea, as well as campus facilities and ministry expansion at WOLBI Jeju.',
  monthly: 'https://online.mrm.or.kr/djPo2CH',
  once: 'https://online.mrm.or.kr/6eeXkHF',
  // 제주월비 사진(give-fund-jeju-campus.jpg)은 '제주에만 보낸다'로 읽힐 수 있어 쓰지 않는다
  img: '/images/heroes/give-fund-ministry.jpg', pos: '50% 50%',
};

// 선교사 고르기 — 프로필(src/content/team/*.md)에 후원 주소가 있는 사람만. 주소는 프로필 값 그대로 쓴다(새로 만들지 않음).
// 거름은 프로필 페이지(team/[slug].astro)와 같다: map-order 빼기, active 가 false 면 빼기.
// 링크: 한국어 화면 support_url || support_url_en, 영어 화면 support_url_en || support_url (프로필 '후원하기'와 같은 규칙)
const team = (await getCollection('team')).filter((p) => !p.slug.startsWith('map-order') && p.data.active !== false);
const givers = team
  .filter((p) => p.data.support_url || p.data.support_url_en)
  .map((p) => ({
    slug: p.slug,
    category: p.data.category,
    campus: p.data.campus,
    order: p.data.order ?? 99,
    // 사람 수(부부 항목은 2명) — 묶음 제목 숫자에 쓴다
    heads: headcountOf(p),
    nameKo: p.data.name_ko,
    nameEn: p.data.name_en,
    place: campusOf(p.data.campus),
    // 사진이 없을 때만 이름 첫 글자(언어별)
    initial: (p.data.name_ko || p.data.name_en || '?').trim().charAt(0),
    initialEn: (p.data.name_en || p.data.name_ko || '?').trim().charAt(0),
    photo: p.data.photo_url,
    photoStyle: p.data.photo_url ? photoFrame(p.data.photo_url, 1, 'avatar', p.data.photo_position) : undefined,
    urlKo: p.data.support_url || p.data.support_url_en,
    urlEn: p.data.support_url_en || p.data.support_url,
  }))
  // 평택 → 제주, 그 안에서 order, 같으면 이름 가나다 (섬기는이 목록과 같은 순서)
  .sort((a, b) => (a.campus === b.campus ? 0 : a.campus === 'pyeongtaek' ? -1 : 1) || a.order - b.order || a.nameKo.localeCompare(b.nameKo, 'ko'));
const giverGroups = [
  { key: 'missionary', ko: '선교사', en: 'Missionaries', open: true },
  { key: 'stw', ko: '단기 사역자', en: 'Short-term Workers', open: false },
].map((g) => ({ ...g, people: givers.filter((p) => p.category === g.key) })).filter((g) => g.people.length)
  // 묶음 제목 숫자는 항목 수가 아니라 사람 수(부부 항목은 2명) — src/lib/teamHeadcount.js 기준
  .map((g) => ({ ...g, count: g.people.reduce((n, p) => n + p.heads, 0) }));
// 작은 사진 칸 폭(아래 CSS .gv-pick-avatar 와 같아야 한다)
const AVATAR_SIZES = ['48px'];

// 계좌 후원 — 비어 있으면 계좌 묶음 자체가 화면에 나오지 않는다. 실제 후원 계좌를 받으면 그대로 채운다.
// 모양: { bankKo: '농협', bankEn: 'NH Bank', number: '000-0000-0000-00', holderKo: '예금주 이름', holderEn: 'Account holder' }
// number 는 화면에 보이는 그대로(하이픈 포함) 복사된다.
const giveAccounts: { bankKo: string; bankEn: string; number: string; holderKo: string; holderEn: string }[] = [];

// 사역 참여 — 페이지 맨 끝 남색 띠 안에 세 갈래로 놓인다(후원 단추가 먼저 보이게 맨 아래로 옮김)
const involve = [
  {
    num: '01', ko: '캠프 스태프', en: 'Camp Staff',
    dKo: '매년 진행되는 청소년 및 영어 캠프에서 스태프로 섬겨주세요. 다음 세대를 복음으로 만나는 자리에 함께합니다.',
    dEn: 'Serve as a staff member at our annual youth and English camps. Join us on the frontlines of reaching the next generation with the Gospel.',
  },
  {
    num: '02', ko: '해외 단기 선교', en: 'Short-Term Mission',
    dKo: '해외 단기 선교에 참여할 수 있습니다.',
    dEn: 'Join short-term overseas mission trips.',
  },
  {
    num: '03', ko: '다양한 사역에 참여', en: 'Ministry Volunteering',
    dKo: 'IT, 미디어, 마케팅, 커리큘럼 개발, 번역, 통역, 주방 사역, 영어 교육, 전도 사역, 한국어 교육 등 다양한 분야에 도움이 필요합니다.',
    dEn: 'We need help across many areas — IT, media, marketing, curriculum development, translation, interpretation, kitchen ministry, English education, evangelism, Korean language education, and more.',
  },
];
---

<BaseLayout
  title="후원 — Word of Life Korea"
  description="월코 사역 후원 및 선교사 개인 후원 — Word of Life Korea"
  activeNav="give"
>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<div class="give">

  <!-- ═══ HERO ═══ -->
<PageHero align="center" variant="band" image="/images/heroes/give-band-winter-camp.jpg" pos="50% 55%">
  <Fragment slot="eyebrow"><span class="wl-ko">함께하는 사역</span><span class="wl-en">Partner With Us</span></Fragment>
  <Fragment slot="title">
    <span class="wl-ko">사역에 <em>동참해 주세요</em></span>
    <span class="wl-en">Support <em>the Mission</em></span>
  </Fragment>
  <Fragment slot="desc">
    <span class="wl-ko">여러분의 후원이 한국의 다음 세대를 복음으로 섬기는 월코 사역을 이어가게 합니다.</span>
    <span class="wl-en">Your generosity empowers Word of Life Korea to reach the next generation with the Gospel.</span>
  </Fragment>
</PageHero>

  <!-- ═══ 바로가기 줄 — 세 갈래(사역 · 선교사 · 해외)로 바로 내려간다.
       한국어 줄과 영어 줄을 따로 둔다: 영어는 '해외에서 후원'이 맨 앞. 보이는 순서 = Tab 순서(CSS order 쓰지 않음) ═══ -->
  <nav class="gv-jump" aria-label="후원 방법 바로가기" data-wl-label-ko="후원 방법 바로가기" data-wl-label-en="Ways to give">
    <div class="wl-ko">
      <ul class="gv-shell gv-jump-list">
        <li class="gv-jump-item">
          <a href="#ministry-give"><span>사역 후원</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4"/></svg></a>
        </li>
        <li class="gv-jump-item">
          <a href="#missionary-give"><span>선교사 후원</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4"/></svg></a>
        </li>
        <li class="gv-jump-item">
          <a href="#intl-give"><span>해외에서 후원</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4"/></svg></a>
        </li>
      </ul>
    </div>
    <div class="wl-en">
      <ul class="gv-shell gv-jump-list">
        <li class="gv-jump-item">
          <a href="#intl-give"><span>Give from Abroad</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4"/></svg></a>
        </li>
        <li class="gv-jump-item">
          <a href="#ministry-give"><span>Ministry Fund</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4"/></svg></a>
        </li>
        <li class="gv-jump-item">
          <a href="#missionary-give"><span>Support a Missionary</span><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v11M4 9l4 4 4-4"/></svg></a>
        </li>
      </ul>
    </div>
  </nav>

  <!-- ═══ SECTION 1 : 사역 후원 — 한 카드(두 기금이 같은 주소라 합침) ═══ -->
  <section class="gv-ministry" id="ministry-give">
    <div class="gv-shell">
      <div class="gv-ministry-grid">
        <div class="gv-ministry-intro">
          <p class="gv-eyebrow"><span class="wl-ko">사역 후원</span><span class="wl-en">Ministry Support</span></p>
          <h2 class="gv-title">
            <span class="wl-ko">월코 사역을<br>함께 세워가요</span>
            <span class="wl-en">Build the Ministry<br>Together</span>
          </h2>
          <p class="gv-lead">
            <span class="wl-ko">월코 본부 사역과 제주 캠프 건축, 그리고 해외 선교를 위한 후원입니다.</span>
            <span class="wl-en">Support WOLKO's headquarters ministry, Jeju camp expansion, and overseas missions.</span>
          </p>
        </div>

        <article class="gv-fund">
          <h3 class="gv-fund-title"><span class="wl-ko">{fund.ko}</span><span class="wl-en">{fund.en}</span></h3>
          <p class="gv-fund-desc"><span class="wl-ko">{fund.dKo}</span><span class="wl-en">{fund.dEn}</span></p>
          <div class="gv-fund-btns">
            <a href={fund.monthly} target="_blank" rel="noopener" class="gv-btn gv-btn-primary">
              <span><span class="wl-ko">정기후원</span><span class="wl-en">Monthly</span></span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
            </a>
            <a href={fund.once} target="_blank" rel="noopener" class="gv-btn gv-btn-secondary">
              <span><span class="wl-ko">일시후원</span><span class="wl-en">One-time</span></span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
            </a>
          </div>
        </article>
      </div>

      <!-- 사진은 단추 뒤(휴대폰에서 단추가 먼저 보이게) -->
      <figure class="gv-fund-photo"><img src={fund.img} alt="" loading="lazy" style={`object-position:${fund.pos}`}></figure>

      {giveAccounts.length > 0 && (
        <div class="gv-accounts">
          <p class="gv-group-label"><span class="wl-ko">계좌 후원</span><span class="wl-en">Bank Transfer</span></p>
          <div class="gv-acct-list">
            {giveAccounts.map((a) => (
              <div class="gv-acct">
                <dl class="gv-acct-meta">
                  <div>
                    <dt><span class="wl-ko">은행</span><span class="wl-en">Bank</span></dt>
                    <dd><span class="wl-ko">{a.bankKo}</span><span class="wl-en">{a.bankEn}</span></dd>
                  </div>
                  <div>
                    <dt><span class="wl-ko">예금주</span><span class="wl-en">Account holder</span></dt>
                    <dd><span class="wl-ko">{a.holderKo}</span><span class="wl-en">{a.holderEn}</span></dd>
                  </div>
                </dl>
                <button type="button" class="gv-acct-num" data-copy={a.number}
                  data-label-ko={`${a.bankKo} 계좌번호 ${a.number} 복사`} data-label-en={`Copy ${a.bankEn} account number ${a.number}`}
                  aria-label={`${a.bankKo} 계좌번호 ${a.number} 복사`}>
                  <span class="gv-sr">{a.number}</span>
                  <span class="gv-acct-digits" aria-hidden="true">
                    {[...a.number].map((ch) => (
                      <span class:list={['gv-dg', { 'gv-dg-sep': !/\d/.test(ch) }]} data-ch={ch}>{ch}</span>
                    ))}
                  </span>
                </button>
                <button type="button" class="gv-btn gv-btn-primary gv-acct-copy" data-copy={a.number}
                  data-label-ko={`${a.bankKo} 계좌번호 복사`} data-label-en={`Copy ${a.bankEn} account number`}
                  aria-label={`${a.bankKo} 계좌번호 복사`}>
                  <span class="gv-copy-idle"><span class="wl-ko">복사</span><span class="wl-en">Copy</span></span>
                  <span class="gv-copy-done"><span class="wl-ko">복사됐어요</span><span class="wl-en">Copied</span></span>
                </button>
              </div>
            ))}
          </div>
          <p class="gv-sr" id="gv-copy-live" aria-live="polite"></p>
          <div class="gv-toast" id="gv-copy-toast" aria-hidden="true">
            <span class="wl-ko">계좌번호를 복사했어요</span><span class="wl-en">Account number copied</span>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ 왜 지금 — 큰 숫자 한 줄 (홈과 같은 근거) ═══ -->
  <section class="gv-stat">
    <div class="gv-shell gv-stat-inner">
      <div class="gv-stat-num" aria-label="83%"><b data-count-to="83">83</b><span aria-hidden="true">%</span></div>
      <div class="gv-stat-body">
        <p class="gv-eyebrow gv-eyebrow--light"><span class="wl-ko">한국 청소년 무종교율</span><span class="wl-en">Korean Youth Without Religious Affiliation</span></p>
        <p class="gv-stat-text">
          <span class="wl-ko">한국 청소년 10명 중 8명 이상이 종교가 없습니다. 종교가 있다고 답한 17%마저 개신교·불교·천주교 등 <strong>모든 종교를 합한 수치</strong>입니다.</span>
          <span class="wl-en">More than 8 in 10 Korean teens have no religion — and even the 17% who do represent <strong>all religions combined</strong> (Protestant, Buddhist, Catholic, and others).</span>
        </p>
        <p class="gv-stat-source">
          <span class="wl-ko">한국갤럽 「한국인의 종교 1983–2025」 · 만 13~18세 기준</span>
          <span class="wl-en">Gallup Korea, “Religion of Koreans 1983–2025” · ages 13–18</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ SECTION 2 : 선교사 개인 후원 ═══ -->
  <section class="gv-missionary" id="missionary-give">
    <div class="gv-shell gv-mission-layout">

      <!-- Left: Text -->
      <div class="gv-mission-text">
        <p class="gv-eyebrow"><span class="wl-ko">선교사 개인 후원</span><span class="wl-en">Missionary Support</span></p>
        <h2 class="gv-title">
          <span class="wl-ko">한 사람의 선교사를<br>함께 세워가요</span>
          <span class="wl-en">Invest in a<br>Missionary's Life</span>
        </h2>
        <p class="gv-body">
          <span class="wl-ko">월코 선교사들은 복음전파와 제자훈련을 위해 한국 전역과 해외에서 헌신하고 있습니다. 선교사 개인 후원을 통해 한 사람의 사역과 삶을 직접 지원해 주세요.</span>
          <span class="wl-en">WOLKO missionaries are committed to Gospel proclamation and discipleship across Korea and beyond. Through personal missionary support, you directly invest in a specific missionary's life and ministry.</span>
        </p>
        <p class="gv-note">
          <span class="wl-ko">후원을 시작하시면 담당 선교사가 감사 인사와 함께 정기적으로 사역 소식을 전해 드립니다.</span>
          <span class="wl-en">When you begin supporting a missionary, they will personally reach out and share regular updates from the field.</span>
        </p>
        <figure class="gv-mission-photo"><img src="/images/people/hero-drone.jpg" alt="월코 사역자들이 W 로고 둘레에 모여 하늘을 올려다보는 모습" data-wl-alt-ko="월코 사역자들이 W 로고 둘레에 모여 하늘을 올려다보는 모습" data-wl-alt-en="WOLKO staff gathered around a W logo, looking up at the sky" loading="lazy"></figure>
      </div>

      <!-- Right: 후원 방법 -->
      <div class="gv-mission-give">
        <p class="gv-give-label"><span class="wl-ko">후원 방법 선택</span><span class="wl-en">Choose Your Gift Type</span></p>
        <ul class="gv-give-list">
          <li>
            <a href="https://online.mrm.or.kr/KoUtWvX" target="_blank" rel="noopener" class="gv-give-row">
              <span class="gv-give-row-info">
                <strong class="gv-give-row-title"><span class="wl-ko">정기후원</span><span class="wl-en">Monthly Support</span></strong>
                <span class="gv-give-row-sub"><span class="wl-ko">매월 안정적으로 선교사를 도와요</span><span class="wl-en">Consistent monthly support for the missionary</span></span>
              </span>
              <svg class="gv-give-row-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
            </a>
          </li>
          <li>
            <a href="https://online.mrm.or.kr/qE1NHEc" target="_blank" rel="noopener" class="gv-give-row">
              <span class="gv-give-row-info">
                <strong class="gv-give-row-title"><span class="wl-ko">일시후원</span><span class="wl-en">One-time Gift</span></strong>
                <span class="gv-give-row-sub"><span class="wl-ko">한 번의 특별한 헌신으로 함께해요</span><span class="wl-en">Make a special one-time contribution</span></span>
              </span>
              <svg class="gv-give-row-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
            </a>
          </li>
        </ul>

        <!-- 선교사를 골라 후원 — 프로필에 후원 주소가 있는 사람. 선교사는 펼쳐 두고, 단기 사역자는 접어 둔다 -->
        <div class="gv-pick">
          <h3 class="gv-pick-title"><span class="wl-ko">후원할 사역자 고르기</span><span class="wl-en">Choose Who to Support</span></h3>
          <p class="gv-pick-note"><span class="wl-ko">‘후원하기’를 누르면 그 사람의 후원 페이지가 새 창으로 열려요.</span><span class="wl-en">Select “Support” to open that person's giving page in a new tab.</span></p>
          {giverGroups.map((g) => {
            const rows = (
              <ul class="gv-pick-list">
                {g.people.map((p) => (
                  <li class="gv-pick-row">
                    <span class="gv-pick-avatar" aria-hidden="true">
                      {p.photo
