/* 계좌 후원 — 큰 번호, 누르면 복사 (계좌가 비어 있으면 화면에 나오지 않음) */
.gv-group-label { color: var(--gv-label); font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 16px; }
.gv-sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
.gv-accounts { margin-top: 72px; }
.gv-acct-list { border-top: 2px solid var(--gv-navy); }
.gv-acct {
  display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto; align-items: center; gap: 24px 40px;
  padding: 28px 0; border-bottom: 1px solid var(--gv-line);
}
.gv-acct-meta { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; padding: 16px 20px; background: var(--gv-fill); }
.gv-acct-meta dt { font-size: 12px; font-weight: 700; color: var(--gv-label); }
.gv-acct-meta dd { margin: 6px 0 0; font-size: 15px; font-weight: 600; line-height: 1.5; color: var(--gv-ink); }
.gv-acct-num {
  justify-self: start; padding: 6px 0; border: 0; background: none; cursor: copy; text-align: left;
  font-family: var(--ff-serif); font-size: clamp(30px, 3.2vw, 44px); font-weight: 700; letter-spacing: -.01em; line-height: 1.15;
  font-variant-numeric: tabular-nums; color: var(--gv-navy);
}
