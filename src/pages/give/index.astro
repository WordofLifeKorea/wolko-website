<script is:inline>
  // 후원 페이지 움직임: 스크롤하면 글과 항목이 아래에서 차례로 떠오른다.
  // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
  (function () {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var items = [].slice.call(document.querySelectorAll('.give .gv-ministry-intro, .give .gv-fund, .give .gv-fund-photo, .give .gv-stat-inner > *, .give .gv-mission-layout > *, .give .gv-intl-inner > *, .give .gv-involve-head, .give .gv-involve-item, .give .gv-involve-cta'));
    items.forEach(function (el) {
      var sib = el.parentNode.children, i = [].indexOf.call(sib, el);
      el.style.setProperty('--d', Math.min(i, 6) * 0.08 + 's');
      el.classList.add('gv-rv');
    });
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    items.forEach(function (el) { io.observe(el); });
  })();

  // 계좌번호 복사 — 번호를 누르거나 "복사" 버튼을 누르면 화면에 보이는 그대로(하이픈 포함) 복사한다.
  (function () {
    var accts = [].slice.call(document.querySelectorAll('.gv-acct'));
    if (!accts.length) return;
    var live = document.getElementById('gv-copy-live');
    var toast = document.getElementById('gv-copy-toast');
    var isEn = function () { return document.documentElement.classList.contains('lang-en'); };
    var T = function (ko, en) { return isEn() ? en : ko; };

    // 화면 읽기 프로그램용 버튼 이름도 지금 언어에 맞춘다
    function syncLabels() {
      var en = isEn();
      document.querySelectorAll('.gv-acct [data-label-ko]').forEach(function (b) { b.setAttribute('aria-label', en ? b.dataset.labelEn : b.dataset.labelKo); });
    }
    syncLabels();
    new MutationObserver(syncLabels).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

    function fallbackCopy(text) {
      var ta = document.createElement('textarea');
      ta.value = text; ta.setAttribute('readonly', '');
      ta.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;';
      document.body.appendChild(ta); ta.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch (e) {}
      document.body.removeChild(ta);
      return ok;
    }
    function copy(text) {
      if (navigator.clipboard && window.isSecureContext) {
        return navigator.clipboard.writeText(text).then(function () { return true; }, function () { return fallbackCopy(text); });
      }
      return Promise.resolve(fallbackCopy(text));
    }

    var toastTimer;
    accts.forEach(function (acct) {
      var timer;
      acct.querySelectorAll('[data-copy]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var text = btn.dataset.copy;
          copy(text).then(function (ok) {
            if (live) live.textContent = '';
            if (!ok) {
              if (live) live.textContent = T('복사하지 못했어요. 번호를 직접 선택해 주세요.', 'Could not copy. Please select the number manually.');
              return;
            }
            acct.classList.add('is-copied');
            if (live) live.textContent = T('계좌번호를 복사했어요', 'Account number copied') + ' ' + text;
            if (toast) {
              toast.classList.add('is-on');
              clearTimeout(toastTimer);
              toastTimer = setTimeout(function () { toast.classList.remove('is-on'); }, 2000);
            }
            clearTimeout(timer);
            timer = setTimeout(function () { acct.classList.remove('is-copied'); }, 2000);
          });
        });
      });
    });

    // 번호가 화면에 들어오면 숫자가 왼쪽부터 차례로 돌다가 제자리에 멈춘다(보이는 모양만 — 실제 번호는 따로 늘 그대로 있다).
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    function roll(box) {
      var digits = [].slice.call(box.querySelectorAll('.gv-dg'));
      var n = 0;
      digits.forEach(function (d) {
        var real = d.dataset.ch;
        if (!/\d/.test(real)) return;
        var stopAt = 260 + n * 55; n++;
        var start = performance.now();
        d.classList.add('is-rolling');
        (function tick(now) {
          if (now - start >= stopAt) { d.textContent = real; d.classList.remove('is-rolling'); d.classList.add('is-set'); return; }
          d.textContent = String(Math.floor(Math.random() * 10));
          setTimeout(function () { requestAnimationFrame(tick); }, 45);
        })(start);
      });
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { roll(en.target); io.unobserve(en.target); } });
    }, { threshold: 0.5 });
    document.querySelectorAll('.gv-acct-digits').forEach(function (el) { el.classList.add('is-armed'); io.observe(el); });
  })();
</script>
<script is:inline>
  // 큰 숫자(83%)는 화면에 들어오면 0부터 1.8초 동안 올라간다. 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 처음부터 83 그대로.
  (function () {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var els = [].slice.call(document.querySelectorAll('[data-count-to]'));
    els.forEach(function (el) { el.textContent = '0'; });
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (!en.isIntersecting) return;
        io.unobserve(en.target);
        var el = en.target, to = +el.getAttribute('data-count-to'), t0 = Date.now(), dur = 1800;
        (function step() {
          var k = Math.min(1, (Date.now() - t0) / dur), e = 1 - Math.pow(1 - k, 4);
          el.textContent = Math.round(to * e);
          if (k < 1) setTimeout(step, 30);
        })();
      });
    }, { threshold: 0.5 });
    els.forEach(function (el) { io.observe(el); });
  })();
</script>

</BaseLayout>

<style>
/* ── 색·글꼴은 감싸는 클래스에 둔다 (:root 아님) — 사역 페이지와 같은 값 ── */
.give {
  --gv-deep:  #004f68;
  --gv-navy:  #0b2430;
