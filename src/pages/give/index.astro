/* ── 1. 사역 후원 — 왼쪽 소개, 오른쪽 한 카드(단추), 아래 넓은 사진 ── */
.gv-ministry { padding: 96px 0 112px; scroll-margin-top: 40px; }
.gv-ministry-grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 80px; align-items: start; }
