---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

// 국내 사역 후원 — 두 기금이 같은 모양(사진과 큰 번호 · 제목 · 설명 · 정기/일시 버튼)으로 나란히 놓인다
const funds = [
  {
    num: '01',
    ko: '월코 전체사역 후원', en: 'WOLKO Ministry Fund',
    dKo: '캠프·제자훈련·전도 등 월코의 모든 국내 사역을 지원합니다.',
    dEn: "Supports all of WOLKO's camp, discipleship, and outreach programs.",
    monthly: 'https://online.mrm.or.kr/djPo2CH',
    once: 'https://online.mrm.or.kr/6eeXkHF',
    img: '/images/heroes/campgroup.jpg', pos: '50% 45%',
  },
  {
    num: '02',
    ko: '제주월비 후원', en: 'Jeju WOLBI Fund',
    dKo: '제주도 캠프 시설 건축과 사역 확장을 위한 후원입니다.',
    dEn: 'Supports the Jeju camp facility construction and ministry expansion.',
    monthly: 'https://online.mrm.or.kr/djPo2CH',
    once: 'https://online.mrm.or.kr/6eeXkHF',
    img: '/images/ministries/wolbi.jpg', pos: '50% 50%',
  },
];

// 계좌 후원 — 비어 있으면 계좌 묶음 자체가 화면에 나오지 않는다. 실제 후원 계좌를 받으면 그대로 채운다.
// 모양: { bankKo: '농협', bankEn: 'NH Bank', number: '000-0000-0000-00', holderKo: '예금주 이름', holderEn: 'Account holder' }
// number 는 화면에 보이는 그대로(하이픈 포함) 복사된다.
const giveAccounts: { bankKo: string; bankEn: string; number: string; holderKo: string; holderEn: string }[] = [];

// 사역 참여 — 마무리 남색 띠 안에 세 갈래로 놓인다
const involve = [
  {
    num: '01', ko: '캠프 스태프', en: 'Camp Staff',
    dKo: '매년 진행되는 청소년 및 영어 캠프에서 스태프로 섬겨주세요. 다음 세대를 복음으로 만나는 현장에 함께합니다.',
    dEn: 'Serve as a staff member at our annual youth and English camps. Join us on the frontlines of reaching the next generation with the Gospel.',
  },
  {
    num: '02', ko: '해외 단기 선교', en: 'Short-Term Mission',
    dKo: '베트남 등 해외 단기 선교에 참여할 수 있습니다.',
    dEn: 'Join short-term mission trips to Vietnam and beyond.',
  },
  {
    num: '03', ko: '다양한 사역에 참여', en: 'Ministry Volunteering',
    dKo: 'IT, 미디어, 마케팅, 커리큘럼 개발, 번역, 통역, 주방 사역, 영어 교육, 전도 사역, 한국어 교육 등 다양한 분야에 도움이 필요합니다.',
    dEn: 'We need help across many areas — IT, media, marketing, curriculum development, translation, interpretation, kitchen ministry, English education, evangelism, Korean language education, and more.',
  },
];
---

<BaseLayout
  title="후원 — Word of Life Korea"
  description="월코 사역 후원 및 선교사 개인 후원 — Word of Life Korea"
  activeNav="give"
>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<div class="give">

  <!-- ═══ HERO ═══ -->
<PageHero align="center" variant="band" image="/images/heroes/worship.jpg" pos="50% 35%">
  <Fragment slot="eyebrow"><span class="wl-ko">함께하는 사역</span><span class="wl-en">Partner With Us</span></Fragment>
  <Fragment slot="title">
    <span class="wl-ko">사역에 동참해 주세요</span>
    <span class="wl-en">Support the Mission</span>
  </Fragment>
  <Fragment slot="desc">
    <span class="wl-ko">여러분의 후원이 한국의 다음 세대를 복음으로 섬기는 월코 사역을 이어가게 합니다.</span>
    <span class="wl-en">Your generosity empowers Word of Life Korea to reach the next generation with the Gospel.</span>
  </Fragment>
</PageHero>

  <!-- ═══ SECTION 1 : 사역 후원 ═══ -->
  <section class="gv-ministry" id="ministry-give">
    <div class="gv-shell">
      <div class="gv-head">
        <div>
          <p class="gv-eyebrow"><span class="wl-ko">사역 후원</span><span class="wl-en">Ministry Support</span></p>
          <h2 class="gv-title">
            <span class="wl-ko">월코 사역을<br>함께 세워가요</span>
            <span class="wl-en">Build the Ministry<br>Together</span>
          </h2>
        </div>
        <p class="gv-lead">
          <span class="wl-ko">월코 본부 사역과 제주 캠프 건축, 그리고 베트남 선교를 위한 후원입니다.<br>여러분의 헌신이 복음의 다음 장을 씁니다.</span>
          <span class="wl-en">Support WOLKO's headquarters ministry, Jeju camp expansion, and Vietnam mission.<br>Your commitment writes the next chapter of the Gospel.</span>
        </p>
      </div>

      <!-- 국내사역 그룹 : 월코 + 제주 -->
      <div class="gv-funds">
        <p class="gv-group-label"><span class="wl-ko">국내 사역 후원</span><span class="wl-en">Domestic Ministry</span></p>
        <div class="gv-fund-grid">
          {funds.map((f) => (
            <article class="gv-fund">
              <figure class="gv-fund-photo">
                <img src={f.img} alt="" loading="lazy" style={`object-position:${f.pos}`}>
                <span class="gv-fund-num" aria-hidden="true">{f.num}</span>
              </figure>
              <h3 class="gv-fund-title"><span class="wl-ko">{f.ko}</span><span class="wl-en">{f.en}</span></h3>
              <p class="gv-fund-desc"><span class="wl-ko">{f.dKo}</span><span class="wl-en">{f.dEn}</span></p>
              <div class="gv-fund-btns">
                <a href={f.monthly} target="_blank" rel="noopener" class="gv-btn gv-btn-primary">
                  <span><span class="wl-ko">정기후원</span><span class="wl-en">Monthly</span></span>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
                </a>
                <a href={f.once} target="_blank" rel="noopener" class="gv-btn gv-btn-secondary">
                  <span><span class="wl-ko">일시후원</span><span class="wl-en">One-time</span></span>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      {giveAccounts.length > 0 && (
        <div class="gv-accounts">
          <p class="gv-group-label"><span class="wl-ko">계좌 후원</span><span class="wl-en">Bank Transfer</span></p>
          <div class="gv-acct-list">
            {giveAccounts.map((a) => (
              <div class="gv-acct">
                <dl class="gv-acct-meta">
                  <div>
                    <dt><span class="wl-ko">은행</span><span class="wl-en">Bank</span></dt>
                    <dd><span class="wl-ko">{a.bankKo}</span><span class="wl-en">{a.bankEn}</span></dd>
                  </div>
                  <div>
                    <dt><span class="wl-ko">예금주</span><span class="wl-en">Account holder</span></dt>
                    <dd><span class="wl-ko">{a.holderKo}</span><span class="wl-en">{a.holderEn}</span></dd>
                  </div>
                </dl>
                <button type="button" class="gv-acct-num" data-copy={a.number}
                  data-label-ko={`${a.bankKo} 계좌번호 ${a.number} 복사`} data-label-en={`Copy ${a.bankEn} account number ${a.number}`}
                  aria-label={`${a.bankKo} 계좌번호 ${a.number} 복사`}>
                  <span class="gv-sr">{a.number}</span>
                  <span class="gv-acct-digits" aria-hidden="true">
                    {[...a.number].map((ch) => (
                      <span class:list={['gv-dg', { 'gv-dg-sep': !/\d/.test(ch) }]} data-ch={ch}>{ch}</span>
                    ))}
                  </span>
                </button>
                <button type="button" class="gv-btn gv-btn-primary gv-acct-copy" data-copy={a.number}
                  data-label-ko={`${a.bankKo} 계좌번호 복사`} data-label-en={`Copy ${a.bankEn} account number`}
                  aria-label={`${a.bankKo} 계좌번호 복사`}>
                  <span class="gv-copy-idle"><span class="wl-ko">복사</span><span class="wl-en">Copy</span></span>
                  <span class="gv-copy-done"><span class="wl-ko">복사됐어요</span><span class="wl-en">Copied</span></span>
                </button>
              </div>
            ))}
          </div>
          <p class="gv-sr" id="gv-copy-live" aria-live="polite"></p>
          <div class="gv-toast" id="gv-copy-toast" aria-hidden="true">
            <span class="wl-ko">계좌번호를 복사했어요</span><span class="wl-en">Account number copied</span>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ═══ 왜 지금 — 큰 숫자 한 줄 (홈과 같은 근거) ═══ -->
  <section class="gv-stat">
    <div class="gv-shell gv-stat-inner">
      <div class="gv-stat-num" aria-label="83%"><b data-count-to="83">83</b><span aria-hidden="true">%</span></div>
      <div class="gv-stat-body">
        <p class="gv-eyebrow gv-eyebrow--light"><span class="wl-ko">한국 청소년 무종교율</span><span class="wl-en">Korean Youth Without Religious Affiliation</span></p>
        <p class="gv-stat-text">
          <span class="wl-ko">한국 청소년 10명 중 8명 이상이 종교가 없습니다. 종교가 있다고 답한 17%마저 개신교·불교·천주교 등 <strong>모든 종교를 합한 수치</strong>입니다.</span>
          <span class="wl-en">More than 8 in 10 Korean teens have no religion — and even the 17% who do represent <strong>all religions combined</strong> (Protestant, Buddhist, Catholic, and others).</span>
        </p>
        <p class="gv-stat-source">
          <span class="wl-ko">한국갤럽 「한국인의 종교 1983–2025」 · 만 13~18세 기준</span>
          <span class="wl-en">Gallup Korea, “Religion of Koreans 1983–2025” · ages 13–18</span>
        </p>
      </div>
    </div>
  </section>

  <!-- ═══ SECTION 2 : 선교사 개인 후원 ═══ -->
  <section class="gv-missionary" id="missionary-give">
    <div class="gv-shell gv-mission-layout">

      <!-- Left: Text -->
      <div class="gv-mission-text">
        <p class="gv-eyebrow"><span class="wl-ko">선교사 개인 후원</span><span class="wl-en">Missionary Support</span></p>
        <h2 class="gv-title">
          <span class="wl-ko">한 사람의 선교사를<br>함께 세워가요</span>
          <span class="wl-en">Invest in a<br>Missionary's Life</span>
        </h2>
        <p class="gv-body">
          <span class="wl-ko">월코 선교사들은 복음전파와 제자훈련을 위해 한국 전역과 해외 현장에서 헌신하고 있습니다. 선교사 개인 후원을 통해 한 사람의 사역과 삶을 직접 지원해 주세요.</span>
          <span class="wl-en">WOLKO missionaries are committed to Gospel proclamation and discipleship across Korea and beyond. Through personal missionary support, you directly invest in a specific missionary's life and ministry.</span>
        </p>
        <p class="gv-note">
          <span class="wl-ko">후원을 시작하시면 담당 선교사가 감사 인사와 함께 정기적으로 사역 소식을 전해 드립니다.</span>
          <span class="wl-en">When you begin supporting a missionary, they will personally reach out and share regular updates from the field.</span>
        </p>
        <figure class="gv-mission-photo"><img src="/images/people/hero-drone.jpg" alt="월코 사역자들이 W 로고 둘레에 모여 하늘을 올려다보는 모습" loading="lazy"></figure>
      </div>

      <!-- Right: 후원 방법 -->
      <div class="gv-mission-give">
        <p class="gv-give-label"><span class="wl-ko">후원 방법 선택</span><span class="wl-en">Choose Your Gift Type</span></p>
        <ul class="gv-give-list">
          <li>
            <a href="https://online.mrm.or.kr/KoUtWvX" target="_blank" rel="noopener" class="gv-give-row">
              <span class="gv-give-row-info">
                <strong class="gv-give-row-title"><span class="wl-ko">정기후원</span><span class="wl-en">Monthly Support</span></strong>
                <span class="gv-give-row-sub"><span class="wl-ko">매월 안정적으로 선교사를 돕습니다</span><span class="wl-en">Consistent monthly support for the missionary</span></span>
              </span>
              <svg class="gv-give-row-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
            </a>
          </li>
          <li>
            <a href="https://online.mrm.or.kr/qE1NHEc" target="_blank" rel="noopener" class="gv-give-row">
              <span class="gv-give-row-info">
                <strong class="gv-give-row-title"><span class="wl-ko">일시후원</span><span class="wl-en">One-time Gift</span></strong>
                <span class="gv-give-row-sub"><span class="wl-ko">한 번의 특별한 헌신으로 함께합니다</span><span class="wl-en">Make a special one-time contribution</span></span>
              </span>
              <svg class="gv-give-row-arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
            </a>
          </li>
        </ul>

        <div class="gv-ask">
          <p class="gv-ask-label"><span class="wl-ko">궁금한 점이 있으신가요?</span><span class="wl-en">Have questions?</span></p>
          <div class="gv-ask-btns">
            <a href="http://pf.kakao.com/_Rxidxkxj" target="_blank" rel="noopener" class="gv-btn gv-btn-kakao">
              <span class="gv-kakao-in">
                <svg viewBox="0 0 24 24" class="gv-kakao-icon" aria-hidden="true">
                  <path d="M12 3C6.48 3 2 6.69 2 11.25c0 2.9 1.9 5.45 4.77 6.89l-1.18 4.32a.4.4 0 0 0 .58.46L11.2 19.7A11 11 0 0 0 12 19.5c5.52 0 10-3.69 10-8.25S17.52 3 12 3z"/>
                </svg>
                <span><span class="wl-ko">카카오톡 문의</span><span class="wl-en">KakaoTalk</span></span>
              </span>
            </a>
            <a href="/contact" class="gv-btn gv-btn-secondary">
              <span><span class="wl-ko">이메일 문의</span><span class="wl-en">Contact us</span></span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ═══ SECTION 3 : 베트남 선교 후원 ═══ -->
  {/* 베트남 선교 종료로 전용 후원 섹션 노출 중단
  <section class="gv-ministry" id="vietnam-give" style="background:#f4f7f9;">
    <div class="gv-wrap">
      <div class="gv-vietnam-group" style="margin-top:0;">
        <div class="gv-group-label-bar gv-group-label-bar--vn">
          <span class="wl-ko">🇻🇳 해외 선교 후원</span>
          <span class="wl-en">🇻🇳 Overseas Mission</span>
        </div>
        <div class="gv-card gv-card-vietnam gv-card-wide">
          <div class="gv-card-top">
            <div class="gv-card-icon">
              <svg viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="22" cy="22" r="20" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.2)" stroke-width="1.5"/>
                <circle cx="22" cy="18" r="5" stroke="rgba(255,255,255,0.9)" stroke-width="1.5"/>
                <path d="M11 34c0-6.07 4.93-11 11-11s11 4.93 11 11" stroke="rgba(255,255,255,0.9)" stroke-width="1.5" stroke-linecap="round"/>
              </svg>
            </div>
            <div>
              <h3 class="gv-card-title">
                <span class="wl-ko">베트남 선교 후원</span>
                <span class="wl-en">Vietnam Mission Support</span>
              </h3>
              <p class="gv-card-desc">
                <span class="wl-ko">베트남 현지 선교 사역과 교회 개척, 다음 세대 복음화를 위한 후원입니다.</span>
                <span class="wl-en">Supports on-the-ground mission work, church planting, and youth outreach in Vietnam.</span>
              </p>
            </div>
          </div>
          <div class="gv-card-btns">
            <a href="https://online.mrm.or.kr/yrPkWIu" target="_blank" rel="noopener" class="gv-cbtn gv-cbtn-solid gv-cbtn-vn">
              <span class="wl-ko">베트남 선교 후원하기</span>
              <span class="wl-en">Give to Vietnam Mission</span>
            </a>
            <a href="/vietnam" class="gv-cbtn gv-cbtn-ghost">
              <span class="wl-ko">사역 자세히 보기</span>
              <span class="wl-en">Learn More</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
  */}

  <!-- ═══ SECTION 4 : 해외 후원 ═══ -->
  <section class="gv-intl">
    <div class="gv-shell gv-intl-inner">
      <div class="gv-intl-text">
        <p class="gv-eyebrow"><span class="wl-ko">해외 거주자 후원</span><span class="wl-en">International Giving</span></p>
        <h2 class="gv-intl-title">
          <span class="wl-ko">해외에서 후원하시나요?</span>
          <span class="wl-en">Giving from Outside Korea?</span>
        </h2>
        <p class="gv-intl-desc">
          <span class="wl-ko">미국 및 해외 거주자분들께서는 Word of Life 국제 후원 페이지를 통해 한국 사역을 지원하실 수 있습니다.</span>
          <span class="wl-en">Donors based in the US or abroad can support Word of Life Korea through the international giving portal hosted by Word of Life International.</span>
        </p>
        <a href="https://give.wol.org/location/southkorea" target="_blank" rel="noopener" class="gv-btn gv-btn-primary gv-intl-btn">
          <span><span class="wl-ko">국제 후원 페이지</span><span class="wl-en">Give Internationally</span></span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
        </a>
      </div>
      <figure class="gv-intl-photo"><img src="/images/heroes/vietnam.jpg" alt="베트남 캠프에 함께한 청소년들과 스태프" loading="lazy"></figure>
    </div>
  </section>

  <!-- ═══ 사역 참여 — 마무리 남색 띠 ═══ -->
  <section class="gv-involve">
    <div class="gv-shell">
      <div class="gv-involve-head">
        <p class="gv-eyebrow"><span class="wl-ko">사역 참여</span><span class="wl-en">Get Involved</span></p>
        <h2 class="gv-title">
          <span class="wl-ko">함께 사역할 수 있는<br>다양한 방법이 있습니다</span>
          <span class="wl-en">There Are Many Ways<br>to Serve With Us</span>
        </h2>
      </div>
      <ol class="gv-involve-grid">
        {involve.map((v) => (
          <li class="gv-involve-item">
            <span class="gv-involve-num">{v.num}</span>
            <h3 class="gv-involve-title"><span class="wl-ko">{v.ko}</span><span class="wl-en">{v.en}</span></h3>
            <p class="gv-involve-desc"><span class="wl-ko">{v.dKo}</span><span class="wl-en">{v.dEn}</span></p>
          </li>
        ))}
      </ol>
      <div class="gv-involve-cta">
        <a href="/contact" class="gv-btn gv-btn-light">
          <span><span class="wl-ko">참여 문의하기</span><span class="wl-en">Get in Touch</span></span>
          <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
        </a>
      </div>
    </div>
  </section>

</div>

<script is:inline>
