  overflow: hidden;
}
.gv-shell { width: min(1200px, calc(100% - 48px)); margin-inline: auto; }
.give svg { width: 14px; height: 14px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: square; }

/* 작은 표시 — 앞에 가는 선 */
.gv-eyebrow { display: flex; align-items: center; gap: 12px; color: var(--gv-deep); font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
.gv-eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; }
.gv-title { margin-top: 20px; font-family: var(--ff-serif); font-size: clamp(30px, 3.4vw, 46px); font-weight: 700; line-height: 1.22; letter-spacing: -.03em; color: var(--gv-navy); }

/* 버튼 — 각진 모서리, 화살표 */
.gv-btn {
  height: 52px; padding: 0 22px; display: inline-flex; align-items: center; justify-content: space-between; gap: 14px;
  border-radius: 2px; font-size: 15px; font-weight: 700; text-decoration: none; white-space: nowrap;
  transition: background-color .2s, border-color .2s, color .2s, gap .25s;
}
.gv-btn-primary { background: var(--gv-deep); color: #fff; }
.gv-btn-primary:hover { background: #00384a; color: #fff; gap: 18px; }
.gv-btn-secondary { border: 1px solid #b9c7ce; color: var(--gv-navy); background: #fff; }
.gv-btn-secondary:hover { border-color: var(--gv-deep); color: var(--gv-deep); gap: 18px; }
.gv-btn-light { background: #fff; color: var(--gv-deep); }
.gv-btn-light:hover { background: #e8f1f4; color: var(--gv-deep); gap: 18px; }
/* 남색 띠 위 테두리 단추 */
.gv-btn-ghost { border: 1px solid rgba(255,255,255,.5); color: #fff; }
.gv-btn-ghost:hover { border-color: #fff; background: rgba(255,255,255,.08); color: #fff; gap: 18px; }
.gv-btn:focus-visible { outline: 2px solid var(--gv-deep); outline-offset: 3px; }
.gv-involve .gv-btn:focus-visible { outline-color: #fff; }
.gv-btn-kakao { background: #FEE500; color: #391b1b; justify-content: center; }
.gv-btn-kakao:hover { background: #f5dc00; color: #391b1b; }
.gv-kakao-in { display: inline-flex; align-items: center; gap: 10px; }
.give .gv-kakao-icon { width: 17px; height: 17px; fill: currentColor; stroke: none; }

/* ── 0. 바로가기 줄 — 머리 바로 아래 흰 띠, 세 칸 사이에 가는 선 ── */
.gv-jump { border-bottom: 1px solid var(--gv-line); background: #fff; }
.gv-jump-list { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--gv-line); }
.gv-jump-item { background: #fff; }
.gv-jump-item a {
  position: relative; display: flex; align-items: center; justify-content: space-between; gap: 12px;
  min-height: 76px; height: 100%; padding: 0 28px; box-sizing: border-box;
  color: var(--gv-navy); font-size: 16px; font-weight: 700; letter-spacing: -.01em; line-height: 1.35; text-decoration: none;
  transition: background-color .2s, color .2s;
}
.gv-jump-item:first-child a { padding-left: 0; }
.give .gv-jump-item svg { width: 16px; height: 16px; color: var(--gv-deep); transition: transform .25s; }
