<script>
/* ── Reveal 애니메이션 ── */
var obs = new IntersectionObserver(function(entries) {
  entries.forEach(function(e) {
    if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
  });
}, { threshold: 0.10, rootMargin: '0px 0px -30px 0px' });
document.querySelectorAll('.crp .reveal').forEach(function(el) { obs.observe(el); });

/* ── 언어 감지 헬퍼 ── */
function crpIsEn() {
  var el = document.getElementById('lang-root');
  return !!(
    (el && el.classList.contains('lang-en')) ||
    document.body.classList.contains('lang-en') ||
    document.documentElement.classList.contains('lang-en')
  );
}
function crpText(ko, en) {
  return crpIsEn() ? en : ko;
}
function crpShowError(el, ko, en) {
  if (!el) return;
  el.dataset.errKo = ko;
  el.dataset.errEn = en;
  el.textContent = crpText(ko, en);
  el.hidden = false;
}

/* ── 정원 바 업데이트 (성별 split) ── */
function updateCrpCapBar(el, data, totalCap) {
  var count  = typeof data.count  === 'number' ? data.count  : 0;
  var countM = typeof data.countMale   === 'number' ? data.countMale   : 0;
  var countF = typeof data.countFemale === 'number' ? data.countFemale : 0;

  // 성별 분리 정원 (hasSplit 캠프)
  var capM = parseInt(el.dataset.capacityMale)   || 0;
  var capF = parseInt(el.dataset.capacityFemale) || 0;

  var countEl  = el.querySelector('.crp-cap-count');
  var countMEl = el.querySelector('.crp-cap-count-m');
  var countFEl = el.querySelector('.crp-cap-count-f');
  var fillM    = el.querySelector('.crp-cap-fill-m');
  var fillF    = el.querySelector('.crp-cap-fill-f');

  if (countEl)  countEl.textContent  = count;
  if (countMEl) countMEl.textContent = countM;
  if (countFEl) countFEl.textContent = countF;
  if (fillM) fillM.style.width = '0%';
  if (fillF) fillF.style.width = '0%';

  if (capM > 0 && capF > 0) {
    // 성별 정원 분리 캠프: 각각의 정원 기준으로 바 계산
    if (fillM) fillM.style.width = Math.min((countM / capM) * 100, 100) + '%';
    if (fillF) fillF.style.width = Math.min((countF / capF) * 100, 100) + '%';
  } else if (totalCap > 0) {
    // 성별 정원 미분리 캠프: 전체 신청 현황을 단일 바로 표시
    if (fillM) fillM.style.width = Math.min((count / totalCap) * 100, 100) + '%';
  }
}

var WAITLIST_SIZE = 10;

async function loadCrpCapacities() {
  var cards = document.querySelectorAll('[data-cap-id]');
  await Promise.all(Array.from(cards).map(async function(el) {
    var campId = el.dataset.capId;
    var btn = document.querySelector('.crp-open-btn[data-camp-id="' + campId + '"]');
    var cap = btn ? parseInt(btn.dataset.capacity) || 40 : 40;
    try {
      var res = await fetch('/api/capacity/' + campId);
      var data = res.ok ? await res.json() : { count: 0, countMale: 0, countFemale: 0 };
      var subs = data.count ?? 0;
      var subsData = { count: subs, countMale: data.countMale ?? 0, countFemale: data.countFemale ?? 0 };
      updateCrpCapBar(el, subsData, cap);
      if (btn) {
        if (subs >= cap + WAITLIST_SIZE) {
          btn.disabled = true;
          btn.innerHTML = '<span class="wl-ko">마감</span><span class="wl-en">Closed</span>';
          btn.style.background = 'rgba(100,116,139,0.15)';
          btn.style.color = '#64748b';
          btn.style.cursor = 'default';
        } else if (subs >= cap) {
          btn.innerHTML = '<span class="wl-ko">예비 신청하기 →</span><span class="wl-en">Join Waitlist →</span>';
          btn.style.background = 'linear-gradient(135deg,#d97706 0%,#b45309 100%)';
          btn.dataset.isWaitlist = 'true';
        }
      }
    } catch(e) { updateCrpCapBar(el, { count: 0, countMale: 0, countFemale: 0 }, cap); }
  }));
}
function scheduleCrpCapacityLoad() {
  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(loadCrpCapacities, { timeout: 1500 });
  } else {
    window.setTimeout(loadCrpCapacities, 250);
  }
}
scheduleCrpCapacityLoad();

/* ── 모달 DOM 참조 ── */
var modal = document.getElementById('crpModal');
var modalTitle = document.getElementById('crpModalTitle');
var modalCapLabel = document.getElementById('crpModalCapLabel');
var modalCapFillM = document.getElementById('crpModalCapFillM');
var modalCapFillF = document.getElementById('crpModalCapFillF');
var campIdInput = document.getElementById('crpCampId');
var campCapInput = document.getElementById('crpCampCap');
var campDepositInput = document.getElementById('crpCampDeposit');
var campCapMaleInput, campCapFemaleInput; // set dynamically on open
var regTypeInput = document.getElementById('crpType');
var formWrap = document.getElementById('crpFormWrap');
var successWrap = document.getElementById('crpSuccessWrap');
var errorMsg = document.getElementById('crpErrorMsg');
var submitBtn = document.getElementById('crpSubmitBtn');
var sectionIndividual = document.getElementById('crpSectionIndividual');
var sectionGroup = document.getElementById('crpSectionGroup');
var tabIndividual = document.getElementById('crpTabIndividual');
var tabGroup = document.getElementById('crpTabGroup');
var groupParticipantsField = document.getElementById('crpGroupParticipantsField');
var groupReferralField = document.getElementById('crpGReferralField');
var CAMP_BASE_FEE = 499000;
var SCHOLARSHIP_DISCOUNTS = {
  wolbi_syme: {
    amount: 50000,
    ko: '월비 또는 SYME 졸업자 및 프로그램 참여자의 자녀 또는 추천·소개',
    en: 'Child or referral of a WOLBI or SYME graduate/program participant',
  },
  sibling: {
    amount: 50000,
    ko: '형제·자매 또는 친구 동반 참여',
    en: 'Sibling or friend attending together',
  },
  excellent_camper: {
    amount: 150000,
    ko: '지난 캠프 우수 캠퍼 선정자',
    en: 'Previous outstanding camper',
  },
};

function crpIsUnionCampId(campId) {
  return campId === '2026-inland-union';
}

function crpIsUnionCampMode() {
  return crpIsUnionCampId(campIdInput.value);
}

function setCrpUnionCampMode(enabled) {
  modal.classList.toggle('crp-modal--union-camp', enabled);
  if (groupParticipantsField) groupParticipantsField.hidden = enabled;
  if (groupReferralField) groupReferralField.hidden = !enabled;
  if (enabled) document.getElementById('crpGParticipants').innerHTML = '';
  document.querySelectorAll('[data-discount-option="excellent_camper"]').forEach(function(option) {
    option.hidden = enabled;
  });
  if (enabled) {
    document.querySelectorAll('[name="scholarshipDiscount"][value="excellent_camper"]').forEach(function(input) {
      input.checked = false;
    });
    document.querySelectorAll('select[name="scholarshipDiscountCount"][data-discount="excellent_camper"]').forEach(function(select) {
      select.value = '0';
    });
  }
}

function crpFormatWon(amount, english) {
  var safeAmount = Math.max(0, parseInt(amount, 10) || 0);
  return english ? 'KRW ' + safeAmount.toLocaleString('en-US') : safeAmount.toLocaleString('ko-KR') + '원';
}

function renderScholarshipYearOptions() {
  var select = document.getElementById('crpWolbiSymeYear');
  if (!select) return;
  var current = select.value;
  var en = crpIsEn();
  var startYear = 2026;
  var endYear = 2000;
  var options = ['<option value="">' + (en ? 'Select year' : '연도 선택') + '</option>'];
  for (var year = startYear; year >= endYear; year--) {
    options.push('<option value="' + year + '"' + (String(year) === current ? ' selected' : '') + '>' + year + '</option>');
  }
  select.innerHTML = options.join('');
}

function getSelectedScholarshipDiscounts() {
  return Array.from(document.querySelectorAll('input[name="scholarshipDiscount"]:checked'))
    .map(function(input) { return input.value; })
    .filter(function(value) { return SCHOLARSHIP_DISCOUNTS[value]; });
}

function getScholarshipCounts() {
  if (regTypeInput.value === 'group') {
    return Array.from(document.querySelectorAll('select[name="scholarshipDiscountCount"]')).reduce(function(acc, select) {
      var key = select.dataset.discount;
      if (crpIsUnionCampMode() && key === 'excellent_camper') return acc;
      var count = Math.max(0, parseInt(select.value, 10) || 0);
      if (key && SCHOLARSHIP_DISCOUNTS[key] && count > 0) acc[key] = count;
      return acc;
    }, {});
  }
  return getSelectedScholarshipDiscounts().reduce(function(acc, key) {
    acc[key] = 1;
    return acc;
  }, {});
}

function scholarshipDiscountAmount(counts) {
  return Object.keys(counts || {}).reduce(function(sum, key) {
    return sum + ((SCHOLARSHIP_DISCOUNTS[key]?.amount || 0) * (parseInt(counts[key], 10) || 0));
  }, 0);
}

function scholarshipDiscountActive(counts, key) {
  return (parseInt((counts || {})[key], 10) || 0) > 0;
}

function scholarshipDiscountSummaryHtml(counts, english) {
  var parts = Object.keys(counts || {}).filter(function(key) {
    return SCHOLARSHIP_DISCOUNTS[key] && (parseInt(counts[key], 10) || 0) > 0;
  });
  if (!parts.length) return english ? '*Scholarship, if selected' : '*장학금 선택 시 적용액';

  var total = scholarshipDiscountAmount(counts);
  var itemRows = parts.map(function(key) {
    var count = parseInt(counts[key], 10) || 0;
    var item = SCHOLARSHIP_DISCOUNTS[key];
    var label = item[english ? 'en' : 'ko'];
    var displayLabel = count > 1
      ? label + (english ? ' × ' + count : ' × ' + count + '명')
      : label;
    var amount = item.amount * count;
    return '<span class="crp-discount-line"><span>' + crpEscHtml(displayLabel) + '</span><strong>-' + crpFormatWon(amount, english) + '</strong></span>';
  }).join('');
  var totalLabel = english ? 'Total discount' : '할인 총 합계';
  var totalRow = parts.length > 1
    ? '<span class="crp-discount-line crp-discount-total"><span>' + totalLabel + '</span><strong>-' + crpFormatWon(total, english) + '</strong></span>'
    : '';
  return '<span class="crp-discount-breakdown">' + itemRows + totalRow + '</span>';
}

function crpPaymentNoticeHtml(balanceLabel, english) {
  if (english) {
    return '<strong class="crp-success-notice-title">Registration &amp; Payment Notice</strong>' +
      '<span class="crp-success-notice-list">' +
        '<span data-num="1"><em>If registrations exceed camp capacity, participation priority is determined by the order in which deposits are verified.</em></span>' +
        '<span data-num="2"><em>If you pay the full camp fee instead of a deposit, your camp participation will be confirmed immediately.</em></span>' +
        '<span data-num="3"><em>Please pay the remaining balance of <strong>' + balanceLabel + '</strong> within 7 days after the deposit is paid or by the day before camp begins. Registrations may be cancelled if the balance is not paid by the deadline.</em></span>' +
      '</span>';
  }
  return '<strong class="crp-success-notice-title">등록 및 납부 안내</strong>' +
    '<span class="crp-success-notice-list">' +
      '<span data-num="1"><em>캠프 정원이 초과될 경우, 예약금 입금이 확인된 순서에 따라 참여 우선순위가 정해집니다.</em></span>' +
      '<span data-num="2"><em>예약금 없이 캠프 참여비 전액을 바로 납부하시면 캠프 참여가 즉시 확정 등록됩니다.</em></span>' +
      '<span data-num="3"><em>예약금 납부 후 남은 금액 <strong>' + balanceLabel + '</strong>은 예약금 납부일로부터 7일 이내 또는 캠프 시작 전날까지 납부해 주세요. 기한 내 잔여 캠프 참여비가 납부되지 않을 경우 신청이 취소될 수 있습니다.</em></span>' +
    '</span>';
}

function scholarshipParticipantCount() {
  return regTypeInput.value === 'group'
    ? (parseInt(document.getElementById('crpGCount').value, 10) || 0)
    : 1;
}

function updateScholarshipCountOptions() {
  var maxCount = scholarshipParticipantCount();
  var en = crpIsEn();
  document.querySelectorAll('select[name="scholarshipDiscountCount"]').forEach(function(select) {
    var current = Math.min(parseInt(select.value, 10) || 0, maxCount);
    select.innerHTML = Array.from({ length: maxCount + 1 }, function(_, count) {
      var label = en ? count + ' ppl' : count + '명';
      return '<option value="' + count + '"' + (count === current ? ' selected' : '') + '>' + label + '</option>';
    }).join('');
  });
}

function updateScholarshipMode() {
  var isGroup = regTypeInput.value === 'group';
  var individualWrap = document.getElementById('crpScholarshipIndividual');
  var groupWrap = document.getElementById('crpScholarshipGroup');
  if (individualWrap) individualWrap.hidden = isGroup;
  if (groupWrap) groupWrap.hidden = !isGroup;
  updateScholarshipCountOptions();
}

function updateScholarshipDetails() {
  var counts = getScholarshipCounts();
  var wolbiActive = scholarshipDiscountActive(counts, 'wolbi_syme');
  var siblingActive = scholarshipDiscountActive(counts, 'sibling');
  var detailsWrap = document.getElementById('crpScholarshipDetails');
  var wolbiDetail = document.getElementById('crpWolbiSymeDetail');
  var siblingDetail = document.getElementById('crpSiblingDetail');
  if (detailsWrap) detailsWrap.hidden = !(wolbiActive || siblingActive);
  if (wolbiDetail) wolbiDetail.hidden = !wolbiActive;
  if (siblingDetail) siblingDetail.hidden = !siblingActive;
  if (!wolbiActive) {
    var wolbiYear = document.getElementById('crpWolbiSymeYear');
    var wolbiName = document.getElementById('crpWolbiSymeName');
    if (wolbiYear) wolbiYear.value = '';
    if (wolbiName) wolbiName.value = '';
  }
  if (!siblingActive) {
    var siblingName = document.getElementById('crpSiblingCamperName');
    var siblingCamp = document.getElementById('crpSiblingCamp');
    if (siblingName) siblingName.value = '';
    if (siblingCamp) siblingCamp.value = '';
  }
}

function getScholarshipDiscountDetails() {
  return {
    wolbi_syme: {
      year: document.getElementById('crpWolbiSymeYear')?.value || '',
      participantName: document.getElementById('crpWolbiSymeName')?.value.trim() || '',
    },
    sibling: {
      camperName: document.getElementById('crpSiblingCamperName')?.value.trim() || '',
      camp: document.getElementById('crpSiblingCamp')?.value || '',
    },
  };
}

function crpFocusScholarshipField(id) {
  var field = document.getElementById(id);
  if (!field) return;
  field.scrollIntoView({ block: 'center', behavior: 'smooth' });
  field.focus();
}

function validateScholarshipDiscountDetails(counts) {
  var details = getScholarshipDiscountDetails();
  if (scholarshipDiscountActive(counts, 'wolbi_syme')) {
    if (!details.wolbi_syme.year) {
      crpShowError(errorMsg, '월비 또는 SYME 참여 연도를 선택해 주세요.', 'Please select the WOLBI/SYME participation year.');
      crpFocusScholarshipField('crpWolbiSymeYear');
      return null;
    }
    if (!details.wolbi_syme.participantName) {
      crpShowError(errorMsg, '월비 또는 SYME 졸업자 및 프로그램 참여자 이름을 입력해 주세요.', 'Please enter the WOLBI/SYME graduate or participant name.');
      crpFocusScholarshipField('crpWolbiSymeName');
      return null;
    }
  }
  if (scholarshipDiscountActive(counts, 'sibling')) {
    if (!details.sibling.camp) {
      crpShowError(errorMsg, '형제·자매 또는 친구가 참여하는 캠프를 선택해 주세요.', 'Please select which camp the sibling or friend is attending.');
      crpFocusScholarshipField('crpSiblingCamp');
      return null;
    }
    if (!details.sibling.camperName) {
      crpShowError(errorMsg, '함께 참여하는 형제·자매 또는 친구 캠퍼 이름을 입력해 주세요.', 'Please enter the sibling or friend camper name.');
      crpFocusScholarshipField('crpSiblingCamperName');
      return null;
    }
  }
  return {
    wolbi_syme: scholarshipDiscountActive(counts, 'wolbi_syme') ? details.wolbi_syme : null,
    sibling: scholarshipDiscountActive(counts, 'sibling') ? details.sibling : null,
  };
}

function updateScholarshipSummary() {
  updateScholarshipCountOptions();
  var participantCount = scholarshipParticipantCount();
  var baseFee = CAMP_BASE_FEE * participantCount;
  var deposit = (parseInt(campDepositInput.value, 10) || 0) * participantCount;
  var scholarshipCounts = getScholarshipCounts();
  var discount = scholarshipDiscountAmount(scholarshipCounts);
  var finalFee = Math.max(0, baseFee - discount);
  var isEn = crpIsEn();
  var baseEl = document.getElementById('crpBaseFeePreview');
  var discountLabelEl = document.getElementById('crpDiscountPreviewLabel');
  var discountEl = document.getElementById('crpDiscountPreview');
  var discountRowEl = document.getElementById('crpDiscountPreviewRow');
  var finalEl = document.getElementById('crpFinalFeePreview');
  var balanceEl = document.getElementById('crpBalanceFeePreview');
  if (baseEl) baseEl.textContent = crpFormatWon(deposit, isEn);
  if (discountLabelEl) discountLabelEl.innerHTML = scholarshipDiscountSummaryHtml(scholarshipCounts, isEn);
  if (discountEl) discountEl.textContent = discount > 0 ? '-' + crpFormatWon(discount, isEn) : crpFormatWon(0, isEn);
  if (discountRowEl) discountRowEl.hidden = discount <= 0;
  if (finalEl) finalEl.textContent = crpFormatWon(finalFee, isEn);
  if (balanceEl) balanceEl.textContent = crpFormatWon(Math.max(0, finalFee - deposit), isEn);
  updateScholarshipDetails();
}

document.querySelectorAll('input[name="scholarshipDiscount"]').forEach(function(input) {
  input.addEventListener('change', updateScholarshipSummary);
});
document.querySelectorAll('select[name="scholarshipDiscountCount"]').forEach(function(select) {
  select.addEventListener('change', updateScholarshipSummary);
});

// 현재 모달의 성별 cap 값 (런타임)
var currentCapMale = 0;
var currentCapFemale = 0;
var currentRegisteredCount = null;
var modalCapacityRequestId = 0;
var currentModalCapData = null;
var currentModalCapacity = 0;

/* ── 모달 정원 바 (성별 split) ── */
function updateCrpModalCap(data, capacity) {
  currentModalCapData = data;
  currentModalCapacity = capacity;
  var rawCount = (typeof data === 'object') ? (data.count ?? 0) : data;
  var count  = parseInt(rawCount, 10);
  var countDisplay = rawCount === '…' ? '…' : (Number.isFinite(count) ? count : 0);
  if (!Number.isFinite(count)) count = 0;
  var countM = (typeof data === 'object') ? (parseInt(data.countMale, 10) || 0) : 0;
  var countF = (typeof data === 'object') ? (parseInt(data.countFemale, 10) || 0) : 0;

  modalCapLabel.textContent = countDisplay + ' / ' + capacity + (crpIsEn() ? ' spots' : '명');
  if (modalCapFillM) modalCapFillM.style.width = '0%';
  if (modalCapFillF) modalCapFillF.style.width = '0%';

  if (capacity <= 0) return;

  if (currentCapMale > 0 && currentCapFemale > 0) {
    if (modalCapFillM) modalCapFillM.style.width = Math.min((countM / capacity) * 100, 100) + '%';
    if (modalCapFillF) modalCapFillF.style.width = Math.min((countF / capacity) * 100, 100) + '%';
  } else {
    if (modalCapFillM) modalCapFillM.style.width = Math.min((count / capacity) * 100, 100) + '%';
  }
}

/* ── 탭 전환 ── */
function crpSwitchTab(type) {
  regTypeInput.value = type;
  if (type === 'individual') {
    tabIndividual.classList.add('active');
    tabGroup.classList.remove('active');
    sectionIndividual.hidden = false;
    sectionGroup.hidden = true;
  } else {
    tabGroup.classList.add('active');
    tabIndividual.classList.remove('active');
    sectionGroup.hidden = false;
    sectionIndividual.hidden = true;
  }
  updateScholarshipMode();
  updateScholarshipSummary();
  errorMsg.hidden = true;
}
tabIndividual.addEventListener('click', function() { crpSwitchTab('individual'); });
tabGroup.addEventListener('click', function() { crpSwitchTab('group'); });

/* ── 단체 참가 학생 입력칸 ── */
function renderGroupParticipants() {
  var count = parseInt(document.getElementById('crpGCount').value) || 0;
  var wrap = document.getElementById('crpGParticipants');
  if (crpIsUnionCampMode()) {
    wrap.innerHTML = '';
    return;
  }
  var previous = Array.from(wrap.querySelectorAll('.crp-group-participant')).map(function(row) {
    return {
      name: row.querySelector('.crp-g-participant-name')?.value || '',
      gender: row.querySelector('.crp-g-participant-gender')?.value || '',
    };
  });
  var namePlaceholder = crpText('학생 이름', 'Participant name');
  var genderPlaceholder = crpText('성별', 'Gender');
  var maleLabel = crpText('남', 'Male');
  var femaleLabel = crpText('여', 'Female');
  wrap.innerHTML = Array.from({ length: count }, function(_, index) {
    var participant = previous[index] || {};
    return '<div class="crp-group-participant">' +
      '<span class="crp-group-participant-num">' + (index + 1) + '</span>' +
      '<input class="crp-g-participant-name" type="text" value="' + crpEscAttr(participant.name) + '" placeholder="' + crpEscAttr(namePlaceholder) + '">' +
      '<select class="crp-g-participant-gender">' +
        '<option value="">' + genderPlaceholder + '</option>' +
        '<option value="male"' + (participant.gender === 'male' ? ' selected' : '') + '>' + maleLabel + '</option>' +
        '<option value="female"' + (participant.gender === 'female' ? ' selected' : '') + '>' + femaleLabel + '</option>' +
      '</select>' +
    '</div>';
  }).join('');
}
function crpEscAttr(value) {
  return String(value || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function crpEscHtml(value) {
  return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
document.getElementById('crpGCount').addEventListener('change', function() {
  renderGroupParticipants();
  updateScholarshipCountOptions();
  updateScholarshipSummary();
});

/* ── 모달 열기 ── */
document.querySelectorAll('.crp-open-btn').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    var campId   = this.dataset.campId;
    var nameKo   = this.dataset.campNameKo;
    var nameEn   = this.dataset.campNameEn;
    var capacity = parseInt(this.dataset.capacity) || 40;
    var requestId = ++modalCapacityRequestId;
    currentCapMale   = parseInt(this.dataset.capacityMale)   || 0;
    currentCapFemale = parseInt(this.dataset.capacityFemale) || 0;
    currentRegisteredCount = null;

    campIdInput.value = campId;
    campCapInput.value = capacity;
    campDepositInput.value = this.dataset.deposit || '0';
    modalTitle.textContent = crpIsEn() ? nameEn : nameKo;

    document.getElementById('crpForm').reset();
    var isUnionCamp = crpIsUnionCampId(campId);
    setCrpUnionCampMode(isUnionCamp);
    updateScholarshipSummary();
    // 단체 학생 명단 초기화
    renderGroupParticipants();

    crpSwitchTab(isUnionCamp ? 'group' : 'individual');
    formWrap.hidden = false;
    successWrap.hidden = true;
    errorMsg.hidden = true;
    submitBtn.disabled = false;
    submitBtn.classList.remove('loading');
    submitBtn.querySelector('.crp-submit-label').innerHTML =
      '<span class="wl-ko">신청 완료하기</span><span class="wl-en">Submit Registration</span>';
    var waitlistNotice = document.getElementById('crpWaitlistNotice');
    if (waitlistNotice) waitlistNotice.hidden = true;
    updateCrpModalCap({ count: '…', countMale: 0, countFemale: 0 }, capacity);

    modal.hidden = false;
    document.body.style.overflow = 'hidden';

    try {
      var res = await fetch('/api/capacity/' + campId);
      if (res.ok) {
        var data = await res.json();
        if (requestId !== modalCapacityRequestId || modal.hidden) return;
        var subs = data.count ?? 0;
        currentRegisteredCount = data.submissions ?? subs;
        updateCrpModalCap({ count: subs, countMale: data.countMale ?? 0, countFemale: data.countFemale ?? 0 }, capacity);
        if (subs >= capacity + WAITLIST_SIZE) {
          submitBtn.disabled = true;
          submitBtn.querySelector('.crp-submit-label').innerHTML =
            '<span class="wl-ko">신청이 마감되었습니다</span><span class="wl-en">Registration Closed</span>';
          if (waitlistNotice) waitlistNotice.hidden = true;
        } else if (subs >= capacity) {
          if (waitlistNotice) {
            waitlistNotice.querySelector('.crp-waitlist-num').textContent = subs - capacity + 1;
            waitlistNotice.hidden = false;
          }
          submitBtn.querySelector('.crp-submit-label').innerHTML =
            '<span class="wl-ko">예비 신청하기 →</span><span class="wl-en">Join Waitlist →</span>';
        } else {
          if (waitlistNotice) waitlistNotice.hidden = true;
        }
      }
    } catch(e) {
      if (requestId === modalCapacityRequestId && !modal.hidden) {
        updateCrpModalCap({ count: 0, countMale: 0, countFemale: 0 }, capacity);
      }
    }
  });
});

/* ── 모달 닫기 ── */
function closeCrpModal() {
  modalCapacityRequestId++;
  modal.hidden = true;
  document.body.style.overflow = '';
}
document.getElementById('crpOverlay').addEventListener('click', closeCrpModal);
document.getElementById('crpCloseBtn').addEventListener('click', closeCrpModal);
document.getElementById('crpSuccessClose').addEventListener('click', closeCrpModal);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeCrpModal(); });

/* ── 환불 규정 모달 ── */
var refundOverlay  = document.getElementById('crpRefundModalOverlay');
var refundAgreeBtn = document.getElementById('crpRefundAgreeBtn');
var refundCheckbox = document.getElementById('crpRefundConsent');

// 체크박스 / 라벨 클릭 → 모달 열기
document.getElementById('crpRefundConsentLabel').addEventListener('click', function(e) {
  e.preventDefault();
  if (refundCheckbox.checked) {
    refundCheckbox.checked = false;
    return;
  }
  refundOverlay.hidden = false;
});

function closeRefundModal() {
  refundOverlay.hidden = true;
}

refundAgreeBtn.addEventListener('click', function() {
  refundCheckbox.checked = true;
  closeRefundModal();
});

document.getElementById('crpRefundCloseBtn').addEventListener('click', closeRefundModal);
refundOverlay.addEventListener('click', function(e) {
  if (e.target === refundOverlay) closeRefundModal();
});

/* ── 폼 제출 ── */
document.getElementById('crpForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  errorMsg.hidden = true;

  var consent = document.getElementById('crpConsent').checked;
  if (!consent) {
    crpShowError(errorMsg, '개인정보 수집 및 이용에 동의해 주세요.', 'Please agree to the privacy policy.');
    return;
  }
  var depositConsent = document.getElementById('crpDepositConsent').checked;
  if (!depositConsent) {
    crpShowError(errorMsg, '예약금과 캠프 참가비 입금 확인 후 최종 확정됨에 동의해 주세요.', 'Please confirm that you understand the deposit and camp fee requirements.');
    return;
  }
  var refundConsent = document.getElementById('crpRefundConsent').checked;
  if (!refundConsent) {
    crpShowError(errorMsg, '환불 규정을 읽어보았으며 이에 동의해 주세요.', 'Please read and agree to the refund policy.');
    return;
  }

  var refundBank = document.getElementById('crpRefundBank').value.trim();
  var refundAccount = document.getElementById('crpRefundAccount').value.trim();
  var refundHolder = document.getElementById('crpRefundHolder').value.trim();
  if (!refundBank || !refundAccount || !refundHolder) {
    crpShowError(errorMsg, '환불을 위한 은행명, 계좌번호, 예금주를 모두 입력해 주세요.', 'Please enter the bank name, refund account number, and account holder.');
    return;
  }

  var currentType = regTypeInput.value;
  var payload;

  if (currentType === 'group') {
    var gName      = document.getElementById('crpGName').value.trim();
    var gPhone     = document.getElementById('crpGPhone').value.trim();
    var gEmail     = document.getElementById('crpGEmail').value.trim();
    var gTotal     = parseInt(document.getElementById('crpGCount').value) || 0;
    var gOrg       = document.getElementById('crpGOrg').value.trim();
    var isUnionCamp = crpIsUnionCampMode();
    var participants = isUnionCamp ? [] : Array.from(document.querySelectorAll('.crp-group-participant')).map(function(row) {
      return {
        name: row.querySelector('.crp-g-participant-name').value.trim(),
        gender: row.querySelector('.crp-g-participant-gender').value,
      };
    });
    var gMaleCount = isUnionCamp ? 0 : participants.filter(function(p) { return p.gender === 'male'; }).length;
    var gFemCount  = isUnionCamp ? 0 : participants.filter(function(p) { return p.gender === 'female'; }).length;

    if (!gName || !gPhone || !gEmail || !gOrg) {
      crpShowError(errorMsg, '담당자 이름, 연락처, 이메일, 소속은 필수 항목입니다.', 'Contact name, phone, email, and organization are required.');
      return;
    }
    if (gTotal < 2) {
      crpShowError(errorMsg, '참여 인원을 2명 이상 선택해 주세요.', 'Please select at least 2 participants.');
      return;
    }
    var gRemaining = Math.max(0, (parseInt(campCapInput.value) || 40) - (currentRegisteredCount || 0));
    if (currentRegisteredCount !== null && gTotal > gRemaining) {
      crpShowError(errorMsg, '현재 잔여 정원은 ' + gRemaining + '명입니다. 참여 인원을 줄여 주세요.', 'Only ' + gRemaining + ' spots remain. Please reduce the number of participants.');
      return;
    }
    if (!isUnionCamp && (participants.length !== gTotal || participants.some(function(p) { return !p.name || !p.gender; }))) {
      crpShowError(errorMsg, '모든 참가 학생의 이름과 성별을 입력해 주세요.', 'Please enter every participant name and gender.');
      return;
    }
    var groupScholarshipCounts = getScholarshipCounts();
    var groupScholarshipDetails = validateScholarshipDiscountDetails(groupScholarshipCounts);
    if (!groupScholarshipDetails) return;
    var groupScholarshipDiscountTotal = scholarshipDiscountAmount(groupScholarshipCounts);
    payload = {
      registrationType: 'group',
      campId: campIdInput.value,
      capacity: parseInt(campCapInput.value) || 40,
      capacityMale: currentCapMale || undefined,
      capacityFemale: currentCapFemale || undefined,
      name: gName, phone: gPhone, email: gEmail,
      maleCount: gMaleCount, femaleCount: gFemCount,
      groupCount: gTotal,
      participants: participants,
      participantDetailsDeferred: isUnionCamp,
      refundBank: refundBank,
      refundAccount: refundAccount,
      refundHolder: refundHolder,
      referralSource: isUnionCamp ? document.getElementById('crpGReferralSource').value.trim() : '',
      scholarshipDiscounts: groupScholarshipCounts,
      scholarshipDiscountDetails: groupScholarshipDetails,
      scholarshipDiscountTotal: groupScholarshipDiscountTotal,
      campFeeBase: CAMP_BASE_FEE * gTotal,
      campFeeFinal: Math.max(0, (CAMP_BASE_FEE * gTotal) - groupScholarshipDiscountTotal),
      church: gOrg,
      notes: document.getElementById('crpGNotes').value.trim(),
    };
  } else {
    var name   = document.getElementById('crpName').value.trim();
    var phone  = document.getElementById('crpPhone').value.trim();
    var email  = document.getElementById('crpEmail').value.trim();
    var grade  = document.getElementById('crpGrade').value;
    var gender = document.getElementById('crpGender').value;

    if (!name || !phone || !email || !grade) {
      crpShowError(errorMsg, '이름, 연락처, 이메일, 학년은 필수 항목입니다.', 'Name, phone, email, and grade are required.');
      return;
    }
    if (!gender) {
      crpShowError(errorMsg, '성별을 선택해 주세요.', 'Please select gender.');
      return;
    }
    var scholarshipDiscounts = getScholarshipCounts();
    var scholarshipDiscountDetails = validateScholarshipDiscountDetails(scholarshipDiscounts);
    if (!scholarshipDiscountDetails) return;
    var scholarshipDiscountTotal = scholarshipDiscountAmount(scholarshipDiscounts);
    payload = {
      registrationType: 'individual',
      campId: campIdInput.value,
      capacity: parseInt(campCapInput.value) || 40,
      capacityMale: currentCapMale || undefined,
      capacityFemale: currentCapFemale || undefined,
      name, phone, email, grade, gender,
      church: document.getElementById('crpChurch').value.trim(),
      school: document.getElementById('crpSchool').value.trim(),
      emergency: document.getElementById('crpEmergency').value.trim(),
      refundBank: refundBank,
      refundAccount: refundAccount,
      refundHolder: refundHolder,
      scholarshipDiscounts: scholarshipDiscounts,
      scholarshipDiscountDetails: scholarshipDiscountDetails,
      scholarshipDiscountTotal: scholarshipDiscountTotal,
      campFeeBase: CAMP_BASE_FEE,
      campFeeFinal: Math.max(0, CAMP_BASE_FEE - scholarshipDiscountTotal),
      notes: document.getElementById('crpNotes').value.trim(),
    };
  }

  submitBtn.disabled = true;
  submitBtn.classList.add('loading');

  try {
    var res = await fetch('/api/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    var data = await res.json();

    if (res.ok && data.success) {
      formWrap.hidden = true;
      successWrap.hidden = false;

      var successMsg = document.getElementById('crpSuccessMsg');
      var successCount = document.getElementById('crpSuccessCount');
      var isEn = crpIsEn();
      var paymentBalance = 0;
      var paymentBalanceLabel = isEn ? 'KRW 0' : '0원';

      // 예약금 금액 표시 (단체는 인원 × 1인 예약금)
      var depositAmt = parseInt(campDepositInput.value) || 0;
      var groupCnt = currentType === 'group' ? (payload.groupCount || 1) : 1;
      var totalDeposit = depositAmt * groupCnt;
      var depositEl = document.getElementById('crpDepositAmount');
      var breakdownEl = document.getElementById('crpDepositBreakdown');
      if (depositEl) {
        depositEl.textContent = totalDeposit > 0
          ? (isEn ? 'KRW ' + totalDeposit.toLocaleString('en-US') : totalDeposit.toLocaleString('ko-KR') + '원')
          : '—';
      }
      if (breakdownEl) {
        breakdownEl.textContent = (currentType === 'group' && groupCnt > 1 && depositAmt > 0)
          ? (isEn
              ? '(KRW ' + depositAmt.toLocaleString('en-US') + ' × ' + groupCnt + ' ppl)'
              : '(' + depositAmt.toLocaleString('ko-KR') + '원 × ' + groupCnt + '명)')
          : '';
      }
      var feeSummaryEl = document.getElementById('crpSuccessFeeSummary');
      if (feeSummaryEl) {
        var baseFee = payload.campFeeBase || (CAMP_BASE_FEE * groupCnt);
        var discountTotal = payload.scholarshipDiscountTotal || 0;
        var finalFee = payload.campFeeFinal ?? Math.max(0, baseFee - discountTotal);
        paymentBalance = Math.max(0, finalFee - totalDeposit);
        paymentBalanceLabel = crpFormatWon(paymentBalance, isEn);
        document.getElementById('crpSuccessBaseFee').textContent = crpFormatWon(totalDeposit, isEn);
        document.getElementById('crpSuccessDiscountLabel').innerHTML = scholarshipDiscountSummaryHtml(payload.scholarshipDiscounts || {}, isEn);
        document.getElementById('crpSuccessDiscount').textContent = discountTotal > 0 ? '-' + crpFormatWon(discountTotal, isEn) : crpFormatWon(0, isEn);
        document.getElementById('crpSuccessDiscountRow').hidden = discountTotal <= 0;
        document.getElementById('crpSuccessFinalFee').textContent = crpFormatWon(finalFee, isEn);
        document.getElementById('crpSuccessBalanceFee').textContent = paymentBalanceLabel;
        feeSummaryEl.hidden = false;
      }

      var paymentNoticeKo = crpPaymentNoticeHtml(paymentBalanceLabel, false);
      var paymentNoticeEn = crpPaymentNoticeHtml(paymentBalanceLabel, true);

      if (currentType === 'group') {
        var gm = payload.maleCount, gf = payload.femaleCount, gc = payload.groupCount;
        successMsg.innerHTML = payload.participantDetailsDeferred
          ? (isEn
              ? 'Your union camp registration for <strong>' + gc + ' participants</strong> has been received.<br>Please transfer the deposit below.'
              : '<strong>총 ' + gc + '명</strong>의 연합캠프 신청이 접수되었습니다.<br>아래 계좌로 예약금을 입금해 주세요.')
          : (isEn
              ? 'Your group registration for <strong>' + gc + ' participants</strong> (Male ' + gm + ' / Female ' + gf + ') has been received.<br>Please transfer the deposit below.'
              : '<strong>남학생 ' + gm + '명 · 여학생 ' + gf + '명 (총 ' + gc + '명)</strong>의 단체 신청이 접수되었습니다.<br>아래 계좌로 예약금을 입금해 주세요.');
        successCount.innerHTML = isEn ? paymentNoticeEn : paymentNoticeKo;
        // 단체: 입금자명을 담당자 성함으로 안내
        var bankNoteKo = document.getElementById('crpBankNoteKo');
        var bankNoteEn = document.getElementById('crpBankNoteEn');
        if (bankNoteKo) bankNoteKo.innerHTML = '입금자명을 <strong>담당자 성함 (' + payload.name + ')</strong>으로 해주세요.<br>입금 확인 후 담당자가 최종 확정 처리합니다.';
        if (bankNoteEn) bankNoteEn.innerHTML = 'Please use the <strong>contact person\'s name (' + payload.name + ')</strong> as the transfer memo.<br>Registration will be finalized after payment is verified.';
      } else {
        var genderLabel = payload.gender === 'male'
          ? (isEn ? 'Male' : '남학생')
          : (isEn ? 'Female' : '여학생');
        var camperName = payload.name || '';
        successMsg.innerHTML = isEn
          ? '<strong>' + camperName + '</strong> (' + genderLabel + ') registration has been received.<br>Please transfer the deposit below to complete your registration.'
          : '캠퍼 <strong>' + camperName + '</strong> (' + genderLabel + ') 신청이 접수되었습니다.<br>아래 계좌로 예약금을 입금해 주세요.';
        successCount.innerHTML = isEn ? paymentNoticeEn : paymentNoticeKo;
        // 개인: 입금자명을 캠퍼 이름으로 안내 (기본값 복원)
        var bankNoteKo2 = document.getElementById('crpBankNoteKo');
        var bankNoteEn2 = document.getElementById('crpBankNoteEn');
        if (bankNoteKo2) bankNoteKo2.innerHTML = '입금자명을 <strong>캠퍼 이름 (' + payload.name + ')</strong>으로 해주세요.<br>입금 확인 후 담당자가 최종 확정 처리합니다.';
        if (bankNoteEn2) bankNoteEn2.innerHTML = 'Please use the <strong>camper\'s name (' + payload.name + ')</strong> as the transfer memo.<br>Registration will be finalized after payment is verified.';
      }

      // pending 상태이므로 카드 카운터는 업데이트하지 않음 (확정 후 반영)

    } else {
      crpShowError(errorMsg, data.error || '오류가 발생했습니다. 다시 시도해 주세요.', 'An error occurred. Please try again.');
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
    }
  } catch(err) {
    crpShowError(errorMsg, '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.', 'Network error. Please try again.');
    submitBtn.disabled = false;
    submitBtn.classList.remove('loading');
  }
});

/* ── 카운트다운 타이머 ── */
function pad(n) { return String(n).padStart(2, '0'); }

document.querySelectorAll('.crp-countdown[data-open-date]').forEach(function(cd) {
  var openDate = new Date(cd.dataset.openDate).getTime();
  var daysEl  = cd.querySelector('.crp-cd-days');
  var hoursEl = cd.querySelector('.crp-cd-hours');
  var minsEl  = cd.querySelector('.crp-cd-mins');
  var secsEl  = cd.querySelector('.crp-cd-secs');
  var timerEl = cd.querySelector('.crp-countdown-timer');
  var labelEl = cd.querySelector('.crp-countdown-label');

  function reveal() {
    // 카운트다운 숨기고 신청 버튼 표시
    if (timerEl) timerEl.hidden = true;
    if (labelEl) labelEl.hidden = true;
    var revealBtn = cd.querySelector('[hidden].crp-open-btn, [hidden].crp-countdown-reveal-btn');
    if (revealBtn) revealBtn.hidden = false;
    // 상태 배지도 "신청 중"으로
    var card = cd.closest('.crp-reg-card');
    if (card) {
      var badge = card.querySelector('.crp-status-badge');
      if (badge) {
        badge.className = 'crp-status-badge crp-status-open';
        badge.innerHTML = '<span class="wl-ko">신청 중</span><span class="wl-en">Open</span>';
      }
      // 정원 바 활성화: upcoming → open 전환 시 실시간 신청 현황 표시
      var capDiv = card.querySelector('.crp-cap');
      if (capDiv && revealBtn && revealBtn.dataset.campId) {
        var cid = revealBtn.dataset.campId;
        var cap = parseInt(revealBtn.dataset.capacity) || 40;
        capDiv.setAttribute('data-cap-id', cid);
        capDiv.classList.remove('crp-cap--gray');
        var capInfo = capDiv.querySelector('.crp-cap-info');
        if (capInfo) {
          var capSpan = capInfo.querySelector('span');
          if (capSpan) capSpan.innerHTML = '<span class="wl-ko">신청 현황</span><span class="wl-en">Spots Filled</span>';
          var capStrong = capInfo.querySelector('strong');
          if (capStrong) capStrong.innerHTML = '<span class="crp-cap-count">—</span> / ' + cap + '<span class="wl-ko">명</span>';
        }
        fetch('/api/capacity/' + cid).then(function(r) { return r.ok ? r.json() : null; }).then(function(data) {
          if (!data) return;
          updateCrpCapBar(capDiv, {
            count: data.count || 0,
            countMale: data.countMale || 0,
            countFemale: data.countFemale || 0
          }, cap);
        }).catch(function() {});
      }
    }
  }

  function tick() {
    var diff = openDate - Date.now();
    if (diff <= 0) { reveal(); return; }
    var d = Math.floor(diff / 86400000);
    var h = Math.floor((diff % 86400000) / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    if (daysEl)  daysEl.textContent  = pad(d);
    if (hoursEl) hoursEl.textContent = pad(h);
    if (minsEl)  minsEl.textContent  = pad(m);
    if (secsEl)  secsEl.textContent  = pad(s);
  }

  tick(); // 즉시 첫 렌더
  var interval = setInterval(function() {
    if (openDate - Date.now() <= 0) {
      clearInterval(interval);
      reveal();
    } else {
      tick();
    }
  }, 1000);
});

/* ══ STAFF MODAL ══ */
(function() {
  var staffModal      = document.getElementById('staffModal');
  var staffModalTitle = document.getElementById('staffModalTitle');
  var staffFormWrap   = document.getElementById('staffFormWrap');
  var staffSuccessWrap= document.getElementById('staffSuccessWrap');
  var staffErrorMsg   = document.getElementById('staffErrorMsg');
  var staffSubmitBtn  = document.getElementById('staffSubmitBtn');
  var staffCampIdInput= document.getElementById('staffCampId');

  function populateStaffBirthSelects() {
    var yearEl = document.getElementById('staffBirthYear');
    var monthEl = document.getElementById('staffBirthMonth');
    var dayEl = document.getElementById('staffBirthDay');
    if (!yearEl || yearEl.dataset.ready) return;

    var currentYear = new Date().getFullYear();
    for (var year = currentYear; year >= 1940; year--) {
      yearEl.insertAdjacentHTML('beforeend', '<option value="' + year + '">' + year + '</option>');
    }
    for (var month = 1; month <= 12; month++) {
      var mm = String(month).padStart(2, '0');
      monthEl.insertAdjacentHTML('beforeend', '<option value="' + mm + '">' + mm + '</option>');
    }
    for (var day = 1; day <= 31; day++) {
      var dd = String(day).padStart(2, '0');
      dayEl.insertAdjacentHTML('beforeend', '<option value="' + dd + '">' + dd + '</option>');
    }
    yearEl.dataset.ready = 'true';
  }

  populateStaffBirthSelects();

  // 스태프 카드 start_date 체크 → 버튼/상태 업데이트
  document.querySelectorAll('.crp-staff-card').forEach(function(card) {
    var startDate = card.dataset.startDate;
    var btn  = card.querySelector('.crp-staff-open-btn');
    var stat = card.querySelector('.crp-staff-status');
    if (startDate && new Date() >= new Date(startDate)) {
      if (btn)  { btn.disabled = true; }
      if (stat) {
        stat.className = 'crp-staff-status crp-staff-status-closed';
        stat.innerHTML = '<span class="wl-ko">마감</span><span class="wl-en">Closed</span>';
      }
    }
  });

  // 모달 열기
  document.querySelectorAll('.crp-staff-open-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (btn.disabled) return;
      staffCampIdInput.value = btn.dataset.campId || '';
      document.getElementById('staffCampNameKo').value = btn.dataset.campNameKo || '';
      staffModalTitle.textContent = crpIsEn()
        ? (btn.dataset.campNameEn || '')
        : (btn.dataset.campNameKo || '');
      document.getElementById('staffForm').reset();
      staffFormWrap.hidden  = false;
      staffSuccessWrap.hidden = true;
      staffErrorMsg.hidden  = true;
      staffSubmitBtn.disabled = false;
      staffSubmitBtn.classList.remove('loading');
      staffModal.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  // 모달 닫기
  function closeStaffModal() {
    staffModal.hidden = true;
    document.body.style.overflow = '';
  }
  document.getElementById('staffOverlay').addEventListener('click', closeStaffModal);
  document.getElementById('staffCloseBtn').addEventListener('click', closeStaffModal);
  document.getElementById('staffSuccessClose').addEventListener('click', closeStaffModal);
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !staffModal.hidden) closeStaffModal();
  });

  // 폼 제출
  document.getElementById('staffForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    staffErrorMsg.hidden = true;

    var name        = document.getElementById('staffName').value.trim();
    var phone       = document.getElementById('staffPhone').value.trim();
    var email       = document.getElementById('staffEmail').value.trim();
    var gender      = document.getElementById('staffGender').value;
    var birthYear   = document.getElementById('staffBirthYear').value;
    var birthMonth  = document.getElementById('staffBirthMonth').value;
    var birthDay    = document.getElementById('staffBirthDay').value;
    var birthDate   = birthYear && birthMonth && birthDay ? birthYear + '-' + birthMonth + '-' + birthDay : '';
    var church      = document.getElementById('staffChurch').value.trim();
    var previousCamp = document.getElementById('staffPreviousCamp').value;
    var serviceArea = Array.from(document.querySelectorAll('input[name="staffTeam"]:checked')).map(function(el){ return el.value; }).join(', ');
    var notes       = document.getElementById('staffNotes').value.trim();
    var testimony   = document.getElementById('staffTestimony').value.trim();
    var privacy     = document.getElementById('staffPrivacyConsent').checked;
    var campId      = staffCampIdInput.value;

    if (!name || !phone || !email) {
      crpShowError(staffErrorMsg, '이름, 연락처, 이메일은 필수 항목입니다.', 'Name, phone, and email are required.');
      return;
    }
    if (!gender) {
      crpShowError(staffErrorMsg, '성별을 선택해 주세요.', 'Please select your gender.');
      return;
    }
    if (!birthDate) {
      crpShowError(staffErrorMsg, '생년월일을 선택해 주세요.', 'Please select your date of birth.');
      return;
    }
    if (!previousCamp) {
      crpShowError(staffErrorMsg, '이전 캠프 참여 경험을 선택해 주세요.', 'Please select whether you have previous camp experience.');
      return;
    }
    if (!serviceArea) {
      crpShowError(staffErrorMsg, '섬기고 싶은 팀을 하나 이상 선택해 주세요.', 'Please select at least one team.');
      return;
    }
    if (!testimony) {
      crpShowError(staffErrorMsg, '간단한 자기소개 및 간증을 입력해 주세요.', 'Please enter a brief introduction and testimony.');
      return;
    }
    if (!privacy) {
      crpShowError(staffErrorMsg, '개인정보 수집 및 이용에 동의해 주세요.', 'Please consent to the privacy policy.');
      return;
    }

    staffSubmitBtn.disabled = true;
    staffSubmitBtn.classList.add('loading');

    try {
      var res = await fetch('/api/staff-register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ campId, name, phone, email, gender, birthDate, church, previousCamp, serviceArea, notes, testimony, campTitleKo: document.getElementById('staffCampNameKo').value }),
      });
      var data = await res.json();

      if (res.ok && data.success) {
        staffFormWrap.hidden   = true;
        staffSuccessWrap.hidden = false;
        var isEn = crpIsEn();
        document.getElementById('staffSuccessMsg').innerHTML = isEn
          ? '<strong>' + name + '</strong>, your staff application has been received.<br>Our team will contact you individually regarding your service area.'
          : '<strong>' + name + '</strong>님의 스태프 지원이 접수되었습니다.<br>섬기실 분야에 대해 담당자가 개별적으로 연락드릴 예정입니다.';
      } else {
        crpShowError(staffErrorMsg, data.error || '오류가 발생했습니다. 다시 시도해 주세요.', 'An error occurred. Please try again.');
        staffSubmitBtn.disabled = false;
        staffSubmitBtn.classList.remove('loading');
      }
    } catch(err) {
      crpShowError(staffErrorMsg, '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.', 'Network error. Please try again.');
      staffSubmitBtn.disabled = false;
      staffSubmitBtn.classList.remove('loading');
    }
  });
})();

/* ── Placeholder & select-option 언어 동기화 ── */
(function() {
  function syncLang() {
    var en = crpIsEn();
    renderScholarshipYearOptions();
    // input / textarea placeholder
    document.querySelectorAll('[data-ph-ko]').forEach(function(el) {
      el.placeholder = en ? (el.dataset.phEn || '') : (el.dataset.phKo || '');
    });
    // select 기본 옵션 텍스트
    document.querySelectorAll('select[data-opt-ko]').forEach(function(el) {
      if (el.options[0]) {
        el.options[0].textContent = en ? el.dataset.optEn : el.dataset.optKo;
      }
      Array.prototype.forEach.call(el.querySelectorAll('optgroup'), function(group) {
        if (group.dataset.ko && group.dataset.en) {
          group.label = en ? group.dataset.en : group.dataset.ko;
        }
      });
      Array.prototype.forEach.call(el.options, function(option) {
        if (option.dataset.ko && option.dataset.en) {
          option.textContent = en ? option.dataset.en : option.dataset.ko;
        }
      });
    });
    var participantWrap = document.getElementById('crpGParticipants');
    if (participantWrap && participantWrap.children.length) renderGroupParticipants();
    if (modal && !modal.hidden) {
      var campBtn = document.querySelector('.crp-open-btn[data-camp-id="' + campIdInput.value + '"]');
      if (campBtn) modalTitle.textContent = en ? (campBtn.dataset.campNameEn || '') : (campBtn.dataset.campNameKo || '');
      if (currentModalCapData) updateCrpModalCap(currentModalCapData, currentModalCapacity);
    }
    var staffModalEl = document.getElementById('staffModal');
    if (staffModalEl && !staffModalEl.hidden) {
      var staffCampId = document.getElementById('staffCampId')?.value || '';
      var staffBtn = document.querySelector('.crp-staff-open-btn[data-camp-id="' + staffCampId + '"]');
      var staffTitle = document.getElementById('staffModalTitle');
      if (staffBtn && staffTitle) staffTitle.textContent = en ? (staffBtn.dataset.campNameEn || '') : (staffBtn.dataset.campNameKo || '');
    }
    [errorMsg, document.getElementById('staffErrorMsg')].forEach(function(el) {
      if (el && !el.hidden && el.dataset.errKo && el.dataset.errEn) {
        el.textContent = en ? el.dataset.errEn : el.dataset.errKo;
      }
    });
    updateScholarshipSummary();
  }
  syncLang();
  var langRoot = document.getElementById('lang-root') || document.body || document.documentElement;
  if (langRoot) {
    new MutationObserver(syncLang).observe(langRoot, { attributes: true, attributeFilter: ['class'] });
  }
})();

