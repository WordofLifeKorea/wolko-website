---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allSchedules = await getCollection('camp_schedules');
const schedules = allSchedules
  .filter(s => s.data.status !== 'closed')
  .sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const jejuCamps   = schedules.filter(s => s.data.camp_type === 'jeju');
const inlandCamps = schedules.filter(s => s.data.camp_type !== 'jeju');

const typeLabel: Record<string, { ko: string; en: string }> = {
  english: { ko: '영어캠프', en: 'English Camp' },
  jeju:    { ko: '제주캠프', en: 'Jeju Camp' },
  union:   { ko: '연합캠프', en: 'Union Camp' },
};
const statusLabel: Record<string, { ko: string; en: string; cls: string }> = {
  open:     { ko: '신청 중',   en: 'Open',               cls: 'status-open' },
  closed:   { ko: '마감',      en: 'Closed',             cls: 'status-closed' },
  upcoming: { ko: '준비 중',   en: 'Upcoming',           cls: 'status-upcoming' },
  full:     { ko: '정원 마감', en: 'Full',               cls: 'status-full' },
};
---

<BaseLayout
  title="캠프 신청 — Word of Life Korea"
  description="월코 캠프 신청 페이지 — 영어캠프, 연합캠프 신청 접수"
  activeNav="connect"
  whiteNav={false}
>

<style is:global>
@import url('https://cdn.jsdelivr.net/npm/pretendard@latest/dist/web/variable/pretendardvariable-dynamic-subset.css');

/* 100vw 전폭 섹션으로 인한 모바일 가로 스크롤 방지 */
html, body { overflow-x: hidden; max-width: 100%; }

/* ══ CAMP REGISTER PAGE ══ */
.crp {
  --c-deep:   #004f68;
  --c-mid:    #007ea1;
  --c-light:  #73d1f5;
  --c-red:    #c42a36;
  --c-red-dk: #a82330;
  --c-white:  #ffffff;
  --c-off:    #f5fafd;
  --c-pale:   #eef7fb;
  --c-text:   #111820;
  --c-sub:    #334a56;
  --c-muted:  #6b8896;
  --c-border: rgba(0,79,104,0.12);
  --f-serif:  'GmarketSans', 'Pretendard Variable', Pretendard, sans-serif;
  --f-sans:   'Pretendard Variable', Pretendard, -apple-system, sans-serif;
  font-family: var(--f-sans);
  font-weight: 400;
  color: var(--c-text);
  background: var(--c-white);
  overflow-x: clip;
  -webkit-font-smoothing: antialiased;
  width: 100%;
}
.crp *, .crp *::before, .crp *::after { box-sizing: border-box; margin: 0; padding: 0; }
.crp a { text-decoration: none; color: inherit; }
.crp ul { list-style: none; }

/* ── REVEAL ── */
.crp .reveal { opacity: 0; transform: translateY(22px); transition: opacity .65s ease, transform .65s ease; }
.crp .reveal.visible { opacity: 1; transform: none; }
.crp .reveal-d1 { transition-delay: .10s; }
.crp .reveal-d2 { transition-delay: .20s; }

/* ── TYPOGRAPHY HELPERS ── */
.crp .section-label {
  display: inline-flex; align-items: center; gap: 14px;
  font-size: 11px; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--c-mid); margin-bottom: 14px;
}
.crp .section-label::before { content: ''; width: 14px; height: 2px; background: var(--c-red); flex-shrink: 0; }
.crp .section-title {
  font-family: var(--f-serif); font-size: clamp(28px, 4vw, 46px);
  font-weight: 700; color: var(--c-deep); line-height: 1.14;
  letter-spacing: -0.025em; word-break: keep-all;
}
.crp .section-desc {
  font-size: 16px; line-height: 1.9; color: var(--c-sub);
  max-width: 580px; word-break: keep-all; margin-top: 16px;
}

/* ── PAGE HERO ── */
.crp-hero {
  background: var(--c-deep);
  padding: 120px 48px 72px;
  margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw;
  position: relative; overflow: hidden;
}
.crp-hero::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(135deg, #003347 0%, #005f80 60%, #004f68 100%);
}
.crp-hero::after { display: none; }
.crp-hero-inner {
  position: relative; z-index: 1;
  max-width: 1100px; margin: 0 auto;
}
.crp-hero-badge {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 10px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--c-light); margin-bottom: 22px;
}
.crp-hero-badge::before { content:''; width:28px; height:1.5px; background: var(--c-light); flex-shrink:0; }
.crp-hero-title {
  font-family: 'GmarketSans', 'Pretendard Variable', sans-serif;
  font-size: clamp(36px, 5.8vw, 68px);
  font-weight: 800; color: #fff; line-height: 1.22;
  letter-spacing: -0.025em; margin-bottom: 20px; word-break: keep-all;
}
.crp-hero-title em { font-style: italic; color: var(--c-light); }
.crp-hero-sub {
  font-size: 16px; line-height: 1.85; color: rgba(255,255,255,0.82);
  max-width: 540px; word-break: keep-all; margin-bottom: 32px;
}
.crp-hero-back {
  display: inline-flex; align-items: center; gap: 8px;
  font-size: 12px; font-weight: 600; letter-spacing: 0.06em;
  color: rgba(255,255,255,0.88) !important;
  border: 1px solid rgba(255,255,255,0.40); border-radius: 100px;
  padding: 8px 18px; transition: all 0.22s;
}
.crp-hero-back:hover { color: #fff !important; border-color: rgba(255,255,255,0.7); background: rgba(255,255,255,0.10); }

/* ── REGISTRATION SECTION ── */
.crp-reg-section {
  background: var(--c-off);
  padding: 72px 48px 96px;
  margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw;
  border-top: 1px solid var(--c-border);
}
.crp-reg-header {
  max-width: 1100px; margin: 0 auto 56px;
  display: flex; align-items: flex-end; justify-content: space-between; gap: 32px;
}
.crp-reg-header-text {}
.crp-reg-header-note {
  font-size: 13px; line-height: 1.8; color: var(--c-muted);
  text-align: right; max-width: 280px; word-break: keep-all;
}

/* ── REG GRID ── */
.crp-reg-grid {
  width: min(100%, 1100px); margin: 0 auto;
  display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px;
  align-items: stretch; justify-content: center;
}
.crp-reg-card {
  background: var(--c-white);
  border: 1px solid var(--c-border);
  border-radius: 16px;
  padding: 32px 28px 36px;
  display: flex; flex-direction: column; gap: 0;
  position: relative; overflow: hidden;
  transition: transform .28s, box-shadow .28s, border-color .28s;
  flex: 1; min-width: 0;
}
.crp-reg-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 18px 48px rgba(0,79,104,0.12);
  border-color: rgba(0,79,104,0.20);
}
.crp-reg-card-top {
  display: flex; align-items: center; justify-content: space-between; margin-bottom: 18px;
}
.crp-type-badge {
  font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
  color: var(--c-mid); background: rgba(0,126,161,0.08);
  padding: 5px 12px; border-radius: 100px;
}
.crp-status-badge {
  font-size: 11px; font-weight: 700; letter-spacing: 0.05em;
  padding: 5px 13px; border-radius: 100px;
}
.crp-status-open     { background: rgba(22,163,74,0.10);  color: #15803d; }
.crp-status-upcoming { background: rgba(0,126,161,0.10);  color: var(--c-mid); }
.crp-status-full     { background: rgba(234,88,12,0.10);  color: #c2410c; }
.crp-status-closed   { background: rgba(100,116,139,0.10); color: #64748b; }

.crp-reg-title {
  font-family: var(--f-serif); font-size: 23px; font-weight: 700;
  color: var(--c-deep); line-height: 1.22; letter-spacing: -0.015em;
  margin-bottom: 20px;
}
.crp-reg-meta {
  display: flex; flex-direction: column; gap: 10px;
  margin-bottom: 20px; flex: 1;
}
.crp-reg-meta-row {
  display: grid; grid-template-columns: 72px 1fr; gap: 8px; align-items: baseline;
}
.crp-reg-meta-label {
  font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--c-muted);
}
.crp-reg-meta-value {
  font-size: 14px; font-weight: 500; color: var(--c-sub); line-height: 1.6; word-break: keep-all;
}
.crp-reg-notes {
  font-size: 13px; line-height: 1.8; color: var(--c-muted);
  padding-top: 14px; border-top: 1px solid var(--c-border);
  margin-bottom: 18px; word-break: keep-all;
}

/* ── CAPACITY BAR ── */
.crp-cap { margin-bottom: 16px; }
.crp-cap-info {
  display: flex; justify-content: space-between; align-items: baseline;
  font-size: 13px; font-weight: 500; color: var(--c-muted); margin-bottom: 8px;
}
.crp-cap-info strong { font-size: 14px; font-weight: 700; color: var(--c-deep); }
.crp-cap-track {
  height: 7px; background: rgba(0,79,104,0.08);
  border-radius: 999px; overflow: hidden;
  display: flex;
}
.crp-cap-fill-m {
  height: 100%; width: 0%; flex-shrink: 0;
  background: #3b82f6;
  transition: width 0.8s cubic-bezier(0.22,1,0.36,1);
}
.crp-cap-fill-f {
  height: 100%; width: 0%; flex-shrink: 0;
  background: #ec4899;
  transition: width 0.8s cubic-bezier(0.22,1,0.36,1);
}
/* 이전 단일 fill — 회색바용으로만 사용 */
.crp-cap-fill {
  height: 100%; border-radius: 999px; width: 0%;
  background: linear-gradient(90deg, var(--c-mid), var(--c-light));
  transition: width 0.8s cubic-bezier(0.22,1,0.36,1);
}
.crp-cap-fill.warn { background: linear-gradient(90deg, #f59e0b, #fbbf24); }
.crp-cap-fill.full { background: linear-gradient(90deg, var(--c-red), #e55); }

/* ── 성별 분리 이중 바 (hasSplit 캠프) ── */
.crp-cap-split { display: flex; flex-direction: column; gap: 8px; padding: 2px 0; }
.crp-cap-bar-row { display: flex; align-items: center; gap: 10px; }
.crp-cap-bar-label {
  font-size: 12px; font-weight: 600; flex-shrink: 0; width: 44px;
}
.crp-cap-bar-label--m { color: #3b82f6; }
.crp-cap-bar-label--f { color: #ec4899; }
.crp-cap-bar-row .crp-cap-track { flex: 1; height: 6px; }
.crp-cap-bar-count {
  font-size: 12px; font-weight: 700; flex-shrink: 0; min-width: 48px; text-align: right;
}
.crp-cap-bar-count--m { color: #3b82f6; }
.crp-cap-bar-count--f { color: #ec4899; }

/* 준비중 / 비활성 상태 — 회색 */
.crp-cap--gray .crp-cap-info { opacity: 0.68; }
.crp-cap--gray .crp-cap-info strong { font-size: 13px; color: var(--c-muted); }
.crp-cap--gray .crp-cap-track { background: rgba(0,79,104,0.06); }
.crp-cap--gray .crp-cap-fill-m,
.crp-cap--gray .crp-cap-fill-f,
.crp-cap--gray .crp-cap-fill { display: none; }
.crp-cap--gray .crp-cap-bar-label,
.crp-cap--gray .crp-cap-bar-count { opacity: 0.5; }

/* ── REG BUTTONS ── */
[hidden] { display: none !important; }
.crp-reg-btn {
  display: inline-flex; align-items: center; justify-content: center; gap: 8px;
  width: 100%; padding: 14px;
  font-size: 13px; font-weight: 700; letter-spacing: 0.04em; border-radius: 10px;
  margin-top: auto; transition: background .22s, transform .18s, box-shadow .22s;
  text-decoration: none; border: none; outline: none; cursor: pointer;
  font-family: var(--f-sans);
}
.crp-reg-btn-primary {
  background: var(--c-red); color: #fff;
  box-shadow: 0 3px 10px rgba(196,42,54,0.20);
}
.crp-reg-btn-primary span { color: #fff !important; }
.crp-reg-btn-primary:hover:not(:disabled) {
  background: var(--c-red-dk); transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(196,42,54,0.32);
}
.crp-reg-btn-outline {
  background: transparent; color: var(--c-mid);
  border: 1.5px solid var(--c-border);
}
.crp-reg-btn-outline:hover { border-color: var(--c-mid); background: rgba(0,126,161,0.05); }
.crp-reg-btn-disabled {
  background: rgba(100,116,139,0.08); color: #94a3b8;
  cursor: default; pointer-events: none;
}

/* ── COUNTDOWN ── */
.crp-countdown {
  display: flex; flex-direction: column; align-items: center; gap: 12px;
  padding: 18px 16px;
  background: transparent;
  border: 1px solid var(--c-border);
  border-radius: 10px;
  text-align: center;
  margin-top: 4px;
}
.crp-countdown-label {
  font-size: 10px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--c-muted);
}
.crp-countdown-timer {
  display: flex; gap: 6px; align-items: baseline;
  font-variant-numeric: tabular-nums;
}
.crp-cd-unit {
  display: flex; flex-direction: column; align-items: center; min-width: 34px;
  background: none; border-radius: 0; padding: 0;
}
.crp-cd-num {
  font-size: 18px; font-weight: 600; color: var(--c-deep); line-height: 1;
  font-family: inherit;
}
.crp-cd-label {
  font-size: 9px; color: var(--c-muted); font-weight: 500;
  letter-spacing: 0.04em; margin-top: 2px;
}
.crp-cd-sep {
  font-size: 14px; font-weight: 400; color: var(--c-border); margin: 0 1px;
  padding-bottom: 8px;
}
.crp-countdown-notice {
  font-size: 11px; color: var(--c-muted); line-height: 1.6;
  word-break: keep-all; text-align: center;
}

/* English copy runs longer, so keep the cards compact and let text wrap cleanly. */
#lang-root.lang-en .crp-reg-grid,
body.lang-en .crp-reg-grid {
  width: min(100%, 1100px);
}
#lang-root.lang-en .crp-reg-card,
body.lang-en .crp-reg-card {
  padding: 30px 26px 34px;
}
#lang-root.lang-en .crp-reg-title,
body.lang-en .crp-reg-title {
  font-size: clamp(21px, 1.7vw, 25px);
  line-height: 1.18;
}
#lang-root.lang-en .crp-reg-meta-row,
body.lang-en .crp-reg-meta-row {
  grid-template-columns: 64px minmax(0, 1fr);
  gap: 8px;
}
#lang-root.lang-en .crp-reg-meta-value,
#lang-root.lang-en .crp-reg-notes,
#lang-root.lang-en .crp-countdown-notice,
body.lang-en .crp-reg-meta-value,
body.lang-en .crp-reg-notes,
body.lang-en .crp-countdown-notice {
  word-break: normal;
  overflow-wrap: anywhere;
}

/* ── CAMP GROUP HEADER ── */
.crp-group { max-width: 1100px; margin: 0 auto; }
.crp-group + .crp-group { margin-top: 72px; }
.crp-group-header {
  display: flex; align-items: center; justify-content: space-between;
  gap: 24px; margin-bottom: 32px;
  padding-bottom: 14px;
  border-bottom: 2px solid var(--c-border);
}
.crp-group-tag {
  display: flex; align-items: center; gap: 10px;
  font-size: 12px; font-weight: 700; letter-spacing: 0.10em; text-transform: uppercase;
  color: var(--c-deep);
}
.crp-group-tag::before {
  content: ''; width: 3px; height: 18px;
  background: var(--c-red); border-radius: 2px; flex-shrink: 0;
}
.crp-group-cafe-link {
  font-size: 12px; font-weight: 600; color: var(--c-mid);
  letter-spacing: 0.04em; white-space: nowrap;
  transition: color 0.2s;
}
.crp-group-cafe-link:hover { color: var(--c-deep); }

/* ── EMPTY STATE ── */
.crp-reg-empty {
  max-width: 1100px; margin: 0 auto;
  background: var(--c-white); border: 1px dashed var(--c-border);
  border-radius: 16px; padding: 64px 32px; text-align: center;
}
.crp-reg-empty-icon { font-size: 36px; margin-bottom: 16px; opacity: 0.45; }
.crp-reg-empty-title { font-family: var(--f-serif); font-size: 20px; color: var(--c-deep); margin-bottom: 10px; }
.crp-reg-empty-desc { font-size: 14px; color: var(--c-muted); line-height: 1.75; }

/* ── CONTACT FOOTER BAR ── */
.crp-contact-bar {
  background: var(--c-deep);
  padding: 36px 48px;
  margin-left: calc(-50vw + 50%); margin-right: calc(-50vw + 50%); width: 100vw;
}
.crp-contact-bar-inner {
  max-width: 1100px; margin: 0 auto;
  display: flex; align-items: center; justify-content: space-between; gap: 32px;
  flex-wrap: wrap;
}
.crp-contact-label {
  font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
  color: rgba(255,255,255,0.6) !important; margin-bottom: 6px;
}
.crp-contact-info {
  font-size: 14px; color: rgba(255,255,255,0.88) !important; line-height: 1.7;
}
.crp-contact-info-line { display: block; }
.crp-contact-info strong { color: #fff !important; }
.crp-contact-divider { width: 1px; height: 44px; background: rgba(255,255,255,0.15); flex-shrink: 0; }
.crp-btn-contact {
  display: inline-flex; align-items: center; justify-content: center;
  padding: 14px 32px; background: #c42a36; color: #fff !important;
  border-radius: 10px; font-size: 14px; font-weight: 700; font-family: var(--f-sans);
  letter-spacing: 0.03em; white-space: nowrap;
  transition: background 0.22s, transform 0.18s;
}
.crp-btn-contact:hover { background: #a82330 !important; color: #fff !important; transform: translateY(-2px); }

/* ── STAFF CARD ── */
.crp-camp-pair { display: flex; flex-direction: column; gap: 10px; min-width: 0; width: 100%; }
.crp-staff-card {
  background: linear-gradient(135deg, #f0fdfa 0%, #f7fffe 100%);
  border: 1.5px dashed rgba(13,148,136,0.35);
  border-radius: 14px;
  padding: 14px 18px;
  display: flex; align-items: center; gap: 14px;
  transition: border-color .22s, box-shadow .22s;
}
.crp-staff-card:hover { border-color: rgba(13,148,136,0.55); box-shadow: 0 6px 24px rgba(13,148,136,0.10); }
.crp-staff-card-icon {
  width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
  background: rgba(13,148,136,0.12); color: #0d9488;
  display: flex; align-items: center; justify-content: center;
}
.crp-staff-card-icon svg { width: 17px; height: 17px; stroke: currentColor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
.crp-staff-card-body { flex: 1; min-width: 0; display: flex; align-items: center; gap: 14px; }
.crp-staff-card-info { flex: 1; min-width: 0; }
.crp-staff-card-tag {
  font-size: 9px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase;
  color: #0d9488; margin-bottom: 2px;
}
.crp-staff-card-camp {
  font-size: 13px; font-weight: 700; color: #0d2b26; line-height: 1.3;
  word-break: keep-all; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.crp-staff-status-open {
  display: inline-block; padding: 2px 8px; border-radius: 999px;
  background: rgba(22,163,74,0.12); color: #15803d; font-size: 10px; font-weight: 700;
  white-space: nowrap; flex-shrink: 0; margin-top: 4px;
}
.crp-staff-status-closed {
  display: inline-block; padding: 2px 8px; border-radius: 999px;
  background: rgba(100,116,139,0.12); color: #64748b; font-size: 10px; font-weight: 700;
  white-space: nowrap; flex-shrink: 0; margin-top: 4px;
}
.crp-staff-open-btn {
  flex-shrink: 0; padding: 9px 20px;
  background: #0d9488; color: #fff; border: none; border-radius: 10px;
  font-size: 13px; font-weight: 700; font-family: var(--f-sans); cursor: pointer;
  white-space: nowrap; transition: background .2s, transform .18s;
}
.crp-staff-open-btn:hover { background: #0f766e; transform: translateY(-1px); }
.crp-staff-open-btn:disabled { background: rgba(100,116,139,0.18); color: #64748b; cursor: default; transform: none; }

/* Team Chips */
.staff-team-chips { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
.staff-team-chip { display:inline-flex; }
.staff-team-chip input[type="checkbox"] { position:absolute; opacity:0; width:0; height:0; }
.staff-team-chip-label {
  display:inline-block; padding:7px 18px;
  border:1.5px solid rgba(0,79,104,0.2); border-radius:999px;
  font-size:13px; font-weight:600; cursor:pointer; user-select:none;
  transition:all 0.15s; background:#fff; color:var(--c-muted);
  line-height:1.4;
}
.staff-team-chip-label:hover { border-color:#0d9488; color:#0d9488; }
.staff-team-chip input:checked ~ .staff-team-chip-label {
  background:#0d9488; border-color:#0d9488; color:#fff;
}

/* Staff Modal */
.crp-staff-modal-head {
  padding: 32px 40px 24px;
  background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%);
  border-radius: 20px 20px 0 0;
  position: relative; overflow: hidden;
}
.crp-staff-modal-head::after {
  content:''; position:absolute; top:-50px; right:-50px;
  width:180px; height:180px; border-radius:50%;
  background:rgba(167,243,208,0.10); pointer-events:none;
}
.crp-staff-modal-badge { color: rgba(167,243,208,0.9); }
.crp-staff-modal-badge::before { background: rgba(167,243,208,0.9); }

/* ── RESPONSIVE ── */
@media (max-width: 960px) {
  .crp-reg-grid,
  .crp-reg-grid--inland,
  #lang-root.lang-en .crp-reg-grid,
  #lang-root.lang-en .crp-reg-grid--inland,
  body.lang-en .crp-reg-grid,
  body.lang-en .crp-reg-grid--inland { grid-template-columns: 1fr 1fr; }
  .crp-reg-header { flex-direction: column; align-items: flex-start; }
  .crp-group-header { flex-direction: column; align-items: flex-start; gap: 6px; }
  .crp-reg-header-note { text-align: left; max-width: 100%; }
}
@media (max-width: 640px) {
  .crp-hero { padding: 100px 24px 56px; }
  .crp-reg-section { padding: 48px 20px 72px; }
  .crp-reg-grid,
  .crp-reg-grid--inland,
  #lang-root.lang-en .crp-reg-grid,
  #lang-root.lang-en .crp-reg-grid--inland,
  body.lang-en .crp-reg-grid,
  body.lang-en .crp-reg-grid--inland { grid-template-columns: 1fr; }
  .crp-contact-bar { padding: 28px 24px; }
  .crp-contact-divider { display: none; }
}

/* ══ REGISTRATION MODAL ══ */
.crp-reg-modal {
  position: fixed; inset: 0; z-index: 9000;
  display: flex; align-items: center; justify-content: center;
  padding: 20px;
}
.crp-reg-modal[hidden] { display: none; }

.crp-modal-overlay {
  position: absolute; inset: 0;
  background: rgba(5,18,28,0.65);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  cursor: pointer;
  animation: crpFadeIn 0.25s ease;
}
@keyframes crpFadeIn { from { opacity:0; } to { opacity:1; } }
@keyframes crpSlideUp { from { opacity:0; transform:translateY(28px); } to { opacity:1; transform:translateY(0); } }

.crp-modal-card {
  position: relative; z-index: 1;
  background: #fff; border-radius: 20px;
  width: 100%; max-width: 680px;
  max-height: 90vh; overflow-y: auto;
  overscroll-behavior: contain;
  -webkit-overflow-scrolling: touch;
  box-shadow: 0 24px 56px rgba(0,20,40,0.24);
  animation: crpSlideUp 0.32s cubic-bezier(0.22,1,0.36,1);
}
.crp-modal-close {
  position: sticky; top: 16px; z-index: 40;
  margin: 16px 16px -48px auto;
  width: 32px; height: 32px; border-radius: 50%;
  border: 1px solid rgba(255,255,255,0.62); background: rgba(0,79,104,0.92);
  cursor: pointer;
  color: #fff; display: flex; align-items: center; justify-content: center;
  box-shadow: 0 6px 16px rgba(0,20,40,0.20);
  transition: background 0.2s, transform 0.18s;
}
.crp-modal-close:hover { background: #015a7a; transform: scale(1.04); }
.crp-modal-close svg { width: 16px; height: 16px; flex-shrink: 0; }

/* Modal header */
.crp-modal-head {
  padding: 36px 44px 28px;
  background: linear-gradient(135deg, var(--c-deep) 0%, #015a7a 100%);
  border-radius: 20px 20px 0 0;
  position: relative; overflow: hidden;
}
.crp-modal-head::after {
  content: ''; position: absolute; top: -60px; right: -60px;
  width: 200px; height: 200px; border-radius: 50%;
  background: rgba(115,209,245,0.08); pointer-events: none;
}
.crp-modal-badge {
  font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--c-light); margin-bottom: 10px; display: flex; align-items: center; gap: 8px;
}
.crp-modal-badge::before { content:''; width:14px; height:1.5px; background:var(--c-light); flex-shrink:0; }
.crp-modal-title {
  font-family: var(--f-serif); font-size: clamp(20px,3vw,26px); font-weight:700;
  color: #fff; line-height:1.2; margin-bottom: 20px; word-break: keep-all;
}
.crp-modal-cap-info {
  display: flex; justify-content: space-between; align-items: baseline;
  font-size: 12px; color: rgba(255,255,255,0.6); margin-bottom: 7px;
}

#staffModal .crp-staff-modal-head {
  background: linear-gradient(135deg, #0b5f59 0%, #0f766e 58%, #0d9488 100%);
}
#staffModal .crp-staff-modal-badge {
  color: #ffffff;
  text-shadow: 0 1px 2px rgba(0,0,0,0.18);
}
#staffModal .crp-staff-modal-badge::before { background: #ffffff; }
#staffModal .crp-modal-title { color: #ffffff; }
#staffModal .crp-staff-modal-desc {
  position: relative;
  z-index: 1;
  font-size: 13px;
  color: #ecfdf5;
  line-height: 1.6;
  margin-top: 4px;
  font-weight: 600;
  text-shadow: 0 1px 2px rgba(0,0,0,0.16);
}
#staffModal .crp-modal-close {
  background: rgba(7, 89, 81, 0.92);
  color: #ffffff;
  border: 1px solid rgba(255,255,255,0.62);
  box-shadow: 0 8px 22px rgba(4, 47, 46, 0.24);
}
#staffModal .crp-modal-close:hover {
  background: #064e49;
  transform: scale(1.04);
}
.crp-modal-cap-info strong { font-size: 15px; font-weight: 700; color: #fff; }
.crp-modal-cap-track {
  height: 8px; background: rgba(255,255,255,0.15); border-radius: 999px; overflow: hidden;
}
.crp-modal-cap-fill-m {
  height: 100%; width: 0%; flex-shrink: 0;
  background: #60a5fa;
  transition: width 0.8s cubic-bezier(0.22,1,0.36,1);
}
.crp-modal-cap-fill-f {
  height: 100%; width: 0%; flex-shrink: 0;
  background: #f472b6;
  transition: width 0.8s cubic-bezier(0.22,1,0.36,1);
}
.crp-modal-cap-track { display: flex; }
.crp-modal-bank {
  display: flex; flex-direction: column; gap: 3px;
  margin-top: 18px; padding-top: 16px;
  border-top: 1px solid rgba(255,255,255,0.15);
}
.crp-modal-bank-label {
  font-size: 10px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
  color: rgba(255,255,255,0.5); margin-bottom: 2px;
}
.crp-modal-bank-acct {
  font-size: 16px; font-weight: 700; color: #fff; letter-spacing: 0.04em;
  font-family: 'Courier New', monospace;
}
.crp-modal-bank-holder {
  font-size: 12px; color: rgba(255,255,255,0.65);
}

/* ── TYPE TABS ── */
.crp-type-tabs {
  display: flex; gap: 10px;
  background: rgba(0,79,104,0.05);
  padding: 10px 36px;
  border-bottom: 1px solid rgba(0,79,104,0.10);
}
.crp-type-tab {
  flex: 1; display: flex; flex-direction: column;
  align-items: center; justify-content: center; gap: 5px;
  padding: 16px 12px;
  background: transparent; border: 1.5px solid transparent;
  border-radius: 12px; cursor: pointer; font-family: var(--f-sans);
  transition: all 0.22s ease;
}
.crp-type-tab:hover { background: rgba(255,255,255,0.6); border-color: rgba(0,79,104,0.12); }
.crp-type-tab.active {
  background: #fff;
  border-color: rgba(0,79,104,0.16);
  box-shadow: 0 2px 10px rgba(0,20,40,0.10);
}
.crp-type-tab svg { flex-shrink: 0; width: 22px; height: 22px; color: var(--c-muted); transition: color 0.2s; }
.crp-type-tab.active svg { color: var(--c-deep); }
.crp-tab-title {
  font-size: 13px; font-weight: 700;
  color: var(--c-muted); letter-spacing: 0.01em; line-height: 1;
  transition: color 0.2s;
}
.crp-type-tab.active .crp-tab-title { color: var(--c-deep); }
.crp-tab-sub {
  font-size: 11px; font-weight: 400;
  color: rgba(107,136,150,0.8); line-height: 1; transition: color 0.2s;
}
.crp-type-tab.active .crp-tab-sub { color: var(--c-mid); }
.crp-modal--union-camp .crp-type-tabs { display: none; }

/* ── FORM STYLES ── */
.crp-form-wrap { padding: 28px 44px 44px; }
.crp-form-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 0;
}
.crp-field { display: flex; flex-direction: column; gap: 6px; }
.crp-field--full { grid-column: 1 / -1; }
.crp-field label {
  font-size: 11px; font-weight: 700; letter-spacing: 0.05em;
  text-transform: uppercase; color: var(--c-mid);
}
.crp-field label .req { color: var(--c-red); margin-left: 2px; }
.crp-field input, .crp-field select, .crp-field textarea {
  border: 1.5px solid rgba(0,79,104,0.13); border-radius: 8px;
  padding: 12px 14px; font-size: 14px; font-family: var(--f-sans);
  color: var(--c-text); background: #f7fbfd;
  transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
  outline: none; width: 100%; resize: vertical;
}
.crp-field input, .crp-field select {
  height: 46px; min-height: 46px; box-sizing: border-box; line-height: 1.2;
}
.crp-field input::placeholder, .crp-field textarea::placeholder { color: #afc2cc; }
.staff-birth-grid { display: grid; grid-template-columns: 1.2fr 0.9fr 0.9fr; gap: 8px; }
.crp-field input:focus, .crp-field select:focus, .crp-field textarea:focus {
  border-color: var(--c-mid); background: #fff;
  box-shadow: 0 0 0 3px rgba(0,126,161,0.09);
}
.crp-field input.error, .crp-field select.error { border-color: var(--c-red); }

/* Form section dividers */
.crp-form-section {
  margin-top: 22px; margin-bottom: 10px;
  display: flex; align-items: center; gap: 12px;
}
.crp-form-section-label {
  font-size: 10px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase;
  color: var(--c-muted); white-space: nowrap; flex-shrink: 0;
  padding-left: 8px; border-left: 2px solid var(--c-red); line-height: 1.2;
}
.crp-form-section-line {
  flex: 1; border: none; border-top: 1px solid rgba(0,79,104,0.16);
  margin: 0; padding: 0; height: 0; background: none; display: block;
}
.crp-form-section:first-child { margin-top: 8px; }

/* Group notice */

/* Consent */
.crp-consent {
  display: flex; align-items: flex-start; gap: 10px;
  padding: 14px 16px; background: rgba(0,79,104,0.035);
  border-radius: 8px; border: 1px solid rgba(0,79,104,0.09);
  margin-top: 20px; margin-bottom: 16px; cursor: pointer;
}
.crp-consent input[type=checkbox] { width: 16px; height: 16px; flex-shrink: 0; margin-top: 2px; cursor: pointer; accent-color: var(--c-deep); }
.crp-consent label,
.crp-consent-text { font-size: 12px; line-height: 1.65; color: var(--c-sub); cursor: pointer; }
.crp-consent label strong,
.crp-consent-text strong { color: var(--c-deep); }

@media (max-width: 640px) {
  .crp-reg-modal {
    padding: 12px 12px max(12px, env(safe-area-inset-bottom));
    align-items: flex-start;
  }
  .crp-modal-card {
    max-height: calc(100dvh - 24px - env(safe-area-inset-bottom));
    border-radius: 16px;
  }
  .crp-modal-head,
  .crp-staff-modal-head { padding: 28px 24px 22px; border-radius: 16px 16px 0 0; }
  .crp-form-wrap { padding: 22px 20px calc(36px + env(safe-area-inset-bottom)); }
  .crp-form-grid { grid-template-columns: 1fr; }
  .crp-modal-close { top: 12px; right: 12px; }
  .crp-consent { padding: 13px 14px; }
}

/* 환불 기준 tooltip */
/* 환불 규정 모달 */
.crp-refund-modal-overlay {
  position: fixed; inset: 0; z-index: 10000;
  background: rgba(0,0,0,0.58);
  align-items: center; justify-content: center;
  padding: 24px;
}
.crp-refund-modal-overlay[hidden] { display: none; }
.crp-refund-modal-overlay:not([hidden]) { display: flex; }
.crp-refund-modal {
  background: #fff; border-radius: 16px;
  width: 100%; max-width: 480px;
  display: flex; flex-direction: column;
  max-height: 80vh; overflow: hidden;
  box-shadow: 0 18px 44px rgba(0,0,0,0.22);
}
.crp-refund-modal-head {
  padding: 22px 24px 16px;
  border-bottom: 1px solid rgba(0,79,104,0.1);
  flex-shrink: 0;
}
.crp-refund-modal-title {
  font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif; font-size: 16px; font-weight: 700;
  color: #004f68;
}
.crp-refund-modal-hint {
  font-size: 12px; color: #6b8896; margin-top: 4px; line-height: 1.5;
}
.crp-refund-modal-body {
  flex: 1; overflow-y: auto; padding: 20px 24px;
  scroll-behavior: smooth;
}
.crp-refund-section { margin-bottom: 20px; }
.crp-refund-section:last-child { margin-bottom: 0; }
.crp-refund-section-head {
  font-size: 13px; font-weight: 700; color: #004f68;
  margin-bottom: 8px; padding-bottom: 6px;
  border-bottom: 1px solid rgba(0,79,104,0.1);
}
.crp-refund-row {
  display: flex; gap: 8px;
  font-size: 13px; line-height: 1.7; color: #334a56;
  word-break: keep-all; margin-top: 5px;
}
.crp-refund-row::before { content: '·'; flex-shrink: 0; color: #6b8896; }
.crp-refund-modal-foot {
  padding: 16px 24px 20px; border-top: 1px solid rgba(0,79,104,0.1);
  flex-shrink: 0;
}
.crp-refund-agree-btn {
  width: 100%; padding: 14px;
  border-radius: 8px; border: none;
  font-size: 15px; font-weight: 700; font-family: 'Pretendard Variable', Pretendard, -apple-system, sans-serif;
  cursor: pointer; transition: background 0.2s;
  background: #004f68; color: #fff;
}
.crp-refund-agree-btn:hover { background: #015a7a; }

/* ── 환불 모달: wl-ko/wl-en 언어 분리
     .crp-refund-row { display:flex }가 글로벌 .wl-en { display:none }을 이기므로
     ID 선택자로 specificity를 높여서 강제 처리 ── */
#lang-root .crp-refund-row.wl-en,
#lang-root .crp-refund-section-head.wl-en,
#lang-root .crp-refund-modal-hint.wl-en,
body .crp-refund-row.wl-en,
body .crp-refund-section-head.wl-en,
body .crp-refund-modal-hint.wl-en { display: none !important; }

#lang-root.lang-en .crp-refund-row.wl-ko,
#lang-root.lang-en .crp-refund-section-head.wl-ko,
#lang-root.lang-en .crp-refund-modal-hint.wl-ko,
body.lang-en .crp-refund-row.wl-ko,
body.lang-en .crp-refund-section-head.wl-ko,
body.lang-en .crp-refund-modal-hint.wl-ko { display: none !important; }

#lang-root.lang-en .crp-refund-row.wl-en,
body.lang-en .crp-refund-row.wl-en { display: flex !important; }
#lang-root.lang-en .crp-refund-section-head.wl-en,
#lang-root.lang-en .crp-refund-modal-hint.wl-en,
body.lang-en .crp-refund-section-head.wl-en,
body.lang-en .crp-refund-modal-hint.wl-en { display: block !important; }

/* Bulk registration note */
.crp-bulk-note {
  grid-column: 1 / -1;
  background: rgba(0,126,161,0.06);
  border: 1px solid rgba(0,126,161,0.18);
  border-radius: 10px;
  padding: 13px 16px;
  margin-bottom: 0;
  font-size: 12.5px;
  line-height: 1.7;
  color: var(--c-muted);
}
.crp-bulk-note strong { color: var(--c-mid); }

/* Submit button */
.crp-submit {
  width: 100%; padding: 20px;
  background: var(--c-red); color: #fff;
  border: none; border-radius: 12px;
  font-size: 16px; font-weight: 700; font-family: var(--f-sans);
  letter-spacing: 0.03em; cursor: pointer;
  transition: background 0.22s, transform 0.18s, box-shadow 0.22s;
  display: flex; align-items: center; justify-content: center; gap: 8px;
  box-shadow: 0 4px 14px rgba(196,42,54,0.22);
}
.crp-submit:hover:not(:disabled) { background: var(--c-red-dk); transform: translateY(-2px); box-shadow: 0 10px 28px rgba(196,42,54,0.35); }
.crp-submit:disabled { opacity: 0.65; cursor: not-allowed; }
.crp-submit--teal {
  background: linear-gradient(135deg, #0f766e 0%, #0d9488 100%);
  box-shadow: 0 4px 14px rgba(13,148,136,0.26);
}
.crp-submit--teal:hover:not(:disabled) { background: linear-gradient(135deg, #0d6b63 0%, #0b857a 100%); transform: translateY(-2px); box-shadow: 0 10px 28px rgba(13,148,136,0.36); }
.crp-submit .spinner {
  display: none; width: 16px; height: 16px;
  border: 2px solid rgba(255,255,255,0.4); border-top-color: #fff;
  border-radius: 50%; animation: crpSpin 0.7s linear infinite;
}
.crp-submit.loading .spinner { display: block; }
.crp-submit.loading .crp-submit-label { opacity: 0.7; }
@keyframes crpSpin { to { transform: rotate(360deg); } }

@media (max-width: 640px) {
  .crp-submit {
    position: sticky;
    bottom: max(12px, env(safe-area-inset-bottom));
    z-index: 25;
    box-shadow: 0 10px 30px rgba(196,42,54,0.34);
  }
}

/* Error / success */
.crp-error-msg {
  margin-top: 12px; padding: 12px 16px;
  background: rgba(196,42,54,0.07); border: 1px solid rgba(196,42,54,0.18);
  border-radius: 8px; font-size: 13px; color: var(--c-red); text-align: center;
}
.crp-success-wrap { padding: 52px 44px; text-align: center; }
.crp-success-icon {
  width: 64px; height: 64px; border-radius: 50%;
  background: rgba(22,163,74,0.1); border: 2px solid rgba(22,163,74,0.25);
  color: #16a34a; font-size: 28px;
  display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;
}
.crp-success-title { font-family: var(--f-serif); font-size: 24px; font-weight: 700; color: var(--c-deep); margin-bottom: 10px; }
.crp-success-sub { font-size: 14px; line-height: 1.75; color: var(--c-muted); margin-bottom: 8px; word-break: keep-all; }
.crp-success-count {
  margin: 0 0 20px;
  padding: 16px 18px;
  border: 1px solid rgba(0,79,104,0.10);
  border-radius: 12px;
  background: #f8fbfd;
  text-align: left;
  color: var(--c-sub);
}
.crp-success-count:empty { display: none; }
.crp-success-notice-title {
  display: block;
  margin-bottom: 10px;
  font-size: 13px;
  font-weight: 800;
  color: var(--c-deep);
}
.crp-success-notice-list {
  display: grid;
  gap: 8px;
  margin: 0;
  padding: 0;
}
.crp-success-notice-list > span {
  display: grid;
  grid-template-columns: 18px minmax(0, 1fr);
  gap: 8px;
  align-items: start;
  font-size: 12.5px;
  font-weight: 600;
  line-height: 1.65;
  color: #64748b;
  word-break: keep-all;
}
.crp-success-notice-list > span::before {
  content: attr(data-num);
  width: 18px;
  height: 18px;
  border-radius: 999px;
  background: rgba(0,126,161,0.10);
  color: var(--c-mid);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 10px;
  font-weight: 800;
  margin-top: 1px;
}
.crp-success-notice-list > span > em {
  min-width: 0;
  font-style: normal;
}
.crp-success-notice-list strong {
  color: var(--c-deep);
  font-weight: 800;
  white-space: nowrap;
}
.crp-success-contact {
  margin: 0 0 24px; font-size: 12px; color: var(--c-muted);
  display: flex; flex-direction: column; gap: 4px;
}
.crp-success-contact strong { color: var(--c-sub); font-weight: 500; font-size: 13px; }
.crp-success-close {
  display: inline-flex; padding: 12px 32px; background: var(--c-deep); color: #fff;
  border: none; border-radius: 8px; font-size: 14px; font-weight: 700; font-family: var(--f-sans);
  cursor: pointer; transition: background 0.2s;
}
.crp-success-close:hover { background: #015a7a; }

/* ── 예약금 입금 안내 블록 ── */
.crp-success-bank {
  margin: 16px 0 20px;
  background: #f0f9ff;
  border: 1.5px solid rgba(0,126,161,0.22);
  border-radius: 12px;
  padding: 20px 24px;
  text-align: left;
}
.crp-success-bank-title {
  font-size: 13px; font-weight: 700; color: var(--c-deep);
  margin-bottom: 10px; letter-spacing: -0.01em;
}
.crp-success-bank-amount {
  font-size: 13px; color: var(--c-sub);
  margin-bottom: 12px;
}
.crp-success-bank-amount strong {
  font-size: 20px; font-weight: 800; color: var(--c-red);
}
.crp-success-bank-info {
  background: #fff;
  border: 1px solid rgba(0,79,104,0.1);
  border-radius: 8px;
  padding: 12px 16px;
  margin-bottom: 12px;
  display: flex; flex-direction: column; gap: 7px;
