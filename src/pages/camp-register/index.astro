          <div id="crpSectionIndividual">
            <div class="crp-form-section">
              <span class="crp-form-section-label"><span class="wl-ko">필수 정보</span><span class="wl-en">Required</span></span>
              <hr class="crp-form-section-line">
            </div>
            <div class="crp-form-grid">
              <div class="crp-field">
                <label><span class="wl-ko">이름</span><span class="wl-en">Name</span> <span class="req">*</span></label>
                <input id="crpName" name="name" placeholder="홍길동">
              </div>
              <div class="crp-field">
                <label><span class="wl-ko">연락처</span><span class="wl-en">Phone</span> <span class="req">*</span></label>
                <input id="crpPhone" name="phone" placeholder="010-0000-0000">
              </div>
              <div class="crp-field">
                <label><span class="wl-ko">이메일</span><span class="wl-en">Email</span> <span class="req">*</span></label>
                <input id="crpEmail" name="email" type="email" placeholder="email@example.com">
              </div>
              <div class="crp-field">
                <label><span class="wl-ko">학년</span><span class="wl-en">Grade</span> <span class="req">*</span></label>
                <select id="crpGrade" name="grade">
                  <option value="">— 선택 / Select —</option>
                  <optgroup label="초등 / Elementary">
                    <option value="초4">초4 (4th Grade)</option>
                    <option value="초5">초5 (5th Grade)</option>
                    <option value="초6">초6 (6th Grade)</option>
                  </optgroup>
                  <optgroup label="중학 / Middle">
                    <option value="중1">중1 (7th Grade)</option>
                    <option value="중2">중2 (8th Grade)</option>
                    <option value="중3">중3 (9th Grade)</option>
                  </optgroup>
                  <optgroup label="고등 / High">
                    <option value="고1">고1 (10th Grade)</option>
                    <option value="고2">고2 (11th Grade)</option>
                    <option value="고3">고3 (12th Grade)</option>
                  </optgroup>
                </select>
              </div>
            </div>
            <div class="crp-form-section">
              <span class="crp-form-section-label"><span class="wl-ko">선택 정보</span><span class="wl-en">Optional</span></span>
              <hr class="crp-form-section-line">
            </div>
            <div class="crp-form-grid">
              <div class="crp-field">
                <label><span class="wl-ko">소속 교회</span><span class="wl-en">Church</span></label>
                <input id="crpChurch" name="church" placeholder="교회 이름">
              </div>
              <div class="crp-field">
                <label><span class="wl-ko">학교</span><span class="wl-en">School</span></label>
                <input id="crpSchool" name="school" placeholder="학교 이름">
              </div>
              <div class="crp-field crp-field--full">
                <label><span class="wl-ko">비상연락처</span><span class="wl-en">Emergency Contact</span></label>
                <input id="crpEmergency" name="emergency" placeholder="보호자 이름 및 연락처">
              </div>
              <div class="crp-field crp-field--full">
                <label><span class="wl-ko">특이사항</span><span class="wl-en">Special Notes</span></label>
                <textarea id="crpNotes" name="notes" rows="3" placeholder="알레르기, 건강 상태, 기타 전달사항"></textarea>
              </div>
            </div>
          </div>

          <!-- 단체 신청 섹션 -->
          <div id="crpSectionGroup" hidden>
            <div class="crp-group-notice">
              <div class="crp-group-notice-icon">📋</div>
              <div>
                <strong class="wl-ko">단체 신청 안내</strong>
                <strong class="wl-en">Group Registration Notice</strong>
                <p class="wl-ko">단체 신청 접수 후, <em>wolkorea1@gmail.com</em>으로 개인별 신청서를 보내주시면 최종 확인 처리해 드립니다.</p>
                <p class="wl-en">After submitting group registration, please send individual registration forms to <em>wolkorea1@gmail.com</em> for final confirmation.</p>
              </div>
            </div>
            <div class="crp-form-section">
              <span class="crp-form-section-label"><span class="wl-ko">담당자 정보</span><span class="wl-en">Contact Person</span></span>
              <hr class="crp-form-section-line">
            </div>
            <div class="crp-form-grid">
              <div class="crp-field">
                <label><span class="wl-ko">담당자 이름</span><span class="wl-en">Contact Name</span> <span class="req">*</span></label>
                <input id="crpGName" name="gName" placeholder="홍길동">
              </div>
              <div class="crp-field">
                <label><span class="wl-ko">연락처</span><span class="wl-en">Phone</span> <span class="req">*</span></label>
                <input id="crpGPhone" name="gPhone" placeholder="010-0000-0000">
              </div>
              <div class="crp-field">
                <label><span class="wl-ko">이메일</span><span class="wl-en">Email</span> <span class="req">*</span></label>
                <input id="crpGEmail" name="gEmail" type="email" placeholder="email@example.com">
              </div>
              <div class="crp-field">
                <label><span class="wl-ko">신청 인원</span><span class="wl-en">Group Size</span> <span class="req">*</span></label>
                <select id="crpGCount" name="gCount">
                  <option value="">— 선택 / Select —</option>
                  {Array.from({length: 49}, (_, i) => i + 2).map(n => (
                    <option value={n}>{n}명 ({n} people)</option>
                  ))}
                </select>
              </div>
              <div class="crp-field crp-field--full">
                <label><span class="wl-ko">소속 교회 / 단체</span><span class="wl-en">Church / Organization</span> <span class="req">*</span></label>
                <input id="crpGOrg" name="gOrg" placeholder="교회 또는 단체 이름">
                <p style="font-size:12px; color:#6b8896; margin-top:5px; line-height:1.6;">
                  <span class="wl-ko">💡 개인 다자녀의 경우 소속 단체 없이 개인 이름으로 입력하셔도 됩니다.</span>
                  <span class="wl-en">💡 For families with multiple children, you may enter your personal name without an organization.</span>
                </p>
              </div>
              <div class="crp-field crp-field--full">
                <label><span class="wl-ko">전달 사항</span><span class="wl-en">Notes</span></label>
                <textarea id="crpGNotes" name="gNotes" rows="3" placeholder="캠프 관련 문의 또는 요청 사항"></textarea>
              </div>
            </div>
          </div>

          <!-- 개인정보 동의 -->
          <label class="crp-consent">
            <input type="checkbox" id="crpConsent">
            <label for="crpConsent">
              <strong class="wl-ko">개인정보 수집 및 이용에 동의합니다.</strong>
              <strong class="wl-en">I agree to the collection and use of personal information.</strong>
              <br>
              <span class="wl-ko" style="font-size:11.5px;color:var(--c-muted);line-height:1.7;">수집 항목: 이름, 연락처, 이메일 &nbsp;·&nbsp; 목적: 캠프 신청 접수 및 안내 &nbsp;·&nbsp; 보유기간: 캠프 종료 후 요청 시까지</span>
              <span class="wl-en" style="font-size:11.5px;color:var(--c-muted);line-height:1.7;">Items: name, phone, email &nbsp;·&nbsp; Purpose: registration processing &nbsp;·&nbsp; Retention: until deletion is requested after camp ends</span>
            </label>
          </label>

          <button type="submit" class="crp-submit" id="crpSubmitBtn">
            <div class="spinner"></div>
            <span class="crp-submit-label">
              <span class="wl-ko">신청 완료하기</span>
              <span class="wl-en">Submit Registration</span>
            </span>
          </button>
          <div class="crp-error-msg" id="crpErrorMsg" hidden></div>
        </form>
      </div>

      <!-- 성공 화면 -->
      <div class="crp-success-wrap" id="crpSuccessWrap" hidden>
        <div class="crp-success-icon">✓</div>
        <div class="crp-success-title">
          <span class="wl-ko">신청이 완료되었습니다!</span>
          <span class="wl-en">Registration Complete!</span>
        </div>
        <p class="crp-success-sub" id="crpSuccessMsg"></p>
        <p class="crp-success-count" id="crpSuccessCount"></p>
        <div class="crp-success-contact">
          <span class="wl-ko">추가 문의</span><span class="wl-en">Questions</span>
          <strong>031-611-9216 &nbsp;·&nbsp; wolkorea1@gmail.com</strong>
        </div>
        <button class="crp-success-close" id="crpSuccessClose">
          <span class="wl-ko">닫기</span><span class="wl-en">Close</span>
        </button>
      </div>
    </div>
  </div>

</div><!-- /.crp -->

<script>
/* ── Reveal 애니메이션 ── */
var obs = new IntersectionObserver(function(entries) {
  entries.forEach(function(e) {
    if (e.isIntersecting) { e.target.classList.add('visible'); obs.unobserve(e.target); }
  });
}, { threshold: 0.10, rootMargin: '0px 0px -30px 0px' });
document.querySelectorAll('.crp .reveal').forEach(function(el) { obs.observe(el); });

/* ── 언어 감지 헬퍼 ── */
function crpIsEn() {
  var el = document.getElementById('lang-root');
  return !!(el && el.classList.contains('lang-en'));
}

/* ── 정원 바 업데이트 ── */
function updateCrpCapBar(el, count, capacity) {
  var fill = el.querySelector('.crp-cap-fill');
  var countEl = el.querySelector('.crp-cap-count');
  var pct = capacity > 0 ? Math.min((count / capacity) * 100, 100) : 0;
  if (countEl) countEl.textContent = count;
  if (fill) {
    fill.style.width = pct + '%';
    fill.className = 'crp-cap-fill' + (pct >= 100 ? ' full' : pct >= 75 ? ' warn' : '');
  }
}

async function loadCrpCapacities() {
  var cards = document.querySelectorAll('[data-cap-id]');
  await Promise.all(Array.from(cards).map(async function(el) {
    var campId = el.dataset.capId;
    var btn = document.querySelector('.crp-open-btn[data-camp-id="' + campId + '"]');
    var cap = btn ? parseInt(btn.dataset.capacity) || 40 : 40;
    try {
      var res = await fetch('/api/capacity/' + campId);
      if (res.ok) {
        var data = await res.json();
        updateCrpCapBar(el, data.count, cap);
        if (data.count >= cap && btn) {
          btn.disabled = true;
          btn.innerHTML = '<span class="wl-ko">정원 마감</span><span class="wl-en">Full</span>';
          btn.style.background = 'rgba(100,116,139,0.15)';
          btn.style.color = '#64748b';
          btn.style.cursor = 'default';
        }
      }
    } catch(e) { /* 조용히 처리 */ }
  }));
}
loadCrpCapacities();

/* ── 모달 DOM 참조 ── */
var modal = document.getElementById('crpModal');
var modalTitle = document.getElementById('crpModalTitle');
var modalCapLabel = document.getElementById('crpModalCapLabel');
var modalCapFill = document.getElementById('crpModalCapFill');
var campIdInput = document.getElementById('crpCampId');
var campCapInput = document.getElementById('crpCampCap');
var regTypeInput = document.getElementById('crpType');
var formWrap = document.getElementById('crpFormWrap');
var successWrap = document.getElementById('crpSuccessWrap');
var errorMsg = document.getElementById('crpErrorMsg');
var submitBtn = document.getElementById('crpSubmitBtn');
var sectionIndividual = document.getElementById('crpSectionIndividual');
var sectionGroup = document.getElementById('crpSectionGroup');
var tabIndividual = document.getElementById('crpTabIndividual');
var tabGroup = document.getElementById('crpTabGroup');

/* ── 모달 정원 바 ── */
function updateCrpModalCap(count, capacity) {
  var pct = capacity > 0 ? Math.min((count / capacity) * 100, 100) : 0;
  modalCapLabel.textContent = count + ' / ' + capacity + (crpIsEn() ? ' spots' : '명');
  modalCapFill.style.width = pct + '%';
  modalCapFill.className = 'crp-modal-cap-fill' + (pct >= 100 ? ' full' : pct >= 75 ? ' warn' : '');
}

/* ── 탭 전환 ── */
function crpSwitchTab(type) {
  regTypeInput.value = type;
  if (type === 'individual') {
    tabIndividual.classList.add('active');
    tabGroup.classList.remove('active');
    sectionIndividual.hidden = false;
    sectionGroup.hidden = true;
  } else {
    tabGroup.classList.add('active');
    tabIndividual.classList.remove('active');
    sectionGroup.hidden = false;
    sectionIndividual.hidden = true;
  }
  errorMsg.hidden = true;
}
tabIndividual.addEventListener('click', function() { crpSwitchTab('individual'); });
tabGroup.addEventListener('click', function() { crpSwitchTab('group'); });

/* ── 모달 열기 ── */
document.querySelectorAll('.crp-open-btn').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    var campId = this.dataset.campId;
    var nameKo = this.dataset.campNameKo;
    var nameEn = this.dataset.campNameEn;
    var capacity = parseInt(this.dataset.capacity) || 40;

    campIdInput.value = campId;
    campCapInput.value = capacity;
    modalTitle.textContent = crpIsEn() ? nameEn : nameKo;

    document.getElementById('crpForm').reset();
    crpSwitchTab('individual');
    formWrap.hidden = false;
    successWrap.hidden = true;
    errorMsg.hidden = true;
    submitBtn.disabled = false;
    submitBtn.classList.remove('loading');
    updateCrpModalCap('…', capacity);

    modal.hidden = false;
    document.body.style.overflow = 'hidden';

    try {
      var res = await fetch('/api/capacity/' + campId);
      if (res.ok) {
        var data = await res.json();
        updateCrpModalCap(data.count, capacity);
        if (data.count >= capacity) {
          submitBtn.disabled = true;
          submitBtn.querySelector('.crp-submit-label').innerHTML =
            '<span>정원이 마감되었습니다 / Registration Full</span>';
        }
      }
    } catch(e) { updateCrpModalCap(0, capacity); }
  });
});

/* ── 모달 닫기 ── */
function closeCrpModal() {
  modal.hidden = true;
  document.body.style.overflow = '';
}
document.getElementById('crpOverlay').addEventListener('click', closeCrpModal);
document.getElementById('crpCloseBtn').addEventListener('click', closeCrpModal);
document.getElementById('crpSuccessClose').addEventListener('click', closeCrpModal);
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeCrpModal(); });

/* ── 폼 제출 ── */
document.getElementById('crpForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  errorMsg.hidden = true;

  var consent = document.getElementById('crpConsent').checked;
  if (!consent) {
    errorMsg.textContent = '개인정보 수집 및 이용에 동의해 주세요. / Please agree to the privacy policy.';
    errorMsg.hidden = false;
    return;
  }

  var currentType = regTypeInput.value;
  var payload;

  if (currentType === 'group') {
    var gName  = document.getElementById('crpGName').value.trim();
    var gPhone = document.getElementById('crpGPhone').value.trim();
    var gEmail = document.getElementById('crpGEmail').value.trim();
    var gCount = document.getElementById('crpGCount').value;
    var gOrg   = document.getElementById('crpGOrg').value.trim();

    if (!gName || !gPhone || !gEmail || !gCount || !gOrg) {
      errorMsg.textContent = '담당자 이름, 연락처, 이메일, 인원, 소속은 필수 항목입니다. / Contact name, phone, email, group size, and organization are required.';
      errorMsg.hidden = false;
      return;
    }
    payload = {
      registrationType: 'group',
      campId: campIdInput.value,
      capacity: parseInt(campCapInput.value) || 40,
      name: gName, phone: gPhone, email: gEmail,
      groupCount: parseInt(gCount),
      church: gOrg,
      notes: document.getElementById('crpGNotes').value.trim(),
    };
  } else {
    var name  = document.getElementById('crpName').value.trim();
    var phone = document.getElementById('crpPhone').value.trim();
    var email = document.getElementById('crpEmail').value.trim();
    var grade = document.getElementById('crpGrade').value;

    if (!name || !phone || !email || !grade) {
      errorMsg.textContent = '이름, 연락처, 이메일, 학년은 필수 항목입니다. / Name, phone, email, and grade are required.';
      errorMsg.hidden = false;
      return;
    }
    payload = {
      registrationType: 'individual',
      campId: campIdInput.value,
      capacity: parseInt(campCapInput.value) || 40,
      name, phone, email, grade,
      church: document.getElementById('crpChurch').value.trim(),
      school: document.getElementById('crpSchool').value.trim(),
      emergency: document.getElementById('crpEmergency').value.trim(),
      notes: document.getElementById('crpNotes').value.trim(),
    };
  }

  submitBtn.disabled = true;
  submitBtn.classList.add('loading');

  try {
    var res = await fetch('/api/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    var data = await res.json();

    if (res.ok && data.success) {
      formWrap.hidden = true;
      successWrap.hidden = false;

      var successMsg = document.getElementById('crpSuccessMsg');
      var successCount = document.getElementById('crpSuccessCount');
      var isEn = crpIsEn();

      if (currentType === 'group') {
        var gc = payload.groupCount;
        successMsg.innerHTML = isEn
          ? 'Your group registration for <strong>' + gc + ' participants</strong> has been received. Please send individual registration forms to <strong>wolkorea1@gmail.com</strong> for final confirmation.'
          : '<strong>' + gc + '명</strong>의 단체 신청이 접수되었습니다.<br><strong>wolkorea1@gmail.com</strong>으로 개인별 신청서를 보내주시면 최종 확인 처리해 드립니다.';
        successCount.textContent = isEn
          ? data.count + ' / ' + data.capacity + ' spots filled'
          : data.count + ' / ' + data.capacity + '명 신청 완료';
      } else {
        successMsg.innerHTML = isEn
          ? "Your registration has been received. We'll be in touch with further details soon."
          : '신청이 성공적으로 접수되었습니다. 캠프 일정 및 안내 사항은 입력하신 이메일로 발송됩니다.';
        successCount.textContent = isEn
          ? data.count + ' / ' + data.capacity + ' spots filled'
          : data.count + ' / ' + data.capacity + '명 신청 완료';
      }

      var capBar = document.querySelector('[data-cap-id="' + payload.campId + '"]');
      if (capBar) updateCrpCapBar(capBar, data.count, data.capacity);
      updateCrpModalCap(data.count, data.capacity);

    } else {
      errorMsg.textContent = data.error || '오류가 발생했습니다. 다시 시도해주세요. / An error occurred. Please try again.';
      errorMsg.hidden = false;
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
    }
  } catch(err) {
    errorMsg.textContent = '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해주세요. / Network error. Please try again.';
    errorMsg.hidden = false;
    submitBtn.disabled = false;
    submitBtn.classList.remove('loading');
  }
});
</script>

</BaseLayout>
