document.getElementById('crpSuccessClose').addEventListener('click', closeCrpModal);
document.getElementById('crpCancelBtn').addEventListener('click', closeCrpModal); // 아래 버튼 줄의 '취소' — 닫기(X)와 같다

/* ── 입금 계좌번호 복사 (후원 페이지와 같은 방식: 클립보드 → 안 되면 숨은 입력칸으로 복사). 화면의 계좌번호 글자는 바꾸지 않는다 ── */
(function() {
  var box = document.querySelector('#crpModal .crp-modal-bank');
  var btn = box && box.querySelector('[data-copy]');
  if (!btn) return;
  var live = document.getElementById('crpCopyLive');
  var timer;
  function fallbackCopy(text) {
    var ta = document.createElement('textarea');
    ta.value = text; ta.setAttribute('readonly', '');
    ta.style.cssText = 'position:fixed;top:0;left:0;width:1px;height:1px;opacity:0;';
    document.body.appendChild(ta); ta.select();
    var ok = false;
    try { ok = document.execCommand('copy'); } catch (e) {}
    document.body.removeChild(ta);
    return ok;
  }
  function copy(text) {
    if (navigator.clipboard && window.isSecureContext) {
      return navigator.clipboard.writeText(text).then(function() { return true; }, function() { return fallbackCopy(text); });
    }
    return Promise.resolve(fallbackCopy(text));
  }
  btn.addEventListener('click', function() {
    var text = btn.dataset.copy;
    copy(text).then(function(ok) {
      if (live) live.textContent = '';
      if (!ok) {
        if (live) live.textContent = crpText('복사하지 못했어요. 번호를 직접 선택해 주세요.', 'Could not copy. Please select the number manually.');
        return;
      }
      box.classList.add('is-copied');
      if (live) live.textContent = crpText('계좌번호를 복사했어요', 'Account number copied') + ' ' + text;
      clearTimeout(timer);
      timer = setTimeout(function() { box.classList.remove('is-copied'); }, 2000);
    });
  });
})();
document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeCrpModal(); });

/* ── 환불 규정 모달 ── */
// 현금·현장 결제를 고르면 환불 계좌 입력칸을 숨기고 필수에서 뺀다.
