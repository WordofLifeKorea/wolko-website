        <div class="crp-contact-info wl-ko">
          <span class="crp-contact-info-line">월코 캠프 문의 &nbsp;|&nbsp; <strong>TEL</strong> 031-611-9216 &nbsp;|&nbsp; <strong>EMAIL</strong> wolkorea1@gmail.com</span>
          <span class="crp-contact-info-line">제주 캠프 문의 &nbsp;|&nbsp; <strong>TEL</strong> 064-799-3707 &nbsp;|&nbsp; <strong>EMAIL</strong> wolbijeju.contact@gmail.com</span>
        </div>
        <div class="crp-contact-info wl-en">
          <span class="crp-contact-info-line">WOLKO Camp Inquiry &nbsp;|&nbsp; <strong>TEL</strong> 031-611-9216 &nbsp;|&nbsp; <strong>EMAIL</strong> wolkorea1@gmail.com</span>
          <span class="crp-contact-info-line">Jeju Camp Inquiry &nbsp;|&nbsp; <strong>TEL</strong> 064-799-3707 &nbsp;|&nbsp; <strong>EMAIL</strong> wolbijeju.contact@gmail.com</span>
        </div>
      </div>
