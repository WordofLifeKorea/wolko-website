                    <option value="초5" data-ko="초5" data-en="5th Grade">초5</option>
                    <option value="초6" data-ko="초6" data-en="6th Grade">초6</option>
                  </optgroup>
                  <optgroup label="중학" data-ko="중학" data-en="Middle School">
                    <option value="중1" data-ko="중1" data-en="7th Grade">중1</option>
                    <option value="중2" data-ko="중2" data-en="8th Grade">중2</option>
                    <option value="중3" data-ko="중3" data-en="9th Grade">중3</option>
                  </optgroup>
                  <optgroup label="고등" data-ko="고등" data-en="High School">
                    <option value="고1" data-ko="고1" data-en="10th Grade">고1</option>
                    <option value="고2" data-ko="고2" data-en="11th Grade">고2</option>
                    <option value="고3" data-ko="고3" data-en="12th Grade">고3</option>
                  </optgroup>
                </select>
