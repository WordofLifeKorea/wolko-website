<script>
import { BIRTH_YEAR_RANGES, GENDER_CAPACITY, WINTER_CAMP_POLICY, birthYearCheck, registrationState, usesWinterCampPolicy, winterCampQuote } from '../../../functions/lib/winterCampPolicy.js';
/* ── Reveal 애니메이션: 스크롤하면 제목·캠프 카드가 아래에서 차례로 떠오른다 (사역·캠프 페이지와 같은 방식).
   움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
   신청 모달과 입력칸은 대상이 아니다. ── */
(function() {
  if (!('IntersectionObserver' in window)) return;
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var items = [].slice.call(document.querySelectorAll(
    '.crp .crp-reg-header-text > *, .crp .crp-group-header, .crp .crp-reg-grid > *, .crp .crp-staff-card, .crp .crp-reg-empty'
  ));
  items.forEach(function(el) {
    var i = [].indexOf.call(el.parentNode.children, el);
    el.style.setProperty('--d', Math.min(i, 5) * 0.08 + 's');
    el.classList.add('crp-rv');
  });
  var io = new IntersectionObserver(function(entries) {
    entries.forEach(function(en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
  }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  items.forEach(function(el) { io.observe(el); });
})();

/* ── 언어 감지 헬퍼 ── */
function crpIsEn() {
  var el = document.getElementById('lang-root');
  return !!(
    (el && el.classList.contains('lang-en')) ||
    document.body.classList.contains('lang-en') ||
    document.documentElement.classList.contains('lang-en')
  );
}
function crpText(ko, en) {
  return crpIsEn() ? en : ko;
}
function crpShowError(el, ko, en) {
  if (!el) return;
  el.dataset.errKo = ko;
  el.dataset.errEn = en;
  el.textContent = crpText(ko, en);
  el.hidden = false;
}

/* ── 정원 바 업데이트 (성별 split) ── */
function updateCrpCapBar(el, data, totalCap) {
  var count  = typeof data.count  === 'number' ? data.count  : 0;
  var countM = typeof data.countMale   === 'number' ? data.countMale   : 0;
  var countF = typeof data.countFemale === 'number' ? data.countFemale : 0;

  // 성별 분리 정원 (hasSplit 캠프)
  var capM = parseInt(el.dataset.capacityMale)   || 0;
  var capF = parseInt(el.dataset.capacityFemale) || 0;

  var countEl  = el.querySelector('.crp-cap-count');
  var countMEl = el.querySelector('.crp-cap-count-m');
  var countFEl = el.querySelector('.crp-cap-count-f');
  var fillM    = el.querySelector('.crp-cap-fill-m');
  var fillF    = el.querySelector('.crp-cap-fill-f');

  if (countEl)  countEl.textContent  = count;
  if (countMEl) countMEl.textContent = countM;
  if (countFEl) countFEl.textContent = countF;
  if (fillM) fillM.style.width = '0%';
  if (fillF) fillF.style.width = '0%';

  if (capM > 0 && capF > 0) {
    // 성별 정원 분리 캠프: 각각의 정원 기준으로 바 계산
    if (fillM) fillM.style.width = Math.min((countM / capM) * 100, 100) + '%';
    if (fillF) fillF.style.width = Math.min((countF / capF) * 100, 100) + '%';
  } else if (totalCap > 0) {
    // 성별 정원 미분리 캠프: 전체 신청 현황을 단일 바로 표시
    if (fillM) fillM.style.width = Math.min((count / totalCap) * 100, 100) + '%';
  }
}

var WAITLIST_SIZE = 10;

async function loadCrpCapacities() {
  var cards = document.querySelectorAll('[data-cap-id]');
  await Promise.all(Array.from(cards).map(async function(el) {
    var campId = el.dataset.capId;
    var btn = document.querySelector('.crp-open-btn[data-camp-id="' + campId + '"]');
    var cap = btn ? parseInt(btn.dataset.capacity) || 40 : 40;
    try {
      var res = await fetch('/api/capacity/' + campId);
      var data = res.ok ? await res.json() : { count: 0, countMale: 0, countFemale: 0 };
      var subs = data.count ?? 0;
      var subsData = { count: subs, countMale: data.countMale ?? 0, countFemale: data.countFemale ?? 0 };
      updateCrpCapBar(el, subsData, cap);
      if (btn) {
        if (subs >= cap + WAITLIST_SIZE) {
          btn.disabled = true;
          btn.innerHTML = '<span class="wl-ko">마감</span><span class="wl-en">Closed</span>';
          btn.style.background = 'rgba(100,116,139,0.15)';
          btn.style.color = '#64748b';
          btn.style.cursor = 'default';
        } else if (subs >= cap) {
          btn.innerHTML = '<span class="wl-ko">예비 신청하기 →</span><span class="wl-en">Join Waitlist →</span>';
          btn.style.background = '#0b2430'; // 예비 신청 — 평평한 짙은 남색 (모양만, 동작은 그대로)
          btn.style.borderColor = '#0b2430';
          btn.dataset.isWaitlist = 'true';
        }
      }
    } catch(e) { updateCrpCapBar(el, { count: 0, countMale: 0, countFemale: 0 }, cap); }
  }));
}
function scheduleCrpCapacityLoad() {
  if ('requestIdleCallback' in window) {
    window.requestIdleCallback(loadCrpCapacities, { timeout: 1500 });
  } else {
    window.setTimeout(loadCrpCapacities, 250);
  }
}
scheduleCrpCapacityLoad();

/* ── 신청창: 열리는 구간(1차·2차)에만 신청 버튼을 보여주고, 구간 사이(공백 기간)에는 닫는다 ── */
function crpFormatOpenAt(iso) {
  var d = new Date(new Date(iso).getTime() + 9 * 3600000); // 한국 시간
  var month = d.getUTCMonth() + 1, day = d.getUTCDate(), hour = d.getUTCHours();
  var ampm = hour < 12 ? '오전' : '오후', h12 = ((hour + 11) % 12) + 1;
  var enHour = h12 + ':' + String(d.getUTCMinutes()).padStart(2, '0') + (hour < 12 ? ' AM' : ' PM');
  var enMonth = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'][month - 1];
  return { ko: month + '월 ' + day + '일 ' + ampm + ' ' + h12 + '시' + (d.getUTCMinutes() ? ' ' + d.getUTCMinutes() + '분' : ''), en: enMonth + ' ' + day + ', ' + enHour + ' KST' };
}
function applyRegistrationWindows() {
  document.querySelectorAll('[data-has-windows]').forEach(function(btn) {
    var campId = btn.dataset.campId;
    var info = registrationState(campId);
    var open = info.state === 'open';
    if (open) btn.setAttribute('data-window-open', 'true'); else btn.removeAttribute('data-window-open');
    var card = btn.closest('.crp-reg-card');
    var notice = document.querySelector('[data-window-notice="' + campId + '"]');
    if (notice) {
      notice.hidden = open;
      if (!open) {
        var when = info.nextOpenAt ? crpFormatOpenAt(info.nextOpenAt) : null;
        var ko = info.state === 'before'
          ? (when ? '신청은 ' + when.ko + '에 시작됩니다.' : '신청 시작 전입니다.')
          : (when ? '1차 신청이 마감되었습니다. 2차 신청은 ' + when.ko + '에 시작됩니다.' : '신청이 마감되었습니다.');
        var en = info.state === 'before'
          ? (when ? 'Registration opens ' + when.en + '.' : 'Registration has not started yet.')
          : (when ? 'Round 1 is closed. Round 2 opens ' + when.en + '.' : 'Registration is closed.');
        notice.innerHTML = '<span class="wl-ko">' + ko + '</span><span class="wl-en">' + en + '</span>';
      }
    }
    var badge = card && card.querySelector('.crp-status-badge');
    if (badge) {
      var label = open ? ['신청 중', 'Open'] : info.state === 'before' ? ['오픈 예정', 'Opens soon'] : info.nextOpenAt ? ['신청 일시 마감', 'Closed for now'] : ['마감', 'Closed'];
      badge.innerHTML = '<span class="wl-ko">' + label[0] + '</span><span class="wl-en">' + label[1] + '</span>';
      badge.className = 'crp-status-badge ' + (open ? 'crp-status-open' : info.state === 'before' ? 'crp-status-upcoming' : 'crp-status-closed');
    }
  });
}
applyRegistrationWindows();
