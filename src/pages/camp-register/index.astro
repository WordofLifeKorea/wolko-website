          <strong>031-611-9216 &nbsp;·&nbsp; wolkorea1@gmail.com</strong>
        </div>
        <button class="crp-success-close" id="crpSuccessClose">
          <span class="wl-ko">닫기</span><span class="wl-en">Close</span>
        </button>
      </div>
    </div>
  </div>

</div><!-- /.crp -->

<!-- 환불 규정 모달 -->
<div class="crp-refund-modal-overlay" id="crpRefundModalOverlay" hidden>
  <div class="crp-refund-modal" role="dialog" aria-modal="true">
    <div class="crp-refund-modal-head">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:12px;">
        <div>
          <div class="crp-refund-modal-title">
            <span class="wl-ko">환불 규정</span>
            <span class="wl-en">Refund Policy</span>
          </div>
          <div class="crp-refund-modal-hint wl-ko">내용을 확인하신 후 아래 동의하기 버튼을 눌러주세요.</div>
          <div class="crp-refund-modal-hint wl-en">Please review the policy and click Agree below.</div>
        </div>
        <button type="button" id="crpRefundCloseBtn" aria-label="닫기" style="
          flex-shrink:0; width:32px; height:32px; border-radius:50%;
