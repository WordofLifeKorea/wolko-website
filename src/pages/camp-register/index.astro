    document.getElementById('crpSuccessFeeSummary').hidden = false;
    document.getElementById('crpSuccessCount').innerHTML = crpPaymentNoticeHtml(balanceLabel, isEn);
    document.getElementById('crpBankNoteKo').innerHTML = '입금자명을 <strong>캠퍼 이름 (미리보기 캠퍼)</strong>으로 해주세요.<br>입금 확인 후 담당자가 최종 확정 처리합니다.';
    document.getElementById('crpBankNoteEn').innerHTML = "Please use the <strong>camper's name (Preview Camper)</strong> as the transfer memo.<br>Registration will be finalized after payment is verified.";
  }, 120);
})();
</script>

