              </div>
              <div class="crp-field">
                <label><span class="wl-ko">성별</span><span class="wl-en">Gender</span> <span class="req">*</span></label>
                <select id="crpGender" name="gender" data-opt-ko="— 선택 —" data-opt-en="— Select —">
                  <option value="">— 선택 —</option>
                  <option value="male" data-ko="남학생" data-en="Male">남학생</option>
                  <option value="female" data-ko="여학생" data-en="Female">여학생</option>
