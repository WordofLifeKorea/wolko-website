function validateScholarshipDiscountDetails(counts) {
  var details = getScholarshipDiscountDetails();
  var winter = usesWinterCampPolicy(campIdInput.value);
  if (winter) {
    if (crpPerCamperMode()) {
      var rows = crpCamperRows();
      for (var i = 0; i < rows.length; i++) {
        var sib = rows[i].querySelector('.crp-gsch-sibling');
        if (crpCamperScholarshipKeys(rows[i]).indexOf('sibling') >= 0 && sib && !sib.value.trim()) {
          crpShowError(errorMsg, '학생' + (i + 1) + '의 함께 참여하는 친구·지인·가족 이름을 입력해 주세요.', 'Please enter the name of the friend/family joining student ' + (i + 1) + '.');
          rows[i].open = true; sib.scrollIntoView({ block: 'center', behavior: 'smooth' }); sib.focus();
          return null;
        }
      }
    }
    try { winterCampQuote(counts, Math.max(1, scholarshipParticipantCount()), Date.now(), { perCamper: crpPerCamperMode() }); }
    catch (error) { crpShowError(errorMsg, error.message, 'Please check the scholarship options and Early Bird deadline.'); return null; }
    if (counts.excellent_camper && !document.getElementById('crpBestCamperEligible').checked) {
      crpShowError(errorMsg, 'Best Camper 수상 조건을 확인해주세요.', 'Please tick the box to confirm Best Camper eligibility.');
      return null;
    }
  }
  if (scholarshipDiscountActive(counts, 'wolbi_syme')) {
    if (!details.wolbi_syme.year) {
      crpShowError(errorMsg, '월비 또는 SYME 참여 연도를 선택해 주세요.', 'Please select the WOLBI/SYME participation year.');
      crpFocusScholarshipField('crpWolbiSymeYear');
      return null;
    }
    if (!details.wolbi_syme.participantName) {
      crpShowError(errorMsg, '월비 또는 SYME 졸업자 및 프로그램 참여자 이름을 입력해 주세요.', 'Please enter the WOLBI/SYME graduate or participant name.');
      crpFocusScholarshipField('crpWolbiSymeName');
      return null;
    }
  }
  if (scholarshipDiscountActive(counts, 'sibling')) {
    if (!winter && !details.sibling.camp) {
      crpShowError(errorMsg, '형제·자매 또는 친구가 참여하는 캠프를 선택해 주세요.', 'Please select which camp the sibling or friend is attending.');
      crpFocusScholarshipField('crpSiblingCamp');
      return null;
    }
    if (!details.sibling.camperName) {
      crpShowError(errorMsg, '함께 참여하는 캠퍼 이름을 입력해 주세요.', 'Please enter the name of the camper joining you.');
      if (winter) {
        var inlineName = document.querySelector('#' + (regTypeInput.value === 'group' ? 'crpScholarshipGroup' : 'crpScholarshipIndividual') + ' [data-sibling-names]');
        if (inlineName) { inlineName.scrollIntoView({ block: 'center', behavior: 'smooth' }); inlineName.focus(); }
      } else crpFocusScholarshipField('crpSiblingCamperName');
      return null;
    }
  }
  return {
    wolbi_syme: scholarshipDiscountActive(counts, 'wolbi_syme') ? details.wolbi_syme : null,
    sibling: scholarshipDiscountActive(counts, 'sibling') ? details.sibling : null,
    ...(winter ? { bestCamperEligible: document.getElementById('crpBestCamperEligible').checked } : {}),
  };
}

function updateScholarshipSummary() {
  updateScholarshipCountOptions();
  var participantCount = scholarshipParticipantCount();
  var baseFee = CAMP_BASE_FEE * participantCount;
  var deposit = (parseInt(campDepositInput.value, 10) || 0) * participantCount;
  var scholarshipCounts = getScholarshipCounts();
  document.querySelectorAll('select[name="scholarshipDiscountCount"]').forEach(function(select) {
    var option = select.closest('.crp-scholarship-option');
    if (option) option.classList.toggle('is-selected', (parseInt(select.value, 10) || 0) > 0);
  });
  if (usesWinterCampPolicy(campIdInput.value)) {
    var keys = Object.keys(scholarshipCounts).filter(function(key) { return key !== 'excellent_camper'; });
    document.querySelectorAll('input[name="scholarshipDiscount"]').forEach(function(input) {
      input.disabled = (input.value !== 'excellent_camper' && !input.checked && keys.length >= 2) || (input.value === 'early_bird' && Date.now() > Date.parse(WINTER_CAMP_POLICY.earlyBirdUntil));
    });
    document.querySelectorAll('select[name="scholarshipDiscountCount"]').forEach(function(select) {
      select.disabled = (select.dataset.discount !== 'excellent_camper' && !(scholarshipCounts[select.dataset.discount] > 0) && keys.length >= 2) || (select.dataset.discount === 'early_bird' && Date.now() > Date.parse(WINTER_CAMP_POLICY.earlyBirdUntil));
    });
    document.getElementById('crpBestCamperConfirmation').hidden = !scholarshipCounts.excellent_camper;
  }
  var discount = scholarshipDiscountAmount(scholarshipCounts);
  var finalFee = Math.max(0, baseFee - discount);
  var isEn = crpIsEn();
  var baseEl = document.getElementById('crpBaseFeePreview');
  var discountLabelEl = document.getElementById('crpDiscountPreviewLabel');
  var discountEl = document.getElementById('crpDiscountPreview');
  var discountRowEl = document.getElementById('crpDiscountPreviewRow');
  var finalEl = document.getElementById('crpFinalFeePreview');
  var balanceEl = document.getElementById('crpBalanceFeePreview');
  if (baseEl) baseEl.textContent = crpFormatWon(deposit, isEn);
  if (discountLabelEl) discountLabelEl.innerHTML = scholarshipDiscountSummaryHtml(scholarshipCounts, isEn);
  if (discountEl) discountEl.textContent = discount > 0 ? '-' + crpFormatWon(discount, isEn) : crpFormatWon(0, isEn);
  if (discountRowEl) discountRowEl.hidden = Object.keys(scholarshipCounts).length === 0;
  if (finalEl) finalEl.textContent = crpFormatWon(finalFee, isEn);
  if (balanceEl) balanceEl.textContent = crpFormatWon(Math.max(0, finalFee - deposit), isEn);
  updateScholarshipDetails();
}

['crpScholarshipIndividual', 'crpScholarshipGroup'].forEach(function(id) {
  document.getElementById(id).addEventListener('change', updateScholarshipSummary);
});

// 현재 모달의 성별 cap 값 (런타임)
var currentCapMale = 0;
var currentCapFemale = 0;
var currentRegisteredCount = null;
var currentGenderSubs = { male: 0, female: 0 };
var modalCapacityRequestId = 0;
var currentModalCapData = null;
var currentModalCapacity = 0;

/* ── 모달 정원 바 (성별 split) ── */
function updateCrpModalCap(data, capacity) {
  currentModalCapData = data;
  currentModalCapacity = capacity;
  var rawCount = (typeof data === 'object') ? (data.count ?? 0) : data;
  var count  = parseInt(rawCount, 10);
  var countDisplay = rawCount === '…' ? '…' : (Number.isFinite(count) ? count : 0);
  if (!Number.isFinite(count)) count = 0;
  var countM = (typeof data === 'object') ? (parseInt(data.countMale, 10) || 0) : 0;
  var countF = (typeof data === 'object') ? (parseInt(data.countFemale, 10) || 0) : 0;

  modalCapLabel.textContent = countDisplay + ' / ' + capacity + (crpIsEn() ? ' spots' : '명');
  if (modalCapFillM) modalCapFillM.style.width = '0%';
  if (modalCapFillF) modalCapFillF.style.width = '0%';

  if (capacity <= 0) return;

  if (currentCapMale > 0 && currentCapFemale > 0) {
    if (modalCapFillM) modalCapFillM.style.width = Math.min((countM / capacity) * 100, 100) + '%';
    if (modalCapFillF) modalCapFillF.style.width = Math.min((countF / capacity) * 100, 100) + '%';
  } else {
    if (modalCapFillM) modalCapFillM.style.width = Math.min((count / capacity) * 100, 100) + '%';
  }
}

/* ── 탭 전환 ── */
function crpSwitchTab(type) {
  regTypeInput.value = type;
  if (type === 'individual') {
    tabIndividual.classList.add('active');
    tabGroup.classList.remove('active');
    sectionIndividual.hidden = false;
    sectionGroup.hidden = true;
  } else {
    tabGroup.classList.add('active');
    tabIndividual.classList.remove('active');
    sectionGroup.hidden = false;
    sectionIndividual.hidden = true;
  }
  updateScholarshipMode();
  renderGroupParticipants();
  updateScholarshipSummary();
  errorMsg.hidden = true;
  if (GENDER_CAPACITY[campIdInput.value]) updateGenderWaitlistNotice();
}
tabIndividual.addEventListener('click', function() { crpSwitchTab('individual'); });
tabGroup.addEventListener('click', function() { crpSwitchTab('group'); });

/* ── 단체 참가 학생 입력칸 ── */
function crpPerCamperMode() {
  return campIdInput.value === WINTER_CAMP_POLICY.campId && regTypeInput.value === 'group' && !crpIsUnionCampMode();
}
function crpSyncPerCamperUi() {
  var winterWolko = campIdInput.value === WINTER_CAMP_POLICY.campId;
  var deferLabel = document.querySelector('label.crp-defer-list');
  var deferBox = document.getElementById('crpGDeferList');
  if (deferLabel) deferLabel.hidden = winterWolko;
  if (winterWolko && deferBox) { deferBox.checked = false; document.getElementById('crpGParticipants').hidden = false; }
  var groupWrap = document.getElementById('crpScholarshipGroup');
  if (groupWrap && regTypeInput.value === 'group') groupWrap.hidden = crpPerCamperMode();
  var perCamperWrap = document.getElementById('crpCamperScholarships');
  if (perCamperWrap) perCamperWrap.hidden = !crpPerCamperMode();
  document.getElementById('crpWinterScholarshipNotice').innerHTML = crpPerCamperMode()
    ? '<span class="wl-ko">각 캠퍼당 장학금은 최대 두 개까지 선택할 수 있습니다 (베스트 캠퍼는 별도, 중복 선택 가능). 아래에서 학생별로 눌러서 해당하는 장학금을 선택해 주세요. 암송 장학금은 종료 후 확인하여 지급하며 참가비에서 미리 차감하지 않습니다.</span><span class="wl-en">Each camper can have up to two scholarships (Best Camper is a bonus and does not count toward the limit). Tap each student below to select their scholarships. The memorization reward is given after camp once verified and is not deducted upfront.</span>'
    : '<span class="wl-ko">최대 두 항목 선택 가능 (베스트 캠퍼는 별도, 중복 선택 가능) · 암송 장학금은 종료 후 확인하여 지급하며 참가비에서 미리 차감하지 않습니다.</span><span class="wl-en">Pick up to two options. Best Camper is a bonus and doesn\'t count toward the limit. The memorization reward is given after camp once we\'ve checked, so it isn\'t taken off your fee upfront.</span>';
}
function crpCamperRows() {
  return Array.from(document.querySelectorAll('#crpCamperScholarships .crp-gsch-row'));
}
function crpCamperScholarshipKeys(row) {
  return Array.from(row.querySelectorAll('input[data-camper-sch]:checked')).map(function(input) { return input.value; });
}
function crpCamperShortLabel(key) {
  var item = WINTER_CAMP_POLICY.discounts[key];
  return (crpIsEn() ? item.en : item.ko).split(' · ')[0];
}
function crpRefreshCamperRow(row) {
  var checked = crpCamperScholarshipKeys(row);
  var normal = checked.filter(function(key) { return key !== 'excellent_camper'; });
  row.querySelectorAll('input[data-camper-sch]').forEach(function(input) {
    var expired = input.value === 'early_bird' && Date.now() > Date.parse(WINTER_CAMP_POLICY.earlyBirdUntil);
    input.disabled = expired || (input.value !== 'excellent_camper' && !input.checked && normal.length >= 2);
  });
  var sibling = row.querySelector('.crp-gsch-sibling');
  if (sibling) { var on = checked.indexOf('sibling') >= 0; sibling.hidden = !on; if (!on) sibling.value = ''; }
  row.classList.toggle('has-selection', checked.length > 0);
  var summary = row.querySelector('.crp-gsch-summary');
  if (summary) summary.textContent = checked.length ? checked.map(crpCamperShortLabel).join(' · ') : crpText('선택 없음', 'None');
  var nameInput = document.querySelectorAll('#crpGParticipants .crp-g-participant-name')[parseInt(row.dataset.index, 10)];
  var label = row.querySelector('.crp-gsch-name');
  if (label) label.textContent = crpText('학생 ', 'Student ') + (parseInt(row.dataset.index, 10) + 1) + (nameInput && nameInput.value.trim() ? ' · ' + nameInput.value.trim() : '');
}
function crpCamperRowHtml(index) {
  var en = crpIsEn();
  var keys = Object.keys(WINTER_CAMP_POLICY.discounts);
  return '<details class="crp-gsch-row" data-index="' + index + '">' +
    '<summary><span class="crp-gsch-name"></span><span class="crp-gsch-summary"></span></summary>' +
    '<div class="crp-gsch-body">' +
      '<div class="crp-gsch-title">' + (en ? 'Up to 2 scholarships (Best Camper is extra)' : '최대 2개 선택 (베스트 캠퍼는 별도)') + '</div>' +
      '<div class="crp-gsch-options">' + keys.map(function(key) {
        var item = WINTER_CAMP_POLICY.discounts[key];
        var extra = item.reward ? (en ? ' (reward after camp)' : ' (종료 후 지급)') : ' (−' + (item.amount || 0).toLocaleString('ko-KR') + (en ? ' KRW)' : '원)');
        return '<label class="crp-gsch-opt"><input type="checkbox" data-camper-sch value="' + key + '"><span>' + crpEscHtml(crpCamperShortLabel(key) + extra) + '</span></label>';
      }).join('') + '</div>' +
      '<input type="text" class="crp-gsch-sibling" hidden maxlength="100" placeholder="' + crpEscAttr(en ? 'Name of the friend/family joining' : '함께 참여하는 친구·지인·가족 이름') + '">' +
    '</div></details>';
}
function renderCamperScholarships() {
  var wrap = document.getElementById('crpCamperScholarships');
  if (!wrap) return;
  var count = crpPerCamperMode() ? (parseInt(document.getElementById('crpGCount').value, 10) || 0) : 0;
  var previous = crpCamperRows().map(function(row) {
    return { keys: crpCamperScholarshipKeys(row), sibling: row.querySelector('.crp-gsch-sibling')?.value || '', open: row.open };
  });
  wrap.innerHTML = Array.from({ length: count }, function(_, index) { return crpCamperRowHtml(index); }).join('');
  crpCamperRows().forEach(function(row, index) {
    var prev = previous[index] || { keys: [], sibling: '', open: false };
    prev.keys.forEach(function(key) {
      var input = row.querySelector('input[data-camper-sch][value="' + key + '"]');
      if (input) input.checked = true;
    });
    var sibling = row.querySelector('.crp-gsch-sibling');
    if (sibling && prev.sibling) sibling.value = prev.sibling;
    row.open = prev.open;
    crpRefreshCamperRow(row);
  });
}
document.getElementById('crpCamperScholarships').addEventListener('change', function(e) {
  if (!e.target.matches || !e.target.matches('input[data-camper-sch]')) return;
  crpRefreshCamperRow(e.target.closest('.crp-gsch-row'));
  updateScholarshipSummary();
});
document.getElementById('crpGParticipants').addEventListener('input', function(e) {
  if (e.target.classList && e.target.classList.contains('crp-g-participant-name')) crpCamperRows().forEach(crpRefreshCamperRow);
});
function renderGroupParticipants() {
  var count = parseInt(document.getElementById('crpGCount').value) || 0;
  var wrap = document.getElementById('crpGParticipants');
  if (crpIsUnionCampMode()) {
    wrap.innerHTML = '';
    return;
  }
  var previous = Array.from(wrap.querySelectorAll('.crp-group-participant')).map(function(row) {
    return {
      name: row.querySelector('.crp-g-participant-name')?.value || '',
      gender: row.querySelector('.crp-g-participant-gender')?.value || '',
      birthDate: row.querySelector('.crp-g-participant-birth')?.value || '',
    };
  });
  var birthRange = BIRTH_YEAR_RANGES[campIdInput.value];
  var thisYear = new Date().getFullYear();
  var birthYears = birthRange ? (birthRange.min - 5) + ',' + (birthRange.max + 5) : (thisYear - 30) + ',' + thisYear;
  var birthStart = birthRange ? Math.round((birthRange.min + birthRange.max) / 2) : thisYear - 13;
  var birthPlaceholder = crpText('생년월일', 'Date of birth');
  var namePlaceholder = crpText('학생 이름', 'Participant name');
  var genderPlaceholder = crpText('성별', 'Gender');
  var maleLabel = crpText('남', 'Male');
  var femaleLabel = crpText('여', 'Female');
  wrap.innerHTML = Array.from({ length: count }, function(_, index) {
    var participant = previous[index] || {};
    return '<div class="crp-group-participant">' +
      '<span class="crp-group-participant-num">' + (index + 1) + '</span>' +
      '<input class="crp-g-participant-name" type="text" value="' + crpEscAttr(participant.name) + '" placeholder="' + crpEscAttr(namePlaceholder) + '">' +
      '<input class="crp-g-participant-birth" type="date" data-cal-center data-cal-jump data-cal-years="' + birthYears + '" data-cal-start="' + birthStart + '" value="' + crpEscAttr(participant.birthDate) + '" placeholder="' + crpEscAttr(birthPlaceholder) + '" aria-label="' + crpEscAttr(birthPlaceholder) + '">' +
      '<select class="crp-g-participant-gender">' +
        '<option value="">' + genderPlaceholder + '</option>' +
        '<option value="male"' + (participant.gender === 'male' ? ' selected' : '') + '>' + maleLabel + '</option>' +
        '<option value="female"' + (participant.gender === 'female' ? ' selected' : '') + '>' + femaleLabel + '</option>' +
      '</select>' +
    '</div>';
  }).join('');
  renderCamperScholarships();
}
function crpEscAttr(value) {
  return String(value || '').replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
function crpEscHtml(value) {
  return String(value || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}
document.getElementById('crpGDeferList').addEventListener('change', function() {
  document.getElementById('crpGParticipants').hidden = this.checked;
});
document.getElementById('crpGCount').addEventListener('change', function() {
  renderGroupParticipants();
  updateScholarshipCountOptions();
  updateScholarshipSummary();
});

/* ── 성별 정원: 선택한 성별의 정원이 찼으면 예비 안내, 예비까지 찼으면 그 성별 접수 마감 ── */
function updateGenderWaitlistNotice() {
  var gc = GENDER_CAPACITY[campIdInput.value];
  if (!gc) return;
  var notice = document.getElementById('crpWaitlistNotice');
  var label = submitBtn.querySelector('.crp-submit-label');
  var normal = '<span class="wl-ko">신청 완료하기</span><span class="wl-en">Submit Registration</span>';
  var gender = document.getElementById('crpGender').value;
  var individual = regTypeInput.value === 'individual';
  submitBtn.disabled = false;
  label.innerHTML = normal;
  if (notice) notice.hidden = true;
  if (!individual || !gender) return;
  var taken = currentGenderSubs[gender] || 0;
  var cap = gender === 'male' ? gc.male : gc.female;
  if (taken >= cap + gc.waitlist) {
    submitBtn.disabled = true;
    label.innerHTML = gender === 'male'
      ? '<span class="wl-ko">남학생 접수가 마감되었습니다</span><span class="wl-en">Boys\' registration is closed</span>'
      : '<span class="wl-ko">여학생 접수가 마감되었습니다</span><span class="wl-en">Girls\' registration is closed</span>';
  } else if (taken >= cap) {
    if (notice) {
      notice.querySelectorAll('.crp-waitlist-num').forEach(function(el) { el.textContent = taken - cap + 1; });
      notice.hidden = false;
    }
    label.innerHTML = '<span class="wl-ko">예비 신청하기 →</span><span class="wl-en">Join Waitlist →</span>';
  }
}
document.getElementById('crpGender').addEventListener('change', updateGenderWaitlistNotice);

/* ── 개인 신청: 생년월일로 지원 연령을 확인하고, 범위 밖이면 경고와 함께 문의 남기기로 안내 ── */
function currentBirthDate() {
  var y = document.getElementById('crpBirthYear').value, m = document.getElementById('crpBirthMonth').value, d = document.getElementById('crpBirthDay').value;
  return y && m && d ? y + '-' + m + '-' + d : '';
}
function fillBirthOptions(select, from, to, pad, placeholder) {
  var html = '<option value="">' + placeholder + '</option>';
  for (var i = from; i <= to; i++) { var v = pad ? String(i).padStart(2, '0') : String(i); html += '<option value="' + v + '">' + i + '</option>'; }
  select.innerHTML = html;
}
function setupBirthCheck(campId) {
  var field = document.getElementById('crpBirthField');
  var range = BIRTH_YEAR_RANGES[campId];
  field.hidden = !range;
  document.getElementById('crpAgeWarn').hidden = true;
  if (!range) return;
  var en = crpIsEn();
  var yearSel = document.getElementById('crpBirthYear');
  var html = '<option value="">' + (en ? 'Year' : '년도') + '</option>';
  for (var y = range.max + 6; y >= range.min - 8; y--) html += '<option value="' + y + '">' + y + (en ? '' : '년') + '</option>';
  yearSel.innerHTML = html;
  fillBirthOptions(document.getElementById('crpBirthMonth'), 1, 12, true, en ? 'Month' : '월');
  fillBirthOptions(document.getElementById('crpBirthDay'), 1, 31, true, en ? 'Day' : '일');
  document.getElementById('crpBirthHint').textContent = en
    ? 'Eligible: born ' + range.min + ' – ' + range.max + '.'
    : '지원 연령: ' + range.min + '년생 ~ ' + range.max + '년생';
}
function updateBirthCheck() {
  var campId = campIdInput.value;
  var range = BIRTH_YEAR_RANGES[campId];
  var warn = document.getElementById('crpAgeWarn');
  if (!range) { warn.hidden = true; return; }
  var year = parseInt(document.getElementById('crpBirthYear').value, 10);
  var out = Number.isFinite(year) && (year < range.min || year > range.max);
  warn.hidden = !out;
  if (!out) return;
  var en = crpIsEn();
  document.getElementById('crpAgeWarnText').textContent = en
    ? 'The birth year you selected (' + year + ') is outside this camp\'s age range (born ' + range.min + ' – ' + range.max + '). If you would still like to join, please leave us an inquiry.'
    : '선택하신 출생연도(' + year + '년생)는 이 캠프의 지원 연령(' + range.min + '년생 ~ ' + range.max + '년생)에 해당하지 않습니다. 그래도 참가를 원하시면 문의를 남겨 주세요.';
}
['crpBirthYear', 'crpBirthMonth', 'crpBirthDay'].forEach(function(id) {
  document.getElementById(id).addEventListener('change', updateBirthCheck);
});
// 문의 페이지로 넘어갈 때 입력한 정보는 주소창이 아니라 이 탭의 임시 저장소로 넘긴다(개인정보가 주소에 남지 않게)
document.getElementById('crpAgeContact').addEventListener('click', function() {
  var campName = modalTitle.textContent.trim();
  var birth = currentBirthDate() || document.getElementById('crpBirthYear').value;
  var range = BIRTH_YEAR_RANGES[campIdInput.value];
  var msg = crpIsEn()
    ? '[Camp registration inquiry] ' + campName + '\nBirth date: ' + birth + '\nThis is outside the age range' + (range ? ' (born ' + range.min + ' – ' + range.max + ')' : '') + '. I would like to ask whether I can still participate.\n'
    : '[캠프 신청 문의] ' + campName + '\n생년월일: ' + birth + '\n지원 연령' + (range ? '(' + range.min + '년생 ~ ' + range.max + '년생)' : '') + '에 해당하지 않지만 참가가 가능한지 문의드립니다.\n';
  try {
    sessionStorage.setItem('wolko-contact-prefill', JSON.stringify({
      type: 'camp', message: msg,
      name: document.getElementById('crpName').value.trim(),
      email: document.getElementById('crpEmail').value.trim(),
      phone: document.getElementById('crpPhone').value.trim(),
    }));
  } catch (e) {}
});

/* ── 모달 열기 ── */
document.querySelectorAll('.crp-open-btn').forEach(function(btn) {
  btn.addEventListener('click', async function() {
    var campId   = this.dataset.campId;
    var nameKo   = this.dataset.campNameKo;
    var nameEn   = this.dataset.campNameEn;
    var capacity = parseInt(this.dataset.capacity) || 40;
    var requestId = ++modalCapacityRequestId;
    currentCapMale   = parseInt(this.dataset.capacityMale)   || 0;
    currentCapFemale = parseInt(this.dataset.capacityFemale) || 0;
    currentRegisteredCount = null;

    campIdInput.value = campId;
    campCapInput.value = capacity;
    campDepositInput.value = this.dataset.deposit || '0';
    modalTitle.textContent = crpIsEn() ? nameEn : nameKo;

    document.getElementById('crpForm').reset();
    setWinterScholarshipMode();
    setupBirthCheck(campId);
    var isUnionCamp = crpIsUnionCampId(campId);
    setCrpUnionCampMode(isUnionCamp);
    crpSyncPerCamperUi();
    updateScholarshipSummary();
    // 단체 학생 명단 초기화
    renderGroupParticipants();

    crpSwitchTab(isUnionCamp ? 'group' : 'individual');
    formWrap.hidden = false;
    successWrap.hidden = true;
    errorMsg.hidden = true;
    submitBtn.disabled = false;
    submitBtn.classList.remove('loading');
    submitBtn.querySelector('.crp-submit-label').innerHTML =
      '<span class="wl-ko">신청 완료하기</span><span class="wl-en">Submit Registration</span>';
    var waitlistNotice = document.getElementById('crpWaitlistNotice');
    if (waitlistNotice) waitlistNotice.hidden = true;
    updateCrpModalCap({ count: '…', countMale: 0, countFemale: 0 }, capacity);

    modal.hidden = false;
    document.body.style.overflow = 'hidden';

    try {
      var res = await fetch('/api/capacity/' + campId);
      if (res.ok) {
        var data = await res.json();
        if (requestId !== modalCapacityRequestId || modal.hidden) return;
        var subs = data.count ?? 0;
        currentRegisteredCount = data.submissions ?? subs;
        currentGenderSubs = { male: data.subsMale ?? 0, female: data.subsFemale ?? 0 };
        updateCrpModalCap({ count: subs, countMale: data.countMale ?? 0, countFemale: data.countFemale ?? 0 }, capacity);
        if (GENDER_CAPACITY[campId]) {
          updateGenderWaitlistNotice(); // 성별 정원이 있는 캠프는 남·여를 따로 보고 예비 안내를 한다
        } else if (subs >= capacity + WAITLIST_SIZE) {
          submitBtn.disabled = true;
          submitBtn.querySelector('.crp-submit-label').innerHTML =
            '<span class="wl-ko">신청이 마감되었습니다</span><span class="wl-en">Registration Closed</span>';
          if (waitlistNotice) waitlistNotice.hidden = true;
        } else if (subs >= capacity) {
          if (waitlistNotice) {
            waitlistNotice.querySelector('.crp-waitlist-num').textContent = subs - capacity + 1;
            waitlistNotice.hidden = false;
          }
          submitBtn.querySelector('.crp-submit-label').innerHTML =
            '<span class="wl-ko">예비 신청하기 →</span><span class="wl-en">Join Waitlist →</span>';
        } else {
          if (waitlistNotice) waitlistNotice.hidden = true;
        }
      }
    } catch(e) {
      if (requestId === modalCapacityRequestId && !modal.hidden) {
        updateCrpModalCap({ count: 0, countMale: 0, countFemale: 0 }, capacity);
      }
    }
  });
});

