          <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
        </svg>
      </button>

      <!-- 헤더 -->
      <div class="crp-modal-head">
        <div class="crp-modal-badge">
          <span class="wl-ko">캠프 신청</span><span class="wl-en">Camp Registration</span>
        </div>
        <div class="crp-modal-title" id="crpModalTitle"></div>
