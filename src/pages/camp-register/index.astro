                <span class="wl-ko">제주 캠프 네이버 카페 →</span>
                <span class="wl-en">Jeju Camp — Naver Cafe →</span>
              </a>
            </div>
            <div class="crp-reg-grid">
              {jejuCamps.map((s) => {
                const d = s.data;
                const type = typeLabel[d.camp_type] ?? { ko: d.camp_type, en: d.camp_type };
                const st = statusLabel[d.status] ?? { ko: d.status, en: d.status, cls: '' };
                const canRegister = d.status === 'open' && d.registration_url;
                return (
                  <div class="crp-reg-card">
                    <div class="crp-reg-card-top">
                      <span class="crp-type-badge">
                        <span class="wl-ko">{type.ko}</span>
                        <span class="wl-en">{type.en}</span>
                      </span>
                      <span class={`crp-status-badge crp-${st.cls}`}>
                        <span class="wl-ko">{st.ko}</span>
                        <span class="wl-en">{st.en}</span>
                      </span>
                    </div>
                    <h3 class="crp-reg-title">
                      <span class="wl-ko">{d.title_ko}</span>
                      <span class="wl-en">{d.title_en}</span>
                    </h3>
                    <div class="crp-reg-meta">
                      <div class="crp-reg-meta-row">
                        <span class="crp-reg-meta-label"><span class="wl-ko">일정</span><span class="wl-en">Dates</span></span>
                        <span class="crp-reg-meta-value"><span class="wl-ko">{d.date_ko}</span><span class="wl-en">{d.date_en}</span></span>
                      </div>
                      <div class="crp-reg-meta-row">
                        <span class="crp-reg-meta-label"><span class="wl-ko">대상</span><span class="wl-en">For</span></span>
                        <span class="crp-reg-meta-value"><span class="wl-ko">{d.target_ko}</span><span class="wl-en">{d.target_en}</span></span>
                      </div>
                      {(d.deadline_ko || d.deadline_en) && (
                        <div class="crp-reg-meta-row">
                          <span class="crp-reg-meta-label"><span class="wl-ko">신청 시작</span><span class="wl-en">Opens</span></span>
                          <span class="crp-reg-meta-value"><span class="wl-ko">{d.deadline_ko}</span><span class="wl-en">{d.deadline_en}</span></span>
                        </div>
                      )}
                      {(d.price_ko || d.price_en) && (
                        <div class="crp-reg-meta-row">
                          <span class="crp-reg-meta-label"><span class="wl-ko">참가비</span><span class="wl-en">Fee</span></span>
                          <span class="crp-reg-meta-value"><span class="wl-ko">{d.price_ko}</span><span class="wl-en">{d.price_en}</span></span>
                        </div>
                      )}
                    </div>
                    {(d.notes_ko || d.notes_en) && (
                      <p class="crp-reg-notes">
                        <span class="wl-ko">{d.notes_ko}</span>
                        <span class="wl-en">{d.notes_en}</span>
                      </p>
                    )}
                    {/* 정원 바 — 제주 캠프는 외부 신청이므로 항상 회색으로 표시 */}
                    <div class="crp-cap crp-cap--gray">
                      <div class="crp-cap-info">
                        <span>
                          <span class="wl-ko">전체 정원</span>
                          <span class="wl-en">Total Capacity</span>
                        </span>
                        <strong>{d.capacity ?? 40}<span class="wl-ko">명</span></strong>
                      </div>
                      <div class="crp-cap-track">
                        <div class="crp-cap-fill"></div>
                      </div>
                    </div>
                    {canRegister ? (
                      <a href={d.registration_url} target="_blank" rel="noopener" class="crp-reg-btn crp-reg-btn-primary">
                        <span class="wl-ko">신청서 작성하기 →</span>
                        <span class="wl-en">Register via Naver Cafe →</span>
                      </a>
                    ) : d.status === 'upcoming' && d.open_date ? (
                      <div class="crp-countdown" data-open-date={d.open_date}>
                        <div class="crp-countdown-label">
                          <span class="wl-ko">신청 오픈까지</span>
                          <span class="wl-en">Opens in</span>
                        </div>
                        <div class="crp-countdown-timer">
                          <div class="crp-cd-unit"><span class="crp-cd-num crp-cd-days">--</span><span class="crp-cd-label wl-ko">일</span><span class="crp-cd-label wl-en">d</span></div>
                          <span class="crp-cd-sep">:</span>
                          <div class="crp-cd-unit"><span class="crp-cd-num crp-cd-hours">--</span><span class="crp-cd-label wl-ko">시간</span><span class="crp-cd-label wl-en">h</span></div>
                          <span class="crp-cd-sep">:</span>
                          <div class="crp-cd-unit"><span class="crp-cd-num crp-cd-mins">--</span><span class="crp-cd-label wl-ko">분</span><span class="crp-cd-label wl-en">m</span></div>
                          <span class="crp-cd-sep">:</span>
                          <div class="crp-cd-unit"><span class="crp-cd-num crp-cd-secs">--</span><span class="crp-cd-label wl-ko">초</span><span class="crp-cd-label wl-en">s</span></div>
                        </div>
                        {d.registration_url && (
                          <a hidden href={d.registration_url} target="_blank" rel="noopener"
                            class="crp-reg-btn crp-reg-btn-primary crp-countdown-reveal-btn">
                            <span class="wl-ko">신청서 작성하기 →</span>
                            <span class="wl-en">Register via Naver Cafe →</span>
                          </a>
                        )}
                        <p class="crp-countdown-notice">
                          <span class="wl-ko">신청 버튼이 활성화되지 않을 시 서버 지연 문제이므로 5~10분 후에 다시 시도 부탁드립니다.</span>
                          <span class="wl-en">If the button doesn't appear, it may be due to server delay — please try again in 5–10 minutes.</span>
                        </p>
                      </div>
                    ) : d.status === 'upcoming' ? (
                      <span class="crp-reg-btn crp-reg-btn-disabled">
                        <span class="wl-ko">오픈 예정</span>
                        <span class="wl-en">Opening Soon</span>
                      </span>
                    ) : (
                      <span class="crp-reg-btn crp-reg-btn-disabled">
                        <span class="wl-ko">{d.status === 'full' ? '정원이 마감되었습니다' : '신청이 마감되었습니다'}</span>
                        <span class="wl-en">{d.status === 'full' ? 'Camp is Full' : 'Registration Closed'}</span>
                      </span>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </>
    ) : (
      <div class="crp-reg-empty reveal">
        <div class="crp-reg-empty-icon">✝</div>
        <h3 class="crp-reg-empty-title">
          <span class="wl-ko">현재 진행 중인 캠프 신청이 없습니다</span>
          <span class="wl-en">No Camp Registrations Currently Open</span>
