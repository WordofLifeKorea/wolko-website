/* ── 폼 제출 ── */
document.getElementById('crpForm').addEventListener('submit', async function(e) {
  e.preventDefault();
  errorMsg.hidden = true;

  var mediaChoice = document.querySelector('input[name="mediaConsent"]:checked');
  if (!mediaChoice) {
    document.getElementById('crpMediaConsent').classList.add('is-invalid');
    crpShowError(errorMsg, '사진·영상 공유 동의 여부(동의 또는 동의 안 함)를 선택해 주세요.', 'Please choose whether you agree to the photo/video sharing (Agree or Do not agree).');
    return;
  }
  var mediaConsent = mediaChoice.value;

  var consent = document.getElementById('crpConsent').checked;
  if (!consent) {
    crpShowError(errorMsg, '개인정보 수집 및 이용에 동의해 주세요.', 'Please agree to the privacy policy.');
    return;
  }
  var depositConsent = document.getElementById('crpDepositConsent').checked;
  if (!depositConsent) {
    crpShowError(errorMsg, '예약금과 캠프 참가비 입금 확인 후 최종 확정됨에 동의해 주세요.', 'Please confirm that you understand the deposit and camp fee requirements.');
    return;
  }
  var refundConsent = document.getElementById('crpRefundConsent').checked;
  if (!refundConsent) {
    crpShowError(errorMsg, '환불 규정을 읽어보았으며 이에 동의해 주세요.', 'Please read and agree to the refund policy.');
    return;
  }

  var payOnSite = document.getElementById('crpPayOnSite').checked;
  var refundBank = payOnSite ? '' : document.getElementById('crpRefundBank').value.trim();
  var refundAccount = payOnSite ? '' : document.getElementById('crpRefundAccount').value.trim();
  var refundHolder = payOnSite ? '' : document.getElementById('crpRefundHolder').value.trim();
  if (!payOnSite && (!refundBank || !refundAccount || !refundHolder)) {
    crpShowError(errorMsg, '환불을 위한 은행명, 계좌번호, 예금주를 모두 입력해 주세요.', 'Please enter the bank name, refund account number, and account holder.');
    return;
  }

  var currentType = regTypeInput.value;
  var payload;

  if (currentType === 'group') {
    var gName      = document.getElementById('crpGName').value.trim();
    var gPhone     = document.getElementById('crpGPhone').value.trim();
    var gEmail     = document.getElementById('crpGEmail').value.trim();
    var gTotal     = parseInt(document.getElementById('crpGCount').value) || 0;
    var gOrg       = document.getElementById('crpGOrg').value.trim();
    var isUnionCamp = crpIsUnionCampMode();
    var deferNames = isUnionCamp || document.getElementById('crpGDeferList').checked;
    var participants = deferNames ? [] : Array.from(document.querySelectorAll('.crp-group-participant')).map(function(row, rowIndex) {
      var entry = {
        name: row.querySelector('.crp-g-participant-name').value.trim(),
        gender: row.querySelector('.crp-g-participant-gender').value,
        birthDate: row.querySelector('.crp-g-participant-birth').value,
      };
      if (crpPerCamperMode()) {
        var schRow = crpCamperRows()[rowIndex];
        entry.scholarships = schRow ? crpCamperScholarshipKeys(schRow) : [];
        var sibInput = schRow && schRow.querySelector('.crp-gsch-sibling');
        if (sibInput && !sibInput.hidden && sibInput.value.trim()) entry.siblingName = sibInput.value.trim();
      }
      return entry;
    });
    var gMaleCount = deferNames ? 0 : participants.filter(function(p) { return p.gender === 'male'; }).length;
    var gFemCount  = deferNames ? 0 : participants.filter(function(p) { return p.gender === 'female'; }).length;

    if (!gName || !gPhone || !gOrg) {
      crpShowError(errorMsg, '담당자 이름, 연락 받을 번호, 소속은 필수 항목입니다.', 'Contact name, phone number, and organization are required.');
      return;
    }
    if (gTotal < 2) {
      crpShowError(errorMsg, '참여 인원을 2명 이상 선택해 주세요.', 'Please select at least 2 participants.');
      return;
    }
    var gRemaining = Math.max(0, (parseInt(campCapInput.value) || 40) - (currentRegisteredCount || 0));
    if (currentRegisteredCount !== null && gTotal > gRemaining) {
      crpShowError(errorMsg, '현재 잔여 정원은 ' + gRemaining + '명입니다. 참여 인원을 줄여 주세요.', 'Only ' + gRemaining + ' spots remain. Please reduce the number of participants.');
      return;
    }
    if (!deferNames && (participants.length !== gTotal || participants.some(function(p) { return !p.name || !p.gender; }))) {
      crpShowError(errorMsg, '모든 참가 학생의 이름과 성별을 입력해 주세요.', 'Please enter every participant name and gender.');
      return;
    }
    // 지원 연령이 정해진 캠프는 학생마다 생년월일이 꼭 필요하고 연령 범위 안이어야 한다.
    if (!deferNames) {
      for (var bi = 0; bi < participants.length; bi++) {
        var bc = birthYearCheck(campIdInput.value, participants[bi].birthDate);
        if (bc.ok) continue;
        var who = (bi + 1) + (participants[bi].name ? ' (' + participants[bi].name + ')' : '');
        var birthInput = document.querySelectorAll('.crp-group-participant')[bi].querySelector('.crp-g-participant-birth');
        birthInput.style.borderColor = '#c42a36';
        birthInput.scrollIntoView({ block: 'center', behavior: 'smooth' });
        birthInput.addEventListener('change', function clearBirthErr() { birthInput.style.borderColor = ''; birthInput.removeEventListener('change', clearBirthErr); });
        if (bc.reason === 'out-of-range') {
          crpShowError(errorMsg, '학생 ' + who + '의 출생연도가 이 캠프의 지원 연령(' + bc.range.min + '년생 ~ ' + bc.range.max + '년생)에 해당하지 않습니다. 문의를 남겨 주세요.', 'Participant ' + who + ' is outside this camp\'s age range (born ' + bc.range.min + ' – ' + bc.range.max + '). Please leave us an inquiry.');
        } else {
          crpShowError(errorMsg, '학생 ' + who + '의 생년월일을 선택해 주세요.', 'Please select the date of birth for participant ' + who + '.');
        }
        return;
      }
    }
    var groupScholarshipCounts = getScholarshipCounts();
    var groupScholarshipDetails = validateScholarshipDiscountDetails(groupScholarshipCounts);
    if (!groupScholarshipDetails) return;
    var groupScholarshipDiscountTotal = scholarshipDiscountAmount(groupScholarshipCounts);
    payload = {
      registrationType: 'group',
      campId: campIdInput.value,
      capacity: parseInt(campCapInput.value) || 40,
      capacityMale: currentCapMale || undefined,
      capacityFemale: currentCapFemale || undefined,
      name: gName, phone: gPhone, email: gEmail,
      maleCount: gMaleCount, femaleCount: gFemCount,
      groupCount: gTotal,
      participants: participants,
      participantDetailsDeferred: deferNames,
      mediaConsent: mediaConsent,
      refundBank: refundBank,
      refundAccount: refundAccount,
      refundHolder: refundHolder,
      payOnSite: payOnSite,
      referralSource: isUnionCamp ? document.getElementById('crpGReferralSource').value.trim() : '',
      scholarshipDiscounts: groupScholarshipCounts,
      scholarshipDiscountDetails: groupScholarshipDetails,
      scholarshipDiscountTotal: groupScholarshipDiscountTotal,
      campFeeBase: CAMP_BASE_FEE * gTotal,
      campFeeFinal: Math.max(0, (CAMP_BASE_FEE * gTotal) - groupScholarshipDiscountTotal),
      church: gOrg,
      notes: document.getElementById('crpGNotes').value.trim(),
    };
  } else {
    var name   = document.getElementById('crpName').value.trim();
    var phone  = document.getElementById('crpPhone').value.trim();
    var email  = document.getElementById('crpEmail').value.trim();
    var gender = document.getElementById('crpGender').value;

    if (!name || !phone) {
      crpShowError(errorMsg, '이름, 연락 받을 번호는 필수 항목입니다.', 'Name and phone number are required.');
      return;
    }
    if (!gender) {
      crpShowError(errorMsg, '성별을 선택해 주세요.', 'Please select gender.');
      return;
    }
    var birthDate = currentBirthDate();
    var birthCheck = birthYearCheck(campIdInput.value, birthDate);
    if (!birthCheck.ok) {
      if (birthCheck.reason === 'out-of-range') {
        updateBirthCheck();
        crpShowError(errorMsg, '입력하신 출생연도는 이 캠프의 지원 연령에 해당하지 않습니다. 아래 "문의 남기기"로 문의해 주세요.', 'The birth year you entered is outside this camp\'s age range. Please use "Leave an inquiry".');
        document.getElementById('crpBirthField').scrollIntoView({ block: 'center', behavior: 'smooth' });
      } else {
        crpShowError(errorMsg, '생년월일을 정확히 선택해 주세요.', 'Please select your date of birth.');
        document.getElementById('crpBirthYear').focus();
      }
      return;
    }
    var scholarshipDiscounts = getScholarshipCounts();
    var scholarshipDiscountDetails = validateScholarshipDiscountDetails(scholarshipDiscounts);
    if (!scholarshipDiscountDetails) return;
    var scholarshipDiscountTotal = scholarshipDiscountAmount(scholarshipDiscounts);
    payload = {
      registrationType: 'individual',
      campId: campIdInput.value,
      capacity: parseInt(campCapInput.value) || 40,
      capacityMale: currentCapMale || undefined,
      capacityFemale: currentCapFemale || undefined,
      name, phone, email, gender,
      ...(birthDate ? { birthDate: birthDate } : {}),
      church: document.getElementById('crpChurch').value.trim(),
      school: document.getElementById('crpSchool').value.trim(),
      emergency: document.getElementById('crpEmergency').value.trim(),
      mediaConsent: mediaConsent,
      refundBank: refundBank,
      refundAccount: refundAccount,
      refundHolder: refundHolder,
      payOnSite: payOnSite,
      scholarshipDiscounts: scholarshipDiscounts,
      scholarshipDiscountDetails: scholarshipDiscountDetails,
      scholarshipDiscountTotal: scholarshipDiscountTotal,
      campFeeBase: CAMP_BASE_FEE,
      campFeeFinal: Math.max(0, CAMP_BASE_FEE - scholarshipDiscountTotal),
      notes: document.getElementById('crpNotes').value.trim(),
    };
  }

  submitBtn.disabled = true;
  submitBtn.classList.add('loading');

  try {
    var res = await fetch('/api/register', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    var data = await res.json();

    if (res.ok && data.success) {
      if (data.pricing) {
        payload.campFeeBase = data.pricing.campFeeBase;
        payload.campFeeFinal = data.pricing.campFeeFinal;
        payload.scholarshipDiscountTotal = data.pricing.scholarshipDiscountAmount;
        payload.scholarshipDiscounts = data.pricing.scholarshipDiscounts;
      }
      formWrap.hidden = true;
      successWrap.hidden = false;

      var successMsg = document.getElementById('crpSuccessMsg');
      var successCount = document.getElementById('crpSuccessCount');
      var isEn = crpIsEn();
      var paymentBalance = 0;
      var paymentBalanceLabel = isEn ? 'KRW 0' : '0원';

      // 예약금 금액 표시 (단체는 인원 × 1인 예약금)
      var depositAmt = usesWinterCampPolicy(payload.campId) ? WINTER_CAMP_POLICY.deposit : (parseInt(campDepositInput.value) || 0);
      var groupCnt = currentType === 'group' ? (payload.groupCount || 1) : 1;
      var totalDeposit = depositAmt * groupCnt;
      var depositEl = document.getElementById('crpDepositAmount');
      var breakdownEl = document.getElementById('crpDepositBreakdown');
      if (depositEl) {
        depositEl.textContent = totalDeposit > 0
          ? (isEn ? 'KRW ' + totalDeposit.toLocaleString('en-US') : totalDeposit.toLocaleString('ko-KR') + '원')
          : '—';
      }
      if (breakdownEl) {
        breakdownEl.textContent = (currentType === 'group' && groupCnt > 1 && depositAmt > 0)
          ? (isEn
              ? '(KRW ' + depositAmt.toLocaleString('en-US') + ' × ' + groupCnt + ' ppl)'
              : '(' + depositAmt.toLocaleString('ko-KR') + '원 × ' + groupCnt + '명)')
          : '';
      }
      var feeSummaryEl = document.getElementById('crpSuccessFeeSummary');
      if (feeSummaryEl) {
        var baseFee = payload.campFeeBase || (CAMP_BASE_FEE * groupCnt);
        var discountTotal = payload.scholarshipDiscountTotal || 0;
        var finalFee = payload.campFeeFinal ?? Math.max(0, baseFee - discountTotal);
        paymentBalance = Math.max(0, finalFee - totalDeposit);
        paymentBalanceLabel = crpFormatWon(paymentBalance, isEn);
        document.getElementById('crpSuccessBaseFee').textContent = crpFormatWon(totalDeposit, isEn);
        document.getElementById('crpSuccessDiscountLabel').innerHTML = scholarshipDiscountSummaryHtml(payload.scholarshipDiscounts || {}, isEn);
        document.getElementById('crpSuccessDiscount').textContent = discountTotal > 0 ? '-' + crpFormatWon(discountTotal, isEn) : crpFormatWon(0, isEn);
        document.getElementById('crpSuccessDiscountRow').hidden = Object.keys(payload.scholarshipDiscounts || {}).length === 0;
        document.getElementById('crpSuccessFinalFee').textContent = crpFormatWon(finalFee, isEn);
        document.getElementById('crpSuccessBalanceFee').textContent = paymentBalanceLabel;
        feeSummaryEl.hidden = false;
      }

      var paymentNoticeKo = crpPaymentNoticeHtml(paymentBalanceLabel, false);
      var paymentNoticeEn = crpPaymentNoticeHtml(paymentBalanceLabel, true);

      if (currentType === 'group') {
        var gm = payload.maleCount, gf = payload.femaleCount, gc = payload.groupCount;
        successMsg.innerHTML = payload.participantDetailsDeferred
          ? (!crpIsUnionCampMode() ? (isEn
              ? 'Your group registration for <strong>' + gc + ' participants</strong> has been received. The participant list can be submitted later.<br>Please transfer the deposit below.'
              : '<strong>총 ' + gc + '명</strong>의 단체 신청이 접수되었습니다. 참가 학생 명단은 추후 제출해 주세요.<br>아래 계좌로 예약금을 입금해 주세요.') : (isEn
              ? 'Your union camp registration for <strong>' + gc + ' participants</strong> has been received.<br>Please transfer the deposit below.'
              : '<strong>총 ' + gc + '명</strong>의 연합캠프 신청이 접수되었습니다.<br>아래 계좌로 예약금을 입금해 주세요.'))
          : (isEn
              ? 'Your group registration for <strong>' + gc + ' participants</strong> (Male ' + gm + ' / Female ' + gf + ') has been received.<br>Please transfer the deposit below.'
              : '<strong>남학생 ' + gm + '명 · 여학생 ' + gf + '명 (총 ' + gc + '명)</strong>의 단체 신청이 접수되었습니다.<br>아래 계좌로 예약금을 입금해 주세요.');
        successCount.innerHTML = isEn ? paymentNoticeEn : paymentNoticeKo;
        // 단체: 입금자명을 담당자 성함으로 안내
        var bankNoteKo = document.getElementById('crpBankNoteKo');
        var bankNoteEn = document.getElementById('crpBankNoteEn');
        if (bankNoteKo) bankNoteKo.innerHTML = '입금자명을 <strong>담당자 성함 (' + payload.name + ')</strong>으로 해주세요.<br>입금 확인 후 담당자가 최종 확정 처리합니다.';
        if (bankNoteEn) bankNoteEn.innerHTML = 'Please use the <strong>contact person\'s name (' + payload.name + ')</strong> as the transfer memo.<br>Registration will be finalized after payment is verified.';
      } else {
        var genderLabel = payload.gender === 'male'
          ? (isEn ? 'Male' : '남학생')
          : (isEn ? 'Female' : '여학생');
        var camperName = payload.name || '';
        successMsg.innerHTML = isEn
          ? '<strong>' + camperName + '</strong> (' + genderLabel + ') registration has been received.<br>Please transfer the deposit below to complete your registration.'
          : '캠퍼 <strong>' + camperName + '</strong> (' + genderLabel + ') 신청이 접수되었습니다.<br>아래 계좌로 예약금을 입금해 주세요.';
        successCount.innerHTML = isEn ? paymentNoticeEn : paymentNoticeKo;
        // 개인: 입금자명을 캠퍼 이름으로 안내 (기본값 복원)
        var bankNoteKo2 = document.getElementById('crpBankNoteKo');
        var bankNoteEn2 = document.getElementById('crpBankNoteEn');
        if (bankNoteKo2) bankNoteKo2.innerHTML = '입금자명을 <strong>캠퍼 이름 (' + payload.name + ')</strong>으로 해주세요.<br>입금 확인 후 담당자가 최종 확정 처리합니다.';
        if (bankNoteEn2) bankNoteEn2.innerHTML = 'Please use the <strong>camper\'s name (' + payload.name + ')</strong> as the transfer memo.<br>Registration will be finalized after payment is verified.';
      }

      // pending 상태이므로 카드 카운터는 업데이트하지 않음 (확정 후 반영)

    } else {
      crpShowError(errorMsg, data.error || '오류가 발생했습니다. 다시 시도해 주세요.', 'An error occurred. Please try again.');
      submitBtn.disabled = false;
      submitBtn.classList.remove('loading');
    }
  } catch(err) {
    crpShowError(errorMsg, '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.', 'Network error. Please try again.');
    submitBtn.disabled = false;
    submitBtn.classList.remove('loading');
  }
});

/* ── 카운트다운 타이머 ── */
function pad(n) { return String(n).padStart(2, '0'); }

document.querySelectorAll('.crp-countdown[data-open-date]').forEach(function(cd) {
  var openDate = new Date(cd.dataset.openDate).getTime();
  var daysEl  = cd.querySelector('.crp-cd-days');
  var hoursEl = cd.querySelector('.crp-cd-hours');
  var minsEl  = cd.querySelector('.crp-cd-mins');
  var secsEl  = cd.querySelector('.crp-cd-secs');
  var timerEl = cd.querySelector('.crp-countdown-timer');
  var labelEl = cd.querySelector('.crp-countdown-label');

  function reveal() {
    // 카운트다운 숨기고 신청 버튼 표시
    if (timerEl) timerEl.hidden = true;
    if (labelEl) labelEl.hidden = true;
    var revealBtn = cd.querySelector('[hidden].crp-open-btn, [hidden].crp-countdown-reveal-btn');
    if (revealBtn) revealBtn.hidden = false;
    // 상태 배지도 "신청 중"으로
    var card = cd.closest('.crp-reg-card');
    if (card) {
      var badge = card.querySelector('.crp-status-badge');
      if (badge) {
        badge.className = 'crp-status-badge crp-status-open';
        badge.innerHTML = '<span class="wl-ko">신청 중</span><span class="wl-en">Open</span>';
      }
      // 정원 바 활성화: upcoming → open 전환 시 실시간 신청 현황 표시
      var capDiv = card.querySelector('.crp-cap');
      if (capDiv && revealBtn && revealBtn.dataset.campId) {
        var cid = revealBtn.dataset.campId;
        var cap = parseInt(revealBtn.dataset.capacity) || 40;
        capDiv.setAttribute('data-cap-id', cid);
        capDiv.classList.remove('crp-cap--gray');
        var capInfo = capDiv.querySelector('.crp-cap-info');
        if (capInfo) {
          var capSpan = capInfo.querySelector('span');
          if (capSpan) capSpan.innerHTML = '<span class="wl-ko">신청 현황</span><span class="wl-en">Spots Filled</span>';
          var capStrong = capInfo.querySelector('strong');
          if (capStrong) capStrong.innerHTML = '<span class="crp-cap-count">—</span> / ' + cap + '<span class="wl-ko">명</span>';
        }
        fetch('/api/capacity/' + cid).then(function(r) { return r.ok ? r.json() : null; }).then(function(data) {
          if (!data) return;
          updateCrpCapBar(capDiv, {
            count: data.count || 0,
            countMale: data.countMale || 0,
            countFemale: data.countFemale || 0
          }, cap);
        }).catch(function() {});
      }
    }
  }

  function tick() {
    var diff = openDate - Date.now();
    if (diff <= 0) { reveal(); return; }
    var d = Math.floor(diff / 86400000);
    var h = Math.floor((diff % 86400000) / 3600000);
    var m = Math.floor((diff % 3600000) / 60000);
    var s = Math.floor((diff % 60000) / 1000);
    if (daysEl)  daysEl.textContent  = pad(d);
    if (hoursEl) hoursEl.textContent = pad(h);
    if (minsEl)  minsEl.textContent  = pad(m);
    if (secsEl)  secsEl.textContent  = pad(s);
  }

  tick(); // 즉시 첫 렌더
  var interval = setInterval(function() {
    if (openDate - Date.now() <= 0) {
      clearInterval(interval);
      reveal();
    } else {
      tick();
    }
  }, 1000);
});

/* ══ STAFF MODAL ══ */
(function() {
  var staffModal      = document.getElementById('staffModal');
  var staffForm       = document.getElementById('staffForm');
  var staffFormWrap   = document.getElementById('staffFormWrap');
  var staffSuccessWrap= document.getElementById('staffSuccessWrap');
  var staffErrorMsg   = document.getElementById('staffErrorMsg');
  var staffSubmitBtn  = document.getElementById('staffSubmitBtn');
  var draftNotice     = document.getElementById('staffDraftNotice');
  var draftNoticeText = document.getElementById('staffDraftNoticeText');
  var draftBtn        = document.getElementById('staffDraftBtn');

  // 임시 저장은 서버가 아니라 이 브라우저(localStorage)에만 둔다 — 로그인 없이
  // 쓰는 공개 폼이라 기기를 옮기면 이어 쓸 수 없지만, 따로 계정이 필요 없다.
  var DRAFT_KEY = 'wolko-staff-application-draft-v1';
  var DRAFT_FIELDS = ['staffName', 'staffGender', 'staffBirthYear', 'staffBirthMonth', 'staffBirthDay', 'staffPhone', 'staffEmail',
    'staffIntro', 'staffFaith', 'staffChurch', 'staffChurchWebsite', 'staffPastorName', 'staffPastorContact', 'staffInstruments',
    'staffPreviousCampDetail', 'staffTeam1', 'staffTeam2', 'staffNotes',
    'staffGuardianName', 'staffGuardianRelation', 'staffGuardianPhone', 'staffGuardianEmail'];
  var DRAFT_RADIOS = ['cultHistory', 'englishAbility', 'mediaTech', 'previousCamp'];
  var formDirty = false;

  // 스태프(고등학교 졸업 성인) / 크루(미성년자 — 보호자 동의 링크가 가고, 동의가 끝나야 수락된다)
  var staffRole = 'staff';
  var ROLE_TITLE = { staff: ['캠프 스태프 지원서', 'Camp Staff Application'], crew: ['캠프 크루 지원서', 'Camp Crew Application'] };
  function setStaffRole(role) {
    staffRole = role === 'crew' ? 'crew' : 'staff';
    document.querySelectorAll('.staff-role-tabs .crp-type-tab').forEach(function(tab) {
      var on = tab.dataset.role === staffRole;
      tab.classList.toggle('active', on);
      tab.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
    byId('staffGuardianSection').hidden = staffRole !== 'crew';
    byId('staffModalTitle').innerHTML = '<span class="wl-ko">' + ROLE_TITLE[staffRole][0] + '</span><span class="wl-en">' + ROLE_TITLE[staffRole][1] + '</span>';
    var submitKo = staffSubmitBtn.querySelector('.crp-submit-label .wl-ko');
    if (submitKo) submitKo.textContent = staffRole === 'crew' ? '크루 지원하기' : '스태프 지원하기';
  }
  document.querySelectorAll('.staff-role-tabs .crp-type-tab').forEach(function(tab) {
    tab.addEventListener('click', function() {
      if (tab.dataset.role === staffRole) return;
      setStaffRole(tab.dataset.role);
      formDirty = true;
      staffErrorMsg.hidden = true;
    });
  });

  function byId(id) { return document.getElementById(id); }
  function escHtml(value) {
    return String(value == null ? '' : value).replace(/[&<>"']/g, function(ch) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
    });
  }
  function radioValue(name) {
    var checked = staffForm.querySelector('input[name="' + name + '"]:checked');
    return checked ? checked.value : '';
  }
  function checkedCampInputs() {
    return Array.prototype.slice.call(staffForm.querySelectorAll('input[name="staffCamp"]:checked'));
  }

  function populateStaffBirthSelects() {
    var yearEl = byId('staffBirthYear');
    var monthEl = byId('staffBirthMonth');
    var dayEl = byId('staffBirthDay');
    if (!yearEl || yearEl.dataset.ready) return;

    var currentYear = new Date().getFullYear();
    for (var year = currentYear; year >= 1940; year--) {
      yearEl.insertAdjacentHTML('beforeend', '<option value="' + year + '">' + year + '</option>');
    }
    for (var month = 1; month <= 12; month++) {
      var mm = String(month).padStart(2, '0');
      monthEl.insertAdjacentHTML('beforeend', '<option value="' + mm + '">' + mm + '</option>');
    }
    for (var day = 1; day <= 31; day++) {
      var dd = String(day).padStart(2, '0');
      dayEl.insertAdjacentHTML('beforeend', '<option value="' + dd + '">' + dd + '</option>');
    }
    yearEl.dataset.ready = 'true';
  }

  populateStaffBirthSelects();

  // 스태프 지원은 캠프가 공개된 순간부터 열려 있고, 캠프 시작일(한국 시간) 0시에 닫힌다.
  // 관리자가 staff_registration_open으로 따로 열어둔 캠프는 예외.
  function staffCampOptions() {
    var todayKst = new Date(Date.now() + 9 * 3600 * 1000).toISOString().slice(0, 10);
    return Array.prototype.slice.call(document.querySelectorAll('#staffCampOptions li')).filter(function(li) {
      if (li.dataset.staffRegistrationOpen === 'true') return true;
      var startDay = (li.dataset.startDate || '').slice(0, 10);
      return !startDay || todayKst < startDay;
    });
  }

  // 지역 카드: 열린 캠프가 하나도 없으면 버튼을 잠근다.
  document.querySelectorAll('.crp-staff-card--group').forEach(function(card) {
    var region = card.dataset.region;
    var hasOpen = staffCampOptions().some(function(li) { return li.dataset.region === region; });
    var btn = card.querySelector('.crp-staff-open-btn');
    if (!hasOpen && btn) {
      btn.disabled = true;
      btn.innerHTML = '<span class="wl-ko">마감</span><span class="wl-en">Closed</span>';
    }
  });

  // "섬길 수 있는 캠프" — 열려 있는 캠프를 지역별로 묶어 날짜와 함께 보여준다.
  var REGION_LABEL = { inland: ['월코 센터 캠프', 'WOLKO Center Camps'], partner: ['교회 및 학교 캠프', 'Church and School Camps'], jeju: ['제주캠프 · 월비캠퍼스', 'Jeju Camp · WOLBI Campus'] };
  function renderCampChips(checkedIds) {
    var options = staffCampOptions();
    var html = '';
    ['inland', 'partner', 'jeju'].forEach(function(region) {
      var items = options.filter(function(li) { return li.dataset.group === region; });
      if (!items.length) return;
      html += '<div class="staff-camp-group"><div class="staff-camp-group-title"><span class="wl-ko">' + REGION_LABEL[region][0] + '</span><span class="wl-en">' + REGION_LABEL[region][1] + '</span></div><div class="staff-camp-list">';
      items.forEach(function(li) {
        var d = li.dataset;
        html += '<label class="staff-camp-option"><input type="checkbox" name="staffCamp" value="' + escHtml(d.campId) + '" data-name-ko="' + escHtml(d.nameKo) + '" data-commitment="' + (d.commitment === 'true' ? 'true' : 'false') + '"' +
          (checkedIds.indexOf(d.campId) !== -1 ? ' checked' : '') + '>' +
          '<span class="staff-camp-option-name"><span class="wl-ko">' + escHtml(d.nameKo) + '</span><span class="wl-en">' + escHtml(d.nameEn || d.nameKo) + '</span></span>' +
          '<span class="staff-camp-option-date"><span class="wl-ko">' + escHtml(d.dateKo) + '</span><span class="wl-en">' + escHtml(d.dateEn || d.dateKo) + '</span></span></label>';
      });
      html += '</div></div>';
    });
    byId('staffCampChips').innerHTML = html ||
      '<span class="staff-camp-empty"><span class="wl-ko">지금 지원할 수 있는 캠프가 없습니다.</span><span class="wl-en">No camps are open right now.</span></span>';
  }

  // 2주 헌신 안내는 준비 주간이 있는 캠프(staff_commitment_required)를 체크했을 때만 보여준다.
  function syncCommitmentBox() {
    var show = checkedCampInputs().some(function(input) { return input.dataset.commitment === 'true'; });
    byId('staffCommitmentBox').hidden = !show;
    if (!show) { byId('staffCommitment').checked = false; byId('staffTrainingException').checked = false; }
  }

  function syncPreviousCampDetail() {
    byId('staffPreviousCampDetailField').hidden = radioValue('previousCamp') !== 'yes';
  }

  // ── 임시 저장 ──
  function readDraft() {
    try { return JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null'); } catch (e) { return null; }
  }
  function writeDraft(draft) {
    try { localStorage.setItem(DRAFT_KEY, JSON.stringify(draft)); return true; } catch (e) { return false; }
  }
  function clearDraft() {
    try { localStorage.removeItem(DRAFT_KEY); } catch (e) {}
  }
  function collectDraft() {
    var draft = { role: staffRole, fields: {}, radios: {}, camps: [], savedAt: new Date().toISOString() };
    DRAFT_FIELDS.forEach(function(id) { draft.fields[id] = byId(id).value; });
    DRAFT_RADIOS.forEach(function(name) { draft.radios[name] = radioValue(name); });
    draft.camps = checkedCampInputs().map(function(input) { return input.value; });
    return draft;
  }
  function applyDraft(draft) {
    DRAFT_FIELDS.forEach(function(id) {
      if (draft.fields && typeof draft.fields[id] === 'string') byId(id).value = draft.fields[id];
    });
    DRAFT_RADIOS.forEach(function(name) {
      var value = draft.radios ? draft.radios[name] : '';
      staffForm.querySelectorAll('input[name="' + name + '"]').forEach(function(radio) { radio.checked = radio.value === value; });
    });
  }
  function draftTime(iso, locale) {
    try {
      return new Date(iso).toLocaleString(locale, { month: 'long', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    } catch (e) { return ''; }
  }
  function showDraftNotice(savedAt) {
    var ko = draftTime(savedAt, 'ko-KR');
    var en = draftTime(savedAt, 'en-US');
    draftNoticeText.innerHTML =
      '<span class="wl-ko">임시 저장한 내용을 불러왔어요' + (ko ? ' · ' + escHtml(ko) : '') + '</span>' +
      '<span class="wl-en">Your saved draft was restored' + (en ? ' · ' + escHtml(en) : '') + '</span>';
    draftNotice.hidden = false;
  }
  function clearFieldErrors() {
    staffForm.querySelectorAll('.error').forEach(function(node) { node.classList.remove('error'); });
    staffForm.querySelectorAll('.is-invalid').forEach(function(node) { node.classList.remove('is-invalid'); });
  }

  draftBtn.addEventListener('click', function() {
    if (!writeDraft(collectDraft())) {
      crpShowError(staffErrorMsg, '이 브라우저에서는 임시 저장을 할 수 없습니다.', 'Drafts cannot be saved in this browser.');
      return;
    }
    formDirty = false;
    staffErrorMsg.hidden = true;
    draftBtn.innerHTML = '<span class="wl-ko">저장했어요</span><span class="wl-en">Saved</span>';
    clearTimeout(draftBtn._resetTimer);
    draftBtn._resetTimer = setTimeout(function() {
      draftBtn.innerHTML = '<span class="wl-ko">임시 저장</span><span class="wl-en">Save Draft</span>';
    }, 2000);
  });

  byId('staffDraftDiscard').addEventListener('click', function() {
    if (!confirm(crpText('임시 저장한 내용을 지우고 새로 작성할까요?', 'Discard the saved draft and start over?'))) return;
    clearDraft();
    staffForm.reset();
    setStaffRole('staff');
    renderCampChips([]);
    syncPreviousCampDetail(); syncCommitmentBox();
    clearFieldErrors();
    draftNotice.hidden = true;
    staffErrorMsg.hidden = true;
    formDirty = false;
  });

  staffForm.addEventListener('input', function(e) {
    formDirty = true;
    if (e.target.classList) e.target.classList.remove('error');
  });
  staffForm.addEventListener('change', function(e) {
    formDirty = true;
    if (e.target.name === 'previousCamp') syncPreviousCampDetail();
    if (e.target.name === 'staffCamp') syncCommitmentBox();
    // 2주 참여 동의와 트레이닝 불참은 둘 중 하나만 고른다.
    if (e.target.id === 'staffCommitment' && e.target.checked) byId('staffTrainingException').checked = false;
    if (e.target.id === 'staffTrainingException' && e.target.checked) byId('staffCommitment').checked = false;
    var chips = e.target.closest ? e.target.closest('.staff-team-chips, #staffCampChips, #staffCommitmentBox') : null;
    if (chips) chips.classList.remove('is-invalid');
    if (e.target.classList) e.target.classList.remove('error');
  });

  // 모달 열기 — 임시 저장본이 있으면 채워 넣는다.
  document.querySelectorAll('.crp-staff-open-btn').forEach(function(btn) {
    btn.addEventListener('click', function() {
      if (btn.disabled) return;
      staffForm.reset();
      clearFieldErrors();
      draftNotice.hidden = true;
      var draft = readDraft();
      var camps = draft && Array.isArray(draft.camps) ? draft.camps.slice() : [];
      renderCampChips(camps);
      setStaffRole(draft && draft.role === 'crew' ? 'crew' : 'staff');
      if (draft) {
        applyDraft(draft);
        showDraftNotice(draft.savedAt);
      }
      syncPreviousCampDetail(); syncCommitmentBox();
      formDirty = false;
      staffFormWrap.hidden  = false;
      staffSuccessWrap.hidden = true;
      staffErrorMsg.hidden  = true;
      staffSubmitBtn.disabled = false;
      staffSubmitBtn.classList.remove('loading');
      staffModal.hidden = false;
      document.body.style.overflow = 'hidden';
    });
  });

  // QR·링크용 앵커: /camp-register/#staff-apply 로 들어오면 스태프 지원서 모달을 바로 연다.
  function openStaffFromHash() {
    if (location.hash !== '#staff-apply') return;
    var openBtn = document.querySelector('.crp-staff-open-btn:not([disabled])');
    if (openBtn && staffModal.hidden) openBtn.click();
  }
  openStaffFromHash();
  window.addEventListener('hashchange', openStaffFromHash);
  // 카드 이미지·레이아웃이 자리잡은 뒤에도 #staff-recruit 위치가 어긋나지 않도록 한 번 더 맞춘다.
  function scrollToStaffBanner() {
    if (location.hash !== '#staff-recruit') return;
    var el = document.getElementById('staff-recruit');
    if (el) el.scrollIntoView({ block: 'start', behavior: 'instant' });
  }
  scrollToStaffBanner();
  [150, 700].forEach(function(ms) { setTimeout(scrollToStaffBanner, ms); });
  window.addEventListener('load', function() { setTimeout(scrollToStaffBanner, 150); });
  window.addEventListener('hashchange', scrollToStaffBanner);

  // 모달 닫기 — 저장 안 한 입력이 있으면 한 번 묻는다(긴 폼이 실수로 날아가지 않게).
  function closeStaffModal(force) {
    if (!force && formDirty && !staffFormWrap.hidden &&
        !confirm(crpText('작성 중인 내용이 있어요. 임시 저장하지 않고 닫으면 사라집니다. 닫을까요?', 'You have unsaved changes. Close without saving a draft?'))) {
      return;
    }
    staffModal.hidden = true;
    document.body.style.overflow = '';
  }
  byId('staffOverlay').addEventListener('click', function() { closeStaffModal(false); });
  byId('staffCloseBtn').addEventListener('click', function() { closeStaffModal(false); });
  byId('staffSuccessClose').addEventListener('click', function() { closeStaffModal(true); });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !staffModal.hidden) closeStaffModal(false);
  });

  // 빠진 항목으로 스크롤하고 빨갛게 표시한다. key는 입력칸 id 또는 예/아니오 라디오 name.
  function markInvalid(key) {
    var target = byId(key);
    if (target && target.type !== 'checkbox') {
      target.classList.add('error');
    } else {
      var input = target || staffForm.querySelector('input[name="' + key + '"]');
      var chips = key === 'staffCamp' ? byId('staffCampChips')
        : key === 'staffCommitment' ? byId('staffCommitmentBox')
        : input ? input.closest('.staff-team-chips') : null;
      target = chips || input;
      if (chips) chips.classList.add('is-invalid');
    }
    if (target && target.scrollIntoView) target.scrollIntoView({ block: 'center', behavior: 'smooth' });
    if (target && target.focus && /^(INPUT|SELECT|TEXTAREA)$/.test(target.tagName)) target.focus({ preventScroll: true });
  }

  // 폼 제출
  staffForm.addEventListener('submit', async function(e) {
    e.preventDefault();
    staffErrorMsg.hidden = true;
    clearFieldErrors();

    function text(id) { return byId(id).value.trim(); }
    var birthYear  = byId('staffBirthYear').value;
    var birthMonth = byId('staffBirthMonth').value;
    var birthDay   = byId('staffBirthDay').value;
    var camps = checkedCampInputs();
    var payload = {
      name: text('staffName'),
      gender: byId('staffGender').value,
      birthDate: birthYear && birthMonth && birthDay ? birthYear + '-' + birthMonth + '-' + birthDay : '',
      phone: text('staffPhone'),
      email: text('staffEmail'),
      introduction: text('staffIntro'),
      faithStory: text('staffFaith'),
      church: text('staffChurch'),
      churchWebsite: text('staffChurchWebsite'),
      pastorName: text('staffPastorName'),
      pastorContact: text('staffPastorContact'),
      cultHistory: radioValue('cultHistory'),
      englishAbility: radioValue('englishAbility'),
      mediaTech: radioValue('mediaTech'),
      instruments: text('staffInstruments'),
      previousCamp: radioValue('previousCamp'),
      previousCampDetail: radioValue('previousCamp') === 'yes' ? text('staffPreviousCampDetail') : '',
      team1: byId('staffTeam1').value,
      team2: byId('staffTeam2').value,
      availableCamps: camps.map(function(input) { return input.value; }),
      availableCampNames: camps.map(function(input) { return input.dataset.nameKo || input.value; }),
      notes: text('staffNotes'),
      commitment: byId('staffCommitment').checked,
      trainingException: byId('staffTrainingException').checked,
      role: staffRole,
    };
    var isCrew = staffRole === 'crew';
    if (isCrew) {
      payload.guardianName = text('staffGuardianName');
      payload.guardianRelation = byId('staffGuardianRelation').value;
      payload.guardianPhone = text('staffGuardianPhone');
      payload.guardianEmail = text('staffGuardianEmail');
    }

    // 위에서부터 차례로 확인해서, 처음 빠진 항목 하나만 알려준다.
    var checks = [
      [!payload.name, 'staffName', '이름을 입력해 주세요.', 'Please enter your name.'],
      [!payload.gender, 'staffGender', '성별을 선택해 주세요.', 'Please select your gender.'],
      [!payload.birthDate, 'staffBirthYear', '생년월일을 선택해 주세요.', 'Please select your date of birth.'],
      [!payload.phone, 'staffPhone', '연락 가능한 전화번호를 입력해 주세요.', 'Please enter your phone number.'],
      [!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.email), 'staffEmail', '이메일 주소를 정확히 입력해 주세요.', 'Please enter a valid email address.'],
      [isCrew && !payload.guardianName, 'staffGuardianName', '보호자 성함을 입력해 주세요.', "Please enter your guardian's name."],
      [isCrew && !payload.guardianRelation, 'staffGuardianRelation', '보호자와의 관계를 선택해 주세요.', 'Please select your relationship to the guardian.'],
      [isCrew && !payload.guardianPhone && !payload.guardianEmail, 'staffGuardianPhone', '보호자 휴대폰 번호 또는 이메일 중 하나 이상 입력해 주세요.', "Please enter your guardian's mobile number or email."],
      [isCrew && payload.guardianEmail && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(payload.guardianEmail), 'staffGuardianEmail', '보호자 이메일 주소를 정확히 입력해 주세요.', "Please enter a valid guardian email."],
      [!payload.introduction, 'staffIntro', '간단한 자기소개를 입력해 주세요.', 'Please write a brief self-introduction.'],
      [!payload.faithStory, 'staffFaith', '언제, 어떻게 예수님을 믿게 되었는지 적어 주세요.', 'Please share when and how you came to believe in Jesus.'],
      [!payload.church, 'staffChurch', '출석 교회를 입력해 주세요. 없으면 "없음"이라고 적어 주세요.', 'Please enter your church, or "None" if you don\'t attend one.'],
      [!payload.cultHistory, 'cultHistory', '하나님의 교회·신천지 참여 여부를 선택해 주세요.', 'Please answer the question about Church of God / Shincheonji.'],
      [!payload.englishAbility, 'englishAbility', '일상 생활 영어 수준을 0~5 중에서 선택해 주세요.', 'Please rate your everyday English from 0 to 5.'],
      [!payload.mediaTech, 'mediaTech', '미디어·테크 수준을 0~5 중에서 선택해 주세요.', 'Please rate your media/tech skills from 0 to 5.'],
      [!payload.previousCamp, 'previousCamp', '기독교 캠프 봉사 경험 여부를 선택해 주세요.', 'Please answer whether you have served at a Christian camp.'],
      [payload.previousCamp === 'yes' && !payload.previousCampDetail, 'staffPreviousCampDetail', '캠프 봉사 경험을 자세히 나눠 주세요.', 'Please share details of your camp service.'],
      [!payload.team1, 'staffTeam1', '선호하는 팀(1지망)을 선택해 주세요.', 'Please choose your 1st-choice team.'],
      [payload.team2 && payload.team2 === payload.team1, 'staffTeam2', '2지망은 1지망과 다른 팀으로 선택해 주세요.', 'Your 2nd choice must differ from your 1st choice.'],
      [!payload.availableCamps.length, 'staffCamp', '섬길 수 있는 캠프를 하나 이상 선택해 주세요.', 'Please select at least one camp you can serve.'],
      [!byId('staffCommitmentBox').hidden && !payload.commitment && !payload.trainingException, 'staffCommitment', '약 2주간 참여에 동의하거나, 캠프 트레이닝 불참 사유가 있으면 해당 항목을 체크해 주세요.', 'Please agree to the 2-week commitment, or check the box if you cannot attend camp training.'],
      [payload.trainingException && !payload.notes, 'staffNotes', '캠프 트레이닝에 참여할 수 없는 사유를 참고 사항에 간단히 적어 주세요.', 'Please briefly explain in the notes why you cannot attend camp training.'],
      [!byId('staffPrivacyConsent').checked, 'staffPrivacyConsent', '개인정보 수집 및 이용에 동의해 주세요.', 'Please consent to the privacy policy.'],
    ];
    for (var i = 0; i < checks.length; i++) {
      if (checks[i][0]) {
        crpShowError(staffErrorMsg, checks[i][2], checks[i][3]);
        markInvalid(checks[i][1]);
        return;
      }
    }

    staffSubmitBtn.disabled = true;
    staffSubmitBtn.classList.add('loading');

    try {
      var res = await fetch('/api/staff-register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });
      var data = await res.json();

      if (res.ok && data.success) {
        clearDraft();
        formDirty = false;
        staffFormWrap.hidden   = true;
        staffSuccessWrap.hidden = false;
        var isEn = crpIsEn();
        if (isCrew) {
          var sentKo = (data.consentSent || []).map(function(v) { return v === 'sms' ? '문자' : '이메일'; }).join('·');
          var sentEn = (data.consentSent || []).map(function(v) { return v === 'sms' ? 'text' : 'email'; }).join(' and ');
          byId('staffSuccessMsg').innerHTML = isEn
            ? '<strong>' + escHtml(payload.name) + '</strong>, your crew application has been received.<br>' +
              (sentEn ? 'A consent link was sent to your guardian by ' + sentEn + '.' : 'We will send the consent link to your guardian shortly.') +
              ' Your application can be accepted once your guardian agrees.'
            : '<strong>' + escHtml(payload.name) + '</strong>님의 크루 지원이 접수되었습니다.<br>' +
              (sentKo ? '보호자께 ' + sentKo + '로 동의 링크를 보냈어요.' : '보호자께 동의 링크를 곧 보내 드릴게요.') +
              ' 보호자가 동의하시면 검토 후 연락드립니다.';
        } else {
          byId('staffSuccessMsg').innerHTML = isEn
            ? '<strong>' + escHtml(payload.name) + '</strong>, your staff application has been received.<br>Our team will contact you individually regarding your service area.'
            : '<strong>' + escHtml(payload.name) + '</strong>님의 스태프 지원이 접수되었습니다.<br>섬기실 분야에 대해 담당자가 개별적으로 연락드릴 예정입니다.';
        }
      } else {
        crpShowError(staffErrorMsg, data.error || '오류가 발생했습니다. 다시 시도해 주세요.', 'An error occurred. Please try again.');
        staffSubmitBtn.disabled = false;
        staffSubmitBtn.classList.remove('loading');
      }
    } catch(err) {
      crpShowError(staffErrorMsg, '네트워크 오류가 발생했습니다. 잠시 후 다시 시도해 주세요.', 'Network error. Please try again.');
      staffSubmitBtn.disabled = false;
      staffSubmitBtn.classList.remove('loading');
    }
  });
})();

/* ── Placeholder & select-option 언어 동기화 ── */
(function() {
  function syncLang() {
    var en = crpIsEn();
    renderScholarshipYearOptions();
    // input / textarea placeholder
    document.querySelectorAll('[data-ph-ko]').forEach(function(el) {
      el.placeholder = en ? (el.dataset.phEn || '') : (el.dataset.phKo || '');
    });
    // select 기본 옵션 텍스트
    document.querySelectorAll('select[data-opt-ko]').forEach(function(el) {
      if (el.options[0]) {
        el.options[0].textContent = en ? el.dataset.optEn : el.dataset.optKo;
      }
      Array.prototype.forEach.call(el.querySelectorAll('optgroup'), function(group) {
        if (group.dataset.ko && group.dataset.en) {
          group.label = en ? group.dataset.en : group.dataset.ko;
        }
      });
      Array.prototype.forEach.call(el.options, function(option) {
        if (option.dataset.ko && option.dataset.en) {
          option.textContent = en ? option.dataset.en : option.dataset.ko;
        }
      });
    });
    var participantWrap = document.getElementById('crpGParticipants');
    if (participantWrap && participantWrap.children.length) renderGroupParticipants();
    if (modal && !modal.hidden) {
      var campBtn = document.querySelector('.crp-open-btn[data-camp-id="' + campIdInput.value + '"]');
      if (campBtn) modalTitle.textContent = en ? (campBtn.dataset.campNameEn || '') : (campBtn.dataset.campNameKo || '');
      if (currentModalCapData) updateCrpModalCap(currentModalCapData, currentModalCapacity);
    }
    [errorMsg, document.getElementById('staffErrorMsg')].forEach(function(el) {
      if (el && !el.hidden && el.dataset.errKo && el.dataset.errEn) {
        el.textContent = en ? el.dataset.errEn : el.dataset.errKo;
      }
    });
    updateScholarshipSummary();
  }
  syncLang();
  var langRoot = document.getElementById('lang-root') || document.body || document.documentElement;
  if (langRoot) {
    new MutationObserver(syncLang).observe(langRoot, { attributes: true, attributeFilter: ['class'] });
  }
})();

/* Local-only success screen preview: /camp-register/?preview=success */
(function() {
  var params = new URLSearchParams(window.location.search);
  var localPreviewHost = ['127.0.0.1', 'localhost'].includes(window.location.hostname);
  if (!localPreviewHost || params.get('preview') !== 'success') return;

  window.setTimeout(function() {
    var modal = document.getElementById('crpModal');
    var formWrapEl = document.getElementById('crpFormWrap');
    var successWrapEl = document.getElementById('crpSuccessWrap');
    if (!modal || !formWrapEl || !successWrapEl) return;

    var isEn = crpIsEn();
    var deposit = 40000;
    var baseFee = CAMP_BASE_FEE;
    var discount = 50000;
    var finalFee = Math.max(0, baseFee - discount);
    var balance = Math.max(0, finalFee - deposit);
    var balanceLabel = crpFormatWon(balance, isEn);

    modal.hidden = false;
    formWrapEl.hidden = true;
    successWrapEl.hidden = false;
    document.body.style.overflow = 'hidden';

    document.getElementById('crpModalTitle').textContent = isEn
      ? '2026 WOLKO Summer Junior English Camp'
      : '2026 여름 월코 주니어 영어캠프';
    document.getElementById('crpSuccessMsg').innerHTML = isEn
      ? '<strong>Preview Camper</strong> (Male) registration has been received.<br>Please transfer the deposit below to complete your registration.'
      : '캠퍼 <strong>미리보기 캠퍼</strong> (남학생) 신청이 접수되었습니다.<br>아래 계좌로 예약금을 입금해 주세요.';
    document.getElementById('crpDepositAmount').textContent = crpFormatWon(deposit, isEn);
    document.getElementById('crpDepositBreakdown').textContent = '';
    document.getElementById('crpSuccessBaseFee').textContent = crpFormatWon(deposit, isEn);
    document.getElementById('crpSuccessDiscountLabel').innerHTML = scholarshipDiscountSummaryHtml({ wolbi_syme: 1 }, isEn);
    document.getElementById('crpSuccessDiscount').textContent = '-' + crpFormatWon(discount, isEn);
    document.getElementById('crpSuccessDiscountRow').hidden = discount <= 0;
    document.getElementById('crpSuccessFinalFee').textContent = crpFormatWon(finalFee, isEn);
    document.getElementById('crpSuccessBalanceFee').textContent = balanceLabel;
    document.getElementById('crpSuccessFeeSummary').hidden = false;
    document.getElementById('crpSuccessCount').innerHTML = crpPaymentNoticeHtml(balanceLabel, isEn);
    document.getElementById('crpBankNoteKo').innerHTML = '입금자명을 <strong>캠퍼 이름 (미리보기 캠퍼)</strong>으로 해주세요.<br>입금 확인 후 담당자가 최종 확정 처리합니다.';
    document.getElementById('crpBankNoteEn').innerHTML = "Please use the <strong>camper's name (Preview Camper)</strong> as the transfer memo.<br>Registration will be finalized after payment is verified.";
  }, 120);
})();
</script>

</BaseLayout>
