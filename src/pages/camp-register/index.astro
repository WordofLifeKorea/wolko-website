                        <span class="crp-reg-meta-label"><span class="wl-ko">일정</span><span class="wl-en">Dates</span></span>
                        <span class="crp-reg-meta-value"><span class="wl-ko">{d.date_ko}</span><span class="wl-en">{d.date_en}</span></span>
                      </div>
                      <div class="crp-reg-meta-row">
                        <span class="crp-reg-meta-label"><span class="wl-ko">대상</span><span class="wl-en">For</span></span>
                        <span class="crp-reg-meta-value"><span class="wl-ko">{d.target_ko}</span><span class="wl-en">{d.target_en}</span></span>
                      </div>
                      {(d.deadline_ko || d.deadline_en) && (
                        <div class="crp-reg-meta-row">
                          <span class="crp-reg-meta-label"><span class="wl-ko">마감일</span><span class="wl-en">Deadline</span></span>
                          <span class="crp-reg-meta-value"><span class="wl-ko">{d.deadline_ko}</span><span class="wl-en">{d.deadline_en}</span></span>
                        </div>
                      )}
                      {(d.price_ko || d.price_en) && (
                        <div class="crp-reg-meta-row">
                          <span class="crp-reg-meta-label"><span class="wl-ko">참가비</span><span class="wl-en">Fee</span></span>
                          <span class="crp-reg-meta-value"><span class="wl-ko">{d.price_ko}</span><span class="wl-en">{d.price_en}</span></span>
                        </div>
                      )}
                    </div>
                    {(d.notes_ko || d.notes_en) && (
                      <p class="crp-reg-notes">
                        <span class="wl-ko">{d.notes_ko}</span>
                        <span class="wl-en">{d.notes_en}</span>
                      </p>
                    )}
                    {/* 정원 바 — 제주 캠프는 외부 신청이므로 항상 회색으로 표시 */}
                    <div class="crp-cap crp-cap--gray">
                      <div class="crp-cap-info">
                        <span>
                          <span class="wl-ko">전체 정원</span>
                          <span class="wl-en">Total Capacity</span>
                        </span>
                        <strong>{d.capacity ?? 40}<span class="wl-ko">명</span></strong>
                      </div>
                      <div class="crp-cap-track">
                        <div class="crp-cap-fill"></div>
                      </div>
                    </div>
                    {canRegister ? (
                      <a href={d.registration_url} target="_blank" rel="noopener" class="crp-reg-btn crp-reg-btn-primary">
                        <span class="wl-ko">네이버 카페에서 신청하기 →</span>
                        <span class="wl-en">Register via Naver Cafe →</span>
                      </a>
                    ) : d.status === 'upcoming' ? (
                      <span class="crp-reg-btn crp-reg-btn-disabled">
                        <span class="wl-ko">오픈 예정</span>
                        <span class="wl-en">Opening Soon</span>
                      </span>
                    ) : (
                      <span class="crp-reg-btn crp-reg-btn-disabled">
                        <span class="wl-ko">{d.status === 'full' ? '정원이 마감되었습니다' : '신청이 마감되었습니다'}</span>
                        <span class="wl-en">{d.status === 'full' ? 'Camp is Full' : 'Registration Closed'}</span>
                      </span>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}
      </>
    ) : (
      <div class="crp-reg-empty reveal">
        <div class="crp-reg-empty-icon">✝</div>
        <h3 class="crp-reg-empty-title">
          <span class="wl-ko">현재 진행 중인 캠프 신청이 없습니다</span>
          <span class="wl-en">No Camp Registrations Currently Open</span>
