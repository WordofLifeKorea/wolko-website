                      data-camp-id={s.id}
                      data-camp-name-ko={d.title_ko}
                      data-camp-name-en={d.title_en}
                    >
                      <span class="wl-ko">지원하기 →</span>
                      <span class="wl-en">Apply →</span>
                    </button>
                  </div>
                  </div>
                );
