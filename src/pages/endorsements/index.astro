---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
---

<BaseLayout title="추천사 — WOLKO 월코" activeNav="about">
<style is:global>
@import url('https://cdn.jsdelivr.net/npm/pretendard@latest/dist/web/variable/pretendardvariable-dynamic-subset.css');

/* 추천사 — 사역 페이지와 같은 회사 소개서 톤.
   카드·그림자·왼쪽 색 줄 없이, 가는 선으로 나눈 인용 목록. 인용문은 똑바로 선 진한 글씨. */

/* ── 스코프 ── */
.wr-wrap {
  --wr-deep: #004f68;
  --wr-navy: #0b2430;
  --wr-ink: #10252e;
  --wr-text: #4a5d66;
  --wr-line: #d6dee2;
  --wr-fill: #f3f7f9;
  font-family: var(--ff-sans, 'Pretendard Variable', Pretendard, -apple-system, sans-serif);
  color: var(--wr-ink);
  background: #fff;
  width: 100%;
  word-break: keep-all;
}

/* ── 언어 레이어 (wr-root 스코프) ── */
.wr-wrap.lang-en .wl-ko         { display: none          !important; }
.wr-wrap.lang-en .wl-en         { display: block         !important; }
.wr-wrap.lang-en span.wl-ko     { display: none          !important; }
.wr-wrap.lang-en span.wl-en     { display: inline        !important; }

/* ── DIVIDER — 맨 위 배너 바로 아래라 따로 줄을 긋지 않는다 ── */
.wr-divider { display: none; }

/* ── 추천사 목록 ── */
.wr-grid-section {
  width: min(1200px, calc(100% - 48px));
  margin: 0 auto;
  padding: 112px 0 120px;
}
/* 작은 표시 — 앞에 가는 선 */
.wr-section-label {
  display: flex; align-items: center; gap: 12px;
  color: var(--wr-deep);
  font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  font-family: inherit; line-height: 1.4;
  margin: 0 0 28px;
}
.wr-section-label::before { content: ''; width: 28px; height: 1px; background: currentColor; flex: none; }

.wr-grid { border-top: 2px solid var(--wr-navy); }

/* ── 추천사 한 줄: 왼쪽 추천인, 오른쪽 인용문 ── */
.wr-card {
  display: grid;
  grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  column-gap: 80px;
  padding: 56px 0;
  border-bottom: 1px solid var(--wr-line);
}
.wr-quote-icon { grid-column: 2; grid-row: 1; margin-bottom: 20px; line-height: 0; }
.wr-quote-icon svg { width: 26px; height: 20px; display: block; }
.wr-quote-icon svg path { fill: var(--wr-deep); fill-opacity: 1; }
.wr-quote-text {
  grid-column: 2; grid-row: 2;
  font-size: 17px; line-height: 1.9; font-weight: 400; font-style: normal;
  color: var(--wr-ink);
  max-width: 760px;
}
/* 첫 추천사는 조금 크게 */
.wr-card-wide .wr-quote-text {
  font-size: 21px; line-height: 1.8; font-weight: 500; letter-spacing: -.01em;
  color: var(--wr-navy);
}

.wr-person {
  grid-column: 1; grid-row: 1 / span 2; align-self: start;
  display: flex; align-items: center; gap: 18px;
}
.wr-avatar {
  width: 64px; height: 64px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  background: var(--wr-fill);
}
.wr-person-info { min-width: 0; }
.wr-person-name {
  font-family: var(--ff-serif, inherit);
  font-size: 19px; font-weight: 700; letter-spacing: -.02em;
  color: var(--wr-navy); line-height: 1.35;
}
.wr-person-title {
  margin-top: 6px;
  font-size: 14px; font-weight: 500;
  color: var(--wr-text); line-height: 1.55;
}

/* 스크롤하면 떠오르기 — 스크립트가 .wr-rv 를 붙일 때만 */
.wr-rv { opacity: 0; transform: translateY(24px); transition: opacity 1s cubic-bezier(.2,.7,.2,1) var(--d, 0s), transform 1s cubic-bezier(.2,.7,.2,1) var(--d, 0s); }
.wr-rv.wr-visible { opacity: 1; transform: none; }

/* ── 태블릿 ── */
@media (max-width: 980px) {
  .wr-card { grid-template-columns: minmax(0, 1fr); padding: 44px 0; }
  .wr-quote-icon { grid-column: 1; grid-row: 1; }
  .wr-quote-text { grid-column: 1; grid-row: 2; max-width: none; }
  .wr-person { grid-column: 1; grid-row: 3; margin-top: 28px; }
}
/* ── 모바일 ── */
@media (max-width: 740px) {
  .wr-grid-section { width: calc(100% - 40px); padding: 64px 0 80px; }
  .wr-section-label { margin-bottom: 20px; }
  .wr-card { padding: 36px 0; }
  .wr-quote-icon { margin-bottom: 16px; }
  .wr-quote-icon svg { width: 22px; height: 17px; }
  .wr-quote-text { font-size: 16px; line-height: 1.85; }
  .wr-card-wide .wr-quote-text { font-size: 18px; line-height: 1.75; }
  .wr-person { margin-top: 24px; gap: 14px; }
  .wr-avatar { width: 52px; height: 52px; }
  .wr-person-name { font-size: 17px; }
  .wr-person-title { margin-top: 4px; font-size: 13.5px; }
}
</style>

<PageHero align="center" variant="band" image="/images/heroes/books.jpg" pos="50% 40%">
  <Fragment slot="eyebrow"><span class="wl-ko">추천사</span><span class="wl-en">Testimonials</span></Fragment>
  <Fragment slot="title">
    <span class="wl-ko">목회자들이 직접 경험하고 <br class="ph-br">전하는 이야기</span>
    <span class="wl-en">Words From Ministry Leaders</span>
  </Fragment>
  <Fragment slot="desc">
    <span class="wl-ko">월코의 사역을 신뢰하며 함께 걸어온 목회자들의 진솔한 이야기를 들어보세요.</span>
    <span class="wl-en">Hear from pastors and ministry leaders who have walked alongside WOLKO and trusted our mission.</span>
  </Fragment>
</PageHero>

<div class="wr-wrap" id="wr-root">

  <!-- HERO -->

  <hr class="wr-divider">

  <!-- 카드 그리드 -->
  <section class="wr-grid-section">

    <h2 class="wr-section-label">
      <span class="wl-ko">목회자 추천사</span>
      <span class="wl-en">Pastor Endorsements</span>
    </h2>

    <div class="wr-grid">

      <!-- 카드 1 — 이동원 목사 (와이드) -->
      <div class="wr-card wr-card-wide">
        <div class="wr-quote-icon">
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
            <path d="M0 14V8.4C0 6.13333 0.6 4.06667 1.8 2.2C3 0.333333 4.73333 0 7 0L7.8 1.4C6.33333 1.8 5.13333 2.53333 4.2 3.6C3.26667 4.66667 2.8 5.86667 2.8 7.2H5.6V14H0ZM10.4 14V8.4C10.4 6.13333 11 4.06667 12.2 2.2C13.4 0.333333 15.1333 0 17.4 0L18 1.4C16.5333 1.8 15.3333 2.53333 14.4 3.6C13.4667 4.66667 13 5.86667 13 7.2H16V14H10.4Z" fill="white" fill-opacity="0.9"/>
          </svg>
        </div>
        <p class="wr-quote-text wl-ko">월코는 청년들에게 영어와 제자훈련 그리고 청소년 사역을 제공하는 기독교단체입니다. 국제 사회가 요구하는 영어와 우리 주님께서 원하시는 제자 훈련을 동시에 제공하는 훌륭한 단체로서, 말씀으로 양육받고 영어 실력을 향상시키고자 하는 청년들에게 적극 추천합니다.</p>
        <p class="wr-quote-text wl-en">WOLKO is a program designed to help Christian young adults learn English, discipleship, and youth ministry all at once. It is an excellent program that simultaneously provides the English skills international society demands and the discipleship training our Lord desires. I strongly recommend it to young people who wish to be nourished by the Word and grow in their English ability.</p>
        <div class="wr-person">
          <img class="wr-avatar" src="https://cdn.imweb.me/thumbnail/20250318/be2ccd28ab12b.png" alt="이동원 목사">
          <div class="wr-person-info">
            <div class="wr-person-name wl-ko">이동원 목사</div>
            <div class="wr-person-name wl-en">Rev. Dong-won Lee</div>
            <div class="wr-person-title wl-ko">지구촌교회 원로목사</div>
            <div class="wr-person-title wl-en">Senior Pastor Emeritus, Jiguchon Church</div>
          </div>
        </div>
      </div>

      <!-- 카드 2 — 배국순 목사 -->
      <div class="wr-card">
        <div class="wr-quote-icon">
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
            <path d="M0 14V8.4C0 6.13333 0.6 4.06667 1.8 2.2C3 0.333333 4.73333 0 7 0L7.8 1.4C6.33333 1.8 5.13333 2.53333 4.2 3.6C3.26667 4.66667 2.8 5.86667 2.8 7.2H5.6V14H0ZM10.4 14V8.4C10.4 6.13333 11 4.06667 12.2 2.2C13.4 0.333333 15.1333 0 17.4 0L18 1.4C16.5333 1.8 15.3333 2.53333 14.4 3.6C13.4667 4.66667 13 5.86667 13 7.2H16V14H10.4Z" fill="white" fill-opacity="0.9"/>
          </svg>
        </div>
        <p class="wr-quote-text wl-ko">Word of Life Korea (월코)는 지난 30년간 한국의 다음 세대를 위해 힘써온 선교 단체입니다. 이 단체를 통하여 다음 세대의 학생들이 캠프와 영어, 하나님의 말씀으로 그리스도를 만나고 삶의 목적이 바뀌는 은혜를 경험했습니다. 저의 두 아들과 조카도 이곳을 통해 훈련받으며 훌륭하게 자라나 지금은 세계 곳곳에서 하나님의 사람으로 주님의 몸 된 교회를 열심히 섬기고 있습니다.</p>
        <p class="wr-quote-text wl-en">Word of Life Korea is a mission organization that has devoted itself to the next generation in Korea for over 30 years. Through this ministry, young students have encountered Christ through camps, English, and God's Word — and experienced the grace of having their life's purpose transformed. My two sons and nephew were trained here and grew into outstanding men of God, now serving the church faithfully around the world.</p>
        <div class="wr-person">
          <img class="wr-avatar" src="https://cdn.imweb.me/thumbnail/20250318/df1a60a5f0a4e.png" alt="배국순 목사">
          <div class="wr-person-info">
            <div class="wr-person-name wl-ko">배국순 목사</div>
            <div class="wr-person-name wl-en">Rev. Guk-soon Bae</div>
            <div class="wr-person-title wl-ko">송탄중앙침례교회</div>
            <div class="wr-person-title wl-en">Songtan Central Baptist Church</div>
          </div>
        </div>
      </div>

      <!-- 카드 3 — 이명규 목사 -->
      <div class="wr-card">
        <div class="wr-quote-icon">
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
            <path d="M0 14V8.4C0 6.13333 0.6 4.06667 1.8 2.2C3 0.333333 4.73333 0 7 0L7.8 1.4C6.33333 1.8 5.13333 2.53333 4.2 3.6C3.26667 4.66667 2.8 5.86667 2.8 7.2H5.6V14H0ZM10.4 14V8.4C10.4 6.13333 11 4.06667 12.2 2.2C13.4 0.333333 15.1333 0 17.4 0L18 1.4C16.5333 1.8 15.3333 2.53333 14.4 3.6C13.4667 4.66667 13 5.86667 13 7.2H16V14H10.4Z" fill="white" fill-opacity="0.9"/>
          </svg>
        </div>
        <p class="wr-quote-text wl-ko">만약 청년의 시기로 돌아갈 수 있다면, 꼭 한 번 훈련받고 싶은 곳이 있다면 바로 월코입니다. 분명한 구원의 확신, 성경적인 비전과 가치관, 좋은 멘토를 만날 수 있는 곳이기 때문입니다. 그리고 무엇보다 영어를 함께 배울 수 있다는 것이 또 하나의 큰 장점입니다. 월코는 인생의 중요한 시기에 접어든 믿음의 청년들에게 권하고 싶은 곳입니다.</p>
        <p class="wr-quote-text wl-en">If I could return to my youth, there is one place I would want to be trained — WOLKO. It is a place where you can gain a sure assurance of salvation, establish a biblical vision and set of values, and find excellent mentors. And beyond all that, being able to grow in English is a tremendous added benefit. WOLKO is a place I wholeheartedly recommend to young believers entering a critical season of life.</p>
        <div class="wr-person">
          <img class="wr-avatar" src="https://cdn.imweb.me/thumbnail/20250318/e8a27fcca7902.png" alt="이명규 목사">
          <div class="wr-person-info">
            <div class="wr-person-name wl-ko">이명규 목사</div>
            <div class="wr-person-name wl-en">Rev. Myung-gyu Lee</div>
            <div class="wr-person-title wl-ko">서서울성서침례교회 담임</div>
            <div class="wr-person-title wl-en">Senior Pastor, West Seoul Bible Baptist Church</div>
          </div>
        </div>
      </div>

      <!-- 카드 4 — 서종식 목사 -->
      <div class="wr-card">
        <div class="wr-quote-icon">
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
            <path d="M0 14V8.4C0 6.13333 0.6 4.06667 1.8 2.2C3 0.333333 4.73333 0 7 0L7.8 1.4C6.33333 1.8 5.13333 2.53333 4.2 3.6C3.26667 4.66667 2.8 5.86667 2.8 7.2H5.6V14H0ZM10.4 14V8.4C10.4 6.13333 11 4.06667 12.2 2.2C13.4 0.333333 15.1333 0 17.4 0L18 1.4C16.5333 1.8 15.3333 2.53333 14.4 3.6C13.4667 4.66667 13 5.86667 13 7.2H16V14H10.4Z" fill="white" fill-opacity="0.9"/>
          </svg>
        </div>
        <p class="wr-quote-text wl-ko">지인의 소개로 두 자녀를 보내 훈련받게 했고, 다섯 명의 청소년들을 소개하여 보냈습니다. 월코는 청소년기의 기독교적 세계관 확립과 인생의 소명을 발견하게 하는 탁월한 훈련의 장입니다. 자비량 선교사님들과 교사들을 통해 사랑과 헌신, 섬김을 배우고, 공동체 생활을 통해 '함께'와 '스스로'를 세워가는 법을 배웁니다. 무엇보다 모든 훈련이 영어로 진행되어 자연스럽게 생활 속에서 체득하게 됩니다.</p>
        <p class="wr-quote-text wl-en">Through a personal referral, I sent two of my own children and five other teenagers to be trained here. WOLKO is an outstanding training ground where young people develop a biblical Christian worldview and discover their God-given calling. Through self-supported missionaries and teachers, they learn love, devotion, and service — and through community life, they grow in both collaboration and personal responsibility. Best of all, training entirely in English means they absorb the language naturally through daily life.</p>
        <div class="wr-person">
          <img class="wr-avatar" src="https://cdn.imweb.me/thumbnail/20250318/4986c4ec20ce3.png" alt="서종식 목사">
          <div class="wr-person-info">
            <div class="wr-person-name wl-ko">서종식 목사</div>
            <div class="wr-person-name wl-en">Rev. Jong-sik Seo</div>
            <div class="wr-person-title wl-ko">대한예수교장로회 살렘교회 담임</div>
            <div class="wr-person-title wl-en">Senior Pastor, Salem Presbyterian Church</div>
          </div>
        </div>
      </div>

      <!-- 카드 5 — 김정서 목사 -->
      <div class="wr-card">
        <div class="wr-quote-icon">
          <svg width="18" height="14" viewBox="0 0 18 14" fill="none" aria-hidden="true">
            <path d="M0 14V8.4C0 6.13333 0.6 4.06667 1.8 2.2C3 0.333333 4.73333 0 7 0L7.8 1.4C6.33333 1.8 5.13333 2.53333 4.2 3.6C3.26667 4.66667 2.8 5.86667 2.8 7.2H5.6V14H0ZM10.4 14V8.4C10.4 6.13333 11 4.06667 12.2 2.2C13.4 0.333333 15.1333 0 17.4 0L18 1.4C16.5333 1.8 15.3333 2.53333 14.4 3.6C13.4667 4.66667 13 5.86667 13 7.2H16V14H10.4Z" fill="white" fill-opacity="0.9"/>
          </svg>
        </div>
        <p class="wr-quote-text wl-ko">월코는 영어로 주님의 제자훈련을 받으면서 신앙과 영어 소통이 놀랄 만큼 변화되는 장소입니다. 여기서 훈련받은 저희 교회 출신 청년들이 글로벌 인재로 여러 방면에서 뛰어나게 활동하고 있습니다.</p>
        <p class="wr-quote-text wl-en">WOLKO is a place where, through discipleship training conducted entirely in English, one's faith and English communication are transformed in remarkable ways. Young adults from our church who trained here are now thriving as global leaders across a wide range of fields.</p>
        <div class="wr-person">
          <img class="wr-avatar" src="https://cdn.imweb.me/thumbnail/20250318/736b10f7525f3.png" alt="김정서 목사">
          <div class="wr-person-info">
            <div class="wr-person-name wl-ko">김정서 원로목사</div>
            <div class="wr-person-name wl-en">Rev. Jeong-seo Kim</div>
            <div class="wr-person-title wl-ko">제주영락교회</div>
            <div class="wr-person-title wl-en">Jeju Youngnak Church</div>
          </div>
        </div>
      </div>

    </div><!-- /.wr-grid -->
  </section>

</div><!-- /.wr-wrap -->

<script is:inline>
(function () {
  // 추천사 움직임: 스크롤하면 한 줄씩 아래에서 떠오른다.
  // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
  if (!('IntersectionObserver' in window)) return;
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var items = [].slice.call(document.querySelectorAll('.wr-section-label, .wr-card'));
  items.forEach(function (el, i) {
    el.style.setProperty('--d', (i < 3 ? i : 0) * 0.08 + 's');
    el.classList.add('wr-rv');
  });
  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (entry.isIntersecting) { entry.target.classList.add('wr-visible'); io.unobserve(entry.target); }
    });
  }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
  items.forEach(function (el) { io.observe(el); });
})();
</script>
</BaseLayout>
