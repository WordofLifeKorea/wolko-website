---
---
<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WOLKO 캠프 진행</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800&family=Noto+Sans+KR:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --blue:#004f68;
      --blue-lt:#0077a3;
      --blue-soft:#e7f1f5;
      --mint:#0d9488;
      --bg:#f4f6f8;
      --card:#ffffff;
      --border:#e4eaee;
      --line:#eef2f5;
      --text:#1a2d38;
      --mid:#5a7585;
      --light:#8fa8b5;
      --red:#c42a36;
      --green:#16a34a;
      --orange:#e07b00;
      --team-red:#ef4444;
      --team-blue:#3b82f6;
      --team-yellow:#f4b400;
      --team-green:#22c55e;
      --shadow:0 2px 14px rgba(0,79,104,.06);
      --shadow-lg:0 12px 36px rgba(16,56,70,.10);
      --sans:'Montserrat',sans-serif;
      --body:'Noto Sans KR',sans-serif;
    }
    * { box-sizing:border-box; }
    body { margin:0; min-height:100vh; background:var(--bg); color:var(--text); font-family:var(--body); -webkit-font-smoothing:antialiased; }
    button,input,select,textarea { font:inherit; }
    button { cursor:pointer; }

    /* ── TOPBAR ── */
    .topbar {
      position:sticky; top:0; z-index:100; display:flex; align-items:center; justify-content:space-between; gap:16px;
      height:64px; padding:0 clamp(16px,3vw,32px);
      background:linear-gradient(140deg,#003d52 0%,#005e7c 100%);
      color:#fff; box-shadow:0 2px 14px rgba(0,79,104,.28);
    }
    .brand { display:flex; align-items:center; gap:12px; min-width:0; text-decoration:none; }
    .brand img { height:30px; flex:0 0 auto; }
    .brand h1 { margin:0; color:#fff; font:800 14px/1 var(--sans); letter-spacing:.06em; }
    .brand p { margin:4px 0 0; color:rgba(255,255,255,.62); font-size:10px; font-family:var(--sans); letter-spacing:.08em; font-weight:700; }
    .toolbar { display:flex; align-items:center; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
    .toolbar select,
    .toolbar button {
      min-height:32px; border:1px solid rgba(255,255,255,.22); border-radius:100px; padding:5px 14px;
      background:rgba(255,255,255,.10); color:rgba(255,255,255,.92); font:700 11.5px/1 var(--sans);
      letter-spacing:.06em; text-decoration:none; transition:background .18s,color .18s,border-color .18s;
    }
    .toolbar button:hover,
    .toolbar select:hover { background:rgba(255,255,255,.22); border-color:rgba(255,255,255,.4); color:#fff; }
    .toolbar select option { color:var(--text); }

    /* ── PAGE LAYOUT ── */
    .page { max-width:min(1540px,calc(100vw - 32px)); margin:0 auto; padding:32px clamp(14px,2vw,32px) 100px; }

    /* ── HERO ── */
    .hero {
      position:relative; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:24px; align-items:center;
      margin-bottom:22px; padding:26px 28px;
      border:1px solid var(--border); border-radius:18px;
      background:linear-gradient(135deg,#fff 0%,#fafdfe 100%); box-shadow:var(--shadow);
      overflow:hidden;
    }
    .hero::before {
      content:""; position:absolute; left:0; top:0; bottom:0; width:5px;
      background:linear-gradient(180deg,var(--blue),var(--mint));
    }
    .hero h2 { margin:0; color:var(--text); font:800 clamp(20px,2.8vw,26px)/1.25 var(--sans); letter-spacing:-.01em; }
    .hero p { margin:8px 0 0; color:var(--mid); font-size:13px; font-weight:500; line-height:1.65; max-width:560px; }

    .stats { display:flex; gap:8px; flex-wrap:wrap; justify-content:flex-end; }
    .stat {
      display:flex; flex-direction:column; align-items:flex-start; min-width:96px;
      padding:14px 16px; border-radius:14px; background:#f8fafb; border:1px solid var(--line);
      transition:transform .15s,border-color .15s;
    }
    .stat:hover { transform:translateY(-1px); border-color:var(--border); }
    .stat strong { display:block; font:800 26px/1 var(--sans); letter-spacing:-.02em; }
    .stat span { display:block; margin-top:8px; font:800 10px/1 var(--sans); letter-spacing:.1em; text-transform:uppercase; }
    .stat-campers strong { color:var(--blue); } .stat-campers span { color:#7891a0; }
    .stat-saved strong { color:#1685bd; } .stat-saved span { color:#1685bd; }
    .stat-dedicated strong { color:#258541; } .stat-dedicated span { color:#258541; }

    /* ── COUNSELOR BOARD ── */
    .board { display:grid; grid-template-columns:repeat(4,minmax(260px,1fr)); gap:14px; align-items:start; }
    .counselor-card {
      overflow:hidden; border:1px solid var(--border); border-radius:16px; background:var(--card);
      box-shadow:var(--shadow); transition:box-shadow .18s,transform .18s;
    }
    .counselor-card:hover { box-shadow:var(--shadow-lg); }
    .counselor-card.is-unassigned { border-style:dashed; background:#fbfdfe; }
    .counselor-head {
      display:flex; align-items:center; justify-content:space-between; gap:10px;
      padding:16px 20px; border-bottom:1px solid var(--line);
      background:linear-gradient(180deg,#fbfdfe,#fff);
    }
    .counselor-head-info { min-width:0; }
    .counselor-head strong { display:block; color:var(--text); font:800 15px/1.3 var(--sans); letter-spacing:-.01em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .counselor-head span { display:block; margin-top:4px; color:var(--light); font:700 11px/1.4 var(--sans); letter-spacing:.02em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .counselor-count {
      flex-shrink:0; display:inline-flex; align-items:center; padding:4px 11px; border-radius:100px;
      background:var(--blue-soft); color:var(--blue); font:800 11px/1 var(--sans); letter-spacing:.02em;
    }
    .counselor-card.is-unassigned .counselor-count { background:#f4f6f8; color:var(--mid); }

    .camper-list { display:grid; gap:0; padding:0; min-height:90px; background:#fff; }
    .camper-btn {
      width:100%; display:grid; grid-template-columns:5px minmax(0,1fr) auto; gap:14px; align-items:center;
      border:0; border-bottom:1px solid var(--line); border-radius:0; padding:13px 18px; background:#fff;
      color:inherit; text-align:left; transition:background .15s,padding-left .15s;
    }
    .camper-btn:hover { background:#f8fafc; padding-left:22px; }
    .camper-btn:last-child { border-bottom:0; }
    .camper-btn:focus-visible { outline:2px solid var(--blue); outline-offset:-2px; background:#f4f9fb; }
    .team-dot { width:5px; align-self:stretch; min-height:36px; border-radius:999px; background:#dde4e9; }
    .team-red { background:var(--team-red); } .team-blue { background:var(--team-blue); }
    .team-yellow { background:var(--team-yellow); } .team-green { background:var(--team-green); }
    .camper-main { min-width:0; }
    .camper-main strong { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font:800 13.5px/1.3 var(--body); color:var(--text); letter-spacing:-.005em; }
    .camper-main span { display:block; margin-top:3px; color:var(--light); font-size:11px; font-weight:600; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .chips { display:flex; gap:4px; flex-wrap:wrap; justify-content:flex-end; flex-shrink:0; }
    .chip { padding:3px 8px; border-radius:999px; font:800 10px/1 var(--sans); letter-spacing:.02em; white-space:nowrap; }
    .chip-saved { background:#e0f3ff; color:#1685bd; }
    .chip-dedicated { background:#e4f7ea; color:#258541; }
    .empty { padding:32px 18px; color:var(--light); font-size:12px; font-weight:600; text-align:center; line-height:1.6; }

    /* ── SECTION ── */
    .section { margin-top:26px; border:1px solid var(--border); border-radius:18px; background:var(--card); box-shadow:var(--shadow); overflow:hidden; }
    .section-head {
      display:flex; align-items:center; justify-content:space-between; gap:12px;
      padding:18px 24px; border-bottom:1px solid var(--line); flex-wrap:wrap;
      background:linear-gradient(180deg,#fbfdfe,#fff);
    }
    .section-head h3 { margin:0; color:var(--text); font:800 15px/1.3 var(--sans); letter-spacing:-.01em; }
    .section-meta { color:var(--mid); font:800 11.5px/1 var(--sans); letter-spacing:.04em; }

    /* ── TEAM GRID ── */
    .team-grid { display:grid; grid-template-columns:repeat(5,minmax(180px,1fr)); gap:12px; padding:18px; background:#fff; }
    .team-box {
      position:relative; border:1px solid var(--border); border-radius:14px; background:#fbfcfd;
      padding:16px 14px 14px; transition:border-color .15s,background .15s;
    }
    .team-box:hover { background:#f7fafb; border-color:#d4dde2; }
    .team-box strong { display:flex; align-items:center; gap:7px; color:var(--blue); font:800 13px/1 var(--sans); letter-spacing:-.005em; }
    .team-box strong::before {
      content:""; display:inline-block; width:7px; height:7px; border-radius:50%; background:var(--blue);
    }
    .team-box ul { list-style:none; margin:12px 0 0; padding:0; display:grid; gap:5px; }
    .team-box li {
      padding:7px 10px; border-radius:8px; background:#fff; border:1px solid var(--line);
      color:#334b58; font-size:12px; font-weight:700; line-height:1.4;
    }
    .team-box li.is-empty { background:transparent; border:1px dashed var(--border); color:var(--light); text-align:center; font-weight:600; }

    /* ── MODAL ── */
    .modal-backdrop { position:fixed; inset:0; z-index:50; display:none; place-items:center; padding:18px; background:rgba(4,19,28,.58); backdrop-filter:blur(2px); }
    .modal-backdrop.open { display:grid; }
    .modal { width:min(720px,100%); max-height:calc(100vh - 36px); overflow:auto; border-radius:18px; background:#fff; box-shadow:0 28px 72px rgba(0,0,0,.30); }
    .modal-head { display:flex; justify-content:space-between; gap:12px; padding:20px 24px; border-bottom:1px solid var(--line); background:linear-gradient(180deg,#fbfdfe,#fff); }
    .modal-title { min-width:0; }
    .modal-title strong { display:block; color:var(--text); font:800 18px/1.25 var(--body); letter-spacing:-.01em; }
    .modal-title span { display:block; margin-top:5px; color:var(--light); font-size:12px; font-weight:600; }
    .icon-btn {
      flex-shrink:0; width:34px; height:34px; border:1px solid var(--border); border-radius:50%; background:#f8fafb;
      color:var(--mid); font:900 18px/1 var(--sans); transition:background .15s,color .15s,border-color .15s;
    }
    .icon-btn:hover { background:#fff; color:var(--blue); border-color:var(--blue); }
    .modal-body { padding:20px 24px 24px; display:grid; gap:18px; }
    .field-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }
    .field { display:grid; gap:7px; }
    .field label { color:var(--mid); font:800 11px/1 var(--sans); letter-spacing:.06em; text-transform:uppercase; }
    .field input,.field select,.field textarea {
      width:100%; border:1.5px solid var(--border); border-radius:10px; background:#fafbfc; padding:11px 13px; color:var(--text); outline:none;
      transition:border-color .2s,background .2s,box-shadow .2s;
    }
    .field input:focus,.field select:focus,.field textarea:focus { border-color:var(--blue); background:#fff; box-shadow:0 0 0 3px rgba(0,79,104,.10); }
    .field textarea { min-height:120px; resize:vertical; line-height:1.65; font-family:var(--body); }
    .checks { display:flex; gap:8px; flex-wrap:wrap; }
    .check-pill {
      display:inline-flex; align-items:center; gap:8px; padding:9px 14px; border:1.5px solid var(--border); border-radius:999px;
      background:#fbfcfd; font:800 12px/1 var(--body); cursor:pointer; transition:border-color .15s,background .15s;
    }
    .check-pill:has(input:checked) { border-color:var(--blue); background:var(--blue-soft); color:var(--blue); }
    .check-pill input { accent-color:var(--blue); }
    .save-row { display:flex; justify-content:flex-end; gap:10px; margin-top:4px; }
    .primary { border:0; border-radius:10px; padding:11px 22px; background:var(--blue); color:#fff; font:800 13px/1 var(--body); transition:background .15s,transform .1s; }
    .primary:hover { background:var(--blue-lt); }
    .primary:active { transform:translateY(1px); }
    .primary:disabled { background:#a3b8c2; cursor:not-allowed; }
    .secondary { border:1.5px solid var(--border); border-radius:10px; padding:10px 20px; background:#fff; color:var(--blue); font:800 13px/1 var(--body); transition:border-color .15s,background .15s; }
    .secondary:hover { border-color:var(--blue); background:#f7fbfd; }

    /* ── LOGIN ── */
    .login-screen {
      position:fixed; inset:0; z-index:80; display:flex; align-items:center; justify-content:center; padding:20px;
      background:linear-gradient(145deg,#003d52,#00627f);
    }
    .login-card {
      width:100%; max-width:400px; border-radius:22px; background:#fff; padding:44px 38px 38px;
      box-shadow:0 28px 72px rgba(0,0,0,.30); text-align:center;
    }
    .login-logo { display:flex; align-items:center; justify-content:center; gap:12px; margin-bottom:24px; }
    .login-logo img { height:38px; }
    .login-logo-text { text-align:left; }
    .login-logo-name { display:block; color:var(--blue); font:800 15px/1 var(--sans); letter-spacing:.06em; }
    .login-logo-sub { display:block; margin-top:4px; color:#8fa8b5; font:700 10px/1 var(--sans); letter-spacing:.08em; }
    .login-title { margin:0 0 8px; color:var(--text); font:800 17px/1.3 var(--body); letter-spacing:-.01em; }
    .login-description { margin:0 0 22px; color:var(--light); font-size:12.5px; font-weight:500; line-height:1.55; }
    .tabs {
      display:grid; grid-template-columns:repeat(3,1fr); gap:4px; margin-bottom:16px; padding:4px;
      border:1px solid var(--border); border-radius:12px; background:#f4f6f8;
    }
    .tab {
      border:0; border-radius:9px; padding:9px 6px; background:transparent; color:#6f8794;
      font:800 11px/1 var(--sans); letter-spacing:.04em; transition:background .15s,color .15s,box-shadow .15s;
    }
    .tab.active { background:#fff; color:var(--blue); box-shadow:0 3px 10px rgba(16,42,56,.08); }
    .login-form { display:grid; gap:10px; text-align:left; }
    .login-form input {
      width:100%; border:1.5px solid var(--border); border-radius:11px; padding:13px 15px;
      background:#fafbfc; color:var(--text); font-size:15px; outline:none;
      transition:border-color .2s,background .2s,box-shadow .2s;
    }
    .login-form input:focus { border-color:var(--blue); background:#fff; box-shadow:0 0 0 3px rgba(0,79,104,.10); }
    .login-error { min-height:18px; color:var(--red); font-size:12px; font-weight:800; }
    .login-btn {
      width:100%; border:0; border-radius:11px; padding:14px; background:var(--blue); color:#fff;
      font:800 15px/1 var(--body); letter-spacing:.02em; transition:background .2s,transform .12s;
    }
    .login-btn:hover { background:var(--blue-lt); }
    .login-btn:active { transform:scale(.98); }
    .login-btn:disabled { opacity:.6; cursor:not-allowed; }

    /* ── ADMIN PANEL ── */
    .admin-panel { display:none; }
    body.is-admin .admin-panel { display:block; }
    .admin-form-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px; padding:18px 22px; border-bottom:1px solid var(--line); }
    .admin-form-grid .field-actions { display:flex; align-items:flex-end; }
    .admin-form-grid .field-actions .primary { width:100%; }
    .account-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:10px; padding:18px 22px; }
    .account-card {
      border:1px solid var(--border); border-radius:14px; padding:14px 16px; background:#fbfcfd;
      transition:background .15s,border-color .15s;
    }
    .account-card:hover { background:#fff; border-color:#d4dde2; }
    .account-card strong { display:block; font:800 13.5px/1.3 var(--body); color:var(--text); letter-spacing:-.005em; }
    .account-card .account-meta { display:flex; align-items:center; gap:8px; margin-top:5px; color:var(--light); font-size:11.5px; font-weight:600; }
    .account-badge {
      display:inline-flex; align-items:center; padding:2px 8px; border-radius:100px; font:800 10px/1 var(--sans); letter-spacing:.04em;
    }
    .account-badge.is-active { background:#e4f7ea; color:#258541; }
    .account-badge.is-disabled { background:#fde8e9; color:var(--red); }
    .account-badge.is-none { background:#f4f6f8; color:var(--mid); }
    .account-actions { display:flex; gap:6px; flex-wrap:wrap; margin-top:12px; }
    .account-actions button {
      border:1px solid var(--border); border-radius:999px; background:#fff; color:var(--blue);
      padding:6px 12px; font:800 11px/1 var(--sans); letter-spacing:.02em; transition:border-color .15s,background .15s;
    }
    .account-actions button:hover { border-color:var(--blue); background:#f7fbfd; }

    /* ── RESPONSIVE ── */
    @media (max-width:1100px) {
      .board { grid-template-columns:repeat(2,minmax(240px,1fr)); }
      .team-grid { grid-template-columns:repeat(3,minmax(160px,1fr)); }
      .hero { grid-template-columns:1fr; align-items:flex-start; }
      .stats { justify-content:flex-start; }
    }
    @media (max-width:760px) {
      .team-grid { grid-template-columns:repeat(2,minmax(140px,1fr)); }
    }
    @media (max-width:640px) {
      .topbar { height:auto; min-height:60px; align-items:flex-start; flex-direction:column; padding:14px 18px; gap:12px; }
      .toolbar { justify-content:flex-start; width:100%; }
      .page { max-width:100%; padding:20px 12px 72px; }
      .board,.team-grid,.field-grid { grid-template-columns:1fr; }
      .hero { padding:20px; border-radius:14px; }
      .hero h2 { font-size:20px; }
      .stat { min-width:auto; flex:1 1 30%; padding:12px; }
      .stat strong { font-size:22px; }
      .section { border-radius:14px; }
      .section-head { padding:16px 18px; }
      .modal-head,.modal-body { padding-left:18px; padding-right:18px; }
      .login-card { padding:36px 26px 30px; }
      .tabs { grid-template-columns:1fr; border-radius:14px; }
      .camper-btn { padding:12px 16px; }
      .counselor-head { padding:14px 18px; }
    }
  </style>
</head>
<body>
  <div class="login-screen" id="loginScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title">캠프 진행 페이지</p>
      <p class="login-description">담당 캠퍼 상담 기록과 팀 현황을 관리합니다.</p>
      <div class="tabs">
        <button class="tab active" data-mode="login" type="button">로그인</button>
        <button class="tab" data-mode="signup" type="button">카운슬러 가입</button>
        <button class="tab" data-mode="adminLogin" type="button">관리자</button>
      </div>
      <div class="login-form">
        <input id="authName" placeholder="이름 (가입 시)" autocomplete="name" hidden>
        <input id="authEmail" type="email" placeholder="email@example.com" autocomplete="email">
        <input id="authPassword" type="password" placeholder="Password" autocomplete="current-password">
        <div class="login-error" id="loginError"></div>
        <button class="login-btn" id="authBtn" type="button">로그인</button>
      </div>
    </div>
  </div>

  <header class="topbar">
    <div class="brand">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <div>
        <h1>WOLKO 캠프 진행</h1>
        <p id="sessionText">Counselor Dashboard</p>
      </div>
    </div>
    <div class="toolbar">
      <select id="campSelect" aria-label="캠프 선택"></select>
      <button id="refreshBtn" type="button">새로고침</button>
      <button id="logoutBtn" type="button">로그아웃</button>
    </div>
  </header>

  <main class="page">
    <section class="hero">
      <div>
        <h2 id="campTitle">캠프 진행 페이지</h2>
        <p>담당 카운슬러별 캠퍼를 확인하고, 각 캠퍼의 팀 색상·구원·헌신·Testimony·상담 내역을 기록합니다.</p>
      </div>
      <div class="stats">
        <div class="stat stat-campers"><strong id="statCampers">0</strong><span>캠퍼</span></div>
        <div class="stat stat-saved"><strong id="statSaved">0</strong><span>구원</span></div>
        <div class="stat stat-dedicated"><strong id="statDedicated">0</strong><span>헌신</span></div>
      </div>
    </section>

    <section class="board" id="counselorBoard"></section>

    <section class="section">
      <div class="section-head">
        <h3>팀 운영 현황</h3>
        <span class="section-meta" id="teamSummary"></span>
      </div>
      <div class="team-grid" id="teamGrid"></div>
    </section>

    <section class="section admin-panel">
      <div class="section-head">
        <h3>카운슬러 접속 권한 관리</h3>
        <button class="secondary" id="loadAccountsBtn" type="button">계정 새로고침</button>
      </div>
      <div class="admin-form-grid">
        <div class="field"><label>이메일</label><input id="accountEmail" placeholder="counselor@example.com"></div>
        <div class="field"><label>이름</label><input id="accountName" placeholder="카운슬러 이름"></div>
        <div class="field"><label>새 비밀번호</label><input id="accountPassword" type="password" placeholder="6자 이상"></div>
        <div class="field field-actions"><button class="primary" id="accountSaveBtn" type="button">계정 생성·재설정</button></div>
      </div>
      <div class="account-grid" id="accountGrid"></div>
    </section>
  </main>

  <div class="modal-backdrop" id="camperModal">
    <div class="modal">
      <div class="modal-head">
        <div class="modal-title">
          <strong id="modalName">캠퍼</strong>
          <span id="modalMeta"></span>
        </div>
        <button class="icon-btn" id="modalClose" type="button">×</button>
      </div>
      <div class="modal-body">
        <div class="field-grid">
          <div class="field">
            <label>팀 색상</label>
            <select id="modalTeamColor">
              <option value="">미지정</option>
              <option value="red">레드팀</option>
              <option value="blue">블루팀</option>
              <option value="yellow">옐로우팀</option>
              <option value="green">그린팀</option>
            </select>
          </div>
          <div class="field">
            <label>영적 현황</label>
            <div class="checks">
              <label class="check-pill"><input id="modalSaved" type="checkbox"> 구원</label>
              <label class="check-pill"><input id="modalDedicated" type="checkbox"> 헌신</label>
            </div>
          </div>
        </div>
        <div class="field">
          <label>Testimony</label>
          <textarea id="modalTestimony" placeholder="캠퍼의 간증, 복음 반응, 나눔 내용을 기록하세요."></textarea>
        </div>
        <div class="field">
          <label>상담 내역</label>
          <textarea id="modalMemo" placeholder="상담 내용, 기도제목, 후속 케어가 필요한 내용을 기록하세요."></textarea>
        </div>
        <div class="save-row">
          <button class="secondary" id="modalCancel" type="button">닫기</button>
          <button class="primary" id="modalSave" type="button">저장</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    const CAMPS = [
      { id:'2026-inland-english-junior', title:'2026 여름 주니어 영어 캠프' },
      { id:'2026-inland-union', title:'2026 교회 연합캠프' },
      { id:'2026-jeju-english', title:'2026 제주 영어 캠프' },
      { id:'2026-jeju-momentum-1', title:'2026 제주 모멘텀 1차' },
      { id:'2026-jeju-momentum-2', title:'2026 제주 모멘텀 2차' },
      { id:'2026-test-camp', title:'테스트 캠프' },
    ];
    const BASE_TEAMS = ['프로그램','티칭','상담자','테크','찬양팀'];
    const BASE_MEMBERS = [
      { name:'앤더슨 제이슨 · 앤더슨 찬주', teams:['프로그램','상담자'] },
      { name:'민경찬 · 김유진', teams:['프로그램'] },
      { name:'송승현', teams:['프로그램','상담자'] },
      { name:'김환규 · 김씬띠아', teams:['티칭','테크'] },
      { name:'백남규 · 조안나', teams:['상담자','티칭'] },
      { name:'채병국', teams:['프로그램','상담자'] },
      { name:'잭 프래지어', teams:['티칭','상담자'] },
      { name:'몰리 그램', teams:['상담자','프로그램'] },
      { name:'버니 카브레라', teams:['찬양팀','상담자'] },
      { name:'정지온', teams:['상담자'] },
      { name:'브링클리 모슬리', teams:['테크'] },
      { name:'웹스터 그레이스', teams:['테크'] },
      { name:'손진영', teams:['프로그램'] },
    ];
    const TOKEN_KEY = 'wolko-camp-progress-token';
    const ROLE_KEY = 'wolko-camp-progress-role';
    let authMode = 'login';
    let token = sessionStorage.getItem(TOKEN_KEY) || '';
    let role = sessionStorage.getItem(ROLE_KEY) || '';
    let state = { counselors:[], campers:[], counselorRegIds:[], teamOverview:null, canEditAll:false };
    let selectedCamper = null;

    const $ = id => document.getElementById(id);
    const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));
    const authHeaders = () => ({ 'Content-Type':'application/json', Authorization:`Bearer ${token}` });

    function currentCampId() { return $('campSelect').value || CAMPS[0].id; }
    function currentCampTitle() { return CAMPS.find(camp => camp.id === currentCampId())?.title || currentCampId(); }

    function setup() {
      $('campSelect').innerHTML = CAMPS.map(camp => `<option value="${camp.id}">${camp.title}</option>`).join('');
      $('campSelect').addEventListener('change', loadData);
      $('refreshBtn').addEventListener('click', loadData);
      $('logoutBtn').addEventListener('click', logout);
      $('modalClose').addEventListener('click', closeModal);
      $('modalCancel').addEventListener('click', closeModal);
      $('modalSave').addEventListener('click', saveCamper);
      $('authBtn').addEventListener('click', submitAuth);
      $('loadAccountsBtn').addEventListener('click', loadAccounts);
      $('accountSaveBtn').addEventListener('click', upsertAccount);
      document.querySelectorAll('.tab').forEach(btn => btn.addEventListener('click', () => setAuthMode(btn.dataset.mode)));
      document.addEventListener('keydown', event => { if (event.key === 'Escape') closeModal(); });
      if (token) unlock();
    }

    function setAuthMode(mode) {
      authMode = mode;
      document.querySelectorAll('.tab').forEach(btn => btn.classList.toggle('active', btn.dataset.mode === mode));
      $('authEmail').hidden = mode === 'adminLogin';
      $('authName').hidden = mode !== 'signup';
      $('authPassword').autocomplete = mode === 'signup' ? 'new-password' : 'current-password';
      $('authBtn').textContent = mode === 'signup' ? '가입하기' : mode === 'adminLogin' ? '관리자 로그인' : '로그인';
      $('loginError').textContent = '';
    }

    async function submitAuth() {
      $('loginError').textContent = '';
      $('authBtn').disabled = true;
      try {
        const res = await fetch('/api/camp-progress/auth', {
          method:'POST',
          headers:{ 'Content-Type':'application/json' },
          body:JSON.stringify({
            mode:authMode,
            email:$('authEmail').value.trim(),
            name:$('authName').value.trim(),
            password:$('authPassword').value,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '로그인 실패');
        token = data.token;
        role = data.role;
        sessionStorage.setItem(TOKEN_KEY, token);
        sessionStorage.setItem(ROLE_KEY, role);
        unlock();
      } catch (error) {
        $('loginError').textContent = error.message;
      } finally {
        $('authBtn').disabled = false;
      }
    }

    function unlock() {
      $('loginScreen').style.display = 'none';
      document.body.classList.toggle('is-admin', role === 'admin');
      $('sessionText').textContent = role === 'admin' ? '관리자 모드' : '카운슬러 모드';
      loadData();
      if (role === 'admin') loadAccounts();
    }

    function logout() {
      sessionStorage.removeItem(TOKEN_KEY);
      sessionStorage.removeItem(ROLE_KEY);
      token = '';
      role = '';
      document.body.classList.remove('is-admin');
      $('loginScreen').style.display = 'grid';
    }

    async function loadData() {
      if (!token) return;
      $('campTitle').textContent = currentCampTitle();
      try {
        const res = await fetch(`/api/camp-progress/data?campId=${encodeURIComponent(currentCampId())}`, { headers:authHeaders() });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '데이터 로드 실패');
        state = data;
        renderBoard();
        renderTeams();
      } catch (error) {
        alert(error.message);
        if (/로그인|authorization|401/i.test(error.message)) logout();
      }
    }

    function canEditCamper(camper) {
      return state.canEditAll || state.counselorRegIds.includes(camper.counselorRegId);
    }

    function renderBoard() {
      const saved = state.campers.filter(camper => camper.saved).length;
      const dedicated = state.campers.filter(camper => camper.dedicated).length;
      $('statCampers').textContent = state.campers.length;
      $('statSaved').textContent = saved;
      $('statDedicated').textContent = dedicated;
      const groups = [
        ...state.counselors.map(counselor => ({
          id:counselor.regId,
          name:counselor.name,
          email:counselor.email,
          campers:state.campers.filter(camper => camper.counselorRegId === counselor.regId),
        })),
        {
          id:'',
          name:'미배정',
          email:'담당 카운슬러가 지정되지 않은 캠퍼',
          campers:state.campers.filter(camper => !camper.counselorRegId),
        },
      ];
      $('counselorBoard').innerHTML = groups.map(group => `
        <article class="counselor-card${group.id ? '' : ' is-unassigned'}">
          <div class="counselor-head">
            <div class="counselor-head-info">
              <strong>${esc(group.name)}</strong>
              <span>${esc(group.email || '담당 카운슬러 미지정')}</span>
            </div>
            <span class="counselor-count">${group.campers.length}명</span>
          </div>
          <div class="camper-list">
            ${group.campers.length ? group.campers.map(renderCamperButton).join('') : '<div class="empty">등록된 캠퍼가<br>없습니다</div>'}
          </div>
        </article>
      `).join('');
      document.querySelectorAll('.camper-btn').forEach(btn => btn.addEventListener('click', () => openCamper(btn.dataset.camperId)));
    }

    function renderCamperButton(camper) {
      const locked = canEditCamper(camper) ? '' : ' · 읽기 전용';
      return `<button class="camper-btn" type="button" data-camper-id="${esc(camper.camperId)}">
        <span class="team-dot ${camper.teamColor ? 'team-' + camper.teamColor : ''}"></span>
        <span class="camper-main">
          <strong>${esc(camper.name)}</strong>
          <span>${esc([camper.grade, camper.church].filter(Boolean).join(' · ') || '정보 없음')}${locked}</span>
        </span>
        <span class="chips">
          ${camper.saved ? '<span class="chip chip-saved">구원</span>' : ''}
          ${camper.dedicated ? '<span class="chip chip-dedicated">헌신</span>' : ''}
        </span>
      </button>`;
    }

    function openCamper(camperId) {
      selectedCamper = state.campers.find(camper => camper.camperId === camperId);
      if (!selectedCamper) return;
      const editable = canEditCamper(selectedCamper);
      $('modalName').textContent = selectedCamper.name;
      $('modalMeta').textContent = [selectedCamper.grade, selectedCamper.church, selectedCamper.phone].filter(Boolean).join(' · ');
      $('modalTeamColor').value = selectedCamper.teamColor || '';
      $('modalSaved').checked = !!selectedCamper.saved;
      $('modalDedicated').checked = !!selectedCamper.dedicated;
      $('modalTestimony').value = selectedCamper.testimony || '';
      $('modalMemo').value = selectedCamper.counselorMemo || '';
      ['modalTeamColor','modalSaved','modalDedicated','modalTestimony','modalMemo','modalSave'].forEach(id => $(id).disabled = !editable);
      $('modalSave').textContent = editable ? '저장' : '읽기 전용';
      $('camperModal').classList.add('open');
    }

    function closeModal() {
      $('camperModal').classList.remove('open');
      selectedCamper = null;
    }

    async function saveField(field, value) {
      const res = await fetch('/api/camp-progress/update', {
        method:'PUT',
        headers:authHeaders(),
        body:JSON.stringify({
          campId:selectedCamper.campId,
          regId:selectedCamper.regId,
          participantIndex:selectedCamper.participantIndex,
          field,
          value,
        }),
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || '저장 실패');
    }

    async function saveCamper() {
      if (!selectedCamper || !canEditCamper(selectedCamper)) return;
      $('modalSave').disabled = true;
      $('modalSave').textContent = '저장 중...';
      try {
        await saveField('teamColor', $('modalTeamColor').value);
        await saveField('saved', $('modalSaved').checked);
        await saveField('dedicated', $('modalDedicated').checked);
        await saveField('testimony', $('modalTestimony').value);
        await saveField('counselorMemo', $('modalMemo').value);
        closeModal();
        await loadData();
      } catch (error) {
        alert(error.message);
      } finally {
        $('modalSave').disabled = false;
        $('modalSave').textContent = '저장';
      }
    }

    function renderTeams() {
      const config = state.teamOverview || {};
      const customTeams = Array.isArray(config.customTeams) ? config.customTeams : [];
      const teams = [...BASE_TEAMS, ...customTeams];
      const staffMembers = state.counselors.map(counselor => ({ name:counselor.name, teams:['상담자'] }));
      const customMembers = Array.isArray(config.customMembers) ? config.customMembers.map(member => ({ name:member.name || '', teams:member.teams || [] })) : [];
      const allMembers = [...BASE_MEMBERS, ...staffMembers, ...customMembers].filter(member => member.name);
      $('teamSummary').textContent = `${teams.length}개 팀`;
      $('teamGrid').innerHTML = teams.map(team => {
        const members = allMembers.filter(member => {
          const override = config.personTeams?.[member.name];
          const memberTeams = Array.isArray(override) ? override : member.teams;
          return memberTeams.includes(team) && !(config.campExclude || []).includes(member.name);
        });
        return `<div class="team-box">
          <strong>${esc(team)}</strong>
          <ul>${members.length ? members.map(member => `<li>${esc(member.name)}</li>`).join('') : '<li class="is-empty">미배정</li>'}</ul>
        </div>`;
      }).join('');
    }

    async function loadAccounts() {
      if (role !== 'admin') return;
      try {
        const res = await fetch('/api/camp-progress/accounts', { headers:authHeaders() });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '계정 로드 실패');
        const accounts = data.accounts || [];
        const accountByEmail = new Map(accounts.map(account => [account.email, account]));
        const staff = data.counselorStaff || [];
        const emails = [...new Set([...staff.map(item => item.email), ...accounts.map(item => item.email)])].filter(Boolean);
        $('accountGrid').innerHTML = emails.map(email => {
          const account = accountByEmail.get(email);
          const staffInfo = staff.find(item => item.email === email);
          const badge = account
            ? (account.disabled
              ? '<span class="account-badge is-disabled">비활성</span>'
              : '<span class="account-badge is-active">활성</span>')
            : '<span class="account-badge is-none">계정 없음</span>';
          return `<div class="account-card">
            <strong>${esc(staffInfo?.name || account?.name || email)}</strong>
            <div class="account-meta">
              <span>${esc(email)}</span>
              ${badge}
            </div>
            <div class="account-actions">
              <button type="button" data-email="${esc(email)}" data-action="select">불러오기</button>
              ${account ? `<button type="button" data-email="${esc(email)}" data-action="${account.disabled ? 'enable' : 'disable'}">${account.disabled ? '활성화' : '비활성화'}</button>
              <button type="button" data-email="${esc(email)}" data-action="delete">삭제</button>` : ''}
            </div>
          </div>`;
        }).join('');
        document.querySelectorAll('.account-actions button').forEach(btn => btn.addEventListener('click', () => accountAction(btn.dataset.action, btn.dataset.email)));
      } catch (error) {
        alert(error.message);
      }
    }

    async function upsertAccount() {
      const email = $('accountEmail').value.trim();
      const name = $('accountName').value.trim();
      const password = $('accountPassword').value;
      await accountAction('upsert', email, { name, password });
      $('accountPassword').value = '';
      await loadAccounts();
    }

    async function accountAction(action, email, extra = {}) {
      if (!email) return alert('이메일을 입력해주세요.');
      if (action === 'select') {
        $('accountEmail').value = email;
        const name = document.querySelector(`[data-email="${CSS.escape(email)}"]`)?.closest('.account-card')?.querySelector('strong')?.textContent || '';
        $('accountName').value = name;
        $('accountPassword').focus();
        return;
      }
      if ((action === 'delete' || action === 'disable') && !confirm(`${email} 계정을 ${action === 'delete' ? '삭제' : '비활성화'}할까요?`)) return;
      const res = await fetch('/api/camp-progress/accounts', {
        method:'POST',
        headers:authHeaders(),
        body:JSON.stringify({ action, email, ...extra }),
      });
      const data = await res.json();
      if (!res.ok) return alert(data.error || '계정 저장 실패');
      await loadAccounts();
    }

    setup();
  </script>
</body>
</html>
