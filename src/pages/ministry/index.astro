---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

// 네 사역 — 소개 아래 바로가기와 사역 꼭지가 같은 목록을 쓴다
const ministries = [
  {
    id: 'camp-ministry', num: '01', href: '/camp', label: 'CAMP MINISTRY',
    img: '/images/heroes/camphero.jpg', pos: '50% 50%',
    ko: '캠프 사역', en: 'Camp Ministry',
    leadKo: '한 번의 캠프가 평생을 바꾸는 경험이 됩니다.', leadEn: 'One camp can become a life-changing experience.',
    descKo: '말씀을 통해 삶의 방향을 다시 세우고, 훈련된 리더와 공동체 안에서 자신을 돌아보며 복음 안에서 새로운 비전과 기쁨을 경험하도록 돕습니다. 단순한 행사로 끝나지 않고, 복음 전도와 제자훈련을 통해 삶의 변화를 목표로 합니다.',
    descEn: "We help campers rebuild their direction through God's Word, reflect with trained leaders and a caring community, and discover new vision and joy in the Gospel. Camp is more than an event: the goal is real life change through evangelism and discipleship.",
    points: [
      { ko: '복음을 분명하게 듣는 말씀 시간', en: 'Clear Gospel messages', dKo: '선교사님들이 전하는 복음 말씀으로 인생의 방향과 비전을 발견합니다.', dEn: 'Missionaries share the Gospel so campers can discover direction and vision for their lives.' },
      { ko: '함께 걷는 상담자와 공동체', en: 'Counselors and community', dKo: '훈련된 상담자와 친구들 곁에서 고민을 나누고 복음 안에서 답을 찾습니다.', dEn: 'Trained counselors and friends walk alongside campers as they share struggles and find answers in the Gospel.' },
      { ko: '영어 환경에서의 경험', en: 'An English-speaking environment', dKo: '원어민 선생님들과 함께 생활하며 영어 실력과 영적 성장을 함께 키웁니다.', dEn: 'Living with native-speaking teachers helps campers grow in English and in faith together.' },
    ],
    facts: [
      { kKo: '프로그램', kEn: 'Programs', vKo: '영어캠프 · 제주캠프 · 연합캠프', vEn: 'English · Jeju · Union Camps' },
      { kKo: '대상', kEn: 'For', vKo: '영어캠프 초6–중3 / 제주캠프 고1–고3', vEn: 'English Camp: Grades 6–9 / Jeju Camp: Grades 10–12' },
    ],
    linkKo: '캠프 사역 보기', linkEn: 'Explore Camp Ministry',
  },
  {
    id: 'wolbi-ministry', num: '02', href: '/wolbi-jeju', label: 'WORD OF LIFE BIBLE INSTITUTE',
    img: '/images/wolbi-jeju/hero-campus-spring-2026.jpeg', pos: '50% 45%',
    ko: '제주월비', en: 'WOLBI Jeju',
    leadKo: '말씀 위에 굳게 세워지는 11개월.', leadEn: "Eleven months of being built on God's Word.",
    descKo: '제주 월비(Word of Life Bible Institute)는 대학 과정에 준하는 체계적인 성경 교육과 제자훈련으로 다음 세대를 준비시키는 사역입니다. 세계 5개 대륙 10개 캠퍼스 네트워크의 일부로, 여러 나라의 청년들이 함께 배우고 사역합니다.',
    descEn: 'WOLBI Jeju (Word of Life Bible Institute) prepares the next generation through systematic, college-level Bible education and discipleship. As part of a network of 10 campuses on 5 continents, young people from many nations learn and serve together.',
    points: [
      { ko: '성경 66권과 조직신학', en: 'All 66 books and theology', dKo: '구약·신약 전권과 조직신학을 세계적인 교수진에게 영어로 배웁니다.', dEn: 'Study the Old and New Testaments and systematic theology in English with a world-class faculty.' },
      { ko: '현장에서 배우는 선교', en: 'Missions in the field', dKo: '태국·베트남 선교 여행(12월)과 이스라엘 성지 순례(3월)를 경험합니다.', dEn: 'Join mission trips to Thailand and Vietnam (December) and a Holy Land pilgrimage to Israel (March).' },
      { ko: '다양한 나라의 공동체', en: 'A multicultural community', dKo: '북미·한국·아시아 청년들이 함께 신앙 공동체를 이룹니다.', dEn: 'Students from North America, Korea, and Asia live as one community of faith.' },
    ],
    facts: [
      { kKo: '과정', kEn: 'Program', vKo: '11개월 집중 과정', vEn: '11-month immersive program' },
      { kKo: '지원 자격', kEn: 'Eligibility', vKo: '고등학교 졸업자 이상 (졸업예정자 포함)', vEn: 'High school graduates (including expected graduates)' },
    ],
    linkKo: '제주월비 보기', linkEn: 'Explore WOLBI Jeju',
  },
  {
    id: 'youth-ministry', num: '03', href: '/youth', label: 'YOUTH MINISTRY',
    img: 'https://wolko.synology.me/Web_Contents/Photos/Youth_Ministry/CT.png', pos: '50% 45%',
    ko: '청소년 사역', en: 'Youth Ministry',
    leadKo: '프로그램보다 복음이 흘러가는 구조를 세웁니다.', leadEn: 'We build a structure where the Gospel keeps flowing, not just a program.',
    descKo: '선생님과 리더가 먼저 복음으로 세워지고, 학생들에게 복음이 흘러가며, 복음을 들은 학생들이 다시 친구를 초대하는 흐름을 만들어 갑니다. 월코는 교회와 다양한 사역 현장이 이 건강한 순환 위에 서도록 돕습니다.',
    descEn: 'Teachers and leaders are first established in the Gospel, the Gospel then flows to students, and those who hear it invite their friends. WOLKO helps churches and ministry settings stand on this healthy cycle.',
    points: [
      { ko: '리더를 먼저 세웁니다', en: 'Leaders first', dKo: '교회와 사역 현장의 선생님·리더에게 복음을 전하고 실제 사역에 필요한 훈련을 제공합니다.', dEn: 'We share the Gospel with church and ministry leaders and equip them with practical training.' },
      { ko: '친구가 친구에게', en: 'Friend to friend', dKo: '전도 이벤트와 다양한 모임에서 학생들이 친구를 초대하고 복음을 나눕니다.', dEn: 'At outreach events and gatherings, students invite friends and share the Gospel.' },
      { ko: '교회 공동체로 연결', en: 'Connected to church', dKo: '영접한 학생들이 예배와 양육, 제자훈련 안에서 계속 성장하도록 돕습니다.', dEn: 'Students who receive Christ keep growing through worship, nurture, and discipleship.' },
    ],
    facts: [
      { kKo: '핵심', kEn: 'Focus', vKo: '리더 훈련 · 학생 사역 · 전도 이벤트', vEn: 'Leader training · Student ministry · Outreach events' },
      { kKo: '협력', kEn: 'Partners', vKo: '교회 청소년부 · 선생님 · 사역 리더', vEn: 'Church youth groups · Teachers · Ministry leaders' },
    ],
    linkKo: '청소년 사역 보기', linkEn: 'Explore Youth Ministry',
  },
  {
    id: 'syme-ministry', num: '04', href: '/jr-syme', label: 'JR. SYME DISCIPLESHIP',
    img: '/images/syme-community.jpg', pos: '50% 58%',
    ko: 'SYME 제자훈련', en: 'SYME Discipleship',
    leadKo: '영어 안에서 말씀에 뿌리내리는 3주.', leadEn: 'Three weeks of taking root in the Word, in English.',
    descKo: 'Jr. SYME은 방학을 활용한 3주 영어 제자훈련 프로그램입니다. 언어 학습을 넘어 Word of Life의 검증된 성경 커리큘럼 안에서 말씀에 뿌리내리고, 복음을 전하는 리더로 성장하는 것을 목표로 합니다.',
    descEn: "Jr. SYME is a three-week English discipleship program held during school vacation. Beyond language learning, students take root in the Word through Word of Life's proven Bible curriculum and grow into leaders who share the Gospel.",
    points: [
      { ko: '모든 활동이 영어로', en: 'Everything in English', dKo: '모든 강의와 활동이 영어로 진행되어 언어와 신앙이 함께 자랍니다.', dEn: 'All lessons and activities are in English, so language and faith grow together.' },
      { ko: '말씀 위에 삶을 세우기', en: 'Life built on the Word', dKo: '성경 묵상, 말씀 암송, 소그룹 나눔으로 하나님의 말씀 위에 삶을 세웁니다.', dEn: "Bible meditation, Scripture memorization, and small groups build life on God's Word." },
      { ko: '또래와 함께하는 공동체', en: 'Community with peers', dKo: '3주간의 공동체 생활로 서로 세우고 도전하며 성장합니다.', dEn: 'Three weeks of shared life where students encourage and challenge one another.' },
    ],
    facts: [
      { kKo: '대상', kEn: 'For', vKo: '중·고등학생 (7–12학년)', vEn: 'Middle and high school students (Grades 7–12)' },
      { kKo: '기간', kEn: 'Duration', vKo: '방학 3주 집중과정', vEn: '3-week vacation intensive' },
    ],
    linkKo: 'SYME 자세히 보기', linkEn: 'Explore SYME',
  },
];
---

<BaseLayout
  title="월코 사역 — Word of Life Korea"
  description="캠프, 제주월비, 청소년 사역, SYME로 이어지는 Word of Life Korea의 다음 세대 사역을 한눈에 살펴보세요."
  activeNav="ministry"
>
  <main class="ministry-hub">
    <PageHero align="center" image="/images/heroes/campgroup.jpg" pos="50% 45%">
      <Fragment slot="eyebrow"><span class="wl-ko">월코 사역</span><span class="wl-en">Our Ministries</span></Fragment>
      <Fragment slot="title">
        <span class="wl-ko">다음 세대를 세우는 <br class="ph-br">네 개의 사역</span>
        <span class="wl-en">Four Ministries, One Gospel</span>
      </Fragment>
      <Fragment slot="bar">
        <p class="ph-sub">
          <span class="wl-ko">캠프의 특별한 만남부터 일상의 제자훈련과 깊이 있는 성경교육까지, 월코는 복음으로 다음 세대의 삶을 연결합니다.</span>
          <span class="wl-en">From life-changing camps to everyday discipleship and in-depth Bible training, WOLKO connects the next generation with the Gospel.</span>
        </p>
        <div class="ph-actions">
          <a class="ph-cta" href="#ministry-overview"><span class="wl-ko">사역 한눈에 보기</span><span class="wl-en">Explore the Ministries</span><svg aria-hidden="true" viewBox="0 0 16 16" fill="none"><path d="M8 2v11M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.8" stroke-linecap="square"/></svg></a>
        </div>
      </Fragment>
    </PageHero>

    <section class="mh-intro" id="ministry-overview">
      <div class="mh-shell mh-intro-inner">
        <div>
          <p class="mh-eyebrow"><span class="wl-ko">월코의 사역</span><span class="wl-en">WOLKO Ministries</span></p>
          <h2><span class="wl-ko">각기 다른 현장,<br>하나의 분명한 목적</span><span class="wl-en">Different Settings,<br>One Clear Purpose</span></h2>
        </div>
        <div>
          <p class="mh-intro-copy">
            <span class="wl-ko">모든 사역은 청소년과 청년이 복음을 듣고, 말씀 안에서 성장하며, 지역 교회와 세상 속에서 그리스도의 제자로 살아가도록 돕는 한 가지 목적을 향합니다.</span>
            <span class="wl-en">Every ministry shares one purpose: helping young people hear the Gospel, grow in God's Word, and live as disciples of Christ in their churches and communities.</span>
          </p>
          <nav class="mh-jump" aria-label="사역 바로가기">
            {ministries.map((m) => (
              <a href={`#${m.id}`}>
                <span class="mh-jump-num">{m.num}</span>
                <span class="mh-jump-name"><span class="wl-ko">{m.ko}</span><span class="wl-en">{m.en}</span></span>
              </a>
            ))}
          </nav>
        </div>
      </div>
    </section>

    {ministries.map((m, i) => (
      <section class:list={['mh-chapter', { 'mh-chapter--flip': i % 2 === 1 }]} id={m.id}>
        <div class="mh-shell mh-chapter-inner">
          <a class="mh-chapter-media" href={m.href} tabindex="-1" aria-hidden="true">
            <img src={m.img} alt="" loading="lazy" style={`object-position:${m.pos}`}>
          </a>
          <div class="mh-chapter-body">
            <p class="mh-chapter-label"><span class="mh-chapter-num">{m.num}</span>{m.label}</p>
            <h3><span class="wl-ko">{m.ko}</span><span class="wl-en">{m.en}</span></h3>
            <p class="mh-chapter-lead"><span class="wl-ko">{m.leadKo}</span><span class="wl-en">{m.leadEn}</span></p>
            <p class="mh-chapter-desc"><span class="wl-ko">{m.descKo}</span><span class="wl-en">{m.descEn}</span></p>
            <ul class="mh-points">
              {m.points.map((p) => (
                <li>
                  <strong><span class="wl-ko">{p.ko}</span><span class="wl-en">{p.en}</span></strong>
                  <p><span class="wl-ko">{p.dKo}</span><span class="wl-en">{p.dEn}</span></p>
                </li>
              ))}
            </ul>
            <dl class="mh-facts">
              {m.facts.map((f) => (
                <div>
                  <dt><span class="wl-ko">{f.kKo}</span><span class="wl-en">{f.kEn}</span></dt>
                  <dd><span class="wl-ko">{f.vKo}</span><span class="wl-en">{f.vEn}</span></dd>
                </div>
              ))}
            </dl>
            <a class="mh-chapter-link" href={m.href}>
              <span class="wl-ko">{m.linkKo}</span><span class="wl-en">{m.linkEn}</span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
            </a>
          </div>
        </div>
      </section>
    ))}

    <section class="mh-closing">
      <div class="mh-shell mh-closing-inner">
        <div>
          <p class="mh-eyebrow"><span class="wl-ko">함께 알아보기</span><span class="wl-en">Start a Conversation</span></p>
          <h2><span class="wl-ko">어떤 사역이 가장 잘 맞을지<br>함께 이야기해 보세요.</span><span class="wl-en">Let's find the right ministry<br>for you or your church.</span></h2>
        </div>
        <div class="mh-closing-actions">
          <a class="mh-btn mh-btn-primary" href="/contact">
            <span class="wl-ko">문의하기</span><span class="wl-en">Contact Us</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4"/></svg>
          </a>
          <a class="mh-btn mh-btn-secondary" href="/about">
            <span class="wl-ko">월코 소개</span><span class="wl-en">About WOLKO</span>
          </a>
        </div>
      </div>
    </section>
  </main>

  <script is:inline>
    // 사역 페이지 움직임: 스크롤하면 사진은 살짝 당겨지며 자리 잡고, 글은 아래에서 차례로 떠오른다.
    // 움직임 줄이기 설정이거나 IntersectionObserver 가 없으면 아무것도 하지 않는다 — 처음부터 그대로 다 보인다.
    (function () {
      if (!('IntersectionObserver' in window)) return;
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var items = [].slice.call(document.querySelectorAll('.mh-intro-inner > *, .mh-chapter-media, .mh-chapter-body > *, .mh-closing-inner > *'));
      items.forEach(function (el) {
        var sib = el.parentNode.children, i = [].indexOf.call(sib, el);
        el.style.setProperty('--d', Math.min(i, 6) * 0.08 + 's');
        el.classList.add('mh-rv');
      });
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('is-in'); io.unobserve(en.target); } });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      items.forEach(function (el) { io.observe(el); });
    })();
  </script>

  <style>
    .ministry-hub {
      --mh-deep: #004f68;
      --mh-navy: #0b2430;
      --mh-ink: #10252e;
      --mh-text: #4a5d66;
      --mh-muted: #587383;
      --mh-label: #5a7380;
      --mh-line: #d6dee2;
      --mh-soft: #f6f9fb;
      --mh-fill: #f3f7f9;
      color: var(--mh-ink);
      background: #fff;
      font-family: var(--ff-sans);
      word-break: keep-all;
      overflow: hidden;
    }
    .mh-shell { width: min(1200px, calc(100% - 48px)); margin-inline: auto; }
    .ministry-hub svg { width: 14px; height: 14px; flex: none; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: square; }

    /* 작은 표시 — 앞에 가는 선 (맨 위 배너와 같은 모양) */
    .mh-eyebrow { display: flex; align-items: center; gap: 12px; color: var(--mh-deep); font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    .mh-eyebrow::before { content: ''; width: 28px; height: 1px; background: currentColor; }

    /* 소개 + 바로가기 */
    .mh-intro { padding: 120px 0 96px; }
    .mh-intro-inner { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 80px; align-items: end; }
    .mh-intro h2, .mh-closing h2 { margin-top: 20px; font-family: var(--ff-serif); font-size: clamp(32px, 3.4vw, 46px); font-weight: 700; line-height: 1.22; letter-spacing: -.03em; color: var(--mh-navy); }
    .mh-intro-copy { color: #3e535d; font-size: 18px; line-height: 1.85; }
    .mh-jump { margin-top: 36px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); border-top: 2px solid var(--mh-navy); }
    .mh-jump a { padding: 16px 12px 4px 0; display: flex; flex-direction: column; gap: 6px; color: var(--mh-ink); text-decoration: none; }
    .mh-jump-num { font-family: var(--ff-serif); font-size: 13px; color: var(--mh-deep); }
    .mh-jump-name { font-size: 16px; font-weight: 700; transition: color .2s; }
    .mh-jump a:hover .mh-jump-name { color: var(--mh-deep); text-decoration: underline; text-underline-offset: 4px; }

    /* 사역 한 꼭지 — 큰 사진 + 글, 꼭지마다 좌우가 바뀐다 */
    .mh-chapter { padding: 72px 0; scroll-margin-top: 40px; }
    .mh-chapter--flip { background: var(--mh-soft); }
    .mh-chapter-inner { display: flex; gap: 72px; align-items: stretch; }
    .mh-chapter--flip .mh-chapter-inner { flex-direction: row-reverse; }
    .mh-chapter-media { flex: 7 1 0; min-width: 0; min-height: 560px; display: block; overflow: hidden; background: var(--mh-navy); }
    .mh-chapter-media img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s cubic-bezier(.2,.7,.2,1); }
    .mh-chapter-media:hover img { transform: scale(1.03); }
    .mh-chapter-body { flex: 5 1 0; min-width: 0; padding: 12px 0; display: flex; flex-direction: column; }
    .mh-chapter-label { display: flex; align-items: baseline; gap: 14px; color: var(--mh-label); font-size: 12px; font-weight: 700; letter-spacing: .12em; }
    .mh-chapter-num { font-family: var(--ff-serif); font-size: 15px; letter-spacing: 0; color: var(--mh-deep); }
    .mh-chapter h3 { margin-top: 16px; font-family: var(--ff-serif); font-size: clamp(30px, 2.8vw, 40px); font-weight: 700; line-height: 1.2; letter-spacing: -.03em; color: var(--mh-navy); }
    .mh-chapter-lead { margin-top: 18px; font-size: 19px; font-weight: 600; line-height: 1.6; color: var(--mh-ink); }
    .mh-chapter-desc { margin-top: 14px; font-size: 15.5px; line-height: 1.85; color: var(--mh-text); }
    .mh-points { list-style: none; margin-top: 28px; }
    .mh-points li { padding: 14px 0; border-top: 1px solid var(--mh-line); }
    .mh-points strong { display: block; font-size: 15px; font-weight: 700; color: var(--mh-navy); }
    .mh-points p { margin-top: 4px; font-size: 14px; line-height: 1.7; color: var(--mh-muted); }
