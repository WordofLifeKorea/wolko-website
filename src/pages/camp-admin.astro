---
// Admin page — password protected via /api/admin/login
// No BaseLayout; standalone page
import { getCollection } from 'astro:content';
const teamMembers = (await getCollection('team'))
  .filter(m => !m.slug.startsWith('map-order'))
  .sort((a, b) => a.data.order - b.data.order)
  .map(m => ({ slug: m.slug, name_ko: m.data.name_ko, name_en: m.data.name_en, category: m.data.category }));
const teamMembersJson = JSON.stringify(teamMembers);
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>관리자 — WOLKO 캠프 신청 현황</title>
  <link rel="icon" type="image/png" href="/images/WOLKO Circle.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@600;700&family=Noto+Sans+KR:wght@400;500;600&display=swap" rel="stylesheet">
  <style is:global>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --blue:    #004f68;
      --blue-lt: #0077a3;
      --accent:  #c42a36;
      --bg:      #f4f6f8;
      --card:    #ffffff;
      --border:  #e4eaee;
      --text:    #1a2d38;
      --mid:     #5a7585;
      --light:   #8fa8b5;
      --green:   #1da462;
      --orange:  #e07b00;
      --red:     #c42a36;
      --f-sans:  'Montserrat', sans-serif;
      --f-body:  'Noto Sans KR', sans-serif;
    }

    body { font-family: var(--f-body); background: var(--bg); color: var(--text); min-height: 100vh; }

    /* ── LOGIN SCREEN ── */
    .login-screen {
      position: fixed; inset: 0;
      background: linear-gradient(145deg, #003d52, #00627f);
      display: flex; align-items: center; justify-content: center;
      z-index: 9999;
      transition: opacity 0.4s ease;
    }
    .login-screen.hidden { opacity: 0; pointer-events: none; }

    .login-card {
      background: #fff;
      border-radius: 20px;
      padding: 48px 40px 40px;
      width: 100%;
      max-width: 380px;
      box-shadow: 0 24px 64px rgba(0,0,0,0.25);
      text-align: center;
    }
    .login-logo {
      display: flex; align-items: center; justify-content: center; gap: 10px;
      margin-bottom: 28px;
    }
    .login-logo img { height: 36px; }
    .login-logo-text { text-align: left; }
    .login-logo-name {
      display: block;
      font-family: var(--f-sans);
      font-size: 15px; font-weight: 700;
      color: var(--blue);
      letter-spacing: 0.04em;
    }
    .login-logo-sub {
      display: block;
      font-size: 10px; color: var(--light);
      letter-spacing: 0.06em;
      font-family: var(--f-sans);
    }
    .login-title {
      font-size: 15px; font-weight: 600; color: var(--mid);
      margin-bottom: 24px;
      letter-spacing: 0.02em;
    }
    .login-input-wrap { position: relative; margin-bottom: 14px; }
    .login-input {
      width: 100%;
      padding: 14px 46px 14px 16px;
      border: 1.5px solid var(--border);
      border-radius: 10px;
      font-size: 15px;
      font-family: var(--f-body);
      color: var(--text);
      outline: none;
      transition: border-color 0.2s;
      background: #fafbfc;
    }
    .login-input:focus { border-color: var(--blue); background: #fff; }
    .login-input.error { border-color: var(--red); }
    .login-eye {
      position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
      background: none; border: none; cursor: pointer; color: var(--light);
      padding: 4px; transition: color 0.2s;
    }
    .login-eye:hover { color: var(--blue); }

    .login-error {
      font-size: 12px; color: var(--red);
      margin-bottom: 12px; min-height: 18px;
      text-align: left;
    }
    .login-btn {
      width: 100%;
      padding: 14px;
      background: var(--blue);
      color: #fff;
      border: none;
      border-radius: 10px;
      font-size: 15px;
      font-weight: 600;
      font-family: var(--f-body);
      cursor: pointer;
      transition: background 0.2s, transform 0.15s;
      letter-spacing: 0.02em;
    }
    .login-btn:hover { background: var(--blue-lt); }
    .login-btn:active { transform: scale(0.98); }
    .login-btn:disabled { opacity: 0.6; cursor: not-allowed; }

    /* ── HEADER ── */
    .adm-header {
      background: var(--blue);
      padding: 0 32px;
      height: 60px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: sticky; top: 0; z-index: 100;
      box-shadow: 0 2px 12px rgba(0,79,104,0.25);
    }
    .adm-header-logo {
      display: flex; align-items: center; gap: 10px;
      text-decoration: none;
    }
    .adm-header-logo img { height: 30px; }
    .adm-header-logo span {
      font-family: var(--f-sans); font-size: 14px; font-weight: 700;
      color: rgba(255,255,255,0.9); letter-spacing: 0.04em;
    }
    .adm-header-right { display: flex; align-items: center; gap: 12px; }
    .adm-header-badge {
      background: rgba(255,255,255,0.15);
      border: 1px solid rgba(255,255,255,0.25);
      color: rgba(255,255,255,0.8);
      font-size: 11px; font-weight: 600; letter-spacing: 0.1em;
      padding: 4px 10px; border-radius: 100px;
      font-family: var(--f-sans);
    }
    .btn-logout {
      background: rgba(255,255,255,0.12);
      border: 1px solid rgba(255,255,255,0.2);
      color: rgba(255,255,255,0.75);
      font-size: 12px; font-weight: 600;
      padding: 5px 12px; border-radius: 100px;
      cursor: pointer; font-family: var(--f-body);
      transition: background 0.2s;
    }
    .btn-logout:hover { background: rgba(255,255,255,0.22); color: #fff; }

    /* ── LAYOUT ── */
    .adm-wrap { max-width: 1280px; margin: 0 auto; padding: 40px 32px 100px; }

    /* ── CAMP CARDS ── */
    .camp-cards-label {
      font-size: 11px; font-weight: 600; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--light);
      font-family: var(--f-sans); margin-bottom: 14px;
    }
    .camp-cards {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
      margin-bottom: 36px;
    }
    .camp-card {
      flex: 1;
      min-width: 160px;
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 16px;
      padding: 20px 22px;
      cursor: pointer;
      transition: border-color 0.18s, box-shadow 0.18s;
      position: relative;
      user-select: none;
    }
    .camp-card:hover { border-color: rgba(0,79,104,0.25); box-shadow: 0 4px 16px rgba(0,79,104,0.08); }
    .camp-card.active { border: 2px solid var(--blue); box-shadow: 0 4px 20px rgba(0,79,104,0.12); }

    .camp-card-top {
      display: flex; align-items: center;
      margin-bottom: 12px;
    }
    .camp-card-kicker {
      font-size: 11px; font-weight: 600; letter-spacing: 0.08em;
      text-transform: uppercase; font-family: var(--f-sans);
      color: var(--light);
    }
    .camp-card-badge {
      margin-left: auto;
      font-size: 11px; font-weight: 500;
      padding: 2px 10px; border-radius: 100px;
      background: rgba(0,79,104,0.09); color: var(--blue);
      font-family: var(--f-sans);
      opacity: 0; transition: opacity 0.18s;
    }
    .camp-card.active .camp-card-badge { opacity: 1; }

    .camp-card-title {
      font-size: 16px; font-weight: 600;
      color: var(--text); margin-bottom: 18px;
      line-height: 1.3; font-family: var(--f-body);
    }
    .camp-card-stats { display: flex; align-items: center; gap: 18px; }
    .camp-card-stat { display: flex; flex-direction: column; gap: 4px; }
    .camp-card-stat-val {
      font-size: 22px; font-weight: 600;
      font-family: var(--f-sans); color: var(--text); line-height: 1;
    }
    .camp-card-stat-val.green { color: var(--green); }
    .camp-card-stat-lbl {
      font-size: 11px; color: var(--light);
      font-family: var(--f-sans); letter-spacing: 0.05em;
    }
    .camp-card-sep { width: 1px; height: 28px; background: var(--border); }

    /* ── DASHBOARD CARDS ── */
    .dash-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px; margin-bottom: 28px; }
    .dash-card { background: var(--card); border-radius: 12px; padding: 20px 22px; border: 1px solid var(--border); box-shadow: 0 2px 8px rgba(0,79,104,0.05); }
    .dash-label { font-size: 11px; font-weight: 600; letter-spacing: 0.1em; color: var(--light); font-family: var(--f-sans); margin-bottom: 8px; text-transform: uppercase; }
    .dash-value { font-size: 32px; font-weight: 700; font-family: var(--f-sans); color: var(--blue); line-height: 1; margin-bottom: 6px; }
    .dash-value.green { color: var(--green); }
    .dash-value.orange { color: var(--orange); }
    .dash-value.red { color: var(--red); }
    .dash-sub { font-size: 12px; color: var(--light); }

    /* ── PROGRESS BAR ── */
    .progress-wrap { margin-bottom: 28px; }
    .progress-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .progress-title { font-size: 13px; font-weight: 600; color: var(--mid); }
    .progress-pct { font-size: 13px; font-weight: 700; color: var(--blue); font-family: var(--f-sans); }
    .progress-bar-bg { height: 10px; background: var(--border); border-radius: 100px; overflow: hidden; }
    .progress-bar-fill { height: 100%; background: linear-gradient(90deg, var(--blue), var(--blue-lt)); border-radius: 100px; transition: width 0.5s ease; }
    .progress-bar-fill.warn { background: linear-gradient(90deg, var(--orange), #f59f2a); }
    .progress-bar-fill.full { background: linear-gradient(90deg, var(--red), #e85565); }

    /* ── TABLE SECTION ── */
    .table-section { background: var(--card); border-radius: 16px; border: 1px solid var(--border); box-shadow: 0 2px 12px rgba(0,79,104,0.05); overflow: hidden; }
    .table-toolbar { display: flex; align-items: center; justify-content: space-between; padding: 18px 22px; border-bottom: 1px solid var(--border); flex-wrap: wrap; gap: 12px; }
    .table-title { font-size: 15px; font-weight: 600; color: var(--text); }
    .table-count { font-size: 13px; color: var(--light); margin-left: 8px; }
    .btn-csv {
      display: inline-flex; align-items: center; gap: 7px;
      background: var(--blue); color: #fff; border: none; border-radius: 8px;
      padding: 9px 18px; font-size: 13px; font-weight: 600;
      font-family: var(--f-body); cursor: pointer; transition: background 0.2s, transform 0.15s;
    }
    .btn-csv:hover { background: var(--blue-lt); transform: translateY(-1px); }

    .table-scroll { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; }
    thead tr { background: #f8fafc; }
    th { padding: 11px 14px; text-align: left; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; color: var(--light); text-transform: uppercase; font-family: var(--f-sans); border-bottom: 1px solid var(--border); white-space: nowrap; }
    td { padding: 13px 14px; border-bottom: 1px solid #f0f4f7; color: var(--text); vertical-align: middle; }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: #f8fafc; }

    .badge { display: inline-block; padding: 3px 10px; border-radius: 100px; font-size: 11px; font-weight: 600; font-family: var(--f-sans); }
    .badge-individual { background: #e8f4fb; color: #0077a3; }
    .badge-group { background: #fef3e2; color: #c47a00; }

    .btn-del { background: none; border: 1px solid #ffd5d8; color: var(--red); border-radius: 6px; padding: 4px 10px; font-size: 11px; font-weight: 600; cursor: pointer; transition: background 0.15s, border-color 0.15s; font-family: var(--f-body); }
    .btn-del:hover { background: #fff0f1; border-color: var(--red); }

    /* ── EMPTY / LOADING STATE ── */
    .state-box { text-align: center; padding: 60px 20px; color: var(--light); }
    .state-box p { font-size: 14px; }
    .spinner { width: 36px; height: 36px; border: 3px solid var(--border); border-top-color: var(--blue); border-radius: 50%; animation: spin 0.7s linear infinite; margin: 0 auto 16px; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ── TOAST ── */
    .toast { position: fixed; bottom: 32px; right: 32px; background: var(--text); color: #fff; padding: 12px 20px; border-radius: 10px; font-size: 13px; font-weight: 500; box-shadow: 0 8px 24px rgba(0,0,0,0.2); opacity: 0; transform: translateY(10px); transition: opacity 0.25s, transform 0.25s; z-index: 999; pointer-events: none; }
    .toast.show { opacity: 1; transform: translateY(0); }
    .toast.success { background: var(--green); }
    .toast.error { background: var(--red); }

    @media (max-width: 640px) {
      .adm-wrap { padding: 20px 14px 60px; }
      .adm-header { padding: 0 16px; }
      .login-card { padding: 36px 24px 28px; margin: 16px; }
      th, td { padding: 10px 10px; }
    }

    /* ── TEAM PASSWORD SECTION ── */
    .team-section {
      margin-top: 48px;
    }
    .team-section-header {
      display: flex; align-items: center; gap: 12px;
      margin-bottom: 20px;
    }
    .team-section-title {
      font-family: var(--f-sans); font-size: 13px; font-weight: 700;
      color: var(--blue); letter-spacing: 0.06em; text-transform: uppercase;
    }
    .team-section-sub {
      font-size: 12px; color: var(--light);
    }
    .team-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 12px;
    }
    .team-member-card {
      background: var(--card);
      border: 1.5px solid var(--border);
      border-radius: 14px;
      padding: 18px 20px;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .team-member-card:hover { border-color: rgba(0,79,104,0.25); box-shadow: 0 2px 12px rgba(0,79,104,0.07); }
    .team-member-name {
      font-weight: 600; font-size: 14px; color: var(--text);
      margin-bottom: 2px;
    }
    .team-member-slug {
      font-size: 11px; color: var(--light); font-family: var(--f-sans);
      letter-spacing: 0.04em; margin-bottom: 14px;
    }
    .team-pw-row {
      display: flex; gap: 8px; align-items: center;
    }
    .team-pw-input {
      flex: 1;
      padding: 9px 12px;
      border: 1.5px solid var(--border);
      border-radius: 8px;
      font-size: 13px; font-family: var(--f-body);
      color: var(--text); background: #fafbfc;
      outline: none; transition: border-color 0.2s;
    }
    .team-pw-input:focus { border-color: var(--blue); background: #fff; }
    .team-pw-input.has-pw { border-color: var(--green); }
    .btn-set-pw {
      padding: 9px 14px;
      background: var(--blue);
      color: #fff; border: none;
      border-radius: 8px;
      font-size: 12px; font-weight: 600;
      font-family: var(--f-sans);
      cursor: pointer; white-space: nowrap;
      transition: background 0.2s;
      letter-spacing: 0.03em;
    }
    .btn-set-pw:hover { background: var(--blue-lt); }
    .btn-set-pw:disabled { opacity: 0.5; cursor: not-allowed; }
    .team-pw-status {
      font-size: 11px; margin-top: 6px; min-height: 16px;
    }
    .team-pw-status.ok { color: var(--green); font-weight: 600; }
    .team-pw-status.err { color: var(--red); }
    .team-pw-link {
      display: inline-flex; align-items: center; gap: 4px;
      font-size: 11px; color: var(--blue-lt);
      text-decoration: none; margin-top: 6px;
      font-family: var(--f-sans); letter-spacing: 0.03em;
    }
    .team-pw-link:hover { text-decoration: underline; }
  </style>
</head>
<body>

  <!-- ── LOGIN SCREEN ── -->
  <div class="login-screen" id="loginScreen">
    <div class="login-card">
      <div class="login-logo">
        <img src="/images/WOLKO Circle.png" alt="WOLKO">
        <div class="login-logo-text">
          <span class="login-logo-name">WOLKO 월코</span>
          <span class="login-logo-sub">Word of Life Korea</span>
        </div>
      </div>
      <p class="login-title">관리자 로그인</p>
      <div class="login-input-wrap">
        <input class="login-input" type="password" id="pwInput" placeholder="비밀번호를 입력하세요" autocomplete="current-password">
        <button class="login-eye" id="eyeBtn" onclick="togglePw()" type="button" aria-label="비밀번호 표시">
          <svg id="eyeIcon" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M1 9C2.5 5.5 5.5 3 9 3s6.5 2.5 8 6c-1.5 3.5-4.5 6-8 6S2.5 12.5 1 9z" stroke="currentColor" stroke-width="1.5"/>
            <circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
      </div>
      <p class="login-error" id="loginError"></p>
      <button class="login-btn" id="loginBtn" onclick="doLogin()">로그인</button>
    </div>
  </div>

  <!-- ── HEADER ── -->
  <header class="adm-header">
    <a class="adm-header-logo" href="/">
      <img src="/images/WOLKO Circle.png" alt="WOLKO">
      <span>WOLKO 관리자</span>
    </a>
    <div class="adm-header-right">
      <span class="adm-header-badge">CAMP ADMIN</span>
      <button class="btn-logout" onclick="doLogout()">로그아웃</button>
    </div>
  </header>

  <div class="adm-wrap">
    <!-- CAMP CARDS -->
    <div class="camp-cards" id="campCards"></div>

    <!-- DASHBOARD CARDS -->
    <div class="dash-grid">
      <div class="dash-card">
        <div class="dash-label">총 신청</div>
        <div class="dash-value" id="dTotal">—</div>
        <div class="dash-sub" id="dTotalSub">불러오는 중…</div>
      </div>
      <div class="dash-card">
        <div class="dash-label">잔여 정원</div>
        <div class="dash-value green" id="dRemain">—</div>
        <div class="dash-sub" id="dRemainSub">정원 기준</div>
      </div>
      <div class="dash-card">
        <div class="dash-label">마감률</div>
        <div class="dash-value" id="dPct">—</div>
        <div class="dash-sub" id="dPctSub">신청 / 정원</div>
      </div>
    </div>

    <!-- PROGRESS -->
    <div class="progress-wrap">
      <div class="progress-header">
        <span class="progress-title" id="progressLabel">전체 정원 현황</span>
        <span class="progress-pct" id="progressPct">0%</span>
      </div>
      <div class="progress-bar-bg">
        <div class="progress-bar-fill" id="progressFill" style="width:0%"></div>
      </div>
    </div>

    <!-- TABLE -->
    <div class="table-section">
      <div class="table-toolbar">
        <div>
          <span class="table-title">신청 목록</span>
          <span class="table-count" id="tableCount"></span>
        </div>
        <button class="btn-csv" onclick="downloadCsv()">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
            <path d="M7 1v8M4 6l3 3 3-3M2 11h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          CSV 다운로드
        </button>
      </div>
      <div class="table-scroll">
        <table>
          <thead>
            <tr>
              <th>#</th><th>캠프</th><th>유형</th><th>이름</th><th>연락처</th>
              <th>이메일</th><th>학년 / 인원</th><th>교회</th><th>학교</th>
              <th>비상연락처</th><th>메모</th><th>신청일시</th><th>삭제</th>
            </tr>
          </thead>
          <tbody id="regBody">
            <tr><td colspan="13">
              <div class="state-box">
                <div class="spinner"></div>
                <p>로그인 후 자동으로 불러옵니다.</p>
              </div>
            </td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- ── TEAM PASSWORD MANAGEMENT ── -->
    <div class="team-section" id="teamSection">
      <div class="team-section-header">
        <div>
          <div class="team-section-title">👤 팀원 프로필 편집 비밀번호 관리</div>
          <div class="team-section-sub">각 선교사의 /team-edit/{slug} 페이지 로그인 비밀번호를 설정합니다</div>
        </div>
      </div>
      <div class="team-grid" id="teamGrid">
        <!-- JS로 생성 -->
      </div>
    </div>

  </div>

  <!-- TOAST -->
  <div class="toast" id="toast"></div>

  <!-- Team member data for JS (injected at build time) -->
  <script is:inline define:vars={{ teamMembersJson }}>
    window.__TEAM_MEMBERS__ = JSON.parse(teamMembersJson);
  </script>

  <script is:inline>
    const CAMP_GROUPS = [
      {
        group: 'wolko',
        label: 'WOLKO 캠프',
        camps: [
          { id: '2026-inland-english-junior', title: '주니어 영어캠프', capacity: 40 },
          { id: '2026-inland-union',          title: '교회 연합캠프',   capacity: 60 },
        ],
      },
      // 제주 캠프는 카페에서 별도 신청 — 추후 필요 시 아래 주석 해제
      // {
      //   group: 'jeju',
      //   label: 'JEJU 캠프',
      //   camps: [
      //     { id: '2026-jeju-english',    title: '제주 영어캠프', capacity: 60 },
      //     { id: '2026-jeju-momentum-1', title: '모멘텀 1차',    capacity: 60 },
      //     { id: '2026-jeju-momentum-2', title: '모멘텀 2차',    capacity: 60 },
      //   ],
      // },
    ];
    const CAMPS_ALL = [{ id: 'all', title: '전체 캠프', capacity: 100 }]
      .concat(CAMP_GROUPS.flatMap(g => g.camps));
    const CAMP_LABELS = Object.fromEntries(CAMPS_ALL.map(c => [c.id, c.title]));
    const CAMP_CAP    = Object.fromEntries(CAMPS_ALL.map(c => [c.id, c.capacity]));

    let allRegs = [];
    let activeCamp = 'all';
    let authToken = sessionStorage.getItem('wolko-admin-token') || '';

    // ── Login ──
    function togglePw() {
      const input = document.getElementById('pwInput');
      const icon = document.getElementById('eyeIcon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.innerHTML = `<path d="M2 2l14 14M7.5 7.6A2.5 2.5 0 0011.4 11.5M5.2 5.3C3.3 6.5 1.9 7.9 1 9c1.5 3.5 4.5 6 8 6 1.4 0 2.8-.4 4-1M9 3C12.5 3 15.5 5.5 17 9c-.5 1.1-1.2 2.1-2 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>`;
      } else {
        input.type = 'password';
        icon.innerHTML = `<path d="M1 9C2.5 5.5 5.5 3 9 3s6.5 2.5 8 6c-1.5 3.5-4.5 6-8 6S2.5 12.5 1 9z" stroke="currentColor" stroke-width="1.5"/><circle cx="9" cy="9" r="2.5" stroke="currentColor" stroke-width="1.5"/>`;
      }
    }

    document.getElementById('pwInput').addEventListener('keydown', e => {
      if (e.key === 'Enter') doLogin();
    });

    async function doLogin() {
      const pw = document.getElementById('pwInput').value;
      const btn = document.getElementById('loginBtn');
      const errEl = document.getElementById('loginError');
      const inputEl = document.getElementById('pwInput');
      if (!pw) { errEl.textContent = '비밀번호를 입력해주세요.'; return; }

      btn.disabled = true;
      btn.textContent = '확인 중…';
      errEl.textContent = '';
      inputEl.classList.remove('error');

      try {
        const res = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password: pw }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '로그인 실패');

        authToken = data.token;
        sessionStorage.setItem('wolko-admin-token', authToken);

        const screen = document.getElementById('loginScreen');
        screen.classList.add('hidden');
        setTimeout(() => screen.style.display = 'none', 400);
        loadRegs();
      } catch (e) {
        errEl.textContent = e.message;
        inputEl.classList.add('error');
      } finally {
        btn.disabled = false;
        btn.textContent = '로그인';
      }
    }

    function doLogout() {
      sessionStorage.removeItem('wolko-admin-token');
      authToken = '';
      location.reload();
    }

    function authHeaders() {
      return { 'Content-Type': 'application/json', 'Authorization': `Bearer ${authToken}` };
    }

    // ── Camp cards ──
    function makeCard(id, kicker, title, capacity) {
      const card = document.createElement('div');
      card.className = 'camp-card' + (id === 'all' ? ' active' : '');
      card.dataset.id = id;
      card.innerHTML = `
        <div class="camp-card-top">
          <span class="camp-card-kicker">${kicker}</span>
          <span class="camp-card-badge">선택됨</span>
        </div>
        <div class="camp-card-title">${title}</div>
        <div class="camp-card-stats">
          <div class="camp-card-stat">
            <div class="camp-card-stat-val" id="card-${id}-reg">—</div>
            <div class="camp-card-stat-lbl">신청</div>
          </div>
          <div class="camp-card-sep"></div>
          <div class="camp-card-stat">
            <div class="camp-card-stat-val green" id="card-${id}-cap">—</div>
            <div class="camp-card-stat-lbl">잔여</div>
          </div>
        </div>
      `;
      card.onclick = () => selectCamp(id);
      return card;
    }

    function buildCampCards() {
      const wrap = document.getElementById('campCards');
      wrap.innerHTML = '';
      wrap.appendChild(makeCard('all', '전체', '전체 캠프', 100));
      CAMP_GROUPS.flatMap(g => g.camps).forEach(c => {
        wrap.appendChild(makeCard(c.id, `WOLKO · 정원 ${c.capacity}명`, c.title, c.capacity));
      });
    }

    function updateCardStats() {
      CAMPS_ALL.forEach(c => {
        const regs = c.id === 'all' ? allRegs : allRegs.filter(r => r.campId === c.id);
        const total = regs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
        const remain = Math.max(0, c.capacity - total);
        const regEl = document.getElementById(`card-${c.id}-reg`);
        const capEl = document.getElementById(`card-${c.id}-cap`);
        if (regEl) regEl.textContent = total;
        if (capEl) capEl.textContent = remain;
      });
    }

    function selectCamp(id) {
      activeCamp = id;
      document.querySelectorAll('.camp-card').forEach(c =>
        c.classList.toggle('active', c.dataset.id === id)
      );
      renderTable();
      renderDash();
    }

    buildCampCards();

    // ── Fetch ──
    async function loadRegs() {
      try {
        const res = await fetch('/api/admin/registrations', { headers: authHeaders() });
        if (res.status === 401) {
          sessionStorage.removeItem('wolko-admin-token');
          location.reload();
          return;
        }
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = await res.json();
        allRegs = data.registrations || [];
        updateCardStats();
        renderTable();
        renderDash();
      } catch (e) {
        showToast('데이터를 불러오지 못했습니다: ' + e.message, 'error');
        document.getElementById('regBody').innerHTML = `
          <tr><td colspan="13">
            <div class="state-box">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                <circle cx="20" cy="20" r="18" stroke="#c42a36" stroke-width="2"/>
                <path d="M20 12v10M20 26v2" stroke="#c42a36" stroke-width="2" stroke-linecap="round"/>
              </svg>
              <p>데이터를 불러오지 못했습니다.<br>잠시 후 다시 시도해주세요.</p>
            </div>
          </td></tr>`;
      }
    }

    function filteredRegs() {
      if (activeCamp === 'all') return allRegs;
      return allRegs.filter(r => r.campId === activeCamp);
    }

    // ── Dashboard ──
    function renderDash() {
      const regs = filteredRegs();
      const cap = CAMP_CAP[activeCamp] || 280;
      const total = regs.reduce((s, r) => s + (r.registrationType === 'group' ? (r.groupCount || 1) : 1), 0);
      const remain = Math.max(0, cap - total);
      const pct = cap > 0 ? Math.round((total / cap) * 100) : 0;

      document.getElementById('dTotal').textContent = total;
      document.getElementById('dTotalSub').textContent = '명 신청 완료';
      document.getElementById('dRemain').textContent = remain;
      document.getElementById('dRemainSub').textContent = `정원 ${cap}명 기준`;
      document.getElementById('dPct').textContent = pct + '%';
      document.getElementById('dPct').className = 'dash-value' + (pct >= 100 ? ' red' : pct >= 80 ? ' orange' : '');
      document.getElementById('dPctSub').textContent = `${total} / ${cap}`;

      const campName = CAMP_LABELS[activeCamp] || '전체';
      document.getElementById('progressLabel').textContent = campName + ' 정원 현황';
      document.getElementById('progressPct').textContent = pct + '%';
      const fill = document.getElementById('progressFill');
      fill.style.width = Math.min(pct, 100) + '%';
      fill.className = 'progress-bar-fill' + (pct >= 100 ? ' full' : pct >= 80 ? ' warn' : '');
    }

    // ── Table ──
    function renderTable() {
      const regs = filteredRegs();
      const tbody = document.getElementById('regBody');
      document.getElementById('tableCount').textContent = `(${regs.length}건)`;

      if (regs.length === 0) {
        tbody.innerHTML = `
          <tr><td colspan="13">
            <div class="state-box">
              <svg width="40" height="40" viewBox="0 0 40 40" fill="none">
                <rect x="8" y="6" width="24" height="30" rx="3" stroke="#8fa8b5" stroke-width="2"/>
                <path d="M14 14h12M14 20h8M14 26h6" stroke="#8fa8b5" stroke-width="1.8" stroke-linecap="round"/>
              </svg>
              <p>신청 내역이 없습니다.</p>
            </div>
          </td></tr>`;
        return;
      }

      tbody.innerHTML = regs.map((r, i) => {
        const date = new Date(r.registeredAt);
        const dateStr = `${date.getFullYear()}.${String(date.getMonth()+1).padStart(2,'0')}.${String(date.getDate()).padStart(2,'0')} ${String(date.getHours()).padStart(2,'0')}:${String(date.getMinutes()).padStart(2,'0')}`;
        const campLabel = CAMP_LABELS[r.campId] || r.campId;
        const typeBadge = r.registrationType === 'group'
          ? `<span class="badge badge-group">단체</span>`
          : `<span class="badge badge-individual">개인</span>`;
        const gradeOrCount = r.registrationType === 'group' ? `${r.groupCount}명` : (r.grade || '—');

        return `<tr>
          <td style="color:var(--light);font-family:var(--f-sans)">${i + 1}</td>
          <td style="font-size:12px;color:var(--mid)">${esc(campLabel)}</td>
          <td>${typeBadge}</td>
          <td style="font-weight:600">${esc(r.name)}</td>
          <td>${esc(r.phone)}</td>
          <td style="font-size:12px;color:var(--mid)">${esc(r.email)}</td>
          <td style="font-family:var(--f-sans);font-size:12px">${esc(gradeOrCount)}</td>
          <td>${esc(r.church || '—')}</td>
          <td>${esc(r.school || '—')}</td>
          <td style="font-size:12px">${esc(r.emergency || '—')}</td>
          <td style="font-size:12px;color:var(--mid);max-width:160px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="${esc(r.notes || '')}">${esc(r.notes || '—')}</td>
          <td style="font-size:12px;color:var(--mid);white-space:nowrap">${dateStr}</td>
          <td><button class="btn-del" onclick="deleteReg('${r.regId}','${r.campId}')">삭제</button></td>
        </tr>`;
      }).join('');
    }

    function esc(str) {
      return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Delete ──
    async function deleteReg(regId, campId) {
      if (!confirm(`정말 삭제하시겠습니까?\n이 작업은 되돌릴 수 없습니다.`)) return;
      try {
        const res = await fetch(`/api/admin/registrations?regId=${regId}&campId=${campId}`, {
          method: 'DELETE', headers: authHeaders()
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '삭제 실패');
        allRegs = allRegs.filter(r => r.regId !== regId);
        renderTable();
        renderDash();
        showToast('신청이 삭제되었습니다.', 'success');
      } catch (e) {
        showToast('삭제 오류: ' + e.message, 'error');
      }
    }

    // ── CSV ──
    function downloadCsv() {
      const regs = filteredRegs();
      if (regs.length === 0) { showToast('다운로드할 데이터가 없습니다.', 'error'); return; }

      const headers = ['번호','캠프','유형','이름','연락처','이메일','학년/인원','교회','학교','비상연락처','메모','신청일시','RegID'];
      const rows = regs.map((r, i) => {
        const date = new Date(r.registeredAt).toLocaleString('ko-KR');
        const gradeOrCount = r.registrationType === 'group' ? `단체 ${r.groupCount}명` : (r.grade || '');
        return [
          i + 1, CAMP_LABELS[r.campId] || r.campId,
          r.registrationType === 'group' ? '단체' : '개인',
          r.name, r.phone, r.email, gradeOrCount,
          r.church || '', r.school || '', r.emergency || '',
          r.notes || '', date, r.regId,
        ].map(v => `"${String(v).replace(/"/g, '""')}"`).join(',');
      });

      const bom = '﻿';
      const csv = bom + [headers.join(','), ...rows].join('\n');
      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      const campName = CAMP_LABELS[activeCamp] || '전체';
      const today = new Date().toISOString().slice(0, 10);
      a.href = url; a.download = `WOLKO_신청목록_${campName}_${today}.csv`;
      a.click(); URL.revokeObjectURL(url);
      showToast('CSV 다운로드 완료!', 'success');
    }

    // ── Toast ──
    let toastTimer;
    function showToast(msg, type = '') {
      const t = document.getElementById('toast');
      t.textContent = msg;
      t.className = 'toast show' + (type ? ' ' + type : '');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { t.className = 'toast'; }, 3000);
    }

    // ── Auto-login if token exists ──
    if (authToken) {
      document.getElementById('loginScreen').classList.add('hidden');
      setTimeout(() => { document.getElementById('loginScreen').style.display = 'none'; }, 0);
      loadRegs();
      buildTeamGrid();
    }

    // ── Team password management ──────────────────────────────────
    // TEAM_MEMBERS injected via hidden script tag below
    function buildTeamGrid() {
      const members = window.__TEAM_MEMBERS__ || [];
      const grid = document.getElementById('teamGrid');
      if (!grid || members.length === 0) return;

      grid.innerHTML = members.map(m => `
        <div class="team-member-card">
          <div class="team-member-name">${m.name_ko}</div>
          <div class="team-member-slug">/team-edit/${m.slug}</div>
          <div class="team-pw-row">
            <input
              type="text"
              class="team-pw-input"
              id="pw-${m.slug}"
              placeholder="새 비밀번호 입력"
              autocomplete="off"
            >
            <button class="btn-set-pw" onclick="setTeamPw('${m.slug}')">저장</button>
          </div>
          <div class="team-pw-status" id="pw-status-${m.slug}"></div>
          <a class="team-pw-link" href="/team-edit/${m.slug}" target="_blank">
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
              <polyline points="15 3 21 3 21 9"/>
              <line x1="10" y1="14" x2="21" y2="3"/>
            </svg>
            편집 페이지 열기
          </a>
        </div>
      `).join('');

      // Load existing passwords to show status
      members.forEach(m => loadTeamPwStatus(m.slug));
    }

    async function loadTeamPwStatus(slug) {
      // Try to check if password is set (via admin API)
      try {
        const res = await fetch(`/api/admin/team-pw?slug=${slug}`, {
          headers: authHeaders()
        });
        if (res.ok) {
          const data = await res.json();
          const inp = document.getElementById(`pw-${slug}`);
          if (inp && data.hasPassword) {
            inp.placeholder = '비밀번호 설정됨 (변경하려면 입력)';
            inp.classList.add('has-pw');
          }
        }
      } catch {}
    }

    async function setTeamPw(slug) {
      const inp = document.getElementById(`pw-${slug}`);
      const statusEl = document.getElementById(`pw-status-${slug}`);
      const btn = inp.closest('.team-member-card').querySelector('.btn-set-pw');
      const pw = inp.value.trim();

      if (!pw) {
        statusEl.textContent = '비밀번호를 입력하세요.';
        statusEl.className = 'team-pw-status err';
        return;
      }
      if (pw.length < 4) {
        statusEl.textContent = '비밀번호는 4자 이상이어야 합니다.';
        statusEl.className = 'team-pw-status err';
        return;
      }

      btn.disabled = true;
      statusEl.textContent = '저장 중...';
      statusEl.className = 'team-pw-status';

      try {
        const res = await fetch('/api/admin/team-pw', {
          method: 'POST',
          headers: authHeaders(),
          body: JSON.stringify({ slug, password: pw }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || '저장 실패');

        inp.value = '';
        inp.placeholder = '비밀번호 설정됨 (변경하려면 입력)';
        inp.classList.add('has-pw');
        statusEl.textContent = '✅ 저장 완료';
        statusEl.className = 'team-pw-status ok';
        showToast(`${slug} 비밀번호 저장 완료`, 'success');
      } catch (e) {
        statusEl.textContent = '❌ ' + e.message;
        statusEl.className = 'team-pw-status err';
      } finally {
        btn.disabled = false;
      }
    }
  </script>
</body>
</html>
