/onlyoffice/*
  Access-Control-Allow-Origin: https://docs.wolko.org
  Access-Control-Allow-Methods: GET, HEAD, OPTIONS
  Cross-Origin-Resource-Policy: cross-origin

# 직원 포탈 — 검색 엔진에 나오지 않게 한다 (페이지마다 meta 를 넣지 않아도 모든 포탈 주소에 붙는다)
/portal
  X-Robots-Tag: noindex, nofollow
/portal/*
  X-Robots-Tag: noindex, nofollow
/portal-manifest.json
  X-Robots-Tag: noindex, nofollow

# 스태프 · 크루 서약서 — 링크를 받은 사람만 들어온다. 검색에 나오지 않게 하고(검색결과 · 캐시 보관본 · 미리보기 글 모두 막음) 링크 따라가기도 막는다
/staff-agreements
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
/staff-agreements/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex
