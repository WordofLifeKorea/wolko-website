{
  "appId": "org.wolko.portal",
  "appName": "WOLKO",
  "webDir": "www",
  "backgroundColor": "#f4f6f8",
  "appendUserAgent": "WOLKOApp/1.0",
  "server": {
    "url": "https://wolko.org/portal/",
    "allowNavigation": [
      "wolko.org"
    ],
    "errorPath": "offline.html"
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#f4f6f8",
      "showSpinner": false
    },
    "SystemBars": {
      "insetsHandling": "native"
    }
  }
}
